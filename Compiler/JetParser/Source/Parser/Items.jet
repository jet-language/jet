// Declaration grammar. AST nodes are assembled directly from Jet tokens; no
// Rust parser or semantic compiler is involved.
use {
    jet_foundation.[
        AccessConvention,
        AppliedRuleApplication,
        CLICommandBinding,
        CallLabel,
        ConstAttr,
        ContractClause,
        ConstDef,
        CtValue,
        DeriveBodyItem,
        DeriveDef,
        EffectRowEntry,
        EnumDef,
        EnumGroup,
        ErrorConvDef,
        Expr,
        Field,
        Func,
        ImplConstValue,
        ImplDef,
        ImportDecl,
        ImportKind,
        ImportedItem,
        InlineForeign,
        InlineVersion,
        Item,
        KernelMarker,
        KernelMode,
        Marker,
        MarkerCallArg,
        NamedSpan,
        NamedType,
        OperatorMarker,
        Param,
        ParamZone,
        PolicyDeclaration,
        PolicyScope,
        PatSlot,
        Pattern,
        PrepParam,
        RuleSite,
        RustConstKind,
        Span,
        StateDecl,
        StateTransition,
        Stmt,
        StructDef,
        TagDef,
        TextEdit,
        TraitConstDecl,
        TraitDef,
        TraitMethodSig,
        TraitImplBlock,
        Type,
        TypeAliasDef,
        TypeParam,
        UserPolicyDecl,
        Variant,
        VariantField,
        VariantPayload,
        ViewProvenance,
        ViewProvenanceEntry,
        ViewProvenanceMap,
        ViewSource,
        ViewSourcePath,
        ViewSourceProjection,
        WebPartitionMarker,
        ast_const,
        ast_enum,
        ast_func,
        ast_struct,
        diagnostic_from_registry,
        expr_span,
        diagnostic_with_edit,
        diagnostic_with_structured_edit,
        marker_registered,
        marker_registered_accepts_arguments,
        owned_trait_arithmetic,
        owned_trait_arithmetic_listed,
    ]
    jet_lexer.[
        TOKEN_AMP,
        TOKEN_AND_AND,
        TOKEN_BANG,
        TOKEN_COLON,
        TOKEN_COLON_EQ,
        TOKEN_COMMA,
        TOKEN_DOT,
        TOKEN_DOT_DOT,
        TOKEN_DOT_DOT_DOT,
        TOKEN_EOF,
        TOKEN_EQ,
        TOKEN_FLOAT,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_COPY,
        TOKEN_KW_DERIVE,
        TOKEN_KW_COMPTIME,
        TOKEN_KW_EFFECT,
        TOKEN_KW_ENUM,
        TOKEN_KW_EXTERN,
        TOKEN_KW_FN,
        TOKEN_KW_IMPL,
        TOKEN_KW_MODULE,
        TOKEN_KW_MOVE,
        TOKEN_KW_MUTATE,
        TOKEN_KW_PRIV,
        TOKEN_KW_PUB,
        TOKEN_KW_STRUCT,
        TOKEN_KW_TAG,
        TOKEN_KW_TRAIT,
        TOKEN_KW_USE,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_MINUS,
        TOKEN_PIPE,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SLASH,
        TOKEN_STAR,
        TOKEN_STRING,
        TOKEN_UNIFIED_ARROW,
        Token,
    ]
}

ParsedItemOrImport: struct {
    item: Item?
    // One import for a `use` line, one per row for a `use { … }` block.
    imports: [ImportDecl]{[ImportDecl]{}}
    handled: Bool
    // What a struct or enum declares beside itself, each an item of its own:
    // the marker of `impl Marker { … }` and the effect names of
    // `impl Effect { … }`.
    companions: [Item]{[Item]{}}
}

ParsedItemModifiers: struct {
    is_pub: Bool
    is_package_pub: Bool
    is_comptime: Bool
    markers: [Marker]
    start_span: Span
    // `pub use` re-exports (the only remaining `pub`, ballot pending).
    reexport: Bool{false}
    // The markers came from at least one `#[…]` list (Rust's grouped marker path).
    grouped_markers: Bool{false}
}
ParsedFunction: struct {
    value: Func
    has_body: Bool
}
ParsedUserPolicy: struct {
    value: UserPolicyDecl
    valid: Bool
}

parser_user_policy_ahead: fn(state: &JetParserState) -> Bool Never! {
    token := parser_current(state)
    token.kind == TOKEN_IDENT && parser_value(state, token) == "policy"
}

// `policy name(params…) { wrap(call) { … } }`, public like every declaration.
parser_parse_user_policy: fn(state: &JetParserState) -> ParsedUserPolicy {
    start: parser_expect_name(state, "to start a policy declaration")
    name: parser_expect_name(state, "as the policy setting name")
    params := parser_parse_param_list(state)
    parser_expect(state, TOKEN_LBRACE, "before the policy wrapper")
    wrap: parser_expect_name(state, "`wrap` in a policy declaration")
    valid := true
    if parser_value(state, wrap) != "wrap" {
        parser_add_error(state, wrap.span, "expected `wrap` in a policy declaration", "a user policy has one checked wrapper boundary around the supplied callable", "write `wrap(call)` around the policy body")
        valid = false
    }
    parser_expect(state, TOKEN_LPAREN, "after `wrap`")
    call: parser_expect_name(state, "as the callable parameter in `wrap(call)`")
    if parser_value(state, call) != "call" {
        parser_add_error(state, call.span, "a policy wrapper must receive `call`", "policy wrappers receive one callable value and cannot edit its signature", "write `wrap(call)`")
        valid = false
    }
    parser_expect(state, TOKEN_RPAREN, "after the policy callable parameter")
    body := parser_parse_block(state)
    // The wrapper body's line end lexes as `;` before the outer `}` (skips
    // every `Semi` in this gap).
    parser_skip_semicolons(state)
    close: parser_expect(state, TOKEN_RBRACE, "after the policy wrapper body")
    parser_finish_statement(state)
    value := UserPolicyDecl{is_pub: true, name: parser_value(state, name), name_span: name.span, params: params, body: body.statements, span: parser_cover(start.span, close.span)}
    ParsedUserPolicy{value: value, valid: valid}
}

parser_parse_item_or_import: fn(state: &JetParserState) -> ParsedItemOrImport {
    // Foreign module heads own their markers; do not replay them as ordinary
    // item/file rules before the dedicated C-module parser sees the head.
    if parser_c_module_ahead_at(state, 0) {
        value: parser_parse_c_module(state)
        return ParsedItemOrImport{item: Val(value), handled: true}
    }
    modifiers: parser_parse_item_modifiers(state, true)
    if {
        parser_module_ahead(state) -> {
            value: parser_parse_module(state, modifiers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_test_ahead(state) -> {
            value: parser_parse_test(state, modifiers.markers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_unit_family_ahead(state) -> {
            value: parser_parse_unit_family(state, modifiers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_distinct_ahead(state) -> {
            value: parser_parse_distinct(state, modifiers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_type_alias_ahead_at(state, 0) -> {
            value: parser_parse_type_alias(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.TypeAlias{value: value}), handled: true}
        }
        parser_state_section_ahead(state) -> {
            section_start: parser_current(state).span
            section := parser_parse_state_section(state, "", section_start)
            parser_report_ineligible_state_section(state, section, "module")
            return ParsedItemOrImport{item: None, handled: true}
        }
        parser_state_ahead(state) -> {
            declaration := parser_parse_state_decl(state, modifiers)
            parser_report_top_level_state_decl(state, declaration)
            return ParsedItemOrImport{item: None, handled: true}
        }
        parser_protocol_ahead(state) -> {
            value: parser_parse_protocol(state, modifiers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_fact_decl_ahead(state) -> {
            value: parser_parse_fact_decl(state)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_tag_decl_ahead(state) -> {
            value: parser_parse_tag_policy(state, modifiers)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_migration_ahead(state) -> {
            value: parser_parse_migration(state)
            return ParsedItemOrImport{item: Val(Item.Migration{value: value}), handled: true}
        }
        parser_item_declaration_ahead_at(state, 0) && parser_extern_ahead(state) -> {
            value: parser_parse_extern_rust(state)
            return ParsedItemOrImport{item: Val(value), handled: true}
        }
        parser_current_kind(state) == TOKEN_KW_USE -> {
            return ParsedItemOrImport{item: None, imports: parser_parse_import(state, modifiers.reexport, None), handled: true}
        }
        parser_prep_verb_ahead(state, 0, TOKEN_KW_USE) -> {
            head: parser_bump(state)
            return ParsedItemOrImport{item: None, imports: parser_parse_import(state, modifiers.reexport, Val(head.span)), handled: true}
        }
    }
    token: parser_current(state)
    if {
        parser_output_ahead_at(state, 0) -> {
            value: parser_parse_output(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Const{value: value}), handled: true}
        }
        parser_output_defaults_ahead_at(state, 0) -> {
            value: parser_parse_output_defaults(state)
            return ParsedItemOrImport{item: Val(Item.Const{value: value}), handled: true}
        }
        parser_template_loop_ahead(state) -> {
            value: parser_parse_template_loop(state)
            return ParsedItemOrImport{item: Val(Item.TemplateLoop{value: value}), handled: true}
        }
        // An ALL_CAPS `NAME: value` in an inline module body is a module
        // constant, and so is `Name: path` until sema reads what the path
        // names (#6176); file scope routes both as module bindings before
        // reaching here.
        parser_marked_const_ahead(state, 0) || parser_path_binding_ahead_at(state, 0) -> {
            value: parser_parse_const(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Const{value: value}), handled: true}
        }
        token.kind == TOKEN_KW_FN -> {
            saved_position: state.position
            saved_diagnostics: state.diagnostics.len()
            saved_blocks: state.block_spans.len()
            saved_else_arms: state.else_arms.len()
            parsed: parser_parse_function(state, modifiers, true)
            if parser_function_signature_only(state, parsed, modifiers, saved_diagnostics) {
                parser_rewind(state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
                value: parser_parse_function_type_alias(state, modifiers)
                return ParsedItemOrImport{item: Val(Item.TypeAlias{value: value}), handled: true}
            }
            return ParsedItemOrImport{item: Val(Item.Func{value: parsed.value}), handled: true}
        }
        token.kind == TOKEN_KW_STRUCT -> {
            value: parser_parse_struct(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Struct{value: value}), handled: true, companions: parser_type_companions(value.marker, value.effect_impl)}
        }
        token.kind == TOKEN_KW_ENUM -> {
            value: parser_parse_enum(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Enum{value: value}), handled: true, companions: parser_type_companions(None, value.effect_impl)}
        }
        token.kind == TOKEN_KW_TRAIT -> {
            value: parser_parse_trait(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Trait{value: value}), handled: true}
        }
        token.kind == TOKEN_KW_IMPL -> return ParsedItemOrImport{item: Val(parser_parse_impl(state, modifiers)), handled: true}
        token.kind == TOKEN_KW_MODULE -> return ParsedItemOrImport{item: Val(parser_parse_module(state, modifiers)), handled: true}
        token.kind == TOKEN_KW_EFFECT -> {
            value: parser_parse_effect_word(state) ?? return ParsedItemOrImport{item: None, handled: true}
            return ParsedItemOrImport{item: Val(Item.EffectDecl{value: value}), handled: true}
        }
        token.kind == TOKEN_KW_TAG -> {
            value: parser_parse_tag_decl(state, modifiers)
            return ParsedItemOrImport{item: Val(Item.Tag{value: value}), handled: true}
        }
        token.kind == TOKEN_KW_EXTERN -> return ParsedItemOrImport{item: Val(parser_parse_extern_rust(state)), handled: true}
        token.kind == TOKEN_KW_DERIVE -> {
            value: parser_parse_user_derive(state) ?? return ParsedItemOrImport{item: None, handled: true}
            return ParsedItemOrImport{item: Val(Item.UserDerive{value: value}), handled: true}
        }
    }
    ParsedItemOrImport{item: None, handled: false}
}
parser_report_top_level_state_decl: fn(state: &JetParserState, declaration: StateDecl) {
    state_names := ""
    index := 0
    loop index < declaration.states.len() {
        if index > 0 -> state_names = "{state_names}, "
        state_name: declaration.states[index]
        state_names = "{state_names}{state_name.name}"
        index += 1
    }
    states := "{{ {state_names} }}"
    parser_add_error_code(state, "E0157", declaration.span, "`state {declaration.type_name} {{ … }}` is not a type declaration", "Typestate facts belong to the struct that owns them; a sibling declaration repeats the type name and creates a false namespace boundary", "move the states into the owner: write `{declaration.type_name}: struct` with `state {states}` inside its body")
}

parser_report_ineligible_state_section: fn(state: &JetParserState, section: StateDecl, owner: String) {
    parser_add_error_code(state, "E0158", section.span, "`state {{ … }}` is not valid inside a {owner}", "state sections attach only to named struct bodies; enums, traits, aliases, impls, modules, and anonymous shapes have no state-set owner", "Move `state {{ … }}` into the named struct body")
}
parser_report_repeated_state_section: fn(state: &JetParserState, section: StateDecl, type_name: String) {
    parser_add_error_code(state, "E0168", section.span, "`{type_name}` may declare only one `state {{ … }}` section", "The state set is one erased fact row owned by the struct", "Merge the state names into one `state {{ … }}` section")
}

// (card #4723): declarations are public by default. `priv` and
// `priv(package)` mark a module (`item_visibility`) or a field (members);
// `priv` on any other declaration is reported with a fix that deletes it, and
// the declaration parses as if it were absent. `pub use` and
// `pub(package) use` are the re-export spellings.
parser_parse_item_modifiers: fn(state: &JetParserState, item_visibility: Bool) -> ParsedItemModifiers {
    start := parser_current(state).span
    is_pub := true
    is_package_pub := false
    is_comptime := false
    reexport := false
    markers := [Marker]{}
    marker_chunks := 0
    bracket_chunks := 0
    sequence := parser_current(state).span
    loop {
        kind := parser_current_kind(state)
        if kind == TOKEN_KW_PUB && item_visibility && (parser_kind_at(state, 1) == TOKEN_KW_USE || (parser_kind_at(state, 1) == TOKEN_LPAREN && parser_kind_at(state, 4) == TOKEN_KW_USE)) {
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_LPAREN {
                parser_bump(state)
                qualifier: parser_current(state)
                if qualifier.kind == TOKEN_IDENT && parser_value(state, qualifier) == "package" {
                    parser_bump(state)
                    is_pub = false
                    is_package_pub = true
                    if parser_current_kind(state) == TOKEN_RPAREN {
                        parser_bump(state)
                    } else {
                        close_span: parser_current(state).span
                        parser_add_error(state, close_span, "expected `)` to close `pub(package)`", "write `pub(package)` with no extra content inside the parentheses", "use `pub(package)` to restrict access to sibling packages in the same payload")
                    }
                } else {
                    found: parser_describe_token(state, qualifier)
                    parser_add_error(state, qualifier.span, "expected `package` inside `pub(…)`, found {found}", "a re-export is `pub use` (public to all) or `pub(package) use` (sibling packages in the same payload)", "write `pub use` or `pub(package) use`")
                    loop parser_current_kind(state) != TOKEN_RPAREN && parser_current_kind(state) != TOKEN_EOF -> parser_bump(state)
                    if parser_current_kind(state) == TOKEN_RPAREN -> parser_bump(state)
                }
            }
            reexport = true
            next
        }
        if kind == TOKEN_KW_PRIV {
            word: parser_bump(state)
            marker_span := word.span
            package := false
            if parser_current_kind(state) == TOKEN_LPAREN {
                open: parser_bump(state).span
                qualifier: parser_current(state)
                package = qualifier.kind == TOKEN_IDENT && parser_value(state, qualifier) == "package" && parser_kind_at(state, 1) == TOKEN_RPAREN
                loop parser_current_kind(state) != TOKEN_RPAREN && parser_current_kind(state) != TOKEN_EOF -> parser_bump(state)
                if parser_current_kind(state) == TOKEN_RPAREN -> marker_span = parser_cover(word.span, parser_bump(state).span)
                written: Span{start: open.start, end: marker_span.end}
                if !package -> parser_add_error_code_edit(state, "E0414", written, "unknown `priv(…)` qualifier: only `priv(package)` exists", "`priv(package) module` is the only qualified module privacy", "delete the qualifier, or write `priv(package)`", TextEdit{span: written, new_text: ""})
            }
            if item_visibility && parser_current_kind(state) != TOKEN_KW_MODULE {
                deletion: parser_deletion_edit(state, marker_span)
                parser_add_error_code_edit(state, "E0413", marker_span, "`priv` marks only modules and fields", "declarations are public by default; privacy belongs to a `priv module` or a `priv` field", "delete `priv`; move the declaration into a `priv module` if it must stay internal", deletion)
                next
            }
            if !item_visibility && package {
                parser_add_error_code_edit(state, "E0417", marker_span, "a field takes plain `priv`, not `priv(package)`", "a `priv` field is usable only by its type's module; package privacy belongs to modules", "write `priv`", TextEdit{span: Span{start: marker_span.start + 4, end: marker_span.end}, new_text: ""})
                package = false
            }
            is_pub = false
            is_package_pub = package
            next
        }
        if kind == TOKEN_HASH {
            if parser_item_declaration_ahead_at(state, 0) -> break
            if parser_kind_at(state, 1) == TOKEN_LBRACKET {
                group: parser_parse_marker_group_list(state)
                if marker_chunks == 0 -> sequence.start = group.span.start
                sequence.end = group.span.end
                marker_chunks += 1
                bracket_chunks += 1
                loop marker in group.markers {
                    markers.push(marker)
                }
                next
            }
            marker: parser_parse_marker(state)
            if marker_chunks == 0 -> sequence.start = marker.span.start
            sequence.end = marker.span.end
            marker_chunks += 1
            markers.push(marker)
            // Rust `parse_attached_marker_sequence`: a marker on its own line
            // still attaches to the declaration below.
            parser_skip_semicolons(state)
            next
        }
        break
    }
    noun: parser_marker_sequence_noun(state, item_visibility)
    if noun != "" -> parser_report_adjacent_markers(state, markers, marker_chunks, bracket_chunks, sequence, noun)
    ParsedItemModifiers{is_pub: is_pub, is_package_pub: is_package_pub, is_comptime: is_comptime, markers: markers, start_span: start, reexport: reexport, grouped_markers: bracket_chunks > 0}
}

// The target a declaration marker sequence attaches to, named as Rust's
// marker-sequence sites name it; empty where no sequence check applies.
parser_marker_sequence_noun: fn(state: &JetParserState, item_visibility: Bool) -> String {
    kind: parser_current_kind(state)
    if kind == TOKEN_KW_FN || parser_prep_fn_ahead(state) {
        if item_visibility -> return "function"
        return "method"
    }
    if kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM -> return "type"
    if kind == TOKEN_KW_IMPL -> return "impl"
    if !item_visibility && kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON -> return "field"
    ""
}

parser_expect_marker_path: fn(state: &JetParserState, reason: String) -> Token {
    name := parser_expect_name(state, reason)
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        member: parser_expect_name(state, "a library marker path segment")
        path: "{parser_value(state, name)}.{parser_value(state, member)}"
        name = parser_spelled_token(state, TOKEN_IDENT, parser_cover(name.span, member.span), path)
    }
    name
}

parser_parse_marker: fn(state: &JetParserState) -> Marker {
    hash: parser_expect(state, TOKEN_HASH, "`#` before a marker")
    negated := false
    bang_start := 0
    if parser_current_kind(state) == TOKEN_BANG {
        bang_start = parser_bump(state).span.start
        negated = true
    }
    name: parser_expect_marker_path(state, "after `#` in a declaration marker")
    if negated -> parser_check_signed_marker(state, bang_start, name)
    args := ParsedMarkerArgs{args: [MarkerCallArg]{}, labels: [CallLabel?]{}}
    end := name.span
    if parser_current_kind(state) == TOKEN_LPAREN {
        open: parser_current(state).span
        args = parser_parse_marker_args(state)
        if state.position > 0 -> end = parser_lookahead(state, -1).span
        if args.args.len() == 0 {
            marker_name: parser_value(state, name)
            parser_check_empty_marker_parens(state, marker_name, Span{start: open.start, end: end.end})
        }
    }
    Marker{name: parser_value(state, name), negated: negated, name_span: name.span, args: args.args, arg_labels: args.labels, span: parser_cover(hash.span, end), ct: None}
}

// A marker writes parentheses exactly when it passes arguments,
// so `#Name()` of a rule that takes arguments is a leftover pair. It is E0999
// at `(`…`)` with the delete edit, and parsing goes on so `jet fmt` can apply
// it.
parser_check_empty_marker_parens: fn(state: &JetParserState, name: String, parens: Span) {
    if !marker_registered_accepts_arguments(name) || parser_aborting(state) -> return
    diagnostic: diagnostic_from_registry("E0999", Val(parens), "`#{name}()` has empty parentheses", "a marker writes parentheses exactly when it passes arguments", "write `#{name}`")
    state.diagnostics.push(diagnostic_with_structured_edit(diagnostic, TextEdit{span: parens, new_text: ""}))
}
parser_marker_first_expr: fn(marker: Marker) -> Expr? {
    if marker.args.len() == 0 -> return None
    if marker.args[0] == {
        .Expr(value) -> return Val(value)
        else -> return None
    }
}

// `use ROW` or a `use { … }` block with one ROW per line (#6542). A row is
// a module path, a member list, or a "file" path, any of them after an
// `alias:`: `alias: path` means what `use alias: path` means. `pub`
// before `use` re-exports every row. `comptime_head` is the `comptime`
// before `use`, which makes every row a build-only import.
parser_parse_import: fn(state: &JetParserState, is_pub: Bool, comptime_head: Span?) -> [ImportDecl] {
    keyword: parser_bump(state)
    comptime_span := Span?{None}
    if comptime_head == .Val(head) -> comptime_span = Val(Span{start: head.start, end: keyword.span.start})
    imports := [ImportDecl]{}
    if parser_current_kind(state) != TOKEN_LBRACE {
        import := parser_parse_import_row(state, comptime_head ?? keyword.span)
        import.is_pub = is_pub
        import.comptime_span = comptime_span
        imports.push(import)
        return imports
    }
    open: parser_bump(state)
    parser_skip_semicolons(state)
    if parser_current_kind(state) == TOKEN_RBRACE {
        parser_add_error(state, open.span, "a `use` block cannot be empty", "a `use {{ … }}` block lists one import per line", "write one import per line inside the braces, or delete the block")
    }
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
        before: state.position
        row_start: parser_current(state).span
        import := parser_parse_import_row(state, row_start)
        import.is_pub = is_pub
        import.comptime_span = comptime_span
        imports.push(import)
        parser_skip_semicolons(state)
        // A row that read nothing (a stray token) must not stall the block.
        if state.position == before -> parser_bump(state)
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` after the rows of a `use` block")
    parser_finish_statement(state)
    imports
}

// One import row: `use` has been read, and `start` is where the import's
// span begins (the `use` keyword, or the row's first token in a block).
parser_parse_import_row: fn(state: &JetParserState, start: Span) -> ImportDecl {
    named := Token?{None}
    if parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
        named = Val(parser_bump(state))
        parser_bump(state)
    }
    token: parser_current(state)
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        path: parser_bump(state)
        alias := parser_path_basename(parser_value(state, path))
        alias_span := path.span
        if named == .Val(name) {
            alias = parser_value(state, name)
            alias_span = name.span
        }
        parser_finish_statement(state)
        end := path.span
        if state.position > 0 -> end = parser_lookahead(state, -1).span
        return ImportDecl{kind: ImportKind.File{path: parser_value(state, path), span: path.span}, alias: alias, alias_span: alias_span, span: parser_cover(start, end), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
    }
    first: parser_expect_name(state, "after `use`")
    path := parser_value(state, first)
    last_span := first.span
    parts := [Token]{first}
    loop parser_current_kind(state) == TOKEN_DOT {
        next_kind := parser_lookahead(state, 1).kind
        if next_kind == TOKEN_LBRACKET || next_kind == TOKEN_STAR -> break
        parser_bump(state)
        member: parser_expect_name(state, "after `.` in an import path")
        parts.push(member)
        path = "{path}.{parser_value(state, member)}"
        last_span = member.span
    }
    module_span := parser_cover(first.span, last_span)
    if parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_LBRACKET {
            if named == .Val(name) {
                named_text: parser_value(state, name)
                parser_add_error(state, name.span, "a member list takes no `{named_text}:` alias", "`alias: path` names one module or item, and a member list names several", "drop `{named_text}:`, or write one `alias: {path}.member` row per member")
            }
            return parser_parse_import_member_list(state, start, path, module_span)
        }
        if parser_current_kind(state) == TOKEN_STAR {
            star: parser_bump(state)
            parser_add_fatal_code(state, "E0612", star.span, "wildcard imports are not supported", "`use {path}.*` would hide where each name comes from", "list each item instead: `use {path}.[item, other]`")
            parser_finish_statement(state)
            end := parser_lookahead(state, -1).span
            return ImportDecl{kind: ImportKind.Module{name: path, span: module_span}, alias: parser_value(state, parts[parts.len() - 1]), alias_span: start, span: parser_cover(start, end), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None}
        }
        suffix: parser_current(state)
        parser_add_error(state, suffix.span, "expected an import member suffix after `.`", "a trailing import dot starts a member list or wildcard suffix", "write `.[member]` after the module path")
    }
    alias := parser_value(state, parts[parts.len() - 1])
    // An import without `alias:` takes its local name from the path's last
    // segment, so that segment is where the name is written.
    alias_span := parts[parts.len() - 1].span
    inline_version := InlineVersion?{None}
    if parts.len() == 1 && parser_current_kind(state) == TOKEN_HASH {
        inline_version = Val(parser_parse_inline_version(state))
    }
    explicit_alias := false
    if named == .Val(name) {
        alias = parser_value(state, name)
        alias_span = name.span
        explicit_alias = true
    }
    parser_finish_statement(state)
    end := last_span
    if state.position > 0 -> end = parser_lookahead(state, -1).span
    span := parser_cover(start, end)
    if parts.len() == 2 && !explicit_alias {
        item_span := parts[1].span
        return ImportDecl{kind: ImportKind.Unqualified{module_alias: parser_value(state, first), module_alias_span: first.span, items: [ImportedItem]{ImportedItem{original: parser_value(state, parts[1]), alias: None}}, items_span: item_span, span: span}, alias: alias, alias_span: item_span, span: span, item_spans: [Span]{item_span}, local_spans: [Span]{item_span}, is_pub: false, is_package_pub: false, inline_version: None}
    }
    ImportDecl{kind: ImportKind.Module{name: path, span: module_span}, alias: alias, alias_span: alias_span, span: span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: inline_version}
}

parser_parse_import_member_list: fn(state: &JetParserState, start: Span, module_alias: String, module_alias_span: Span) -> ImportDecl {
    open: parser_bump(state)
    close_kind: TOKEN_RBRACKET
    items := [ImportedItem]{}
    item_spans := [Span]{}
    local_spans := [Span]{}
    next_kind := parser_current_kind(state)
    if next_kind == close_kind || next_kind == TOKEN_EOF {
        parser_add_error(state, open.span, "an import member list cannot be empty", "the `.[…]` form must name at least one member", "write `use {module_alias}.[member]`")
    }
    loop parser_current_kind(state) != close_kind && parser_current_kind(state) != TOKEN_EOF {
        first: parser_expect_name(state, "inside an import member list")
        name := parser_value(state, first)
        item_end := first.span
        local_span := first.span
        loop parser_current_kind(state) == TOKEN_DOT {
            parser_bump(state)
            part: parser_expect_name(state, "after `.` in an imported member")
            name = "{name}.{parser_value(state, part)}"
            item_end = part.span
            local_span = part.span
        }
        items.push(ImportedItem{original: name, alias: None})
        item_spans.push(parser_cover(first.span, item_end))
        local_spans.push(local_span)
        if parser_current_kind(state) != TOKEN_COMMA -> break
        parser_bump(state)
    }
    close: parser_expect(state, TOKEN_RBRACKET, "`]` after imported members")
    items_span := parser_cover(open.span, close.span)
    parser_finish_statement(state)
    end := parser_lookahead(state, -1).span
    span := parser_cover(start, end)
    ImportDecl{kind: ImportKind.Unqualified{module_alias: module_alias, module_alias_span: module_alias_span, items: items, items_span: items_span, span: span}, alias: module_alias, alias_span: module_alias_span, span: span, item_spans: item_spans, local_spans: local_spans, is_pub: false, is_package_pub: false, inline_version: None}
}

parser_parse_inline_version: fn(state: &JetParserState) -> InlineVersion {
    hash: parser_bump(state)
    first := parser_current(state)
    if first.kind != TOKEN_INT && first.kind != TOKEN_FLOAT {
        parser_add_error(state, first.span, "expected a version number after `#`", "`use package#version;` pins an inline dependency version", "write numeric version components after `#`")
        return InlineVersion{text: "", span: hash.span}
    }
    text := parser_text(state, first)
    end := parser_bump(state).span
    loop parser_current_kind(state) == TOKEN_DOT && parser_lookahead(state, 1).kind == TOKEN_INT {
        parser_bump(state)
        part: parser_bump(state)
        text = "{text}.{parser_text(state, part)}"
        end = part.span
    }
    InlineVersion{text: text, span: parser_cover(hash.span, end)}
}

parser_path_basename: fn(path: String) -> String Never! {
    segments: path.split("/").to_list()
    segments[segments.len() - 1]
}

parser_parse_type_params: fn(state: &JetParserState) -> [TypeParam] {
    params := [TypeParam]{}
    if parser_current_kind(state) != TOKEN_LT -> return params
    parser_bump(state)
    if {
        parser_type_close_here(state) -> parser_add_error_here(state, "a generic parameter list cannot be empty", "type parameters are declared by name", "write at least one type parameter or remove `< >`")
        else -> {
            loop {
                // `comptime N: Int` declares a compile-time number parameter.
                if parser_current_kind(state) == TOKEN_KW_COMPTIME && parser_kind_at(state, 1) == TOKEN_IDENT {
                    prep_head: parser_bump(state)
                    params.push(parser_parse_prep_param(state, prep_head.span))
                    if parser_type_close_here(state) -> break
                    if parser_current_kind(state) != TOKEN_COMMA -> break
                    parser_bump(state)
                    if parser_type_close_here(state) -> break
                    next
                }
                name: parser_expect_name(state, "in a generic parameter list")
                bounds := [String]{}
                if parser_current_kind(state) == TOKEN_COLON {
                    parser_bump(state)
                    bounds = parser_parse_trait_bounds(state, "in a generic trait-bound list", "`]` after generic bounds", "after `:` in a generic parameter")
                }
                params.push(TypeParam{name: parser_value(state, name), name_span: name.span, bounds: bounds, prep: None})
                if parser_type_close_here(state) -> break
                if parser_current_kind(state) != TOKEN_COMMA {
                    parser_add_error_here(state, "expected `,` between generic parameters", "type parameter declarations are comma-separated", "add a comma or close the generic list")
                    break
                }
                parser_bump(state)
                if parser_type_close_here(state) -> break
            }
        }
    }
    if parser_type_close_here(state) -> parser_take_type_close(state) else -> parser_expect(state, TOKEN_GT, "`>` after generic parameters")
    params
}

// Parse `N: Int` after `comptime` into the typed number-parameter slot.
parser_parse_prep_param: fn(state: &JetParserState, prep_span: Span) -> TypeParam {
    name: parser_expect_name(state, "for a number parameter name")
    param_name: parser_value(state, name)
    name_span: name.span
    parser_expect(state, TOKEN_COLON, "`:` after a number parameter name")
    value_type: parser_expect_name(state, "for the number parameter type")
    TypeParam{name: param_name, name_span: name_span, bounds: [String]{}, prep: Val(PrepParam{prep_span: prep_span, value_type: parser_value(state, value_type), value_type_span: value_type.span})}
}

// `/` closes the positional-only zone and `*` opens the
// label-only zone; each appears at most once, `/` before `*`, and neither
// may mark an empty zone (E0763).
parser_parse_param_list: fn(state: &JetParserState) -> [Param] {
    parser_expect(state, TOKEN_LPAREN, "`(` before function parameters")
    params := [Param]{}
    zone := ParamZone.Either
    slash := Span?{None}
    star := Span?{None}
    if parser_current_kind(state) != TOKEN_RPAREN {
        loop {
            if {
                parser_current_kind(state) == TOKEN_SLASH -> {
                    span: parser_bump(state).span
                    if {
                        slash != None -> parser_add_error_code(state, "E0763", span, "`/` appears twice in this parameter list", "each parameter list has at most one positional-only `/` and one label-only `*`", "remove the extra `/`")
                        star != None -> parser_add_error_code(state, "E0763", span, "`/` comes after `*` in this parameter list", "the zones read left to right: positional-only, then either, then label-only", "move `/` before `*`")
                        params.len() == 0 -> parser_add_error_code(state, "E0763", span, "`/` marks an empty parameter zone", "a positional-only zone needs at least one parameter before the `/`", "write the positional-only parameters before `/`, or remove the `/`")
                        else -> {
                            slash = Val(span)
                            index := 0
                            loop index < params.len() {
                                params[index].zone = ParamZone.PositionalOnly
                                index += 1
                            }
                        }
                    }
                }
                parser_current_kind(state) == TOKEN_STAR -> {
                    span: parser_bump(state).span
                    if star != None {
                        parser_add_error_code(state, "E0763", span, "`*` appears twice in this parameter list", "each parameter list has at most one positional-only `/` and one label-only `*`", "remove the extra `*`")
                    } else {
                        star = Val(span)
                        zone = ParamZone.LabelOnly
                    }
                }
                else -> params.push(parser_parse_param(state, zone))
            }
            if parser_current_kind(state) == TOKEN_RPAREN -> break
            if parser_current_kind(state) != TOKEN_COMMA {
                current: parser_current(state)
                found: parser_describe_token(state, current)
                parser_add_error_here(state, "expected `,` between parameters, found {found}", "the structure here isn't what the compiler expected", "use `,` between parameters")
                break
            }
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RPAREN -> break
        }
    }
    parser_expect(state, TOKEN_RPAREN, "`)` after function parameters")
    if star == Val(star_span) {
        label_only := false
        loop param in params {
            if param.zone == ParamZone.LabelOnly -> label_only = true
        }
        if !label_only -> parser_add_error_code(state, "E0763", star_span, "`*` marks an empty parameter zone", "a label-only zone needs at least one parameter after the `*`", "write the label-only parameters after `*`, or remove the `*`")
    }
    parser_validate_variadic_params(state, params)
    parser_validate_param_labels(state, params)
    params
}

// A parameter's call label is its public label when written,
// else its name; two parameters may not publish the same one (E0770).
parser_validate_param_labels: fn(state: &JetParserState, params: [Param]) {
    loop index in 0..<params.len() {
        param: params[index]
        if param.name == "self" -> next
        label: if param.public_label == {.Val(value) -> value.name else -> param.name}
        label_span: if param.public_label == {.Val(value) -> value.span else -> param.name_span}
        loop earlier_index in 0..<index {
            earlier: params[earlier_index]
            if earlier.name == "self" -> next
            earlier_label: if earlier.public_label == {.Val(value) -> value.name else -> earlier.name}
            if earlier_label == label {
                parser_add_error_code(state, "E0770", label_span, "two parameters both publish the label `{label}`", "a label binds an argument by name, so a repeated one leaves the second parameter with no way to be called", "give one of them a different label, as in `{label}_2 {param.name}: …`")
                break
            }
        }
    }
}

// A `name: ...T` rest parameter collects every trailing
// argument, so it is last and has no default (E1310).
parser_validate_variadic_params: fn(state: &JetParserState, params: [Param]) {
    loop index in 0..<params.len() {
        param: params[index]
        if param.variadic && index + 1 != params.len() {
            parser_add_error_code(state, "E1310", param.name_span, "variadic parameter `{param.name}` must be last", "a `name: ...T` rest parameter collects every trailing argument, so nothing may follow it", "move `{param.name}` to the end of the parameter list, or remove the `...`")
        }
    }
}

parser_parse_param: fn(state: &JetParserState, zone: ParamZone) -> Param {
    root := false
    if parser_current_kind(state) == TOKEN_HASH {
        marker: parser_parse_marker(state)
        root = marker.name == "Root"
        // An unregistered name applies to the parameter site, where sema
        // reports it from the shared applied-rule vocabulary (E0927).
        if !marker_registered(marker.name) {
            span: marker.span
            state.statement_rules.push(AppliedRuleApplication{marker: marker, target: Val(span), site: Val(RuleSite.Parameter)})
        }
    }
    convention := AccessConvention.Read
    access_kind: parser_current_kind(state)
    if access_kind == TOKEN_KW_COPY || access_kind == TOKEN_KW_MUTATE || access_kind == TOKEN_KW_MOVE {
        keyword_token: parser_bump(state)
        keyword_text: parser_text(state, keyword_token)
        parser_add_error(state, keyword_token.span, "expected a name for a parameter name, found the keyword `{keyword_text}`", "names start with a letter or `_`", "e.g. `main`, `count`, `_tmp`")
    }
    leading_mark := ""
    if access_kind == {
        TOKEN_AMP -> {
            parser_bump(state)
            convention = AccessConvention.Write
            leading_mark = "&"
        }
        TOKEN_AND_AND -> {
            parser_bump(state)
            convention = AccessConvention.Move
            leading_mark = "&&"
        }
        else -> {}
    }
    name := if parser_current_kind(state) == TOKEN_SELF -> parser_bump(state) else -> parser_expect_name(state, "for a parameter name")
    // An expert receiver may state its field footprint
    // with a field or the ratified member spread: `&self.log`,
    // `&self.[log, hits]`. A consuming `&&self` takes the whole value.
    declared_footprint := [NamedSpan]?{None}
    if name.kind == TOKEN_SELF && convention != AccessConvention.Move && parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        fields := [NamedSpan]{}
        if parser_current_kind(state) == TOKEN_LBRACKET {
            parser_bump(state)
            if parser_current_kind(state) != TOKEN_RBRACKET {
                loop {
                    if parser_current_kind(state) == TOKEN_IDENT {
                        field: parser_bump(state)
                        fields.push(NamedSpan{name: parser_value(state, field), span: field.span})
                    } else {
                        bad: parser_current(state).span
                        parser_add_error_code(state, "E0961", bad, "`.[ ]` lists member names, not calls or expressions", "member spread names fields or package names that hang off the prefix", "write bare names like `default.[cargo, ripgrep]`")
                        loop parser_current_kind(state) != TOKEN_COMMA && parser_current_kind(state) != TOKEN_RBRACKET && parser_current_kind(state) != TOKEN_EOF -> parser_bump(state)
                    }
                    if parser_current_kind(state) != TOKEN_COMMA -> break
                    parser_bump(state)
                    if parser_current_kind(state) == TOKEN_RBRACKET -> break
                }
            }
            _ := parser_expect(state, TOKEN_RBRACKET, "`]` to close a member spread `.[…]`")
        } else {
            field: parser_expect_name(state, "for a receiver footprint field")
            fields.push(NamedSpan{name: parser_value(state, field), span: field.span})
        }
        declared_footprint = Val(fields)
    }
    public_label := CallLabel?{None}
    if name.kind == TOKEN_IDENT && parser_current_kind(state) == TOKEN_IDENT {
        public_label = Val(CallLabel{name: parser_value(state, name), span: name.span})
        name = parser_bump(state)
    }
    ty := Type.Named{name: ""}
    ty_span := name.span
    variadic := false
    variadic_bounds := [String]?{None}
    if {
        name.kind == TOKEN_SELF && parser_current_kind(state) != TOKEN_COLON -> {
            // Sema supplies the receiver type from its owning declaration.
        }
        else -> {
            if parser_current_kind(state) == TOKEN_COLON {
                parser_bump(state)
            } else {
                param_name: parser_text(state, name)
                parser_add_error(state, name.span, "expected `:` after the parameter `{param_name}`", "every parameter except `self` needs a type after its name", "write `{param_name}: Type`")
            }
            cap_kind := parser_current_kind(state)
            if cap_kind == TOKEN_AMP || cap_kind == TOKEN_AND_AND {
                cap: parser_bump(state)
                type_convention := AccessConvention.Move
                if cap.kind == TOKEN_AMP -> type_convention = AccessConvention.Write
                if convention != AccessConvention.Read {
                    leading_label: if convention == AccessConvention.Write -> "the write-access marker `&`" else -> "the take marker `{leading_mark}`"
                    type_label: if type_convention == AccessConvention.Write -> "the write-access marker `&`" else -> "the take marker `&&`"
                    name_text: parser_text(state, name)
                    parser_add_error_code(state, "E0029", name.span, "`{name_text}` has two access markers", "{leading_label} before the parameter name conflicts with {type_label} on its type; a parameter can declare only one access marker", "keep one access marker on the type or receiver and remove the other")
                }
                convention = type_convention
            }
            if {
                parser_current_kind(state) == TOKEN_DOT_DOT_DOT -> {
                    parser_bump(state)
                    variadic = true
                    if {
                        parser_current_kind(state) == TOKEN_LBRACKET -> {
                            parser_bump(state)
                            bounds := [String]{}
                            if parser_current_kind(state) != TOKEN_RBRACKET {
                                loop {
                                    bound: parser_expect_name(state, "in variadic trait bounds")
                                    bounds.push(parser_value(state, bound))
                                    if parser_current_kind(state) == TOKEN_RBRACKET -> break
                                    if parser_current_kind(state) != TOKEN_COMMA -> break
                                    parser_bump(state)
                                }
                            }
                            close: parser_expect(state, TOKEN_RBRACKET, "`]` after variadic bounds")
                            variadic_bounds = Val(bounds)
                            ty_span = parser_cover(name.span, close.span)
                        }
                        else -> {
                            parsed_type: parser_parse_type(state, 0)
                            ty = parsed_type.ty
                            ty_span = parsed_type.span
                        }
                    }
                }
                else -> {
                    parsed_type: parser_parse_type(state, 0)
                    ty = parsed_type.ty
                    ty_span = parsed_type.span
                }
            }
        }
    }
    // An optional `from src (| src)*` follows the type,
    // then the default `{expr}`.
    declared_from := [String]?{None}
    if parser_current_kind(state) == TOKEN_IDENT && parser_value_at(state, 0) == "from" && (parser_kind_at(state, 1) == TOKEN_IDENT || parser_kind_at(state, 1) == TOKEN_SELF) {
        parser_bump(state)
        sources := [String]{}
        loop {
            source: parser_current(state)
            if source.kind == TOKEN_SELF || (source.kind == TOKEN_IDENT && parser_value(state, source) == "self") {
                parser_bump(state)
                sources.push("self")
            } else if source.kind == TOKEN_IDENT {
                parser_bump(state)
                sources.push(parser_value(state, source))
            } else {
                break
            }
            // A projection names a field of the source; the requirement keys
            // on the owner name only.
            loop parser_current_kind(state) == TOKEN_DOT {
                parser_bump(state)
                if parser_current_kind(state) == TOKEN_IDENT -> parser_bump(state)
            }
            if parser_current_kind(state) != TOKEN_PIPE -> break
            parser_bump(state)
        }
        if sources.len() > 0 -> declared_from = Val(sources)
    }
    default := Expr?{None}
    if {
        parser_current_kind(state) == TOKEN_LBRACE -> {
            parser_bump(state)
            default = Val(parser_parse_expression(state, 1, 0).expr)
            parser_expect(state, TOKEN_RBRACE, "`}}` after the parameter default")
        }
        else -> {}
    }
    if variadic && default != None {
        param_name: parser_value(state, name)
        parser_add_error_code(state, "E1310", name.span, "variadic parameter `{param_name}` can't have a default value", "a `...` rest parameter collects trailing arguments — it can't also be optional", "remove the `{{…}}` default from the variadic parameter")
    }
    Param{convention: convention, root: root, name: parser_value(state, name), name_span: name.span, public_label: public_label, zone: zone, ty: ty, ty_span: ty_span, default: default, variadic: variadic, variadic_bound_list: variadic_bounds, declared_view_from_names: declared_from, declared_footprint: declared_footprint}
}

parser_parse_function: fn(state: &JetParserState, modifiers: ParsedItemModifiers, body_required: Bool) -> ParsedFunction {
    start: parser_bump(state)
    // Callable declarations share the contextual `.copy(...)` spelling; a
    // bare `copy` starts no expression.
    name: if parser_current_kind(state) == TOKEN_KW_COPY -> parser_bump(state) else -> parser_expect_name(state, "after `fn`")
    func_name := if name.kind == TOKEN_KW_COPY -> parser_text(state, name) else -> parser_value(state, name)
    func_name_span := name.span
    external_type := NamedSpan?{None}
    // `Type.method: fn(` attaches an external method.
    if parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        method: parser_expect_name(state, "after `.` in an external method name")
        external_type = Val(NamedSpan{name: func_name, span: name.span})
        func_name = parser_value(state, method)
        func_name_span = method.span
    }
    type_params := parser_parse_type_params(state)
    // S83: one bare variant head, `Circle(r: Float)` or `Empty()`, in place
    // of the parameter list; its payload parameters feed sema's dispatch fold.
    // A unit head is a variant name: `twice: fn(n)` is one untyped parameter
    // and reports the missing type, not a variant head.
    head_pattern := Pattern?{None}
    params := [Param]{}
    if parser_current_kind(state) == TOKEN_LPAREN && parser_kind_at(state, 1) == TOKEN_IDENT && (parser_kind_at(state, 2) == TOKEN_LPAREN || (parser_kind_at(state, 2) == TOKEN_RPAREN && parser_pascal_name(parser_value_at(state, 1)))) {
        parser_bump(state)
        variant: parser_expect_name(state, "for a multi-head variant")
        pattern_end := variant.span.end
        if parser_current_kind(state) == TOKEN_LPAREN {
            params = parser_parse_param_list(state)
            pattern_end = parser_lookahead(state, -1).span.end
        }
        parser_expect(state, TOKEN_RPAREN, "`)` after a multi-head variant")
        bindings := [PatSlot]{}
        loop param in params {
            if param.name == "_" {
                bindings.push(PatSlot.Wildcard)
            } else {
                bindings.push(PatSlot.Bind{name: param.name, span: param.name_span})
            }
        }
        head_pattern = Val(Pattern.Variant{variant: parser_value(state, variant), bindings: bindings, leading_dot: false, span: Span{start: variant.span.start, end: pattern_end}})
    } else {
        params = parser_parse_param_list(state)
    }
    // `x.copy()` and `x.move()` are the compiler's own
    // copy and take, so a method may not take either name (E0436). A module
    // function keeps it (`files.move(from, to)`).
    if (func_name == "copy" || func_name == "move") && params.len() > 0 && params[0].name == "self" {
        verb: if func_name == "copy" -> "copy" else -> "take"
        parser_add_error_code(state, "E0436", func_name_span, "a method can't be named `{func_name}`", "`x.{func_name}()` is the compiler's own {verb} of a named value, so a method with that name would be shadowed at every call", "rename the method and its calls, for example to `emit_{func_name}`")
    }
    signature: parser_parse_callable_result(state)
    return_type := signature.return_type
    return_type_span := signature.return_type_span
    declared_effects := signature.effects
    effect_via := signature.via
    declared_return_view: parser_parse_opt_declared_view_from(state, parser_view_owner_names(params))
    post_effect := false
    if declared_effects == None && effect_via == None && !signature.plain_arrow && parser_func_effect_starts_here(state) {
        post_effect = true
        effects: parser_parse_opt_func_effects(state)
        declared_effects = effects.effects
        effect_via = effects.via
    }
    effect_body_marker: post_effect || (return_type == None && (declared_effects != None || effect_via != None) && signature.prefix_effect)
    // The colon before a bare result is not a signature form.
    if parser_current_kind(state) == TOKEN_COLON {
        colon: parser_bump(state)
        if !parser_aborting(state) {
            diagnostic: diagnostic_from_registry("E0003", Val(colon.span), "a function return type uses `:`", "Jet uses `:` for parameter and field types; callable bodies use `->`", "replace `:` with `->` before the return type")
            state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: colon.span, new_text: "->"}))
        }
        if parser_type_starts_here(state) {
            parsed: parser_parse_type(state, 0)
            return_type = Val(parsed.ty)
            return_type_span = Val(parsed.span)
        }
    }
    guest_import: loop applied in modifiers.markers {
        if parser_marker_is_c_guest_import(applied) -> break true
    } ?? false
    is_ffi: loop applied in modifiers.markers {
        if applied.name == "FFI" -> break true
    } ?? false
    // (card #4512): a named function has one arrow, before its
    // result, and a braced body. A body `->` after the result, or an
    // expression right after the arrow, is E0080 and recovers to the same
    // body. An
    // `#FFI` function's body is its foreign source instead. A trait slot
    // (`body_required` false) has no effect-arrow body, as Rust
    // `trait_method_sig`: `f: fn() Never! -[FS]>` ends a bodiless requirement.
    marker_kind: parser_current_kind(state)
    marker_span: parser_current(state).span
    effect_body: body_required && !is_ffi && effect_body_marker && marker_kind != TOKEN_UNIFIED_ARROW && marker_kind != TOKEN_COLON && marker_kind != TOKEN_EQ
    teach_arrow_body: !guest_import
    arrow_marker: !is_ffi && !effect_body && teach_arrow_body && marker_kind == TOKEN_UNIFIED_ARROW
    body_marker: if {
        is_ffi -> false
        effect_body -> true
        else -> parser_parse_function_body_marker(state, guest_import)
    }
    retired_body := Stmt?{None}
    value_body := false
    if arrow_marker && parser_current_kind(state) == TOKEN_LBRACE -> parser_report_arrow_function_body(state, marker_span)
    if body_marker && parser_current_kind(state) != TOKEN_LBRACE {
        value_body = true
        if parser_function_body_missing(state) {
            missing: parser_current(state).span
            parser_add_error_code(state, "E0081", missing, "`{func_name}: fn` has no body", "Jet functions are defined, not declared: a signature without `{{ … }}` is not a complete function. Host and FFI cells use `#Import` / `#FFI` with their required body form.", "Add a `{{ … }}` block.")
        } else {
            if arrow_marker -> parser_report_arrow_function_body(state, marker_span)
            if effect_body && teach_arrow_body {
                body_span: parser_current(state).span
                parser_report_arrow_function_body(state, body_span)
            }
            value: parser_parse_expression(state, 1, 0)
            parser_finish_statement(state)
            retired_body = Val(Stmt.Expr{expr: value.expr})
        }
    }
    signature_end := parser_lookahead(state, -1).span
    func := ast_func(func_name, func_name_span, start.span)
    func.is_pub = modifiers.is_pub
    func.is_package_pub = modifiers.is_package_pub
    func.is_comptime = modifiers.is_comptime
    func.external_type = external_type
    func.type_params = type_params
    func.params = params
    func.return_type = return_type
    func.return_type_span = return_type_span
    func.declared_effects = declared_effects
    func.effect_via = effect_via
    func.declared_return_view_provenance = declared_return_view
    if declared_effects == .Val(row) {
        if row.len() == 0 -> func.is_pure = true
    }
    func.head_pattern = head_pattern
    func.markers = modifiers.markers
    has_body := false
    if {
        is_ffi -> {
            func.inline_foreign = parser_parse_inline_foreign_body(state, modifiers.markers)
            func.span = parser_cover(modifiers.start_span, parser_lookahead(state, -1).span)
            has_body = true
        }
        parser_current_kind(state) == TOKEN_LBRACE -> {
            // Marker lines directly in this body join the function's
            // markers; a nested block or a lambda body reads them as
            // statements, which report the Block site.
            outer_depth: state.inbody_marker_depth
            outer_markers: state.inbody_markers.copy()
            state.inbody_marker_depth = state.block_depth + 1
            state.inbody_markers = [Marker]{}
            body: parser_parse_callable_body(state, parser_return_type_has_value(return_type))
            inside: state.inbody_markers.copy()
            state.inbody_marker_depth = outer_depth
            state.inbody_markers = outer_markers
            func.body = body.statements
            func.span = parser_cover(modifiers.start_span, body.span)
            merged: parser_merge_inbody_markers(state, modifiers.markers, inside, modifiers.start_span.start, body.span.end - 1, "function `{func_name}`")
            func.markers = parser_drop_body_shaping_lines(state, merged)
            has_body = true
        }
        else -> {
            if retired_body == .Val(statement) {
                func.body = [Stmt]{statement}
                has_body = true
            }
            if body_required && !has_body && !value_body {
                body_span: parser_current(state).span
                parser_add_error_code(state, "E0081", body_span, "`{func_name}: fn` has no body", "Jet functions are defined, not declared: a signature without `{{ … }}` is not a complete function. Host and FFI cells use `#Import` / `#FFI` with their required body form.", "Add a `{{ … }}` block.")
            }
            if parser_current_kind(state) == TOKEN_SEMI -> signature_end = parser_bump(state).span
            func.span = parser_cover(modifiers.start_span, signature_end)
        }
    }
    // copy: the markers are read while the function they mark is updated.
    markers: func.markers.copy()
    parser_apply_function_markers(state, func, markers)
    if guest_import && !is_ffi -> parser_bind_guest_import_symbol(state, func)
    ParsedFunction{value: func, has_body: has_body}
}

// Rust `is_c_guest_import_marker`: the per-callable C import `#Import(c)`.
// Declared infallible: it is called inside the `guest_import` loop
// expression, which would otherwise carry its failure into the parser.
parser_marker_is_c_guest_import: fn(marker: Marker) -> Bool Never! {
    if marker.negated || marker.name != "Import" -> return false
    first: parser_marker_first_expr(marker) ?? return false
    if first == .Ident(name, _, _) -> return name == "c"
    false
}

// `#FFI` and `#Import(c)` decide how a function's body is read (as foreign
// source, or as the C symbol), so they are written above it.
parser_marker_shapes_body: fn(marker: Marker) -> Bool Never! {
    marker.name == "FFI" || parser_marker_is_c_guest_import(marker)
}

// A body-shaping line inside that body comes too late to shape it and is
// reported and left out.
parser_drop_body_shaping_lines: fn(state: &JetParserState, markers: [Marker]) -> [Marker] {
    kept := [Marker]{}
    loop marker in markers {
        if marker.inside && parser_marker_shapes_body(marker) {
            parser_add_error_code(state, "E0355", marker.span, "`#{marker.name}: …` cannot be written inside the body it shapes", "`#{marker.name}` decides how the function's body is read, so it must be known before the body starts", "write `#{parser_marker_above_text(marker)}` above the function")
            next
        }
        kept.push(marker)
    }
    kept
}

// (Rust `guest_import_fn_from_markers`): the one string body
// of an `#Import(c)` function names its C symbol. The symbol moves into the
// marker's compile-time fact and the Jet body is cleared, so it never reaches
// expression checking or codegen.
parser_bind_guest_import_symbol: fn(state: &JetParserState, func: &Func) {
    symbol := ""
    error_span := func.span
    if func.body.len() == 1 {
        if func.body[0] == .Expr(value) && value == .Str(parts, span, _) {
            error_span = span
            if parts.len() == 1 {
                if parts[0] == .Lit(text) -> symbol = text
            }
        }
    }
    if symbol == "" {
        parser_add_error_code(state, "E3212", error_span, "a `#Import(c)` declaration needs one non-empty symbol string", "the Jet signature is checked by sema and the string after `=` names the stable C symbol", "write `#Import(c) name: fn(args) -> Return = \"c_symbol\"`")
        return
    }
    loop index in 0..<func.markers.len() {
        if parser_marker_is_c_guest_import(func.markers[index]) {
            func.markers[index].ct = Val(CtValue.Str{value: symbol})
            break
        }
    }
    func.body = [Stmt]{}
}

// Rust Sema `guest_import_symbol`: the fixed C symbol the parser bound as the
// `#Import(c)` marker's compile-time fact. A missing or empty value is an
// invalid declaration (E3212 above), never an import. Sema and the Jetpack
// bridge read the binding through this one reader.
parser_guest_import_symbol: fn(function: Func) -> String? Never! {
    loop marker in function.markers {
        if !parser_marker_is_c_guest_import(marker) -> next
        if marker.ct == .Val(value) {
            if value == .Str(symbol) && symbol != "" -> return Val(symbol)
        }
        return None
    }
    None
}

ParsedFuncEffects: struct {
    effects: [EffectRowEntry]?
    via: NamedSpan?
}

ParsedCallableResult: struct {
    return_type: Type?
    return_type_span: Span?
    effects: [EffectRowEntry]?
    via: NamedSpan?
    prefix_effect: Bool
    // The result follows a plain `->` (not an effect arrow or a bare `E!`).
    plain_arrow: Bool
}

// The start of an effect arrow `-[`.
parser_func_effect_starts_here: fn(state: &JetParserState) -> Bool Never! {
    parser_current_kind(state) == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_LBRACKET
}

// The effect arrow after a
// callable's parameters, a declared bound `-[Net, DB]>` or the `-[via f]>`
// pass-through. Both halves are None when no effect arrow starts here.
parser_parse_opt_func_effects: fn(state: &JetParserState) -> ParsedFuncEffects {
    first: parser_current_kind(state)
    second: parser_kind_at(state, 1)
    if first != TOKEN_MINUS || second != TOKEN_LBRACKET -> return ParsedFuncEffects{effects: None, via: None}
    parser_bump(state)
    parser_expect(state, TOKEN_LBRACKET, "`[` to start an effect row")
    close: TOKEN_RBRACKET
    close_text: "`]` to close the effect row"
    via: parser_current(state)
    if via.kind == TOKEN_IDENT && parser_value(state, via) == "via" {
        parser_bump(state)
        param: parser_expect_name(state, "for the callback parameter name after `via`")
        parser_expect(state, close, close_text)
        parser_expect(state, TOKEN_GT, "`>` after the effect row")
        return ParsedFuncEffects{effects: None, via: Val(NamedSpan{name: parser_value(state, param), span: param.span})}
    }
    effects: parser_parse_effect_row_entries(state, close)
    parser_expect(state, close, close_text)
    parser_expect(state, TOKEN_GT, "`>` after the effect row")
    ParsedFuncEffects{effects: Val(effects), via: None}
}

// The entries of an effect row up to (not including) `close`: effect paths,
// `!Effect` prohibitions and `..Name` open rows.
parser_parse_effect_row_entries: fn(state: &JetParserState, close: Int) -> [EffectRowEntry] {
    effects := [EffectRowEntry]{}
    loop parser_current_kind(state) != close && !parser_aborting(state) {
        if parser_current_kind(state) == TOKEN_DOT_DOT {
            parser_bump(state)
            open_name: parser_expect_name(state, "for an open effect-row name")
            effects.push(EffectRowEntry{name: "..{parser_value(state, open_name)}", span: open_name.span})
        } else {
            prohibited: parser_current_kind(state) == TOKEN_BANG
            if prohibited -> parser_bump(state)
            entry: parser_expect_effect_path_name(state)
            if !prohibited && entry.name.contains("(") {
                parser_add_fatal_code(state, "E0119", entry.span, "`{entry.name}` is only valid as a memory denial", "the `above: Bytes` argument parameterizes a prohibition, not a positive effect bound", "write `-[!{entry.name}]>`")
                break
            }
            name: if prohibited -> "!{entry.name}" else -> entry.name
            effects.push(EffectRowEntry{name: name, span: entry.span})
        }
        if parser_current_kind(state) == close -> break
        parser_expect(state, TOKEN_COMMA, "`,` between effects in the row")
    }
    effects
}

// An effect path `ident (.ident)*`; the one
// parameterized entry is the bounded memory denial `Mem.Alloc(above: N)`.
parser_expect_effect_path_name: fn(state: &JetParserState) -> NamedSpan {
    first: parser_expect_name(state, "for an effect name")
    name := parser_value(state, first)
    end := first.span.end
    loop parser_current_kind(state) == TOKEN_DOT && !parser_aborting(state) {
        parser_bump(state)
        segment: parser_expect_name(state, "for an effect path segment after `.`")
        name = "{name}.{parser_value(state, segment)}"
        end = segment.span.end
    }
    if name == "Mem.Alloc" && parser_current_kind(state) == TOKEN_LPAREN {
        parser_bump(state)
        label: parser_expect_name(state, "for the memory denial argument name")
        label_name: parser_value(state, label)
        if label_name != "above" {
            parser_add_fatal_code(state, "E0119", label.span, "`Mem.Alloc` does not accept the argument `{label_name}`", "the bounded memory denial has one closed argument: `above: Bytes`", "write `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        parser_expect(state, TOKEN_COLON, "`:` after `above`")
        value: parser_bump(state)
        if value.kind != TOKEN_INT {
            parser_add_fatal_code(state, "E0119", value.span, "`Mem.Alloc(above: …)` needs an integer byte ceiling", "the bounded denial is checked at compile time and accepts a positive byte count", "write `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        bytes: parser_integer(state, value) ?? 0
        if bytes <= 0 {
            parser_add_fatal_code(state, "E0119", value.span, "`Mem.Alloc(above: …)` needs a positive byte ceiling", "zero cannot bound a usable memory region", "write a positive byte count, such as `Mem.Alloc(above: 65536)`")
            return NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
        }
        close: parser_expect(state, TOKEN_RPAREN, "`)` after the memory denial argument")
        name = "{name}(above: {bytes})"
        end = close.span.end
    }
    NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
}

// Rust `type_starts_here`, with the `#Tag Type` value-tag prefix.
parser_type_starts_here: fn(state: &JetParserState) -> Bool Never! {
    kind: parser_current_kind(state)
    parser_type_starts(kind) || parser_type_tag_ahead(state)
}

parser_is_unit_fallible: fn(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) -> return ok == (Type.Named{name: "Unit"})
    false
}

// A unit-fallible result written after the parameters
// (`IOError!`, `(A | B)!`).
parser_parse_unit_fallible_return: fn(state: &JetParserState) -> ParsedType? {
    start: parser_current(state).span
    if parser_suffix_contract_ahead(state) < 0 -> return None
    error_type: parser_parse_suffix_contract(state, 1)
    Val(ParsedType{ty: Type.Result{ok: Type.Named{name: "Unit"}, err: error_type.ty}, span: parser_cover(start, error_type.span)})
}

// A result after `->` or `-[E]>` is a type only when a
// declaration-body boundary follows it, so `-> n * 2` stays an expression.
parser_result_type_follows_arrow: fn(state: &JetParserState) -> Bool {
    saved_position: state.position
    saved_diagnostics: state.diagnostics.len()
    saved_blocks: state.block_spans.len()
    saved_else_arms: state.else_arms.len()
    saved_type_gt: state.pending_type_gt
    saved_type_gt_span: Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.end}
    saved_semicolon: state.explicit_semicolon_reported
    parsed: parser_parse_type(state, 0)
    failed: parser_aborting(state) && state.abort_mark > saved_diagnostics
    next: parser_current(state)
    kind: next.kind
    // `-> T -[E]>` also ends the result: a second (effect) arrow. A one-line
    // trait slot ends at the enclosing `}`.
    boundary: kind == TOKEN_COLON || kind == TOKEN_EQ || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_SEMI || kind == TOKEN_COMMA || kind == TOKEN_RPAREN || (kind == TOKEN_LBRACE && parsed.span.end < next.span.start) || (kind == TOKEN_IDENT && parser_value(state, next) == "from") || (kind == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_LBRACKET) || kind == TOKEN_RBRACE
    parser_rewind(state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    state.pending_type_gt = saved_type_gt
    state.pending_type_gt_span = saved_type_gt_span
    state.explicit_semicolon_reported = saved_semicolon
    !failed && boundary
}

// The result after the one arrow. Current forms are `-> T`,
// `-[E]> T`, unit `-[E]>` and unit-fallible `E!`. A `->` with no type after it is left for the
// body parser, so `f: fn() -> expr` still reads as a one-line body.
parser_parse_callable_result: fn(state: &JetParserState) -> ParsedCallableResult {
    prefix_effect: parser_func_effect_starts_here(state)
    effects: parser_parse_opt_func_effects(state)
    arrow_return := false
    plain_arrow := false
    result := ParsedType?{None}
    if {
        effects.effects != None || effects.via != None -> {
            arrow_return = true
            result = if parser_result_type_follows_arrow(state) -> Val(parser_parse_type(state, 0)) else -> parser_parse_unit_fallible_return(state)
        }
        parser_at_unified_arrow(state) -> {
            before: state.position
            parser_bump(state)
            if parser_result_type_follows_arrow(state) {
                arrow_return = true
                plain_arrow = true
                result = Val(parser_parse_type(state, 0))
            } else {
                result = parser_parse_unit_fallible_return(state)
                if parser_has_type(result) {
                    arrow_return = true
                    plain_arrow = true
                } else {
                    state.position = before
                }
            }
        }
        else -> {
            result = parser_parse_unit_fallible_return(state)
        }
    }
    return_type := Type?{None}
    return_type_span := Span?{None}
    if result == .Val(parsed) {
        return_type = Val(parsed.ty)
        return_type_span = Val(parsed.span)
        if arrow_return && parser_is_unit_fallible(parsed.ty) {
            parser_add_error_code(state, "E0003", parsed.span, "a unit-fallible signature has no `->`", "a function that can fail but returns no value has no result payload for an arrow to introduce", "write `save: fn(path: String) IOError!`, or omit the contract for implicit `Err`")
        }
    }
    ParsedCallableResult{return_type: return_type.move(), return_type_span: return_type_span.move(), effects: effects.effects, via: effects.via, prefix_effect: prefix_effect.move(), plain_arrow: plain_arrow}
}

// The marker that opens a recovered one-line function body. A `->` here is
// E0080 at the caller; an `#Import(c)` function binds its C symbol with `=`,
// where a `->` is the wrong marker (E3261).
parser_parse_function_body_marker: fn(state: &JetParserState, guest_import: Bool) -> Bool {
    token: parser_current(state)
    if token.kind == TOKEN_UNIFIED_ARROW {
        parser_bump(state)
        if guest_import {
            parser_add_error_code(state, "E3261", token.span, "`#Import(c)` function uses a non-canonical body marker", "`#Import(c)` binds a compile-time C symbol; `->` is a Jet function-body marker and cannot declare a foreign symbol", "write `#Import(c) name: fn(args) -> Return = \"symbol\"`")
        }
        return true
    }
    if token.kind != TOKEN_EQ || !guest_import -> return false
    parser_bump(state)
    true
}

// (card #4512): E0080 for a named function body after an arrow.
parser_report_arrow_function_body: fn(state: &JetParserState, span: Span) {
    parser_add_error_code(state, "E0080", span, "This named function body follows an arrow instead of braces.", "A named function has one arrow, `->` or `-[Effects]>`, followed by its optional return type; the body always sits in braces: `name: fn(...) -> Type {{ … }}`.", "Replace `-> expr` with `{{ expr }}`; `jet fmt` applies this fix.")
}

// (card #501): a `#FFI(<lang>) fn` body is exactly one
// non-interpolated string of foreign source; anything else is E0064. The
// braced body follows the one arrow and its result; a second `->` is E0080.
parser_parse_inline_foreign_body: fn(state: &JetParserState, markers: [Marker]) -> InlineForeign? {
    ffi := markers[0]
    loop applied in markers {
        if applied.name == "FFI" -> ffi = applied
    }
    lang := ""
    lang_span := ffi.span
    if parser_marker_first_expr(ffi) == .Val(argument) {
        if argument == .Ident(name, span, _) {
            lang = name
            lang_span = span
        }
    }
    if lang == "" {
        parser_marker_shape_fatal(state, ffi)
        return None
    }
    if parser_current_kind(state) == TOKEN_UNIFIED_ARROW {
        arrow_span: parser_bump(state).span
        parser_report_arrow_function_body(state, arrow_span)
    }
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `#FFI` foreign-source body")
    parser_skip_semicolons(state)
    source: parser_current(state)
    plain: source.kind == TOKEN_RAW_STRING || (source.kind == TOKEN_STRING && parser_interpolations(state, source) == 0)
    if source.kind == TOKEN_STRING || source.kind == TOKEN_RAW_STRING -> parser_bump(state)
    if !plain {
        error_span: if source.kind == TOKEN_STRING -> source.span else -> ffi.span
        parser_add_fatal_code(state, "E0064", error_span, "a `#FFI({lang})` function body must be one string of {lang} source", "the inline foreign tier carries the foreign source as a single `\"\"\"…\"\"\"` string; the Jet signature above is the checked contract", "write the body as `{{ \"\"\"<{lang} source>\"\"\" }}` — one string literal, no other statements or interpolation")
        return None
    }
    parser_skip_semicolons(state)
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the `#FFI` foreign-source body")
    Val(InlineForeign{lang: lang, lang_span: lang_span, marker_span: ffi.span, source: parser_value(state, source), source_span: source.span})
}

// An optional `from src (| src)*` or `from (slot: srcs, …)`
// after a return type. A source names one of `owners` (the non-`self`
// parameters, by position), the receiver `self`, or `static.path.Name`,
// optionally projected through fields.
parser_parse_opt_declared_view_from: fn(state: &JetParserState, owners: [String]) -> ViewProvenanceMap? {
    token: parser_current(state)
    if !(token.kind == TOKEN_IDENT && parser_value(state, token) == "from") -> return None
    next: parser_kind_at(state, 1)
    if next != TOKEN_IDENT && next != TOKEN_SELF && next != TOKEN_LPAREN -> return None
    parser_bump(state)
    if parser_current_kind(state) != TOKEN_LPAREN {
        sources: parser_parse_declared_view_sources(state, owners)
        return Val(ViewProvenanceMap{entries: [ViewProvenanceEntry]{ViewProvenanceEntry{slot: [String]{}, value: ViewProvenance{sources: sources, mutable: false}}}})
    }
    parser_bump(state)
    entries := [ViewProvenanceEntry]{}
    loop {
        kind: parser_current_kind(state)
        if kind == TOKEN_RPAREN || kind == TOKEN_EOF -> break
        if kind != TOKEN_IDENT {
            parser_bump(state)
            break
        }
        slot: parser_bump(state)
        if parser_current_kind(state) != TOKEN_COLON -> break
        parser_bump(state)
        sources: parser_parse_declared_view_sources(state, owners)
        entries.push(ViewProvenanceEntry{slot: [String]{parser_value(state, slot)}, value: ViewProvenance{sources: sources, mutable: false}})
        if parser_current_kind(state) != TOKEN_COMMA -> break
        parser_bump(state)
    }
    if parser_current_kind(state) == TOKEN_RPAREN -> parser_bump(state)
    Val(ViewProvenanceMap{entries: entries})
}

parser_parse_declared_view_sources: fn(state: &JetParserState, owners: [String]) -> [ViewSourcePath] {
    sources := [ViewSourcePath]{}
    loop {
        parsed: parser_parse_declared_view_source(state, owners)
        if parsed == .Val(path) {
            sources.push(path)
        } else {
            break
        }
        if parser_current_kind(state) != TOKEN_PIPE -> break
        parser_bump(state)
    }
    sources
}

parser_parse_declared_view_source: fn(state: &JetParserState, owners: [String]) -> ViewSourcePath? {
    token: parser_current(state)
    source := ViewSource.Receiver
    if {
        token.kind == TOKEN_SELF || (token.kind == TOKEN_IDENT && parser_value(state, token) == "self") -> parser_bump(state)
        token.kind == TOKEN_IDENT && parser_value(state, token) == "static" -> {
            parser_bump(state)
            if parser_current_kind(state) != TOKEN_DOT -> return None
            parser_bump(state)
            if parser_current_kind(state) != TOKEN_IDENT -> return None
            module_path := ""
            name_token := parser_bump(state)
            name := parser_value(state, name_token)
            loop parser_current_kind(state) == TOKEN_DOT {
                parser_bump(state)
                if parser_current_kind(state) != TOKEN_IDENT -> break
                module_path = if module_path == "" -> name else -> "{module_path}.{name}"
                name_token = parser_bump(state)
                name = parser_value(state, name_token)
            }
            source = ViewSource.Static{module_path: module_path, name: name}
        }
        token.kind == TOKEN_IDENT -> {
            parser_bump(state)
            index := -1
            loop position in 0..<owners.len() {
                if owners[position] == parser_value(state, token) {
                    index = position
                    break
                }
            }
            if index < 0 -> return None
            source = ViewSource.Parameter{index: index}
        }
        else -> return None
    }
    projections := [ViewSourceProjection]{}
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        if parser_current_kind(state) != TOKEN_IDENT -> break
        field: parser_bump(state)
        projections.push(ViewSourceProjection.Field{name: parser_value(state, field)})
    }
    Val(ViewSourcePath{source: source, projections: projections})
}

// The parameters a declared view source may name: every one but the receiver.
parser_view_owner_names: fn(params: [Param]) -> [String] Never! {
    owners := [String]{}
    loop param in params {
        if param.name != "self" -> owners.push(param.name)
    }
    owners
}

// A one-line body is missing when the next token already starts another
// declaration or closes the enclosing scope (`#Todo` is a value body).
parser_function_body_missing: fn(state: &JetParserState) -> Bool Never! {
    kind: parser_current_kind(state)
    if kind == TOKEN_HASH -> return !(parser_kind_at(state, 1) == TOKEN_IDENT && parser_value_at(state, 1) == "Todo")
    kind == TOKEN_KW_FN || kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_USE || kind == TOKEN_KW_EXTERN || kind == TOKEN_EOF || kind == TOKEN_RBRACE || kind == TOKEN_SEMI
}

// A unit or unit-fallible (`E!`) result carries no value, so the body's final
// line stays a statement.
parser_return_type_has_value: fn(return_type: Type?) -> Bool Never! {
    ty: return_type ?? return false
    if ty == {
        .Named(name) -> name != "Unit"
        .Result(ok, _) -> ok != (Type.Named{name: "Unit"})
        else -> true
    }
}

// Rust `apply_callable_markers`: the typed projections of the function rules,
// applied once the function is parsed. The marker list itself stays on the
// function. A rule with no projection here projects nothing; sema reports an
// unknown rule (E0927). A refused rule ends the
// function (a fatal diagnostic), as Rust's applicator returns its error.
parser_apply_function_markers: fn(state: &JetParserState, func: &Func, markers: [Marker]) {
    policy := [PolicyDeclaration]{}
    callable_policy_seen := false
    guest_import: loop applied in markers {
        if parser_marker_is_c_guest_import(applied) -> break true
    } ?? false
    foreign: guest_import || func.inline_foreign != None
    loop marker in markers {
        if marker.name == {
            "Unsafe" -> {
                func.is_unsafe = true
                func.unsafe_span = Val(marker.span)
                first := parser_marker_first_expr(marker)
                if first == .Val(reason) -> func.unsafe_reason = parser_expr_literal_string(reason)
                if parser_unsafe_obligation_policy(state, marker, PolicyScope.Function, func.span) == .Val(declaration) {
                    state.block_policy_declarations.push(declaration)
                }
            }
            "Reactive" -> {
                if marker.args.len() == 0 -> func.is_reactive = true
            }
            "Replayable" -> {
                if marker.args.len() == 0 {
                    func.is_replayable = true
                    func.replayable_span = Val(marker.span)
                }
            }
            "MustUse" -> {
                if marker.args.len() == 0 {
                    func.is_must_use = true
                    func.must_use_span = Val(marker.span)
                }
            }
            "WasmExport" -> {
                if marker.args.len() == 0 -> func.web_marker = Val(WebPartitionMarker.WasmExport)
            }
            // `#Scrub(Tag)` names the one fact tag removed.
            "Scrub" -> {
                if parser_marker_bindings(marker, [String]{"tag"}) == .Val(values) {
                    if values[0] == .Val(written) && written == .Ident(name, _, _) -> func.scrub_tag = Val(name)
                }
            }
            // Bare `#Inline` is a hint; `#Inline(Always)`
            // is the checked promise. A written `Hint` or `Never` mode is
            // E0930 here (Rust `apply_callable_markers`); sema's menu check
            // reports any other value.
            "Inline" -> {
                func.inline_span = Val(marker.span)
                mode := Expr?{None}
                if parser_marker_bindings(marker, [String]{"mode"}) == .Val(values) -> mode = values[0]
                if mode == {
                    .Val(value) -> {
                        variant: parser_marker_enum_variant(value)
                        if {
                            variant == "Always" -> func.is_inline_always = true
                            variant == "Hint" || variant == "Never" -> parser_marker_shape_error(state, marker)
                            else -> {}
                        }
                    }
                    else -> func.is_inline = true
                }
            }
            // (Rust `apply_callable_markers`): `#Pre(cond, msg)` and
            // `#Post(cond, msg)` become the function's contract clauses; both
            // arguments are required.
            "Pre" -> parser_project_contract_marker(state, func, marker, true)
            "Post" -> parser_project_contract_marker(state, func, marker, false)
            // A callable chain (`#Policy(retry(3))`) stays a marker; the scoped
            // form declares function-scoped policies targeting the function.
            "Policy" -> {
                if parser_callable_policy_marker(marker) {
                    if callable_policy_seen {
                        parser_add_fatal_code(state, "E0355", marker.span, "a function can have only one `#Policy` callable chain", "the declaration marker supplies one default chain; a call-site `apply(...)` supplies replacements", "merge the policies into one `#Policy(...)` marker")
                        return
                    }
                    callable_policy_seen = true
                } else {
                    declarations: parser_policy_declarations_from_marker(state, marker, PolicyScope.Function) ?? return
                    loop declaration in declarations -> policy.push(declaration)
                }
            }
            "Meta" -> {
                if func.meta != None {
                    parser_add_fatal_code(state, "E0355", marker.span, "a function can have only one `#Meta` rule", "metadata fields belong in one function marker", "merge the fields into one `#Meta(...)` entry")
                    return
                }
                meta: parser_meta_attr_from_marker(state, marker) ?? return
                loop field in meta.fields {
                    if field == .Maturity(value, span) && parser_maturity_tag(value) == .Val(maturity) {
                        func.maturity = Val(maturity)
                        func.maturity_span = Val(span)
                        break
                    }
                }
                func.meta = Val(meta)
            }
            // The explicit kernel declaration; sema attaches the proof after
            // it has checked the body.
            "Kernel" -> {
                if func.kernel != None {
                    parser_add_fatal_code(state, "E0003", marker.span, "a function may have only one `#Kernel` marker", "the kernel mode is a single declaration, not a stack of execution policies", "keep one `#Kernel(.parallel)` marker")
                    return
                }
                values: parser_marker_bindings(marker, [String]{"mode"}) ?? [Expr?]{None}
                if values[0] == .Val(mode) && parser_marker_enum_variant(mode) == "parallel" {
                    func.kernel = Val(KernelMarker{mode: KernelMode.Parallel, span: marker.span, proof: None})
                } else {
                    parser_marker_shape_fatal(state, marker)
                    return
                }
            }
            "State" -> {
                paths: parser_marker_path_arguments(marker, [String]{"state"}) ?? {
                    parser_marker_shape_fatal(state, marker)
                    return
                }
                func.state_requires = Val(NamedSpan{name: paths[0], span: marker.span})
            }
            // `_` as the source state is the entry transition.
            "Transition" -> {
                paths: parser_marker_path_arguments(marker, [String]{"from", "to"}) ?? {
                    parser_marker_shape_fatal(state, marker)
                    return
                }
                from: if paths[0] == "_" -> String?{None} else -> Val(paths[0])
                func.state_transition = Val(StateTransition{from: from, to: paths[1], span: marker.span})
            }
            "Undo" -> {
                values: parser_marker_bindings(marker, [String]{"inverse"}) ?? [Expr?]{None}
                if values[0] == .Val(written) && written == .Ident(inverse, span, _) {
                    func.undo = Val(NamedSpan{name: inverse, span: span})
                } else {
                    parser_marker_shape_fatal(state, marker)
                    return
                }
            }
            "Target" -> {
                partition: parser_function_web_partition(state, marker) ?? return
                func.web_marker = Val(partition)
            }
            // C declarations select their calling convention; foreign bodies
            // never reach this applicator in Rust.
            "ABI" -> {
                if !foreign {
                    parser_add_fatal_code(state, "E3212", marker.span, "`#ABI` only applies to C declarations", "ordinary Jet functions do not select a native C calling convention", "move the function into a `#Import c.<library>: module {{ … }}` declaration or remove `#ABI`")
                    return
                }
            }
            else -> {}
        }
    }
    // `#Job` metadata and its `#Every` schedule (E0925).
    _ := parser_project_function_job_markers(state, func, markers)
    loop index in 0..<policy.len() -> policy[index].target = Val(func.span)
    loop declaration in policy -> state.block_policy_declarations.push(declaration)
}

// The `#State` / `#Transition` arguments: one written state path per
// parameter, all required. None when any is missing or not a path.
parser_marker_path_arguments: fn(marker: Marker, names: [String]) -> [String]? {
    values: parser_marker_bindings(marker, names) ?? return None
    paths := [String]{}
    loop value in values {
        written: value ?? return None
        paths.push(parser_marker_ident_path(written) ?? return None)
    }
    Val(paths)
}

// Rust `web_target_from_marker` at a function: `#Target(Wasm)` or
// `#Target(JS)` selects its web partition; any other target ends the function.
parser_function_web_partition: fn(state: &JetParserState, marker: Marker) -> WebPartitionMarker? {
    values: parser_marker_bindings(marker, [String]{"target"}) ?? [Expr?]{None}
    target: values[0] ?? {
        parser_marker_shape_fatal(state, marker)
        return None
    }
    name: parser_marker_target_path(target) ?? {
        parser_marker_shape_fatal(state, marker)
        return None
    }
    if name == "Wasm" -> return Val(WebPartitionMarker.Wasm)
    if name == "JS" -> return Val(WebPartitionMarker.JS)
    segments: name.split(".").to_list()
    if segments.len() > 1 && segments[0] == "OS" {
        os: segments[1..<segments.len()].join(".")
        if os != "Linux" && os != "MacOS" && os != "Windows" {
            parser_add_fatal_code(state, "E0003", expr_span(target), "`#Target(OS.{os})` is not a known native OS", "native OS targets are `OS.Linux`, `OS.MacOS`, or `OS.Windows`", "write `#Target(OS.Linux)`, `#Target(OS.MacOS)`, or `#Target(OS.Windows)`")
            return None
        }
    } else if name != "Web" {
        parser_add_fatal_code(state, "E0003", expr_span(target), "`#Target({name})` is not a known web partition", "web targets are `Wasm` (compute), `JS` (DOM/view), `Web` (default CLI backend), or `OS.Linux`/`OS.MacOS`/`OS.Windows` (native platform gating)", "write `#Target(Wasm)`, `#Target(JS)`, `#Target(Web)`, or `#Target(OS.{{Linux|MacOS|Windows}})`")
        return None
    }
    parser_add_fatal_code(state, "E0003", marker.span, "`#Target` on a function needs `Wasm` or `JS`", "function target rules select one web partition", "write `#Target(Wasm)` or `#Target(JS)`")
    None
}

parser_project_contract_marker: fn(state: &JetParserState, func: &Func, marker: Marker, pre: Bool) {
    clause: parser_contract_clause(state, marker) ?? return
    if pre {
        func.pre.push(clause)
    } else {
        func.post.push(clause)
    }
}

// The clause of `#Pre(cond, msg)` or `#Post(cond, msg)`; both arguments are
// required, so another shape is its marker shape error.
parser_contract_clause: fn(state: &JetParserState, marker: Marker) -> ContractClause? {
    values: parser_marker_bindings(marker, [String]{"condition", "message"}) ?? [Expr?]{}
    if values.len() == 2 && values[0] == .Val(condition) && values[1] == .Val(message) {
        return Val(ContractClause{cond: condition, message_expr: message, message_span: expr_span(message), span: marker.span})
    }
    parser_marker_shape_error(state, marker)
    None
}

parser_parse_struct: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> StructDef {
    start: parser_bump(state)
    name: parser_expect_name(state, "after `struct`")
    value := ast_struct(parser_value(state, name), name.span, start.span)
    value.is_pub = modifiers.is_pub
    value.is_package_pub = modifiers.is_package_pub
    value.type_params = parser_parse_type_params(state)
    if parser_current_kind(state) != TOKEN_LBRACE {
        parser_apply_struct_markers(state, value, modifiers.markers, modifiers.grouped_markers)
        parser_add_error_here(state, "expected `{{` before struct fields", "record fields are declared inside a struct body", "open a struct body with `{{`")
        return value
    }
    parser_bump(state)
    inside := [Marker]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        member_start: state.position
        member_modifiers := parser_parse_item_modifiers(state, false)
        if parser_state_section_ahead(state) {
            type_name: parser_value(state, name)
            section := parser_parse_state_section(state, type_name, name.span)
            if value.state == {
                .None -> value.state = Val(section)
                else -> parser_report_repeated_state_section(state, section, type_name)
            }
            if parser_current_kind(state) == TOKEN_COMMA || parser_current_kind(state) == TOKEN_SEMI -> parser_bump(state)
            next
        }
        if parser_take_prep_fn(state) -> member_modifiers.is_comptime = true
        // (Rust `cli_binding_starts_here` / `cli_binding`):
        // `name = callable` binds a program-struct command to a function; it
        // is a command member, never a stored field.
        if parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_EQ {
            command_name: parser_bump(state)
            parser_bump(state)
            target: parser_parse_expression(state, 1, 0)
            value.cli_bindings.push(CLICommandBinding{name: parser_value(state, command_name), name_span: command_name.span, markers: member_modifiers.markers, target: target.expr})
            if parser_current_kind(state) == TOKEN_COMMA || parser_current_kind(state) == TOKEN_SEMI -> parser_bump(state)
            next
        }
        // (Rust `at_validate_block` / `validate_block`):
        // `validate { … }` holds the struct's rule statements as an ordinary
        // block; sema restricts and synthesizes them (sema_validate_blocks).
        if parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_LBRACE && parser_value_at(state, 0) == "validate" {
            keyword: parser_bump(state)
            block: parser_parse_block(state)
            value.validate_block = block.statements
            value.validate_span = Val(parser_cover(keyword.span, block.span))
            next
        }
        if parser_current_kind(state) == {
            TOKEN_KW_FN -> {
                method: parser_parse_function(state, member_modifiers, true)
                value.methods.push(method.value)
            }
            TOKEN_KW_IMPL -> {
                if {
                    parser_value_at(state, 1) == "Marker" && parser_kind_at(state, 2) == TOKEN_LBRACE -> parser_parse_marker_impl(state, value)
                    parser_value_at(state, 1) == "Effect" && parser_kind_at(state, 2) == TOKEN_LBRACE -> {
                        parsed: parser_parse_effect_impl(state, value.name, value.effect_impl != None)
                        if parsed != None -> value.effect_impl = parsed
                    }
                    else -> value.trait_impls.push(parser_parse_trait_impl_block(state, member_modifiers.markers))
                }
            }
            else -> {
                field_markers := member_modifiers.markers
                field_pub := member_modifiers.is_pub
                field_package_pub := member_modifiers.is_package_pub
                field_name: parser_struct_field_name(state)
                parser_expect(state, TOKEN_COLON, "`:` after a struct field name")
                field_type: parser_parse_type(state, 0)
                computed := Expr?{None}
                default := Expr?{None}
                default_kind := parser_current_kind(state)
                if {
                    // `name: T -> expr` is a computed field;
                    // sema rewrites sibling field names to `self.<field>`.
                    parser_at_unified_arrow(state) -> {
                        parser_bump(state)
                        parsed_value: parser_parse_expression(state, 1, 0)
                        computed = Val(parsed_value.expr)
                    }
                    default_kind == TOKEN_COLON_EQ || default_kind == TOKEN_EQ -> {
                        parser_bump(state)
                        parsed_value: parser_parse_expression(state, 1, 0)
                        default = Val(parsed_value.expr)
                    }
                    parser_current_kind(state) == TOKEN_LBRACE -> {
                        parser_bump(state)
                        parsed_value: parser_parse_expression(state, 1, 0)
                        parser_expect(state, TOKEN_RBRACE, "`}}` after a struct field default")
                        default = Val(parsed_value.expr)
                    }
                }
                redact := false
                marker_index := 0
                loop marker_index < field_markers.len() {
                    if field_markers[marker_index].name == "Redact" -> redact = true
                    if field_markers[marker_index].name == "Computed" {
                        first := parser_marker_first_expr(field_markers[marker_index])
                        if first == .Val(computed_expr) -> computed = Val(computed_expr)
                    }
                    marker_index += 1
                }
                value.fields.push(Field{is_pub: field_pub, is_package_pub: field_package_pub, name: parser_value(state, field_name), name_span: field_name.span, ty: field_type.ty, ty_span: field_type.span, serde_markers: field_markers, redact: redact, computed: computed.move(), default: default.move(), default_ct: None})
                separator_kind := parser_current_kind(state)
                if separator_kind == TOKEN_COMMA || separator_kind == TOKEN_SEMI -> parser_bump(state)
            }
        }
        // A member's own separator is optional (a field may end at `}`), so
        // only a member that consumed nothing is reported and skipped.
        if state.position == member_start && !parser_aborting(state) {
            parser_add_error_here(state, "expected a separator between struct members", "struct fields and methods are separated by commas or statement terminators", "add a separator or close the struct")
            parser_recover_statement(state)
        }
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after struct fields")
    value.span = parser_cover(modifiers.start_span, close.span)
    markers: parser_merge_inbody_markers(state, modifiers.markers, inside, modifiers.start_span.start, close.span.start, "struct `{value.name}`")
    parser_apply_struct_markers(state, value, markers, modifiers.grouped_markers)
    parser_finish_marker_struct(state, value)
    value.effect_impl = parser_finish_effect_type(state, value.name, value.name_span, value.effect_impl, [Variant]{})
    value
}

// Rust `attach_type_markers`: the markers, the derives and serde markers they
// request, the package auto-derive default and the SingleUse/MustUse/
// PublishedSchema facts. They apply once the whole body is read, so a marker
// line anywhere in the body counts the same as the markers above.
parser_apply_struct_markers: fn(state: &JetParserState, value: &StructDef, markers: [Marker], grouped: Bool) {
    parser_apply_struct_type_markers(value, markers)
    value.layout = parser_layout_marker_fact(state, markers, grouped, false)
    value.layout_span = parser_layout_marker_span(markers, grouped, value.layout)
    value.layout_alignment_span = if value.layout != None -> parser_layout_alignment_span(markers) else -> None
}

// A struct field name; a keyword followed by `:` names a field too (a
// marker's `use` argument).
parser_struct_field_name: fn(state: &JetParserState) -> Token {
    token: parser_current(state)
    if token.kind != TOKEN_IDENT && token.kind != TOKEN_KW_TAG && parser_kind_at(state, 1) == TOKEN_COLON && parser_is_keyword_token(state, token) {
        parser_bump(state)
        spelling: parser_text(state, token)
        return parser_spelled_token(state, TOKEN_IDENT, token.span, spelling)
    }
    parser_expect_name(state, "in a struct field")
}

parser_parse_enum: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> EnumDef {
    start: parser_bump(state)
    name: parser_expect_name(state, "after `enum`")
    value := ast_enum(parser_value(state, name), name.span, start.span)
    value.is_pub = modifiers.is_pub
    value.is_package_pub = modifiers.is_package_pub
    value.type_params = parser_parse_type_params(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` before enum variants")
    inside := [Marker]{}
    // A fatal error ends the whole enum, as Rust's `?` does; the item loop
    // resynchronizes.
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        if parser_current_kind(state) == TOKEN_SEMI {
            parser_bump(state)
            next
        }
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        if parser_state_section_ahead(state) {
            section_start: parser_current(state).span
            section := parser_parse_state_section(state, "", section_start)
            parser_report_ineligible_state_section(state, section, "enum")
            next
        }
        if parser_method_starts_here(state) {
            value.methods.push(parser_parse_type_method(state))
            next
        }
        kind: parser_current_kind(state)
        markers: if kind == TOKEN_HASH -> parser_parse_variant_markers(state) else -> [Marker]{}
        if {
            kind == TOKEN_KW_IMPL && parser_value_at(state, 1) == "Effect" && parser_kind_at(state, 2) == TOKEN_LBRACE -> {
                parsed: parser_parse_effect_impl(state, value.name, value.effect_impl != None)
                if parsed != None -> value.effect_impl = parsed
            }
            kind == TOKEN_KW_IMPL -> value.trait_impls.push(parser_parse_trait_impl_block(state, markers))
            else -> parser_parse_variant_entry(state, "", value, markers, inside)
        }
        if parser_current_kind(state) == TOKEN_SEMI -> parser_bump(state)
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after enum variants")
    value.span = parser_cover(modifiers.start_span, close.span)
    // Rust `attach_type_markers`, as for structs: markers, derives, serde
    // markers, the package auto-derive default and SingleUse/MustUse, applied
    // once the body (and every marker line in it) is read.
    markers: parser_merge_inbody_markers(state, modifiers.markers, inside, modifiers.start_span.start, close.span.start, "enum `{value.name}`")
    parser_apply_enum_type_markers(value, markers)
    _ := parser_layout_marker_fact(state, markers, modifiers.grouped_markers, true)
    value.effect_impl = parser_finish_effect_type(state, value.name, value.name_span, value.effect_impl, value.variants)
    value
}

// A method inside a type body: `fn`, `pub fn`, `comptime fn`, or `pub comptime fn`.
parser_method_starts_here: fn(state: &JetParserState) -> Bool Never! {
    parser_current_kind(state) == TOKEN_KW_FN || parser_prep_fn_ahead(state) || (parser_current_kind(state) == TOKEN_KW_PUB && (parser_kind_at(state, 1) == TOKEN_KW_FN || parser_prep_verb_ahead(state, 1, TOKEN_KW_FN)))
}

parser_parse_type_method: fn(state: &JetParserState) -> Func {
    modifiers := parser_parse_item_modifiers(state, false)
    if parser_take_prep_fn(state) -> modifiers.is_comptime = true
    parser_parse_function(state, modifiers, true).value
}

// 7 + the markers on one variant, bare `#Name` markers or
// `#[…]` lists; two distinct rules belong in one list (E0999).
parser_parse_variant_markers: fn(state: &JetParserState) -> [Marker] {
    markers := [Marker]{}
    chunks := 0
    bracket_chunks := 0
    sequence := parser_current(state).span
    loop parser_current_kind(state) == TOKEN_HASH && !parser_aborting(state) {
        if parser_kind_at(state, 1) == TOKEN_LBRACKET {
            group: parser_parse_marker_group_list(state)
            loop marker in group.markers -> markers.push(marker)
            sequence.end = group.span.end
            bracket_chunks += 1
        } else {
            marker: parser_parse_marker(state)
            markers.push(marker)
            sequence.end = marker.span.end
            parser_skip_semicolons(state)
        }
        chunks += 1
    }
    parser_report_adjacent_markers(state, markers, chunks, bracket_chunks, sequence, "variant")
    markers
}

// One enum-body entry, a leaf variant or a variant group
// `Name { … }`. Leaves are recorded flat with their full dotted path and each
// group path in `groups`; groups nest to any depth. Payloads live on leaves
// only (E0331).
parser_parse_variant_entry: fn(state: &JetParserState, prefix: String, value: &EnumDef, markers: [Marker], inside: &[Marker]) {
    name: parser_expect_name(state, "for a variant name")
    if parser_aborting(state) -> return
    path: if prefix.len() == 0 -> parser_value(state, name) else -> "{prefix}.{parser_value(state, name)}"
    payload := VariantPayload.Unit
    if parser_current_kind(state) == TOKEN_LPAREN {
        open: parser_bump(state)
        parsed: parser_parse_variant_payload(state)
        close: parser_expect(state, TOKEN_RPAREN, "`)` after a variant's payload")
        if parser_current_kind(state) == TOKEN_LBRACE {
            parser_add_error_code(state, "E0331", parser_cover(open.span, close.span), "group `{path}` can't carry a payload", "a variant group only names its subtree — data lives on the leaf variants", "move the payload onto the leaf variants inside the `{{ }}`, or remove the `(...)`")
        } else {
            payload = parsed
        }
    }
    discriminant := Int?{None}
    discriminant_expr := Expr?{None}
    if parser_current_kind(state) == TOKEN_EQ {
        parser_bump(state)
        expression: parser_parse_expression(state, 1, 0)
        discriminant_expr = Val(expression.expr)
        if expression.expr == .Int(number, _, _, _, _) -> discriminant = Val(number)
    }
    if parser_current_kind(state) != TOKEN_LBRACE {
        value.variants.push(Variant{name: path, name_span: name.span, payload: payload, discriminant: discriminant, discriminant_expr: discriminant_expr, serde_markers: markers})
        return
    }
    parser_bump(state)
    if markers.len() > 0 {
        parser_add_error_code(state, "E0003", name.span, "a `#[…]` marker can't sit on group `{path}`", "serde markers rename wire names, and only leaf variants reach the wire", "move the marker onto a leaf variant inside the `{{ }}`")
    }
    leaves_before: value.variants.len()
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        kind: parser_current_kind(state)
        if kind == TOKEN_SEMI || kind == TOKEN_COMMA {
            parser_bump(state)
            next
        }
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        entry_markers: if kind == TOKEN_HASH -> parser_parse_variant_markers(state) else -> [Marker]{}
        parser_parse_variant_entry(state, path, value, entry_markers, inside)
        if parser_current_kind(state) == TOKEN_SEMI || parser_current_kind(state) == TOKEN_COMMA -> parser_bump(state)
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the variant group")
    if parser_aborting(state) -> return
    if value.variants.len() == leaves_before {
        parser_add_error_code(state, "E0003", name.span, "group `{path}` has no variants", "an empty group can never match anything — every group needs at least one leaf variant", "add a variant inside the `{{ }}`, or remove the group")
    }
    value.groups.push(EnumGroup{path: path, name_span: name.span})
}

// A variant payload inside `( )`: named fields `name: Type, …` or one
// positional type.
parser_parse_variant_payload: fn(state: &JetParserState) -> VariantPayload {
    if parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
        fields := [VariantField]{}
        loop !parser_aborting(state) {
            field: parser_expect_name(state, "for a variant field name")
            parser_expect(state, TOKEN_COLON, "`:` after a variant field name")
            ty: parser_parse_type(state, 0)
            fields.push(VariantField{name: parser_value(state, field), name_span: field.span, ty: ty.ty, ty_span: ty.span})
            if parser_current_kind(state) != TOKEN_COMMA -> break
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RPAREN -> break
        }
        return VariantPayload.Named{fields: fields}
    }
    ty: parser_parse_type(state, 0)
    if parser_current_kind(state) == TOKEN_COMMA {
        parser_add_error_here(state, "a positional enum variant can carry only one value", "one positional payload has one type; variants with two or more values use named fields", "name each field, for example `Hit(text: String, count: Int)`")
    }
    VariantPayload.Single{ty: ty.ty, span: ty.span}
}

// S28: `impl Trait { … }` inside a struct or enum body, with
// associated types `Name: Type`, trait constants `name: value` and
// one parenthesized right-hand type on an operator trait. The trait may be
// dotted (`impl labels.Named`, `impl Literal.Int`), and `impl Trait using
// field` delegates the trait to a field, as a top-level impl does. `above`
// holds the markers written before `impl`.
parser_parse_trait_impl_block: fn(state: &JetParserState, above: [Marker]) -> TraitImplBlock {
    start: parser_bump(state)
    trait_name: parser_expect_name(state, "after `impl`")
    trait_text := parser_value(state, trait_name)
    trait_end := trait_name.span
    loop parser_current_kind(state) == TOKEN_DOT && !parser_aborting(state) {
        parser_bump(state)
        segment: parser_expect_name(state, "after `.` in `impl`")
        trait_text = "{trait_text}.{parser_value(state, segment)}"
        trait_end = segment.span
    }
    trait_span: parser_cover(trait_name.span, trait_end)
    operator_rhs: parser_parse_operator_rhs(state, Val(trait_text.copy()))
    operator_marker := parser_operator_marker(above)
    loop parser_current_kind(state) == TOKEN_HASH {
        marker: parser_parse_marker(state)
        if marker.name == "Commutative" -> operator_marker = Val(OperatorMarker.Commutative)
    }
    using: parser_current(state)
    if using.kind == TOKEN_IDENT && parser_value(state, using) == "using" {
        parser_bump(state)
        field: parser_expect_name(state, "after `using` for the delegation field")
        parser_finish_statement(state)
        return TraitImplBlock{trait_name: trait_text, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: [Func]{}, compiler_generated: false, assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}, delegation_field: Val(parser_value(state, field)), markers: above, span: Val(parser_cover(start.span, field.span))}
    }
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the trait impl body")
    methods := [Func]{}
    assoc_types := [NamedType]{}
    constants := [ImplConstValue]{}
    inside := [Marker]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        token: parser_current(state)
        if token.kind == TOKEN_SEMI {
            parser_bump(state)
            next
        }
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        if parser_state_section_ahead(state) {
            section := parser_parse_state_section(state, "", token.span)
            parser_report_ineligible_state_section(state, section, "impl")
            next
        }
        if parser_impl_assoc_type_ahead(state) {
            assoc_types.push(parser_parse_impl_assoc_type(state))
            next
        }
        if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
            constants.push(parser_parse_impl_constant(state))
            next
        }
        if token.kind != TOKEN_KW_FN && token.kind != TOKEN_KW_PUB && token.kind != TOKEN_HASH && !parser_prep_fn_ahead(state) {
            found: parser_describe_token(state, token)
            parser_add_error(state, token.span, "expected a method `name: fn(…)`, found {found}", "an impl body holds methods, associated types and trait constants", "write a method as `name: fn(…)`, or a trait constant as `name: value`")
            break
        }
        methods.push(parser_parse_type_method(state))
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` to close the trait impl body")
    markers: parser_merge_inbody_markers(state, above, inside, start.span.start, close.span.start, "impl `{trait_text}`")
    if parser_operator_marker(markers) != None -> operator_marker = parser_operator_marker(markers)
    TraitImplBlock{trait_name: trait_text, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: methods, compiler_generated: false, assoc_type_impls: assoc_types, constants: constants, delegation_field: None, markers: markers, os_target: parser_impl_os_target(markers), span: Val(parser_cover(start.span, close.span))}
}

// `Commutative` among an impl's markers makes it commutative, as the
// `#Commutative` written after the trait does.
parser_operator_marker: fn(markers: [Marker]) -> OperatorMarker? Never! {
    loop marker in markers {
        if marker.name == "Commutative" && !marker.negated -> return Val(OperatorMarker.Commutative)
    }
    None
}

// `Name: Type` in an impl body: an associated type. A trait constant is
// lower-case (`limit: 10`), an associated type PascalCase (`Output: Int`).
parser_impl_assoc_type_ahead: fn(state: &JetParserState) -> Bool Never! {
    token: parser_current(state)
    if token.kind != TOKEN_IDENT || parser_kind_at(state, 1) != TOKEN_COLON -> return false
    name: parser_value(state, token)
    parser_pascal_name(name) && !parser_constant_name(name)
}

parser_parse_impl_assoc_type: fn(state: &JetParserState) -> NamedType {
    assoc: parser_bump(state)
    parser_bump(state)
    ty: parser_parse_type(state, 0)
    parser_finish_statement(state)
    NamedType{name: parser_value(state, assoc), span: assoc.span, ty: ty.ty}
}

// `name: value` in an impl body: the value of one trait constant.
parser_parse_impl_constant: fn(state: &JetParserState) -> ImplConstValue {
    name_token: parser_bump(state)
    parser_bump(state)
    value: parser_parse_expression(state, 1, 0)
    parser_finish_statement(state)
    ImplConstValue{name: parser_value(state, name_token), name_span: name_token.span, value: value.expr, span: parser_cover(name_token.span, value.span)}
}

parser_parse_const: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> ConstDef {
    start: parser_current(state)
    name_token: parser_expect_name(state, "for a constant")
    parser_expect(state, TOKEN_COLON, "`:` after a constant name")
    binding_name: parser_value(state, name_token)
    prepared := false
    parsed_value := ParsedExpr{expr: Expr.Unit{span: start.span, id: parser_node_id(state)}, span: start.span}
    if parser_prep_verb_ahead(state, 0, TOKEN_LBRACE) {
        head: parser_bump(state)
        block: parser_parse_value_block(state, 0, true)
        span: parser_cover(head.span, block.span)
        parsed_value = ParsedExpr{expr: Expr.Unit{span: span, id: parser_node_id(state)}, span: span}
        if block.statements.len() == 0 && block.tail == .Val(tail) {
            prepared = true
            parsed_value = ParsedExpr{expr: tail, span: span}
        } else {
            parser_add_error_code(state, "E0391", span, "`comptime {{ … }}` is used as a value, which this compiler does not support yet", "Jet makes the block's final expression its value; only a block holding a single final expression is folded today", "write `NAME: comptime {{ value }}` with one final expression, or a `comptime {{ … }}` statement")
        }
    } else {
        parsed_value = parser_parse_expression(state, 1, 0)
    }
    terminator := parser_current(state)
    terminator_span := terminator.span
    if terminator.kind == TOKEN_RBRACE || terminator.kind == TOKEN_EOF -> terminator_span = parsed_value.span
    if terminator.kind != TOKEN_SEMI && terminator.kind != TOKEN_RBRACE && terminator.kind != TOKEN_EOF {
        terminator_text: parser_text(state, terminator)
        parser_add_error(state, terminator.span, "something unexpected appeared after this line, found `{terminator_text}`", "each line ends where the line break is (no `;` needed)", "put the next line of code on a new line")
    }
    parser_finish_statement(state)
    attrs := [ConstAttr]{}
    rust_kind := RustConstKind.Const
    marker_index := 0
    loop marker_index < modifiers.markers.len() {
        marker: modifiers.markers[marker_index]
        if marker.name == "Static" {
            attrs.push(ConstAttr.ForceStatic)
            rust_kind = RustConstKind.Static
        }
        if marker.name == "Inline" -> attrs.push(ConstAttr.ForceInline)
        marker_index += 1
    }
    result := ast_const(binding_name, name_token.span, parser_cover(modifiers.start_span, terminator_span), parsed_value.expr)
    result.attrs = attrs
    result.markers = modifiers.markers
    result.is_pub = modifiers.is_pub
    result.is_package_pub = modifiers.is_package_pub
    result.is_comptime = prepared
    result.rust_kind = rust_kind
    result.ty = None
    result
}

// `name: value` / `name := value` at file scope declares a
// module binding, not an executable script statement (Rust
// `module_binding_def`).
parser_module_binding_ahead: fn(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_IDENT -> return false
    next: parser_kind_at(state, 1)
    if next == TOKEN_COLON_EQ || next == TOKEN_COLON -> return true
    // `Type{ … }: value` is a destructuring head; the module-binding parser
    // rejects it with one diagnostic (Rust `pattern_target_is_binding`).
    if next != TOKEN_LBRACE -> return false
    depth := 0
    offset := 1
    loop {
        kind: parser_kind_at(state, offset)
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 {
                after: parser_kind_at(state, offset + 1)
                return after == TOKEN_COLON || after == TOKEN_COLON_EQ
            }
        }
        offset += 1
    }
    false
}

// The module constant or variable a parsed file-scope binding declares, spanning
// `start` through `end`. A line that is not one named binding stays a script
// statement (None), which sema reports as top-level executable code.
parser_module_binding_item: fn(statement: Stmt, start: Span, end: Int) -> Item? {
    definition: parser_module_binding_def(statement, start, end) ?? return None
    Val(Item.Const{value: definition})
}

parser_module_binding_def: fn(statement: Stmt, start: Span, end: Int) -> ConstDef? {
    if statement == .Val(binding) {
        if binding.pattern != None || binding.name == "" -> return None
        definition := ast_const(binding.name, binding.name_span, Span{start: start.start, end: end}, binding.init)
        definition.meta = binding.meta
        definition.markers = binding.markers
        definition.is_comptime = binding.is_comptime
        definition.ct = binding.ct
        definition.ty = binding.ty
        definition.mutable = binding.mutable
        // Everything is public by default (S18), module bindings included.
        definition.is_pub = true
        return Val(definition)
    }
    None
}

// `#Persist name := value` at file scope (Rust `at_persist_binding`): module
// state that survives a `jet dev` reload. A local `#Persist` never reaches
// here and keeps the statement parser's E0145.
parser_persist_binding_ahead: fn(state: &JetParserState) -> Bool Never! {
    parser_current_kind(state) == TOKEN_HASH && parser_kind_at(state, 1) == TOKEN_IDENT && parser_value_at(state, 1) == "Persist" && parser_kind_at(state, 2) == TOKEN_IDENT
}

// Rust `persist_def`: the marker, then one named module binding.
parser_parse_persist_binding: fn(state: &JetParserState) -> Item? {
    hash: parser_bump(state)
    marker: parser_bump(state)
    statement: parser_parse_binding_statement(state)
    definition := parser_module_binding_def(statement, hash.span, parser_previous_end(state)) ?? return None
    definition.is_persist = true
    definition.persist_span = Val(parser_cover(hash.span, marker.span))
    Val(Item.Const{value: definition})
}

// `Name: Type` / `Name<T>: Type<T>` (parser_type_alias_ahead_at).
parser_parse_type_alias: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> TypeAliasDef {
    name: parser_bump(state)
    type_params := parser_parse_type_params(state)
    parser_expect(state, TOKEN_COLON, "`:` before the aliased type")
    target := if {
        parser_state_section_ahead(state) -> {
            section_start: parser_current(state).span
            section := parser_parse_state_section(state, "", section_start)
            parser_report_ineligible_state_section(state, section, "alias")
            ParsedType{ty: Type.Named{name: "__jet_error"}, span: section.span}
        }
        else -> parser_parse_type(state, 0)
    }
    parser_finish_statement(state)
    TypeAliasDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: parser_value(state, name), name_span: name.span, type_params: type_params.move(), target: target.ty, target_span: target.span, span: parser_cover(name.span, target.span)}
}

// At file and module scope an unmarked `name: fn(…)` with no
// body names a function type, as `Name: Type` names any other type. The item
// parse reads it as a function first; a lone E0081 there means the signature
// had no body, and the same tokens then reparse as the alias.
parser_function_signature_only: fn(state: JetParserState, parsed: ParsedFunction, modifiers: ParsedItemModifiers, diagnostics_before: Int) -> Bool Never! {
    if parsed.has_body || modifiers.markers.len() > 0 || modifiers.is_comptime -> return false
    // A head pattern stays allowed: `(Int)` reads as a unit variant head until
    // the reparse reads it as the parameter type it is.
    if parsed.value.type_params.len() > 0 || parsed.value.external_type != None -> return false
    state.diagnostics.len() == diagnostics_before + 1 && state.diagnostics[diagnostics_before].code == "E0081"
}

// `name: fn(…) -> R` without a body, from its moved `fn` keyword: the alias of
// that function type.
parser_parse_function_type_alias: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> TypeAliasDef {
    keyword: parser_bump(state)
    name: parser_bump(state)
    target: parser_parse_function_type_from(state, 0, keyword.span)
    parser_finish_statement(state)
    TypeAliasDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: parser_value(state, name), name_span: name.span, type_params: [TypeParam]{}, target: target.ty, target_span: target.span, span: parser_cover(name.span, target.span)}
}

parser_apply_type_markers: fn(value: &StructDef, markers: [Marker]) Never! {
    index := 0
    loop index < markers.len() {
        marker: markers[index]
        if marker.name == "SingleUse" {
            value.is_single_use = true
            value.single_use_span = Val(marker.span)
        }
        if marker.name == "MustUse" {
            value.is_must_use = true
            value.must_use_span = Val(marker.span)
        }
        if marker.name == "PublishedSchema" {
            value.is_published_schema = true
            value.published_schema_span = Val(marker.span)
        }
        index += 1
    }
}

parser_parse_trait: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> TraitDef {
    start: parser_bump(state)
    name: parser_expect_name(state, "after `trait`")
    // `Name: trait: [A, B] {{ … }}` lists the traits it
    // builds on with the ordinary bound spelling.
    supertraits := [String]{}
    if parser_current_kind(state) == TOKEN_COLON {
        parser_bump(state)
        supertraits = parser_parse_trait_bounds(state, "in a supertrait list", "`]` after supertraits", "after `:` in a trait definition")
    }
    parser_expect(state, TOKEN_LBRACE, "`{{` before trait members")
    methods := [TraitMethodSig]{}
    assoc_types := [NamedSpan]{}
    constants := [TraitConstDecl]{}
    inside := [Marker]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        if parser_state_section_ahead(state) {
            section_start: parser_current(state).span
            section := parser_parse_state_section(state, "", section_start)
            parser_report_ineligible_state_section(state, section, "trait")
            next
        }
        // An unregistered marker before a trait member applies to the method
        // site, where sema reports it from the shared applied-rule
        // vocabulary (E0927); the member after it still parses.
        if parser_current_kind(state) == TOKEN_HASH && parser_kind_at(state, 1) == TOKEN_IDENT && !marker_registered(parser_value_at(state, 1)) {
            marker: parser_parse_marker(state)
            span: marker.span
            state.statement_rules.push(AppliedRuleApplication{marker: marker, target: Val(span), site: Val(RuleSite.Method)})
            next
        }
        if {
            // `Name: type`: an associated type.
            parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON && parser_kind_at(state, 2) == TOKEN_IDENT && parser_value_at(state, 2) == "type" && (parser_kind_at(state, 3) == TOKEN_SEMI || parser_kind_at(state, 3) == TOKEN_RBRACE || parser_kind_at(state, 3) == TOKEN_EOF) -> {
                assoc: parser_bump(state)
                parser_bump(state)
                kw: parser_bump(state)
                assoc_types.push(NamedSpan{name: parser_value(state, assoc), span: parser_cover(assoc.span, kw.span)})
                parser_finish_statement(state)
            }
            // `name: Type`, or `name: Type{default}`: a trait constant.
            parser_current_kind(state) == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON -> {
                constant_name: parser_bump(state)
                parser_bump(state)
                constant_type: parser_parse_type(state, 0)
                default := Expr?{None}
                end := constant_type.span
                if parser_current_kind(state) == TOKEN_LBRACE {
                    parser_bump(state)
                    parsed_value: parser_parse_expression(state, 1, 0)
                    close_default: parser_expect(state, TOKEN_RBRACE, "`}}` after a trait constant default")
                    default = Val(parsed_value.expr)
                    end = close_default.span
                }
                constants.push(TraitConstDecl{name: parser_value(state, constant_name), name_span: constant_name.span, ty: constant_type.ty, ty_span: constant_type.span, default: default.move(), span: parser_cover(constant_name.span, end)})
                parser_finish_statement(state)
            }
            // Markers before a requirement attach to it, as they do to any
            // method; sema judges them against the applied-rule vocabulary.
            parser_current_kind(state) == TOKEN_KW_FN || parser_current_kind(state) == TOKEN_HASH -> {
                method_modifiers := parser_parse_item_modifiers(state, false)
                if parser_current_kind(state) != TOKEN_KW_FN {
                    parser_add_error_here(state, "expected a trait method, associated type or trait constant", "trait bodies declare callable requirements, associated types and compile-time constants", "write `name: fn(...)`, `type Name` or `name: Type`")
                    parser_recover_statement(state)
                    next
                }
                parsed: parser_parse_function(state, method_modifiers, false)
                method := parsed.value
                default_body := [Stmt]?{None}
                if parsed.has_body -> default_body = Val(method.body)
                methods.push(TraitMethodSig{name: method.name, name_span: method.name_span, params: method.params, return_type: method.return_type, span: method.span, default_body: default_body.move(), is_pure: method.is_pure, declared_effects: method.declared_effects, return_view_provenance: method.return_view_provenance, declared_return_view_provenance: method.declared_return_view_provenance, markers: method.markers})
            }
            else -> {
                parser_add_error_here(state, "expected a trait method, associated type or trait constant", "trait bodies declare callable requirements, associated types and compile-time constants", "write `name: fn(...)`, `type Name` or `name: Type`")
                parser_recover_statement(state)
            }
        }
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after trait members")
    trait_name: parser_value(state, name)
    markers: parser_merge_inbody_markers(state, modifiers.markers, inside, modifiers.start_span.start, close.span.start, "trait `{trait_name}`")
    TraitDef{span: parser_cover(modifiers.start_span, close.span), is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: trait_name, name_span: name.span, supertraits: supertraits, assoc_types: assoc_types, constants: constants, methods: methods, markers: markers}
}

// The trait bounds after a `:` (Rust `parse_trait_bounds`): a bracketed list
// `[A, B]`, or bare names joined by `|`. Each context names the place in the
// expected-name and missing-`]` reports.
parser_parse_trait_bounds: fn(state: &JetParserState, list_context: String, close_context: String, single_context: String) -> [String] {
    bounds := [String]{}
    if parser_current_kind(state) == TOKEN_LBRACKET {
        parser_bump(state)
        if parser_current_kind(state) != TOKEN_RBRACKET {
            loop {
                bound: parser_expect_name(state, list_context)
                bounds.push(parser_value(state, bound))
                if parser_current_kind(state) == TOKEN_RBRACKET -> break
                if parser_current_kind(state) != TOKEN_COMMA -> break
                parser_bump(state)
            }
        }
        parser_expect(state, TOKEN_RBRACKET, close_context)
        return bounds
    }
    loop {
        bound: parser_expect_name(state, single_context)
        bound_name: parser_value(state, bound)
        if bound_name == "Quantity" && parser_current_kind(state) == TOKEN_LT {
            bounds.push(parser_parse_quantity_bound(state))
        } else {
            bounds.push(bound_name)
        }
        if parser_current_kind(state) != TOKEN_PIPE -> break
        parser_bump(state)
    }
    bounds
}

// `Quantity<Dimension, .Kind>` bounds a parameter to the quantities of one
// dimension and kind. The dimension is any family name; the kind is the
// closed set `.Linear`, `.Point`, `.Delta`. The bound is kept as its canonical
// text, `Quantity<Length, .Linear>`.
parser_parse_quantity_bound: fn(state: &JetParserState) -> String {
    parser_bump(state)
    dimension: parser_expect_name(state, "for the quantity dimension")
    parser_expect(state, TOKEN_COMMA, "`,` between the quantity dimension and kind")
    parser_expect(state, TOKEN_DOT, "`.` before the quantity kind")
    kind_token: parser_expect_name(state, "for the quantity kind")
    kind: parser_value(state, kind_token)
    if kind != "Linear" && kind != "Point" && kind != "Delta" -> parser_add_error(state, kind_token.span, "`.{kind}` is not a quantity kind", "Quantity bounds distinguish linear values, affine points, and affine deltas", "Use `.Linear`, `.Point`, or `.Delta`")
    if parser_type_close_here(state) -> parser_take_type_close(state) else -> parser_expect(state, TOKEN_GT, "`>` after the quantity kind")
    "Quantity<{parser_value(state, dimension)}, .{kind}>"
}

// The one parenthesized right-hand type allowed on an
// operator trait impl. A bare operator impl keeps `None`, which means `Self`.
parser_parse_operator_rhs: fn(state: &JetParserState, trait_name: String?) -> Type? {
    if parser_current_kind(state) != TOKEN_LPAREN -> return None
    parser_bump(state)
    rhs: parser_parse_type(state, 0)
    if parser_current_kind(state) == TOKEN_COMMA {
        comma: parser_bump(state)
        parser_add_error(state, comma.span, "an operator impl accepts exactly one right-hand type", "operator dispatch has one right-hand operand; multiple type arguments would make the hook ambiguous", "write one type, for example `impl Money.Mul(Int)`")
        return None
    }
    parser_expect(state, TOKEN_RPAREN, "`)` after the operator right-hand type")
    name: trait_name ?? {
        parser_add_error(state, rhs.span, "type arguments on an impl need an operator trait", "only {owned_trait_arithmetic_listed()} accept an explicit right-hand operand type", "write a dotted operator impl such as `impl Money.Mul(Int)`")
        return None
    }
    if !owned_trait_arithmetic(name) {
        parser_add_error(state, rhs.span, "`{name}` does not accept an operator right-hand type", "only {owned_trait_arithmetic_listed()} have a typed right-hand operand", "remove the type arguments or use an arithmetic operator trait")
        return None
    }
    Val(rhs.ty)
}

// `impl Type.Trait { … }` implements a trait; `impl Type { … }`
// is inherent, as is a protocol handle `impl Payment.Client { … }`. A
// `Type.Literal.Int` / `Type.Literal.Float` tail names one literal capability.
// (as respelled by): `impl Source -> Target { body }`
// declares the conversion of a `Source` error into a `Target` error.
// `modifiers` holds the markers written above `impl`.
parser_parse_impl: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    start: parser_bump(state)
    parts := [Token]{}
    parts.push(parser_expect_name(state, "after `impl`"))
    loop parser_current_kind(state) == TOKEN_DOT && !parser_aborting(state) {
        parser_bump(state)
        parts.push(parser_expect_name(state, "after `.` in `impl`"))
    }
    // `impl Stack<T> {`: an impl names its type bare and its methods already
    // see the struct's type parameters.
    if parser_current_kind(state) == TOKEN_LT && !parser_aborting(state) {
        open: parser_current(state).span
        _: parser_parse_type_params(state)
        written := parser_value(state, parts[0])
        loop index in 1..<parts.len() -> written = "{written}.{parser_value(state, parts[index])}"
        params_span: Span{start: open.start, end: parser_prev_token_end(state)}
        parser_add_error_code_edit(state, "E0003", params_span, "`impl {written}` takes no type parameters", "an impl of a generic type names the type bare; its methods already see the type's parameters", "write `impl {written} {{`", TextEdit{span: params_span, new_text: ""})
        loop parser_current_kind(state) == TOKEN_DOT && !parser_aborting(state) {
            parser_bump(state)
            parts.push(parser_expect_name(state, "after `.` in `impl`"))
        }
    }
    first: parts[0]
    count: parts.len()
    is_error_conversion: parser_current_kind(state) == TOKEN_UNIFIED_ARROW
    is_protocol_impl: count == 2 && (parser_value(state, parts[1]) == "Client" || parser_value(state, parts[1]) == "Server") && parser_current_kind(state) == TOKEN_LBRACE
    literal_capability: count >= 3 && parser_value(state, parts[count - 2]) == "Literal" && (parser_value(state, parts[count - 1]) == "Int" || parser_value(state, parts[count - 1]) == "Float")
    owner_count := if {
        count == 1 || is_error_conversion || is_protocol_impl -> count
        literal_capability -> count - 2
        else -> count - 1
    }
    // A module or package alias (a snake_case segment) binds to
    // the segment after it, so `impl Local.labels.Named` implements
    // `labels.Named` for `Local`.
    if !literal_capability {
        loop owner_count > 1 && owner_count < count && !parser_pascal_name(parser_value(state, parts[owner_count - 1])) {
            owner_count -= 1
        }
    }
    type_name := parser_value(state, first)
    loop index in 1..<owner_count -> type_name = "{type_name}.{parser_value(state, parts[index])}"
    type_span: parser_cover(first.span, parts[owner_count - 1].span)
    has_trait: owner_count < count
    trait_name := String?{None}
    trait_span := Span?{None}
    if has_trait {
        trait_text := parser_value(state, parts[owner_count])
        loop index in (owner_count + 1)..<count -> trait_text = "{trait_text}.{parser_value(state, parts[index])}"
        trait_name = Val(trait_text)
        trait_span = Val(parser_cover(parts[owner_count].span, parts[count - 1].span))
    }
    if is_error_conversion {
        parser_bump(state)
        target: parser_expect_name(state, "after `->` in error conversion")
        to_ty := parser_value(state, target)
        loop parser_current_kind(state) == TOKEN_DOT && !parser_aborting(state) {
            parser_bump(state)
            segment: parser_expect_name(state, "after `.` in a type path")
            to_ty = "{to_ty}.{parser_value(state, segment)}"
        }
        if parser_current_kind(state) != TOKEN_LBRACE {
            parser_add_error_here(state, "expected `{{` to open the error-conversion body", "an error conversion body is a block: `impl Source -> Target {{ … }}`", "add `{{` after the target type")
            return Item.ErrorConv{value: ErrorConvDef{from_ty: type_name, from_span: type_span, to_ty: to_ty, to_span: target.span, body: [Stmt]{}, body_span: parser_cover(start.span, target.span), markers: modifiers.markers}}
        }
        body: parser_parse_block(state)
        return Item.ErrorConv{value: ErrorConvDef{from_ty: type_name, from_span: type_span, to_ty: to_ty, to_span: target.span, body: body.statements, body_span: body.span, markers: modifiers.markers}}
    }
    operator_rhs: parser_parse_operator_rhs(state, trait_name)
    operator_marker := parser_operator_marker(modifiers.markers)
    loop parser_current_kind(state) == TOKEN_HASH && !parser_aborting(state) {
        marker: parser_parse_marker(state)
        if marker.name == "Commutative" -> operator_marker = Val(OperatorMarker.Commutative)
    }
    // S62: `impl Type.Trait using field_name` delegates the trait to a field.
    using: parser_current(state)
    if has_trait && using.kind == TOKEN_IDENT && parser_value(state, using) == "using" {
        parser_bump(state)
        field: parser_expect_name(state, "after `using` for the delegation field")
        parser_finish_statement(state)
        return Item.Impl{value: ImplDef{span: parser_cover(start.span, field.span), type_name: type_name, type_span: type_span, trait_name: trait_name, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: [Func]{}, delegation_field: Val(parser_value(state, field)), assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}, is_generated_serde: false, os_target: parser_impl_os_target(modifiers.markers), markers: modifiers.markers}}
    }
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `impl` body")
    methods := [Func]{}
    assoc_types := [NamedType]{}
    constants := [ImplConstValue]{}
    inside := [Marker]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        token: parser_current(state)
        if token.kind == TOKEN_SEMI {
            parser_bump(state)
            next
        }
        if parser_inbody_marker_ahead(state) {
            if parser_parse_inbody_marker(state) == .Val(line) -> inside.push(line)
            next
        }
        if parser_state_section_ahead(state) {
            section := parser_parse_state_section(state, "", token.span)
            parser_report_ineligible_state_section(state, section, "impl")
            next
        }
        if parser_impl_assoc_type_ahead(state) {
            assoc_types.push(parser_parse_impl_assoc_type(state))
            next
        }
        if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
            constants.push(parser_parse_impl_constant(state))
            next
        }
        if token.kind != TOKEN_KW_FN && token.kind != TOKEN_KW_PUB && token.kind != TOKEN_HASH && !parser_prep_fn_ahead(state) {
            found: parser_describe_token(state, token)
            parser_add_error(state, token.span, "expected a method `name: fn(…)`, found {found}", "an impl body holds methods, associated types and trait constants", "write a method as `name: fn(…)`, or a trait constant as `name: value`")
            break
        }
        methods.push(parser_parse_type_method(state))
    }
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after implementation methods")
    written := type_name.copy()
    if trait_name == .Val(text) -> written = "{written}.{text}"
    markers: parser_merge_inbody_markers(state, modifiers.markers, inside, start.span.start, close.span.start, "impl `{written}`")
    if parser_operator_marker(markers) != None -> operator_marker = parser_operator_marker(markers)
    Item.Impl{value: ImplDef{span: parser_cover(start.span, close.span), type_name: type_name, type_span: type_span, trait_name: trait_name, trait_span: trait_span, operator_rhs: operator_rhs, operator_marker: operator_marker, methods: methods, delegation_field: None, assoc_type_impls: assoc_types, constants: constants, is_generated_serde: false, os_target: parser_impl_os_target(markers), markers: markers}}
}

// The native OS an impl is gated to by `#Target(OS.Linux|MacOS|Windows)`
// among its markers, spelled as sema reads it (`linux`, `macos`, `windows`).
parser_impl_os_target: fn(markers: [Marker]) -> String? {
    loop marker in markers {
        if marker.name != "Target" || marker.args.len() != 1 -> next
        if marker.args[0] == .Expr(value) {
            if parser_marker_target_path(value) == .Val(path) {
                if path == "OS.Linux" -> return Val("linux")
                if path == "OS.MacOS" -> return Val("macos")
                if path == "OS.Windows" -> return Val("windows")
            }
        }
    }
    None
}

parser_parse_tag_decl: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> TagDef {
    start: parser_bump(state)
    name: parser_expect_name(state, "after `tag`")
    deny := [NamedSpan]{}
    from := [NamedSpan]{}
    end := name.span
    if {
        parser_current_kind(state) == TOKEN_LBRACE -> {
            parser_bump(state)
            loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
                keyword: parser_expect_name(state, "in a tag declaration")
                target: parser_expect_name(state, "after a tag declaration clause")
                item := NamedSpan{name: parser_value(state, target), span: target.span}
                if parser_value(state, keyword) == "deny" -> deny.push(item)
                if parser_value(state, keyword) == "from" -> from.push(item)
                parser_finish_statement(state)
            }
            close: parser_expect(state, TOKEN_RBRACE, "`}}` after tag declaration")
            end = close.span
        }
        else -> parser_finish_statement(state)
    }
    TagDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: parser_value(state, name), name_span: name.span, deny: deny, from: from, span: parser_cover(start.span, end)}
}

// `derive T.Trait { … }`.
parser_parse_user_derive: fn(state: &JetParserState) -> DeriveDef? {
    start: parser_bump(state)
    type_name: parser_expect_name(state, "after `derive`")
    parser_expect(state, TOKEN_DOT, "`.` between a type and derive trait")
    trait_token: parser_expect_name(state, "after `.` in a derive declaration")
    // Rust `derive_body_items`: a derive body is the shared template body —
    // items, statements and `comptime loop` templates (parser_marker_body).
    body: parser_marker_body(state)
    end: parser_lookahead(state, -1).span
    type_param: parser_value(state, type_name)
    trait_name: parser_value(state, trait_token)
    if parser_derive_nested_impl_span(body) == .Val(span) {
        message: "`derive {type_param}.{trait_name}` already names its implementation"
        parser_add_fatal_code(state, "E0003", span, message, "a derive provider body is the member list; a nested `impl` repeats the target and trait", "remove the `impl` wrapper and keep its members directly in the derive body")
        return None
    }
    Val(DeriveDef{trait_name: trait_name, trait_span: trait_token.span, type_param: type_param, body: body, span: parser_cover(start.span, end)})
}

// Rust `derive_nested_impl_span`: the first `impl` or error conversion a
// derive body (or one of its template loops) wraps its members in.
parser_derive_nested_impl_span: fn(body: [DeriveBodyItem]) -> Span? Never! {
    loop body_item in body {
        if body_item == {
            .Item(item) -> if item == {
                .Impl(implementation) -> return Val(implementation.span)
                .ErrorConv(conversion) -> return Val(conversion.from_span)
                else -> {}
            }
            .Loop(_, _, _, nested, _) -> {
                if parser_derive_nested_impl_span(nested) == .Val(span) -> return Val(span)
            }
            .Stmt(_) -> {}
        }
    }
    None
}
