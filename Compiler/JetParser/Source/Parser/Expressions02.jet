// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:1026
// Invoke before ordinary lower-case implicit-subject members only when the
// Recipe.build(steps: ...) context enables allow_lowercase_leading_dot.
fn parser_parse_build_step(state: &JetParserState) -> ParsedExpr {
    dot :: parser_expect(&state, TOKEN_DOT, "before a build step")
    variant :: parser_expect_name(&state, "after `.` in a build step")
    args := [EnumLitArg]{}
    end := variant.span.end
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_RPAREN {
            loop {
                if parser_current_kind(&state) != TOKEN_IDENT || parser_kind_at(&state, 1) != TOKEN_COLON {
                    parser_add_fatal_code(&state, "E0003", parser_current(&state).span, "build-step arguments need field labels", "finite build actions name every tool, path, URL, hash, and argument list", "write `field: value`, for example `tool: \"cc\"`")
                    return ParsedExpr{expr: Expr.EnumLit{type_name: "", variant: variant.payload.decoded, variant_span: Val(variant.span), args: ^args, leading_dot: true, span: Span{start: dot.span.start, end: end}}, span: Span{start: dot.span.start, end: end}}
                }
                label :: parser_expect_name(&state, "for a named build-step argument")
                parser_bump(&state)
                expr :: if label.payload.decoded == "args" { build_step_string_list(&state) } else { build_step_string(&state) }
                if parser_aborting(&state) -> return expr
                &args.push(EnumLitArg.Named{label: label.payload.decoded, expr: expr.expr})
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
                parser_expect(&state, TOKEN_COMMA, "between build-step arguments")
                if parser_aborting(&state) -> return expr
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
            }
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "to close the build step")
        end = close.span.end
    }
    span :: Span{start: dot.span.start, end: end}
    ParsedExpr{expr: Expr.EnumLit{type_name: "", variant: variant.payload.decoded, variant_span: Val(variant.span), args: ^args, leading_dot: true, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:1115
fn build_step_string(state: &JetParserState) -> ParsedExpr {
    token :: parser_current(&state)
    if token.kind != TOKEN_STRING && token.kind != TOKEN_RAW_STRING {
        parser_add_fatal_code(&state, "E0003", token.span, "a build-step field must be quoted text", "build actions use fixed strings for tools, paths, URLs, and hashes", "write a quoted string such as `\"src/file\"`")
        return ParsedExpr{expr: Expr.Unit{span: token.span}, span: token.span}
    }
    loop part in token.payload.string_parts {
        if part.kind == STRING_PART_INTERPOLATION {
            parser_add_fatal_code(&state, "E0003", token.span, "build-step fields must be literal quoted text", "build action identity includes fixed tool, path, URL, and hash facts", "replace interpolation with a quoted literal")
            return ParsedExpr{expr: Expr.Unit{span: token.span}, span: token.span}
        }
    }
    // The canonical codec preserves text/byte parts and the raw-string decoded
    // fallback. No full expression grammar or interpolation parser is entered.
    parser_parse_string(&state, 0)
}
// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:1146
fn build_step_string_list(state: &JetParserState) -> ParsedExpr {
    open :: parser_expect(&state, TOKEN_LBRACKET, "before build-step string arguments")
    values := [Expr]{}
    if parser_aborting(&state) -> return ParsedExpr{expr: Expr.Unit{span: open.span}, span: open.span}
    if parser_current_kind(&state) != TOKEN_RBRACKET {
        loop {
            value :: build_step_string(&state)
            if parser_aborting(&state) -> return value
            &values.push(value.expr)
            if parser_current_kind(&state) == TOKEN_RBRACKET -> break
            parser_expect(&state, TOKEN_COMMA, "between build-step string arguments")
            if parser_aborting(&state) -> return value
            if parser_current_kind(&state) == TOKEN_RBRACKET -> break
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACKET, "after build-step string arguments")
    span :: parser_cover(open.span, close.span)
    ParsedExpr{expr: Expr.ListLit{elements: ^values, span: span}, span: span}
}
