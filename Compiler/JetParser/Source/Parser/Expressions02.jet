// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:155
fn parser_fallback_brace_is_block(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_LBRACE -> return false
    // Empty braces are a block; a field-led inferred record is a value.
    if parser_kind_at(&state, 1) == TOKEN_RBRACE -> return true
    !brace_starts_record(&state)
}
// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:173
fn parser_fallback_control(state: &JetParserState) -> OrFallback? {
    token :: parser_current(&state)
    if token.kind == TOKEN_BREAK {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parser_bump(&state)
            name :: parser_expect_name(&state, "as the loop name in `break(name)`")
            end :: parser_current(&state).span.end
            parser_expect(&state, TOKEN_RPAREN, "after the named break target")
            return Val(OrFallback.BreakLabel{name: name.payload.decoded, span: Span{start: token.span.start, end: end}})
        }
        return Val(OrFallback.Break{span: token.span})
    }
    if token.kind == TOKEN_IDENT && token.payload.decoded == "next" && (parser_kind_at(&state, 1) != TOKEN_LPAREN || (parser_kind_at(&state, 2) == TOKEN_IDENT && parser_kind_at(&state, 3) == TOKEN_RPAREN)) {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parser_bump(&state)
            name :: parser_expect_name(&state, "as the loop name in `next(name)`")
            end :: parser_current(&state).span.end
            parser_expect(&state, TOKEN_RPAREN, "after the named next target")
            return Val(OrFallback.ContinueLabel{name: name.payload.decoded, span: Span{start: token.span.start, end: end}})
        }
        return Val(OrFallback.Continue{span: token.span})
    }
    None
}
// Rust: crates/jet-parser/src/Parser/Expressions/binary_unary.rs:214
// A fallback is stricter than an ordinary value block: no final statement,
// authored semicolon or empty block can masquerade as a value. Preserve
// speculative parser state and diagnose the exact tail rather than the opener.
fn parser_parse_fallback_block(state: &JetParserState, depth: Int) -> OrFallback {
    open :: parser_expect(&state, TOKEN_LBRACE, "to open the `??` fallback block")
    body := [Stmt]{}
    loop {
        current :: parser_current(&state)
        if current.kind == TOKEN_SEMI && current.span.start == current.span.end { parser_bump(&state); next }
        if current.kind == TOKEN_RBRACE {
            close :: parser_bump(&state)
            if body.last() == .Val(stmt) {
                if parser_statement_definitely_exits_value_block(stmt) -> return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, close.span)}
                parser_add_fatal_code(&state, "E0114", stmt.span(), "this fallback ends with a statement instead of a value", "a value-expected fallback block must end with one unadorned expression; statements yield unit", "put one unadorned expression last, or use `return ...` for an early exit")
            } else {
                parser_add_fatal_code(&state, "E0003", close.span, "a `??` fallback block needs a final value or exit", "a fallback block runs its statements and then produces one value or leaves control", "add a final value or exit, such as `{{ log(err); default_value }}` or `{{ log(err); return }}`")
            }
            return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, close.span)}
        }
        if current.kind == TOKEN_EOF {
            parser_add_fatal_code(&state, "E0003", current.span, "expected `}` to close the `??` fallback block, found the end of the file", "every `{` needs a matching `}`", "add a closing `}`")
            return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, current.span)}
        }
        if current.kind == TOKEN_RETURN || current.kind == TOKEN_BREAK || (current.kind == TOKEN_IDENT && current.payload.decoded == "next") {
            saved_position :: state.position
            saved_diagnostics :: state.diagnostics.len()
            saved_blocks :: state.block_spans.len()
            saved_else_arms :: state.else_arms.len()
            stmt :: parser_parse_statement(&state)
            if !parser_error_since(state, saved_diagnostics) && parser_statement_definitely_exits_value_block(stmt) && parser_current_kind(&state) == TOKEN_RBRACE {
                close :: parser_bump(&state)
                &body.push(stmt)
                return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, close.span)}
            }
            parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
        }
        saved_position :: state.position
        saved_diagnostics :: state.diagnostics.len()
        saved_blocks :: state.block_spans.len()
        saved_else_arms :: state.else_arms.len()
        value :: parser_parse_expression(&state, 1, depth + 1)
        if !parser_error_since(state, saved_diagnostics) {
            if parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE {
                semi :: parser_current(&state).span
                if semi.start != semi.end && !parser_expression_definitely_diverges(value.expr) {
                    parser_add_fatal_code(&state, "E0114", value.span, "this fallback ends with a semicolon-terminated expression", "a value-expected fallback block must end with one unadorned expression; a semicolon-terminated expression yields unit", "remove the semicolon, or use `return ...` for an early exit")
                    return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, semi)}
                }
                parser_bump(&state)
            }
            if parser_current_kind(&state) == TOKEN_RBRACE {
                close :: parser_bump(&state)
                if parser_expression_definitely_diverges(value.expr) {
                    &body.push(Stmt.Expr{expr: value.expr})
                    return OrFallback.Block{body: ^body, value: None, span: parser_cover(open.span, close.span)}
                }
                return OrFallback.Block{body: ^body, value: Val(value.expr), span: parser_cover(open.span, close.span)}
            }
        }
        parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
        stmt :: parser_parse_statement(&state)
        if parser_error_since(state, saved_diagnostics) { parser_sync_stmt(&state) } else { &body.push(stmt) }
    }
}

