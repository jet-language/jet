// A module re-exports a declaration by declaring a second name for it:
// `clamp: core.math.clamp` in a module body makes `clamp` a member of that
// module which is the declaration `core.math.clamp` itself, with its home,
// privacy, generics, defaults, methods and traits, and public like any
// declaration. A `use` stays local to its file or module body.
//
// The parser reads such a line as a module binding. Once a module body is
// whole, each binding that re-exports becomes the import it means, a public
// `name: path` row, so the loader loads its target and registration binds
// the name as a member, as it binds any import. A binding re-exports when it
// is a plain, immutable, unannotated and unmarked `name: path` whose name and
// path words are value names (each starts with a lowercase letter): a
// function, a value or a module. The path's head is a module the body can
// name (`core`, a module beside it, a package), or a name a `use` of the
// same body binds, which stands for what that `use` imports: after
// `use core.math.[clamp]`, `my_clamp: clamp` re-exports `core.math.clamp`,
// and after `use bank_file: "bank.jet"`, `bank: bank_file` re-exports that
// file module. A one-word path that no `use` binds stays a binding (a module
// alias, a constant). A type name re-exports through the alias rule
// (`Point: geo.Point`). A dotted path in parentheses still re-exports, and
// the parse refuses the parentheses (parser_report_parenthesized_reexport).
use jet_foundation.[ConstDef, Expr, ImportDecl, ImportKind, ImportedItem, Item, Span, TextEdit, expr_span, member_import_local]

// `name: (core.math.sqrt)`: a re-export target written in parentheses, with
// the edit that drops them. The line still re-exports (parser_reexport_import),
// so this is its one error.
parser_report_parenthesized_reexport: fn(state: &JetParserState, definition: ConstDef) -[]> {
    if definition.mutable || definition.is_comptime || definition.markers.len() > 0 || !parser_reexport_value_word(definition.name) {
        return
    }
    if definition.value == .Paren(inner, span, _) && inner == .Field(_, _, _, _) {
        path: parser_reexport_target(inner, [ImportDecl]{}, false) ?? return
        parser_add_error_code_edit(state, "E0003", span, "a re-export's target is written in parentheses", "a re-export names its target as a bare path; in parentheses the line is a constant, and a constant holds a value, not a function or a module", "drop the parentheses: `{definition.name}: {path}`", TextEdit{span: span, new_text: path})
    }
}

// `items` with each re-exporting binding moved out, as a public import, to
// the end of `imports`; the items as they are when none re-exports.
parser_reexport_declarations: fn(items: &&[Item], imports: &[ImportDecl]) -> [Item] Never! {
    found := false
    loop item in items {
        if item == .Const(definition) {
            if parser_reexport_import(definition, imports) != None {
                found = true
                break
            }
        }
    }
    if !found -> return items.move()
    kept := [Item]{}
    loop item in items.move() {
        if item == .Const(definition) {
            if parser_reexport_import(definition, imports) == .Val(import) {
                imports.push(import)
                next
            }
        }
        kept.push(item)
    }
    kept
}

// The public import a re-exporting binding means, or None for any other
// binding. A re-export whose name repeats the member of a two-word path
// (`launch: bank.launch`) is the member import `use bank.launch` written as
// a declaration, so it is that import's row and binds as that row binds,
// through a module beside it in the same file too. A dotted target written
// in parentheses, which the constant parse refuses (parser_parse_const),
// still re-exports, so that refusal is the line's one error.
parser_reexport_import: fn(definition: ConstDef, imports: [ImportDecl]) -> ImportDecl? Never! {
    if definition.mutable || definition.is_comptime || definition.is_persist || definition.ty != None || definition.meta != None || definition.ct != None || definition.attrs.len() > 0 || definition.markers.len() > 0 {
        return None
    }
    if !parser_reexport_value_word(definition.name) -> return None
    if definition.value == .Paren(inner, _, _) && inner == .Field(_, _, _, _) {
        return parser_reexport_path_import(definition, inner, imports)
    }
    file: parser_reexport_file(definition.value, imports)
    if file == .Val(path) {
        return Val(ImportDecl{kind: ImportKind.File{path: path, span: expr_span(definition.value)}, alias: definition.name, alias_span: definition.name_span, span: parser_cover(definition.span, expr_span(definition.value)), item_spans: [Span]{}, local_spans: [Span]{}, is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, inline_version: None})
    }
    parser_reexport_path_import(definition, definition.value, imports)
}

// The import re-exporting binding `definition` means when its target is the
// bare path `value`, or None when `value` is no such path.
parser_reexport_path_import: fn(definition: ConstDef, value: Expr, imports: [ImportDecl]) -[]> ImportDecl? {
    target: parser_reexport_target(value, imports, true) ?? return None
    path: parser_cover(parser_reexport_head_span(value), expr_span(value))
    span: parser_cover(definition.span, path)
    if value == .Field(base, member, member_span, _) && base == .Ident(head, head_span, _) && member == definition.name {
        bound: parser_reexport_bound(head, imports) ?? ""
        if bound == "" || bound == head {
            return Val(ImportDecl{kind: ImportKind.Unqualified{module_alias: head, module_alias_span: head_span, items: [ImportedItem]{ImportedItem{original: member, alias: None}}, items_span: member_span, span: span}, alias: definition.name, alias_span: definition.name_span, span: span, item_spans: [Span]{member_span}, local_spans: [Span]{definition.name_span}, is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, inline_version: None})
        }
    }
    ImportDecl{kind: ImportKind.Module{name: target, span: path}, alias: definition.name, alias_span: definition.name_span, span: span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, inline_version: None}
}

// The file a one-word `value` names through a file `use` row of `imports`,
// or None.
parser_reexport_file: fn(value: Expr, imports: [ImportDecl]) -> String? Never! {
    if value == .Ident(name, _, _) {
        loop import in imports {
            if import.comptime_span != None || import.alias != name -> next
            if import.kind == .File(path, _) -> return Val("{path}")
        }
    }
    None
}

// The span of the first word of the path `value`; a field's own span is its
// member's.
parser_reexport_head_span: fn(value: Expr) -> Span Never! {
    if value == .Field(base, _, _, _) -> return parser_reexport_head_span(base)
    expr_span(value)
}

// The dotted path `value` re-exports, its head replaced by what a `use` of
// the body binds it to; None when `value` is not a bare path of value names,
// or is one word (`whole`) that no `use` binds.
parser_reexport_target: fn(value: Expr, imports: [ImportDecl], whole: Bool) -> String? Never! {
    if value == .Ident(name, _, _) {
        if !parser_reexport_value_word(name) -> return None
        bound: parser_reexport_bound(name, imports)
        if bound != None || whole -> return bound
        return Val("{name}")
    }
    if value == .Field(base, member, _, _) {
        if !parser_reexport_value_word(member) -> return None
        head: parser_reexport_target(base, imports, false) ?? return None
        return Val("{head}.{member}")
    }
    None
}

// The path the word `name` stands for through a `use` row of `imports`, or
// None when no row binds it. A build-only row binds nothing a member can
// name, and a file row has no path to name.
parser_reexport_bound: fn(name: String, imports: [ImportDecl]) -> String? Never! {
    loop import in imports {
        if import.comptime_span != None -> next
        if import.kind == .Module(path, _) {
            if import.alias == name -> return Val("{path}")
        }
        if import.kind == .Unqualified(module_alias, _, items, _, _) {
            loop item in items {
                if member_import_local(item.original, item.alias) == name {
                    return Val("{module_alias}.{item.original}")
                }
            }
        }
    }
    None
}

// A value name: it starts with a lowercase letter, or with one `_` before
// one (a soft-public `_preview`).
parser_reexport_value_word: fn(word: String) -> Bool Never! {
    bytes: word.bytes()
    first := 0
    if bytes.len() > 1 && bytes[0] == 95 -> first = 1
    bytes.len() > first && bytes[first] >= 97 && bytes[first] <= 122
}
