// Syntax-only expansion into the ordinary marker reader.
// Sema owns declaration validity and lexical declaration identities.
use {
    jet_foundation.[Diagnostic, Span, name_empty, name_intern, name_text]
    jet_lexer.[Token, TokenLiteral, TokenTables, StringPart, token_tables, token_decoded, TOKEN_IDENT, TOKEN_DOT, TOKEN_COLON, TOKEN_HASH, TOKEN_BANG, TOKEN_KW_IMPL, TOKEN_KW_MODULE, TOKEN_KW_STRUCT, TOKEN_LBRACKET, TOKEN_RBRACKET, TOKEN_LPAREN, TOKEN_RPAREN, TOKEN_LBRACE, TOKEN_RBRACE, TOKEN_COMMA, TOKEN_EOF, TOKEN_SEMI, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT]
}

NamedMarkerGroupTokens: struct {
    name: String
    name_span: Span
    members: [Token]
    // Members own only their spellings and literal facts, not a source-wide table.
    tables: TokenTables
    required_scope: String?{None}
}

ExpandedMarkerGroupUse: struct {
    name: String
    span: Span
}

ExpandedMarkerGroups: struct {
    tokens: [Token]
    uses: [ExpandedMarkerGroupUse]
}

MarkerTokenPath: struct {
    name: String
    end: Int
}

// `start..<end` are the group's member tokens; `stop` is the struct's `}`.
MarkerGroupTokenRange: struct {
    name: String
    start: Int
    end: Int
    stop: Int
}

MarkerGroupNamespace: struct {
    path: String
    braces: [String?]
}

// The code tokens, without comments, in source order: the parse proper reads
// the colon declaration heads.
marker_group_code: fn(input: [Token]) -> [Token] Never! {
    code := [Token]{}
    loop token in input {
        if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT -> code.push(token.copy())
    }
    code
}

marker_token_path: fn(tokens: [Token], tables: TokenTables, start: Int) -> MarkerTokenPath? {
    if start < 0 || start >= tokens.len() || tokens[start].kind != TOKEN_IDENT -> return None
    name := token_decoded(tables, tokens[start])
    end := start + 1
    loop end + 1 < tokens.len() && tokens[end].kind == TOKEN_DOT && tokens[end + 1].kind == TOKEN_IDENT {
        name = "{name}.{token_decoded(tables, tokens[end + 1])}"
        end += 2
    }
    Val(MarkerTokenPath{name: name, end: end})
}

marker_group_skip_semicolons: fn(tokens: [Token], index: Int) -> Int Never! {
    at := index
    loop at < tokens.len() && tokens[at].kind == TOKEN_SEMI -> at += 1
    at
}

// `Name: struct { impl Marker { group: #[…] } }`: a marker type with no
// fields whose one member is its group.
marker_group_token_range: fn(tokens: [Token], tables: TokenTables, start: Int) -> MarkerGroupTokenRange? Never! {
    if start < 0 || start + 3 >= tokens.len() -> return None
    if tokens[start].kind != TOKEN_IDENT || tokens[start + 1].kind != TOKEN_COLON || tokens[start + 2].kind != TOKEN_KW_STRUCT || tokens[start + 3].kind != TOKEN_LBRACE -> return None
    head := marker_group_skip_semicolons(tokens, start + 4)
    if head + 2 >= tokens.len() || tokens[head].kind != TOKEN_KW_IMPL || tokens[head + 1].kind != TOKEN_IDENT || token_decoded(tables, tokens[head + 1]) != "Marker" || tokens[head + 2].kind != TOKEN_LBRACE -> return None
    head = marker_group_skip_semicolons(tokens, head + 3)
    if head + 3 >= tokens.len() || tokens[head].kind != TOKEN_IDENT || token_decoded(tables, tokens[head]) != "group" || tokens[head + 1].kind != TOKEN_COLON || tokens[head + 2].kind != TOKEN_HASH || tokens[head + 3].kind != TOKEN_LBRACKET -> return None
    depth := 1
    end := head + 4
    loop end < tokens.len() {
        if tokens[end].kind == TOKEN_EOF -> return None
        if tokens[end].kind == TOKEN_LBRACKET -> depth += 1
        if tokens[end].kind == TOKEN_RBRACKET {
            depth -= 1
            if depth == 0 -> break
        }
        end += 1
    }
    if end >= tokens.len() -> return None
    stop := marker_group_skip_semicolons(tokens, end + 1)
    if stop >= tokens.len() || tokens[stop].kind != TOKEN_RBRACE -> return None
    stop = marker_group_skip_semicolons(tokens, stop + 1)
    if stop >= tokens.len() || tokens[stop].kind != TOKEN_RBRACE -> return None
    Val(MarkerGroupTokenRange{name: token_decoded(tables, tokens[start]), start: head + 4, end: end, stop: stop})
}

marker_group_namespace_advance: fn(scope: &MarkerGroupNamespace, tokens: [Token], tables: TokenTables, index: Int) Never! {
    if tokens[index].kind == TOKEN_LBRACE {
        previous := String?{None}
        if index >= 3 && tokens[index - 1].kind == TOKEN_KW_MODULE && tokens[index - 2].kind == TOKEN_COLON && tokens[index - 3].kind == TOKEN_IDENT {
            previous = Val(scope.path)
            name: token_decoded(tables, tokens[index - 3])
            scope.path = if scope.path == "" -> name else -> "{scope.path}.{name}"
        }
        scope.braces.push(previous)
    }
    if tokens[index].kind == TOKEN_RBRACE && scope.braces.len() > 0 {
        previous: scope.braces.pop() ?? None
        if previous == .Val(path) -> scope.path = path
    }
}

named_marker_groups: fn(tokens: [Token], tables: TokenTables) -> [NamedMarkerGroupTokens] Never! {
    code: marker_group_code(tokens)
    groups := [NamedMarkerGroupTokens]{}
    index := 0
    scope := MarkerGroupNamespace{path: "", braces: [String?]{}}
    loop index < code.len() {
        declarative: loop brace in scope.braces { if brace == None -> break false } ?? true
        if declarative && marker_group_token_range(code, tables, index) == .Val(range) {
            name: if scope.path == "" -> range.name else -> "{scope.path}.{range.name}"
            member_tables := token_tables()
            members := [Token]{}
            loop cursor in range.start..<range.end -> members.push(marker_group_rebase_token(code[cursor], tables, member_tables))
            groups.push(NamedMarkerGroupTokens{name: name, name_span: code[index].span, members: members.move(), tables: member_tables.move()})
            index = range.stop + 1
            next
        }
        marker_group_namespace_advance(scope, code, tables, index)
        index += 1
    }
    groups
}

marker_group_scope_allows: fn(group: NamedMarkerGroupTokens, scope: String) -> Bool Never! {
    if group.required_scope == .Val(required) -> return scope == required || scope.starts_with("{required}.")
    true
}

marker_group_find: fn(local: [NamedMarkerGroupTokens], imported: [NamedMarkerGroupTokens], name: String, scope: String) -> NamedMarkerGroupTokens? Never! {
    prefix := scope
    loop prefix != "" {
        qualified: "{prefix}.{name}"
        loop group in imported { if group.name == qualified && marker_group_scope_allows(group, scope) -> return Val(group) }
        loop group in local { if group.name == qualified -> return Val(group) }
        parts: prefix.split(".").to_list()
        prefix = parts.slice(0, parts.len() - 1).join(".")
    }
    loop group in imported { if group.name == name && marker_group_scope_allows(group, scope) -> return Val(group) }
    loop group in local { if group.name == name -> return Val(group) }
    None
}

marker_group_expandable: fn(group: NamedMarkerGroupTokens, local: [NamedMarkerGroupTokens], imported: [NamedMarkerGroupTokens]) -> Bool Never! {
    index := 0
    depth := 0
    count := 0
    entry := true
    parts: group.name.split(".").to_list()
    scope: parts.slice(0, parts.len() - 1).join(".")
    loop index < group.members.len() {
        kind: group.members[index].kind
        if depth == 0 && entry && kind != TOKEN_SEMI {
            if kind == TOKEN_BANG -> return false
            path: marker_token_path(group.members, group.tables, index) ?? return false
            name: path.name
            if name == "Unsafe" || name == "Impure" || name == "Nondeterministic" || name == "Allow" || name == "Scrub" || name == "FX" -> return false
            if marker_group_find(local, imported, name, scope) != None -> return false
            index = path.end
            count += 1
            entry = false
            next
        }
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if (kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE) && depth > 0 -> depth -= 1
        if depth == 0 && kind == TOKEN_COMMA -> entry = true
        index += 1
    }
    count >= 2
}

// Tokens from another lexed source carry table-local IDs. Preserve the old
// self-contained-payload behavior by importing every referenced fact, including
// nested interpolation tokens, into the destination table before insertion.
marker_group_rebase_token: fn(token: Token, source: TokenTables, tables: &TokenTables) -> Token Never! {
    value := token
    value.text = name_intern(tables.names, name_text(source.names, token.text))
    value.decoded = name_intern(tables.names, name_text(source.names, token.decoded))
    if token.literal < 0 -> return value
    literal: source.literals[token.literal]
    parts := [StringPart]{}
    loop part in literal.string_parts {
        nested := [Token]{}
        loop inner in part.tokens -> nested.push(marker_group_rebase_token(inner, source, tables))
        parts.push(StringPart{kind: part.kind, span: part.span, text: name_intern(tables.names, name_text(source.names, part.text)), byte: part.byte, tokens: nested.move()})
    }
    // The typed-head reading, rebased the same way as a token of its own.
    head := -1
    head_decoded := name_empty()
    if literal.head >= 0 {
        reading := token
        reading.literal = literal.head
        reading.decoded = literal.head_decoded
        rebased: marker_group_rebase_token(reading, source, tables)
        head = rebased.literal
        head_decoded = rebased.decoded
    }
    tables.literals.push(TokenLiteral{integer: literal.integer, decimal: literal.decimal, suffix: name_intern(tables.names, name_text(source.names, literal.suffix)), interpolations: literal.interpolations, string_parts: parts.move(), head: head, head_decoded: head_decoded, deferred: literal.deferred.copy(), escapes: literal.escapes.copy()})
    value.literal = tables.literals.len() - 1
    value
}

marker_group_push_members: fn(output: &[Token], group: NamedMarkerGroupTokens, span: Span, tables: &TokenTables) Never! {
    loop token in group.members {
        value := marker_group_rebase_token(token, group.tables, tables)
        value.span = span
        output.push(value)
    }
}

expand_named_marker_groups_with_uses: fn(tokens: [Token], tables: &TokenTables, imported: [NamedMarkerGroupTokens]) -> ExpandedMarkerGroups {
    local: named_marker_groups(tokens, tables)
    if local.len() == 0 && imported.len() == 0 -> return ExpandedMarkerGroups{tokens: tokens, uses: [ExpandedMarkerGroupUse]{}}
    code: marker_group_code(tokens)
    output := [Token]{}
    uses := [ExpandedMarkerGroupUse]{}
    index := 0
    scope := MarkerGroupNamespace{path: "", braces: [String?]{}}
    loop index < code.len() {
        if marker_group_token_range(code, tables, index) == .Val(range) {
            loop cursor in index..<range.stop + 1 -> output.push(code[cursor])
            index = range.stop + 1
            next
        }
        if code[index].kind == TOKEN_HASH {
            if marker_token_path(code, tables, index + 1) == .Val(path) && marker_group_find(local, imported, path.name, scope.path) == .Val(group) && marker_group_expandable(group, local, imported) && (path.end >= code.len() || code[path.end].kind != TOKEN_LPAREN) {
                span: Span{start: code[index].span.start, end: code[path.end - 1].span.end}
                uses.push(ExpandedMarkerGroupUse{name: group.name, span: span})
                // The `#`, `[` and `]` each read the marker's own token.
                hash := code[index]
                hash.span = span
                open := code[index]
                open.span = span
                open.kind = TOKEN_LBRACKET
                close := code[index]
                close.span = span
                close.kind = TOKEN_RBRACKET
                output.push(hash)
                output.push(open)
                marker_group_push_members(output, group, span, tables)
                output.push(close)
                index = path.end
                next
            }
            if index + 1 < code.len() && code[index + 1].kind == TOKEN_LBRACKET {
                output.push(code[index])
                output.push(code[index + 1])
                index += 2
                depth := 0
                entry := true
                loop index < code.len() {
                    kind: code[index].kind
                    if depth == 0 && kind == TOKEN_RBRACKET -> break
                    if depth == 0 && entry && marker_token_path(code, tables, index) == .Val(path) && marker_group_find(local, imported, path.name, scope.path) == .Val(group) && marker_group_expandable(group, local, imported) && (path.end >= code.len() || code[path.end].kind != TOKEN_LPAREN) {
                        span: Span{start: code[index].span.start, end: code[path.end - 1].span.end}
                        uses.push(ExpandedMarkerGroupUse{name: group.name, span: span})
                        marker_group_push_members(output, group, span, tables)
                        index = path.end
                        entry = false
                        next
                    }
                    if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
                    if (kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE) && depth > 0 -> depth -= 1
                    entry = depth == 0 && kind == TOKEN_COMMA
                    output.push(code[index])
                    index += 1
                }
                next
            }
        }
        marker_group_namespace_advance(scope, code, tables, index)
        output.push(code[index])
        index += 1
    }
    ExpandedMarkerGroups{tokens: output, uses: uses}
}
