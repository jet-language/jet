// The final argument is parser metadata, never source text
// supplied by a program. Marker/derive/generated bodies share one parser.
use {
    jet_foundation.[AccessConvention, Call, CallArg, Expr, StrPart, Type, ast_empty_call_arg_flags]
    jet_lexer.[TOKEN_HASH, TOKEN_IDENT, TOKEN_LBRACE]
}

parser_parse_generate_template_arg: fn(state: &JetParserState, method: String, args: &[CallArg]) -> Bool {
    if method != "generate" || parser_current_kind(state) != TOKEN_LBRACE -> return false
    parser_parse_template_items_arg(state, args)
    true
}

// The `{ items }` block at the current `{`, pushed as the hidden final
// argument that carries its items.
parser_parse_template_items_arg: fn(state: &JetParserState, args: &[CallArg]) {
    open: parser_current(state).span
    items := parser_marker_body(state)
    span: parser_cover(open, parser_lookahead(state, -1).span)
    flags := ast_empty_call_arg_flags()
    flags.template_items = Val(items)
    args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{}, span: span, id: parser_node_id(state)}, span: span, flags: flags, label: None, spread: false})
}

// `#code { items }`, written with no space between `#` and `code`. Its
// spelling is the Syntax registry's CODE_VALUE; `code` stays an identifier.
parser_code_value_ahead: fn(state: &JetParserState) -> Bool Never! {
    if parser_kind_at(state, 0) != TOKEN_HASH || parser_kind_at(state, 1) != TOKEN_IDENT || parser_value_at(state, 1) != "code" -> return false
    parser_kind_at(state, 2) == TOKEN_LBRACE && parser_lookahead(state, 0).span.end == parser_lookahead(state, 1).span.start
}

// A `Code` value: the call `#code` whose one argument is its item block, as
// a `b.generate` template rides on its call (sema_build_code_value).
parser_parse_code_value: fn(state: &JetParserState) -> ParsedExpr {
    hash: parser_bump(state)
    word: parser_bump(state)
    args := [CallArg]{}
    parser_parse_template_items_arg(state, args)
    span: parser_cover(hash.span, parser_lookahead(state, -1).span)
    call: Call{name: "#code", name_span: parser_cover(hash.span, word.span), type_args: [Type]{}, args: args}
    ParsedExpr{expr: Expr.Call{call: call, id: parser_node_id(state)}, span: span}
}
