// Rust: crates/jet-parser/src/Parser/mod.rs:888
fn parser_with_nesting<T>(state: &JetParserState, span: Span, f: fn(&JetParserState) -> T ParserFailure!) -> T ParserFailure! {
    if state.depth >= MAX_SOURCE_NESTING -> return Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_source_nesting_exceeded(state.depth + 1, span)}})
    state.depth += 1
    // Capture both rails before restoring depth, including a callback failure.
    result :: f(&state)
    state.depth -= 1
    result
}
// Rust: crates/jet-parser/src/Parser/mod.rs:902
fn parser_peek_is_ident(state: &JetParserState, name: String) -> Bool Never! {
    token :: parser_current(&state)
    token.kind == TOKEN_IDENT && token.payload.decoded == name
}
