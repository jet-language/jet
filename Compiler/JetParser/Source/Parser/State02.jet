// Rust: crates/jet-parser/src/Parser/mod.rs:989
// expect_kw has exact Rust messages; canonical parser_expect supplies recovery.
fn parser_expect_kw(state: &JetParserState, want: Int, context: String) -> Token {
    if parser_current_kind(&state) == want -> return parser_bump(&state)
    token :: parser_current(&state)
    expected :: parser_describe_token(parser_synthetic_token(want, token.span))
    parser_add_fatal_code(&state, "E0003", token.span,
        "expected {expected} {context}, found {parser_describe_token(token)}",
        "the structure here isn't what the compiler expected", "use {expected} {context}")
    parser_synthetic_token(want, token.span)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1009
// expect -> parser_expect_kw above, same discriminant matching and messages.
// Rust: crates/jet-parser/src/Parser/mod.rs:1016
fn parser_expect_list_separator(state: &JetParserState, context: String, construct: String) {
    if state.source_present && parser_unclosed_delimiter(&state, construct) {
        state.abort_mark = state.diagnostics.len()
        state.abort_position = state.position
        return
    }
    parser_expect_kw(&state, TOKEN_COMMA, context)
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1028
fn parser_expect_closer(state: &JetParserState, want: Int, context: String, construct: String) {
    if parser_current_kind(&state) != want && state.source_present && parser_unclosed_delimiter(&state, construct) {
        state.abort_mark = state.diagnostics.len()
        state.abort_position = state.position
        return
    }
    parser_expect_kw(&state, want, context)
}
