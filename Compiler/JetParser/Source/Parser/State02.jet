// Rust: crates/jet-parser/src/Parser/mod.rs:183
fn prepare_tokens(toks: [Token]) -> ParserFenceExpansion ParserFailure! {
    has_comments := false
    has_fences := false
    loop token in toks {
        if token.kind == TOKEN_LINE_COMMENT || token.kind == TOKEN_BLOCK_COMMENT -> has_comments = true
        if token.kind == TOKEN_FENCE_OPEN || token.kind == TOKEN_FENCE_CLOSE -> has_fences = true
        if has_comments && has_fences -> break
    }
    // A clean input retains the lexer-owned descriptor; no token-vector clone.
    code := toks
    if has_comments {
        filtered := [Token]{}
        loop token in toks {
            if token.kind != TOKEN_LINE_COMMENT && token.kind != TOKEN_BLOCK_COMMENT -> &filtered.push(token)
        }
        code = ^filtered
    }
    prepared := if has_fences -> parser_fence_expand(code) else -> ParserFenceExpansion{
        tokens: code, fenced_statements: [], diagnostics: [], budget: ParserFenceBudget{entries: 0, bytes: 0}}
    if !prepared.diagnostics.is_empty() -> return Err(ParserFailure.Diagnostics{diagnostics: ^prepared.diagnostics})
    check_token_nesting(prepared.tokens)?
    prepared
}

// Rust: crates/jet-parser/src/Parser/mod.rs:218
fn parse_for_check_inner(toks: [Token], source: String?) -> (program: Program, diagnostics: [Diagnostic]) ParserFailure! {
    prepared := prepare_tokens(toks)?
    state := parser_new_state(prepared.tokens, source, true, false)
    program := parser_parse_program(&state)
    program.fenced_statements = ^prepared.fenced_statements
    program.block_spans = ^state.block_spans
    loop declaration in state.block_policy_declarations -> &program.policy_declarations.push(declaration)
    program.user_policy_declarations = ^state.user_policy_declarations
    program.applied_rules = ^state.applied_rules
    program.rule_facts = ^state.rule_facts
    loop diagnostic in state.diagnostics {
        if diagnostic.severity != 2 && !is_teaching_parse_diag(diagnostic.code) && diagnostic.code != "E0081" -> return Err(ParserFailure.Diagnostics{diagnostics: ^state.diagnostics})
    }
    (program: program, diagnostics: state.diagnostics)
}

// Rust: crates/jet-parser/src/Parser/mod.rs:272
fn parse_inner(toks: [Token], for_fmt: Bool, allow_environment_reads: Bool, source: String?) -> Program ParserFailure! {
    prepared := prepare_tokens(toks)?
    state := parser_new_state(prepared.tokens, source, for_fmt, allow_environment_reads)
    program := parser_parse_program(&state)
    program.fenced_statements = ^prepared.fenced_statements
    program.block_spans = ^state.block_spans
    loop declaration in state.block_policy_declarations -> &program.policy_declarations.push(declaration)
    program.user_policy_declarations = ^state.user_policy_declarations
    program.applied_rules = ^state.applied_rules
    program.rule_facts = ^state.rule_facts
    loop diagnostic in state.diagnostics {
        if diagnostic.severity != 1 -> next
        if for_fmt && (is_teaching_parse_diag(diagnostic.code) || (diagnostic.code == "E0927" && diagnostic.what.contains("retired"))) -> next
        return Err(ParserFailure.Diagnostics{diagnostics: ^state.diagnostics})
    }
    program
}

// Rust: crates/jet-parser/src/Parser/mod.rs:333
fn string_literal_value(parts: [StringPart]) -> String ParserFailure! {
    if parts.len() != 1 -> return Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_from_registry("E0003", None,
        "an import path must be one piece of quoted text", "file paths can't contain `{{ }}` interpolation",
        "write: {Syntax.KW_USE} \"path/to/file\";")}})
    part :: parts[0]
    if part.kind == STRING_PART_TEXT -> return part.text
    if part.kind == STRING_PART_BYTE -> return Char.from_u32(U32{part.byte}).to_string()
    Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_from_registry("E0003", None,
        "an import path can't contain `{{ }}` interpolation", "file paths are fixed strings",
        "write: {Syntax.KW_USE} \"path/to/file\";")}})
}

// Rust: crates/jet-parser/src/Parser/mod.rs:355
fn string_literal_token_value(token: Token) -> String ParserFailure! {
    if token.kind == TOKEN_STRING -> return string_literal_value(token.payload.string_parts)
    if token.kind == TOKEN_RAW_STRING -> return token.payload.decoded
    Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_from_registry("E0003", None,
        "expected quoted text, found {parser_describe_token(token)}",
        "this position accepts one non-interpolated string literal",
        "write a quoted string or a backtick-fenced raw string")}})
}

// Rust: crates/jet-parser/src/Parser/mod.rs:371
fn is_teaching_parse_diag(code: String) -> Bool Never! {
    code == "E0031" || code == "E0034" || code == "E0048" || code == "E0049" || code == "E0055" || code == "E0057" || code == "E0065" || code == "E0066" || code == "E0068" || code == "E0070" || code == "E0080" || code == "E0082" || code == "E0077" || code == "E0146" || code == "E0154" || code == "E0210" || code == "E0986" || code == "E0320" || code == "E0992" || code == "E0994" || code == "E0366" || code == "E0367" || code == "E0372" || code == "E0373" || code == "E0374" || code == "E0378" || code == "E0379" || code == "E0383" || code == "E0384" || code == "E0385" || code == "E0386" || code == "E0999" || code == "E0412" || code == "E0413" || code == "E0414" || code == "E0415" || code == "E0417" || code == "E0418" || code == "E0998" || code == "E0927" || code == "E1115"
}

// Rust: crates/jet-parser/src/Parser/mod.rs:432
// Parser maps to JetParserState (State.jet:47). This factory carries every Rust
// field/default, using canonical -1 for callable_tail_block_depth=None.
fn parser_new_state(tokens: [Token], source: String?, migration_mode: Bool, allow_environment_reads: Bool) -> JetParserState Never! {
    source_end :: if tokens.is_empty() -> 0 else -> tokens[tokens.len() - 1].span.end
    source_bytes :: if source == { .Val(text) -> text.bytes(); None -> [U8]{} }
    JetParserState{tokens: tokens, position: 0, diagnostics: [], source_end: source_end,
        source: source_bytes, source_present: source != None, line_starts: parser_line_starts(source_bytes),
        explicit_semicolon_reported: false, retired_step: None, pending_type_gt: false,
        pending_type_gt_span: Span{start: source_end, end: source_end}, depth: 0,
        result_handler_depth: 0, type_generic_depth: 0, type_generic_chain: [],
        type_generic_truncated: false, pub_file_default: false, in_layout_body: 0,
        adjacent_if_body_depth: 0, block_depth: 0, callable_tail_depth: -1,
        callable_tail_expects_value: false, lambda_tail_block_depth: None,
        module_arg_expr_depth: None, allow_lowercase_leading_dot: false,
        migration_mode: migration_mode, allow_environment_reads: allow_environment_reads,
        derive_template_depth: 0, block_policy_declarations: [], user_policy_declarations: [],
        applied_rules: [], rule_facts: [], block_spans: [], prep_value_block: None,
        prep_value_escape: None, statement_start: -1}
}

// Rust's Result<_, Vec<Diagnostic>> rail; diagnostics are not themselves errors.
#Error
pub enum ParserFailure {
    Diagnostics(diagnostics: [Diagnostic])
}

// Rust: crates/jet-parser/src/Parser/mod.rs:509,513
// Frames retain read-only array descriptors, not copies of nested token trees.
enum ParserNestingFrame {
    Tokens(tokens: [Token], position: Int, depth: Int)
    StringParts(parts: [StringPart], position: Int, depth: Int)
}
fn check_token_nesting(tokens: [Token]) -> () ParserFailure! {
    pending := [ParserNestingFrame]{ParserNestingFrame.Tokens{tokens: tokens, position: 0, depth: 0}}
    loop !pending.is_empty() {
        frame :: &pending.pop() ?? break
        if frame == {
            .Tokens(batch, position, initial_depth) -> {
                if position >= batch.len() -> next
                token :: batch[position]
                depth := initial_depth
                parts_depth := Int?{None}
                if token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LBRACE {
                    depth += 1
                    if depth > MAX_SOURCE_NESTING -> return Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_source_nesting_exceeded(depth, token.span)}})
                } else if token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACKET || token.kind == TOKEN_RBRACE {
                    if depth > 0 -> depth -= 1
                } else if token.kind == TOKEN_STRING {
                    has_interpolation :: loop part in token.payload.string_parts {
                        if part.kind == STRING_PART_INTERPOLATION -> break true
                    } ?? false
                    if has_interpolation {
                        interpolation_depth :: depth + 1
                        if interpolation_depth > MAX_SOURCE_NESTING -> return Err(ParserFailure.Diagnostics{diagnostics: [Diagnostic]{diagnostic_source_nesting_exceeded(interpolation_depth, token.span)}})
                        parts_depth = Val(interpolation_depth)
                    }
                }
                &pending.push(ParserNestingFrame.Tokens{tokens: batch, position: position + 1, depth: depth})
                if parts_depth == .Val(nested_depth) -> &pending.push(ParserNestingFrame.StringParts{parts: token.payload.string_parts, position: 0, depth: nested_depth})
            }
            .StringParts(parts, position, depth) -> {
                if position >= parts.len() -> next
                part :: parts[position]
                &pending.push(ParserNestingFrame.StringParts{parts: parts, position: position + 1, depth: depth})
                if part.kind == STRING_PART_INTERPOLATION -> &pending.push(ParserNestingFrame.Tokens{tokens: part.tokens, position: 0, depth: depth})
            }
        }
    }
}

