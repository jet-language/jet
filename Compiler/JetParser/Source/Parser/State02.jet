// Rust: crates/jet-parser/src/Parser/mod.rs:1335
// pat_span -> canonical Foundation pattern_span.
// Rust: crates/jet-parser/src/Parser/mod.rs:1342
fn leading_dot_variant(token: Token) -> String? Never! {
    if token.kind == TOKEN_NULL -> return Val(Syntax.LIT_NULL)
    if token.kind != TOKEN_IDENT -> return None
    name :: token.payload.decoded
    if Syntax.is_comptime_name(name) -> return Val(name)
    if name.chars().next() == .Val(first) && first.is_uppercase() -> return Val(name)
    None
