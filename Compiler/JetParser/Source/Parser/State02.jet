// Rust: crates/jet-parser/src/Parser/mod.rs:663
fn parser_environment_read_outside_config(span: Span) -> Diagnostic Never! {
    diagnostic_from_registry("E0003", Val(span), "`$NAME` is an environment read for config surfaces only",
        "D-ONCE-DOLLAR1=B reserves `$NAME` for typed environment access in `env.jet` and deploy/config files; ordinary program code does not read the environment with `$`",
        "move the read to `env.jet` or a deploy/config file, or use an explicit program API for runtime environment access")
}
// Rust: crates/jet-parser/src/Parser/mod.rs:673
fn parser_invalid_environment_read(span: Span) -> Diagnostic Never! {
    diagnostic_from_registry("E0003", Val(span), "an environment read needs a plain name after `$`",
        "config-surface environment access has the typed form `$NAME`",
        "write a name such as `$HOME` in `env.jet` or a deploy/config file")
}
// Rust: crates/jet-parser/src/Parser/mod.rs:687
fn parser_unknown_fact_root(name: String, span: Span) -> Diagnostic Never! {
    body :: name.strip_prefix(Syntax.COMPTIME_MARK) ?? name
    if !body.is_empty() && Syntax.is_constant_name(body) -> return parser_environment_read_outside_config(span)
    diagnostic_from_registry("E0003", Val(span), "`{name}` is not a compiler fact",
        "`$` marks facts the compiler supplies: the roots `{Syntax.FACT_ROOT_BUILD}`, `{Syntax.FACT_ROOT_PACKAGE}`, `{Syntax.FACT_ROOT_PHASE}` and `{Syntax.FACT_ROOT_PROGRAM}`, and `$` members of a type, function or value such as `T.$layout` (D-META-ROOT3=A)",
        "read a fact root such as `$build.os`, or read the fact on its subject, such as `T.$fields`")
}

