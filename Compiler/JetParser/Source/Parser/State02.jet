//RS                 kind: TokKind::KwTag,
//RS                 span,
//RS             } => Ok((Syntax::KW_TAG.to_string(), span)),
//RS             t => Err(Diagnostic::error(
//RS                 "E0003",
//RS                 format!("expected a name {}, found {}", where_, describe(&t.kind)),
//RS                 "names start with a letter or `_`".to_string(),
//RS                 "e.g. `main`, `count`, `_tmp`".to_string(),
//RS                 Some(t.span),
//RS             )),
//RS         }
//RS     }
//RS 
//RS     /// S84 (ratified 2026-06-16): a *dashed name* — `ident (-ident)*` — for the
//RS     /// kebab-case naming positions (package / module / system / image / env
//RS     /// names), matching nixpkgs/npm package-name convention. A `-` only joins
//RS     /// when it is **span-adjacent** to both neighbours (`prev.end == minus.start`
//RS     /// and `minus.end == next.start`); a spaced `a - b` therefore stays
//RS     /// subtraction (no lexer change, no expression-grammar change). No leading,
//RS     /// trailing, or doubled hyphen — `image.-iso` / `image.a--b` fall through to
//RS     /// the ordinary teaching diagnostic via `expect_ident`.
//RS     fn expect_dashed_name(&mut self, where_: &str) -> Result<(String, Span), Diagnostic> {
//RS         let (mut name, first_span) = self.expect_ident(where_)?;
//RS         let start = first_span.start;
//RS         let mut end = first_span.end;
//RS         // Join `-<segment>` while the hyphen and the following ident are both
//RS         // glued (no intervening whitespace) to the preceding segment.
//RS         while matches!(self.peek().kind, TokKind::Minus)
//RS             && self.peek().span.start == end
//RS             && matches!(self.peek2().kind, TokKind::Ident(_))
//RS             && self.peek2().span.start == self.peek().span.end
//RS         {
//RS             self.bump(); // `-`
//RS             let seg = self.bump(); // the adjacent ident
//RS             if let TokKind::Ident(s) = seg.kind {
//RS                 name.push_str(Syntax::NAME_SEGMENT_SEP);
//RS                 name.push_str(&s);
//RS                 end = seg.span.end;
//RS             }
//RS         }
//RS         Ok((name, Span::new(start, end)))
//RS     }
//RS 
//RS     /// D-EFFTREE1/D-AUTHORITY-MEM2: an effect path — `ident (.ident)*` — for effect-list
//RS     /// entries (`FS`, `FS.Read`, `Net.HTTP.Get`). The root is validated in
//RS     /// sema against the closed ten-name D-EFF4/5 vocabulary; further segments
//RS     /// are an open, user-chosen leaf path (mirrors D-TAG1's tag-tree dotted
//RS     /// paths) — not validated here, and with no depth limit.
//RS     fn expect_effect_path_name(&mut self, where_: &str) -> Result<(String, Span), Diagnostic> {
//RS         let (mut name, first_span) = self.expect_ident(where_)?;
//RS         let mut end = first_span.end;
//RS         while matches!(self.peek().kind, TokKind::Dot) {
//RS             self.bump(); // `.`
//RS             let (seg, seg_span) = self.expect_ident("for an effect path segment after `.`")?;
//RS             name.push('.');
//RS             name.push_str(&seg);
//RS             end = seg_span.end;
//RS         }
//RS         // Memory's bounded denial is the only parameterized rights-tree
//RS         // entry. Keep its closed argument in the canonical AST string so the
//RS         // formatter, sema, and every execution tier consume one spelling.
//RS         if name == "Mem.Alloc" && matches!(self.peek().kind, TokKind::LParen) {
//RS             self.bump();
//RS             let (label, label_span) = self.expect_ident("for the memory denial argument name")?;
//RS             if label != "above" {
//RS                 return Err(Diagnostic::error(
//RS                     "E0119",
//RS                     format!("`Mem.Alloc` does not accept the argument `{label}`"),
//RS                     "the bounded memory denial has one closed argument: `above: Bytes`".to_string(),
//RS                     "write `Mem.Alloc(above: 65536)`".to_string(),
//RS                     Some(label_span),
//RS                 ));
//RS             }
//RS             self.expect(TokKind::Colon, "after `above`")?;
//RS             let token = self.bump();
//RS             let TokKind::Int(value, _) = token.kind else {
//RS                 return Err(Diagnostic::error(
//RS                     "E0119",
//RS                     "`Mem.Alloc(above: …)` needs an integer byte ceiling".to_string(),
//RS                     "the bounded denial is checked at compile time and accepts a positive byte count".to_string(),
//RS                     "write `Mem.Alloc(above: 65536)`".to_string(),
//RS                     Some(token.span),
//RS                 ));
//RS             };
//RS             if value <= 0 {
//RS                 return Err(Diagnostic::error(
//RS                     "E0119",
//RS                     "`Mem.Alloc(above: …)` needs a positive byte ceiling".to_string(),
//RS                     "zero cannot bound a usable memory region".to_string(),
//RS                     "write a positive byte count, such as `Mem.Alloc(above: 65536)`".to_string(),
//RS                     Some(token.span),
//RS                 ));
//RS             }
//RS             let close_span = self.peek().span;
//RS             self.expect(TokKind::RParen, "after the memory denial argument")?;
//RS             name.push_str(&format!("(above: {value})"));
//RS             end = close_span.end;
//RS         }
//RS         Ok((name, Span::new(first_span.start, end)))
//RS     }
//RS }
