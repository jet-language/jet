//RS 
//RS /// One authored piece of a classic `if` chain, in source order. The L0507
//RS /// fix rebuilds the chain as an arm table from exactly these byte ranges.
//RS #[derive(Clone, Copy, Debug)]
//RS pub(crate) enum BranchPart {
//RS     Arm { cond: Span, body: Span },
//RS     Else { body: Span },
//RS }
//RS 
//RS /// True when the text between two recorded pieces holds only the chain's own
//RS /// connectors. Anything else — a comment, a retired arrow — means the rebuilt
//RS /// table would drop authored text, so no automatic fix is offered.
//RS fn branch_gap_is_connector(gap: &str) -> bool {
//RS     gap.split_whitespace().all(|word| {
//RS         matches!(word, "if" | "else") || word == Syntax::OP_UNIFIED_ARROW
//RS     })
//RS }
//RS 
//RS /// Re-indent every line after the first by one level, so a body moved from
//RS /// statement level into a table arm keeps its relative layout.
//RS fn indent_following_lines(text: &str, unit: &str) -> String {
//RS     let mut lines = text.split('\n');
//RS     let mut out = lines.next().unwrap_or_default().to_string();
//RS     for line in lines {
//RS         out.push('\n');
//RS         if !line.trim().is_empty() {
//RS             out.push_str(unit);
//RS             out.push_str(line);
//RS         }
//RS     }
//RS     out
//RS }
//RS 
//RS /// Take the next authored piece of a chain: the text before it must be only
//RS /// connectors, and pieces must advance in source order within `end`.
//RS fn take_branch_piece<'s>(
//RS     source: &'s str,
//RS     piece: Span,
//RS     cursor: &mut usize,
//RS     end: usize,
//RS ) -> Option<&'s str> {
//RS     if piece.start < *cursor || piece.end < piece.start || piece.end > end {
//RS         return None;
//RS     }
//RS     if !branch_gap_is_connector(source.get(*cursor..piece.start)?) {
//RS         return None;
//RS     }
//RS     *cursor = piece.end;
//RS     source.get(piece.start..piece.end).map(str::trim)
//RS }
