    PolicyDeclaration, UserPolicyDecl, AppliedRuleApplication, NamedSpan, SystemFieldValue, ImageFieldValue, Syntax, ast_program,
    diagnostic_from_registry, diagnostic_from_row, diagnostic_source_nesting_exceeded, MAX_SOURCE_NESTING,
    pattern_span, expr_span]
