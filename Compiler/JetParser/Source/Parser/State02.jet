    TOKEN_IDENT, TOKEN_STRING, TOKEN_RAW_STRING, TOKEN_LINE_COMMENT, TOKEN_BLOCK_COMMENT,
    TOKEN_FENCE_OPEN, TOKEN_FENCE_CLOSE, TOKEN_LPAREN, TOKEN_LBRACKET, TOKEN_LBRACE,
    TOKEN_RPAREN, TOKEN_RBRACKET, TOKEN_RBRACE, TOKEN_COMMA, TOKEN_MINUS, TOKEN_NULL,
    TOKEN_UNIFIED_ARROW, TOKEN_LAMBDA_ARROW, TOKEN_EOF, TOKEN_SEMI, TOKEN_KW_IN, TOKEN_KW_TAG]

