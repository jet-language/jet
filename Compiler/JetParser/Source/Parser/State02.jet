// Rust: crates/jet-parser/src/Parser/mod.rs:1117
fn parser_at_unified_arrow_token(kind: Int) -> Bool Never! {
    kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LAMBDA_ARROW
}
// Rust: crates/jet-parser/src/Parser/mod.rs:1121
// expect_unified_arrow -> State.jet:353, retired LambdaArrow teaches E0070.
// Rust: crates/jet-parser/src/Parser/mod.rs:1144
fn parser_expect_ident(state: &JetParserState, context: String) -> Token {
    token := parser_bump(&state)
    if token.kind == TOKEN_IDENT && token.payload.decoded != Syntax.KW_CONC_TASK -> return token
    if token.kind == TOKEN_IDENT {
        name :: token.payload.decoded
        parser_add_fatal_code(&state, "E0003", token.span,
            "`{name}` is reserved for structured task syntax",
            "the `task` word starts a child or task combinator", "choose a different identifier name")
        return token
    }
    if token.kind == TOKEN_KW_IN {
        parser_add_fatal_code(&state, "E0003", token.span,
            "`{Syntax.KW_IN}` is reserved as the source-loop keyword",
            "the `{Syntax.KW_IN}` keyword marks the boundary between a loop binding and its source",
            "choose a different identifier name, or use `{Syntax.KW_IN}` in a source loop; after `.` it is allowed as a member name")
        return token
    }
    if token.kind == TOKEN_KW_TAG {
        token.payload.decoded = Syntax.KW_TAG
        return token
    }
    parser_add_fatal_code(&state, "E0003", token.span,
        "expected a name {context}, found {parser_describe_token(token)}",
        "names start with a letter or `_`", "e.g. `main`, `count`, `_tmp`")
    token
}

// Rust: crates/jet-parser/src/Parser/mod.rs:1198
fn parser_expect_dashed_name(state: &JetParserState, context: String) -> NamedSpan {
    first :: parser_expect_ident(&state, context)
    name := first.payload.decoded
    end := first.span.end
    loop !parser_aborting(&state) && parser_current_kind(&state) == TOKEN_MINUS && parser_current(&state).span.start == end && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).span.start == parser_current(&state).span.end {
        parser_bump(&state)
        segment :: parser_bump(&state)
        name = "{name}{Syntax.NAME_SEGMENT_SEP}{segment.payload.decoded}"
        end = segment.span.end
    }
    NamedSpan{name: name, span: Span{start: first.span.start, end: end}}
}
