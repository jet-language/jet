//RS 
//RS /// Hard cap on recursive parser nesting (parentheses, unary chains,
//RS /// literals-with-expressions, generic types). Recursive descent here — and
//RS /// the recursive passes downstream (sema, codegen, fmt) — use the call
//RS /// stack, so unbounded nesting in adversarial input would abort the compiler
//RS /// with a stack overflow instead of the shared source-nesting diagnostic.
//RS 
//RS struct Parser<'a> {
//RS     toks: &'a [Token],
//RS     source: Option<String>,
//RS     pos: usize,
//RS     diags: Vec<Diagnostic>,
//RS     /// D-SEMI1=A: report one explicit semicolon boundary per source file.
//RS     explicit_semicolon_reported: bool,
//RS     /// Span of the last retired `++`/`--` step (E0160 already reported), so
//RS     /// the statement parser accepts its recovered operand without a second error.
//RS     retired_step: Option<Span>,
//RS     /// S33: when `>>` is split while closing nested `Type<…>`.
//RS     pending_type_gt: bool,
//RS     /// Current recursive parser nesting depth.
//RS     depth: usize,
//RS     /// Nested compact Result handlers leave the next `!` for their caller.
//RS     /// Only the outermost handler diagnoses an extra failure role.
//RS     result_handler_depth: usize,
//RS     /// Nesting depth inside generic type arguments (M9 E0909).
//RS     type_generic_depth: usize,
//RS     type_generic_chain: Vec<String>,
//RS     /// Set when generic depth exceeds the limit mid-parse.
//RS     type_generic_truncated: bool,
//RS     /// D-VISDEFAULT2=A: when true, top-level items default to public unless `priv`.
//RS     pub_file_default: bool,
//RS     /// D-LAYOUT1 / D-LAYOUT-CTOR1: >0 while parsing a `Layout.{ … }` body.
//RS     /// Retained for forks/probes; constraint elements are parsed as typed-
//RS     /// literal exprs (not bare expression statements), so the E0003
//RS     /// comparison-as-statement carve-out is unused on the happy path.
//RS     in_layout_body: usize,
//RS     /// >0 while a one-line effect-only `if` body is being parsed. The body's
//RS     /// statement may end at an adjacent `else` instead of a line terminator.
//RS     adjacent_if_body_depth: usize,
//RS     /// Current statement-block nesting. An explicit callable result contract
//RS     /// may admit one final value expression only at its own body depth.
//RS     block_depth: usize,
//RS     callable_tail_block_depth: Option<usize>,
//RS     /// D-TAIL-RETURN1=A: the callable owning `callable_tail_block_depth`
//RS     /// declares (or may infer) a result value. A unit callable's trailing
//RS     /// `if` stays a statement, so its arm-tail loops keep statement meaning.
//RS     callable_tail_expects_value: bool,
//RS     /// A depth whose final loop keeps statement meaning: the body depth of the
//RS     /// innermost block lambda (its result may be unit, a callback; sema alone
//RS     /// knows whether that tail is a value), or the enclosing depth while a
//RS     /// braceless arm's single statement is parsed.
//RS     lambda_tail_block_depth: Option<usize>,
//RS     /// While parsing a value in `Template<...>`, a top-level `>` closes the
//RS     /// application instead of becoming a comparison. Nested expressions can
//RS     /// still use `>` normally.
//RS     module_arg_expr_depth: Option<usize>,
//RS     /// D-JPK-BUILDRECIPE1: lower-case leading-dot build steps are values only
//RS     /// inside the ratified `Recipe.build(steps: [...])` surface. Ordinary
//RS     /// expressions keep the existing upper-case enum-variant grammar.
//RS     allow_lowercase_leading_dot: bool,
//RS     /// Internal one-shot corpus migration arm. Retired spellings remain
//RS     /// recoverable for `fmt`/check so formatter can rewrite old sources; no
//RS     /// user-facing switch exposes this mode.
//RS     migration_mode: bool,
//RS     /// D-ONCE-DOLLAR1=B: config surfaces admit `$NAME` as a typed environment
//RS     /// read. Ordinary source leaves the same token on the teaching path.
//RS     allow_environment_reads: bool,
//RS     /// >0 while parsing a typed item-template body (`derive`, marker, or
//RS     /// `b.generate`). A compile-time name in a type slot is an internal hole
//RS     /// here; expansion fills it before ordinary sema checks the item.
//RS     derive_template_depth: usize,
//RS     policy_declarations: Vec<crate::Policy::PolicyDeclaration>,
//RS     user_policy_declarations: Vec<crate::AST::UserPolicyDecl>,
//RS     applied_rules: Vec<crate::AST::AppliedRuleApplication>,
//RS     rule_facts: Vec<crate::AST::AppliedRuleApplication>,
//RS     block_spans: Vec<Span>,
//RS     /// The innermost `name :: prep { … }` value block being parsed: its `{`
//RS     /// span and the block depth of its statements.
//RS     prep_value_block: Option<(Span, usize)>,
//RS     /// Set when a binding statement opened directly in that block shows it was
//RS     /// never closed: the token where the enclosing binding's parse resumes.
//RS     prep_value_escape: Option<usize>,
//RS }
//RS 
