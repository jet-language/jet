// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:44
fn parse_result_handler_inner(state: &JetParserState, subject: ParsedExpr, question_span: Span, depth: Int, check_duplicate_failure: Bool) -> ParsedExpr {
    ok_binding :: parser_expect_name(&state, "for the success payload binding after `?`")
    if ok_binding.payload.decoded == "_" -> parser_add_fatal_code(&state, "E0003", ok_binding.span, "a Result handler success branch needs a payload binding", "the compact handler exposes the success payload inside its branch", "name the payload after `?`, for example `? ok -> ...`")
    if parser_aborting(&state) -> return subject
    parser_expect_unified_arrow(&state, "after the success payload binding")
    if parser_aborting(&state) -> return subject
    ok_branch :: parse_result_handler_branch(&state, depth + 1)
    if parser_aborting(&state) -> return subject
    if parser_current_kind(&state) != TOKEN_BANG {
        parser_add_fatal_code(&state, "E0003", parser_current(&state).span, "a Result handler needs a `!` failure branch", "the compact handler is exhaustive: it has one success branch and one failure branch", "add `! error -> failure` after the success branch")
        return subject
    }
    bang_span :: parser_bump(&state).span
    err_binding :: parser_expect_name(&state, "for the failure payload binding after `!`")
    if err_binding.payload.decoded == "_" -> parser_add_fatal_code(&state, "E0003", err_binding.span, "a Result handler failure branch needs a payload binding", "the compact handler exposes the failure payload inside its branch", "name the payload after `!`, for example `! error -> ...`")
    if parser_aborting(&state) -> return subject
    if err_binding.payload.decoded == ok_binding.payload.decoded -> parser_add_fatal_code(&state, "E0003", err_binding.span, "a Result handler cannot bind both payloads to the same name", "the success and failure payloads are distinct branch-local values", "give the success and failure payloads different names")
    if parser_aborting(&state) -> return subject
    parser_expect_unified_arrow(&state, "after the failure payload binding")
    if parser_aborting(&state) -> return subject
    err_branch :: parse_result_handler_branch(&state, depth + 1)
    if parser_aborting(&state) -> return subject
    if check_duplicate_failure && parser_expression_form_result_separator_ahead(&state) {
        parser_add_fatal_code(&state, "E0003", parser_current(&state).span, "a Result handler cannot have two failure branches", "the compact handler has exactly one success role and one failure role", "keep one `! error -> ...` branch")
        return subject
    }
    ok_span :: parser_cover(question_span, ok_binding.span)
    err_span :: parser_cover(bang_span, err_binding.span)
    ok_cond :: Expr.PatternTest{subject: subject.expr, pattern: Pattern.Ok{binding: ok_binding.payload.decoded, binding_span: ok_binding.span, inner: None, span: ok_span}, span: ok_span}
    err_cond :: Expr.PatternTest{subject: subject.expr, pattern: Pattern.Err{binding: err_binding.payload.decoded, binding_span: err_binding.span, inner: None, span: err_span}, span: err_span}
    end :: expr_span(err_branch.value).end
    span :: Span{start: subject.span.start, end: end}
    err_if :: Expr.If{cond: err_cond, then_body: err_branch.body, then_value: err_branch.value, else_body: [], else_value: Expr.NoElse{span: Span{start: end, end: end}}, span: span}
    ParsedExpr{expr: Expr.If{cond: ok_cond, then_body: ok_branch.body, then_value: ok_branch.value, else_body: [], else_value: err_if, span: span}, span: span}
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:154
fn parse_result_handler_branch(state: &JetParserState, depth: Int) -> ParserExpressionFormValueBranch {
    if parser_current_kind(&state) == TOKEN_LBRACE -> return parse_result_handler_block(&state, depth + 1)
    if parser_current_kind(&state) == TOKEN_RETURN {
        return_span :: parser_bump(&state).span
        value := Expr?{None}
        kind :: parser_current_kind(&state)
        if !parser_expression_form_result_separator_ahead(&state) && kind != TOKEN_RBRACE && kind != TOKEN_SEMI && kind != TOKEN_EOF -> value = Val(parser_parse_expression(&state, 1, depth + 1).expr)
        end :: if value == { .Val(expr) -> expr_span(expr).end; .None -> return_span.end }
        span :: Span{start: return_span.start, end: end}
        return ParserExpressionFormValueBranch{body: [Stmt]{Stmt.Return{value: value, span: return_span}}, value: Expr.NoElse{span: Span{start: end, end: end}}, span: span}
    }
    branch := parse_selected_value(&state, depth + 1)
    if branch.value == .Call(call) && call.name == "panic" {
        end :: expr_span(branch.value).end
        // Rust discards the selected block's earlier body in this exact branch.
        branch.body = [Stmt]{Stmt.Expr{expr: branch.value}}
        branch.value = Expr.NoElse{span: Span{start: end, end: end}}
    }
    branch
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:188
fn parse_result_handler_block(state: &JetParserState, depth: Int) -> ParserExpressionFormValueBranch {
    open :: parser_expect(&state, TOKEN_LBRACE, "to open this Result handler branch")
    stmts := [Stmt]{}
    loop {
        if parser_aborting(&state) -> return ParserExpressionFormValueBranch{body: stmts, value: Expr.NoElse{span: parser_current(&state).span}, span: parser_cover(open.span, parser_current(&state).span)}
        parser_skip_synthetic_semicolons(&state)
        token :: parser_current(&state)
        if token.kind == TOKEN_RBRACE {
            parser_bump(&state)
            parser_add_fatal_code(&state, "E0003", token.span, "a Result handler branch cannot be empty", "each exhaustive branch must produce a value or diverge", "add a value, `return`, or another diverging tail")
            next
        }
        if token.kind == TOKEN_EOF {
            parser_add_fatal_code(&state, "E0003", token.span, "expected `}}` to close this Result handler branch", "every `{{` needs a matching `}}`", "add a closing `}}`")
            next
        }
        save :: state.position
        diags :: state.diagnostics.len()
        blocks :: state.block_spans.len()
        else_arms :: state.else_arms.len()
        // This scan avoids reparsing nested control bodies exponentially.
        if parser_value_tail_ahead(state) {
            value :: parser_parse_expression(&state, 1, depth + 1)
            if !parser_error_since(state, diags) {
                if parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE {
                    semi :: parser_current(&state).span
                    if semi.start != semi.end && !parser_expression_definitely_diverges(value.expr) {
                        parser_add_fatal_code(&state, "E0114", value.span, "this Result handler branch ends with a semicolon-terminated expression", "a value-expected block must end with one unadorned expression; a semicolon-terminated expression yields unit", "remove the semicolon, or use `return ...` for an early exit")
                        next
                    }
                    parser_bump(&state)
                }
                if parser_current_kind(&state) == TOKEN_RBRACE {
                    close :: parser_bump(&state).span
                    if value.expr == .Call(call) && call.name == "panic" {
                        &stmts.push(Stmt.Expr{expr: value.expr})
                        end :: value.span.end
                        return ParserExpressionFormValueBranch{body: stmts, value: Expr.NoElse{span: Span{start: end, end: end}}, span: parser_cover(open.span, close)}
                    }
                    return ParserExpressionFormValueBranch{body: stmts, value: value.expr, span: parser_cover(open.span, close)}
                }
            }
            parser_rewind(&state, save, diags, blocks, else_arms)
        }
        stmt :: parser_parse_statement(&state)
        if parser_aborting(&state) -> next
        diverges :: if stmt == {
            .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) -> true
            .Expr(expr) -> if expr == { .Call(call) -> call.name == "panic"; .Todo(_, _) -> true; else -> false }
            else -> false
        }
        &stmts.push(stmt)
        if diverges && parser_current_kind(&state) == TOKEN_RBRACE {
            close :: parser_bump(&state).span
            return ParserExpressionFormValueBranch{body: stmts, value: Expr.NoElse{span: Span{start: close.start, end: close.start}}, span: parser_cover(open.span, close)}
        }
    }
}

