// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1023
fn if_arm_head(state: &JetParserState, subject: Expr, pat_subject: Expr, op: BinOp, depth: Int) -> Expr {
    range :: parser_parse_range_arm_head(&state, pat_subject)
    if range == .Val(value) -> return value
    if parser_pattern_rhs_ahead(&state) {
        save :: state.position
        diags :: state.diagnostics.len()
        blocks :: state.block_spans.len()
        else_arms :: state.else_arms.len()
        pattern :: parser_parse_pattern(&state, depth + 1, true)
        if parser_aborting(&state) -> return Expr.PatternTest{subject: pat_subject, pattern: pattern.pattern, span: pattern.span}
        after :: parser_current_kind(&state)
        if parser_at_unified_arrow(&state) || after == TOKEN_AND_AND || after == TOKEN_OR_OR {
            result := parser_expression_form_pattern_condition(&state, pat_subject, pattern, op)
            if op != BinOp.Eq || parser_at_unified_arrow(&state) -> return result
            loop parser_current_kind(&state) == TOKEN_AND_AND && !parser_aborting(&state) {
                parser_bump(&state)
                result = parser_expression_form_combine(result, parse_arm_bool_operand(&state, subject, op, depth + 1), BinOp.And)
            }
            loop parser_current_kind(&state) == TOKEN_OR_OR && !parser_aborting(&state) {
                parser_bump(&state)
                group := parse_arm_bool_operand(&state, subject, op, depth + 1)
                loop parser_current_kind(&state) == TOKEN_AND_AND && !parser_aborting(&state) {
                    parser_bump(&state)
                    group = parser_expression_form_combine(group, parse_arm_bool_operand(&state, subject, op, depth + 1), BinOp.And)
                }
                result = parser_expression_form_combine(result, group, BinOp.Or)
            }
            return result
        }
        parser_rewind(&state, save, diags, blocks, else_arms)
    }
    save :: state.position
    diags :: state.diagnostics.len()
    blocks :: state.block_spans.len()
    else_arms :: state.else_arms.len()
    raw :: parser_parse_expression_no_struct_lit(&state, depth + 1)
    if !parser_error_since(state, diags) {
        redundant :: if raw.expr == {
            .PatternTest(lhs, _, _) -> parser_expression_form_same_dispatch_subject(lhs, subject)
            .Binary(binop, lhs, _, _) -> binop == op && parser_expression_form_same_dispatch_subject(lhs, subject)
            else -> false
        }
        if redundant {
            &state.diagnostics.push(redundant_subject_diag(raw.span))
            return raw.expr
        }
    }
    parser_rewind(&state, save, diags, blocks, else_arms)
    parse_arm_value_cond(&state, subject, op, depth + 1)
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1144
fn redundant_subject_diag(span: Span) -> Diagnostic {
    diagnostic_from_registry("E0994", Val(span), "drop the `subject OP` — the comparison on the `if` already applies it to every arm", "`if subject OP {{ … }}` matches each arm head against the subject, so repeating `subject OP` on an arm is redundant", "delete the `subject OP` prefix; write just the value or pattern")
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1160
fn distributed_atom_group_diag(state: &JetParserState, span: Span) -> Diagnostic {
    diagnostic := Diagnostic.from_row("E0386", [], Val(span))
    if span.start >= 0 && span.end >= span.start && span.end <= state.source.len() {
        source := String.from_bytes(state.source[span.start..<span.end]) // #4303
        if source == .Val(text) -> diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: "({text})"})
    }
    diagnostic
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1181
fn parse_arm_and_cond(state: &JetParserState, subject: Expr, op: BinOp, depth: Int) -> Expr {
    (lhs, count, span) :: parse_arm_alternates_cond(&state, subject, op, false, depth + 1)
    if count > 1 && (parser_current_kind(&state) == TOKEN_AND_AND || parser_current_kind(&state) == TOKEN_OR_OR) -> &state.diagnostics.push(distributed_atom_group_diag(&state, span))
    result := lhs
    loop parser_current_kind(&state) == TOKEN_AND_AND && !parser_aborting(&state) {
        parser_bump(&state)
        result = parser_expression_form_combine(result, parse_arm_bool_operand(&state, subject, op, depth + 1), BinOp.And)
    }
    result
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1210
fn parse_arm_value_cond(state: &JetParserState, subject: Expr, op: BinOp, depth: Int) -> Expr {
    result := parse_arm_and_cond(&state, subject, op, depth + 1)
    loop parser_current_kind(&state) == TOKEN_OR_OR && !parser_aborting(&state) {
        parser_bump(&state)
        result = parser_expression_form_combine(result, parse_arm_bool_operand(&state, subject, op, depth + 1), BinOp.Or)
    }
    result
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1235
fn parse_arm_bool_operand(state: &JetParserState, subject: Expr, op: BinOp, depth: Int) -> Expr {
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        inner :: parse_arm_value_cond(&state, subject, op, depth + 1)
        parser_expect(&state, TOKEN_RPAREN, "to close the arm head group")
        return inner
    }
    (cond, count, span) :: parse_arm_alternates_cond(&state, subject, op, true, depth + 1)
    if count > 1 -> &state.diagnostics.push(distributed_atom_group_diag(&state, span))
    cond
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1258
fn parse_arm_alternates_cond(state: &JetParserState, subject: Expr, op: BinOp, prefer_predicate: Bool, depth: Int) -> (Expr, Int, Span) {
    start :: parser_current(&state).span.start
    result := parse_arm_atom_cond(&state, subject, op, prefer_predicate, depth + 1)
    end := parser_prev_token_end(state)
    count := 1
    loop parser_current_kind(&state) == TOKEN_PIPE && parser_kind_at(&state, 1) != TOKEN_PIPE && !parser_aborting(&state) {
        parser_bump(&state)
        value :: parse_arm_atom_cond(&state, subject, op, false, depth + 1)
        result = parser_expression_form_combine(result, value, BinOp.Or)
        end = parser_prev_token_end(state)
        count += 1
    }
    (result, count, Span{start: start, end: end})
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1303
fn parse_dispatch_atom_expr(state: &JetParserState, depth: Int) -> ParsedExpr {
    lhs :: parser_parse_expression_dispatch_atom(&state, depth + 1)
    kind :: parser_current_kind(&state)
    op :: if kind == {
        TOKEN_EQ_EQ -> Val(BinOp.Eq)
        TOKEN_NOT_EQ -> Val(BinOp.Ne)
        TOKEN_LT -> Val(BinOp.Lt)
        TOKEN_GT -> if state.module_arg_expr_depth != Val(depth) -> Val(BinOp.Gt) else -> None
        TOKEN_LE -> Val(BinOp.Le)
        TOKEN_GE -> Val(BinOp.Ge)
        TOKEN_COMPARE -> Val(BinOp.Compare)
        else -> None
    } ?? return lhs
    op_span :: parser_bump(&state).span
    if op == BinOp.Eq && parser_pattern_rhs_ahead(&state) {
        pattern :: parser_parse_pattern(&state, depth + 1, true)
        span :: Span{start: lhs.span.start, end: pattern.span.end.max(op_span.end)}
        return ParsedExpr{expr: Expr.PatternTest{subject: lhs.expr, pattern: pattern.pattern, span: span}, span: span}
    }
    rhs :: parser_parse_expression_dispatch_atom(&state, depth + 1)
    span :: Span{start: lhs.span.start, end: rhs.span.end.max(op_span.end)}
    ParsedExpr{expr: Expr.Binary{op: op, left: lhs.expr, right: rhs.expr, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1335
fn parse_arm_atom_cond(state: &JetParserState, subject: Expr, op: BinOp, prefer_predicate: Bool, depth: Int) -> Expr {
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        inner :: parse_arm_value_cond(&state, subject, op, depth + 1)
        parser_expect(&state, TOKEN_RPAREN, "to close the arm head group")
        return inner
    }
    raw :: parse_dispatch_atom_expr(&state, depth + 1)
    arm_atom_to_cond(subject, raw.expr, op, prefer_predicate)
}
// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1359
fn arm_atom_to_cond(subject: Expr, value: Expr, op: BinOp, prefer_predicate: Bool) -> Expr Never! {
    predicate :: if value == {
        .Binary(binop, _, _, _) -> binop == BinOp.Eq || binop == BinOp.Ne || binop == BinOp.Lt || binop == BinOp.Gt || binop == BinOp.Le || binop == BinOp.Ge || binop == BinOp.Compare || binop == BinOp.And || binop == BinOp.Or
        .PatternTest(_, _, _) -> true
        .Bool(_, _) -> prefer_predicate
        .Unary(unary, _, _) -> unary == UnOp.Not
        .Ident(_, _) | .Field(_, _, _) | .Call(_) | .MethodCall(_, _, _, _, _, _, _, _, _, _) -> prefer_predicate
        else -> false
    }
    if predicate -> return value
    Expr.Binary{op: op, left: subject, right: value, span: Span{start: expr_span(subject).start, end: expr_span(value).end}}
}
