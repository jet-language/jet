fn parse_selected_value(state: &JetParserState, depth: Int) -> ParserExpressionFormValueBranch {
    if parser_current_kind(&state) == TOKEN_LBRACE -> return parse_value_block(&state, depth + 1)
    value :: parser_parse_expression(&state, 1, depth + 1)
    ParserExpressionFormValueBranch{body: [], value: value.expr, span: value.span}
}
