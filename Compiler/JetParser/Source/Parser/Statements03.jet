// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:332
fn scope_member_stmt(state: &JetParserState, depth: Int) -> Stmt {
    dot_span :: parser_bump(&state).span
    name :: parser_expect_name(&state, "for the scope-member name")
    args := [Expr]{}
    args_span := Span?{None}
    if parser_current_kind(&state) == TOKEN_LPAREN {
        lp :: parser_bump(&state).span
        loop parser_current_kind(&state) != TOKEN_RPAREN && !parser_aborting(&state) {
            &args.push(parser_parse_expression(&state, 1, depth + 1).expr)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            parser_expect(&state, TOKEN_COMMA, "between scope-member arguments")
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
        parser_expect(&state, TOKEN_RPAREN, "to close the scope-member arguments")
        args_span = Val(Span{start: lp.start, end: parser_prev_token_end(state)})
    }
    body :: parser_parse_block(&state)
    Stmt.ScopeMember{name: name.payload.decoded, name_span: name.span, args: args, args_span: args_span, body: body.statements, dsl: false, dot_span: dot_span, span: Span{start: dot_span.start, end: parser_prev_token_end(state)}}
}

