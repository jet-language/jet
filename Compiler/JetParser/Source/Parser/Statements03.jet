fn braceless_arm_stmt(state: &JetParserState) -> Stmt {
    saved :: state.lambda_tail_block_depth
    state.lambda_tail_block_depth = Val(state.block_depth)
    statement :: parser_parse_statement(&state)
    state.lambda_tail_block_depth = saved
    statement
}
