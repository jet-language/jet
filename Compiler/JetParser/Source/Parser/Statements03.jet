// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1742
fn parse_value_block(state: &JetParserState, depth: Int) -> ParserExpressionFormValueBranch {
    open :: parser_expect(&state, TOKEN_LBRACE, "to open this `if` branch")
    stmts := [Stmt]{}
    loop {
        if parser_aborting(&state) -> return ParserExpressionFormValueBranch{body: stmts, value: Expr.NoElse{span: parser_current(&state).span}, span: parser_cover(open.span, parser_current(&state).span)}
        parser_skip_synthetic_semicolons(&state)
        token :: parser_current(&state)
        if token.kind == TOKEN_RBRACE {
            parser_bump(&state)
            if stmts.len() > 0 {
                stmt :: stmts[stmts.len() - 1]
                if parser_statement_definitely_exits_value_block(stmt) -> return ParserExpressionFormValueBranch{body: stmts, value: Expr.NoElse{span: Span{start: token.span.start, end: token.span.start}}, span: parser_cover(open.span, token.span)}
                parser_add_fatal_code(&state, "E0114", stmt_span(stmt), "this value branch ends with a statement instead of a value", "a value-expected block must end with one unadorned expression; statements yield unit", "put one unadorned expression last, or use `return ...` for an early exit")
            } else {
                parser_add_fatal_code(&state, "E0003", token.span, "this `if` branch is empty but is used as a value", "when `if` produces a value, each branch must end with one (S68)", "put a value as the last line, like `{{ x }}`")
            }
            next
        }
        if token.kind == TOKEN_EOF {
            parser_add_fatal_code(&state, "E0003", token.span, "expected `}}` to close this `if` branch, found the end of the file", "every `{{` needs a matching `}}`", "add a closing `}}`")
            next
        }
        save :: state.position
        diags :: state.diagnostics.len()
        blocks :: state.block_spans.len()
        else_arms :: state.else_arms.len()
        if parser_value_tail_ahead(state) {
            value :: parser_parse_expression(&state, 1, depth + 1)
            if !parser_error_since(state, diags) {
                if parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE {
                    semi :: parser_current(&state).span
                    if semi.start != semi.end && !parser_expression_definitely_diverges(value.expr) {
                        parser_add_fatal_code(&state, "E0114", value.span, "this value branch ends with a semicolon-terminated expression", "a value-expected block must end with one unadorned expression; a semicolon-terminated expression yields unit", "remove the semicolon, or use `return ...` for an early exit")
                        next
                    }
                    parser_bump(&state)
                }
                if parser_current_kind(&state) == TOKEN_RBRACE {
                    close :: parser_bump(&state).span
                    return ParserExpressionFormValueBranch{body: stmts, value: value.expr, span: parser_cover(open.span, close)}
                }
            }
            parser_rewind(&state, save, diags, blocks, else_arms)
        }
        statement :: parser_parse_statement(&state)
        if parser_aborting(&state) {
            parser_recover_aborted_statement(&state, save)
        } else {
            &stmts.push(statement)
        }
    }
}

// Rust: crates/jet-parser/src/Parser/Statements/conditionals.rs:1844
fn switch_after_kw(state: &JetParserState, span: Span, depth: Int) -> Stmt {
    subject :: parser_parse_expression_no_struct_lit(&state, depth + 1).expr
    parser_expect(&state, TOKEN_LBRACE, "to open the `switch` body")
    arms := [SwitchArm]{}
    else_body := [Stmt]?{None}
    loop !parser_aborting(&state) {
        token :: parser_current(&state)
        if token.kind == TOKEN_RBRACE {
            parser_bump(&state)
            break
        }
        if token.kind == TOKEN_EOF {
            parser_add_fatal_code(&state, "E0003", token.span, "expected `}}` to close this `switch`, found the end of the file", "every `{{` needs a matching `}}`", "add a closing `}}`")
            break
        }
        if token.kind == TOKEN_PIPE {
            arm_start :: parser_bump(&state).span
            if parser_current_kind(&state) == TOKEN_KW_ELSE {
                parser_bump(&state)
                body :: parser_parse_block(&state).statements
                if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
                else_body = Val(body)
            } else {
                cond :: parse_arm_value_cond(&state, subject, BinOp.Eq, depth + 1)
                body :: parser_parse_block(&state).statements
                end :: parser_current(&state).span.end
                if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
                &arms.push(SwitchArm{cond: cond, body: body, span: Span{start: arm_start.start, end: end}})
            }
            next
        }
        // Rust's FOREIGN_CASE/FOREIGN_DEFAULT arm is guarded by literal false;
        // no token can enter that branch.
        if token.kind == TOKEN_KW_ELSE {
            parser_bump(&state)
            parser_expect_unified_arrow(&state, "after `else` in a `switch`")
            body :: parser_parse_block(&state).statements
            parser_expect(&state, TOKEN_SEMI, "after a `switch` arm's closing `}}`")
            else_body = Val(body)
            next
        }
        cond := Expr?{None}
        if token.kind == TOKEN_DOT && leading_dot_variant(parser_lookahead(&state, 1)) != None {
            dot_span :: parser_bump(&state).span
            variant_token :: parser_bump(&state)
            variant :: leading_dot_variant(variant_token) ?? panic("leading-dot variant guard and token must agree")
            bindings := [jet_foundation.PatSlot]{}
            end := variant_token.span.end
            if parser_current_kind(&state) == TOKEN_LPAREN {
                parser_bump(&state)
                loop parser_current_kind(&state) != TOKEN_RPAREN && !parser_aborting(&state) {
                    &bindings.push(parser_parse_pattern_slot(&state, depth + 1))
                    if parser_current_kind(&state) == TOKEN_RPAREN -> break
                    parser_expect(&state, TOKEN_COMMA, "between pattern bindings")
                    if parser_current_kind(&state) == TOKEN_RPAREN -> break
                }
                parser_expect(&state, TOKEN_RPAREN, "after pattern bindings")
                end = parser_prev_token_end(state)
            }
            pat_span :: Span{start: dot_span.start, end: end}
            cond = Val(Expr.PatternTest{subject: subject, pattern: Pattern.Variant{variant: variant, bindings: bindings, leading_dot: true, span: pat_span}, span: pat_span})
        } else {
            cond = parser_parse_range_arm_head(&state, subject)
        }
        head :: cond ?? parser_parse_expression_no_struct_lit(&state, depth + 1).expr
        parser_expect_unified_arrow(&state, "after a `switch` arm's condition")
        body :: parser_parse_block(&state).statements
        semi_end :: parser_current(&state).span.end
        parser_expect(&state, TOKEN_SEMI, "after a `switch` arm's closing `}}`")
        &arms.push(SwitchArm{cond: head, body: body, span: Span{start: token.span.start, end: semi_end}})
    }
    Stmt.Switch{subject: subject, arms: arms, else_body: else_body, span: span}
}
