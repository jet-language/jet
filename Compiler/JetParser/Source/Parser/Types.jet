// Type grammar constructs JetFoundation Type variants directly. Type source
// spans are returned separately because semantic Type intentionally carries no
// parser locations.
use {
    jet_foundation.[
        AccessConvention,
        CallablePolicy,
        CallablePolicyChain,
        CallContractRow,
        EffectRowEntry,
        FunctionCallMetadata,
        FunctionDefaultRef,
        Measure,
        MeasureRule,
        ParamZone,
        Span,
        TagMarker,
        TextEdit,
        Type,
        TypeTupleField,
        diagnostic_from_registry,
        diagnostic_with_edit,
        type_tuple_fields_canonical,
        type_name,
        foundation_named_type,
    ]
    jet_lexer.[
        TOKEN_AND_AND,
        TOKEN_BANG,
        TOKEN_COLON,
        TOKEN_COMMA,
        TOKEN_DOT,
        TOKEN_DOT_DOT,
        TOKEN_EOF,
        TOKEN_FLOAT,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_FN,
        TOKEN_KW_TAG,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_LT_GT,
        TOKEN_MINUS,
        TOKEN_PIPE,
        TOKEN_PLUS,
        TOKEN_QUESTION,
        TOKEN_QUESTION_QUESTION,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SHR,
        TOKEN_SLASH,
        TOKEN_STAR,
    ]
}

ParsedType: struct {
    ty: Type
    span: Span
}

parser_parse_type: fn(state: &JetParserState, depth: Int) -> ParsedType {
    if depth > 256 {
        span: parser_current(state).span
        parser_add_fatal_code(state, "E1403", span, "this type is nested too deeply", "type parsing is bounded against adversarial nesting", "reduce the nesting depth")
        return ParsedType{ty: Type.Named{name: "__jet_error"}, span: span}
    }

    start: parser_current(state)
    // A whole type position may hold only a contract,
    // `E!` or `(A | B)!`, the unit-success carrier.
    if parser_suffix_contract_ahead(state) >= 0 {
        error_type: parser_parse_suffix_contract(state, depth + 1)
        return ParsedType{ty: Type.Result{ok: Type.Named{name: "Unit"}, err: error_type.ty}, span: parser_cover(start.span, error_type.span)}
    }
    ty: parser_parse_type_atom(state, depth + 1)
    // The error contract follows the success type:
    // `Int ParseError!`, `Entry? (DBError | TimeoutError)!`.
    if parser_suffix_contract_ahead(state) >= 0 {
        error_type: parser_parse_suffix_contract(state, depth + 1)
        result: Type.Result{ok: ty.ty, err: error_type.ty}
        return ParsedType{ty: result, span: parser_cover(start.span, error_type.span)}
    }

    parser_parse_type_union_tail(state, ty, depth + 1)
}

parser_next_code_index: fn(state: JetParserState, start: Int) -> Int Never! {
    index := start
    loop index < state.tokens.len() {
        if !parser_is_trivia(state.tokens[index].kind) -> return index
        index += 1
    }
    -1
}

// The index just past one error-contract member (a dotted
// type path with optional `<...>` arguments, a `( ... )` group, or a
// `[ ... ]` list of errors), or -1.
parser_scan_contract_member: fn(state: JetParserState, start: Int) -> Int Never! {
    index := parser_next_code_index(state, start)
    if index < 0 -> return -1
    kind: state.tokens[index].kind
    if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET {
        close_kind: if kind == TOKEN_LPAREN -> TOKEN_RPAREN else -> TOKEN_RBRACKET
        depth := 0
        loop index < state.tokens.len() {
            current: state.tokens[index].kind
            if current == kind -> depth += 1
            if current == close_kind {
                depth -= 1
                if depth == 0 -> return index + 1
            }
            if current == TOKEN_LBRACE || current == TOKEN_RBRACE || current == TOKEN_SEMI || current == TOKEN_EOF -> return -1
            index += 1
        }
        return -1
    }
    if kind != TOKEN_IDENT -> return -1
    index += 1
    loop {
        dot: parser_next_code_index(state, index)
        if dot < 0 || state.tokens[dot].kind != TOKEN_DOT -> break
        name: parser_next_code_index(state, dot + 1)
        if name < 0 || state.tokens[name].kind != TOKEN_IDENT -> break
        index = name + 1
    }
    open: parser_next_code_index(state, index)
    if open >= 0 && state.tokens[open].kind == TOKEN_LT {
        depth := 0
        cursor := open
        loop cursor < state.tokens.len() {
            current: state.tokens[cursor].kind
            if current == TOKEN_LT -> depth += 1
            if current == TOKEN_GT -> depth -= 1
            if current == TOKEN_SHR -> depth -= 2
            if current == TOKEN_LBRACE || current == TOKEN_RBRACE || current == TOKEN_SEMI || current == TOKEN_EOF -> return -1
            cursor += 1
            if depth <= 0 -> break
        }
        if depth != 0 -> return -1
        index = cursor
    }
    index
}

// Does an error contract start here? -1 when none, 0 for
// `E!` or `(A | B)!`, and 1 for the rejected unparenthesized `A | B!`.
parser_suffix_contract_ahead: fn(state: &JetParserState) -> Int Never! {
    if state.pending_type_gt -> return -1
    parser_skip_trivia(state)
    index := state.position
    members := 0
    loop {
        index = parser_scan_contract_member(state, index)
        if index < 0 -> return -1
        members += 1
        next_index: parser_next_code_index(state, index)
        if next_index < 0 -> return -1
        kind: state.tokens[next_index].kind
        if kind == TOKEN_BANG {
            if members > 1 -> return 1
            return 0
        }
        if kind != TOKEN_PIPE -> return -1
        index = next_index + 1
    }
    -1
}

// The error half of a contract and its `!`. A union needs
// its parentheses: `A | B!` is taught as `(A | B)!`.
parser_parse_suffix_contract: fn(state: &JetParserState, depth: Int) -> ParsedType {
    bare_union: parser_suffix_contract_ahead(state) == 1
    first_index: state.position
    error_type: parser_parse_type_union(state, depth + 1)
    end_index: state.position
    bang: parser_expect(state, TOKEN_BANG, "`!` after the error contract")
    span: parser_cover(error_type.span, bang.span)
    if bare_union {
        text: parser_tokens_text(state, first_index, end_index)
        marked: parser_tokens_text(state, parser_contract_last_member(state, first_index), end_index)
        parser_add_type_mark_error(state, "E-ERR-UNION", span, "`{text}!` marks only `{marked}` as the error contract.", "The `!` mark follows one type, so a union of error types is grouped for the mark to cover every member.", "Write `({text})!`.", "({text})!")
    }
    ParsedType{ty: error_type.ty, span: span.move()}
}

// The token where the last member of a bare `A | B` union starts: the one
// member its `!` actually marks.
parser_contract_last_member: fn(state: JetParserState, first: Int) -> Int Never! {
    start := first
    index := first
    loop {
        index = parser_scan_contract_member(state, index)
        if index < 0 -> return start
        pipe: parser_next_code_index(state, index)
        if pipe < 0 || state.tokens[pipe].kind != TOKEN_PIPE -> return start
        member: parser_next_code_index(state, pipe + 1)
        if member < 0 -> return start
        start = member
        index = member
    }
    start
}

parser_type_starts: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_IDENT || kind == TOKEN_SELF || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_STAR || kind == TOKEN_KW_FN
}

// `#TagName Type`: a value-tag prefix on a type. The tag is a PascalCase name.
parser_type_tag_ahead: fn(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_HASH || parser_kind_at(state, 1) != TOKEN_IDENT -> return false
    parser_pascal_name(parser_value_at(state, 1))
}

parser_tokens_text: fn(state: JetParserState, first: Int, end: Int) -> String Never! {
    out := ""
    previous_end := -1
    loop index in first..<end {
        token: state.tokens[index]
        text: parser_text(state, token)
        if parser_is_trivia(token.kind) || text == "" -> next
        if previous_end >= 0 && token.span.start > previous_end -> out = "{out} "
        out = "{out}{text}"
        previous_end = token.span.end
    }
    out
}

// Source text of a type written before a suffix mark,
// grouped when the mark would otherwise bind to its last member.
parser_marked_type_text: fn(state: JetParserState, ty: Type, first: Int, end: Int) -> String Never! {
    text: parser_tokens_text(state, first, end)
    grouped: if ty == {
        .Union(_) | .Fn(_, _, _, _, _, _) | .Result(_, _) | .Tagged(_, _) -> true
        else -> false
    }
    if grouped && !text.starts_with("(") -> return "({text})"
    text
}

parser_add_type_mark_error: fn(state: &JetParserState, code: String, span: Span, what: String, why: String, fix: String, replacement: String) {
    diagnostic: diagnostic_from_registry(code, Val(span), what, why, fix)
    state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: replacement}))
}

parser_parse_type_union: fn(state: &JetParserState, depth: Int) -> ParsedType {
    ty: parser_parse_type_atom(state, depth + 1)
    parser_parse_type_union_tail(state, ty, depth + 1)
}

parser_parse_type_union_tail: fn(state: &JetParserState, first: ParsedType, depth: Int) -> ParsedType {
    result := first
    members := [Type]{}
    loop parser_current_kind(state) == TOKEN_PIPE {
        parser_bump(state)
        next: parser_parse_type_atom(state, depth + 1)
        if members.len() == 0 -> members.push(result.ty)
        members.push(next.ty)
        result.span.end = next.span.end
    }
    if members.len() > 0 -> result.ty = Type.Union{members: members}
    result
}

// `?` follows the type it marks and binds tightly, so
// `[Int?]`, `[Int]?`, `Box<Int?>`, and `Box<Int>?` all differ. `T??` is E0309.
parser_parse_type_atom: fn(state: &JetParserState, depth: Int) -> ParsedType {
    parsed: parser_parse_type_base(state, depth + 1)
    base: parser_parse_inline_range(state, parsed) ?? parsed
    kind: parser_current_kind(state)
    if kind != TOKEN_QUESTION && kind != TOKEN_QUESTION_QUESTION -> return base
    mark: parser_bump(state)
    already_optional: if base.ty == {
        .Option(_) -> true
        else -> false
    }
    span: parser_cover(base.span, mark.span)
    if kind == TOKEN_QUESTION_QUESTION || already_optional {
        parser_add_error_code(state, "E0309", mark.span, "`??` isn't allowed on a type", "an optional value is written `T?` once; there is no optional optional", "use a single `?`, like `Int?`")
    }
    if already_optional -> return ParsedType{ty: base.ty, span: span}
    ParsedType{ty: Type.Option{inner: base.ty}, span: span.move()}
}

// An inline range `Int(lo..hi)` may follow a type in every type position;
// its carrier is always `Int`. A consumed `>>` leaves one virtual outer `>`
// pending, and the `(` after it belongs to the enclosing call. None when no
// range follows `base`.
parser_parse_inline_range: fn(state: &JetParserState, base: ParsedType) -> ParsedType? {
    if state.pending_type_gt || parser_current_kind(state) != TOKEN_LPAREN -> return None
    if parser_kind_at(state, 1) != TOKEN_INT && parser_kind_at(state, 1) != TOKEN_MINUS -> return None
    open: parser_bump(state)
    lower: parser_distinct_range_bound(state, "as the range's lower bound")
    parser_expect(state, TOKEN_DOT_DOT, "between the range's bounds")
    upper: parser_distinct_range_bound(state, "as the range's upper bound")
    close: parser_expect(state, TOKEN_RPAREN, "to close the range constraint")
    span: parser_cover(base.span, close.span)
    if lower.value > upper.value {
        parser_add_error_code(state, "E0137", parser_cover(lower.span, upper.span), "this range is empty — {lower.value} is after {upper.value}", "a range's low bound must not be greater than its high bound", "write `{upper.value}..{lower.value}` (swap the bounds), or fix the values")
    }
    if base.ty != Type.Int {
        parser_add_error_code(state, "E0137", parser_cover(open.span, close.span), "inline value ranges apply to `Int`, not `{type_name(base.ty)}`", "an inline range carries an interval on the default integer carrier", "write `Int(lo..hi)` here, or declare a named distinct type for another carrier")
        return Val(ParsedType{ty: base.ty, span: span})
    }
    Val(ParsedType{ty: Type.InlineRange{base: base.ty, lo: lower.value, hi: upper.value}, span: span})
}

parser_parse_type_base: fn(state: &JetParserState, depth: Int) -> ParsedType {
    start: parser_current(state)
    kind: start.kind

    if parser_type_tag_ahead(state) {
        parser_bump(state)
        marker_token: parser_bump(state)
        inner: parser_parse_type(state, depth + 1)
        return ParsedType{ty: Type.Tagged{marker: TagMarker.User{name: parser_value(state, marker_token)}, inner: inner.ty}, span: parser_cover(start.span, inner.span)}
    }
    if kind == {
        TOKEN_STAR -> {
            parser_bump(state)
            elem: parser_parse_type_atom(state, depth + 1)
            ParsedType{ty: Type.Apply{name: "Ptr", args: [Type]{elem.ty}}, span: parser_cover(start.span, elem.span)}
        }
        TOKEN_KW_FN -> parser_parse_function_type(state, depth + 1)
        TOKEN_LBRACKET -> parser_parse_collection_type(state, depth + 1)
        TOKEN_LPAREN -> parser_parse_tuple_type(state, depth + 1)
        else -> {
            if kind != TOKEN_IDENT && kind != TOKEN_SELF {
                found: parser_text(state, start)
                parser_add_error(state, start.span, "expected a type, found `{found}`", "a type position needs a type constructor or a declared type name", "write a type name such as `Int`, `String?`, or `[U8]")
                if kind != TOKEN_EOF && kind != TOKEN_RBRACE && kind != TOKEN_COMMA -> parser_bump(state)
                return ParsedType{ty: Type.Named{name: "__jet_error"}, span: start.span}
            }
            // (E1107): the per-container prefix spelling `columnar [T]` is
            // reserved; nothing ships, so it is a fatal teaching error at the
            // prefix word.
            if kind == TOKEN_IDENT && parser_value(state, start) == "columnar" && parser_kind_at(state, 1) == TOKEN_LBRACKET {
                parser_add_fatal_code(state, "E1107", start.span, "the `columnar [T]` per-container layout form is reserved", "a per-use columnar override isn't built yet — only the whole-struct form ships", "put `#Layout(columnar)` on the `struct` declaration instead")
                return ParsedType{ty: Type.Named{name: "__jet_error"}, span: start.span}
            }
            parser_bump(state)
            name := parser_value(state, start)
            end := start.span
            loop parser_current_kind(state) == TOKEN_DOT {
                parser_bump(state)
                member: parser_expect_name(state, "after `.` in a type path")
                name = "{name}.{parser_value(state, member)}"
                end = member.span
            }
            if parser_current_kind(state) == TOKEN_LT {
                return parser_parse_applied_type(state, name, parser_cover(start.span, end), depth + 1)
            }
            // `Box<>`: `<>` is one token, the value a pipe step receives, so
            // an empty type-argument list is read and refused here.
            if parser_current_kind(state) == TOKEN_LT_GT {
                empty: parser_bump(state)
                diagnostic: diagnostic_from_registry("E0440", Val(empty.span), "`{name}<>` has an empty type-argument list", "A type's arguments go between `<` and `>`; `<>` lists none, so it only adds noise", "Write the type arguments, such as `{name}<Int>`, or drop the `<>`")
                state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: empty.span, new_text: ""}))
                return ParsedType{ty: foundation_named_type(name), span: parser_cover(start.span, empty.span)}
            }
            // E0119: a `$fact` path segment reads a compile-time fact value,
            // which never names a type outside a derive template.
            if state.derive_template_depth == 0 && (name.starts_with("$") || name.contains(".$")) {
                parser_add_error_code(state, "E0119", start.span, "`{name}` is a fact value, not a type", "facts classify values at compile time; they do not mint or select types", "read the fact in a compile-time value position instead")
            }
            ParsedType{ty: foundation_named_type(name), span: parser_cover(start.span, end)}
        }
    }
}

parser_parse_collection_type: fn(state: &JetParserState, depth: Int) -> ParsedType {
    open: parser_bump(state)
    first: parser_parse_type(state, depth + 1)
    if parser_current_kind(state) == TOKEN_COLON {
        parser_bump(state)
        value: parser_parse_type(state, depth + 1)
        close: parser_expect(state, TOKEN_RBRACKET, "`]` after the map value type")
        return ParsedType{ty: Type.Map{key: first.ty, key_span: Val(first.span), value: value.ty}, span: parser_cover(open.span, close.span)}
    }
    if parser_current_kind(state) == TOKEN_HASH {
        parser_bump(state)
        measure: parser_parse_measure(state, "length", depth + 1)
        close: parser_expect(state, TOKEN_RBRACKET, "`]` after the fixed-list length")
        return ParsedType{ty: Type.FixedList{elem: first.ty, len: measure.move()}, span: parser_cover(open.span, close.span)}
    }
    close: parser_expect(state, TOKEN_RBRACKET, "`]` after the list element type")
    ParsedType{ty: Type.List{element: first.ty}, span: parser_cover(open.span, close.span)}
}

parser_parse_tuple_type: fn(state: &JetParserState, depth: Int) -> ParsedType {
    open: parser_bump(state)
    if parser_current_kind(state) == TOKEN_RPAREN {
        close: parser_bump(state)
        return ParsedType{ty: Type.Named{name: "Unit"}, span: parser_cover(open.span, close.span)}
    }
    fields := [TypeTupleField]{}
    loop {
        // A member name is an identifier or the `tag` keyword, which also
        // spells an ordinary name (parser_expect_name).
        kind: parser_current_kind(state)
        if {
            (kind == TOKEN_IDENT || kind == TOKEN_KW_TAG) && parser_kind_at(state, 1) == TOKEN_COLON -> {
                name: parser_expect_name(state, "for a tuple member name")
                parser_bump(state)
                ty: parser_parse_type(state, depth + 1)
                fields.push(TypeTupleField{name: parser_value(state, name), ty: ty.ty})
            }
            else -> {
                ty: parser_parse_type(state, depth + 1)
                fields.push(TypeTupleField{name: "", ty: ty.ty})
            }
        }
        if parser_current_kind(state) == TOKEN_RPAREN -> break
        if parser_current_kind(state) != TOKEN_COMMA {
            token: parser_current(state)
            parser_add_error(state, token.span, "expected `,` between tuple type members", "tuple types list their members in source order", "add a comma or close the tuple type")
            break
        }
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_RPAREN -> break
    }
    close: parser_expect(state, TOKEN_RPAREN, "`)` after the tuple type")
    if fields.len() == 1 && fields[0].name == "" -> return ParsedType{ty: fields[0].ty, span: parser_cover(open.span, close.span)}
    // S73: a named tuple type stores its members sorted by name, so its
    // identity ignores source order (Rust `canonicalize_tuple_fields`).
    ParsedType{ty: Type.Tuple{fields: type_tuple_fields_canonical(fields)}, span: parser_cover(open.span, close.span)}
}

// A function type `fn(T1, …) -> R`, `fn(T1, …) -[E]> R` or `fn(…) E!`. It
// reuses the parameter grammar's zone separators public
// labels and zones are part of callable identity, local names are not.
parser_parse_function_type: fn(state: &JetParserState, depth: Int) -> ParsedType {
    start: parser_bump(state)
    parser_parse_function_type_from(state, depth, start.span)
}

// A function type from its `(` on; `start` is where the type began.
parser_parse_function_type_from: fn(state: &JetParserState, depth: Int, start: Span) -> ParsedType {
    parser_expect(state, TOKEN_LPAREN, "`(` after `fn` in a function type")
    params := [Type]{}
    names := [String]{}
    zones := [ParamZone]{}
    conventions := [AccessConvention]{}
    marked := false
    zone := ParamZone.Either
    saw_slash := false
    saw_star := false
    if parser_current_kind(state) != TOKEN_RPAREN {
        loop !parser_aborting(state) {
            token: parser_current(state)
            if {
                token.kind == TOKEN_SLASH -> {
                    parser_bump(state)
                    if saw_slash || saw_star || params.len() == 0 {
                        parser_report_fn_type_zone(state, token.span)
                    } else {
                        saw_slash = true
                        positional := [ParamZone]{}
                        loop _ in zones -> positional.push(ParamZone.PositionalOnly)
                        zones = positional
                    }
                }
                token.kind == TOKEN_STAR -> {
                    parser_bump(state)
                    if saw_star {
                        parser_report_fn_type_zone(state, token.span)
                    } else {
                        saw_star = true
                        zone = ParamZone.LabelOnly
                    }
                }
                else -> {
                    name := ""
                    if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
                        parser_bump(state)
                        parser_bump(state)
                        name = parser_value(state, token)
                    }
                    // A parameter type marks a taken input `&&`, as a declared
                    // parameter does: `fn(&&Map)` takes its argument.
                    convention := AccessConvention.Read
                    if parser_current_kind(state) == TOKEN_AND_AND {
                        parser_bump(state)
                        convention = AccessConvention.Move
                        marked = true
                    }
                    params.push(parser_parse_type(state, depth + 1).ty)
                    names.push(name)
                    zones.push(zone.copy())
                    conventions.push(convention)
                }
            }
            if parser_current_kind(state) == TOKEN_RPAREN -> break
            parser_expect(state, TOKEN_COMMA, "`,` between parameter types in `fn(...)`")
            if parser_current_kind(state) == TOKEN_RPAREN -> break
        }
    }
    close: parser_expect(state, TOKEN_RPAREN, "`)` after parameter types in `fn(...)`")
    has_label_only := false
    unlabeled_label_only := false
    loop index in 0..<zones.len() {
        if zones[index] == ParamZone.LabelOnly {
            has_label_only = true
            if names[index] == "" -> unlabeled_label_only = true
        }
    }
    after_params: parser_current(state).span
    if saw_star && !has_label_only -> parser_report_fn_type_zone(state, after_params)
    if unlabeled_label_only {
        parser_add_error_code(state, "E0763", after_params, "a parameter after `*` in this function type has no label", "a label-only parameter is reached by writing its label, so it has to have one", "name it, as in `fn(*, force: Bool) Int`")
    }
    param_contract := [CallContractRow]?{None}
    if saw_slash || saw_star {
        rows := [CallContractRow]{}
        loop index in 0..<zones.len() {
            label: if zones[index] == ParamZone.LabelOnly -> names[index] else -> ""
            rows.push(CallContractRow{label: label, zone: zones[index]})
        }
        param_contract = Val(rows)
    }
    first: parser_current_kind(state)
    second: parser_kind_at(state, 1)
    canonical: first == TOKEN_MINUS && second == TOKEN_LBRACKET
    effect_bound := [EffectRowEntry]?{None}
    if canonical -> effect_bound = Val(parser_parse_effect_arrow_row(state))
    arrow_return := false
    result := ParsedType?{None}
    if {
        canonical -> {
            result = parser_parse_unit_fallible_return(state)
            if !parser_has_type(result) && parser_type_starts_here(state) {
                arrow_return = true
                result = Val(parser_parse_type(state, depth + 1))
            }
        }
        parser_at_unified_arrow(state) -> {
            parser_bump(state)
            arrow_return = true
            result = parser_parse_unit_fallible_return(state)
            if !parser_has_type(result) && parser_type_starts_here(state) -> result = Val(parser_parse_type(state, depth + 1))
        }
        else -> result = parser_parse_unit_fallible_return(state)
    }
    returned := Type?{None}
    end := close.span
    if result == .Val(parsed) {
        returned = Val(parsed.ty)
        end = parsed.span
        if arrow_return && parser_is_unit_fallible(parsed.ty) {
            parser_add_error_code(state, "E0003", parsed.span, "a unit-fallible signature has no `->`", "a function that can fail but returns no value has no result payload for an arrow to introduce", "write `save: fn(path: String) IOError!`, or omit the contract for implicit `Err`")
        }
    }
    owners := [String]{}
    loop index in 0..<names.len() {
        owners.push(if names[index] == "" -> "_{index}" else -> names[index])
    }
    return_view: parser_parse_opt_declared_view_from(state, owners)
    if effect_bound == None && parser_func_effect_starts_here(state) {
        late_first: parser_current_kind(state)
        if late_first == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_LBRACKET -> effect_bound = Val(parser_parse_effect_arrow_row(state))
    }
    end = parser_lookahead(state, -1).span
    // Only a marked parameter needs call metadata; its names repeat the contract's labels so
    // the mark adds no label a plain function type lacks.
    call_metadata := FunctionCallMetadata?{None}
    if marked {
        call_metadata = Val(FunctionCallMetadata{
            names: loop index in 0..<zones.len() -> if zones[index] == ParamZone.LabelOnly -> names[index] else -> "",
            defaults: loop _ in params -> FunctionDefaultRef?{None},
            variadic: loop _ in params -> false,
            conventions: conventions,
            policies: CallablePolicyChain{policies: [CallablePolicy]{}},
        })
    }
    ty: Type.Fn{params: params, ret: returned, effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view}
    ParsedType{ty: ty, span: parser_cover(start, end)}
}

parser_has_type: fn(value: ParsedType?) -> Bool Never! {
    if value == .Val(_) -> return true
    false
}

// The effect row of a function type, `-[E]>`.
parser_parse_effect_arrow_row: fn(state: &JetParserState) -> [EffectRowEntry] {
    parser_expect(state, TOKEN_MINUS, "`-` to start an effect arrow")
    parser_expect(state, TOKEN_LBRACKET, "`[` to start an effect row")
    effects: parser_parse_effect_row_entries(state, TOKEN_RBRACKET)
    parser_expect(state, TOKEN_RBRACKET, "`]` to close the effect row")
    parser_expect(state, TOKEN_GT, "`>` after the effect row")
    effects
}

parser_report_fn_type_zone: fn(state: &JetParserState, span: Span) {
    parser_add_error_code(state, "E0763", span, "this function type's parameter zones are out of order", "the zones read left to right: positional-only, then either, then label-only", "write at most one `/` before at most one `*`, each with parameters on its side")
}

parser_parse_applied_type: fn(state: &JetParserState, name: String, prefix: Span, depth: Int) -> ParsedType {
    parser_bump(state)
    args := [Type]{}
    if !parser_type_close_here(state) {
        loop {
            if {
                (name == "Vec" || name == "Matrix") && parser_current_kind(state) == TOKEN_IDENT -> {
                    measure_token: parser_bump(state)
                    args.push(Type.Measure{measure: Measure.Symbol{kind: "shape", name: parser_value(state, measure_token)}})
                }
                else -> {
                    args.push(parser_parse_type(state, depth + 1).ty)
                }
            }
            if parser_type_close_here(state) -> break
            if parser_current_kind(state) != TOKEN_COMMA {
                token: parser_current(state)
                parser_add_error(state, token.span, "expected `,` between type arguments", "generic type arguments are comma-separated", "add a comma or close the type arguments")
                break
            }
            parser_bump(state)
            if parser_type_close_here(state) -> break
        }
    }
    if !parser_type_close_here(state) {
        token: parser_current(state)
        parser_add_error(state, token.span, "expected `>` after type arguments", "generic type arguments must be closed", "add `>`")
        return ParsedType{ty: Type.Apply{name: name, args: args}, span: parser_cover(prefix, token.span)}
    }
    close: parser_type_gt_span(state)
    ty: parser_apply_named_type(name, args)
    ParsedType{ty: ty, span: parser_cover(prefix, close)}
}

parser_parse_measure: fn(state: &JetParserState, kind: String, depth: Int) -> Measure {
    token: parser_current(state)
    // Rust `parse_declared_measure`: a fixed-list length is a whole,
    // non-negative number; either report is the item's `Err`.
    if kind == "length" && token.kind == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_INT {
        parser_bump(state)
        number: parser_bump(state)
        parser_add_fatal_code(state, "E0963", parser_cover(token.span, number.span), "a fixed-size list length is outside the supported range", "the list length must fit the target's array-size representation", "use a non-negative comptime integer within the supported range")
        return Measure.Literal{kind: kind, value: 0}
    }
    if kind == "length" && token.kind == TOKEN_FLOAT {
        parser_bump(state)
        parser_add_fatal_code(state, "E0963", token.span, "a fixed-size list length must be an integer, got Float (an approximate binary number)", "a fixed-size list needs one known number of elements", "use an integer literal or a compile-time expression that produces Int")
        return Measure.Literal{kind: kind, value: 0}
    }
    if token.kind == {
        TOKEN_INT -> {
            parser_bump(state)
            Measure.Literal{kind: kind, value: parser_integer(state, token) ?? 0}
        }
        TOKEN_IDENT -> {
            parser_bump(state)
            Measure.Symbol{kind: kind, name: parser_value(state, token)}
        }
        TOKEN_LPAREN -> {
            parser_bump(state)
            left: parser_parse_measure(state, kind, depth + 1)
            op: parser_current_kind(state)
            if op == TOKEN_PLUS || op == TOKEN_STAR {
                parser_bump(state)
                right: parser_parse_measure(state, kind, depth + 1)
                close: parser_expect(state, TOKEN_RPAREN, "`)` after the measure expression")
                rule: if op == TOKEN_STAR -> MeasureRule.Mul else -> MeasureRule.Add
                return Measure.Combined{kind: kind, rule: rule, left: left, right: right}
            }
            parser_expect(state, TOKEN_RPAREN, "`)` after the measure")
            left
        }
        else -> {
            parser_add_error(state, token.span, "expected a declared type measure", "type measures accept integer literals, names, and declared arithmetic", "write an integer or a module value parameter")
            if token.kind != TOKEN_EOF -> parser_bump(state)
            Measure.Literal{kind: kind, value: 0}
        }
    }
}

parser_apply_named_type: fn(name: String, args: [Type]) -> Type Never! {
    if {
        name == "Shared" && args.len() == 1 -> Type.Shared{inner: args[0]}
        name == "Option" && args.len() == 1 -> Type.Option{inner: args[0]}
        name == "Result" && args.len() == 2 -> Type.Result{ok: args[0], err: args[1]}
        (name == "Vec" || name == "Matrix") && args.len() > 0 -> Type.Apply{name: name, args: args}
        else -> Type.Apply{name: name, args: args}
    }
}
