// Shared marker projection bodies for declaration parsers. Keep the original
// marker list on each AST node and return its newly computed typed projections.
use jet_foundation.[
    Call,
    EnumDef,
    EveryArg,
    EveryMarker,
    Expr,
    Func,
    JobCachePolicy,
    JobMetadata,
    JobScope,
    JobSkip,
    Marker,
    NamedSpan,
    Span,
    StringMapEntry,
    StructDef,
    StructLayout,
    UnOp,
    ast_job_metadata,
    expr_span,
]

fn parser_marker_is_signed_auto_derive(name: String) -> Bool Never! {
    name == "Printable" || name == "Equatable" || name == "Debug" || name == "Comparable" || name == "Encode" || name == "Decode" || name == "Codable"
}

fn parser_split_type_markers(markers: [Marker]) -> (derives: [NamedSpan], serde_markers: [Marker]) Never! {
    serde := [Marker]{}
    derives := [NamedSpan]{}
    loop marker in markers {
        if marker.negated && parser_marker_is_signed_auto_derive(marker.name) -> next
        if marker.name == {
            "Codable" -> {
                &derives.push(NamedSpan{name: "Encode", span: marker.name_span})
                &derives.push(NamedSpan{name: "Decode", span: marker.name_span})
            }
            "Encode" | "Decode" -> &derives.push(NamedSpan{name: marker.name, span: marker.name_span})
            "RenameAll" | "DenyUnknownFields" | "Tag" | "Untagged" | "Rename" | "Skip" | "Default" | "Flatten" -> &serde.push(marker)
            "Layout" | "Deprecated" | "Error" -> {}
            else -> &derives.push(NamedSpan{name: marker.name, span: marker.name_span})
        }
    }
    (derives: ^derives, serde_markers: ^serde)
}

fn parser_apply_struct_type_markers(value: &StructDef, markers: [Marker]) Never! {
    value.type_markers = markers.copy()
    (derives, serde_markers) := parser_split_type_markers(markers)
    value.serde_markers = serde_markers
    value.derives = derives
    value.auto_derive_default = true
    parser_apply_type_markers(&value, markers)
}

fn parser_apply_enum_type_markers(value: &EnumDef, markers: [Marker]) Never! {
    value.type_markers = markers.copy()
    (derives, serde_markers) := parser_split_type_markers(markers)
    value.serde_markers = serde_markers
    value.derives = derives
    value.auto_derive_default = true
    loop marker in markers {
        if marker.name == "SingleUse" {
            value.is_single_use = true
            value.single_use_span = Val(marker.span)
        }
        if marker.name == "MustUse" {
            value.is_must_use = true
            value.must_use_span = Val(marker.span)
        }
    }
}

fn parser_marker_shape_error(state: &JetParserState, marker: Marker) {
    parser_add_error_code(&state, "E0930", marker.span, "`#{marker.name}` arguments do not match its registered signature", "marker arguments use the same call grammar and typed signature as function arguments", "match the registered marker signature")
}

// The layout fact of a
// struct's `#Layout(…)` marker, or the refusal of an enum's. `grouped` is the
// `#[…]` list spelling (Rust `marker_groups.rs`), whose refusals are ordinary
// errors; the bare `#Layout(…)` spelling (Rust `layout_type_def`) refuses
// fatally, ending the declaration. `c` and `columnar` are supported,
// `align(N)` / `align(target, N)` is the second argument of `#Layout(c)`, a
// bare second identifier is an enum's C tag width, and `packed` and the
// first-argument `align` stay reserved. Sema owns positivity, power-of-two,
// and target facts. None when there is no layout fact.
fn parser_layout_marker_fact(state: &JetParserState, markers: [Marker], grouped: Bool, is_enum: Bool) -> StructLayout? {
    marker :: loop candidate in markers {
        if candidate.name == "Layout" -> break candidate
    } ?? return None
    if grouped -> return parser_layout_grouped_fact(&state, marker, is_enum)
    values :: parser_bind_marker_arguments(&state, marker, [String]{"kind", "tag"}, 1) ?? {
        state.abort_mark = state.diagnostics.len()
        return None
    }
    kind_expr :: values[0] ?? return None
    if kind_expr == .Ident(variant, variant_span) {
        tag_width := false
        alignment := Int?{None}
        alignment_span := Span?{None}
        alignment_target := false
        has_alignment := false
        if values[1] == .Val(value) {
            if value == .Ident(_, _) {
                tag_width = true
            } else if parser_layout_align_call(value) == .Val(call) {
                has_alignment = true
                alignment_target = call.args.len() == 2
                argument :: call.args[if alignment_target -> 1 else -> 0].expr
                if argument == .Int(number, number_span, _, _) && number >= 0 {
                    alignment = Val(number)
                    alignment_span = Val(number_span)
                } else if argument == .Unary(op, operand, _) && op == UnOp.Neg && operand == .Int(_, _, _, _) {
                    alignment_span = Val(expr_span(argument))
                } else {
                    parser_add_fatal_code(&state, "E1105", expr_span(argument), "`align` requires one integer byte value (or `target, N`)", "`#Layout(c, align(N))` is compiler-owned ABI metadata", "write `align(64)` or `align(target, 2097152)`")
                    return None
                }
            } else {
                parser_marker_shape_error(&state, marker)
                state.abort_mark = state.diagnostics.len()
                return None
            }
        }
        layout := StructLayout?{None}
        if variant == {
            "c" -> layout = Val(if alignment == .Val(bytes) -> StructLayout.CAligned{alignment: bytes, target: alignment_target} else -> StructLayout.C)
            "columnar" -> {
                if has_alignment {
                    parser_add_fatal_code(&state, "E1105", alignment_span ?? marker.span, "`align` is only valid with `#Layout(c)`", "columnar layout has no C ABI alignment override", "use `#Layout(c, align(64))` or remove `align(…)`")
                    return None
                }
                layout = Val(StructLayout.Columnar)
            }
            "packed" | "align" -> {
                parser_add_fatal_code(&state, "E1105", variant_span, "`#Layout({variant})` is reserved and not yet supported", "the supported variants are `c`, `columnar`, and `c, align(N)` or `c, align(target, N)`", "use `#Layout(c)`, `#Layout(c, align(64))`, `#Layout(c, align(target, 2097152))`, or `#Layout(columnar)`")
                return None
            }
            else -> {
                parser_add_fatal_code(&state, "E1105", variant_span, "`#Layout({variant})` isn't a known layout variant", "the supported variants are `c`, `columnar`, and `c, align(N)` or `c, align(target, N)`", "write `#Layout(c)`, `#Layout(c, align(64))`, `#Layout(c, align(target, 2097152))`, or `#Layout(columnar)`")
                return None
            }
        }
        if is_enum {
            if has_alignment || layout != Val(StructLayout.C) {
                parser_add_fatal_code(&state, "E1105", variant_span, "Only plain C layout applies to enums.", "alignment is a struct ABI override; enum tags use the second bare layout argument.", "use `#Layout(c, I32)` or another enum tag width")
            }
            return None
        }
        if tag_width {
            parser_add_fatal_code(&state, "E1105", marker.span, "A tag width applies only to enums.", "Structs have fields and padding but no discriminant tag.", "Remove `tag: …`, or put this layout on an enum.")
            return None
        }
        return layout
    }
    parser_marker_shape_error(&state, marker)
    state.abort_mark = state.diagnostics.len()
    None
}

// Rust `marker_groups.rs`: `#Layout(…)` inside a `#[…]` list. Its arguments
// are read positionally and its refusals do not end the declaration.
fn parser_layout_grouped_fact(state: &JetParserState, marker: Marker, is_enum: Bool) -> StructLayout? {
    second :: parser_marker_expression(marker, 1)
    if is_enum {
        if second == .Val(value) && parser_layout_align_call(value) != None {
            parser_add_error_code(&state, "E1105", marker.span, "alignment overrides apply only to structs", "enum C layout uses its tag-width argument instead", "write `#Layout(c, I32)` on an enum")
        }
        return None
    }
    first :: parser_marker_expression(marker, 0) ?? return None
    if first == .Ident(variant, _) {
        has_alignment := false
        alignment_target := false
        alignment := Int?{None}
        if second == .Val(value) {
            if parser_layout_align_call(value) == .Val(call) {
                has_alignment = true
                alignment_target = call.args.len() == 2
                argument :: call.args[if alignment_target -> 1 else -> 0].expr
                if argument == .Int(number, _, _, _) && number >= 0 {
                    alignment = Val(number)
                } else if argument == .Unary(op, operand, _) && op == UnOp.Neg && operand == .Int(_, _, _, _) {
                } else {
                    parser_add_error_code(&state, "E1105", expr_span(argument), "`align` requires one integer byte value (or `align(target, N)`)", "`#Layout(c, align(N))` is compiler-owned ABI metadata", "write `align(64)` or `align(target, 2097152)`")
                }
            } else {
                parser_add_error_code(&state, "E1105", expr_span(value), "the second `#Layout` argument must be `align(N)` or `align(target, N)`", "struct alignment is a positive power-of-two integer", "write `#Layout(c, align(64))` or `#Layout(c, align(target, 2097152))`")
            }
        }
        if variant == {
            "c" -> return Val(if alignment == .Val(bytes) -> StructLayout.CAligned{alignment: bytes, target: alignment_target} else -> StructLayout.C)
            "columnar" -> {
                if has_alignment -> parser_add_error_code(&state, "E1105", marker.span, "`align` is only valid with `#Layout(c)`", "columnar layout has no C ABI alignment override", "write `#Layout(c, align(64))`")
                return Val(StructLayout.Columnar)
            }
            else -> return None
        }
    }
    None
}

// `align(N)` or `align(target, N)`.
fn parser_layout_align_call(value: Expr) -> Call? {
    if value == .Call(call) && call.name == "align" {
        if call.args.len() == 1 -> return Val(call)
        if call.args.len() == 2 {
            // copy: `call` is a payload of read parameter `value`, which keeps the original; the Val carrier owns this one
            if call.args[0].expr == .Ident(name, _) && name == "target" -> return Val(call.copy())
        }
    }
    None
}

// The struct's `layout_span`: the marker, whenever a layout fact is set, and
// for the grouped spelling whenever its first argument is an identifier.
fn parser_layout_marker_span(markers: [Marker], grouped: Bool, layout: StructLayout?) -> Span? {
    marker :: loop candidate in markers {
        if candidate.name == "Layout" -> break candidate
    } ?? return None
    if layout != None -> return Val(marker.span)
    if grouped && parser_marker_expression(marker, 0) == .Val(first) && first == .Ident(_, _) -> return Val(marker.span)
    None
}

// Rust `marker_argument_bindings`: the argument bound to each named
// parameter, positional ones first and labeled ones by name. None when the
// arguments do not fit the parameter list; no diagnostic is reported here.
fn parser_marker_bindings(marker: Marker, names: [String]) -> [Expr?]? {
    values := [Expr?]{}
    loop _ in 0..<names.len() -> &values.push(None)
    positional := 0
    saw_named := false
    index := 0
    loop index < marker.args.len() {
        label := parser_marker_label(marker, index)
        parameter := -1
        if {
            label != "" -> {
                saw_named = true
                parameter_index := 0
                loop parameter_index < names.len() {
                    if names[parameter_index] == label {
                        parameter = parameter_index
                        break
                    }
                    parameter_index += 1
                }
                if parameter < 0 -> return None
            }
            else -> {
                if saw_named -> return None
                loop positional < values.len() && values[positional] != None -> positional += 1
                if positional >= values.len() -> return None
                parameter = positional
                positional += 1
            }
        }
        if values[parameter] != None -> return None
        argument :: parser_marker_expression(marker, index) ?? return None
        values[parameter] = Val(argument)
        index += 1
    }
    Val(values)
}

fn parser_bind_marker_arguments(state: &JetParserState, marker: Marker, names: [String], required: Int) -> [Expr?]? {
    values :: parser_marker_bindings(marker, names) ?? {
        parser_marker_shape_error(&state, marker)
        return None
    }
    index := 0
    loop index < required {
        if values[index] == None {
            parser_marker_shape_error(&state, marker)
            return None
        }
        index += 1
    }
    Val(values)
}

// Rust `marker_enum_variant`: the variant a marker argument names, written
// `Name`, `Type.Name`, or `.Name`; empty for any other expression.
fn parser_marker_enum_variant(value: Expr) -> String {
    if value == {
        .Ident(name, _) -> name
        .Field(_, member, _) -> member
        .EnumLit(_, variant, _, _, _, _) -> variant
        else -> ""
    }
}

// Rust `marker_ident_path`: `A.B.C` as written; None for any other shape.
fn parser_marker_ident_path(value: Expr) -> String? {
    if value == {
        .Ident(name, _) -> Val(name)
        .Field(base, member, _) -> {
            prefix :: parser_marker_ident_path(base) ?? return None
            Val("{prefix}.{member}")
        }
        else -> None
    }
}

fn parser_job_metadata_error(state: &JetParserState, field: String, expected: String, span: Span) {
    parser_add_error_code(&state, "E1330", span, "task metadata {field} has the wrong shape", "D-TASK-META1: {field} is {expected}", "write {field}: as {expected}")
}

fn parser_job_word(value: Expr) -> String? {
    if value == {
        .Ident(name, _) -> {
            return Val(name)
        }
        .EnumLit(_, variant, _, args, _, _) -> {
            if args.len() == 0 {
                return Val(variant)
            }
        }
        .Str(parts, _) -> {
            if parts.len() == 1 {
                if parts[0] == {
                    .Lit(text) -> {
                        return Val(text)
                    }
                    else -> {
                        return None
                    }
                }
            }
        }
        else -> {
            return None
        }
    }
    None
}

fn parser_job_static_word(value: Expr) -> String? {
    word := parser_job_word(value)
    if word != None -> return word
    if value == {
        .Int(number, _, _, _) -> return Val("{number}")
        .Bool(boolean, _) -> return Val("{boolean}")
        else -> return None
    }
}

fn parser_job_string_list(state: &JetParserState, marker: Marker, field: String, value: Expr?) -> [String]? {
    expression :: value ?? return Val([String]{})
    if expression == {
        .ListLit(values, _) -> {
            result := [String]{}
            loop item in values {
                word :: parser_job_word(item) ?? {
                    parser_job_metadata_error(&state, field, "a list of strings or names", expr_span(item))
                    return None
                }
                &result.push(word)
            }
            return Val(result)
        }
        else -> {
            word :: parser_job_word(expression) ?? {
                parser_job_metadata_error(&state, field, "a list of strings or names", marker.span)
                return None
            }
            return Val([String]{word})
        }
    }
}

fn parser_job_skip(state: &JetParserState, marker: Marker, expression: Expr) -> JobSkip? {
    word := parser_job_word(expression)
    if word != None {
        reason :: word ?? ""
        if reason == "none" || reason == "None" -> return None
        return Val(JobSkip.Always{reason: reason})
    }
    if expression == {
        .EnumLit(_, variant, _, args, _, _) -> {
            if variant != "Unless" || args.len() != 1 {
                parser_job_metadata_error(&state, "skip", "a reason string or .Unless(.Platform(.Linux))", marker.span)
                return None
            }
            platform_expr := Expr?{None}
            if args[0] == {
                .Positional(value) -> { platform_expr = Val(value) }
                else -> {}
            }
            value :: platform_expr ?? {
                parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                return None
            }
            if value == {
                .EnumLit(_, platform_constructor, _, platform_args, _, _) -> {
                    if platform_constructor != "Platform" || platform_args.len() != 1 {
                        parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                        return None
                    }
                    platform_value := Expr?{None}
                    if platform_args[0] == {
                        .Positional(platform) -> { platform_value = Val(platform) }
                        else -> {}
                    }
                    platform :: platform_value ?? {
                        parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                        return None
                    }
                    platform_name :: parser_job_word(platform) ?? {
                        parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                        return None
                    }
                    if platform_name != "Linux" && platform_name != "MacOS" && platform_name != "Windows" && platform_name != "FreeBSD" {
                        parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                        return None
                    }
                    return Val(JobSkip.UnlessPlatform{platform: platform_name})
                }
                else -> {
                    parser_job_metadata_error(&state, "skip", ".Unless(.Platform(.Linux))", marker.span)
                    return None
                }
            }
        }
        else -> {
            parser_job_metadata_error(&state, "skip", "a reason string or .Unless(.Platform(.Linux))", marker.span)
            return None
        }
    }
}

fn parser_job_limits(state: &JetParserState, marker: Marker, expression: Expr) -> [StringMapEntry]? {
    if expression == {
        .MapLit(entries, _) -> {
            limits := [StringMapEntry]{}
            loop entry in entries {
                key :: parser_job_word(entry.key) ?? {
                    parser_job_metadata_error(&state, "limits", "a map of names to static values", expr_span(entry.key))
                    return None
                }
                value :: parser_job_static_word(entry.value) ?? {
                    parser_job_metadata_error(&state, "limits", "a map of names to static values", expr_span(entry.value))
                    return None
                }
                loop existing in limits {
                    if existing.key == key {
                        parser_job_metadata_error(&state, "limits", "a map with unique keys", marker.span)
                        return None
                    }
                }
                &limits.push(StringMapEntry{key: key, value: value})
            }
            index := 1
            loop index < limits.len() {
                current := limits[index]
                insertion := index - 1
                loop insertion >= 0 && limits[insertion].key > current.key {
                    limits[insertion + 1] = limits[insertion]
                    insertion -= 1
                }
                limits[insertion + 1] = current
                index += 1
            }
            return Val(limits)
        }
        else -> {
            parser_job_metadata_error(&state, "limits", "a map of names to static values", marker.span)
            return None
        }
    }
}

fn parser_job_parallel(state: &JetParserState, marker: Marker, expression: Expr) -> Int? {
    word := parser_job_word(expression)
    if word != None {
        reason :: word ?? ""
        if reason == "none" || reason == "None" -> return None
    }
    if expression == {
        .Int(value, _, _, _) -> {
            if value > 0 -> return Val(value)
        }
        else -> {}
    }
    parser_job_metadata_error(&state, "parallel", "a positive integer or none", expr_span(expression))
    None
}

fn parser_job_metadata_from_marker(state: &JetParserState, marker: Marker) -> JobMetadata? {
    if marker.args.len() == 0 -> return None
    values :: parser_bind_marker_arguments(&state, marker, [String]{"scope", "packages", "cwd", "inputs", "outputs", "skip", "cache", "limits", "after", "parallel"}, 0) ?? return None
    metadata := ast_job_metadata()

    if values[0] == .Val(scope_expr) {
        scope :: parser_job_word(scope_expr) ?? {
            parser_job_metadata_error(&state, "scope", ".Dev, .Ship, or .Internal", expr_span(scope_expr))
            return None
        }
        if {
            scope == "Dev" -> metadata.scope = JobScope.Dev
            scope == "Ship" -> metadata.scope = JobScope.Ship
            scope == "Internal" -> metadata.scope = JobScope.Internal
            else -> {
                parser_job_metadata_error(&state, "scope", ".Dev, .Ship, or .Internal", expr_span(scope_expr))
                return None
            }
        }
    }
    metadata.packages = parser_job_string_list(&state, marker, "packages", values[1]) ?? return None
    if values[2] == .Val(cwd_expr) {
        cwd :: parser_job_word(cwd_expr) ?? {
            parser_job_metadata_error(&state, "cwd", "a string or name", marker.span)
            return None
        }
        if cwd != "none" && cwd != "None" -> metadata.cwd = Val(cwd)
    }
    metadata.inputs = parser_job_string_list(&state, marker, "inputs", values[3]) ?? return None
    metadata.outputs = parser_job_string_list(&state, marker, "outputs", values[4]) ?? return None
    if values[5] == .Val(skip_expr) {
        diagnostics_before := state.diagnostics.len()
        metadata.skip = parser_job_skip(&state, marker, skip_expr)
        if state.diagnostics.len() != diagnostics_before -> return None
    }
    if values[6] == .Val(cache_expr) {
        cache :: parser_job_word(cache_expr) ?? {
            parser_job_metadata_error(&state, "cache", ".Uncached, .Local, or .Shared", expr_span(cache_expr))
            return None
        }
        if {
            cache == "Local" -> metadata.cache = JobCachePolicy.Local
            cache == "Shared" -> metadata.cache = JobCachePolicy.Shared
            cache == "Uncached" || cache == "Off" -> metadata.cache = JobCachePolicy.Uncached
            else -> {
                parser_job_metadata_error(&state, "cache", ".Uncached, .Local, or .Shared", expr_span(cache_expr))
                return None
            }
        }
    }
    if values[7] == .Val(limits_expr) {
        metadata.limits = parser_job_limits(&state, marker, limits_expr) ?? return None
    }
    metadata.after = parser_job_string_list(&state, marker, "after", values[8]) ?? return None
    if values[9] == .Val(parallel_expr) {
        diagnostics_before := state.diagnostics.len()
        metadata.parallel = parser_job_parallel(&state, marker, parallel_expr)
        if state.diagnostics.len() != diagnostics_before -> return None
    }
    Val(metadata)
}

fn parser_every_marker_from_marker(state: &JetParserState, marker: Marker) -> EveryMarker? {
    values :: parser_bind_marker_arguments(&state, marker, [String]{"schedule"}, 1) ?? return None
    schedule :: values[0] ?? return None
    arg := if schedule == {
        .UnitLit(_, int, float, suffix, suffix_span, _) -> EveryArg.Duration{int: int, float: float, suffix: suffix, suffix_span: suffix_span}
        .Str(parts, span) -> if {
            parts.len() == 1 -> {
                if parts[0] == {
                    .Lit(text) -> EveryArg.WallClock{text: text, text_span: span}
                    .Interp(_, _) -> EveryArg.Expression{value: schedule}
                    else -> EveryArg.Expression{value: schedule}
                }
            }
            else -> EveryArg.Expression{value: schedule}
        }
        else -> EveryArg.Expression{value: schedule}
    }
    Val(EveryMarker{arg: arg, span: marker.span, resolved: None})
}

fn parser_project_function_job_markers(state: &JetParserState, function: &Func, markers: [Marker]) -> Bool {
    valid := true
    loop marker in markers {
        if marker.name == "Job" {
            function.is_job = true
            function.job_span = Val(marker.span)
            diagnostics_before := state.diagnostics.len()
            function.job_metadata = parser_job_metadata_from_marker(&state, marker)
            if state.diagnostics.len() != diagnostics_before -> valid = false
        }
        if marker.name == "Every" {
            diagnostics_before := state.diagnostics.len()
            function.every = parser_every_marker_from_marker(&state, marker)
            if state.diagnostics.len() != diagnostics_before -> valid = false
        }
    }
    if function.every != None && !function.is_job {
        every :: function.every ?? panic("projected Every marker disappeared")
        parser_add_error_code(&state, "E0925", every.span, "`#Every(…)` needs `#Job` on the same function", "a schedule only means something on a job — `#Every(…)` names when `#Job` runs, it isn't a standalone timer", "add `#Job` (`#Job #Every(5min) fn …`), or drop `#Every(…)` if this isn't a scheduled job")
        valid = false
    }
    valid
}
