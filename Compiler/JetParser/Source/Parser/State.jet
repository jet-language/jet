// Parser state and token access. The lexer supplies canonical token IDs,
// byte spans, interned spellings, literal facts, nested string token streams,
// and diagnostics.
use {
    jet_foundation.[
        AppliedRuleApplication,
        Diagnostic,
        DiagnosticFixApplicability,
        DiagnosticFixSafety,
        ElseArmLayout,
        ElseArmSpan,
        Expr,
        Marker,
        PolicyDeclaration,
        Span,
        Stmt,
        TextEdit,
        diagnostic_from_registry,
        diagnostic_with_edit,
        diagnostic_with_edit_grade,
        diagnostic_with_label,
        name_find,
        name_index,
        name_intern,
        name_start,
        name_text,
    ]
    jet_lexer.[
        StringPart,
        TOKEN_BLOCK_COMMENT,
        TOKEN_BREAK,
        TOKEN_CHAR,
        TOKEN_EOF,
        TOKEN_FLOAT,
        TOKEN_GT,
        TOKEN_INT,
        TOKEN_KW_CONST,
        TOKEN_KW_ENUM,
        TOKEN_KW_FN,
        TOKEN_KW_IMPL,
        TOKEN_KW_IN,
        TOKEN_KW_MODULE,
        TOKEN_KW_STRUCT,
        TOKEN_IDENT,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LINE_COMMENT,
        TOKEN_LPAREN,
        TOKEN_NULL,
        TOKEN_PREP,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RETURN,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SHR,
        TOKEN_STRING,
        TOKEN_UNIFIED_ARROW,
        TOKEN_UNIT_NUMBER,
        Token,
        TokenTables,
        text_reading_diagnostics,
        token_decimal,
        token_decoded,
        token_integer,
        token_interpolations,
        token_string_part_count,
        token_string_parts,
        token_suffix,
        token_synthetic,
        token_text,
    ]
}

JetParserState: struct {
    tokens: [Token],
    position: Int,
    diagnostics: [Diagnostic],
    source_end: Int,
    block_spans: [Span],
    pending_type_gt: Bool,
    pending_type_gt_span: Span,
    // Byte offset where the statement being parsed starts; a retired `++`/`--`
    // that spans the whole statement gets a Safe compound-assignment edit.
    statement_start: Int,
    // Byte offsets where each source line starts, when the source text is
    // known; E0083 names the opener's line from it.
    line_starts: [Int]{[Int]{}},
    // E0641: the `else` arm of every dispatch table parsed so far.
    else_arms: [ElseArmSpan]{[ElseArmSpan]{}},
    // Block `#Policy(...) { … }` declarations, joined to the
    // program's policy declarations after the parse.
    block_policy_declarations: [PolicyDeclaration]{[PolicyDeclaration]{}},
    statement_rules: [AppliedRuleApplication]{[AppliedRuleApplication]{}},
    // An authored `;` reports E0373 once per file.
    explicit_semicolon_reported: Bool{false},
    has_scope_member: Bool{false},
    has_task_spawn: Bool{false},
    // The source text, when known; L0507 and E0373 build their edits from it.
    // One row, so an interpolation hole can borrow it (parser_lend_hole) the
    // way it borrows `tables`; empty only while lent. For a chunked parse,
    // `sources[0]` holds only the chunk's byte slice starting at `source_offset`,
    // and `line_starts` holds the chunk's line starts after `line_base` earlier
    // lines.
    sources: [[U8]]{[[U8]]{[U8]{}}},
    source_offset: Int{0},
    line_base: Int{0},
    // A statement or item stops at its first fatal error and parsing resumes
    // at the next boundary, so one mistake reports once. `abort_mark` is the
    // diagnostics length just after that error (0 = none; a rewind below it
    // cancels the abort); `abort_position` is the cursor where it was found.
    abort_mark: Int{0},
    abort_position: Int{0},
    // An interpolation hole's own parser: its end is the hole's closing `}`.
    in_hole: Bool{false},
    // Depth of one-statement `->` bodies; their statement may end before `else`.
    adjacent_if_body_depth: Int{0},
    // Depth of one-statement arm-table bodies; their statement may end before
    // a `#Through` (parser_parse_arm_through).
    arm_body_depth: Int{0},
    // The block depth of a braceless arm body in an arm table (-1 = none);
    // its statement may end before the `,` that separates compact arms.
    table_arm_block_depth: Int{-1},
    // The headers of the hole tables (`if n % <> == 0 { … }`) whose arms are
    // being read, innermost last, each grouped over its written span; an arm
    // atom fills the innermost one.
    dispatch_hole_headers: [Expr]{[Expr]{}},
    // Where the last value hole table read starts (-1 = none). A callable
    // body's final `if` whose value reading is one keeps that reading, so a
    // missing `else` is reported as such (parser_parse_tail_if).
    hole_value_table: Int{-1},
    // Braced statement lists entered so far. Value blocks read their lines at
    // the enclosing depth.
    block_depth: Int{0},
    // The block depth of the innermost callable body (-1 = none). Its last line
    // may be a bare value.
    callable_tail_depth: Int{-1},
    // That body's callable has a declared result, so an audited region at its
    // tail keeps the value grammar.
    callable_tail_value: Bool{false},
    // Derive, marker and declaration-loop template bodies entered so far. A
    // `#loop` inside one is a template loop the derive expansion unrolls.
    derive_template_depth: Int{0},
    // Code and generic module bodies entered so far; 0 is a file's top
    // level, where `priv` already keeps a declaration inside the package.
    module_depth: Int{0},
    // A Jetpack config surface reads `$NAME` as the typed environment read
    // ordinary source rejects the same token with E0003.
    allow_environment_reads: Bool{false},
    // The lexed source's names and literal facts, as one row. A nested state
    // (an interpolation, a pattern hole) borrows the row while it parses and
    // hands it back (`parser_lend_tables` / `parser_return_tables`).
    tables: [TokenTables]{[TokenTables]{}},
    // AST NodeIds (`parser_node_id`): the current top-level unit's first
    // byte, shifted past the unit-local count, plus the next unit-local
    // number. A nested state numbers on from its parent's count.
    node_base: Int{0},
    next_node: Int{0},
    // The block depth of the function body whose own lines may be
    // `#X: value` markers (-1 = none), and the markers read there so far.
    inbody_marker_depth: Int{-1},
    inbody_markers: [Marker]{[Marker]{}},
    // The markers this file declares, with where each bare name resolves to
    // it (parser_marker_scopes); a written marker there reaches no hook.
    marker_scopes: [ParserMarkerScope]{[ParserMarkerScope]{}},
    // The size names (`U8`) this file binds for itself, bit `row` for
    // FOUNDATION_SIZE_ALIASES[row] (parser_bound_size_rows): there a written
    // one stays a name.
    bound_size_rows: Int{0},
    // Pipes (`head |> step`): each token's bracket depth (built on first use),
    // the depths whose expression already owns its `|>` steps, and the open
    // steps, innermost last, with how many times each has read its `<>`.
    token_depths: [Int]{[Int]{}},
    pipe_owner_depths: [Int]{[Int]{}},
    pipe_step_names: [String]{[String]{}},
    pipe_step_reads: [Int]{[Int]{}},
    // Where the body of the typed literal being read starts
    // (parser_mark_head_body); quoted text there is the head's body.
    head_text_at: Int{-1},
    // A loop header's step is being read: an update operator such as `~=`
    // after its target is the step's own, not a mistyped comparison.
    reading_loop_step: Bool{false},
    // Pre-resolved Name IDs (-1 when absent from `tables[0].names`) for hot
    // keyword/habit checks without allocating temporary Strings.
    words: ParserWordIds{ParserWordIds{}},
}

ParserWordIds: struct {
    id_pass: Int{-1},
    id_not: Int{-1},
    id_f: Int{-1},
    id_and: Int{-1},
    id_or: Int{-1},
    id_is: Int{-1},
    id_while: Int{-1},
    id_for: Int{-1},
    id_elif: Int{-1},
    id_import: Int{-1},
    id_def: Int{-1},
    id_function: Int{-1},
    id_task: Int{-1},
    id_val: Int{-1},
    id_new: Int{-1},
    id_run: Int{-1},
    id_next: Int{-1},
    id_after: Int{-1},
    id_group: Int{-1},
}

parser_word_id_of: fn(tables: TokenTables, text: String) -> Int Never! {
    if name_find(tables.names, text) == .Val(id) -> name_index(id) else -> -1
}

parser_word_ids_for: fn(tables: TokenTables) -> ParserWordIds Never! {
    ParserWordIds{
        id_pass: parser_word_id_of(tables, "pass"),
        id_not: parser_word_id_of(tables, "not"),
        id_f: parser_word_id_of(tables, "f"),
        id_and: parser_word_id_of(tables, "and"),
        id_or: parser_word_id_of(tables, "or"),
        id_is: parser_word_id_of(tables, "is"),
        id_while: parser_word_id_of(tables, "while"),
        id_for: parser_word_id_of(tables, "for"),
        id_elif: parser_word_id_of(tables, "elif"),
        id_import: parser_word_id_of(tables, "import"),
        id_def: parser_word_id_of(tables, "def"),
        id_function: parser_word_id_of(tables, "function"),
        id_task: parser_word_id_of(tables, "task"),
        id_val: parser_word_id_of(tables, "Val"),
        id_new: parser_word_id_of(tables, "new"),
        id_run: parser_word_id_of(tables, "#run"),
        id_next: parser_word_id_of(tables, "next"),
        id_after: parser_word_id_of(tables, "after"),
        id_group: parser_word_id_of(tables, "group"),
    }
}

// First UTF-8 byte of `token.decoded`, or -1 when empty, without allocating.
parser_decoded_first_byte: fn(state: JetParserState, token: Token) -> Int Never! {
    id: name_index(token.decoded)
    if id <= 0 || state.tables.len() == 0 -> return -1
    names: state.tables[0].names
    start: name_start(names, id)
    if start >= names.ends[id] -> return -1
    Int{names.bytes[start]}
}

// Length in bytes of `token.decoded`, without allocating.
parser_decoded_byte_len: fn(state: JetParserState, token: Token) -> Int Never! {
    id: name_index(token.decoded)
    if id <= 0 || state.tables.len() == 0 -> return 0
    names: state.tables[0].names
    names.ends[id] - name_start(names, id)
}

// One authored piece of a classic branch chain: an arm's condition and body,
// or the final `else` body. The L0507 fix rebuilds the chain from these.
ParserBranchPart: struct {
    is_else: Bool,
    cond: Span,
    body: Span,
}

ParsedBlock: struct {
    span: Span,
    statements: [Stmt],
    tail: Expr?,
}

parser_synthetic_token: fn(kind: Int, span: Span) -> Token Never! { token_synthetic(kind, span) }

// A synthetic token spelled `text`, interned in the state's names.
parser_spelled_token: fn(state: ^JetParserState, kind: Int, span: Span, text: String) -> Token Never! {
    name: name_intern(state.tables[0].names, text)
    token := token_synthetic(kind, span)
    token.text = name
    token.decoded = name
    token
}

// A token's decoded spelling: an identifier's name, a literal's value.
parser_value: fn(state: JetParserState, token: Token) -> String Never! {
    token_decoded(state.tables[0], token)
}

// A token's exact source spelling.
parser_text: fn(state: JetParserState, token: Token) -> String Never! {
    token_text(state.tables[0], token)
}

// The decoded spelling of the token `offset` tokens ahead (0 = current).
parser_value_at: fn(state: ^JetParserState, offset: Int) -> String Never! {
    token: parser_lookahead(state, offset)
    parser_value(state, token)
}

parser_integer: fn(state: JetParserState, token: Token) -> Int? Never! {
    token_integer(state.tables[0], token)
}

parser_decimal: fn(state: JetParserState, token: Token) -> Float? Never! {
    token_decimal(state.tables[0], token)
}

parser_suffix: fn(state: JetParserState, token: Token) -> String Never! {
    token_suffix(state.tables[0], token)
}

parser_interpolations: fn(state: JetParserState, token: Token) -> Int Never! {
    token_interpolations(state.tables[0], token)
}

parser_string_part_count: fn(state: JetParserState, token: Token) -> Int Never! {
    token_string_part_count(state.tables[0], token)
}

parser_string_parts: fn(state: JetParserState, token: Token) -> [StringPart] Never! {
    token_string_parts(state.tables[0], token)
}

parser_part_text: fn(state: JetParserState, part: StringPart) -> String Never! {
    name_text(state.tables[0].names, part.text)
}

// The reading of quoted text `token` takes. The lexer can't tell a typed
// head's body (`Regex{"\d+"}`) from a block's first line (`-> String { "a\n" }`),
// so text after `Name{`, `.{` or `[U8]{` comes with both readings. `head` picks
// the typed head's, which keeps backslashes as written or reads `\xNN` as a
// byte; only a typed literal's, default's or pattern's body asks for it.
parser_text_reading: fn(state: JetParserState, token: Token, head: Bool) -> Token Never! {
    if !head || token.literal < 0 -> return token.copy()
    row: state.tables[0].literals[token.literal].head
    if row < 0 -> return token.copy()
    reading := token.copy()
    reading.literal = row
    reading.decoded = state.tables[0].literals[token.literal].head_decoded
    reading
}

// Consumes the current quoted text in the reading `head` picks
// (parser_text_reading) and reports the diagnostics the lexer kept for it.
parser_take_text: fn(state: ^JetParserState, head: Bool) -> Token Never! {
    bumped: parser_bump(state)
    token: parser_text_reading(state, bumped, head)
    if token.literal < 0 -> return token
    row: token.literal
    loop diagnostic in text_reading_diagnostics(state.tables[0].literals[row].deferred, state.tables[0].literals[row].escapes) {
        state.diagnostics.push(diagnostic.move())
    }
    token
}

// Marks the current token as the start of a typed literal's body and returns
// the mark to restore once the body is read.
parser_mark_head_body: fn(state: ^JetParserState) -> Int Never! {
    saved: state.head_text_at
    state.head_text_at = state.position
    saved
}

parser_token_text_is_id: fn(token: Token, id: Int) -> Bool Never! {
    id >= 0 && name_index(token.text) == id
}

parser_token_decoded_is_id: fn(token: Token, id: Int) -> Bool Never! {
    id >= 0 && name_index(token.decoded) == id
}

// A nested state parses with its parent's tables and numbers its nodes on
// from the parent's count; it must hand both back with
// `parser_return_tables` before the parent reads a token again.
parser_lend_tables: fn(state: ^JetParserState, nested: ^JetParserState) Never! {
    nested.node_base = state.node_base
    nested.next_node = state.next_node
    nested.words = state.words
    tables: state.tables.pop() ?? return
    nested.tables.push(tables)
}

parser_return_tables: fn(state: ^JetParserState, nested: ^JetParserState) Never! {
    state.next_node = nested.next_node
    tables: nested.tables.pop() ?? return
    state.tables.push(tables)
}

// The next AST NodeId of the current top-level unit.
parser_node_id: fn(state: ^JetParserState) -> Int Never! {
    id: state.node_base + state.next_node
    state.next_node += 1
    id
}

// A top-level unit (item or script statement) starting at byte `start`
// numbers its nodes from `start << PARSER_NODE_UNIT_BITS`: the ids depend on
// the unit's place in the file, not on which chunk parsed it. Units start at
// least one byte apart, so ids stay unique while a unit has fewer than
// 2&&PARSER_NODE_UNIT_BITS nodes per source byte.
PARSER_NODE_UNIT_BITS: 24

parser_begin_node_unit: fn(state: ^JetParserState, start: Int) Never! {
    state.node_base = start << PARSER_NODE_UNIT_BITS
    state.next_node = 0
}

// An interpolation hole parses with its parent's tables and source text: the
// source row moves to the nested state and back instead of the whole source
// being copied once per hole. Every exit returns both before the parent
// reads again.
parser_lend_hole: fn(state: ^JetParserState, nested: ^JetParserState) Never! {
    parser_lend_tables(state, nested)
    nested.source_offset = state.source_offset
    nested.line_base = state.line_base
    source: state.sources.pop() ?? return
    nested.sources.push(source)
}

parser_return_hole: fn(state: ^JetParserState, nested: ^JetParserState) Never! {
    parser_return_tables(state, nested)
    source: nested.sources.pop() ?? return
    state.sources.push(source)
}

parser_is_trivia: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

parser_skip_trivia: fn(state: ^JetParserState) Never! {
    loop state.position >= 0 && state.position < state.tokens.len() && parser_is_trivia(state.tokens[state.position].kind) {
        state.position += 1
    }
}

parser_current: fn(state: ^JetParserState) -> Token Never! {
    if state.pending_type_gt {
        return parser_synthetic_token(TOKEN_GT, Span{start: state.pending_type_gt_span.start + 1, end: state.pending_type_gt_span.end})
    }
    pos := state.position
    len: state.tokens.len()
    if pos < 0 || pos >= len {
        return parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
    }
    kind := state.tokens[pos].kind
    if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT {
        return state.tokens[pos]
    }
    loop {
        pos += 1
        if pos >= len {
            state.position = pos
            return parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
        }
        kind = state.tokens[pos].kind
        if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT {
            state.position = pos
            return state.tokens[pos]
        }
    }
}

parser_lookahead_forward: fn(state: JetParserState, start: Int, skip: Int) -> Token Never! {
    remaining := skip
    loop index in start..<state.tokens.len() {
        kind: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            if remaining == 0 -> return state.tokens[index]
            remaining -= 1
        }
    }
    parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
}

parser_lookahead: fn(state: ^JetParserState, offset: Int) -> Token Never! {
    seek_offset := offset
    if state.pending_type_gt {
        if seek_offset == 0 -> return parser_current(state)
        if seek_offset > 0 {
            return parser_lookahead_forward(state, state.position, seek_offset - 1)
        }
        if seek_offset == -1 {
            return parser_synthetic_token(TOKEN_GT, Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.start + 1})
        }
        seek_offset += 1
    }
    parser_skip_trivia(state)
    if seek_offset >= 0 -> return parser_lookahead_forward(state, state.position, seek_offset)
    index := state.position - 1
    remaining := -seek_offset
    loop index >= 0 {
        kind: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            remaining -= 1
            if remaining == 0 -> return state.tokens[index]
        }
        index -= 1
    }
    parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
}

// Kind-only reads: the parser asks for the current or a lookahead token's kind
// far more often than for the token, so these never copy a Token (payload text,
// decoded text, string parts). Same cursor effects as `parser_current` /
// `parser_lookahead` (trivia skipped at the cursor) and the same kinds.
parser_lookahead_kind_forward: fn(state: JetParserState, start: Int, skip: Int) -> Int Never! {
    remaining := skip
    loop index in start..<state.tokens.len() {
        kind: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            if remaining == 0 -> return kind
            remaining -= 1
        }
    }
    TOKEN_EOF
}

parser_current_kind: fn(state: ^JetParserState) -> Int Never! {
    // Keep parser_current's split-token, trivia, and EOF cursor rules.
    if state.pending_type_gt -> return TOKEN_GT
    pos := state.position
    len: state.tokens.len()
    if pos < 0 || pos >= len -> return TOKEN_EOF
    kind := state.tokens[pos].kind
    if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT -> return kind
    loop {
        pos += 1
        if pos >= len {
            state.position = pos
            return TOKEN_EOF
        }
        kind = state.tokens[pos].kind
        if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT {
            state.position = pos
            return kind
        }
    }
}

parser_kind_at: fn(state: ^JetParserState, offset: Int) -> Int Never! {
    if offset == 0 -> return parser_current_kind(state)
    if offset == 1 && !state.pending_type_gt {
        len: state.tokens.len()
        pos := state.position
        loop pos >= 0 && pos < len && parser_is_trivia(state.tokens[pos].kind) {
            pos += 1
        }
        state.position = pos
        idx := pos + 1
        loop idx < len {
            kind: state.tokens[idx].kind
            if kind != TOKEN_LINE_COMMENT && kind != TOKEN_BLOCK_COMMENT -> return kind
            idx += 1
        }
        return TOKEN_EOF
    }
    seek_offset := offset
    if state.pending_type_gt {
        if seek_offset > 0 {
            return parser_lookahead_kind_forward(state, state.position, seek_offset - 1)
        }
        if seek_offset == -1 -> return TOKEN_GT
        seek_offset += 1
    }
    parser_skip_trivia(state)
    if seek_offset >= 0 -> return parser_lookahead_kind_forward(state, state.position, seek_offset)
    index := state.position - 1
    remaining := -seek_offset
    loop index >= 0 {
        kind: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            remaining -= 1
            if remaining == 0 -> return kind
        }
        index -= 1
    }
    TOKEN_EOF
}

parser_bump: fn(state: ^JetParserState) -> Token Never! {
    if state.pending_type_gt {
        token: parser_current(state)
        state.pending_type_gt = false
        return token
    }
    token: parser_current(state)
    if token.kind == TOKEN_SEMI && token.span.start < token.span.end && !state.explicit_semicolon_reported {
        parser_report_explicit_semicolon(state, token.span)
    }
    if token.kind == TOKEN_IDENT && state.tables.len() > 0 && state.tables[0].has_paste {
        if {
            parser_glued_paste(state, token) -> {
                parser_report_glued_paste(state, token)
            }
            state.derive_template_depth == 0 && parser_template_paste(state, token) -> {
                parser_report_paste_outside_template(state, token)
            }
        }
    }
    if token.kind != TOKEN_EOF && state.position < state.tokens.len() -> state.position += 1
    token
}

// Whether the identifier `token` is a template paste `#{name}`, which the
// lexer reads as one word. A marker group's replayed member names carry the
// group's `#` span, so past the `#` byte the word itself decides.
parser_template_paste: fn(state: JetParserState, token: Token) -> Bool Never! {
    parser_source_byte(state, token.span.start) == 35 && parser_text(state, token).starts_with("#{{")
}

parser_report_paste_outside_template: fn(state: ^JetParserState, token: Token) Never! {
    paste: parser_text(state, token)
    state.diagnostics.push(diagnostic_from_registry("E0003", Val(token.span), "`{paste}` pastes a template binding outside a template", "only a derive or marker template splices a binding's name into the code it generates", "write the name itself, or move this code into a derive or marker template"))
}

// Whether the identifier `token` is a word the lexer read with a paste glued
// to its letters (`get_#{field}`, `#{field}_value`, `#{a}#{b}`). Only a word
// with a `{` byte reads its text.
parser_glued_paste: fn(state: JetParserState, token: Token) -> Bool Never! {
    if state.sources.len() == 0 -> return false
    source: state.sources[0]
    lo: token.span.start - state.source_offset
    hi: token.span.end - state.source_offset
    if lo < 0 || hi > source.len() -> return false
    brace := lo
    loop brace < hi && source[brace] != (U8{123}) -> brace += 1
    if brace == hi -> return false
    text: parser_text(state, token)
    if !text.contains("#{{") -> return false
    !text.starts_with("#{{") || !text.ends_with("}}") || text.slice(2, text.len()).contains("#{{")
}

parser_report_glued_paste: fn(state: ^JetParserState, token: Token) Never! {
    word: parser_text(state, token)
    state.diagnostics.push(diagnostic_from_registry("E0003", Val(token.span), "`{word}` glues a paste onto letters", "a paste `#{{…}}` stands for a whole name; it never joins the letters beside it, so `pkg#1.4` and `[Int#4]` keep their meaning", "build the name as a string first, as in `method: \"get_{{field.name}}\"`, then paste `#{{method}}`"))
}

// An explicit `;` stays a statement boundary but is not canonical
// Jet. The edit replaces it with a line break when code follows on the same
// line and deletes it otherwise.
parser_report_explicit_semicolon: fn(state: ^JetParserState, span: Span) Never! {
    state.explicit_semicolon_reported = true
    next_start := -1
    loop index in (state.position + 1)..<state.tokens.len() {
        kind: state.tokens[index].kind
        if !parser_is_trivia(kind) && kind != TOKEN_SEMI && kind != TOKEN_EOF {
            next_start = state.tokens[index].span.start
            break
        }
    }
    same_line := next_start >= state.source_offset && next_start <= parser_source_end_offset(state)
    if same_line {
        loop index in span.end..<next_start {
            byte: parser_source_byte(state, index)
            if byte == 10 || byte == 13 -> same_line = false
        }
    }
    new_text: if same_line -> "\n" else -> ""
    diagnostic: diagnostic_from_registry("E0373", Val(span), "This explicit semicolon is not part of canonical Jet syntax.", "Jet uses line boundaries for statements; the parser preserves this boundary so the same program can be repaired without changing behavior.", "Replace the semicolon with a line break when code follows it, or remove it at the end of a line; `jet fmt` applies this fix.")
    state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: new_text}))
}

parser_type_close_here: fn(state: ^JetParserState) -> Bool Never! {
    if state.pending_type_gt -> return true
    kind: parser_current_kind(state)
    kind == TOKEN_GT || kind == TOKEN_SHR
}

parser_take_type_close: fn(state: ^JetParserState) -> Span Never! {
    token: parser_current(state)
    if state.pending_type_gt {
        state.pending_type_gt = false
        return token.span
    }
    if token.kind == TOKEN_SHR {
        state.position += 1
        state.pending_type_gt = true
        state.pending_type_gt_span = token.span
        return Span{start: token.span.start, end: token.span.start + 1}
    }
    if token.kind == TOKEN_GT -> return parser_bump(state).span
    token.span
}

parser_cover: fn(left: Span, right: Span) -> Span Never! { Span{start: left.start, end: right.end} }

parser_add_error_code: fn(state: ^JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    if parser_aborting(state) {
        return
    }
    state.diagnostics.push(diagnostic_from_registry(code, Val(span), what, why, fix))
}

// A coded error with its fix edit.
parser_add_error_code_edit: fn(state: ^JetParserState, code: String, span: Span, what: String, why: String, fix: String, edit: TextEdit) {
    if parser_aborting(state) {
        return
    }
    state.diagnostics.push(diagnostic_with_edit(diagnostic_from_registry(code, Val(span), what, why, fix), edit))
}

// An edit deleting `span` and the horizontal whitespace after it.
parser_deletion_edit: fn(state: JetParserState, span: Span) -> TextEdit Never! {
    end := span.end
    limit: parser_source_end_offset(state)
    loop end < limit {
        b: parser_source_byte(state, end)
        if b != 32 && b != 9 -> break
        end += 1
    }
    TextEdit{span: Span{start: span.start, end: end}, new_text: ""}
}

// A fatal error ends the statement or item, so nothing more is reported until
// the enclosing loop resynchronizes.
parser_add_fatal_code: fn(state: ^JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    if parser_aborting(state) {
        return
    }
    state.diagnostics.push(diagnostic_from_registry(code, Val(span), what, why, fix))
    state.abort_mark = state.diagnostics.len()
    state.abort_position = state.position
}

parser_add_error: fn(state: ^JetParserState, span: Span, what: String, why: String, fix: String) {
    parser_add_fatal_code(state, "E0003", span, what, why, fix)
}

parser_aborting: fn(state: ^JetParserState) -> Bool Never! {
    if state.abort_mark == 0 -> return false
    if state.diagnostics.len() < state.abort_mark {
        state.abort_mark = 0
        return false
    }
    true
}

// Resume after a fatal error found inside the construct that began at token
// index `start`: put the cursor back where the error was found. An abort from
// before `start` belongs to an outer loop.
parser_take_abort: fn(state: ^JetParserState, start: Int) -> Bool Never! {
    if !parser_aborting(state) || state.abort_position < start -> return false
    state.abort_mark = 0
    state.position = state.abort_position
    state.pending_type_gt = false
    true
}

parser_recover_aborted_statement: fn(state: ^JetParserState, start: Int) Never! {
    if !parser_take_abort(state, start) {
        return
    }
    // Braces the statement opened before the error, such as a typed literal's
    // `HTML{` around a bad hole, close inside it; skip their closers too.
    open := 0
    loop index in start..<state.position {
        if index >= state.tokens.len() -> break
        kind: state.tokens[index].kind
        if kind == TOKEN_LBRACE -> open += 1
        if kind == TOKEN_RBRACE && open > 0 -> open -= 1
    }
    parser_sync_stmt_from(state, open)
}

parser_recover_aborted_item: fn(state: ^JetParserState, start: Int) Never! {
    if parser_take_abort(state, start) -> parser_sync_top(state)
}

parser_add_error_here: fn(state: ^JetParserState, what: String, why: String, fix: String) {
    span: parser_current(state).span
    parser_add_error(state, span, what, why, fix)
}

// `describe`: name what the reader sees. Users never type `;`: the lexer
// inserts it at a line end, and an explicit one is retired.
parser_describe_token: fn(state: JetParserState, token: Token) -> String Never! {
    kind: token.kind
    if kind == TOKEN_EOF -> return "the end of the file"
    if kind == TOKEN_SEMI -> return "the end of the line"
    if kind == TOKEN_IDENT -> return "the name `{parser_text(state, token)}`"
    if kind == TOKEN_STRING -> return "a piece of quoted text"
    if kind == TOKEN_RAW_STRING -> return "a piece of raw text"
    if kind == TOKEN_INT -> return "a number"
    if kind == TOKEN_FLOAT -> return "a decimal number"
    if kind == TOKEN_UNIT_NUMBER -> return "a number with a unit suffix"
    if kind == TOKEN_CHAR -> return "a character"
    if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> return "a comment"
    keyword: kind == TOKEN_SELF || kind == TOKEN_NULL || kind == TOKEN_BREAK || kind == TOKEN_RETURN || (kind >= TOKEN_KW_FN && kind <= TOKEN_KW_MODULE)
    if keyword -> return "the keyword `{parser_text(state, token)}`"
    "`{parser_text(state, token)}`"
}

parser_expect: fn(state: ^JetParserState, kind: Int, context: String) -> Token {
    if parser_current_kind(state) == kind -> return parser_bump(state)
    span: parser_current(state).span
    parser_report_expected(state, context)
    parser_synthetic_token(kind, span)
}

// The generic parse error at the current token, naming what belongs there.
parser_report_expected: fn(state: ^JetParserState, context: String) {
    token: parser_current(state)
    found: parser_describe_token(state, token)
    parser_add_error(
        state,
        token.span,
        "expected {context}, found {found}",
        "the parser needs the expected token to keep the surrounding syntax unambiguous",
        "write the expected token here",
    )
}

parser_expect_name: fn(state: ^JetParserState, context: String) -> Token {
    if parser_current_kind(state) == TOKEN_IDENT -> return parser_bump(state)
    token: parser_current(state)
    // `in` is the source-loop keyword, never a name.
    if token.kind == TOKEN_KW_IN {
        parser_add_error(state, token.span, "`in` is reserved as the source-loop keyword", "the `in` keyword marks the boundary between a loop binding and its source", "choose a different identifier name, or use `in` in a source loop; after `.` it is allowed as a member name")
        return parser_synthetic_token(TOKEN_IDENT, token.span)
    }
    found: parser_describe_token(state, token)
    parser_add_error(
        state,
        token.span,
        "expected a name {context}, found {found}",
        "names start with a letter or `_`",
        "e.g. `main`, `count`, `_tmp`",
    )
    parser_synthetic_token(TOKEN_IDENT, token.span)
}

// Callables, arms and lambdas share one arrow, `->`.
parser_at_unified_arrow: fn(state: ^JetParserState) -> Bool Never! {
    kind: parser_current_kind(state)
    kind == TOKEN_UNIFIED_ARROW
}

parser_expect_unified_arrow: fn(state: ^JetParserState, context: String) -> Token {
    token: parser_current(state)
    if !parser_at_unified_arrow(state) {
        found: parser_describe_token(state, token)
        parser_add_error(state, token.span, "expected `->` {context}, found {found}", "callables, arms, and lambdas use one arrow", "write `->` {context}")
        return parser_synthetic_token(TOKEN_UNIFIED_ARROW, token.span)
    }
    parser_bump(state)
    token
}

parser_is_closer: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE
}

parser_closer_text: fn(kind: Int) -> String Never! {
    if kind == TOKEN_LPAREN -> return ")"
    if kind == TOKEN_LBRACKET -> return "]"
    "}}"
}

// The innermost bracket opened before the cursor and not yet closed.
parser_innermost_open_delimiter: fn(state: JetParserState) -> Token? {
    depth := 0
    index := state.position - 1
    loop index >= 0 {
        token: state.tokens[index]
        if {
            parser_is_closer(token.kind) -> depth += 1
            token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LBRACE -> {
                if depth == 0 -> return Val(token)
                depth -= 1
            }
            else -> {}
        }
        index -= 1
    }
    None
}

parser_previous_end: fn(state: JetParserState) -> Int Never! {
    index := state.position - 1
    loop index >= 0 {
        token: state.tokens[index]
        if !parser_is_trivia(token.kind) && token.span.start != token.span.end {
            return token.span.end
        }
        index -= 1
    }
    0
}

// E0083 (#3719): a delimited list cut off by the end of a line, a closer of
// another kind, or the end of the file reports its opener, never a missing
// separator before an invisible terminator. Returns true when it reported.
parser_unclosed_delimiter: fn(state: ^JetParserState, construct: String) -> Bool {
    token: parser_current(state)
    at_line_end: token.kind == TOKEN_SEMI && token.span.start == token.span.end
    if !(at_line_end || token.kind == TOKEN_EOF || parser_is_closer(token.kind)) -> return false
    cutoff: if {
        at_line_end -> "the end of the line"
        token.kind == TOKEN_EOF -> "the end of the file"
        else -> "`{parser_text(state, token)}`"
    }
    opener: parser_innermost_open_delimiter(state) ?? return false
    close: parser_closer_text(opener.kind)
    if parser_text(state, token) == close -> return false
    // An error already reported between the opener and the cutoff (an
    // unclosed text that swallowed the closer) explains the cut on its own.
    if parser_error_within(state, opener.span.start, token.span.start) -> return true
    parser_report_unclosed(state, opener, cutoff, construct)
    true
}

parser_error_within: fn(state: JetParserState, start: Int, end: Int) -> Bool Never! {
    loop diagnostic in state.diagnostics {
        if diagnostic.severity == 1 && diagnostic.span == .Val(span) && span.start >= start && span.start < end {
            return true
        }
    }
    false
}

parser_report_unclosed: fn(state: ^JetParserState, opener: Token, cutoff: String, construct: String) {
    close: parser_closer_text(opener.kind)
    open: parser_text(state, opener)
    at: parser_previous_end(state)
    line: parser_line_number_of(state, opener.span.start)
    what: if line > 0 -> "`{open}` opened on line {line} is never closed" else -> "this `{open}` is never closed"
    diagnostic: diagnostic_from_registry("E0083", Val(opener.span), what, "Every `{open}` needs a matching `{close}`, but {cutoff} came first", "Add `{close}` where the {construct} ends")
    labeled: diagnostic_with_label(diagnostic, Span{start: at, end: at}, "{cutoff} comes before the closing `{close}`")
    state.diagnostics.push(diagnostic_with_edit_grade(labeled, TextEdit{span: Span{start: at, end: at}, new_text: close}, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview))
}

// A block cut off by the end of the file, read by indentation: the first `}`
// that starts its line left of the line its `{` opened on closes an outer
// block early, so that `{` is the one never closed. Jet's formatter keeps
// indentation, so the mismatch names the likely opener, and its `}` belongs
// before the first line back at the opener's indentation. Reports nothing
// and returns false when every such `}` sits at its opener's indentation.
parser_report_unclosed_by_indent: fn(state: ^JetParserState, open: Token) -> Bool {
    if state.line_starts.len() == 0 || state.sources.len() == 0 || state.sources[0].len() == 0 -> return false
    openers := [Int]{}
    loop index in 0..<state.tokens.len() {
        token: state.tokens[index]
        if token.span.start < open.span.start || token.span.start == token.span.end -> next
        if token.kind == TOKEN_LBRACE {
            openers.push(index)
            next
        }
        if token.kind != TOKEN_RBRACE -> next
        opener: state.tokens[openers.pop() ?? return false]
        close_start: parser_line_start_of(state, token.span.start)
        close_column: token.span.start - close_start
        if parser_line_indent_width(state, close_start) != close_column -> next
        opener_start: parser_line_start_of(state, opener.span.start)
        indent: parser_line_indent_width(state, opener_start)
        if close_column >= indent -> next
        parser_report_misindented_close(state, opener, token, opener_start, indent)
        return true
    }
    false
}

// E0083 for the `{` that a `}` left of its line closes too early.
parser_report_misindented_close: fn(state: ^JetParserState, opener: Token, close: Token, opener_start: Int, indent: Int) {
    opener_line: parser_line_number_of(state, opener.span.start)
    close_line: parser_line_number_of(state, close.span.start)
    size: parser_source_end_offset(state)
    insert_line := opener_line + 1
    loop insert_line < close_line {
        local: insert_line - 1 - state.line_base
        if local < 0 || local >= state.line_starts.len() -> break
        start: state.line_starts[local]
        width: parser_line_indent_width(state, start)
        blank: start + width >= size || parser_is_space_byte(parser_source_byte(state, start + width))
        if !blank && width <= indent -> break
        insert_line += 1
    }
    at_local: insert_line - 1 - state.line_base
    at: if at_local >= 0 && at_local < state.line_starts.len() -> state.line_starts[at_local] else -> size
    head: parser_line_head_keyword(state, opener_start + indent)
    named: if head == "" -> "`{{`" else -> "the `{head}`"
    what: "{named} opened on line {opener_line} is never closed"
    why: "the `}}` on line {close_line} sits left of {named} on line {opener_line}, so it closes an outer block and leaves {named} without its own `}}`"
    fix: "add `}}` before line {insert_line}, the first line back at the indentation of {named}"
    diagnostic: diagnostic_from_registry("E0083", Val(opener.span), what, why, fix)
    labeled: diagnostic_with_label(diagnostic, close.span, "this `}}` closes an outer block")
    edit: TextEdit{span: Span{start: at, end: at}, new_text: "{parser_source_slice(state, opener_start, opener_start + indent)}}}\n"}
    state.diagnostics.push(diagnostic_with_edit_grade(labeled, edit, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview))
}

// The keyword that opens a block at `offset` (`if`, `else`, `loop`, `match`),
// or "" when the line opens with anything else.
parser_line_head_keyword: fn(state: JetParserState, offset: Int) -> String Never! {
    end := offset
    limit: parser_source_end_offset(state)
    loop end < limit && parser_is_word_byte(parser_source_byte(state, end)) -> end += 1
    word: parser_source_slice(state, offset, end)
    if word == "if" || word == "else" || word == "loop" || word == "match" -> word else -> ""
}

parser_is_word_byte: fn(byte: Int) -> Bool Never! {
    (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

// Where the line holding `offset` starts.
parser_line_start_of: fn(state: JetParserState, offset: Int) -> Int Never! {
    if state.line_starts.len() == 0 -> return 0
    low := 0
    high := state.line_starts.len()
    loop low < high {
        mid: low + (high - low) /% 2
        if state.line_starts[mid] <= offset -> low = mid + 1 else -> high = mid
    }
    if low > 0 -> state.line_starts[low - 1] else -> 0
}

// The 1-based line holding `offset`.
parser_line_number_of: fn(state: JetParserState, offset: Int) -> Int Never! {
    if state.line_starts.len() == 0 -> return 0
    low := 0
    high := state.line_starts.len()
    loop low < high {
        mid: low + (high - low) /% 2
        if state.line_starts[mid] <= offset -> low = mid + 1 else -> high = mid
    }
    if low == 0 -> return 0
    state.line_base + low
}

// The spaces and tabs that start the line beginning at `line_start`.
parser_line_indent_width: fn(state: JetParserState, line_start: Int) -> Int Never! {
    end := line_start
    limit: parser_source_end_offset(state)
    loop end < limit {
        b: parser_source_byte(state, end)
        if b != 32 && b != 9 -> break
        end += 1
    }
    end - line_start
}

parser_skip_semicolons: fn(state: ^JetParserState) Never! {
    loop parser_current_kind(state) == TOKEN_SEMI -> parser_bump(state)
}

parser_skip_synthetic_semicolons: fn(state: ^JetParserState) Never! {
    loop {
        if parser_current_kind(state) != TOKEN_SEMI -> break
        semi: parser_current(state)
        if semi.span.start != semi.span.end -> break
        parser_bump(state)
    }
}

// Did a parse since diagnostic index `mark` report an error (not a lint)?
parser_error_since: fn(state: JetParserState, mark: Int) -> Bool Never! {
    loop index in mark..<state.diagnostics.len() {
        if state.diagnostics[index].severity == 1 -> return true
    }
    false
}

// True when a line ends between token indexes `start` and `end` (the lexer's
// zero-width terminator marks every authored line break).
parser_authored_line_break: fn(state: JetParserState, start: Int, end: Int) -> Bool Never! {
    loop index in start..<end {
        if index >= 0 && index < state.tokens.len() {
            token: state.tokens[index]
            if token.kind == TOKEN_SEMI && token.span.start == token.span.end -> return true
        }
    }
    false
}

// L0507: a multi-line or chained classic branch prefers one ordered arm
// table. When the recorded parts cover the whole construct, the arm-table
// rewrite rides along as a safe fix.
parser_prefer_arm_table: fn(state: ^JetParserState, span: Span, parts: [ParserBranchPart], diag_mark: Int) {
    diagnostic: diagnostic_from_registry("L0507", Val(span), "prefer an ordered arm table for this branch", "one ordered arm table is Jet's normal form for multi-line and chained choices", "write `if {{ condition -> body else -> body }}`")
    edit: parser_arm_table_edit(state, span, parts, diag_mark)
    if edit == .Val(value) {
        state.diagnostics.push(diagnostic_with_edit(diagnostic, value))
        return
    }
    state.diagnostics.push(diagnostic)
}

parser_is_space_byte: fn(byte: Int) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

parser_source_end_offset: fn(state: JetParserState) -> Int Never! {
    if state.sources.len() == 0 -> return 0
    state.source_offset + state.sources[0].len()
}

parser_source_byte: fn(state: JetParserState, offset: Int) -> Int Never! {
    if state.sources.len() == 0 -> return -1
    local: offset - state.source_offset
    if local < 0 || local >= state.sources[0].len() -> return -1
    Int{state.sources[0][local]}
}

parser_source_slice: fn(state: JetParserState, start: Int, end: Int) -> String Never! {
    if state.sources.len() == 0 -> return ""
    lo: start - state.source_offset
    hi: end - state.source_offset
    if lo < 0 || hi < lo || hi > state.sources[0].len() -> return ""
    String.from_bytes(state.sources[0].slice(lo, hi)) ?? ""
}

// E0641: the `else` arm of a dispatch table that opens after `open_end` (just
// past its `{`), as sema reports and rewrites it. `last_arm_end` ends the arm
// before the `else`, which starts at `else_start`; the arm ends at `arm_end`.
parser_else_arm_span: fn(state: JetParserState, table: Span, open_end: Int, last_arm_end: Int, else_start: Int, arm_end: Int) -> ElseArmSpan Never! {
    arm: Span{start: else_start, end: arm_end}
    delete: Span{start: last_arm_end, end: arm_end}
    if parser_source_slice(state, last_arm_end, else_start).contains("\n") {
        return ElseArmSpan{table: table, arm: arm, delete: delete, one_line: false, layout: None}
    }
    limit: parser_source_end_offset(state)
    close := arm_end
    loop close < limit && parser_is_space_byte(parser_source_byte(state, close)) -> close += 1
    if close >= limit || parser_source_byte(state, close) != 125 || parser_source_slice(state, open_end, else_start).contains("\n") {
        return ElseArmSpan{table: table, arm: arm, delete: delete, one_line: true, layout: None}
    }
    line_start := open_end
    loop line_start > state.source_offset && parser_source_byte(state, line_start - 1) != 10 -> line_start -= 1
    indent_end := line_start
    loop indent_end < limit {
        b: parser_source_byte(state, indent_end)
        if b != 32 && b != 9 -> break
        indent_end += 1
    }
    layout: ElseArmLayout{
        span: Span{start: open_end, end: close},
        head: parser_source_slice(state, open_end, last_arm_end).trim(),
        tail: parser_source_slice(state, else_start + 4, arm_end),
        indent: parser_source_slice(state, line_start, indent_end),
    }
    ElseArmSpan{table: table, arm: arm, delete: delete, one_line: true, layout: Val(layout)}
}

// The source between two recorded pieces may hold only the chain's own
// connectors (`if`, `else`, `->`); anything else, such as a comment, would be
// dropped by the rebuilt table.
parser_branch_gap_is_connector: fn(state: JetParserState, start: Int, end: Int) -> Bool Never! {
    index := start
    loop index < end {
        if parser_is_space_byte(parser_source_byte(state, index)) {
            index += 1
            next
        }
        word_start: index
        loop index < end && !parser_is_space_byte(parser_source_byte(state, index)) -> index += 1
        word: parser_source_slice(state, word_start, index)
        if word != "if" && word != "else" && word != "->" -> return false
    }
    true
}

// Trimmed byte range of one authored piece starting at or after `cursor`, or
// None when the pieces are out of order, overrun the construct, or are
// separated by more than connectors. The caller advances `cursor` to
// `piece.end`.
parser_take_branch_piece: fn(state: JetParserState, piece: Span, cursor: Int, end: Int) -> Span? Never! {
    if piece.start < cursor || piece.end < piece.start || piece.end > end -> return None
    if !parser_branch_gap_is_connector(state, cursor, piece.start) -> return None
    start := piece.start
    stop := piece.end
    loop start < stop && parser_is_space_byte(parser_source_byte(state, start)) -> start += 1
    loop stop > start && parser_is_space_byte(parser_source_byte(state, stop - 1)) -> stop -= 1
    Val(Span{start: start, end: stop})
}

// Re-indent every line after the first by one level, so a body moved from
// statement level into a table arm keeps its relative layout.
parser_indent_following_lines: fn(state: JetParserState, piece: Span, unit: String) -> String Never! {
    out := ""
    line_start := piece.start
    first := true
    loop {
        line_end := line_start
        loop line_end < piece.end && parser_source_byte(state, line_end) != 10 -> line_end += 1
        line: parser_source_slice(state, line_start, line_end)
        if {
            first -> {
                out = line
                first = false
            }
            else -> {
                blank := true
                loop index in line_start..<line_end {
                    if !parser_is_space_byte(parser_source_byte(state, index)) -> blank = false
                }
                out = if blank -> "{out}\n" else -> "{out}\n{unit}{line}"
            }
        }
        if line_end >= piece.end -> break
        line_start = line_end + 1
    }
    out
}

// Rebuild a classic chain as `if { cond -> body … else -> body }` from its
// authored text. None whenever the rewrite could lose or change anything:
// errors inside the chain, text between parts other than `if`/`else`/`->`,
// or a guard head the table would read as a readiness timeout.
parser_arm_table_edit: fn(state: JetParserState, if_span: Span, parts: [ParserBranchPart], diag_mark: Int) -> TextEdit? Never! {
    start: if_span.start
    end: if state.position > 0 -> state.tokens[state.position - 1].span.end else -> 0
    if start < state.source_offset || start >= end || end > parser_source_end_offset(state) || parser_source_slice(state, start, start + 2) != "if" {
        return None
    }
    if parser_error_since(state, diag_mark) -> return None
    line_start := start
    loop line_start > state.source_offset && parser_source_byte(state, line_start - 1) != 10 -> line_start -= 1
    indent_end := line_start
    loop indent_end < start {
        b: parser_source_byte(state, indent_end)
        if b != 32 && b != 9 -> break
        indent_end += 1
    }
    indent: parser_source_slice(state, line_start, indent_end)
    unit: "    "
    arms := ""
    else_line := ""
    else_seen := false
    arm_count := 0
    cursor := start + 2
    loop part in parts {
        if else_seen -> return None
        if !part.is_else {
            cond: parser_take_branch_piece(state, part.cond, cursor, end) ?? return None
            cursor = part.cond.end
            body: parser_take_branch_piece(state, part.body, cursor, end) ?? return None
            cursor = part.body.end
            if cond.start == cond.end || body.start == body.end -> return None
            // A guard head that starts with `after` is a readiness timeout,
            // not a Boolean test.
            word_end := cond.start
            loop word_end < cond.end && parser_is_identifier_byte(parser_source_byte(state, word_end)) {
                word_end += 1
            }
            if parser_source_slice(state, cond.start, word_end) == "after" -> return None
            arms = "{arms}{indent}{unit}{parser_indent_following_lines(state, cond, unit)} -> {parser_indent_following_lines(state, body, unit)}\n"
            arm_count += 1
            next
        }
        body: parser_take_branch_piece(state, part.body, cursor, end) ?? return None
        cursor = part.body.end
        if body.start == body.end -> return None
        else_line = "{indent}{unit}else -> {parser_indent_following_lines(state, body, unit)}\n"
        else_seen = true
    }
    if arm_count == 0 || cursor > end -> return None
    loop index in cursor..<end {
        if !parser_is_space_byte(parser_source_byte(state, index)) -> return None
    }
    Val(TextEdit{span: Span{start: start, end: end}, new_text: "if {{\n{arms}{else_line}{indent}}}"})
}

// ASCII letters, digits and `_`; the readiness `after` check splits on others.
parser_is_identifier_byte: fn(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// A keyword token: a written word the lexer reads as a keyword. A marker
// parameter may be named by any written word.
parser_is_keyword_token: fn(state: JetParserState, token: Token) -> Bool Never! {
    text: parser_text(state, token)
    if token.kind == TOKEN_IDENT || text.len() == 0 -> return false
    bytes: text.bytes()
    first: Int{bytes[0]}
    if !((first >= 97 && first <= 122) || (first >= 65 && first <= 90)) -> return false
    loop byte in bytes {
        if !parser_is_identifier_byte(Int{byte}) -> return false
    }
    true
}

// End of the token before the cursor, trivia and line terminators included.
parser_prev_token_end: fn(state: JetParserState) -> Int Never! {
    if state.position <= 0 || state.position > state.tokens.len() -> return 0
    state.tokens[state.position - 1].span.end
}

// Undo a speculative parse: restore the cursor and drop every diagnostic,
// block span, `else` arm and statement rule it recorded.
parser_rewind: fn(state: ^JetParserState, position: Int, diagnostics: Int, blocks: Int, else_arms: Int) {
    state.position = position
    loop state.diagnostics.len() > diagnostics -> _ := state.diagnostics.pop()
    loop state.block_spans.len() > blocks -> _ := state.block_spans.pop()
    // An abort raised inside the undone parse is undone with it.
    if state.abort_mark > diagnostics -> state.abort_mark = 0
    loop state.else_arms.len() > else_arms -> _ := state.else_arms.pop()
    // A rule recorded by the undone parse starts at or after the rewind
    // point; the reparse records it again.
    if position < state.tokens.len() {
        start: state.tokens[position].span.start
        loop state.statement_rules.len() > 0 && state.statement_rules[state.statement_rules.len() - 1].marker.span.start >= start {
            _ := state.statement_rules.pop()
        }
    }
}

parser_recover_statement: fn(state: ^JetParserState) Never! {
    loop {
        kind: parser_current_kind(state)
        if kind == {
            TOKEN_EOF -> break
            TOKEN_RBRACE -> break
            TOKEN_SEMI -> {
                parser_bump(state)
                break
            }
            else -> parser_bump(state)
        }
    }
}

// After a failed top-level item: skip to the next plausible item start. A
// `#run`, `#if` or `#loop` starts an item only at the start of a line; after
// `NAME:` it is that binding's value, which goes with the skipped line.
parser_sync_top: fn(state: ^JetParserState) Never! {
    loop {
        kind: parser_current_kind(state)
        if kind == TOKEN_EOF || kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_CONST {
            break
        }
        if kind == TOKEN_PREP && (state.position == 0 || state.tokens[state.position - 1].kind == TOKEN_SEMI) {
            break
        }
        parser_bump(state)
    }
}

// After a failed statement: skip to just past the next `;` at this brace
// depth, or stop before the block's closing `}`. `open` counts braces the
// failed statement opened and left unclosed; their closers belong to it.
parser_sync_stmt: fn(state: ^JetParserState) Never! { parser_sync_stmt_from(state, 0) }

parser_sync_stmt_from: fn(state: ^JetParserState, open: Int) Never! {
    depth := open
    loop {
        kind: parser_current_kind(state)
        if kind == TOKEN_EOF -> break
        if kind == TOKEN_RBRACE {
            if depth == 0 -> break
            depth -= 1
        }
        if kind == TOKEN_LBRACE -> depth += 1
        parser_bump(state)
        if kind == TOKEN_SEMI && depth == 0 -> break
    }
}

parser_type_gt_span: fn(state: ^JetParserState) -> Span Never! { parser_take_type_close(state) }
