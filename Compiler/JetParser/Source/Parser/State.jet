// Parser state and token access. The lexer supplies canonical token IDs,
// byte spans, exact spelling, nested string token streams, and diagnostics.
use jet_foundation.[
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    ElseArmSpan,
    Expr,
    PolicyDeclaration,
    Span,
    Stmt,
    TextEdit,
    diagnostic_from_registry,
    diagnostic_with_edit,
    diagnostic_with_edit_grade,
    diagnostic_with_label,
]
use jet_lexer.[
    StringPart,
    TOKEN_BLOCK_COMMENT,
    TOKEN_EOF,
    TOKEN_GT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_ENUM,
    TOKEN_KW_FN,
    TOKEN_KW_IMPL,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_IDENT,
    TOKEN_LAMBDA_ARROW,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LINE_COMMENT,
    TOKEN_LPAREN,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_SEMI,
    TOKEN_SHR,
    TOKEN_UNIFIED_ARROW,
    Token,
    TokenPayload,
]

pub struct JetParserState {
    pub tokens: [Token]
    pub position: Int
    pub diagnostics: [Diagnostic]
    pub source_end: Int
    pub block_spans: [Span]
    pub pending_type_gt: Bool
    pub pending_type_gt_span: Span
    pub result_handler_depth: Int
    // Byte offset where the statement being parsed starts; a retired `++`/`--`
    // that spans the whole statement gets a Safe compound-assignment edit.
    pub statement_start: Int
    // Byte offsets where each source line starts, when the source text is
    // known; E0083 names the opener's line from it.
    pub line_starts: [Int]{[Int]{}}
    // L0303 (#3716): the `else` arm of every dispatch table parsed so far.
    pub else_arms: [ElseArmSpan]{[ElseArmSpan]{}}
    // D-MARK-SCOPE1: block `#Policy(...) { … }` declarations, joined to the
    // program's policy declarations after the parse.
    pub block_policy_declarations: [PolicyDeclaration]{[PolicyDeclaration]{}}
    // D-VISDEFAULT2=A: after `#PubFile`, top-level items default to public.
    pub pub_file_default: Bool{false}
    // D-SEMI1=A: an authored `;` reports E0373 once per file.
    pub explicit_semicolon_reported: Bool{false}
    // The source text, when known; L0507 and E0373 build their edits from it.
    pub source: [U8]{[U8]{}}
    // Rust stops a statement or item at its first fatal error and resumes at
    // the next boundary, so one mistake reports once. `abort_mark` is the
    // diagnostics length just after that error (0 = none; a rewind below it
    // cancels the abort); `abort_position` is the cursor where it was found.
    pub abort_mark: Int{0}
    pub abort_position: Int{0}
    // Depth of one-statement `->` bodies; their statement may end before `else`.
    pub adjacent_if_body_depth: Int{0}
    // Rust `block_depth`: braced statement lists entered so far. Value
    // blocks read their lines at the enclosing depth, as in Rust.
    pub block_depth: Int{0}
    // Rust `callable_tail_block_depth`: the block depth of the innermost
    // callable body (-1 = none). Its last line may be a bare value.
    pub callable_tail_depth: Int{-1}
    // Rust `retired_step`: the whole span of the last retired `++`/`--`
    // step. E0160 covers it, so its recovered operand is no second error.
    pub retired_step: Span?{None}
    // Rust `derive_template_depth`: derive, marker and declaration-loop
    // template bodies entered so far. A `prep loop` inside one is a
    // template loop the derive expansion unrolls.
    pub derive_template_depth: Int{0}
}

// One authored piece of a classic branch chain: an arm's condition and body,
// or the final `else` body. The L0507 fix rebuilds the chain from these.
pub struct ParserBranchPart {
    pub is_else: Bool
    pub cond: Span
    pub body: Span
}

pub struct ParsedBlock {
    pub span: Span
    pub statements: [Stmt]
    pub tail: Expr?
}

fn parser_synthetic_token(kind: Int, span: Span) -> Token Never! {
    Token{
        kind: kind,
        span: span,
        payload: TokenPayload{
            text: "",
            decoded: "",
            integer: None,
            decimal: None,
            suffix: "",
            interpolations: 0,
            string_parts: [StringPart]{},
        },
    }
}

fn parser_is_trivia(kind: Int) -> Bool Never! {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

fn parser_skip_trivia(state: &JetParserState) Never! {
    loop state.position >= 0 && state.position < state.tokens.len() && parser_is_trivia(state.tokens[state.position].kind) -> state.position += 1
}

fn parser_current(state: &JetParserState) -> Token Never! {
    if state.pending_type_gt {
        return parser_synthetic_token(TOKEN_GT, Span{start: state.pending_type_gt_span.start + 1, end: state.pending_type_gt_span.end})
    }
    parser_skip_trivia(&state)
    if state.position < 0 || state.position >= state.tokens.len() {
        return parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
    }
    state.tokens[state.position]
}

fn parser_lookahead_forward(state: JetParserState, start: Int, skip: Int) -> Token Never! {
    remaining := skip
    loop index in start..<state.tokens.len() {
        kind :: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            if remaining == 0 -> return state.tokens[index]
            remaining -= 1
        }
    }
    parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
}

fn parser_lookahead(state: &JetParserState, offset: Int) -> Token Never! {
    seek_offset := offset
    if state.pending_type_gt {
        if seek_offset == 0 -> return parser_current(&state)
        if seek_offset > 0 -> return parser_lookahead_forward(state, state.position, seek_offset - 1)
        if seek_offset == -1 -> return parser_synthetic_token(TOKEN_GT, Span{start: state.pending_type_gt_span.start, end: state.pending_type_gt_span.start + 1})
        seek_offset += 1
    }
    parser_skip_trivia(&state)
    if seek_offset >= 0 -> return parser_lookahead_forward(state, state.position, seek_offset)
    index := state.position - 1
    remaining := -seek_offset
    loop index >= 0 {
        kind :: state.tokens[index].kind
        if !parser_is_trivia(kind) {
            remaining -= 1
            if remaining == 0 -> return state.tokens[index]
        }
        index -= 1
    }
    parser_synthetic_token(TOKEN_EOF, Span{start: state.source_end, end: state.source_end})
}

fn parser_current_kind(state: &JetParserState) -> Int Never! {
    parser_current(&state).kind
}

fn parser_kind_at(state: &JetParserState, offset: Int) -> Int Never! {
    if offset == 0 -> return parser_current_kind(&state)
    parser_lookahead(&state, offset).kind
}

fn parser_bump(state: &JetParserState) -> Token Never! {
    if state.pending_type_gt {
        token :: parser_current(&state)
        state.pending_type_gt = false
        return token
    }
    token :: parser_current(&state)
    if token.kind == TOKEN_SEMI && token.span.start < token.span.end && !state.explicit_semicolon_reported -> parser_report_explicit_semicolon(&state, token.span)
    if token.kind != TOKEN_EOF && state.position < state.tokens.len() -> state.position += 1
    token
}

// D-SEMI1=A: an explicit `;` stays a statement boundary but is not canonical
// Jet. The edit replaces it with a line break when code follows on the same
// line and deletes it otherwise.
fn parser_report_explicit_semicolon(state: &JetParserState, span: Span) Never! {
    state.explicit_semicolon_reported = true
    next_start := -1
    loop index in (state.position + 1)..<state.tokens.len() {
        kind :: state.tokens[index].kind
        if !parser_is_trivia(kind) && kind != TOKEN_SEMI && kind != TOKEN_EOF {
            next_start = state.tokens[index].span.start
            break
        }
    }
    same_line := next_start >= 0 && next_start <= state.source.len()
    if same_line {
        loop index in span.end..<next_start {
            byte :: Int.from_u8(state.source[index])
            if byte == 10 || byte == 13 -> same_line = false
        }
    }
    new_text :: if same_line -> "\n" else -> ""
    diagnostic :: diagnostic_from_registry("E0373", Val(span), "This explicit semicolon is not part of canonical Jet syntax.", "Jet uses line boundaries for statements; the parser preserves this boundary so the same program can be repaired without changing behavior.", "Replace the semicolon with a line break when code follows it, or remove it at the end of a line; `jet fmt` applies this fix.")
    &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: new_text}))
}

fn parser_type_close_here(state: &JetParserState) -> Bool Never! {
    if state.pending_type_gt -> return true
    kind :: parser_current(&state).kind
    kind == TOKEN_GT || kind == TOKEN_SHR
}

fn parser_take_type_close(state: &JetParserState) -> Span Never! {
    token :: parser_current(&state)
    if state.pending_type_gt {
        state.pending_type_gt = false
        return token.span
    }
    if token.kind == TOKEN_SHR {
        state.position += 1
        state.pending_type_gt = true
        state.pending_type_gt_span = token.span
        return Span{start: token.span.start, end: token.span.start + 1}
    }
    if token.kind == TOKEN_GT -> return parser_bump(&state).span
    token.span
}

fn parser_cover(left: Span, right: Span) -> Span Never! {
    Span{start: left.start, end: right.end}
}

fn parser_add_error_code(state: &JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    if parser_aborting(&state) -> return
    &state.diagnostics.push(diagnostic_from_registry(code, Val(span), what, why, fix))
}

// A fatal error: Rust returns it as the statement's or item's `Err`, so
// nothing more is reported until the enclosing loop resynchronizes.
fn parser_add_fatal_code(state: &JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    if parser_aborting(&state) -> return
    &state.diagnostics.push(diagnostic_from_registry(code, Val(span), what, why, fix))
    state.abort_mark = state.diagnostics.len()
    state.abort_position = state.position
}

fn parser_add_error(state: &JetParserState, span: Span, what: String, why: String, fix: String) {
    parser_add_fatal_code(&state, "E0003", span, what, why, fix)
}

fn parser_aborting(state: &JetParserState) -> Bool Never! {
    if state.abort_mark == 0 -> return false
    if state.diagnostics.len() < state.abort_mark {
        state.abort_mark = 0
        return false
    }
    true
}

// Resume after a fatal error found inside the construct that began at token
// index `start`: put the cursor back where the error was found, as Rust's
// `?` leaves it. An abort from before `start` belongs to an outer loop.
fn parser_take_abort(state: &JetParserState, start: Int) -> Bool Never! {
    if !parser_aborting(&state) || state.abort_position < start -> return false
    state.abort_mark = 0
    state.position = state.abort_position
    state.pending_type_gt = false
    true
}

fn parser_recover_aborted_statement(state: &JetParserState, start: Int) Never! {
    if parser_take_abort(&state, start) -> parser_sync_stmt(&state)
}

fn parser_recover_aborted_item(state: &JetParserState, start: Int) Never! {
    if parser_take_abort(&state, start) -> parser_sync_top(&state)
}

fn parser_add_error_here(state: &JetParserState, what: String, why: String, fix: String) {
    span :: parser_current(&state).span
    parser_add_error(&state, span, what, why, fix)
}

// Name what the reader sees. Users never type `;`: the lexer inserts it at a
// line end, and an explicit one is retired (D-SEMI1=A).
fn parser_describe_token(token: Token) -> String Never! {
    if token.kind == TOKEN_EOF -> return "the end of the file"
    if token.kind == TOKEN_SEMI -> return "the end of the line"
    "`{token.payload.text}`"
}

fn parser_expect(state: &JetParserState, kind: Int, context: String) -> Token {
    if parser_current_kind(&state) == kind -> return parser_bump(&state)
    token :: parser_current(&state)
    parser_add_error(
        &state,
        token.span,
        "expected {context}, found {parser_describe_token(token)}",
        "the parser needs the expected token to keep the surrounding syntax unambiguous",
        "write the expected token here",
    )
    parser_synthetic_token(kind, token.span)
}

fn parser_expect_name(state: &JetParserState, context: String) -> Token {
    if parser_current_kind(&state) == TOKEN_IDENT -> return parser_bump(&state)
    // Rust `expect_ident`: the `tag` keyword also spells an ordinary name
    // (a field, a variant field, a parameter).
    if parser_current_kind(&state) == TOKEN_KW_TAG {
        keyword :: parser_bump(&state)
        name := parser_synthetic_token(TOKEN_IDENT, keyword.span)
        name.payload.text = "tag"
        name.payload.decoded = "tag"
        return name
    }
    token :: parser_current(&state)
    parser_add_error(
        &state,
        token.span,
        "expected a name {context}, found {parser_describe_token(token)}",
        "declarations and member paths are built from identifier tokens",
        "write an identifier here",
    )
    parser_synthetic_token(TOKEN_IDENT, token.span)
}

// D-ARROW-UNIFY1: callables, arms and lambdas share one arrow, `->`. The
// retired `=>` is still read there, with the E0070 teaching edit.
fn parser_at_unified_arrow(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LAMBDA_ARROW
}

fn parser_expect_unified_arrow(state: &JetParserState, context: String) -> Token {
    token :: parser_current(&state)
    if !parser_at_unified_arrow(&state) {
        parser_add_error(&state, token.span, "expected `->` {context}, found {parser_describe_token(token)}", "callables, arms, and lambdas use one arrow", "write `->` {context}")
        return parser_synthetic_token(TOKEN_UNIFIED_ARROW, token.span)
    }
    parser_bump(&state)
    if token.kind == TOKEN_LAMBDA_ARROW -> parser_report_retired_arrow(&state, token.span)
    token
}

// D-ARROW-RESPELL1=A: the retired `=>` arrow teaches the canonical spelling.
fn parser_report_retired_arrow(state: &JetParserState, span: Span) {
    if parser_aborting(&state) -> return
    diagnostic :: diagnostic_from_registry("E0070", Val(span), "this uses a retired arrow spelling", "callables, arms, and lambdas use one arrow: `->`", "replace `=>` with `->`")
    &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: "->"}))
}

fn parser_is_closer(kind: Int) -> Bool Never! {
    kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE
}

fn parser_closer_text(kind: Int) -> String Never! {
    if kind == TOKEN_LPAREN -> return ")"
    if kind == TOKEN_LBRACKET -> return "]"
    "}}"
}

// The innermost bracket opened before the cursor and not yet closed.
fn parser_innermost_open_delimiter(state: JetParserState) -> Token? {
    depth := 0
    index := state.position - 1
    loop index >= 0 {
        token :: state.tokens[index]
        if {
            parser_is_closer(token.kind) -> depth += 1
            token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LBRACE -> {
                if depth == 0 -> return Val(token)
                depth -= 1
            }
            else -> {}
        }
        index -= 1
    }
    None
}

fn parser_previous_end(state: JetParserState) -> Int Never! {
    index := state.position - 1
    loop index >= 0 {
        token :: state.tokens[index]
        if !parser_is_trivia(token.kind) && token.span.start != token.span.end -> return token.span.end
        index -= 1
    }
    0
}

// E0083 (#3719): a delimited list cut off by the end of a line, a closer of
// another kind, or the end of the file reports its opener, never a missing
// separator before an invisible terminator. Returns true when it reported.
fn parser_unclosed_delimiter(state: &JetParserState, construct: String) -> Bool {
    token :: parser_current(&state)
    at_line_end :: token.kind == TOKEN_SEMI && token.span.start == token.span.end
    if !(at_line_end || token.kind == TOKEN_EOF || parser_is_closer(token.kind)) -> return false
    cutoff :: if {
        at_line_end -> "the end of the line"
        token.kind == TOKEN_EOF -> "the end of the file"
        else -> "`{token.payload.text}`"
    }
    opener :: parser_innermost_open_delimiter(state) ?? return false
    close :: parser_closer_text(opener.kind)
    if token.payload.text == close -> return false
    parser_report_unclosed(&state, opener, cutoff, construct)
    true
}

fn parser_report_unclosed(state: &JetParserState, opener: Token, cutoff: String, construct: String) {
    close :: parser_closer_text(opener.kind)
    open :: opener.payload.text
    at :: parser_previous_end(state)
    line := 0
    loop start in state.line_starts {
        if start <= opener.span.start -> line += 1
    }
    what :: if line > 0 -> "`{open}` opened on line {line} is never closed" else -> "this `{open}` is never closed"
    diagnostic :: diagnostic_from_registry("E0083", Val(opener.span), what, "Every `{open}` needs a matching `{close}`, but {cutoff} came first", "Add `{close}` where the {construct} ends")
    labelled :: diagnostic_with_label(^diagnostic, Span{start: at, end: at}, "{cutoff} comes before the closing `{close}`")
    &state.diagnostics.push(diagnostic_with_edit_grade(labelled, TextEdit{span: Span{start: at, end: at}, new_text: close}, DiagnosticFixApplicability.Suggested, DiagnosticFixSafety.NeedsReview))
}

fn parser_skip_semicolons(state: &JetParserState) Never! {
    loop parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
}

fn parser_skip_synthetic_semicolons(state: &JetParserState) Never! {
    loop {
        if parser_current_kind(&state) != TOKEN_SEMI -> break
        semi :: parser_current(&state)
        if semi.span.start != semi.span.end -> break
        parser_bump(&state)
    }
}

// Did a parse since diagnostic index `mark` report an error (not a lint)?
fn parser_error_since(state: JetParserState, mark: Int) -> Bool Never! {
    loop index in mark..<state.diagnostics.len() {
        if state.diagnostics[index].severity == 1 -> return true
    }
    false
}

// True when a line ends between token indexes `start` and `end` (the lexer's
// zero-width terminator marks every authored line break).
fn parser_authored_line_break(state: JetParserState, start: Int, end: Int) -> Bool Never! {
    loop index in start..<end {
        if index >= 0 && index < state.tokens.len() {
            token :: state.tokens[index]
            if token.kind == TOKEN_SEMI && token.span.start == token.span.end -> return true
        }
    }
    false
}

// L0507: a multi-line or chained classic branch prefers one ordered arm
// table. When the recorded parts cover the whole construct, the arm-table
// rewrite rides along as a safe fix.
fn parser_prefer_arm_table(state: &JetParserState, span: Span, parts: [ParserBranchPart], diag_mark: Int) {
    diagnostic :: diagnostic_from_registry("L0507", Val(span), "prefer an ordered arm table for this branch", "one ordered arm table is Jet's normal form for multi-line and chained choices", "write `if {{ condition -> body else -> body }}`")
    edit :: parser_arm_table_edit(state, span, parts, diag_mark)
    if edit == .Val(value) {
        &state.diagnostics.push(diagnostic_with_edit(diagnostic, value))
        return
    }
    &state.diagnostics.push(diagnostic)
}

fn parser_is_space_byte(byte: Int) -> Bool Never! {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn parser_source_slice(state: JetParserState, start: Int, end: Int) -> String Never! {
    String.from_bytes(state.source.slice(start, end)) ?? ""
}

// The source between two recorded pieces may hold only the chain's own
// connectors (`if`, `else`, `->`); anything else, such as a comment, would be
// dropped by the rebuilt table.
fn parser_branch_gap_is_connector(state: JetParserState, start: Int, end: Int) -> Bool Never! {
    index := start
    loop index < end {
        if parser_is_space_byte(Int.from_u8(state.source[index])) {
            index += 1
            next
        }
        word_start :: index
        loop index < end && !parser_is_space_byte(Int.from_u8(state.source[index])) -> index += 1
        word :: parser_source_slice(state, word_start, index)
        if word != "if" && word != "else" && word != "->" -> return false
    }
    true
}

// Trimmed byte range of one authored piece starting at or after `cursor`, or
// None when the pieces are out of order, overrun the construct, or are
// separated by more than connectors. The caller advances `cursor` to
// `piece.end`.
fn parser_take_branch_piece(state: JetParserState, piece: Span, cursor: Int, end: Int) -> Span? Never! {
    if piece.start < cursor || piece.end < piece.start || piece.end > end -> return None
    if !parser_branch_gap_is_connector(state, cursor, piece.start) -> return None
    start := piece.start
    stop := piece.end
    loop start < stop && parser_is_space_byte(Int.from_u8(state.source[start])) -> start += 1
    loop stop > start && parser_is_space_byte(Int.from_u8(state.source[stop - 1])) -> stop -= 1
    Val(Span{start: start, end: stop})
}

// Re-indent every line after the first by one level, so a body moved from
// statement level into a table arm keeps its relative layout.
fn parser_indent_following_lines(state: JetParserState, piece: Span, unit: String) -> String Never! {
    out := ""
    line_start := piece.start
    first := true
    loop {
        line_end := line_start
        loop line_end < piece.end && Int.from_u8(state.source[line_end]) != 10 -> line_end += 1
        line :: parser_source_slice(state, line_start, line_end)
        if first {
            out = line
            first = false
        } else {
            blank := true
            loop index in line_start..<line_end {
                if !parser_is_space_byte(Int.from_u8(state.source[index])) -> blank = false
            }
            out = if blank -> "{out}\n" else -> "{out}\n{unit}{line}"
        }
        if line_end >= piece.end -> break
        line_start = line_end + 1
    }
    out
}

// Rebuild a classic chain as `if { cond -> body … else -> body }` from its
// authored text. None whenever the rewrite could lose or change anything:
// errors inside the chain, text between parts other than `if`/`else`/`->`,
// or a guard head the table would read as a readiness timeout.
fn parser_arm_table_edit(state: JetParserState, if_span: Span, parts: [ParserBranchPart], diag_mark: Int) -> TextEdit? Never! {
    start :: if_span.start
    end :: if state.position > 0 -> state.tokens[state.position - 1].span.end else -> 0
    if start >= end || end > state.source.len() || parser_source_slice(state, start, start + 2) != "if" -> return None
    if parser_error_since(state, diag_mark) -> return None
    line_start := start
    loop line_start > 0 && Int.from_u8(state.source[line_start - 1]) != 10 -> line_start -= 1
    indent_end := line_start
    loop indent_end < start && (Int.from_u8(state.source[indent_end]) == 32 || Int.from_u8(state.source[indent_end]) == 9) -> indent_end += 1
    indent :: parser_source_slice(state, line_start, indent_end)
    unit :: "    "
    arms := ""
    else_line := ""
    else_seen := false
    arm_count := 0
    cursor := start + 2
    loop part in parts {
        if else_seen -> return None
        if !part.is_else {
            cond :: parser_take_branch_piece(state, part.cond, cursor, end) ?? return None
            cursor = part.cond.end
            body :: parser_take_branch_piece(state, part.body, cursor, end) ?? return None
            cursor = part.body.end
            if cond.start == cond.end || body.start == body.end -> return None
            // A guard head that starts with `after` is a readiness timeout,
            // not a Boolean test.
            word_end := cond.start
            loop word_end < cond.end && (parser_is_identifier_byte(Int.from_u8(state.source[word_end]))) -> word_end += 1
            if parser_source_slice(state, cond.start, word_end) == "after" -> return None
            arms = "{arms}{indent}{unit}{parser_indent_following_lines(state, cond, unit)} -> {parser_indent_following_lines(state, body, unit)}\n"
            arm_count += 1
            next
        }
        body :: parser_take_branch_piece(state, part.body, cursor, end) ?? return None
        cursor = part.body.end
        if body.start == body.end -> return None
        else_line = "{indent}{unit}else -> {parser_indent_following_lines(state, body, unit)}\n"
        else_seen = true
    }
    if arm_count == 0 || cursor > end -> return None
    loop index in cursor..<end {
        if !parser_is_space_byte(Int.from_u8(state.source[index])) -> return None
    }
    Val(TextEdit{span: Span{start: start, end: end}, new_text: "if {{\n{arms}{else_line}{indent}}}"})
}

// ASCII letters, digits and `_`; the readiness `after` check splits on others.
fn parser_is_identifier_byte(byte: Int) -> Bool Never! {
    (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// A keyword token: a written word the lexer reads as a keyword. A marker
// parameter may be named by any written word (D-VERDICT-1455-1).
fn parser_is_keyword_token(token: Token) -> Bool Never! {
    if token.kind == TOKEN_IDENT || token.payload.text.len() == 0 -> return false
    bytes :: token.payload.text.bytes()
    first :: Int.from_u8(bytes[0])
    if !((first >= 97 && first <= 122) || (first >= 65 && first <= 90)) -> return false
    loop byte in bytes {
        if !parser_is_identifier_byte(Int.from_u8(byte)) -> return false
    }
    true
}

// End of the token before the cursor, trivia and line terminators included.
fn parser_prev_token_end(state: JetParserState) -> Int Never! {
    if state.position <= 0 || state.position > state.tokens.len() -> return 0
    state.tokens[state.position - 1].span.end
}

// Undo a speculative parse: restore the cursor and drop every diagnostic,
// block span and `else` arm it recorded.
fn parser_rewind(state: &JetParserState, position: Int, diagnostics: Int, blocks: Int, else_arms: Int) {
    state.position = position
    loop state.diagnostics.len() > diagnostics -> _ := &state.diagnostics.pop()
    loop state.block_spans.len() > blocks -> _ := &state.block_spans.pop()
    // An abort raised inside the undone parse is undone with it.
    if state.abort_mark > diagnostics -> state.abort_mark = 0
    loop state.else_arms.len() > else_arms -> _ := &state.else_arms.pop()
}

fn parser_recover_statement(state: &JetParserState) Never! {
    loop {
        kind :: parser_current_kind(&state)
        if kind == {
            TOKEN_EOF -> break
            TOKEN_RBRACE -> break
            TOKEN_SEMI -> {
                parser_bump(&state)
                break
            }
            else -> parser_bump(&state)
        }
    }
}

// Consume one balanced `(…)`, `[…]` or `{…}` group starting at the current
// opener, so a rejected construct does not cascade into its contents.
fn parser_skip_group(state: &JetParserState) Never! {
    depth := 0
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_EOF -> break
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if parser_is_closer(kind) -> depth -= 1
        parser_bump(&state)
        if depth <= 0 -> break
    }
}

// S73 recovery: skip a rejected parenthesized group through its `)`, stopping
// early at a line end or block close at the group's own depth.
fn parser_skip_to_rparen(state: &JetParserState) Never! {
    depth := 0
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_EOF -> break
        if kind == TOKEN_LPAREN -> depth += 1
        if kind == TOKEN_RPAREN {
            if depth == 0 {
                parser_bump(&state)
                break
            }
            depth -= 1
        }
        if (kind == TOKEN_SEMI || kind == TOKEN_RBRACE) && depth == 0 -> break
        parser_bump(&state)
    }
}

// After a failed top-level item: skip to the next plausible item start.
fn parser_sync_top(state: &JetParserState) Never! {
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_EOF || kind == TOKEN_KW_FN || kind == TOKEN_KW_PUB || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_CONST || kind == TOKEN_KW_COMPTIME -> break
        parser_bump(&state)
    }
}

// After a failed statement: skip to just past the next `;` at this brace
// depth, or stop before the block's closing `}`.
fn parser_sync_stmt(state: &JetParserState) Never! {
    depth := 0
    loop {
        kind :: parser_current_kind(&state)
        if kind == TOKEN_EOF -> break
        if kind == TOKEN_RBRACE {
            if depth == 0 -> break
            depth -= 1
        }
        if kind == TOKEN_LBRACE -> depth += 1
        parser_bump(&state)
        if kind == TOKEN_SEMI && depth == 0 -> break
    }
}

fn parser_type_gt_span(state: &JetParserState) -> Span Never! {
    parser_take_type_close(&state)
}
