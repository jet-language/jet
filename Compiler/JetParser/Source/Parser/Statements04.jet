// Rust: crates/jet-parser/src/Parser/Statements/control.rs:768
fn parser_parse_meta_attr_at_site(state: &JetParserState, site: Policy.RuleSite) -> MetaAttr Diagnostic! {
    parser_meta_attr_from_marker(&state, state.parse_registered_marker_at_site(site))
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:776
fn parser_meta_attr_from_marker(state: &JetParserState, marker: Marker) -> MetaAttr Diagnostic! {
    arguments :: state.bound_registered_rule_arguments(&marker)
    indices := [Int?]{}
    loop i in 0..<marker.args.len() -> &indices.push(arguments.parameter_for_source(i))
    fields := [MetaField]{}
    values :: marker.expr_args_owned()
    loop i in 0..<values.len() {
        value :: values[i]
        label := marker.arg_labels[i]
        if label == .None {
            if value == .Ident(name, span) {
                if name == Syntax.META_FIELD_TUNABLE { &fields.push(MetaField.Tunable{span: span}); next }
            }
            if indices[i] == .Val(parameter_index) {
                if Policy.applied_rule(Syntax.MARKER_META) == .Val(rule) {
                    if parameter_index < rule.signature.params.len() -> label = Val(NamedSpan{name: rule.signature.params[parameter_index].name, span: expr_span(value)})
                }
            }
        }
        if label == {
            .Val(field) -> {
                span :: Span{start: field.span.start, end: expr_span(value).end}
                if field.name == Syntax.META_FIELD_CATEGORY -> &fields.push(MetaField.Category{value: value, span: span})
                else if field.name == Syntax.META_FIELD_MATURITY {
                    valid := false
                    if value == .EnumLit(type_name, variant, _, args, _, _) {
                        valid = type_name.is_empty() && args.is_empty() && (variant == Syntax.MARKER_EXPERIMENTAL || variant == Syntax.MARKER_TESTED || variant == Syntax.MARKER_HARDENED)
                    }
                    if !valid -> parser_add_error_code(&state, "E0352", expr_span(value), "`#Meta` maturity needs a known maturity value", "maturity metadata is a closed documentation scale", "write `maturity: .Experimental`, `.Tested`, or `.Hardened`")
                    &fields.push(MetaField.Maturity{value: value, span: span})
                } else if field.name == Syntax.META_FIELD_TUNABLE {
                    if value == { .Bool(true, _) -> &fields.push(MetaField.Tunable{span: span}), .Bool(false, _) -> {}, else -> &fields.push(MetaField.Unknown{name: field.name, value: Val(value), span: field.span}) }
                } else -> &fields.push(MetaField.Unknown{name: field.name, value: Val(value), span: field.span})
            }
            .None -> {
                name :: if value == { .Ident(n, _) -> n, else -> "<positional>" }
                &fields.push(MetaField.Unknown{name: name, value: None, span: expr_span(value)})
            }
        }
    }
    MetaAttr{fields: fields, span: marker.span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:867
fn parser_meta_attr_wrong_place_diag(span: Span, target: String) -> Diagnostic Never! {
    Diagnostic.error("E0349", "`#Meta` attaches to a binding or function", "`#Meta` is a tooling fact about a named source item; expressions do not carry it", "move `#Meta(...)` before a {target}, or remove it", Val(span))
}

// Rust: crates/jet-parser/src/Parser/Statements/control.rs:882
// Switch body and duplicate-marker diagnostic -> Statements.jet:1705-1743;
// registered marker parsing/binding belongs to Items06. Site must be Block or
// Statement according to the actual body, not an unconditional block fact.
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:943
// at_policy_stmt -> Declarations/Policies.jet parser_policy_block_stmt.
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:965
fn parser_unsafe_marker_statement(state: &JetParserState) -> Stmt Diagnostic! {
    start :: parser_current(&state).span
    if parser_current_kind(&state) == TOKEN_HASH && parser_lookahead(&state, 1).payload.decoded == Syntax.MARKER_AUDIT {
        if Policy.applied_rule(Syntax.MARKER_AUDIT) == .Val(row) {
            if row.status == .Retired(replacement) {
                audit :: state.parse_rule_marker()
                if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
                parser_add_error_code(&state, "E0055", audit.span, "`#{audit.name}` is retired", "D-UNSAFE2 merged the audit reason into the gate itself", "write `{replacement} {{ … }}` and drop the separate audit line")
            }
        }
    }
    if parser_current_kind(&state) != TOKEN_HASH || parser_kind_at(&state, 1) != TOKEN_IDENT || parser_lookahead(&state, 1).payload.decoded != Syntax.KW_UNSAFE {
        return Err(Diagnostic.error("E0003", "expected `#{Syntax.KW_UNSAFE}` here", "an audited region opens with `#Unsafe(\"reason\") {{ … }}`", "write `#{Syntax.KW_UNSAFE}(\"why this is safe\") {{ … }}`", Val(parser_current(&state).span)))
    }
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    if marker.args.len() == 0 -> return Err(Diagnostic.error("E3112", "an `#Unsafe` block needs a reason", "every unsafe gate records why its unchecked operations preserve memory safety", "write `#Unsafe(\"why this is safe\") {{ … }}`", Val(marker.span)))
    arguments :: state.bound_registered_rule_arguments(&marker)
    audit_expr :: arguments.parameter(0).cloned()
    audit := String?{None}
    if audit_expr == .Val(value) -> audit = parser_expr_literal_string(value)
    mode := Policy.PolicyValue?{None}
    if marker.args.len() > 2 -> return Err(Policy.marker_argument_shape_error(Syntax.KW_UNSAFE, marker.span))
    if arguments.parameter(1) == .Val(value) {
        if value == {
            .EnumLit(type_name, variant, _, args, _, span) -> {
                if !type_name.is_empty() || !args.is_empty() -> return Err(Policy.marker_argument_shape_error(Syntax.KW_UNSAFE, expr_span(value)))
                mode = if variant == { "Track" -> Val(Policy.PolicyValue.Track), "Skip" -> Val(Policy.PolicyValue.Skip), else -> return Err(Diagnostic.error("E3108", "`.{variant}` is not a per-site obligation mode", "a gate either tracks typed obligations or explicitly skips them when policy permits", "write `.Track` or `.Skip`", Val(span))) }
            }
            else -> return Err(Policy.marker_argument_shape_error(Syntax.KW_UNSAFE, expr_span(value)))
        }
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(start, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    if mode == .Val(value) -> &state.block_policy_declarations.push(Policy.PolicyDeclaration{key: Policy.PolicyKey.Unsafe, value: value, scope: Policy.PolicyScope.Block, span: span, target: Val(span), source: "<source>"})
    Stmt.Unsafe{audit: audit, audit_expr: audit_expr, body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1084
// Impure -> Statements.jet:1732-1739 (reason_expr and literal-string extraction).
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1114
// Reactive -> Statements.jet:1741.
