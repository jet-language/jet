// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1706
fn parser_arrow_loop_stmt(state: &JetParserState) -> Stmt {
    token :: parser_current(&state)
    kind :: token.kind
    special :: kind == TOKEN_RETURN || kind == TOKEN_KW_YIELD || kind == TOKEN_BREAK || kind == TOKEN_KW_COMPTIME || kind == TOKEN_HASH || kind == TOKEN_AT || kind == TOKEN_DOLLAR
    word :: token.payload.decoded
    if special || (kind == TOKEN_IDENT && (word == Syntax.KW_DEFER || word == Syntax.KW_ASSERT || word == Syntax.KW_NEXT || parser_is_foreign_loop_word(word))) || parser_looks_like_sigil_binding(&state) || parser_at_prep_verb(&state, TOKEN_LBRACE) || parser_at_prep_verb(&state, TOKEN_KW_IF) || parser_at_prep_verb(&state, TOKEN_KW_LOOP) -> return parser_parse_statement(&state)
    value :: parser_parse_expression(&state, 1, 0)
    if parser_is_assignment_operator(parser_current_kind(&state)) {
        operator :: parser_bump(&state)
        rhs :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        target :: parser_expression_lvalue(&state, value.expr, value.span, operator)
        return Stmt.Assign{target: target, op: parser_assignment_binop(operator.kind), op_span: operator.span, value: rhs.expr}
    }
    parser_finish_statement(&state)
    Stmt.Expr{expr: value.expr}
}
