// Rust: crates/jet-parser/src/Parser/Statements/control.rs:7
// NoFixReason/NoFixReasonKind are retained imports; this range does not construct them.
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:9
// ForeignKeywordKind and FOREIGN_KEYWORDS are shared with the foreign-word
// teaching continuation (control.rs:1806+); const deliberately is not a row.
enum ForeignKeywordKind { For, While, Continue, Do, Repeat, Until, Declaration, MutableBinding, ImmutableBinding }
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:20
const FOREIGN_KEYWORDS: [(String, ForeignKeywordKind)] = [
    (Syntax.FOREIGN_FOR, .For), (Syntax.FOREIGN_WHILE, .While),
    (Syntax.FOREIGN_CONTINUE, .Continue), (Syntax.FOREIGN_DO, .Do),
    (Syntax.FOREIGN_REPEAT, .Repeat), (Syntax.FOREIGN_UNTIL, .Until),
    (Syntax.FOREIGN_FUN, .Declaration), (Syntax.FOREIGN_FUNC, .Declaration),
    (Syntax.FOREIGN_DEF, .Declaration), (Syntax.FOREIGN_FUNCTION, .Declaration),
    (Syntax.FOREIGN_VAR, .MutableBinding), (Syntax.FOREIGN_LET, .ImmutableBinding),
    (Syntax.FOREIGN_VAL, .ImmutableBinding)
]

// Rust: crates/jet-parser/src/Parser/Statements/control.rs:46
// Shares ordinary AST/lambda and loop helpers; this supplies the exact missing
// finite-header and hard item-path errors instead of a second loop AST.
fn parser_yielding_loop_expr(state: &JetParserState, depth: Int) -> ParsedExpr Diagnostic! {
    start :: parser_bump(&state).span
    if parser_current_kind(&state) == TOKEN_LBRACE {
        block :: parser_parse_block(&state)
        return parser_expression_form_make_loop_lambda([Stmt.Loop{body: block.statements, span: start, arrow_body: false, label: None}], start, block.span, true, false, false, None)
    }
    first :: parser_current_kind(&state)
    second :: parser_kind_at(&state, 1)
    bindingless :: first == TOKEN_IDENT && (second == TOKEN_UNIFIED_ARROW || second == TOKEN_KW_IF)
    binding_head :: first == TOKEN_IDENT || first == TOKEN_KW_IT
    finite :: first == TOKEN_LPAREN || (binding_head && (second == TOKEN_COLON_EQ || second == TOKEN_SEMI || second == TOKEN_COMMA || second == TOKEN_KW_IF || second == TOKEN_KW_IN || second == TOKEN_UNIFIED_ARROW))
    if !finite {
        return Err(Diagnostic.error("E0072", "this collecting loop cannot return a List because it has no finite exhaustion edge", "a collecting loop must finish after a statically finite source or C-style condition; bare infinite and condition-only loops do not provide that boundary", "remove `->`, or iterate a finite source; return one final value from an ordinary loop with `break value`", Val(start)))
    }
    clauses := [ParserExpressionFormLoopClause]{}
    counted := ParserExpressionFormCountedLoop?{None}
    if first == TOKEN_IDENT && second == TOKEN_COLON_EQ {
        counted = Val(parser_expression_form_parse_counted_loop(&state, start, depth + 1))
    } else if bindingless {
        source :: parser_parse_expression_no_struct_lit(&state, depth + 1)
        &clauses.push(ParserExpressionFormLoopClause{var: Syntax.KW_IT, var_span: source.span, var2: None, kind: ForKind.In{collection: source.expr, step: None}})
    } else {
        loop {
            clause := parser_loop_source_binding(&state)
            parser_loop_source_separator(&state)
            first_expr :: parser_parse_expression_no_struct_lit(&state, depth + 1)
            range_end := Expr?{None}
            range_start := first_expr.expr
            exclusive := false
            if first_expr.expr == {
                .Range(a, b, ex, _) -> { range_start = a; range_end = Val(b); exclusive = ex }
                else -> {
                    if parser_current_kind(&state) == TOKEN_DOT_DOT || parser_current_kind(&state) == TOKEN_DOT_DOT_LT {
                        exclusive = parser_bump(&state).kind == TOKEN_DOT_DOT_LT
                        range_end = Val(parser_parse_expression_no_struct_lit(&state, depth + 1).expr)
                    }
                }
            }
            step := Expr?{None}
            if parser_expression_form_loop_stride_here(&state) && !parser_expression_form_loop_guard_comma(&state) && parser_kind_at(&state, 1) != TOKEN_LBRACE && parser_kind_at(&state, 1) != TOKEN_UNIFIED_ARROW {
                parser_bump(&state)
                step = Val(parser_parse_expression_no_struct_lit(&state, depth + 1).expr)
            }
            clause.kind = if range_end == { .Val(end) -> ForKind.Range{start: range_start, end: end, step: step, exclusive: exclusive}, .None -> ForKind.In{collection: first_expr.expr, step: step} }
            &clauses.push(clause)
            if parser_current_kind(&state) == TOKEN_COMMA && (parser_kind_at(&state, 1) == TOKEN_LBRACE || parser_kind_at(&state, 1) == TOKEN_UNIFIED_ARROW) { parser_bump(&state); break }
            if parser_expression_form_loop_guard_comma(&state) {
                comma :: parser_bump(&state)
                parser_add_error_code(&state, "E0379", comma.span, "a guard follows its source with no comma", "the guard self-announces with `if`, so the loop head only uses commas between positional clauses", "remove the comma before `if`")
            }
            if !parser_expression_form_loop_clause_ahead(&state) -> break
            parser_bump(&state)
        }
    }
    guard := Expr?{None}
    if parser_current_kind(&state) == TOKEN_KW_IF { parser_bump(&state); guard = Val(parser_parse_expression_no_struct_lit(&state, depth + 1).expr) }
    collecting :: parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
    body := [Stmt]{}
    exhaustion := Span?{None}
    end := start
    if !collecting {
        if parser_current_kind(&state) != TOKEN_LBRACE {
            return Err(Diagnostic.error("E0003", "this statement loop is used where a value is required", "a finite loop produces a value only with a braced search body or `->`", "add `-> value`, or write `{{ ... break value }} ?? fallback`", Val(start)))
        }
        block :: parser_parse_block(&state)
        body = block.statements
        end = parser_lookahead(&state, -1).span
        exhaustion = Val(end)
    } else {
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_LBRACE {
            block :: parser_parse_callable_body(&state, true)
            body = block.statements
            end = block.span
        } else {
            value :: parser_parse_expression(&state, 1, depth + 1)
            &body.push(Stmt.Expr{expr: value.expr})
            end = value.span
        }
        last :: &body.pop() ?? return Err(Diagnostic.error("E0073", "this collecting loop path produces no item", "every accepted iteration must contribute one non-unit value unless `next` explicitly omits it", "return a value on this path, or use `next` to omit the item; remove `->` if the loop only performs effects", Val(start)))
        value :: if last == {
            .Expr(value) -> value
            else -> return Err(Diagnostic.error("E0073", "this collecting loop path produces no item", "a multiline collecting body uses its final expression as the item", "return a value on this path, or use `next` to omit this iteration", Val(start)))
        }
        &body.push(Stmt.Yield{value: value, span: Span{start: start.start, end: start.start}})
    }
    if guard == .Val(cond) {
        body = [Stmt.Switch{subject: Expr.Bool{value: true, span: start}, arms: [SwitchArm{cond: cond, body: body, span: expr_span(cond)}], else_body: None, span: start}]
    }
    label :: mangle(if collecting -> "collect_loop_{start.start}" else -> "value_loop_{start.start}")
    parser_expression_form_loop_rewrite_exits(&body, label, 0)
    statement := Stmt?{None}
    if counted == {
        .Val(counter) -> statement = Val(Stmt.CountedLoop{init: counter.init, cond: counter.cond, step: counter.step, body: body, span: start, arrow_body: false, label: if collecting -> Val(NamedSpan{name: label, span: start}) else -> None})
        .None -> {
            nested := body
            i := clauses.len()
            loop i > 0 {
                i -= 1
                clause :: clauses[i]
                nested = [Stmt.For{var: clause.var, var_span: clause.var_span, var2: clause.var2, kind: clause.kind, body: nested, span: start, arrow_body: false, label: if collecting && i == 0 -> Val(NamedSpan{name: label, span: start}) else -> None, auto_vectorization: None}]
            }
            statement = Val(nested[0])
        }
    }
    root :: statement ?? panic("a value loop has a source clause")
    final_body :: if collecting -> [root] else -> [Stmt.Loop{body: [root], span: start, arrow_body: false, label: Val(NamedSpan{name: label, span: start})}]
    final_end :: Span{start: start.start, end: end.end.max(stmt_span(root).end).max(start.end)}
    parser_expression_form_make_loop_lambda(final_body, start, final_end, !collecting, collecting, !collecting, exhaustion)
}

// Rust: crates/jet-parser/src/Parser/Statements/control.rs:432
fn parser_at_meta_attr(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == Syntax.MARKER_META && parser_kind_at(&state, 2) == TOKEN_LPAREN
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:441
fn parser_at_declared_dsl_block(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH || parser_kind_at(&state, 1) != TOKEN_IDENT -> return false
    name :: parser_lookahead(&state, 1).payload.decoded
    loop reserved in [Syntax.RETIRED_MARKER_KNOWN, Syntax.KW_UNSAFE, Syntax.CTX_BLOCK, Syntax.MARKER_REGION, Syntax.MARKER_POLICY, Syntax.MARKER_ARITHMETIC, Syntax.MARKER_LIVE, Syntax.MARKER_NONDETERMINISTIC, Syntax.KW_FX, Syntax.RETIRED_MARKER_GRANT, Syntax.KW_TRANSACT, Syntax.KW_IMPURE, Syntax.KW_SHIELD, Syntax.KW_REACTIVE, Syntax.MARKER_OFF, Syntax.MARKER_DEBUG_ONLY] { if name == reserved -> return false }
    state.marker_head_is_followed_by(TOKEN_LBRACE) || (name == Syntax.DSL_BLOCK_SQL && parser_kind_at(&state, 2) == TOKEN_LT && parser_kind_at(&state, 3) == TOKEN_IDENT && parser_kind_at(&state, 4) == TOKEN_GT && parser_kind_at(&state, 5) == TOKEN_LBRACE)
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:480
fn parser_at_declared_dsl_block_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    start :: parser_current(&state).span
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    args := marker.expr_args_owned()
    args_span :: if args.len() > 0 -> Val(marker.span) else -> None
    if parser_current_kind(&state) == TOKEN_LT {
        type_start :: parser_bump(&state).span
        type_token :: parser_bump(&state)
        end :: parser_current(&state).span
        parser_expect(&state, TOKEN_GT, "after the DSL type name")
        if type_token.kind == TOKEN_IDENT -> &args.push(Expr.Ident{value: type_token.payload.decoded, span: type_token.span})
        parser_expect(&state, TOKEN_LBRACE, "after a stdlib DSL marker")
        _ :: parser_parse_block_contents(&state)
        return Err(Diagnostic.error("E0927", "`#{marker.name}<…>` is retired", "marker arguments use the ordinary call form from the registry", "write `#{marker.name}(Row) {{ … }}`", Val(Span{start: marker.span.start, end: end.end})))
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(start, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    Stmt.ScopeMember{name: marker.name, name_span: marker.name_span, args: args, args_span: args_span, body: block.statements, dsl: true, dot_span: start, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:530
fn parser_meta_attr_next_kind(state: &JetParserState) -> Int? Never! {
    index :: parser_meta_attr_next_index(&state) ?? return None
    Val(parser_kind_at(&state, index - state.position))
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:536
fn parser_meta_attr_next_index(state: &JetParserState) -> Int? Never! {
    if !parser_at_meta_attr(&state) -> return None
    depth := 0
    i := state.position + 2
    loop i < state.tokens.len() {
        kind :: parser_kind_at(&state, i - state.position)
        if kind == TOKEN_LPAREN { depth += 1 }
        else if kind == TOKEN_RPAREN {
            if depth == 0 -> return None
            depth -= 1
            if depth == 0 { i += 1; break }
        }
        i += 1
    }
    loop i < state.tokens.len() && parser_kind_at(&state, i - state.position) == TOKEN_SEMI -> i += 1
    if i < state.tokens.len() -> Val(i) else -> None
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:570
fn parser_at_persist_after_meta(state: &JetParserState) -> Bool Never! {
    index :: parser_meta_attr_next_index(&state) ?? return false
    offset :: index - state.position
    parser_kind_at(&state, offset) == TOKEN_HASH && parser_kind_at(&state, offset + 1) == TOKEN_IDENT && parser_lookahead(&state, offset + 1).payload.decoded == Syntax.MARKER_PERSIST
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:582
fn parser_at_comptime_marker_after_meta(state: &JetParserState) -> Bool Never! {
    index :: parser_meta_attr_next_index(&state) ?? return false
    offset :: index - state.position
    token :: parser_lookahead(&state, offset)
    if token.kind == TOKEN_IDENT && Syntax.is_comptime_name(token.payload.decoded) -> return true
    if token.kind != TOKEN_HASH || parser_kind_at(&state, offset + 1) != TOKEN_IDENT -> return false
    name :: parser_lookahead(&state, offset + 1).payload.decoded
    name == Syntax.RETIRED_MARKER_KNOWN || name == Syntax.MARKER_STATIC || name == Syntax.MARKER_INLINE || name == "static" || name == "inline"
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:612
fn parser_looks_like_layout_ctor(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_IDENT && (parser_kind_at(&state, 1) == TOKEN_COLON_COLON || parser_kind_at(&state, 1) == TOKEN_COLON_EQ) && parser_kind_at(&state, 2) == TOKEN_IDENT && parser_lookahead(&state, 2).payload.decoded == Syntax.LAYOUT_TYPE && (parser_kind_at(&state, 3) == TOKEN_LBRACE || (parser_kind_at(&state, 3) == TOKEN_DOT && parser_kind_at(&state, 4) == TOKEN_LBRACE))
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:624
fn parser_layout_ctor_binding(state: &JetParserState) -> Stmt Diagnostic! {
    name :: parser_expect_name(&state, "for the layout binding name")
    sigil :: parser_bump(&state)
    if sigil.kind == TOKEN_COLON_EQ {
        return Err(Diagnostic.error("E0003", "a `{Syntax.LAYOUT_TYPE}.{{ … }}` binding is immutable", "`{Syntax.LAYOUT_TYPE}` builds a solved layout handle once; mutate suggestions through `.suggest`, not the binding", "write `{name.payload.decoded} {Syntax.SIGIL_BIND_IMMUT} {Syntax.LAYOUT_TYPE}.{{ … }}`", Val(name.span)))
    }
    type_token :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_DOT -> parser_bump(&state)
    state.in_layout_body += 1
    literal :: typed_lit_body_for_head(&state, Type.Named{name: Syntax.LAYOUT_TYPE}, 0)
    state.in_layout_body -= 1
    elems :: if literal == {
        .Elements(elements) -> elements
        .Empty -> [Expr]{}
        else -> return Err(Diagnostic.error("E0003", "a `{Syntax.LAYOUT_TYPE}.{{ … }}` body is a comma-separated list of constraints", "write comparisons separated by commas, e.g. `label.width >= 80.0, input.left == label.right`", "write `{name.payload.decoded} {Syntax.SIGIL_BIND_IMMUT} {Syntax.LAYOUT_TYPE}.{{ constraint, … }}`", Val(name.span)))
    }
    body := [Stmt]{}
    loop expr in elems {
        stmt := Stmt.Expr{expr: expr}
        desugar_layout_anchors(name.payload.decoded, &stmt)
        &body.push(stmt)
    }
    Stmt.Layout{name: name.payload.decoded, name_span: name.span, body: body, span: Span{start: name.span.start, end: parser_previous_end(state).max(type_token.span.end)}}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:693
fn parser_retired_layout_keyword(state: &JetParserState) -> Stmt Diagnostic! {
    start :: parser_bump(&state).span
    hint := ""
    end := start.end
    if parser_current_kind(&state) == TOKEN_IDENT { token :: parser_bump(&state); hint = token.payload.decoded; end = token.span.end }
    if parser_current_kind(&state) == TOKEN_LBRACE -> end = parser_current(&state).span.end
    binding :: if hint.is_empty() -> "name" else -> hint
    Err(Diagnostic.error("E2935", "`{Syntax.FOREIGN_LAYOUT_KW}` is retired", "constraint layouts use typed-literal construction — `name {Syntax.SIGIL_BIND_IMMUT} {Syntax.LAYOUT_TYPE}.{{ … }}` (D-DOTCTOR3 element body of `Constraint`s)", "write `{binding} {Syntax.SIGIL_BIND_IMMUT} {Syntax.LAYOUT_TYPE}.{{ … }}`", Val(Span{start: start.start, end: end})))
}
