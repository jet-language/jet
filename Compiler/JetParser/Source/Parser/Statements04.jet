fn parser_retired_grant_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    marker :: state.parse_rule_marker()
    _ :: &state.rule_facts.pop()
    Err(Diagnostic.error("E0077", "the `#Grant` scope marker is retired", "`#FX` now narrows a block and binds an Authority handle when its head has a name", "write `#FX(grant: FS, Net) {{ ... }}`", Val(marker.span)))
}
