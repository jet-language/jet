// Rust: crates/jet-parser/src/Parser/Statements/control.rs:882
fn parser_statement_switch_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    if parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT {
        second :: parser_lookahead(&state, 1)
        if second.payload.decoded == Syntax.MARKER_OFF || second.payload.decoded == Syntax.MARKER_DEBUG_ONLY {
            parser_add_error_code(&state, "E0344", parser_cover(parser_current(&state).span, second.span), "only one switch-off attribute can be written on a statement", "`#{marker.name}` and `#{second.payload.decoded}` both control whether the same statement emits code", "keep one marker: `#{Syntax.MARKER_OFF} <statement>` or `#{Syntax.MARKER_DEBUG_ONLY} <statement>`")
        }
    }
    body_is_block :: parser_current_kind(&state) == TOKEN_LBRACE
    body := [Stmt]{}
    end := marker.span.end
    if body_is_block {
        block :: parser_parse_block(&state)
        body = block.statements
        end = block.span.end
    } else {
        statement :: parser_parse_statement(&state)
        end = stmt_span(statement).end
        &body.push(statement)
    }
    span :: Span{start: marker.span.start, end: end}
    state.bind_rule_fact(marker.name_span, Val(span), if body_is_block -> Policy.RuleSite.Block else -> Policy.RuleSite.Statement)
    Stmt.Switched{marker: marker, body: body, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1084
fn parser_impure_marker_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    start :: parser_current(&state).span
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    arguments :: state.bound_registered_rule_arguments(&marker)
    reason_expr :: arguments.parameter(0).cloned()
    reason := String?{None}
    if reason_expr == .Val(value) -> reason = parser_expr_literal_string(value)
    block :: parser_parse_block(&state)
    span :: parser_cover(start, block.span)
    state.bind_rule_fact(marker.name_span, Val(parser_cover(marker.span, block.span)), Policy.RuleSite.Block)
    Stmt.Impure{reason: reason, reason_expr: reason_expr, body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1114,1127,1150
fn parser_reactive_shield_region_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    if parser_lookahead(&state, 1).payload.decoded == Syntax.KW_SHIELD && parser_kind_at(&state, 2) == TOKEN_LPAREN {
        head :: state.read_marker_head()
        return Err(Diagnostic.error("E0430", "`#Shield` takes no arguments", "a shield region protects whatever runs inside it; there is nothing to configure", "write `#Shield {{ … }}`", Val(parser_cover(head.name_span, parser_current(&state).span))))
    }
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    region := NamedSpan?{None}
    if marker.name == Syntax.MARKER_REGION {
        arguments :: state.bound_registered_rule_arguments(&marker)
        value :: arguments.parameter(0) ?? return Err(Policy.marker_argument_shape_error(Syntax.MARKER_REGION, marker.span))
        if value == {
            .Ident(name, span) -> region = Val(NamedSpan{name: name, span: span})
            else -> return Err(Policy.marker_argument_shape_error(Syntax.MARKER_REGION, marker.span))
        }
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(marker.span, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    if region == .Val(named) -> return Stmt.Region{name: named.name, name_span: named.span, body: block.statements, span: span}
    if marker.name == Syntax.KW_SHIELD -> Stmt.Shield{body: block.statements, span: span}
    else -> Stmt.Reactive{body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1320
fn parser_fx_marker_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    if parser_kind_at(&state, 2) == TOKEN_LPAREN && parser_kind_at(&state, 3) == TOKEN_IDENT && parser_kind_at(&state, 4) == TOKEN_COLON {
        start :: parser_bump(&state).span
        marker_name :: parser_expect_name(&state, "`#{Syntax.KW_FX}`")
        parser_expect(&state, TOKEN_LPAREN, "after `#FX`")
        binding :: parser_expect_name(&state, "as the scoped Authority handle")
        parser_expect(&state, TOKEN_COLON, "after the scoped Authority handle")
        caps := [NamedSpan]{}
        args := [jet_foundation.MarkerCallArg]{}
        labels := [jet_foundation.CallLabel?]{}
        loop {
            cap :: parser_expect_effect_path_name(&state, "as an authority-bound effect")
            name :: strip_marker_enum_prefix(cap.name, "Effect")
            &caps.push(NamedSpan{name: name, span: cap.span})
            &args.push(jet_foundation.MarkerCallArg.Expr{value: Expr.Ident{value: name, span: cap.span}})
            &labels.push(None)
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            parser_expect(&state, TOKEN_COMMA, "between scoped effects")
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
        }
        caps_start :: if caps.len() == 0 -> binding.span.end else -> caps[0].span.start
        close :: parser_expect(&state, TOKEN_RPAREN, "to close `#FX`")
        marker :: Marker{name: Syntax.KW_FX, name_span: marker_name.span, negated: false, args: args, arg_labels: labels, span: parser_cover(start, close.span), ct: None}
        state.record_rule_fact(marker, None, Policy.RuleSite.Block)
        block :: parser_parse_block(&state)
        span :: parser_cover(start, block.span)
        state.bind_rule_fact(marker_name.span, Val(span), Policy.RuleSite.Block)
        return Stmt.AuthorityScope{caps: caps, caps_span: Span{start: caps_start, end: close.span.end}, binding: Val(NamedSpan{name: binding.payload.decoded, span: binding.span}), body: block.statements, span: span}
    }
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    arguments :: state.bound_registered_rule_arguments(&marker)
    caps := [NamedSpan]{}
    loop argument in arguments.variadic() {
        name :: marker_enum_path(&argument, "Effect") ?? return Err(Policy.marker_argument_shape_error(Syntax.KW_FX, expr_span(argument)))
        &caps.push(NamedSpan{name: name, span: expr_span(argument)})
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(marker.span, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    Stmt.AuthorityScope{caps: caps, caps_span: Span{start: marker.name_span.end, end: marker.span.end}, binding: None, body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1434
fn parser_transact_marker_stmt(state: &JetParserState) -> Stmt Diagnostic! {
    start :: parser_bump(&state).span
    marker_name :: parser_bump(&state).span
    binding := NamedSpan?{None}
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        named :: parser_expect_name(&state, "for the transaction handle name")
        parser_expect(&state, TOKEN_RPAREN, "to close `#{Syntax.KW_TRANSACT}(name`")
        binding = Val(NamedSpan{name: named.payload.decoded, span: named.span})
        marker :: Marker{name: Syntax.KW_TRANSACT, name_span: marker_name, negated: false, args: [jet_foundation.MarkerCallArg.Expr{value: Expr.Ident{value: named.payload.decoded, span: named.span}}], arg_labels: [None], span: Span{start: start.start, end: parser_previous_end(state)}, ct: None}
        state.record_rule_fact(marker, None, Policy.RuleSite.Block)
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(start, block.span)
    if binding != None -> state.bind_rule_fact(marker_name, Val(span), Policy.RuleSite.Block)
    name := String?{None}
    name_span := Span?{None}
    if binding == .Val(value) { name = Val(value.name); name_span = Val(value.span) }
    Stmt.Transact{name: name, name_span: name_span, body: block.statements, implicit: false, span: span}
}

// Rust: crates/jet-parser/src/Parser/Statements/control.rs:733
fn parser_retired_uninit_marker(state: &JetParserState) -> Stmt Diagnostic! {
    head :: state.read_marker_head()
    end := head.name_span.end
    name := ""
    if parser_current_kind(&state) == TOKEN_IDENT {
        token :: parser_current(&state)
        name = token.payload.decoded
        end = token.span.end
    }
    fix :: if name.is_empty() -> "write `name {Syntax.SIGIL_BIND_MUT} Type{{ {Syntax.KW_UNINIT} }}`"
        else -> "write `{name} {Syntax.SIGIL_BIND_MUT} <Type>.{{ {Syntax.KW_UNINIT} }}`"
    Err(Diagnostic.error("E0426", "`#{Syntax.MARKER_UNINIT}` is retired", "uninitialized storage is a fact about the value — it now reads `name {Syntax.SIGIL_BIND_MUT} Type{{ {Syntax.KW_UNINIT} }}`", fix, Val(Span{start: head.span.start, end: end})))
}
