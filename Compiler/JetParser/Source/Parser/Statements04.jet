fn parser_live_or_nondeterministic_statement(state: &JetParserState) -> Stmt Diagnostic! {
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    reason_expr := Expr?{None}
    reason := ""
    if marker.name == Syntax.MARKER_NONDETERMINISTIC {
        arguments :: state.bound_registered_rule_arguments(&marker)
        value :: arguments.parameter(0).cloned() ?? panic("bound reason argument")
        reason = parser_expr_literal_string(value) ?? ""
        reason_expr = Val(value)
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(marker.span, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    if marker.name == Syntax.MARKER_LIVE -> Stmt.Live{body: block.statements, span: span}
    else -> Stmt.AssumeDet{reason: reason, reason_expr: reason_expr ?? panic("bound reason argument"), body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1220
fn parser_context_marker_statement(state: &JetParserState) -> Stmt Diagnostic! {
    field :: parser_lookahead(&state, 3)
    equal :: parser_lookahead(&state, 4)
    if field.kind == TOKEN_IDENT && equal.kind == TOKEN_EQ -> return Err(Diagnostic.error("E0760", "context fields are set with `:`, not `=`", "`=` is reassignment (S17); the `name: value` form sets a context field", "write `#{Syntax.CTX_BLOCK}({field.payload.decoded}: …) {{ … }}`", Val(equal.span)))
    marker :: state.parse_registered_marker_at_site(Policy.RuleSite.Block)
    loop label in marker.arg_labels {
        if label == .Val(named) {
            if named.name != Syntax.CTX_FIELD_ALLOCATOR && named.name != Syntax.CTX_FIELD_LOGGER && named.name != Syntax.CTX_FIELD_DEADLINE -> return Err(parser_context_unknown_field(named))
        }
    }
    arguments :: state.bound_registered_rule_arguments(&marker)
    indices := [Int?]{}
    loop i in 0..<marker.args.len() -> &indices.push(arguments.parameter_for_source(i))
    values :: marker.expr_args_owned()
    fields := [(String, Expr, Span)]{}
    loop i in 0..<values.len() {
        value :: values[i]
        label :: marker.arg_labels[i] ?? {
            index :: indices[i] ?? panic("normalized context argument")
            rule :: Policy.applied_rule(Syntax.CTX_BLOCK) ?? panic("normalized context argument")
            NamedSpan{name: rule.signature.params[index].name, span: expr_span(value)}
        }
        if label.name != Syntax.CTX_FIELD_ALLOCATOR && label.name != Syntax.CTX_FIELD_LOGGER && label.name != Syntax.CTX_FIELD_DEADLINE -> return Err(parser_context_unknown_field(label))
        &fields.push((label.name, value, Span{start: label.span.start, end: expr_span(value).end}))
    }
    block :: parser_parse_block(&state)
    span :: parser_cover(marker.span, block.span)
    state.bind_rule_fact(marker.name_span, Val(span), Policy.RuleSite.Block)
    Stmt.ContextBlock{fields: fields, body: block.statements, span: span}
}
// Rust: crates/jet-parser/src/Parser/Statements/control.rs:1240,1280
fn parser_context_unknown_field(field: NamedSpan) -> Diagnostic Never! {
    Diagnostic.error("E0761", "`{field.name}` isn't a context field", "the context bundle holds `allocator`, `logger`, and `deadline`", "write `#{Syntax.CTX_BLOCK}(allocator: …)`, `#{Syntax.CTX_BLOCK}(logger: …)`, or `#{Syntax.CTX_BLOCK}(deadline: …)`", Val(field.span))
}
