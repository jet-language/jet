// Colon declarations: every declaration is written
// `name: value`, so a function is `area: fn(r: Float) -> Float { … }`, a type
// `Point: struct { … }` and a module `math: module { … }`. The item parsers
// read one head order, keyword first. This token pre-pass maps each colon head
// onto that order before they run, so a colon head builds exactly the node the
// keyword head builds, and sema never sees which spelling the source used.
//
// A head `name: kw` becomes `kw name`. The keyword token moves before the name
// with a zero-width span at the name's start, the names keep their tokens, and
// the `:` stays in place as trivia, so token spans still ascend.
//
// Which `name: fn(…)` is a function depends on the brace it sits in, which the
// pass tracks as one frame per open delimiter:
// - At file scope and in module, impl, trait, derive, extern, tag and effect
//   bodies, it is always a function or a required signature. At file and
//   module scope the item parser reads an unmarked one without a body as a
//   function type (parser_function_type_alias).
// - In struct and enum bodies, it is a method only when a body follows (`{`,
//   or the `-> value` arrow after the result). Without a body it is a field of
//   function type.
// - In a function body or any other code block, it stays a local function
//   value. The item block of a build's
//   `b.generate("name") { … }` holds the generated file's items, so it reads as
//   a module body.
//
// A module instance has no keyword either: `int_cache: cache<Int>(32)`. At
// file scope and in module bodies, a binding whose right-hand side is only a
// module path with optional `<types>` and `(values)` is an instance when the
// path names a module, template or instance this file declares, or when it
// carries `<types>` and names nothing else this file declares (a template
// imported with `use`). The pass writes the keyword back in front of its
// name, so it parses as `module int_cache: cache<Int>(32)` did.
//
// A keyword written before the name (`fn name`, `struct Name`, `module name`)
// starts no declaration outside function bodies: the pass reads that keyword
// as a plain word, so the parser meets it as any other word there. A local
// `fn name` in a body stays a local function.
use {
    jet_foundation.[Span, name_empty, name_index]
    jet_lexer.[
        TOKEN_BANG,
        TOKEN_BLOCK_COMMENT,
        TOKEN_COLON,
        TOKEN_DOLLAR,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_KW_COMPTIME,
        TOKEN_KW_CONST,
        TOKEN_KW_COPY,
        TOKEN_KW_DERIVE,
        TOKEN_KW_EFFECT,
        TOKEN_KW_ELSE,
        TOKEN_KW_ENUM,
        TOKEN_KW_EXTERN,
        TOKEN_KW_FN,
        TOKEN_KW_IF,
        TOKEN_KW_IMPL,
        TOKEN_KW_IN,
        TOKEN_KW_IT,
        TOKEN_KW_LOOP,
        TOKEN_KW_MODULE,
        TOKEN_KW_MOVE,
        TOKEN_KW_MUTATE,
        TOKEN_KW_PRIV,
        TOKEN_KW_PUB,
        TOKEN_KW_STRUCT,
        TOKEN_KW_TAG,
        TOKEN_KW_TRAIT,
        TOKEN_KW_YIELD,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LINE_COMMENT,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_MINUS,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SEMI,
        TOKEN_SHR,
        TOKEN_UNIFIED_ARROW,
        Token,
        TokenTables,
        token_decoded,
    ]
}

// The frame an open delimiter starts. A group is `(…)` or `[…]`, where no
// declaration starts. A container body holds declarations; a shape body holds
// fields, variants and methods; code holds statements.
PARSER_COLON_FRAME_GROUP: 0
PARSER_COLON_FRAME_CONTAINER: 1
PARSER_COLON_FRAME_SHAPE: 2
PARSER_COLON_FRAME_CODE: 3
// File scope or a module body: a container where a module instance may sit.
PARSER_COLON_FRAME_MODULE: 4

parser_colon_is_trivia: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

// The next code token at or after `from`, or `tokens.len()`.
parser_colon_code_at: fn(tokens: [Token], from: Int) -> Int Never! {
    index := from
    loop index < tokens.len() && parser_colon_is_trivia(tokens[index].kind) -> index += 1
    index
}

// A word that may name a declaration: an identifier or a keyword that also
// spells a member name (`tag`, `copy`, `effect`, …).
parser_colon_word: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_IDENT || kind == TOKEN_KW_TAG || kind == TOKEN_KW_EFFECT || kind == TOKEN_KW_COPY || kind == TOKEN_KW_MOVE || kind == TOKEN_KW_MUTATE || kind == TOKEN_KW_IT || kind == TOKEN_KW_CONST || kind == TOKEN_KW_DERIVE || kind == TOKEN_KW_YIELD || kind == TOKEN_KW_IN || kind == TOKEN_KW_EXTERN
}

// The declaration keywords a colon head may carry.
parser_colon_head_keyword: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_TAG || kind == TOKEN_KW_EFFECT
}

// The head kind of a `comptime loop` or `comptime if` statement.
PARSER_COLON_HEAD_COMPTIME_BLOCK: -2

// The frame a declaration's body brace opens, by the declaration's keyword.
// A `comptime loop` or `comptime if` among declarations generates
// declarations, so its bodies keep the enclosing frame.
parser_colon_body_frame: fn(head: Int, frame: Int) -> Int Never! {
    if head == TOKEN_KW_STRUCT || head == TOKEN_KW_ENUM -> return PARSER_COLON_FRAME_SHAPE
    if head == TOKEN_KW_MODULE -> return PARSER_COLON_FRAME_MODULE
    if head == TOKEN_KW_IMPL || head == TOKEN_KW_TRAIT || head == TOKEN_KW_DERIVE || head == TOKEN_KW_EXTERN || head == TOKEN_KW_TAG || head == TOKEN_KW_EFFECT -> return PARSER_COLON_FRAME_CONTAINER
    if head == PARSER_COLON_HEAD_COMPTIME_BLOCK && (frame == PARSER_COLON_FRAME_MODULE || frame == PARSER_COLON_FRAME_CONTAINER) -> return frame
    PARSER_COLON_FRAME_CODE
}

// Whether the group opening at `open` holds the arguments of a `.generate(…)`
// call, whose trailing brace is an item block.
parser_colon_generate_call: fn(tokens: [Token], tables: TokenTables, open: Int) -> Bool Never! {
    name: open - 1
    name >= 1 && tokens[name].kind == TOKEN_IDENT && tokens[name - 1].kind == TOKEN_DOT && token_decoded(tables, tokens[name]) == "generate"
}

// One past a balanced `(…)` or `[…]` group opening at `open`.
parser_colon_skip_group: fn(tokens: [Token], open: Int) -> Int Never! {
    depth := 0
    index := open
    loop index < tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET -> depth += 1
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET {
            depth -= 1
            if depth == 0 -> return index + 1
        }
        if kind == TOKEN_EOF -> return index
        index += 1
    }
    index
}

// The head of the statement starting at `start`: past `pub`, `pub(…)`,
// `priv`, `priv(…)`, `comptime` and `#Marker(…)` / `#[…]` markers written on
// the declaration's line. A `pub:` / `priv:` section label (E0415) is passed
// over too, so the declaration after it keeps its head.
parser_colon_head_at: fn(tokens: [Token], start: Int) -> Int Never! {
    index := parser_colon_code_at(tokens, start)
    loop index < tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV {
            index = parser_colon_code_at(tokens, index + 1)
            if index < tokens.len() && tokens[index].kind == TOKEN_LPAREN -> index = parser_colon_code_at(tokens, parser_colon_skip_group(tokens, index))
            if index < tokens.len() && tokens[index].kind == TOKEN_COLON -> index = parser_colon_code_at(tokens, index + 1)
            next
        }
        if kind == TOKEN_KW_COMPTIME {
            index = parser_colon_code_at(tokens, index + 1)
            next
        }
        if kind != TOKEN_HASH -> return index
        index = parser_colon_code_at(tokens, index + 1)
        if index < tokens.len() && tokens[index].kind == TOKEN_BANG -> index = parser_colon_code_at(tokens, index + 1)
        if index < tokens.len() && tokens[index].kind == TOKEN_LBRACKET {
            index = parser_colon_code_at(tokens, parser_colon_skip_group(tokens, index))
            next
        }
        if index >= tokens.len() || tokens[index].kind != TOKEN_IDENT -> return index
        index = parser_colon_code_at(tokens, index + 1)
        loop index < tokens.len() && tokens[index].kind == TOKEN_DOT {
            segment: parser_colon_code_at(tokens, index + 1)
            if segment >= tokens.len() || tokens[segment].kind != TOKEN_IDENT -> break
            index = parser_colon_code_at(tokens, segment + 1)
        }
        // `#X: value` is an in-body marker line, not a marker before a head.
        if index < tokens.len() && tokens[index].kind == TOKEN_COLON -> return index
        if index < tokens.len() && tokens[index].kind == TOKEN_LPAREN -> index = parser_colon_code_at(tokens, parser_colon_skip_group(tokens, index))
    }
    index
}

// The `:` of a colon head whose name path starts at `head`, or -1. The path
// is `name(.name)*`, a `$name` template name, or a dashed module name
// (`web-app`), which only a `module` head may carry.
parser_colon_head_colon: fn(tokens: [Token], head: Int) -> Int Never! {
    index := head
    if index < tokens.len() && tokens[index].kind == TOKEN_DOLLAR -> index = parser_colon_code_at(tokens, index + 1)
    if index >= tokens.len() || !parser_colon_word(tokens[index].kind) -> return -1
    dashed := false
    index = parser_colon_code_at(tokens, index + 1)
    loop index < tokens.len() {
        kind: tokens[index].kind
        if kind != TOKEN_DOT && kind != TOKEN_MINUS -> break
        word: parser_colon_code_at(tokens, index + 1)
        if word >= tokens.len() || !parser_colon_word(tokens[word].kind) -> return -1
        if kind == TOKEN_MINUS -> dashed = true
        index = parser_colon_code_at(tokens, word + 1)
    }
    if index >= tokens.len() || tokens[index].kind != TOKEN_COLON -> return -1
    keyword: parser_colon_code_at(tokens, index + 1)
    if keyword >= tokens.len() || !parser_colon_head_keyword(tokens[keyword].kind) -> return -1
    if dashed && tokens[keyword].kind != TOKEN_KW_MODULE -> return -1
    index
}

// Whether the `fn` signature at `keyword` has a body before its line ends:
// a `{` outside its groups, or an arrow past the result's (the arrow body).
// Each `fn` type in the signature brings an arrow of its own, and a `pub` or
// `priv` starts the next member of a one-line body.
parser_colon_fn_has_body: fn(tokens: [Token], keyword: Int) -> Bool Never! {
    depth := 0
    arrows := 0
    types := 0
    index := keyword + 1
    loop index < tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_EOF -> return false
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET {
            depth += 1
        } else if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET {
            depth -= 1
        } else if depth == 0 {
            if kind == TOKEN_LBRACE -> return true
            if kind == TOKEN_SEMI || kind == TOKEN_RBRACE || kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV -> return false
            if kind == TOKEN_KW_FN -> types += 1
            if kind == TOKEN_UNIFIED_ARROW {
                arrows += 1
                if arrows == types + 2 -> return true
            }
        }
        index += 1
    }
    false
}

// Moves the keyword at `keyword` before the name path at `head`. The path,
// the `:` (now trivia) and any trivia before the keyword each shift one slot
// right, and the keyword takes the name's start as a zero-width span.
parser_colon_rotate: fn(tokens: &[Token], head: Int, keyword: Int, colon: Int) Never! {
    moved: tokens[keyword]
    index := keyword
    loop index > head {
        tokens[index] = tokens[index - 1]
        index -= 1
    }
    tokens[colon + 1].kind = TOKEN_BLOCK_COMMENT
    at: tokens[head + 1].span.start
    tokens[head] = Token{kind: moved.kind, span: Span{start: at, end: at}, text: moved.text, decoded: moved.decoded, literal: moved.literal}
}

// A binding `name: target[-part…][<…>][(…)]` that ends its statement, read
// at `head`: a module instance when its target names a module this file
// declares, whatever the casing. Read from `<types>` alone, module names are
// snake case, so a capitalized name or target (a type alias
// `Lookup: Map<String, Int>`, a constant `LIMIT: limit<Int>()`) is not one.
ParserColonInstance: struct {
    head: Int
    name: Int
    target: Int
    typed: Bool
    snake: Bool
}

// Whether `token` spells a snake-case name.
parser_colon_snake: fn(tables: TokenTables, token: Token) -> Bool Never! {
    bytes: token_decoded(tables, token).bytes()
    bytes.len() > 0 && ((bytes[0] >= 97 && bytes[0] <= 122) || bytes[0] == 95)
}

parser_colon_instance_at: fn(tokens: [Token], tables: TokenTables, head: Int) -> ParserColonInstance? Never! {
    if head >= tokens.len() || tokens[head].kind != TOKEN_IDENT -> return None
    colon: parser_colon_code_at(tokens, head + 1)
    if colon >= tokens.len() || tokens[colon].kind != TOKEN_COLON -> return None
    target: parser_colon_code_at(tokens, colon + 1)
    if target >= tokens.len() || tokens[target].kind != TOKEN_IDENT -> return None
    index := parser_colon_code_at(tokens, target + 1)
    loop index < tokens.len() && tokens[index].kind == TOKEN_MINUS {
        word: parser_colon_code_at(tokens, index + 1)
        if word >= tokens.len() || tokens[word].kind != TOKEN_IDENT -> return None
        index = parser_colon_code_at(tokens, word + 1)
    }
    typed := false
    if index < tokens.len() && tokens[index].kind == TOKEN_LT {
        typed = true
        depth := 0
        loop index < tokens.len() {
            kind: tokens[index].kind
            if kind == TOKEN_LT -> depth += 1
            if kind == TOKEN_GT -> depth -= 1
            if kind == TOKEN_SHR -> depth -= 2
            if kind == TOKEN_SEMI || kind == TOKEN_LBRACE || kind == TOKEN_RBRACE || kind == TOKEN_EOF -> return None
            if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET {
                index = parser_colon_skip_group(tokens, index)
                next
            }
            index += 1
            if depth <= 0 -> break
        }
        if depth != 0 -> return None
        index = parser_colon_code_at(tokens, index)
    }
    if index < tokens.len() && tokens[index].kind == TOKEN_LPAREN -> index = parser_colon_code_at(tokens, parser_colon_skip_group(tokens, index))
    if index < tokens.len() && tokens[index].kind != TOKEN_SEMI && tokens[index].kind != TOKEN_RBRACE && tokens[index].kind != TOKEN_EOF -> return None
    Val(ParserColonInstance{head: head, name: name_index(tokens[head].text), target: name_index(tokens[target].text), typed: typed, snake: parser_colon_snake(tables, tokens[head]) && parser_colon_snake(tables, tokens[target])})
}

// The name a keyword head at `head` declares, or -1.
parser_colon_declared_name: fn(tokens: [Token], head: Int) -> Int Never! {
    if head >= tokens.len() || !parser_colon_head_keyword(tokens[head].kind) -> return -1
    word: parser_colon_code_at(tokens, head + 1)
    if word >= tokens.len() || !parser_colon_word(tokens[word].kind) -> return -1
    name_index(tokens[word].text)
}

// Writes `module` in front of each binding that names a module (see the file
// comment). A binding naming an instance is one too, so the choice runs to a
// fixed point over the file's candidates.
parser_colon_mark_instances: fn(tokens: &&[Token], candidates: [ParserColonInstance], declared_modules: [Int:Bool], others: [Int:Bool]) -> [Token] Never! {
    modules := declared_modules
    chosen := [Bool]{}
    loop _ in candidates -> chosen.push(false)
    any := false
    changed := true
    loop changed {
        changed = false
        loop index in 0..<candidates.len() {
            if chosen[index] -> next
            candidate: candidates[index]
            if modules.get(candidate.target) != None || (candidate.typed && candidate.snake && others.get(candidate.target) == None) {
                chosen[index] = true
                modules[candidate.name] = true
                changed = true
                any = true
            }
        }
    }
    if !any -> return tokens.move()
    marked := [Token]{}
    next_candidate := 0
    loop index in 0..<tokens.len() {
        loop next_candidate < candidates.len() && candidates[next_candidate].head < index -> next_candidate += 1
        if next_candidate < candidates.len() && candidates[next_candidate].head == index && chosen[next_candidate] {
            at: tokens[index].span.start
            marked.push(Token{kind: TOKEN_KW_MODULE, span: Span{start: at, end: at}, text: name_empty(), decoded: name_empty(), literal: -1})
        }
        marked.push(tokens[index])
    }
    marked
}

// Whether `head` holds a keyword written before the declared name (`fn name`,
// `struct Name`, `module a-b`): no declaration head outside function bodies,
// where a local `fn name` stays a local function.
parser_colon_keyword_first: fn(tokens: [Token], head: Int, frame: Int) -> Bool Never! {
    if head >= tokens.len() || frame == PARSER_COLON_FRAME_GROUP -> return false
    kind: tokens[head].kind
    if !parser_colon_head_keyword(kind) -> return false
    if kind == TOKEN_KW_FN && frame == PARSER_COLON_FRAME_CODE -> return false
    word := parser_colon_code_at(tokens, head + 1)
    if word < tokens.len() && tokens[word].kind == TOKEN_DOLLAR -> word = parser_colon_code_at(tokens, word + 1)
    word < tokens.len() && parser_colon_word(tokens[word].kind)
}

// The frames whose members may share a line: file scope and module,
// container and shape bodies.
parser_colon_member_frame: fn(frame: Int) -> Bool Never! {
    frame == PARSER_COLON_FRAME_MODULE || frame == PARSER_COLON_FRAME_CONTAINER || frame == PARSER_COLON_FRAME_SHAPE
}

// Whether a member starts at `index` with no separator before it, as in the
// one-line bodies `{ step: Int fn step(self) {} }` and
// `{ step: Int step: fn(self) {} }`: a `pub` or `priv`, or a declaration head
// right after the last token of a type (`previous`). A `name: fn`-style head
// starts a member after any other token too: a line the lexer continued
// (`use math.*` before `run: fn() {`) still ends before it.
parser_colon_member_break: fn(tokens: [Token], index: Int, previous: Int) -> Bool Never! {
    kind: tokens[index].kind
    if kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV -> return true
    if previous < 0 -> return false
    before: tokens[previous].kind
    if before != TOKEN_IDENT && before != TOKEN_RPAREN && before != TOKEN_RBRACKET && before != TOKEN_GT {
        if kind != TOKEN_IDENT || before == TOKEN_DOT || before == TOKEN_COLON -> return false
        colon: parser_colon_head_colon(tokens, index)
        if colon < 0 -> return false
        keyword: parser_colon_code_at(tokens, colon + 1)
        return keyword < tokens.len() && parser_colon_head_keyword(tokens[keyword].kind)
    }
    if kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_MODULE {
        word: parser_colon_code_at(tokens, index + 1)
        return word < tokens.len() && parser_colon_word(tokens[word].kind)
    }
    kind == TOKEN_IDENT && parser_colon_head_colon(tokens, index) >= 0
}

// `tables` spells the tokens' names.
parser_colon_declarations: fn(input: &&[Token], tables: TokenTables) -> [Token] Never! {
    tokens := input.move()
    // Per open delimiter: its frame, and the enclosing statement's head
    // kind and whether that statement had opened its body.
    frames := [Int]{}
    saved_heads := [Int]{}
    saved_opened := [Bool]{}
    frame := PARSER_COLON_FRAME_MODULE
    // The current statement's head kind (-1 before it is read) and whether
    // its first `{` has opened.
    head_kind := -1
    opened := false
    at_start := true
    // Module instance candidates, and the names this file declares as
    // modules and as anything else.
    candidates := [ParserColonInstance]{}
    modules := [Int:Bool]{}
    others := [Int:Bool]{}
    index := 0
    // The last code token before `index`, or -1.
    previous := -1
    // The last token of the latest head: a rotated head reads `fn name`
    // there, which is no new member. A marker's arguments hold heads of
    // their own before it, so this only grows.
    head_end := -1
    // The open delimiters' indices, and that of the group closed last.
    opens := [Int]{}
    closed := -1
    loop index < tokens.len() {
        if parser_colon_is_trivia(tokens[index].kind) {
            index += 1
            next
        }
        if !at_start && index > head_end && parser_colon_member_frame(frame) && parser_colon_member_break(tokens, index, previous) -> at_start = true
        if at_start && frame != PARSER_COLON_FRAME_GROUP {
            at_start = false
            head: parser_colon_head_at(tokens, index)
            colon: parser_colon_head_colon(tokens, head)
            if colon >= 0 {
                keyword: parser_colon_code_at(tokens, colon + 1)
                rotate: if {
                    tokens[keyword].kind != TOKEN_KW_FN -> true
                    frame == PARSER_COLON_FRAME_CONTAINER || frame == PARSER_COLON_FRAME_MODULE -> true
                    frame == PARSER_COLON_FRAME_SHAPE -> parser_colon_fn_has_body(tokens, keyword)
                    else -> false
                }
                if rotate -> parser_colon_rotate(tokens, head, keyword, colon)
                if keyword > head_end -> head_end = keyword
            } else {
                if head > head_end -> head_end = head
                if parser_colon_keyword_first(tokens, head, frame) -> tokens[head].kind = TOKEN_IDENT
                if frame == PARSER_COLON_FRAME_MODULE {
                    if parser_colon_instance_at(tokens, tables, head) == .Val(candidate) -> candidates.push(candidate)
                }
            }
            declared: parser_colon_declared_name(tokens, head)
            if declared >= 0 {
                if tokens[head].kind == TOKEN_KW_MODULE -> modules[declared] = true else -> others[declared] = true
            }
            head_kind = if head < tokens.len() -> tokens[head].kind else -> -1
            if head_kind == TOKEN_KW_LOOP || head_kind == TOKEN_KW_IF {
                loop at in index..<head {
                    if tokens[at].kind == TOKEN_KW_COMPTIME -> head_kind = PARSER_COLON_HEAD_COMPTIME_BLOCK
                }
            }
            opened = false
        }
        current: tokens[index].kind
        if current == TOKEN_LPAREN || current == TOKEN_LBRACKET || current == TOKEN_LBRACE {
            frames.push(frame)
            opens.push(index)
            saved_heads.push(head_kind)
            saved_opened.push(opened)
            if current == TOKEN_LBRACE {
                body: frame != PARSER_COLON_FRAME_GROUP && (!opened || head_kind == PARSER_COLON_HEAD_COMPTIME_BLOCK)
                frame = if body -> parser_colon_body_frame(head_kind, frame) else -> PARSER_COLON_FRAME_CODE
                if previous >= 0 && tokens[previous].kind == TOKEN_RPAREN && parser_colon_generate_call(tokens, tables, closed) -> frame = PARSER_COLON_FRAME_MODULE
                saved_opened[saved_opened.len() - 1] = true
                at_start = true
            } else {
                frame = PARSER_COLON_FRAME_GROUP
            }
            head_kind = -1
            opened = false
        } else if current == TOKEN_RPAREN || current == TOKEN_RBRACKET || current == TOKEN_RBRACE {
            if frames.len() > 0 {
                frame = frames.pop() ?? PARSER_COLON_FRAME_MODULE
                head_kind = saved_heads.pop() ?? -1
                opened = saved_opened.pop() ?? false
            }
            closed = opens.pop() ?? -1
            // A member's body brace ends the member, so a one-line body's
            // next member (`{ get: fn(self) -> Int { 1 } put: fn… }`) starts
            // here; an `else` goes on with a `comptime if`.
            if current == TOKEN_RBRACE && parser_colon_member_frame(frame) {
                after: parser_colon_code_at(tokens, index + 1)
                if after >= tokens.len() || tokens[after].kind != TOKEN_KW_ELSE -> at_start = true
            }
        } else if current == TOKEN_SEMI && frame != PARSER_COLON_FRAME_GROUP {
            at_start = true
            head_kind = -1
            opened = false
        }
        previous = index
        index += 1
    }
    if candidates.len() == 0 -> return tokens.move()
    parser_colon_mark_instances(tokens, candidates, modules, others)
}
