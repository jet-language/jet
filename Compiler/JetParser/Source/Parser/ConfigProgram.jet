// The config-value program of the first-party compiler service (JetFoundation
// CompilerService.jet). Both requesters build it here: `jet` in-process
// (JetCLI ConfigEval.jet) and `jetpack` before asking the sibling `jet`
// (EnvModel CompilerService.jet). It lives beside the parser because a config
// expression's source text is found on its lexed tokens.
use {
    jet_foundation.[
        CallArg,
        ComptimeEvalError,
        ComptimeNameSite,
        CtValue,
        Expr,
        Func,
        Item,
        JET_CONFIG_VALUE_NAME,
        NameTable,
        NamedCtValue,
        Span,
        comptime_walk_identifiers,
        expr_span,
        jet_config_eval_diagnostic,
        jet_config_eval_error,
        jet_config_literal,
        name_find,
        name_index,
        name_intern,
        name_table_sized,
    ]
    jet_lexer.[
        STRING_PART_INTERPOLATION,
        TOKEN_IDENT,
        TOKEN_LPAREN,
        TOKEN_RPAREN,
        TOKEN_STRING,
        Token,
        TokenTables,
        lex_config,
        token_decoded,
        token_string_parts,
    ]
}

// The typed program for one config value. Each global the expression reads
// becomes one ALL_CAPS module constant, and each read is respelled to it.
jet_config_program: fn(expr: Expr, source: String, funcs: [String:Func], globals: [String:CtValue]) -> String ComptimeEvalError! {
    bytes: source.bytes()
    span: jet_config_value_extent(expr, lex_config(bytes).tokens) ?? return Err(jet_config_eval_error(expr, "this config value has no source text to evaluate"))
    if span.start < 0 || span.end > bytes.len() || span.start > span.end {
        return Err(jet_config_eval_error(expr, "this config value has no source text to evaluate"))
    }
    sites := [ComptimeNameSite]{}
    loop site in comptime_walk_identifiers(expr) {
        if globals.get(site.name) == None -> next
        if site.span.start < span.start || site.span.end > span.end {
            return Err(jet_config_eval_error(expr, "`{site.name}` is read outside this config value's source text"))
        }
        index := sites.len()
        loop index > 0 && sites[index - 1].span.start > site.span.start -> index -= 1
        sites.insert(index, site)
    }
    // Per global read, by id in a table of their names: the number of the
    // constant it became, or -1 before its first read.
    globals_read := name_table_sized(16)
    constant_of := [Int]{}
    constants := 0
    lines := [String]{}
    loop name in funcs.keys() {
        if funcs[name].span.start < 0 || funcs[name].span.end > bytes.len() -> next
        lines.push(String.from_bytes(bytes.slice(funcs[name].span.start, funcs[name].span.end)) ?? return Err(jet_config_eval_error(expr, "the function `{name}` is not valid text")))
    }
    text := [String]{}
    cursor := span.start
    loop site in sites {
        if site.span.start < cursor -> next
        read: name_index(name_intern(globals_read, site.name))
        loop constant_of.len() <= read -> constant_of.push(-1)
        if constant_of[read] < 0 {
            constant_of[read] = constants
            constants += 1
            value: globals[site.name]
            literal: jet_config_literal(value) ?? return Err(jet_config_eval_error(expr, "`{site.name}` holds a value this config value can't read as literal data"))
            lines.push("JET_CONFIG_GLOBAL_{constant_of[read]}: {literal}")
        }
        constant: "JET_CONFIG_GLOBAL_{constant_of[read]}"
        text.push(String.from_bytes(bytes.slice(cursor, site.span.start)) ?? "")
        text.push(constant)
        cursor = site.span.end
    }
    text.push(String.from_bytes(bytes.slice(cursor, span.end)) ?? "")
    body: text.join("")
    lines.push("{JET_CONFIG_VALUE_NAME}: #run {{ {body} }}")
    lines.push("")
    Ok(lines.join("\n"))
}

// A config expression's whole source text, first byte to last. `expr_span`
// is the diagnostic anchor: a call's is its callee name, and a binary
// expression's covers its operands' anchors, so `double(PORT)` or
// `1 + missing()` would lose the argument list. A call runs to its closing
// `)`, found on the lexed tokens so that a string, a comment or a nested call
// never stands in for it. None when the tokens hold no closing `)`.
jet_config_value_extent: fn(expr: Expr, tokens: [Token]) -> Span? Never! {
    Val(Span{start: jet_config_value_start(expr), end: jet_config_value_end(expr, tokens) ?? return None})
}

// The first byte: the leftmost operand, receiver or base of a postfix or
// infix form, else the expression's own span.
jet_config_value_start: fn(expr: Expr) -> Int Never! {
    own: expr_span(expr).start
    start: if expr == {
        .Binary(_, left, _, _, _) -> jet_config_value_start(left)
        .CompareChain(operands, _, _, _, _) -> if operands.len() > 0 -> jet_config_value_start(operands[0]) else -> own
        .Range(first, _, _, _, _) -> jet_config_value_start(first)
        .Index(base, _, _, _, _) -> jet_config_value_start(base)
        .Slice(base, _, _, _, _, _) -> jet_config_value_start(base)
        .Try(value, _, _, _, _) -> jet_config_value_start(value)
        .OrFallback(value, _, _, _, _) -> jet_config_value_start(value)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) -> jet_config_value_start(base)
        .MethodCall(receiver, _, _, _, _, _, _) | .OptMethodCall(receiver, _, _, _, _, _, _) -> jet_config_value_start(receiver)
        .CallValue(callee, _, _, _) -> jet_config_value_start(callee)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> own
    }
    if start < own -> start else -> own
}

// The end of the last byte: a call's closing `)`, the rightmost operand of a
// prefix or infix form, else the expression's own span.
jet_config_value_end: fn(expr: Expr, tokens: [Token]) -> Int? Never! {
    own: expr_span(expr).end
    end: if expr == {
        .Call(call, _) -> jet_config_call_close(call.name_span.end, call.args, tokens) ?? return None
        .MethodCall(_, _, method_span, _, _, args, _) -> jet_config_call_close(method_span.end, args, tokens) ?? return None
        .OptMethodCall(_, _, method_span, _, args, _, _) -> jet_config_call_close(method_span.end, args, tokens) ?? return None
        .Binary(_, _, right, _, _) -> jet_config_value_end(right, tokens) ?? return None
        .CompareChain(operands, _, _, _, _) -> if operands.len() > 0 -> (jet_config_value_end(operands[operands.len() - 1], tokens) ?? return None) else -> own
        .Range(_, last, _, _, _) -> jet_config_value_end(last, tokens) ?? return None
        .Unary(_, operand, _, _) -> jet_config_value_end(operand, tokens) ?? return None
        .Spread(value, _, _) | .Deref(value, _, _) | .RawOf(value, _, _) | .Copy(value, _, _) -> jet_config_value_end(value, tokens) ?? return None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> own
    }
    Val(if end > own -> end else -> own)
}

// The end of a call's closing `)`. With arguments the walk starts after the
// last argument, inside the parentheses (depth 1); without, after the callee,
// where the next `(` opens them (depth 0). Tokens before `from` are skipped by
// binary search; comment and string tokens never count as parentheses.
jet_config_call_close: fn(callee_end: Int, args: [CallArg], tokens: [Token]) -> Int? Never! {
    from := callee_end
    depth := 0
    if args.len() > 0 {
        from = jet_config_value_end(args[args.len() - 1].expr, tokens) ?? return None
        depth = 1
    }
    low := 0
    high := tokens.len()
    loop low < high {
        middle: (low + high) /% 2
        if tokens[middle].span.start < from -> low = middle + 1 else -> high = middle
    }
    loop index in low..<tokens.len() {
        kind: tokens[index].kind
        if kind == TOKEN_LPAREN -> depth += 1
        if kind == TOKEN_RPAREN {
            depth -= 1
            if depth == 0 -> return Val(tokens[index].span.end)
            if depth < 0 -> return None
        }
    }
    None
}

// The module values of a config source as one program the compiler checks
// whole: the source's text with every function, type and immutable module
// value kept in place and every other byte blanked, line breaks kept, so a
// span in the program is the same span in the source. An environment read
// `$NAME` is respelled in place, its `$` replaced by a letter that makes a
// name no token of the source spells, and that name is declared after the
// source with the read's value in `environment`
// (jet_config_environment_literal). The last line, `JET_CONFIG_VALUE: 0`,
// names the program's module among the values the check computes.
jet_config_module_values_program: fn(items: [Item], source: String, environment: [NamedCtValue]) -> String ComptimeEvalError! {
    bytes: source.bytes()
    out := [U8]{}
    newline: U8{10}
    blank: U8{32}
    loop byte in bytes -> out.push(if byte == newline -> newline else -> blank)
    kept := [Span]{}
    loop item in items {
        span: jet_config_module_values_item_span(item) ?? next
        if span.start < 0 || span.end > bytes.len() || span.start > span.end -> next
        loop index in span.start..<span.end -> out[index] = bytes[index]
        kept.push(span)
    }
    lexed: lex_config(bytes)
    // Every identifier the source spells.
    spelled := name_table_sized(64)
    reads := [Span]{}
    jet_config_module_values_names(lexed.tokens, lexed.tables, spelled, reads)
    // Per environment read, by id in a table of the names read: the letter
    // that stands for its `$` in the program (its first byte there), `unread`
    // before its first read.
    declared := name_table_sized(16)
    unread: U8{0}
    letters := [U8]{unread}
    lines := [String]{}
    loop read in reads {
        if !jet_config_module_values_kept(kept, read) -> next
        name: source.slice(read.start..<read.end)
        id: name_index(name_intern(declared, name))
        if id == letters.len() -> letters.push(unread)
        if letters[id] != unread {
            out[read.start] = letters[id]
            next
        }
        rest: name.removeprefix("$")
        chosen := ""
        prefixes: [String]{"Q", "X", "Z", "J", "K", "V", "W", "Y"}
        loop prefix in prefixes {
            candidate: "{prefix}{rest}"
            if name_find(spelled, candidate) == None {
                chosen = candidate
                break
            }
        }
        if chosen == "" {
            return Err(ComptimeEvalError{diagnostic: jet_config_eval_diagnostic(Val(read), "the environment read `{name}` has no free name to stand for it in the module values' program")})
        }
        literal: jet_config_environment_literal(environment, name) ?? return Err(ComptimeEvalError{diagnostic: jet_config_eval_diagnostic(Val(read), "the environment read `{name}` holds a value the module values' program can't spell")})
        lines.push("{chosen}: {literal}")
        first: chosen.bytes()[0]
        out[read.start] = first
        letters[id] = first
        _ := name_intern(spelled, chosen)
    }
    lines.push("{JET_CONFIG_VALUE_NAME}: 0")
    lines.push("")
    text: String.from_bytes(out) ?? return Err(ComptimeEvalError{diagnostic: jet_config_eval_diagnostic(None, "the module values' source is not valid text")})
    declarations: lines.join("\n")
    Ok("{text}\n{declarations}")
}

// The span of an item the module values' program keeps: a function, a type,
// or an immutable module value. Mutable module state is no value.
jet_config_module_values_item_span: fn(item: Item) -> Span? Never! {
    if item == {
        .Func(value) -> Val(value.span)
        .Const(value) -> if value.mutable -> None else -> Val(value.span)
        .Struct(value) -> Val(value.span)
        .Enum(value) -> Val(value.span)
        .Distinct(value) -> Val(value.span)
        .TypeAlias(value) -> Val(value.span)
        .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// Every identifier `tokens` spell, interpolations included, into `spelled`,
// and the span of each environment read `$NAME` into `reads`.
jet_config_module_values_names: fn(tokens: [Token], tables: TokenTables, spelled: &NameTable, reads: &[Span]) Never! {
    loop token in tokens {
        if token.kind == TOKEN_IDENT {
            name: token_decoded(tables, token)
            if name.starts_with("$") -> reads.push(token.span)
            _ := name_intern(spelled, name)
        }
        if token.kind == TOKEN_STRING {
            loop part in token_string_parts(tables, token) {
                if part.kind == STRING_PART_INTERPOLATION {
                    jet_config_module_values_names(part.tokens, tables, spelled, reads)
                }
            }
        }
    }
}

// Whether `span` lies inside one of the `kept` item spans.
jet_config_module_values_kept: fn(kept: [Span], span: Span) -> Bool Never! {
    loop item in kept {
        if span.start >= item.start && span.end <= item.end -> return true
    }
    false
}

// The literal of the value `environment` holds for the read `name`, the
// empty text when it holds none; None when the module values' program can't
// spell it (jet_config_literal).
jet_config_environment_literal: fn(environment: [NamedCtValue], name: String) -> String? Never! {
    loop entry in environment {
        if entry.name == name -> return jet_config_literal(entry.value)
    }
    jet_config_literal(CtValue.Str{value: ""})
}
