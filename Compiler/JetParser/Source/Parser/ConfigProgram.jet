// The config-value program of the first-party compiler service (JetFoundation
// CompilerService.jet). Both requesters build it here: `jet` in-process
// (JetCli ConfigEval.jet) and `jetpack` before asking the sibling `jet`
// (EnvModel CompilerService.jet). It lives beside the parser because a config
// expression's source text is found on its lexed tokens.
use jet_foundation.[
    CallArg, ComptimeEvalError, ComptimeNameSite, CtValue, Expr, Func, JET_CONFIG_VALUE_NAME, Span,
    comptime_walk_identifiers, expr_span, jet_config_eval_error, jet_config_literal,
]
use jet_lexer.[TOKEN_LPAREN, TOKEN_RPAREN, Token, lex_config]

// The typed program for one config value. Each global the expression reads
// becomes one ALL_CAPS module constant, and each read is respelled to it.
fn jet_config_program(expr: Expr, source: String, funcs: [String: Func], globals: [String: CtValue]) -> String ComptimeEvalError! {
    bytes :: source.bytes()
    span :: jet_config_value_extent(expr, lex_config(bytes).tokens) ?? return Err(jet_config_eval_error(expr, "this config value has no source text to evaluate"))
    if span.start < 0 || span.end > bytes.len() || span.start > span.end -> return Err(jet_config_eval_error(expr, "this config value has no source text to evaluate"))
    sites := [ComptimeNameSite]{}
    loop site in comptime_walk_identifiers(expr) {
        if globals.get(site.name) == None -> next
        if site.span.start < span.start || site.span.end > span.end -> return Err(jet_config_eval_error(expr, "`{site.name}` is read outside this config value's source text"))
        index := sites.len()
        loop index > 0 && sites[index - 1].span.start > site.span.start -> index -= 1
        &sites.insert(index, site)
    }
    constants := [String: String]{}
    lines := [String]{}
    loop name in funcs.keys() {
        if funcs[name].span.start < 0 || funcs[name].span.end > bytes.len() -> next
        &lines.push(String.from_bytes(bytes.slice(funcs[name].span.start, funcs[name].span.end)) ?? return Err(jet_config_eval_error(expr, "the function `{name}` is not valid text")))
    }
    text := [String]{}
    cursor := span.start
    loop site in sites {
        if site.span.start < cursor -> next
        constant := constants.get(site.name) ?? ""
        if constant == "" {
            constant = "JET_CONFIG_GLOBAL_{constants.len()}"
            value :: globals[site.name]
            literal :: jet_config_literal(value) ?? return Err(jet_config_eval_error(expr, "`{site.name}` holds a value this config value can't read as literal data"))
            constants[site.name] = constant
            &lines.push("{constant} :: {literal}")
        }
        &text.push(String.from_bytes(bytes.slice(cursor, site.span.start)) ?? "")
        &text.push(constant)
        cursor = site.span.end
    }
    &text.push(String.from_bytes(bytes.slice(cursor, span.end)) ?? "")
    body :: text.join("")
    &lines.push("{JET_CONFIG_VALUE_NAME} :: comptime {{ {body} }}")
    &lines.push("")
    Ok(lines.join("\n"))
}

// A config expression's whole source text, first byte to last. `expr_span`
// is the diagnostic anchor: a call's is its callee name, and a binary
// expression's covers its operands' anchors, so `double(PORT)` or
// `1 + missing()` would lose the argument list. A call runs to its closing
// `)`, found on the lexed tokens so that a string, a comment or a nested call
// never stands in for it. None when the tokens hold no closing `)`.
fn jet_config_value_extent(expr: Expr, tokens: [Token]) -> Span? Never! {
    Val(Span{start: jet_config_value_start(expr), end: jet_config_value_end(expr, tokens) ?? return None})
}

// The first byte: the leftmost operand, receiver or base of a postfix or
// infix form, else the expression's own span.
fn jet_config_value_start(expr: Expr) -> Int Never! {
    own :: expr_span(expr).start
    start :: if expr == {
        .Binary(_, left, _, _, _) -> jet_config_value_start(left)
        .CompareChain(operands, _, _, _, _) -> if operands.len() > 0 -> jet_config_value_start(operands[0]) else -> own
        .Range(first, _, _, _, _) -> jet_config_value_start(first)
        .Index(base, _, _, _, _) -> jet_config_value_start(base)
        .Slice(base, _, _, _, _, _) -> jet_config_value_start(base)
        .Try(value, _, _, _, _) -> jet_config_value_start(value)
        .OrFallback(value, _, _, _, _) -> jet_config_value_start(value)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) -> jet_config_value_start(base)
        .MethodCall(receiver, _, _, _, _, _, _) | .OptMethodCall(receiver, _, _, _, _, _, _) -> jet_config_value_start(receiver)
        .CallValue(callee, _, _, _) -> jet_config_value_start(callee)
        else -> own
    }
    if start < own -> start else -> own
}

// The end of the last byte: a call's closing `)`, the rightmost operand of a
// prefix or infix form, else the expression's own span.
fn jet_config_value_end(expr: Expr, tokens: [Token]) -> Int? Never! {
    own :: expr_span(expr).end
    end :: if expr == {
        .Call(call, _) -> jet_config_call_close(call.name_span.end, call.args, tokens) ?? return None
        .MethodCall(_, _, method_span, _, _, args, _) -> jet_config_call_close(method_span.end, args, tokens) ?? return None
        .OptMethodCall(_, _, method_span, _, args, _, _) -> jet_config_call_close(method_span.end, args, tokens) ?? return None
        .Binary(_, _, right, _, _) -> jet_config_value_end(right, tokens) ?? return None
        .CompareChain(operands, _, _, _, _) -> if operands.len() > 0 -> (jet_config_value_end(operands[operands.len() - 1], tokens) ?? return None) else -> own
        .Range(_, last, _, _, _) -> jet_config_value_end(last, tokens) ?? return None
        .Unary(_, operand, _, _) -> jet_config_value_end(operand, tokens) ?? return None
        .Spread(value, _, _) | .Deref(value, _, _) | .RawOf(value, _, _) | .Copy(value, _, _) -> jet_config_value_end(value, tokens) ?? return None
        else -> own
    }
    Val(if end > own -> end else -> own)
}

// The end of a call's closing `)`. With arguments the walk starts after the
// last argument, inside the parentheses (depth 1); without, after the callee,
// where the next `(` opens them (depth 0). Tokens before `from` are skipped by
// binary search; comment and string tokens never count as parentheses.
fn jet_config_call_close(callee_end: Int, args: [CallArg], tokens: [Token]) -> Int? Never! {
    from := callee_end
    depth := 0
    if args.len() > 0 {
        from = jet_config_value_end(args[args.len() - 1].expr, tokens) ?? return None
        depth = 1
    }
    low := 0
    high := tokens.len()
    loop low < high {
        middle :: (low + high) /% 2
        if tokens[middle].span.start < from -> low = middle + 1 else -> high = middle
    }
    loop index in low..<tokens.len() {
        kind :: tokens[index].kind
        if kind == TOKEN_LPAREN -> depth += 1
        if kind == TOKEN_RPAREN {
            depth -= 1
            if depth == 0 -> return Val(tokens[index].span.end)
            if depth < 0 -> return None
        }
    }
    None
}
