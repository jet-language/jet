//RS     fn arrow_control_law_formats_canonical_forms_idempotently() {
//RS         use crate::Formatter::format_source;
//RS 
//RS         let src = r#"protocol Exchange {
//RS     client: Hello(id: Int)
//RS     server: Ready()
//RS }
//RS 
//RS fn classify(score: Int) -> Grade -> if {
//RS     score >= 90 -> .A
//RS     score >= 80 -> .B
//RS     else -> .C
//RS }
//RS 
//RS fn notify(ready: Bool) -[Net]> {
//RS     if ready -> send() else -> skip()
//RS     loop item in items -> audit(item)
//RS     outer :: loop {
//RS         next(outer)
//RS     }
//RS     task.group group {
