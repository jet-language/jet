use jet_foundation.[AccessConvention, Diagnostic, EnumDef, Func, MetaAttr, Param, ParamZone, PatSlot, Pattern, Span, StructDef, Type, StateTransition, MaturityTag, WebPartitionMarker, Stmt, TextEdit, Syntax, Expr, Field, StateDecl, CLICommandBinding, TraitImplBlock, Marker, RuleSite]
use jet_lexer.[TokKind]

// Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:7
impl Parser {
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:11
    fn parse_func_params(&self) -> ([Param], Pattern?) Diagnostic! {
        is_head :: (self.peek().kind == .Ident(_)) && (self.peek2().kind == { .LParen | .RParen -> true else -> false })
        if !is_head -> return (self.parse_param_list()?, None)
        (variant, variant_span) :: self.expect_ident("for a multi-head variant")?
        params := [Param]{}
        pattern_end := variant_span.end
        if self.peek().kind == .LParen {
            self.bump()
            params = self.parse_param_list()?
            pattern_end = self.toks[self.pos.saturating_sub(1)].span.end
            self.expect(.RParen, "after a multi-head payload")?
        } else {
            self.expect(.RParen, "after a unit multi-head variant")?
        }
        bindings := [PatSlot]{}
        loop param in params {
            if param.name == Syntax.PAT_WILDCARD_SLOT {
                &bindings.push(.Wildcard)
            } else {
                &bindings.push(.Bind{name: ~param.name, span: param.name_span})
            }
        }
        (params, Val(Pattern.Variant{variant: variant, bindings: bindings, leading_dot: false, span: Span.new(variant_span.start, pattern_end)}))
    }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:54
    pub fn func_after_fn(&self, is_pub: Bool, is_package_pub: Bool, is_unsafe: Bool,
        unsafe_reason: String?, unsafe_span: Span?, is_pure: Bool, is_sanitizer: Bool,
        meta: MetaAttr?, state_requires: (String, Span)?, state_transition: StateTransition?,
        is_reactive: Bool, web_marker: WebPartitionMarker?, is_must_use: Bool, must_use_span: Span?,
        maturity: MaturityTag?, maturity_span: Span?, is_inline: Bool, is_inline_always: Bool,
        inline_span: Span?, is_replayable: Bool, replayable_span: Span?, allow_guest_import_symbol: Bool) -> Func Diagnostic! {
        declaration_start :: self.toks[self.pos.saturating_sub(1)].span.start
        (name, name_span) := self.expect_ident("after `fn`")?
        external_type := (String, Span)?{None}
        connector :: self.peek().kind == { .Dot | .TildeTilde -> true else -> false }
        if connector && self.peek2().kind == .Ident(_) && self.peek3().kind == .LParen {
            type_name :: name
            type_span :: name_span
            if self.peek().kind == .TildeTilde {
                sep_span :: self.peek().span
                &self.diags.push(Diagnostic.error("E0325",
                    "external methods attach with `{Syntax.EXTERNAL_METHOD_CONNECTOR}`, not `{Syntax.EXTERNAL_METHOD_CONNECTOR_RETIRED}`",
                    "the dot connector matches trait impls and ordinary member access",
                    "write `fn {type_name}.method(...)`", Val(sep_span)))
            }
            self.bump()
            (method_name, method_span) :: self.expect_ident("after the connector in an external method definition")?
            name = method_name
            name_span = method_span
            external_type = Val((type_name, type_span))
        }
        type_params :: self.parse_opt_type_params()?
        self.expect(.LParen, "after the function name")?
        (params, head_pattern) :: self.parse_func_params()?
        self.validate_variadic_params(params)
        self.validate_param_labels(params)
        if external_type != None -> self.reject_root_method_params(params)
        (return_type, return_type_span, declared_effects, effect_via, prefix_effect_span) := self.parse_callable_result_and_prefix_effects()?
        declared_return_view_provenance :: self.parse_opt_declared_view_from(params)
        post_effect_span := Span?{None}
        if declared_effects == None && effect_via == None && self.func_effect_starts_here() {
            post_effect_span = Val(self.peek().span)
            (effects, via) :: self.parse_opt_func_effects()?
            declared_effects = effects
            effect_via = via
        }
        effect_body_span := post_effect_span
        if effect_body_span == None && return_type == None && (declared_effects != None || effect_via != None) {
            effect_body_span = prefix_effect_span
        }
        pure := is_pure
        if declared_effects == .Val(effects) -> pure = pure || effects.is_empty()
        // D-SIG-SHAPE1=B: retain the Rust colon recovery diagnostic.
        if self.peek().kind == .Colon {
            colon :: self.bump()
            &self.diags.push(Diagnostic.error("E0003", "a function return type uses `:`",
                "Jet uses `:` for parameter and field types; callable bodies use `->`",
                "replace `:` with `->` before the return type", Val(colon.span))
                .with_edit(TextEdit{span: colon.span, new_text: Syntax.OP_UNIFIED_ARROW}))
            if self.type_starts_here() {
                (ty, span) :: self.return_type()?
                return_type = Val(ty)
                return_type_span = Val(span)
            }
        }
        effect_body_marker :: effect_body_span != None
        body_marker_span := Span?{None}
        explicit_marker :: self.peek().kind == { .UnifiedArrow | .LambdaArrow | .ColonColon | .Eq -> true else -> false }
        if effect_body_span != None && !explicit_marker {
            body_marker_span = effect_body_span
        } else {
            body_marker_span = self.parse_optional_function_body_marker(allow_guest_import_symbol)
        }
        body := [Stmt]{}
        end := self.peek().span.start
        value_body := false
        if body_marker_span != None {
            value_body = self.peek().kind != .LBrace || (!effect_body_marker && self.brace_starts_record() && self.peek2().kind != .RBrace)
        }
        if value_body {
            if self.function_body_is_missing() {
                &self.diags.push(Parser.missing_function_body(self.peek().span, name))
                if self.peek().kind == .Semi -> self.bump()
            } else {
                expr :: self.expr()?
                expr_end :: expr.span().end
                self.finish_stmt()?
                end = if self.pos > 0 -> self.toks[self.pos - 1].span.end else -> expr_end
                &body.push(.Expr(expr))
            }
        } else if self.peek().kind != .LBrace {
            &self.diags.push(Parser.missing_function_body(self.peek().span, name))
        } else {
            self.expect(.LBrace, "to open the function body")?
            // D-TAIL-RETURN1=A: restore the enclosing callable's tail state.
            previous_tail_depth :: self.callable_tail_block_depth
            previous_tail_value :: self.callable_tail_expects_value
            self.callable_tail_block_depth = Val(self.block_depth + 1)
            self.callable_tail_expects_value = if return_type == { .Val(ty) -> Parser.return_type_has_value(ty) else -> false }
            body = self.block_stmts()
            self.callable_tail_block_depth = previous_tail_depth
            self.callable_tail_expects_value = previous_tail_value
            end = self.toks[self.pos.saturating_sub(1)].span.end
        }
        Func{span: Span.new(declaration_start, end), is_pub: is_pub, is_package_pub: is_package_pub,
            is_comptime: false, external_type: external_type, name: name, name_span: name_span,
            meta: meta, type_params: type_params, head_pattern: head_pattern, params: params,
            return_type: return_type, return_type_span: return_type_span, return_view_provenance: None,
            declared_return_view_provenance: declared_return_view_provenance, gc_return: false,
            diverges: false, gc_scope: false, is_unsafe: is_unsafe, unsafe_reason: unsafe_reason,
            unsafe_span: unsafe_span, is_pure: pure, is_sanitizer: is_sanitizer, scrub_tag: None,
            is_reactive: is_reactive, reactive_upgrades: [], is_replayable: is_replayable,
            replayable_span: replayable_span, is_job: false, job_span: None, every: None, job_metadata: None,
            declared_effects: declared_effects, effect_via: effect_via, state_requires: state_requires,
            state_transition: state_transition, web_marker: web_marker, is_must_use: is_must_use,
            must_use_span: must_use_span, maturity: maturity, maturity_span: maturity_span, kernel: None,
            is_inline: is_inline, is_inline_always: is_inline_always, inline_span: inline_span,
            pre: [], post: [], inline_foreign: None, undo: None, markers: [], compiler_generated: false, body: body}
    }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:409
    pub fn guest_import_func(&self) -> Func Diagnostic! {
        loop self.peek().kind == .Semi { self.bump() }
        (is_pub, is_package_pub) :: self.parse_item_visibility()
        self.expect_kw(.KwFn, "to start a function definition")?
        self.func_after_fn(is_pub, is_package_pub, false, None, None, false, false, None,
            None, None, false, None, false, None, None, None, false, false, None, false, None, true)?
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:442
    pub fn foreign_function(&self) -> Func Diagnostic! {
        self.func_after_fn(false, false, false, None, None, false, false, None, None, None,
            false, None, false, None, None, None, false, false, None, false, None, false)?
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:451
    pub fn bump_then_func_after_fn(&self, is_pub: Bool, is_package_pub: Bool, is_unsafe: Bool,
        is_pure: Bool, is_sanitizer: Bool, meta: MetaAttr?, state_requires: (String, Span)?,
        state_transition: StateTransition?, web_marker: WebPartitionMarker?, is_must_use: Bool,
        must_use_span: Span?, maturity: MaturityTag?, maturity_span: Span?) -> Func Diagnostic! {
        self.expect_kw(.KwFn, "to start a function definition")?
        self.func_after_fn(is_pub, is_package_pub, is_unsafe, None, None, is_pure, is_sanitizer,
            meta, state_requires, state_transition, false, web_marker, is_must_use, must_use_span,
            maturity, maturity_span, false, false, None, false, None, false)?
    }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:497
    pub fn parse_callable_result_and_prefix_effects(&self) -> (Type?, Span?, [(String, Span)]?, (String, Span)?, Span?) Diagnostic! {
        prefix_effect_span :: if self.func_effect_starts_here() -> Val(self.peek().span) else -> None
        (declared_effects, effect_via) :: self.parse_opt_func_effects()?
        has_prefix_effect :: declared_effects != None || effect_via != None
        arrow_return := false
        return_type := Type?{None}
        return_type_span := Span?{None}
        if has_prefix_effect {
            arrow_return = true
            if self.result_type_follows_arrow() {
                (ty, span) :: self.return_type()?
                return_type = Val(ty)
                return_type_span = Val(span)
            } else if self.parse_unit_fallible_return()? == .Val((ty, span)) {
                return_type = Val(ty)
                return_type_span = Val(span)
            }
        } else if self.at_unified_arrow() {
            self.bump()
            if self.result_type_follows_arrow() {
                arrow_return = true
                (ty, span) :: self.return_type()?
                return_type = Val(ty)
                return_type_span = Val(span)
            } else if self.parse_unit_fallible_return()? == .Val((ty, span)) {
                arrow_return = true
                return_type = Val(ty)
                return_type_span = Val(span)
            } else {
                self.pos = self.pos.saturating_sub(1)
            }
        } else if self.parse_unit_fallible_return()? == .Val((ty, span)) {
            return_type = Val(ty)
            return_type_span = Val(span)
        } else if self.type_starts_here() {
            (ty, span) :: self.return_type()?
            &self.diags.push(Parser.retired_signature_shape(span))
            return_type = Val(ty)
            return_type_span = Val(span)
        }
        if arrow_return && return_type == .Val(ty) {
            if Parser.is_unit_fallible_type(ty) {
                span :: return_type_span ?? self.peek().span
                &self.diags.push(Parser.retired_unit_fallible_signature(span))
            }
        }
        (return_type, return_type_span, declared_effects, effect_via, prefix_effect_span)
    }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:567
    fn result_type_follows_arrow(&self) -> Bool Never! {
        saved_pos :: self.pos
        saved_diags :: self.diags.len()
        saved_pending_type_gt :: self.pending_type_gt
        saved_type_generic_depth :: self.type_generic_depth
        saved_type_generic_chain_len :: self.type_generic_chain.len()
        saved_type_generic_truncated :: self.type_generic_truncated
        (_, span) :: self.return_type() ?? {
            self.pos = saved_pos
            &self.diags.truncate(saved_diags)
            self.pending_type_gt = saved_pending_type_gt
            self.type_generic_depth = saved_type_generic_depth
            &self.type_generic_chain.truncate(saved_type_generic_chain_len)
            self.type_generic_truncated = saved_type_generic_truncated
            return false
        }
        result_boundary := false
        {
            result_boundary = self.peek().kind == {
                .ColonColon | .Eq | .UnifiedArrow | .LambdaArrow | .Semi | .Comma | .RParen -> true
                .LBrace -> span.end < self.peek().span.start
                .Ident(name) -> name == Syntax.VIEW_FROM
                else -> false
            }
        }
        self.pos = saved_pos
        &self.diags.truncate(saved_diags)
        self.pending_type_gt = saved_pending_type_gt
        self.type_generic_depth = saved_type_generic_depth
        &self.type_generic_chain.truncate(saved_type_generic_chain_len)
        self.type_generic_truncated = saved_type_generic_truncated
        result_boundary
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:601
    pub fn func_effect_starts_here(self) -> Bool Never! {
        second :: self.peek2().kind
        self.peek().kind == {
            .Colon | .Eq | .Minus -> second == .LBracket
            .Hash -> second == .LParen
            .MinusMinus -> true
            else -> false
        }
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:613
    fn parse_optional_function_body_marker(&self, allow_guest_import_symbol: Bool) -> Span? Never! {
        if self.peek().kind == {
            .UnifiedArrow -> {
                span :: self.bump().span
                if allow_guest_import_symbol -> &self.diags.push(Parser.guest_import_body_marker(span))
                Val(span)
            }
            .LambdaArrow -> {
                span :: self.bump().span
                &self.diags.push(Parser.retired_unified_arrow(span))
                Val(span)
            }
            .ColonColon -> {
                span :: self.bump().span
                &self.diags.push(Parser.retired_function_body(span, "::"))
                Val(span)
            }
            .Eq -> {
                span :: self.bump().span
                if !allow_guest_import_symbol -> &self.diags.push(Parser.retired_function_body(span, "="))
                Val(span)
            }
            else -> None
        }
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:645
    fn guest_import_body_marker(span: Span) -> Diagnostic Never! {
        Diagnostic.error("E3261", "`#Import(c)` function uses a non-canonical body marker",
            "`#Import(c)` binds a compile-time C symbol; `->` is a Jet function-body marker and cannot declare a foreign symbol",
            "write `#Import(c) fn name(args) Return = \"symbol\"`", Val(span))
    }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:662
    pub fn parse_opt_effect_annotation(&self) -> [(String, Span)]? Diagnostic! {
        (effects, _) :: self.parse_opt_func_effects()?
        effects
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:677
    pub fn parse_opt_func_effects(&self) -> ([(String, Span)]?, (String, Span)?) Diagnostic! {
        canonical :: self.peek().kind == .Minus && self.peek2().kind == .LBracket
        retired_colon :: self.peek().kind == .Colon && self.peek2().kind == .LBracket
        retired_eq :: self.peek().kind == .Eq && self.peek2().kind == .LBracket
        retired_hash :: self.peek().kind == .Hash && self.peek2().kind == .LParen
        retired_double :: self.peek().kind == .MinusMinus
        if !canonical && !retired_colon && !retired_eq && !retired_double && !retired_hash -> return (None, None)
        start :: self.peek().span
        open := TokKind.LBracket
        close := TokKind.RBracket
        close_arrow := TokKind.Gt
        self.bump()
        if canonical || retired_colon {
            if retired_colon -> &self.diags.push(Parser.retired_effect_syntax(start))
        } else if retired_eq {
            &self.diags.push(Parser.retired_effect_syntax(start))
            close_arrow = .LambdaArrow
        } else if retired_hash {
            &self.diags.push(Parser.retired_effect_syntax(start))
            open = .LParen
            close = .RParen
            close_arrow = .UnifiedArrow
        } else {
            &self.diags.push(Parser.retired_effect_syntax(start))
            close_arrow = .UnifiedArrow
        }
        self.expect(open, "to start an effect row")?
        if self.peek().kind == .Ident(name) && name == Syntax.KW_VIA {
            self.bump()
            (param, span) :: self.expect_ident("for the callback parameter name after `via`")?
            self.expect(close, "to close the effect row")?
            self.finish_effect_arrow(close_arrow, retired_hash, canonical, start)?
            return (None, Val((param, span)))
        }
        effects := [(String, Span)]{}
        if self.peek().kind != close {
            loop {
                if self.peek().kind == .DotDot {
                    self.bump()
                    (name, span) :: self.expect_ident("for an open effect-row name")?
                    &effects.push(("..{name}", span))
                    if self.peek().kind == close -> break
                    self.expect(.Comma, "between effects in the row")?
                    if self.peek().kind == close -> break
                    next
                }
                prohibited :: self.peek().kind == .Bang
                if prohibited -> self.bump()
                (name, span) :: self.expect_effect_path_name("for an effect name")?
                if !prohibited && name.contains("(") {
                    throw Diagnostic.error("E0119", "`{name}` is only valid as a memory denial",
                        "the `above: Bytes` argument parameterizes a prohibition, not a positive effect bound",
                        "write `-[!{name}]>`", Val(span))
                }
                entry :: if prohibited -> "!{name}" else -> name
                &effects.push((entry, span))
                if self.peek().kind == close -> break
                self.expect(.Comma, "between effects in the list")?
                if self.peek().kind == close -> break
            }
        }
        self.expect(close, "to close the effect row")?
        self.finish_effect_arrow(close_arrow, retired_hash, canonical, start)?
        (Val(effects), None)
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:773
    fn finish_effect_arrow(&self, close_arrow: TokKind, retired_hash: Bool, canonical: Bool, start: Span) Diagnostic! {
        if retired_hash {
            if Parser.at_unified_arrow_token(self.peek().kind) -> self.bump()
            return
        }
        if self.peek().kind == .Gt { self.bump(); return }
        if canonical && Parser.at_unified_arrow_token(self.peek().kind) {
            self.bump()
            &self.diags.push(Parser.retired_effect_syntax(start))
            return
        }
        self.expect(close_arrow, "after the effect row")?
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:799
    pub fn retired_effect_syntax(span: Span) -> Diagnostic Never! {
        Diagnostic.error("E0066", "this function uses the retired effect-arrow spelling",
            "callable results use `->`, and an explicit effect ceiling uses the same arrow",
            "write `-[Effects]>`; use `-[]>` for an explicit purity bound", Val(span))
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:810
    pub fn retired_signature_shape(span: Span) -> Diagnostic Never! { Diagnostic.from_row("E0068", [], Val(span)) }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:817
    pub fn retired_unified_arrow(span: Span) -> Diagnostic Never! {
        Diagnostic.error("E0070", "this uses a retired arrow spelling",
            "callables, arms, and lambdas use one arrow: `->`", "replace `=>` with `->`", Val(span))
            .with_edit(TextEdit{span: span, new_text: Syntax.OP_UNIFIED_ARROW})
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:831
    pub fn retired_function_body(span: Span, marker: String) -> Diagnostic Never! {
        Diagnostic.error("E0065", "This function uses the retired `{marker}` body marker.",
            "Named function bodies use braces. `::` binds a name, and `=` fills a slot inside a definition.",
            "Replace `{marker}` with `{{ … }}`; `jet fmt` applies this fix.", Val(span))
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:843
    fn function_body_is_missing(self) -> Bool Never! {
        self.peek().kind == {
            .Hash -> !(self.peek2().kind == .Ident(name) && name == Syntax.KW_TODO)
            .KwFn | .KwPub | .KwPriv | .KwStruct | .KwEnum | .KwModule | .KwImpl | .KwTrait | .KwUse | .KwExtern | .Eof | .RBrace | .Semi -> true
            else -> false
        }
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:867
    fn missing_function_body(span: Span, name: String) -> Diagnostic Never! { Diagnostic.from_row("E0081", [("name", name)], Val(span)) }

    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:878
    pub fn parse_param_list(&self) -> [Param] Diagnostic! {
        params := [Param]{}
        zone := ParamZone.Either
        slash := Span?{None}
        star := Span?{None}
        if self.peek().kind != .RParen {
            loop {
                if self.peek().kind == {
                    .Slash -> {
                        span :: self.bump().span
                        if slash == .Val(first) {
                            &self.diags.push(Parser.repeated_param_zone(Syntax.PARAM_ZONE_POSITIONAL_ONLY, span, first))
                        } else if star == .Val(star_span) {
                            &self.diags.push(Parser.zone_out_of_order(span, star_span))
                        } else if params.is_empty() {
                            &self.diags.push(Parser.empty_param_zone(Syntax.PARAM_ZONE_POSITIONAL_ONLY,
                                "a positional-only zone needs at least one parameter before the `/`",
                                "write the positional-only parameters before `/`, or remove the `/`", span))
                        } else {
                            slash = Val(span)
                            loop index in 0..<params.len() { params[index].zone = .PositionalOnly }
                        }
                    }
                    .Star -> {
                        span :: self.bump().span
                        if star == .Val(first) {
                            &self.diags.push(Parser.repeated_param_zone(Syntax.PARAM_ZONE_LABEL_ONLY, span, first))
                        } else { star = Val(span); zone = .LabelOnly }
                    }
                    else -> {
                        param := self.param()?
                        param.zone = zone
                        &params.push(param)
                    }
                }
                if self.peek().kind == .RParen -> break
                self.expect(.Comma, "between parameters")?
                if self.peek().kind == .RParen -> break
            }
        }
        self.expect(.RParen, "to close the parameter list")?
        if star == .Val(span) {
            has_label_only := false
            loop param in params { if param.zone == .LabelOnly -> has_label_only = true }
            if !has_label_only -> &self.diags.push(Parser.empty_param_zone(Syntax.PARAM_ZONE_LABEL_ONLY,
                "a label-only zone needs at least one parameter after the `*`",
                "write the label-only parameters after `*`, or remove the `*`", span))
        }
        params
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:952
    fn repeated_param_zone(sigil: String, span: Span, first: Span) -> Diagnostic Never! {
        _ :: first
        Diagnostic.error("E0763", "`{sigil}` appears twice in this parameter list",
            "each parameter list has at most one positional-only `{Syntax.PARAM_ZONE_POSITIONAL_ONLY}` and one label-only `{Syntax.PARAM_ZONE_LABEL_ONLY}`",
            "remove the extra `{sigil}`", Val(span))
    }
    // Rust: crates/jet-parser/src/Parser/Items/functions_params.rs:967
