        type_params :: self.parse_opt_type_params()?
        self.expect(.LBrace, "to open the struct body")?
        fields := [Field]{}
        state := StateDecl?{None}
        methods := [Func]{}
        cli_bindings := [CLICommandBinding]{}
        trait_impls := [TraitImplBlock]{}
        derives :: [String]{}
        validate_block := [Stmt]{}
        validate_span := Span?{None}
        loop self.peek().kind != .RBrace && self.peek().kind != .Eof {
            if self.peek().kind == .Semi { self.bump(); next }
            if self.at_state_section() {
                section :: self.state_section(~name, name_span)?
                if state != None -> throw Diagnostic.from_row("E0168", [("type", name)], Val(section.span))
                state = Val(section)
                next
            }
            if self.method_starts_here() { &methods.push(self.method_in_type()?); next }
            if self.cli_binding_starts_here() {
                &cli_bindings.push(self.cli_binding([])?)
                if self.peek().kind == { .Comma | .Semi -> true else -> false } -> self.bump()
                next
            }
            if self.at_marker_list() || self.peek().kind == .Hash {
                field_markers :: self.parse_field_markers(RuleSite.Field)?
                if self.cli_binding_starts_here() {
                    &cli_bindings.push(self.cli_binding(field_markers)?)
                    if self.peek().kind == { .Comma | .Semi -> true else -> false } -> self.bump()
                    next
                }
