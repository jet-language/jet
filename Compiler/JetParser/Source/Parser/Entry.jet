// Public parser entry points preserve lexer diagnostics and original byte spans.
use jet_foundation.[
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    ImportDecl,
    ParseResult,
    Program,
    Span,
    TextEdit,
    WebBucket,
    ast_program,
    diagnostic_from_registry,
    diagnostic_with_edit_grade,
]
use jet_lexer.[
    Lexed,
    STRING_PART_INTERPOLATION,
    TOKEN_AT,
    TOKEN_BANG,
    TOKEN_COLON,
    TOKEN_COLON_COLON,
    TOKEN_EOF,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_DERIVE,
    TOKEN_KW_EFFECT,
    TOKEN_KW_ENUM,
    TOKEN_KW_EXTERN,
    TOKEN_KW_FN,
    TOKEN_KW_IMPL,
    TOKEN_KW_LOOP,
    TOKEN_KW_MODULE,
    TOKEN_KW_PRIV,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_KW_TRAIT,
    TOKEN_KW_USE,
    TOKEN_LBRACKET,
    TOKEN_LPAREN,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    Token,
    lex,
    lex_generated,
]

pub fn parse_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex(source), source, parser_line_starts(source))
}

// Embedded Core library sources are vetted stdlib internals: they may spell
// the reserved `__name` namespace (Rust `Lexer::lex_generated`). Only the
// loader's embedded-Core path parses this way; a user file never does.
pub fn parse_generated_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex_generated(source), source, parser_line_starts(source))
}

pub fn parse_lexed(lexed: Lexed) -> ParseResult {
    parser_parse_lexed_lines(lexed, [U8]{}, [Int]{})
}

fn parser_parse_lexed_lines(lexed: Lexed, source: [U8], line_starts: [Int]) -> ParseResult {
    source_end :: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    parser_parse_prepared(parser_prepare_tokens(lexed.tokens), lexed.diagnostics, source_end, line_starts, source)
}

fn parser_line_starts(source: [U8]) -> [Int] Never! {
    starts := [Int]{0}
    loop index in 0..<source.len() {
        if source[index] == (U8{10}) -> &starts.push(index + 1)
    }
    starts
}

pub fn parse_tokens(tokens: [Token]) -> ParseResult {
    source_end :: if {
        tokens.len() > 0 -> {
            last :: tokens[tokens.len() - 1]
            if last.kind == TOKEN_EOF -> last.span.start else -> last.span.end
        }
        else -> 0
    }
    parser_parse_prepared(parser_prepare_tokens(tokens), [Diagnostic]{}, source_end, [Int]{}, [U8]{})
}

// D-EACH1=C: fence expansion runs before parsing. A fence error stops the
// parse like any token-level rejection: no partially expanded AST is built.
fn parser_parse_prepared(prepared: ParserFenceExpansion, lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8]) -> ParseResult {
    if prepared.diagnostics.len() > 0 {
        diagnostics := [Diagnostic]{}
        loop diagnostic in lexer_diagnostics -> &diagnostics.push(diagnostic)
        loop diagnostic in prepared.diagnostics -> &diagnostics.push(diagnostic)
        return ParseResult{program: ast_program(), diagnostics: diagnostics}
    }
    state := JetParserState{tokens: prepared.tokens, position: 0, diagnostics: lexer_diagnostics, source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, result_handler_depth: 0, statement_start: -1, line_starts: line_starts, source: source}
    program := parser_parse_program(&state)
    program.block_spans = state.block_spans
    program.else_arms = state.else_arms
    loop declaration in state.block_policy_declarations -> &program.policy_declarations.push(declaration)
    program.fenced_statements = prepared.fenced_statements
    program.used_import_names = parser_used_import_names(state.tokens, program.imports)
    ParseResult{program: program, diagnostics: state.diagnostics}
}

// L0103 (D-LINT-UNUSED1): an import's local name is read when the file spells
// it outside every import declaration, interpolations included. The module
// root of a member import (`b` in `use b.[f]`) reads that name as well.
fn parser_used_import_names(tokens: [Token], imports: [ImportDecl]) -> [String] Never! {
    candidates := [String]{}
    used := [String]{}
    loop declaration in imports {
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if !used.contains(module_alias) -> &used.push(module_alias)
                loop item in items {
                    parts :: item.original.split(".").to_list()
                    &candidates.push(item.alias ?? parts[parts.len() - 1])
                }
            }
            else -> &candidates.push(declaration.alias)
        }
    }
    parser_collect_used_import_names(tokens, imports, candidates, &used)
    used
}

fn parser_collect_used_import_names(tokens: [Token], imports: [ImportDecl], candidates: [String], used: &[String]) Never! {
    loop token in tokens {
        if token.kind == TOKEN_IDENT && candidates.contains(token.payload.decoded) && !used.contains(token.payload.decoded) {
            inside_import := false
            loop declaration in imports {
                if token.span.start >= declaration.span.start && token.span.end <= declaration.span.end {
                    inside_import = true
                    break
                }
            }
            if !inside_import -> &used.push(token.payload.decoded)
        }
        loop part in token.payload.string_parts {
            if part.kind == STRING_PART_INTERPOLATION -> parser_collect_used_import_names(part.tokens, imports, candidates, &used)
        }
    }
}

fn parser_parse_program(state: &JetParserState) -> Program {
    program := ast_program()
    loop parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_EOF -> break
        before := state.position
        if {
            // D-VERDICT-732-1 / D-ONCE-AT1=D: a top-level `@` other than the
            // retired `@loop` head is a misspelled applied rule.
            parser_current_kind(&state) == TOKEN_AT && parser_kind_at(&state, 1) != TOKEN_KW_LOOP -> {
                at :: parser_bump(&state)
                parser_add_error_code(&state, "E0063", at.span, "applied rules use `#`, not `@`", "`#` marks attributes, instructions, and properties; prefix `@` marks compile-time names and fact reads, while infix `@` stays a package-source separator (D-VERDICT-732-1, amended by D-ONCE-AT1=D)", "replace the leading `@` with `#`")
                parser_sync_top(&state)
            }
            parser_user_policy_ahead(&state) -> {
                declaration :: parser_parse_user_policy(&state)
                if declaration.valid -> &program.user_policy_declarations.push(declaration.value)
            }
            parser_section_label_ahead(&state) -> parser_report_section_label(&state)
            parser_foreign_top_word_ahead(&state) -> parser_report_foreign_top_word(&state)
            parser_file_directive_ahead(&state) -> parser_parse_file_directive(&state, &program)
            parser_policy_file_decl_ahead(&state) -> parser_parse_policy_file_decl(&state, &program)
            parser_item_ahead(&state) -> {
                declaration :: parser_parse_item_or_import(&state)
                if declaration.import == {
                    .Val(value) -> &program.imports.push(value)
                    .None -> {
                        if declaration.item == {
                            .Val(value) -> &program.items.push(value)
                            .None -> {
                                if !declaration.handled {
                                    parser_add_error_here(&state, "expected a declaration", "a declaration modifier must be followed by an item", "add an item declaration or remove the modifier")
                                    parser_recover_statement(&state)
                                }
                            }
                        }
                    }
                }
            }
            else -> {
                // Rust resynchronizes a failed script line like a block line
                // and steps over a token the line could not consume.
                &program.script_body.push(parser_parse_statement(&state))
                parser_recover_aborted_statement(&state, before)
                if state.position == before -> parser_bump(&state)
            }
        }
        parser_recover_aborted_item(&state, before)
        // An abort that no item or line took ends with its item.
        state.abort_mark = 0
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error_code(&state, "E0003", token.span, "the parser could not advance through this source item", "top-level recovery prevents repeated diagnostics at one token", "remove or complete this item")
            parser_bump(&state)
        }
    }
    program
}

// Foreign top-level words that teach the Jet spelling: `namespace` (E0323)
// and `unsafe` (E0031). `unsafe extern rust` keeps its block.
fn parser_foreign_top_word_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    token.kind == TOKEN_IDENT && (token.payload.decoded == "namespace" || token.payload.decoded == "unsafe")
}

fn parser_report_foreign_top_word(state: &JetParserState) {
    word :: parser_bump(&state)
    if word.payload.decoded == "namespace" {
        parser_add_error_code(&state, "E0323", word.span, "in-file grouping uses `module name {{ }}`, not `namespace`", "Jet has one spelling for in-file grouping: a named `module` block", "write `module mygroup {{ fn foo() {{ … }} }}` instead")
        parser_sync_top(&state)
        return
    }
    parser_add_error_code(&state, "E0031", word.span, "Jet doesn't use `unsafe` to call Rust crates", "foreign Rust functions live in whole `extern rust` blocks — callers never write `unsafe`", "write: extern rust \"crate@version\" {{ fn name(...) T = \"rust::path\"; }}")
    if parser_current_kind(&state) != TOKEN_KW_EXTERN -> parser_sync_top(&state)
}

fn parser_file_directive_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    name :: parser_lookahead(&state, 1)
    if name.kind != TOKEN_IDENT -> return false
    if name.payload.decoded == "PubFile" || name.payload.decoded == "PublicFile" || name.payload.decoded == "NoPrelude" || name.payload.decoded == "Html" -> return true
    name.payload.decoded == "Target" && !parser_hash_leads_to_item(&state)
}

fn parser_parse_file_directive(state: &JetParserState, program: &Program) {
    marker :: parser_parse_marker(&state)
    if marker.name == {
        "PubFile" | "PublicFile" -> {
            hash :: Span{start: marker.span.start, end: marker.span.start + 1}
            if marker.name == "PublicFile" -> parser_add_error_code(&state, "E0418", hash, "write `#PubFile`, not `#PublicFile`", "`#PubFile` flips this file to public-by-default (D-VISDEFAULT2)", "write `#PubFile` at the top of the file")
            if program.pub_file {
                parser_add_error_code(&state, "E0999", hash, "`#PubFile` is already applied to this file", "`#PubFile` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
            }
            program.pub_file = true
            state.pub_file_default = true
        }
        "NoPrelude" -> program.no_prelude = true
        "Target" -> {
            first :: parser_marker_first_expr(marker)
            if first == {
                .Val(value) -> {
                    if value == {
                        .Ident(name, _) -> {
                            if name == {
                                "JS" -> program.web_target_ceiling = Val(WebBucket.JS)
                                "Wasm" -> program.web_target_ceiling = Val(WebBucket.Wasm)
                                else -> parser_add_error(&state, marker.span, "unknown file target `{name}`", "`#Target` selects a supported compilation target", "write `#Target(JS)` or `#Target(Wasm)`")
                            }
                            program.default_target = Val(name)
                        }
                        else -> parser_add_error(&state, marker.span, "expected a target name in `#Target`", "target declarations select a compiler target", "write `#Target(JS)` or `#Target(Wasm)`")
                    }
                }
                .None -> parser_add_error(&state, marker.span, "`#Target` requires a target name", "the target directive must choose a backend bucket", "write `#Target(JS)` or `#Target(Wasm)`")
            }
        }
        "Html" -> {
            first :: parser_marker_first_expr(marker)
            if first == {
                .Val(value) -> {
                    path :: parser_expr_literal_string(value)
                    if path == {
                        .Val(text) -> program.html_path = Val(text)
                        .None -> parser_add_error(&state, marker.span, "`#Html` requires a string path", "the companion page location is source text", "write `#Html(\"index.html\")`")
                    }
                }
                .None -> parser_add_error(&state, marker.span, "`#Html` requires a string path", "the companion page location is source text", "write `#Html(\"index.html\")`")
            }
        }
        else -> {}
    }
}

// D-VISDEFAULT2=A: `pub:` / `priv:` section labels would let one line flip
// the visibility of everything below it; E0415 rejects the label itself.
fn parser_section_label_ahead(state: &JetParserState) -> Bool Never! {
    if parser_kind_at(&state, 1) != TOKEN_COLON -> return false
    token :: parser_current(&state)
    token.kind == TOKEN_KW_PUB || token.kind == TOKEN_KW_PRIV || (token.kind == TOKEN_IDENT && token.payload.decoded == "private")
}

fn parser_report_section_label(state: &JetParserState) {
    first :: parser_bump(&state)
    colon :: parser_bump(&state)
    parser_add_error_code(&state, "E0415", parser_cover(first.span, colon.span), "section visibility labels like `pub:` / `priv:` are not supported", "moving an item above or below a label would silently change whether it exports", "write `#PubFile` once at the top of the file, then mark exceptions with `priv`")
}

fn parser_item_ahead(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    token :: parser_current(&state)
    if {
        parser_comptime_const_ahead(&state, 0) -> true
        parser_item_declaration_ahead_at(&state, 0) -> true
        parser_template_loop_ahead(&state) -> true
        parser_is_item_keyword(kind) -> true
        kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_COMPTIME -> true
        token.kind == TOKEN_IDENT && token.payload.decoded == "alias" -> true
        token.kind == TOKEN_IDENT && token.payload.decoded == "private" -> parser_foreign_private_ahead(&state)
        token.kind == TOKEN_IDENT && token.payload.decoded == "sanitizer" -> parser_kind_at(&state, 1) == TOKEN_KW_FN || parser_kind_at(&state, 1) == TOKEN_KW_PUB
        kind == TOKEN_HASH -> parser_hash_leads_to_item(&state)
        else -> false
    }
}

fn parser_is_item_keyword(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_CONST || kind == TOKEN_KW_USE || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_EFFECT || kind == TOKEN_KW_TAG || kind == TOKEN_KW_EXTERN || kind == TOKEN_KW_DERIVE
}

fn parser_comptime_const_ahead(state: &JetParserState, offset: Int) -> Bool Never! {
    parser_kind_at(&state, offset) == TOKEN_AT && parser_kind_at(&state, offset + 1) == TOKEN_IDENT && parser_kind_at(&state, offset + 2) == TOKEN_COLON_COLON
}

// D-PREP-SURFACE2=A + owner ruling (2026-09-30): an immutable module binding
// is named in ALL_CAPS, `MAX_ROWS :: 100`. This is the casing predicate only;
// compile time is always the explicit `NAME :: prep { value }`.
fn parser_constant_name(name: String) -> Bool Never! {
    if name == "" || name.starts_with("@") || name.starts_with("$") -> return false
    has_upper := false
    loop byte in name.bytes() {
        if byte >= (U8{97}) && byte <= (U8{122}) -> return false
        if byte >= (U8{65}) && byte <= (U8{90}) -> has_upper = true
    }
    has_upper
}

// D-CONSTMARK1: after `#Static` / `#Inline`, a constant binding `NAME :: …`
// (or a retired `@`-marked name, which E0388 respells) is a declaration.
fn parser_marked_const_ahead(state: &JetParserState, offset: Int) -> Bool Never! {
    token :: parser_lookahead(&state, offset)
    token.kind == TOKEN_IDENT && parser_kind_at(&state, offset + 1) == TOKEN_COLON_COLON && (token.payload.decoded.starts_with("@") || parser_constant_name(token.payload.decoded))
}

// D-PREP-SURFACE2=A: a retired `@`-marked constant read (or a declaration whose
// value is already `prep { … }`) teaches E0388 with the behavior-preserving
// respelling, and the parse continues under the plain name so each mention
// reports once.
fn parser_retire_const_mark(state: &JetParserState, token: Token) -> String {
    name :: token.payload.decoded
    if !name.starts_with("@") -> return name
    bytes :: name.bytes()
    // A block-scope name stays an ordinary snake_case local; only a module
    // constant is ALL_CAPS, so the mark is dropped and the case kept.
    plain :: String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    diagnostic :: diagnostic_from_registry("E0388", Val(token.span), "`{name}` is retired; write `{plain}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{name}` with `{plain}`")
    &state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: token.span, new_text: plain}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
    plain
}

// D-PREP-SURFACE2=A: a retired `@name :: value` declaration always meant
// compile time, so E0388 teaches `name :: prep { value }` and the parse
// continues under the plain name as that prepared binding.
fn parser_retire_const_decl(state: &JetParserState, span: Span, old: String) -> String {
    bytes :: old.bytes()
    plain :: String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    parser_add_error_code(&state, "E0388", span, "`{old}` is retired; write `{plain} :: prep {{ value }}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{old} :: value` with `{plain} :: prep {{ value }}`")
    plain
}

// An `@`-marked read names a retired constant when the name under the mark
// is ALL_CAPS or this file declares that marked name with `::`; a called
// marked root is a retired metadata query, not a constant.
fn parser_reads_retired_constant(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    name :: token.payload.decoded
    if token.kind != TOKEN_IDENT || !name.starts_with("@") || parser_kind_at(&state, 1) == TOKEN_LPAREN -> return false
    bytes :: name.bytes()
    if parser_constant_name(String.from_bytes(bytes.slice(1, bytes.len())) ?? "") -> return true
    loop index in 0..<state.tokens.len() {
        candidate :: state.tokens[index]
        if candidate.kind == TOKEN_IDENT && candidate.payload.decoded == name && index + 1 < state.tokens.len() && state.tokens[index + 1].kind == TOKEN_COLON_COLON -> return true
    }
    false
}

fn parser_hash_leads_to_item(state: &JetParserState) -> Bool Never! {
    offset := 0
    loop {
        if parser_item_declaration_ahead_at(&state, offset) -> return true
        if parser_kind_at(&state, offset) != TOKEN_HASH -> break
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LBRACKET {
            offset += 1
            nesting := 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LBRACKET -> nesting += 1
                    TOKEN_RBRACKET -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
            next
        }
        if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
        if parser_kind_at(&state, offset) != TOKEN_IDENT -> return false
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LPAREN {
            nesting := 1
            offset += 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LPAREN -> nesting += 1
                    TOKEN_RPAREN -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
        }
    }
    kind :: parser_kind_at(&state, offset)
    parser_item_declaration_ahead_at(&state, offset) || parser_comptime_const_ahead(&state, offset) || parser_marked_const_ahead(&state, offset) || parser_is_item_keyword(kind) || (kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_COMPTIME) || (kind == TOKEN_IDENT && parser_lookahead(&state, offset).payload.decoded == "alias")
}
