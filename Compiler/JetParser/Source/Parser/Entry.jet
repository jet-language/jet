// Public parser entry points preserve lexer diagnostics and original byte spans.
use jet_foundation.[
    DebugTraceSite,
    Diagnostic,
    Expr,
    FixApplicability,
    FixSafety,
    ImportDecl,
    Item,
    Marker,
    ParseResult,
    Program,
    Span,
    TextEdit,
    WebBucket,
    ast_program,
    diagnostic_from_registry,
    diagnostic_with_edit_grade,
    expr_span,
]
use jet_lexer.[
    Lexed,
    STRING_PART_INTERPOLATION,
    TOKEN_AT,
    TOKEN_BANG,
    TOKEN_COLON,
    TOKEN_COMMA,
    TOKEN_COLON_COLON,
    TOKEN_DOT,
    TOKEN_EOF,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_DERIVE,
    TOKEN_KW_EFFECT,
    TOKEN_KW_ENUM,
    TOKEN_KW_EXTERN,
    TOKEN_KW_FN,
    TOKEN_KW_IMPL,
    TOKEN_KW_LOOP,
    TOKEN_KW_MODULE,
    TOKEN_KW_PRIV,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_KW_TRAIT,
    TOKEN_KW_USE,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LPAREN,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_SEMI,
    Token,
    lex,
    lex_generated,
]

pub fn parse_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex(source), source, parser_line_starts(source))
}

// Embedded Core library sources are vetted stdlib internals: they may spell
// the reserved `__name` namespace (Rust `Lexer::lex_generated`). Only the
// loader's embedded-Core path parses this way; a user file never does.
pub fn parse_generated_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex_generated(source), source, parser_line_starts(source))
}

pub fn parse_lexed(lexed: Lexed) -> ParseResult {
    parser_parse_lexed_lines(lexed, [U8]{}, [Int]{})
}

fn parser_parse_lexed_lines(lexed: Lexed, source: [U8], line_starts: [Int]) -> ParseResult {
    source_end :: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    parser_parse_prepared(parser_prepare_tokens(lexed.tokens), lexed.diagnostics, source_end, line_starts, source)
}

fn parser_line_starts(source: [U8]) -> [Int] Never! {
    starts := [Int]{0}
    loop index in 0..<source.len() {
        if source[index] == (U8{10}) -> &starts.push(index + 1)
    }
    starts
}

pub fn parse_tokens(tokens: [Token]) -> ParseResult {
    source_end :: if {
        tokens.len() > 0 -> {
            last :: tokens[tokens.len() - 1]
            if last.kind == TOKEN_EOF -> last.span.start else -> last.span.end
        }
        else -> 0
    }
    parser_parse_prepared(parser_prepare_tokens(tokens), [Diagnostic]{}, source_end, [Int]{}, [U8]{})
}

// D-EACH1=C: fence expansion runs before parsing. A fence error stops the
// parse like any token-level rejection: no partially expanded AST is built.
fn parser_parse_prepared(prepared: ParserFenceExpansion, lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8]) -> ParseResult {
    if prepared.diagnostics.len() > 0 {
        diagnostics := [Diagnostic]{}
        loop diagnostic in lexer_diagnostics -> &diagnostics.push(diagnostic)
        loop diagnostic in prepared.diagnostics -> &diagnostics.push(diagnostic)
        return ParseResult{program: ast_program(), diagnostics: diagnostics}
    }
    state := JetParserState{tokens: prepared.tokens, position: 0, diagnostics: lexer_diagnostics, source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, result_handler_depth: 0, statement_start: -1, line_starts: line_starts, source: source}
    program := parser_parse_program(&state)
    program.block_spans = state.block_spans
    program.else_arms = state.else_arms
    loop declaration in state.block_policy_declarations -> &program.policy_declarations.push(declaration)
    program.fenced_statements = prepared.fenced_statements
    program.used_import_names = parser_used_import_names(state.tokens, program.imports, program.items)
    program.debug_sites = parser_debug_trace_sites(state.tokens, source)
    ParseResult{program: program, diagnostics: state.diagnostics}
}

// L0103 (D-LINT-UNUSED1): an import's local name is read when the file spells
// it outside every import declaration, interpolations included. The module
// root of a member import (`b` in `use b.[f]`) reads that name as well. A
// body-less `module name` is the file import the loader binds for it (D-MOD1).
// Rust: none (Jet-only pass)
fn parser_used_import_names(tokens: [Token], imports: [ImportDecl], program_items: [Item]) -> [String] Never! {
    candidates := [String:Bool]{}
    used := [String]{}
    used_names := [String:Bool]{}
    import_spans := [Span]{}
    loop declaration in imports {
        &import_spans.push(declaration.span)
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if used_names.get(module_alias) == None {
                    &used_names.add(module_alias, true).drop("checked absent above")
                    &used.push(module_alias)
                }
                loop item in items {
                    parts :: item.original.split(".").to_list()
                    &candidates.add(item.alias ?? parts[parts.len() - 1], true).drop("candidate names may repeat")
                }
            }
            else -> &candidates.add(declaration.alias, true).drop("candidate names may repeat")
        }
    }
    loop item in program_items {
        if item == .CodeModule(definition) {
            if definition.body != None -> next
            &import_spans.push(definition.span)
            &candidates.add(definition.name, true).drop("candidate names may repeat")
        }
    }
    if candidates.len() == 0 -> return used
    indexed_spans :: parser_import_span_index(import_spans)
    parser_collect_used_import_names(tokens, indexed_spans, candidates, &used_names, &used)
    used
}

// Rust: none (Jet-only pass)
fn parser_import_span_index(spans: [Span]) -> [Span] Never! {
    order := [Int]{}
    loop index in 0..<spans.len() -> &order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle :: if start + width < order.len() -> start + width else -> order.len()
            end :: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && spans[order[left]].start <= spans[order[right]].start) {
                    &merged.push(order[left])
                    left += 1
                } else {
                    &merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width *= 2
    }
    indexed := [Span]{}
    loop position in order {
        span :: spans[position]
        // Prefix maximum ends preserve containment even for overlapping spans.
        end :: if indexed.len() > 0 && indexed[indexed.len() - 1].end > span.end -> indexed[indexed.len() - 1].end else -> span.end
        &indexed.push(Span{start: span.start, end: end})
    }
    indexed
}

// Rust: none (Jet-only pass)
fn parser_inside_import_span(indexed_spans: [Span], span: Span) -> Bool Never! {
    low := 0
    high := indexed_spans.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if indexed_spans[middle].start <= span.start -> low = middle + 1 else -> high = middle
    }
    low > 0 && span.end <= indexed_spans[low - 1].end
}

// Rust: none (Jet-only pass)
fn parser_collect_used_import_names(tokens: [Token], indexed_spans: [Span], candidates: [String:Bool], used_names: &[String:Bool], used: &[String]) Never! {
    loop token in tokens {
        if token.kind == TOKEN_IDENT && candidates.get(token.payload.decoded) != None && used_names.get(token.payload.decoded) == None {
            if !parser_inside_import_span(indexed_spans, token.span) {
                &used_names.add(token.payload.decoded, true).drop("checked absent above")
                &used.push(token.payload.decoded)
            }
        }
        loop part in token.payload.string_parts {
            if part.kind == STRING_PART_INTERPOLATION -> parser_collect_used_import_names(part.tokens, indexed_spans, candidates, &used_names, &used)
        }
    }
}

// D-DBG1=A: record each `debug(…)` call's argument text as written, so sema
// can name the traced expression and build the E3405 unwrap edit. The text
// runs from the first token after `(` to the last one before its matching
// `)`, leaving out a trailing comma. Interpolations are scanned as well.
fn parser_debug_trace_sites(tokens: [Token], source: [U8]) -> [DebugTraceSite] Never! {
    sites := [DebugTraceSite]{}
    if source.len() > 0 -> parser_collect_debug_trace_sites(tokens, source, &sites)
    sites
}

// Rust: none (Jet-only pass)
fn parser_collect_debug_trace_sites(tokens: [Token], source: [U8], sites: &[DebugTraceSite]) Never! {
    closes := [Int]{}
    opens := [Int]{}
    loop index in 0..<tokens.len() {
        &closes.push(-1)
        if tokens[index].kind == TOKEN_LPAREN -> &opens.push(index)
        if tokens[index].kind == TOKEN_RPAREN && opens.len() > 0 {
            open :: &opens.pop() ?? -1
            closes[open] = index
        }
    }
    loop index in 0..<tokens.len() {
        token :: tokens[index]
        loop part in token.payload.string_parts {
            if part.kind == STRING_PART_INTERPOLATION -> parser_collect_debug_trace_sites(part.tokens, source, &sites)
        }
        if token.kind != TOKEN_IDENT || token.payload.decoded != "debug" || index + 1 >= tokens.len() || tokens[index + 1].kind != TOKEN_LPAREN -> next
        open :: index + 1
        close :: closes[open]
        if close < 0 -> next
        last := close - 1
        if last > open && tokens[last].kind == TOKEN_COMMA -> last -= 1
        if last <= open -> next
        start :: tokens[open + 1].span.start
        end :: tokens[last].span.end
        close_end :: tokens[close].span.end
        if start < 0 || end <= start || close_end > source.len() -> next
        text :: String.from_bytes(source.slice(start, end)) ?? next
        &sites.push(DebugTraceSite{name_start: token.span.start, text: text, close_end: close_end})
    }
}

fn parser_parse_program(state: &JetParserState) -> Program {
    program := ast_program()
    loop parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_EOF -> break
        before := state.position
        if {
            // D-VERDICT-732-1 / D-ONCE-AT1=D: a top-level `@` other than the
            // retired `@loop` head is a misspelled applied rule.
            parser_current_kind(&state) == TOKEN_AT && parser_kind_at(&state, 1) != TOKEN_KW_LOOP -> {
                at :: parser_bump(&state)
                parser_add_error_code(&state, "E0063", at.span, "applied rules use `#`, not `@`", "`#` marks attributes, instructions, and properties; prefix `@` marks compile-time names and fact reads, while infix `@` stays a package-source separator (D-VERDICT-732-1, amended by D-ONCE-AT1=D)", "replace the leading `@` with `#`")
                parser_sync_top(&state)
            }
            parser_user_policy_ahead(&state) -> {
                declaration :: parser_parse_user_policy(&state)
                if declaration.valid -> &program.user_policy_declarations.push(declaration.value)
            }
            parser_section_label_ahead(&state) -> parser_report_section_label(&state)
            parser_foreign_top_word_ahead(&state) -> parser_report_foreign_top_word(&state)
            parser_file_directive_ahead(&state) -> parser_parse_file_directive(&state, &program)
            parser_policy_file_decl_ahead(&state) -> parser_parse_policy_file_decl(&state, &program)
            parser_item_ahead(&state) -> {
                declaration :: parser_parse_item_or_import(&state)
                if declaration.import == {
                    .Val(value) -> &program.imports.push(value)
                    .None -> {
                        if declaration.item == {
                            .Val(value) -> &program.items.push(value)
                            .None -> {
                                if !declaration.handled {
                                    parser_add_error_here(&state, "expected a declaration", "a declaration modifier must be followed by an item", "add an item declaration or remove the modifier")
                                    parser_recover_statement(&state)
                                }
                            }
                        }
                    }
                }
            }
            // D-MODULE-BIND1 (Rust `module_binding_def`): the binding parser
            // reads one named module binding; a destructuring head or a failed
            // binding reports and resynchronizes at the next item.
            parser_module_binding_ahead(&state) -> {
                start :: parser_current(&state).span
                destructuring :: parser_kind_at(&state, 1) == TOKEN_LBRACE
                errors_before :: state.diagnostics.len()
                statement :: if destructuring -> parser_parse_statement(&state) else -> parser_parse_binding_statement(&state)
                item :: parser_module_binding_item(statement, start, parser_previous_end(state))
                if destructuring {
                    parser_add_error_code(&state, "E0003", start, "module globals bind one name at a time", "a module binding is a named value available to every function in the file", "write `name :: value` or `name := value`")
                    parser_sync_top(&state)
                } else if state.diagnostics.len() > errors_before {
                    parser_sync_top(&state)
                } else if item == .Val(value) {
                    &program.items.push(value)
                } else {
                    parser_sync_top(&state)
                }
                if state.position == before -> parser_bump(&state)
            }
            else -> {
                // Rust resynchronizes a failed script line like a block line
                // and steps over a token the line could not consume.
                &program.script_body.push(parser_parse_statement(&state))
                parser_recover_aborted_statement(&state, before)
                if state.position == before -> parser_bump(&state)
            }
        }
        parser_recover_aborted_item(&state, before)
        // An abort that no item or line took ends with its item.
        state.abort_mark = 0
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error_code(&state, "E0003", token.span, "the parser could not advance through this source item", "top-level recovery prevents repeated diagnostics at one token", "remove or complete this item")
            parser_bump(&state)
        }
    }
    program
}

// Foreign top-level words that teach the Jet spelling: `namespace` (E0323)
// and `unsafe` (E0031). `unsafe extern rust` keeps its block.
fn parser_foreign_top_word_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    token.kind == TOKEN_IDENT && (token.payload.decoded == "namespace" || token.payload.decoded == "unsafe")
}

fn parser_report_foreign_top_word(state: &JetParserState) {
    word :: parser_bump(&state)
    if word.payload.decoded == "namespace" {
        parser_add_error_code(&state, "E0323", word.span, "in-file grouping uses `module name {{ }}`, not `namespace`", "Jet has one spelling for in-file grouping: a named `module` block", "write `module mygroup {{ fn foo() {{ … }} }}` instead")
        parser_sync_top(&state)
        return
    }
    parser_add_error_code(&state, "E0031", word.span, "Jet doesn't use `unsafe` to call Rust crates", "foreign Rust functions live in whole `extern rust` blocks — callers never write `unsafe`", "write: extern rust \"crate@version\" {{ fn name(...) T = \"rust::path\"; }}")
    if parser_current_kind(&state) != TOKEN_KW_EXTERN -> parser_sync_top(&state)
}

// File rules (D-VISDEFAULT2, D-PRELUDEX1, D-WEBDEFAULT1, D-HTMLPAIR1): bare
// `#PubFile`/`#NoPrelude`/`#HTML(…)`, a file-level `#Target(…)`, or a `#[…]`
// list of them. The retired `#PublicFile`/`#Html` spellings are read to teach.
fn parser_file_directive_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    if parser_kind_at(&state, 1) == TOKEN_LBRACKET -> return parser_file_marker_group_ahead(&state)
    name :: parser_lookahead(&state, 1)
    if name.kind != TOKEN_IDENT -> return false
    if name.payload.decoded == "PubFile" || name.payload.decoded == "PublicFile" || name.payload.decoded == "NoPrelude" || name.payload.decoded == "HTML" || name.payload.decoded == "Html" -> return true
    name.payload.decoded == "Target" && (parser_target_selects_file_web_at(&state, 1) || !parser_hash_leads_to_item(&state))
}

fn parser_is_file_rule(name: String) -> Bool Never! {
    name == "PubFile" || name == "NoPrelude" || name == "Target" || name == "HTML" || name == "Html"
}

// Rust `marker_list_is_file_rules`: a `#[…]` list whose every entry is a file
// rule configures the file, unless it heads a type, or every entry is a
// partition `#Target` that the function below can take (`#[Target(JS)] fn`).
fn parser_file_marker_group_ahead(state: &JetParserState) -> Bool Never! {
    offset := 2
    every_entry_fits_function := true
    loop {
        if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
        name :: parser_lookahead(&state, offset)
        if name.kind != TOKEN_IDENT || !parser_is_file_rule(name.payload.decoded) -> return false
        if name.payload.decoded != "Target" || parser_target_selects_file_web_at(&state, offset) -> every_entry_fits_function = false
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LPAREN {
            depth := 0
            loop {
                kind :: parser_kind_at(&state, offset)
                if kind == TOKEN_EOF -> return false
                offset += 1
                if kind == TOKEN_LPAREN -> depth += 1
                if kind == TOKEN_RPAREN {
                    depth -= 1
                    if depth == 0 -> break
                }
            }
        }
        if parser_kind_at(&state, offset) == TOKEN_COMMA {
            offset += 1
            next
        }
        if parser_kind_at(&state, offset) != TOKEN_RBRACKET -> return false
        offset += 1
        break
    }
    loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
    after :: parser_kind_at(&state, offset)
    if after == TOKEN_KW_STRUCT || after == TOKEN_KW_ENUM -> return false
    function_follows :: after == TOKEN_KW_FN || (after == TOKEN_KW_PUB && parser_kind_at(&state, offset + 1) == TOKEN_KW_FN) || parser_prep_verb_ahead(&state, offset, TOKEN_KW_FN) || after == TOKEN_HASH
    !(every_entry_fits_function && function_follows)
}

// Rust `target_marker_selects_file_web_at`: `#Target(Web)` (or a path ending
// in `Target.Web`) is the file default, never a marker on the next item.
// `name_offset` is the offset of the `Target` name.
fn parser_target_selects_file_web_at(state: &JetParserState, name_offset: Int) -> Bool Never! {
    if parser_kind_at(&state, name_offset + 1) != TOKEN_LPAREN -> return false
    previous := ""
    last := ""
    count := 0
    offset := name_offset + 2
    loop {
        token :: parser_lookahead(&state, offset)
        if token.kind == TOKEN_RPAREN -> break
        if token.kind != TOKEN_IDENT && token.kind != TOKEN_DOT -> return false
        if token.kind == TOKEN_IDENT {
            previous = last
            last = token.payload.decoded
            count += 1
        }
        offset += 1
    }
    last == "Web" && (count == 1 || previous == "Target")
}

// One run of file rules, bare or in `#[…]` lists. Two distinct rules belong
// in one list (E0999); each rule then sets its program field.
fn parser_parse_file_directive(state: &JetParserState, program: &Program) {
    markers := [Marker]{}
    chunks := 0
    bracket_chunks := 0
    sequence := parser_current(&state).span
    loop parser_file_directive_ahead(&state) && !parser_aborting(&state) {
        if parser_kind_at(&state, 1) == TOKEN_LBRACKET {
            group :: parser_parse_marker_group_list(&state)
            loop marker in group.markers -> &markers.push(marker)
            sequence.end = group.span.end
            bracket_chunks += 1
        } else {
            marker :: parser_parse_marker(&state)
            &markers.push(marker)
            sequence.end = marker.span.end
            parser_skip_semicolons(&state)
        }
        chunks += 1
    }
    parser_report_adjacent_markers(&state, markers, chunks, bracket_chunks, sequence, "file")
    single :: chunks == 1 && bracket_chunks == 0
    loop marker in markers -> parser_apply_file_marker(&state, &program, marker, single)
}

fn parser_apply_file_marker(state: &JetParserState, program: &Program, marker: Marker, single: Bool) {
    hash :: Span{start: marker.span.start, end: marker.span.start + 1}
    repeat_span :: if single -> hash else -> marker.span
    if marker.name == {
        "PubFile" | "PublicFile" -> {
            if marker.name == "PublicFile" -> parser_add_error_code(&state, "E0418", hash, "write `#PubFile`, not `#PublicFile`", "`#PubFile` flips this file to public-by-default (D-VISDEFAULT2)", "write `#PubFile` at the top of the file")
            if program.pub_file {
                parser_report_repeated_file_marker(&state, "PubFile", repeat_span)
                return
            }
            program.pub_file = true
            state.pub_file_default = true
        }
        "NoPrelude" -> {
            if program.no_prelude {
                parser_report_repeated_file_marker(&state, "NoPrelude", repeat_span)
                return
            }
            program.no_prelude = true
        }
        "Target" -> parser_apply_file_target(&state, &program, marker, single)
        "HTML" -> {
            if program.html_path != None {
                parser_add_error(&state, marker.span, "only one `#HTML(…)` marker is allowed per file", "a file may declare at most one companion host page", "remove the duplicate `#HTML(…)` marker")
                return
            }
            values :: parser_bind_marker_arguments(&state, marker, [String]{"page"}, 1) ?? return
            page :: values[0] ?? return
            program.html_path = parser_html_page_path(page)
        }
        "Html" -> parser_add_error_code(&state, "E0927", marker.name_span, "`#Html` is retired", "the registry keeps this old spelling only to teach its replacement; it no longer applies a rule", "write `#HTML` instead")
        else -> {}
    }
}

fn parser_report_repeated_file_marker(state: &JetParserState, name: String, span: Span) {
    parser_add_error_code(&state, "E0999", span, "`#{name}` is already applied to this file", "`#{name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
}

// Rust `html_from_marker`: the companion page is `Path{"page.html"}` or a
// plain literal string; any other value names no page.
fn parser_html_page_path(page: Expr) -> String? {
    if page == .TypedLit(head, body, _) && head == .Val(ty) && ty == .Named(type_name) && type_name == "Path" && body == .Value(inner) -> return parser_expr_literal_string(inner)
    parser_expr_literal_string(page)
}

// D-WASM1=A / D-WEBDEFAULT1 / D-OSTARGET1=A (Rust `web_target_from_marker`):
// `#Target(Web)` picks the file's default CLI backend, `#Target(Wasm|JS)`
// caps its web partition, and `#Target(OS.…)` only gates an `impl`.
fn parser_apply_file_target(state: &JetParserState, program: &Program, marker: Marker, single: Bool) {
    values :: parser_bind_marker_arguments(&state, marker, [String]{"target"}, 1) ?? return
    target :: values[0] ?? return
    written :: parser_marker_ident_path(target) ?? {
        parser_marker_shape_error(&state, marker)
        return
    }
    // Rust `strip_marker_enum_prefix`: the path after the first `Target`
    // segment, when one follows it.
    segments :: written.split(".").to_list()
    kept := [String]{}
    stripped := false
    loop (index, segment) in segments {
        if !stripped && segment == "Target" && index + 1 < segments.len() {
            stripped = true
            kept = [String]{}
            next
        }
        &kept.push(segment)
    }
    name :: kept.join(".")
    here :: parser_current(&state).span
    if kept.len() == 2 && kept[0] == "OS" {
        os :: kept[1]
        if os != "Linux" && os != "MacOS" && os != "Windows" {
            parser_add_error(&state, expr_span(target), "`#Target(OS.{os})` is not a known native OS", "native OS targets are `OS.Linux`, `OS.MacOS`, or `OS.Windows`", "write `#Target(OS.Linux)`, `#Target(OS.MacOS)`, or `#Target(OS.Windows)`")
            return
        }
        if single {
            parser_add_error(&state, here, "`#Target(OS.{os})` isn't valid here", "`OS.Linux`/`OS.MacOS`/`OS.Windows` gates a whole `impl` block, not a module, function, or any other item", "write `#Target(OS.{os}) impl Type.Trait {{ … }}`")
        } else {
            parser_report_grouped_target_conflict(&state, marker)
        }
        return
    }
    if name == "Web" {
        if single && parser_current_kind(&state) == TOKEN_KW_MODULE {
            parser_add_error(&state, here, "`#Target(Web)` isn't valid on a module", "`Web` is a file-level default-backend marker, not a partition ceiling", "move `#Target(Web)` to the top of the file, outside any module; use `#Target(Wasm)` or `#Target(JS)` on a module")
            return
        }
        if program.default_target != None {
            if single {
                parser_add_error(&state, here, "only one `#Target(Web)` marker is allowed per file", "a file may declare at most one default backend", "remove the duplicate `#Target(Web)` marker")
            } else {
                parser_report_grouped_target_conflict(&state, marker)
            }
            return
        }
        program.default_target = Val("web")
        return
    }
    bucket :: if name == {
        "Wasm" -> Val(WebBucket.Wasm)
        "JS" -> Val(WebBucket.JS)
        else -> WebBucket?{None}
    }
    if bucket == None {
        parser_add_error(&state, expr_span(target), "`#Target({name})` is not a known web partition", "web targets are `Wasm` (compute), `JS` (DOM/view), `Web` (default CLI backend), or `OS.Linux`/`OS.MacOS`/`OS.Windows` (native platform gating)", "write `#Target(Wasm)`, `#Target(JS)`, `#Target(Web)`, or `#Target(OS.{{Linux|MacOS|Windows}})`")
        return
    }
    if program.web_target_ceiling != None {
        if single {
            parser_add_error(&state, here, "only one `#Target(…)` ceiling is allowed per file", "a file may declare at most one web partition ceiling", "remove the duplicate `#Target(Wasm)` or `#Target(JS)` marker")
        } else {
            parser_report_grouped_target_conflict(&state, marker)
        }
        return
    }
    program.web_target_ceiling = bucket
}

fn parser_report_grouped_target_conflict(state: &JetParserState, marker: Marker) {
    parser_add_error(&state, marker.span, "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`")
}

// D-VISDEFAULT2=A: `pub:` / `priv:` section labels would let one line flip
// the visibility of everything below it; E0415 rejects the label itself.
fn parser_section_label_ahead(state: &JetParserState) -> Bool Never! {
    if parser_kind_at(&state, 1) != TOKEN_COLON -> return false
    token :: parser_current(&state)
    token.kind == TOKEN_KW_PUB || token.kind == TOKEN_KW_PRIV || (token.kind == TOKEN_IDENT && token.payload.decoded == "private")
}

fn parser_report_section_label(state: &JetParserState) {
    first :: parser_bump(&state)
    colon :: parser_bump(&state)
    parser_add_error_code(&state, "E0415", parser_cover(first.span, colon.span), "section visibility labels like `pub:` / `priv:` are not supported", "moving an item above or below a label would silently change whether it exports", "write `#PubFile` once at the top of the file, then mark exceptions with `priv`")
}

fn parser_item_ahead(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    token :: parser_current(&state)
    if {
        parser_comptime_const_ahead(&state, 0) -> true
        parser_item_declaration_ahead_at(&state, 0) -> true
        parser_template_loop_ahead(&state) -> true
        parser_is_item_keyword(kind) -> true
        kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_COMPTIME -> true
        token.kind == TOKEN_IDENT && token.payload.decoded == "alias" -> true
        token.kind == TOKEN_IDENT && token.payload.decoded == "private" -> parser_foreign_private_ahead(&state)
        token.kind == TOKEN_IDENT && token.payload.decoded == "sanitizer" -> parser_kind_at(&state, 1) == TOKEN_KW_FN || parser_kind_at(&state, 1) == TOKEN_KW_PUB
        kind == TOKEN_HASH -> parser_hash_leads_to_item(&state)
        else -> false
    }
}

fn parser_is_item_keyword(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_CONST || kind == TOKEN_KW_USE || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_EFFECT || kind == TOKEN_KW_TAG || kind == TOKEN_KW_EXTERN || kind == TOKEN_KW_DERIVE
}

fn parser_comptime_const_ahead(state: &JetParserState, offset: Int) -> Bool Never! {
    parser_kind_at(&state, offset) == TOKEN_AT && parser_kind_at(&state, offset + 1) == TOKEN_IDENT && parser_kind_at(&state, offset + 2) == TOKEN_COLON_COLON
}

// D-PREP-SURFACE2=A + owner ruling (2026-09-30): an immutable module binding
// is named in ALL_CAPS, `MAX_ROWS :: 100`. This is the casing predicate only;
// compile time is always the explicit `NAME :: prep { value }`.
fn parser_constant_name(name: String) -> Bool Never! {
    if name == "" || name.starts_with("@") || name.starts_with("$") -> return false
    has_upper := false
    loop byte in name.bytes() {
        if byte >= (U8{97}) && byte <= (U8{122}) -> return false
        if byte >= (U8{65}) && byte <= (U8{90}) -> has_upper = true
    }
    has_upper
}

// D-CONSTMARK1: after `#Static` / `#Inline`, a constant binding `NAME :: …`
// (or a retired `@`-marked name, which E0388 respells) is a declaration.
fn parser_marked_const_ahead(state: &JetParserState, offset: Int) -> Bool Never! {
    token :: parser_lookahead(&state, offset)
    token.kind == TOKEN_IDENT && parser_kind_at(&state, offset + 1) == TOKEN_COLON_COLON && (token.payload.decoded.starts_with("@") || parser_constant_name(token.payload.decoded))
}

// D-PREP-SURFACE2=A: a retired `@`-marked constant read (or a declaration whose
// value is already `prep { … }`) teaches E0388 with the behavior-preserving
// respelling, and the parse continues under the plain name so each mention
// reports once.
fn parser_retire_const_mark(state: &JetParserState, token: Token) -> String {
    name :: token.payload.decoded
    if !name.starts_with("@") -> return name
    bytes :: name.bytes()
    // A block-scope name stays an ordinary snake_case local; only a module
    // constant is ALL_CAPS, so the mark is dropped and the case kept.
    plain :: String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    diagnostic :: diagnostic_from_registry("E0388", Val(token.span), "`{name}` is retired; write `{plain}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{name}` with `{plain}`")
    &state.diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: token.span, new_text: plain}, FixApplicability.Safe, FixSafety.BehaviorPreserving))
    plain
}

// D-PREP-SURFACE2=A: a retired `@name :: value` declaration always meant
// compile time, so E0388 teaches `name :: prep { value }` and the parse
// continues under the plain name as that prepared binding.
fn parser_retire_const_decl(state: &JetParserState, span: Span, old: String) -> String {
    bytes :: old.bytes()
    plain :: String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    parser_add_error_code(&state, "E0388", span, "`{old}` is retired; write `{plain} :: prep {{ value }}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{old} :: value` with `{plain} :: prep {{ value }}`")
    plain
}

// An `@`-marked read names a retired constant when the name under the mark
// is ALL_CAPS or this file declares that marked name with `::`; a called
// marked root is a retired metadata query, not a constant.
fn parser_reads_retired_constant(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    name :: token.payload.decoded
    if token.kind != TOKEN_IDENT || !name.starts_with("@") || parser_kind_at(&state, 1) == TOKEN_LPAREN -> return false
    bytes :: name.bytes()
    if parser_constant_name(String.from_bytes(bytes.slice(1, bytes.len())) ?? "") -> return true
    loop index in 0..<state.tokens.len() {
        candidate :: state.tokens[index]
        if candidate.kind == TOKEN_IDENT && candidate.payload.decoded == name && index + 1 < state.tokens.len() && state.tokens[index + 1].kind == TOKEN_COLON_COLON -> return true
    }
    false
}

// Rust `marker_sequence_leads_to_function`: newline terminators between the
// markers and before the item are skipped, so `#[A, B]` on its own line still
// attaches to the item below.
fn parser_hash_leads_to_item(state: &JetParserState) -> Bool Never! {
    offset := 0
    loop {
        loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
        if parser_item_declaration_ahead_at(&state, offset) -> return true
        if parser_kind_at(&state, offset) != TOKEN_HASH -> break
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LBRACKET {
            offset += 1
            nesting := 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LBRACKET -> nesting += 1
                    TOKEN_RBRACKET -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
            next
        }
        if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
        if parser_kind_at(&state, offset) != TOKEN_IDENT -> return false
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LPAREN {
            nesting := 1
            offset += 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LPAREN -> nesting += 1
                    TOKEN_RPAREN -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
        }
    }
    loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
    kind :: parser_kind_at(&state, offset)
    parser_item_declaration_ahead_at(&state, offset) || parser_comptime_const_ahead(&state, offset) || parser_marked_const_ahead(&state, offset) || parser_is_item_keyword(kind) || (kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_KW_COMPTIME) || (kind == TOKEN_IDENT && parser_lookahead(&state, offset).payload.decoded == "alias")
}

// Rust: Parser/mod.rs::parse_inner/parse_for_check_inner. Keep the recovered
// parser API distinct from admission: a rejected AST is never a fmt success.
pub struct JetParseAdmission {
    pub program: Program?
    pub diagnostics: [Diagnostic]
}
pub fn parse_strict_source(source: [U8]) -> JetParseAdmission {
    parsed :: parse_source(source)
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == 1 -> return JetParseAdmission{program: None, diagnostics: parsed.diagnostics}
    }
    JetParseAdmission{program: Val(parsed.program), diagnostics: [Diagnostic]{}}
}
// Rust Parser/mod.rs::parse_with_source: strict admission from the caller's
// already lexed tokens and their exact original bytes, without lexing twice.
pub fn parse_with_source(tokens: [Token], source: [U8]) -> JetParseAdmission {
    parsed :: parser_parse_lexed_lines(Lexed{tokens: tokens, diagnostics: [Diagnostic]{}}, source, parser_line_starts(source))
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == 1 -> return JetParseAdmission{program: None, diagnostics: parsed.diagnostics}
    }
    JetParseAdmission{program: Val(parsed.program), diagnostics: [Diagnostic]{}}
}
pub fn parse_for_check_with_source(tokens: [Token], source: [U8]) -> JetParseAdmission {
    parsed :: parser_parse_lexed_lines(Lexed{tokens: tokens, diagnostics: [Diagnostic]{}}, source, parser_line_starts(source))
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity != 2 && !parser_is_teaching_parse_diag(diagnostic.code) && diagnostic.code != "E0081" -> return JetParseAdmission{program: None, diagnostics: parsed.diagnostics}
    }
    JetParseAdmission{program: Val(parsed.program), diagnostics: parsed.diagnostics}
}
pub fn parse_for_fmt(tokens: [Token]) -> JetParseAdmission {
    parsed :: parse_tokens(tokens)
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == 1 && !parser_is_teaching_parse_diag(diagnostic.code) -> return JetParseAdmission{program: None, diagnostics: parsed.diagnostics}
    }
    JetParseAdmission{program: Val(parsed.program), diagnostics: [Diagnostic]{}}
}
// Rust: Parser/mod.rs::is_teaching_parse_diag. This is the parser's single
// recovered-diagnostic admission catalog, shared by check and formatting.
fn parser_is_teaching_parse_diag(code: String) -> Bool Never! {
    if code == {
        "E0031" | "E0034" | "E0048" | "E0049" | "E0055" | "E0057" |
        "E0065" | "E0066" | "E0068" | "E0070" | "E0080" | "E0082" |
        "E0077" | "E0146" | "E0154" | "E0210" | "E0986" | "E0320" |
        "E0992" | "E0994" | "E0366" | "E0367" | "E0372" | "E0373" |
        "E0374" | "E0378" | "E0379" | "E0383" | "E0384" | "E0385" |
        "E0386" | "E0999" | "E0412" | "E0413" | "E0414" | "E0415" |
        "E0417" | "E0418" | "E0998" | "E0927" | "E1115" -> true
        else -> false
    }
}
