// Public parser entry points preserve lexer diagnostics and original byte spans.
use {
    jet_foundation.[
        AppliedRuleApplication,
        CompilerThreads,
        DIAGNOSTIC_ERROR,
        DebugTraceSite,
        Diagnostic,
        ElseArmSpan,
        Expr,
        FencedStatement,
        ImportDecl,
        Item,
        MARKER_FX,
        MARKER_HTML,
        MARKER_NO_PRELUDE,
        MARKER_TARGET,
        Marker,
        Name,
        NameTable,
        ParseResult,
        PolicyDeclaration,
        Program,
        RuleSite,
        Span,
        Stmt,
        Type,
        UserPolicyDecl,
        WebBucket,
        ast_program,
        compiler_threads_admit,
        compiler_threads_failure_text,
        compiler_transfer_rows,
        expr_span,
        name_count,
        name_empty,
        name_find,
        name_index,
        name_intern,
        name_intern_bytes,
        name_start,
        name_table_sized,
        name_text,
        sema_casing_marker_qualifier,
        target_os_gates,
        target_os_named,
        type_name,
    ]
    jet_lexer.[
        Lexed,
        STRING_PART_INTERPOLATION,
        StringPart,
        TOKEN_AMP_TILDE_EQ,
        TOKEN_AT,
        TOKEN_BANG,
        TOKEN_BLOCK_COMMENT,
        TOKEN_CHAR,
        TOKEN_COLON,
        TOKEN_COLON_COLON,
        TOKEN_COMMA,
        TOKEN_COLON_EQ,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_EQ,
        TOKEN_FALSE,
        TOKEN_FENCE_CLOSE,
        TOKEN_FENCE_OPEN,
        TOKEN_FLOAT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_INT,
        TOKEN_KW_ENUM,
        TOKEN_KW_EXTERN,
        TOKEN_KW_FN,
        TOKEN_KW_IF,
        TOKEN_KW_IMPL,
        TOKEN_KW_IN,
        TOKEN_KW_LOOP,
        TOKEN_KW_MODULE,
        TOKEN_KW_PRIV,
        TOKEN_KW_STRUCT,
        TOKEN_KW_TRAIT,
        TOKEN_KW_USE,
        TOKEN_LBRACE,
        TOKEN_LINE_COMMENT,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_NULL,
        TOKEN_PLUS_EQ,
        TOKEN_PREP,
        TOKEN_QUESTION,
        TOKEN_QUESTION_DOT,
        TOKEN_RAW_STRING,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RETURN,
        TOKEN_RPAREN,
        TOKEN_SELF,
        TOKEN_SEMI,
        TOKEN_SHR_EQ,
        TOKEN_STAR,
        TOKEN_STRING,
        TOKEN_TILDE_EQ,
        TOKEN_TILDE_PIPE_EQ,
        TOKEN_TRUE,
        TOKEN_UNIFIED_ARROW,
        TOKEN_UNIT_NUMBER,
        Token,
        TokenLiteral,
        TokenTables,
        lex,
        lex_chunks_threads,
        lex_generated,
        token_decoded,
        token_tables,
    ]
}

parse_source: fn(source: [U8]) -> ParseResult {
    parser_join_effect_impls(parse_source_layout(source))
}

// `parse_source` on the admitted compiler threads: lexes into per-chunk
// `LexedChunk`s and parses each chunk directly with its own `TokenTables`,
// `tokens`, `line_starts` and chunk source slice, joining in source order.
parse_source_threads: fn(source: [U8], threads: CompilerThreads) -> ParseResult {
    parser_join_effect_impls(parser_parse_source_lines_threads(source, false, threads))
}

// `parse_generated_source` on the admitted compiler threads.
parse_generated_source_threads: fn(source: [U8], threads: CompilerThreads) -> ParseResult {
    parser_join_effect_impls(parser_parse_source_lines_threads(source, true, threads))
}

// `text` as exactly one type: read as the type of a struct's one field, it
// parses with no diagnostic, the struct is the only item and has that one
// field and nothing else, and the field's type spans the whole text, so
// nothing in it ends the struct, adds a field or gives a default. None for
// any other text.
parse_type_text: fn(text: String) -> Type? Never! {
    lead: "Probe: struct {{\n    probe: "
    parsed: parse_source("{lead}{text}\n}}\n".bytes())
    if parsed.diagnostics.len() != 0 || parsed.program.imports.len() != 0 || parsed.program.items.len() != 1 {
        return None
    }
    if parsed.program.items[0] == .Struct(definition) {
        if definition.fields.len() != 1 || definition.methods.len() != 0 || definition.trait_impls.len() != 0 || definition.state == .Val(_) {
            return None
        }
        field: definition.fields[0]
        if field.default == .Val(_) || field.computed == .Val(_) || field.serde_markers.len() != 0 {
            return None
        }
        if field.name != "probe" || field.ty_span.start != lead.len() || field.ty_span.end != lead.len() + text.len() {
            return None
        }
        return Val(field.ty)
    }
    None
}

// Embedded Core library sources are vetted stdlib internals: they may spell the
// reserved `__name` namespace. The loader's embedded-Core path and
// compiler-generated call arguments (core.testing histories, #6410) parse this
// way; a user file never does.
parse_generated_source: fn(source: [U8]) -> ParseResult {
    parser_join_effect_impls(parse_generated_layout(source))
}

// The program as written, for the formatter: an `impl Name.Effect` block
// outside its type stays where it is written instead of joining the type
// (parser_join_effect_impls).
parse_source_layout: fn(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex(source), source, parser_line_starts(source), false)
}

// parse_source_layout lexed as parse_generated_source.
parse_generated_layout: fn(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex_generated(source), source, parser_line_starts(source), false)
}

// The parse entry points take the caller's tokens: they move into the parser
// instead of being copied.
parse_lexed: fn(lexed: ^^Lexed) -> ParseResult {
    parser_join_effect_impls(parser_parse_lexed_lines(lexed, [U8]{}, [Int]{}, false))
}

// Parse just the supplied token slice with its aggregate source available for
// canonical source-dependent diagnostics. REPL turns never reparse old tokens.
parse_lexed_with_source: fn(lexed: ^^Lexed, source: [U8], line_starts: [Int]) -> ParseResult {
    parser_join_effect_impls(parser_parse_lexed_lines(lexed, source, line_starts, false))
}

// parse_lexed_with_source on the admitted compiler threads: a large source
// is cut at top-level item boundaries and its chunks parse at once. `runs`
// are the lexer's item runs (`LexedThreads.runs`: `[0, r1, …, tokens.len()]`,
// each later run starting with the terminator of the item before it and
// then an item head, delimiters nesting within every run), where the cut
// scan itself runs in parallel; `[0, tokens.len()]` scans on this thread.
parse_lexed_with_source_threads: fn(lexed: ^^Lexed, source: [U8], line_starts: [Int], runs: [Int], threads: CompilerThreads) -> ParseResult {
    parser_join_effect_impls(parser_parse_lexed_lines_threads(lexed, source, line_starts, runs, false, threads))
}

// Parse a Jetpack config surface: the config lexer keeps `$NAME` as one
// identifier token, which this parser reads as the typed environment read
// `source` stays available for config values whose spelling is not a general
// Jet expression.
parse_config_with_source: fn(lexed: ^^Lexed, source: [U8]) -> ParseResult {
    parser_join_effect_impls(parser_parse_lexed_lines(lexed, source, parser_line_starts(source), true))
}

// A parsed file with every `impl Name.Effect` block written outside its type
// joined to the type (parser_attach_effect_impls), and every
// `impl Trait.Derive` block given its trait's visibility
// (parser_join_derive_visibility), once the whole file is read: a chunked
// parse sees the type or trait and the block in different chunks.
parser_join_effect_impls: fn(input: ^^ParseResult) -> ParseResult {
    result := input.move()
    derives: parser_derives_written(result.program.items)
    effects: parser_effect_impls_outside(result.program.items)
    if !derives && !effects -> return result
    items := result.program.items.move()
    if derives -> parser_join_derive_visibility(items)
    if effects -> parser_attach_effect_impls(items, result.diagnostics)
    result.program.items = items.move()
    result
}

// The lexed tokens move into the parser state (field moves reset the field,
// so no token list is copied on the way). One thread: this entry spawns
// nothing, so it stays infallible for the `Never!` callers of the parse
// entry points above.
parser_parse_lexed_lines: fn(input: ^^Lexed, source: [U8], line_starts: [Int], allow_environment_reads: Bool) -> ParseResult {
    lexed := input.move()
    source_end: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    tokens := lexed.tokens.move()
    lexed.tokens = [Token]{}
    prepared := parser_prepare_tokens(tokens, lexed.tables)
    parser_parse_prepared(prepared, lexed.diagnostics, source_end, line_starts, source, allow_environment_reads, lexed.tables.move())
}

// Parallel source-to-AST parse: lexes into per-chunk `LexedChunk`s directly
// without flattening tokens or merging `TokenTables`, runs parallel per-chunk
// `ColonDeclarations`, validation, parsing, and post-passes, and falls back
// to one-thread parsing on fences, whole-file directives, or parse errors.
parser_parse_source_lines_threads: fn(source: [U8], allow_reserved_identifiers: Bool, threads: CompilerThreads) -> ParseResult {
    lexed_chunks := lex_chunks_threads(source, false, allow_reserved_identifiers, threads)
    chunk_count: lexed_chunks.chunks.len()
    if chunk_count == 0 {
        return if allow_reserved_identifiers -> parse_generated_layout(source) else -> parse_source_layout(source)
    }
    if chunk_count == 1 {
        only := lexed_chunks.chunks.pop() ?? panic("missing single chunk")
        diagnostics := only.diagnostics.move()
        compiler_transfer_rows<Diagnostic>(diagnostics, only.bidi_diagnostics)
        compiler_transfer_rows<Diagnostic>(diagnostics, only.terminator_diagnostics)
        return parser_parse_lexed_lines(Lexed{tokens: only.tokens.move(), tables: only.tables.move(), diagnostics: diagnostics.move()}, source, only.line_starts.move(), false)
    }
    if lexed_chunks.has_fences {
        return if allow_reserved_identifiers -> parse_generated_layout(source) else -> parse_source_layout(source)
    }
    total_tokens := 0
    loop chunk in lexed_chunks.chunks -> total_tokens += chunk.tokens.len()
    workers: compiler_threads_admit(threads, total_tokens, total_tokens, PARSER_CHUNK_MIN_TOKENS, (source.len() /% 16 + 1) * PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE, 0)
    if workers <= 1 {
        return if allow_reserved_identifiers -> parse_generated_layout(source) else -> parse_source_layout(source)
    }
    last_chunk: lexed_chunks.chunks[chunk_count - 1]
    source_end: if last_chunk.tokens.len() > 0 -> last_chunk.tokens[last_chunk.tokens.len() - 1].span.start else -> source.len()
    lexer_diagnostics := [Diagnostic]{}
    bidi_diagnostics := [Diagnostic]{}
    terminator_diagnostics := [Diagnostic]{}
    slots := [Shared<ParserChunkSlot>]{}
    slots.try_reserve(chunk_count) ?? panic("reserve failed")
    line_base := 0
    index := 0
    loop raw_chunk in lexed_chunks.chunks.move() {
        chunk := raw_chunk.move()
        compiler_transfer_rows<Diagnostic>(lexer_diagnostics, chunk.diagnostics)
        compiler_transfer_rows<Diagnostic>(bidi_diagnostics, chunk.bidi_diagnostics)
        compiler_transfer_rows<Diagnostic>(terminator_diagnostics, chunk.terminator_diagnostics)
        chunk_line_count: chunk.line_starts.len()
        empty_colon: ParserColonLocal{candidates: [ParserColonInstance]{}, declared_modules: [Int]{}, declared_others: [Int]{}, clean: true}
        prepared: ParserChunkPrepared{tokens: chunk.tokens.move(), tables: chunk.tables.move(), source: [U8]{}, source_offset: chunk.start, line_starts: chunk.line_starts.move(), line_base: line_base, colon: empty_colon, marker_scopes: [ParserMarkerScope]{}, whole: false, fences: false}
        slots.push(Shared{ParserChunkSlot{index: index, is_last: index + 1 == chunk_count, tok_start: 0, tok_end: 0, byte_start: chunk.start, byte_end: chunk.end, line_idx_start: line_base, line_idx_end: line_base + chunk_line_count, needs_colon: true, prepared: [ParserChunkPrepared]{prepared.move()}, chosen_heads: [Int]{}, outputs: [ParserChunkOutput]{}}})
        line_base += chunk_line_count
        index += 1
    }
    compiler_transfer_rows<Diagnostic>(lexer_diagnostics, bidi_diagnostics)
    compiler_transfer_rows<Diagnostic>(lexer_diagnostics, terminator_diagnostics)
    _ := parser_prepare_direct_slots(source, slots, 0)
    outcome := parser_finish_prepared_slots(slots, source, source_end, false, lexer_diagnostics, [FencedStatement]{})
    if outcome.ok -> return outcome.result.move()
    if allow_reserved_identifiers -> parse_generated_layout(source) else -> parse_source_layout(source)
}

// parser_parse_lexed_lines on the admitted compiler threads. With multiple
// lexer item runs and no fences, each chunk slices only its own tokens,
// compact `TokenTables`, `source` slice, and `line_starts` slice, runs
// map-reduce `ColonDeclarations`, validates boundaries, parses, and runs
// post-passes in parallel. Any file with fences routes through whole-file
// `FencedNames` expansion so `ParserFenceBudget` remains exact.
parser_parse_lexed_lines_threads: fn(input: ^^Lexed, source: [U8], line_starts: [Int], runs: [Int], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    lexed := input.move()
    source_end: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    tokens := lexed.tokens.move()
    tables := lexed.tables.move()
    diagnostics := lexed.diagnostics.move()
    if runs.len() <= 2 || tables.has_fences {
        return parser_parse_tokens_threads(tokens, tables, diagnostics, source_end, line_starts, source, allow_environment_reads, threads)
    }
    parser_parse_runs_threads(tokens, tables, diagnostics, source_end, line_starts, source, runs, allow_environment_reads, threads)
}

// The item-run route: groups `runs` into admitted worker chunks, slices each
// chunk's tokens/compact tables/source/line_starts in parallel, map-reduces
// `ColonDeclarations` and post-passes, and falls back to untouched original
// `tokens`/`tables` if any chunk reports fences, whole-file rules, or errors.
// Runs that fit the workers are the chunk bounds as they are.
parser_parse_runs_threads: fn(input: ^^[Token], tables_input: ^^TokenTables, lexer_diagnostics: ^^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], runs: [Int], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    tokens := input.move()
    tables := tables_input.move()
    diagnostics := lexer_diagnostics.move()
    count: tokens.len()
    workers: compiler_threads_admit(threads, count, count, PARSER_CHUNK_MIN_TOKENS, (source.len() /% 16 + 1) * PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE, 0)
    if workers <= 1 {
        prepared := parser_prepare_tokens(tokens.move(), tables)
        return parser_parse_prepared(prepared, diagnostics, source_end, line_starts, source, allow_environment_reads, tables.move())
    }
    if runs.len() - 1 <= workers {
        return parser_parse_run_chunks(tokens.move(), tables.move(), diagnostics.move(), source_end, line_starts, source, runs, threads, allow_environment_reads: allow_environment_reads)
    }
    parser_parse_run_chunks(tokens.move(), tables.move(), diagnostics.move(), source_end, line_starts, source, parser_group_run_bounds(runs, workers), threads, allow_environment_reads: allow_environment_reads)
}

// parser_parse_runs_threads over the chunk token `bounds` (`[0, b1, …,
// tokens.len()]`, each on a run start).
parser_parse_run_chunks: fn(input: ^^[Token], tables_input: ^^TokenTables, lexer_diagnostics: ^^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], bounds: [Int], threads: CompilerThreads, allow_environment_reads: Bool{false}) -> ParseResult {
    tokens: input.move()
    tables := tables_input.move()
    diagnostics: lexer_diagnostics.move()
    if bounds.len() <= 2 {
        return parser_parse_tokens_threads(tokens.move(), tables.move(), diagnostics.move(), source_end, line_starts, source, allow_environment_reads, threads)
    }
    byte_bounds: parser_chunk_byte_bounds(tokens, bounds, source)
    chunk_count: bounds.len() - 1
    slots := [Shared<ParserChunkSlot>]{}
    slots.try_reserve(chunk_count) ?? panic("reserve failed")
    loop chunk in 0..<chunk_count {
        line_lo: if line_starts.len() > 0 -> parser_line_starts_lower_bound(line_starts, byte_bounds[chunk]) else -> 0
        line_hi: if line_starts.len() > 0 -> if chunk + 1 == chunk_count -> line_starts.len() else -> parser_line_starts_lower_bound(line_starts, byte_bounds[chunk + 1]) else -> 0
        slots.push(Shared{ParserChunkSlot{index: chunk, is_last: chunk + 1 == chunk_count, tok_start: bounds[chunk], tok_end: bounds[chunk + 1], byte_start: byte_bounds[chunk], byte_end: byte_bounds[chunk + 1], line_idx_start: line_lo, line_idx_end: line_hi, needs_colon: true, prepared: [ParserChunkPrepared]{}, chosen_heads: [Int]{}, outputs: [ParserChunkOutput]{}}})
    }
    _ := parser_prepare_sliced_slots(tokens, tables, source, line_starts, true, slots, 0)
    outcome := parser_finish_prepared_slots(slots, source, source_end, allow_environment_reads, diagnostics, [FencedStatement]{})
    if outcome.ok -> return outcome.result.move()
    if outcome.fences {
        return parser_parse_tokens_threads(tokens.move(), tables.move(), diagnostics.move(), source_end, line_starts, source, allow_environment_reads, threads)
    }
    prepared := parser_prepare_tokens(tokens.move(), tables)
    parser_parse_prepared(prepared, diagnostics, source_end, line_starts, source, allow_environment_reads, tables.move())
}

// The one-run route: colon declarations and whole-file fence expansion first,
// then chunked parsing when `parser_chunk_bounds` admits multiple chunks.
parser_parse_tokens_threads: fn(input: ^^[Token], tables_input: ^^TokenTables, lexer_diagnostics: ^^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    tables := tables_input.move()
    prepared := parser_prepare_tokens(input, tables)
    parser_parse_expansion_threads(prepared, tables, lexer_diagnostics, source_end, line_starts, source, allow_environment_reads, threads)
}

parser_parse_expansion_threads: fn(input: ^^ParserFenceExpansion, tables_input: ^^TokenTables, lexer_diagnostics: ^^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    tables := tables_input.move()
    diagnostics := lexer_diagnostics.move()
    prepared := input.move()
    bounds: if prepared.diagnostics.len() > 0 -> [Int]{} else -> parser_chunk_bounds(prepared.tokens, tables, source, threads)
    if bounds.len() <= 2 {
        return parser_parse_prepared(prepared, diagnostics, source_end, line_starts, source, allow_environment_reads, tables)
    }
    parser_parse_chunked(prepared, bounds, diagnostics, source_end, line_starts, source, allow_environment_reads, tables)
}

parser_line_starts: fn(source: [U8]) -> [Int] Never! {
    count: source.len()
    starts := [Int]{}
    if count > 0 -> starts.try_reserve(count /% 32 + 2) ?? panic("reserve failed")
    starts.push(0)
    index := 0
    loop index + 4 <= count {
        if source[index] == (U8{10}) -> starts.push(index + 1)
        if source[index + 1] == (U8{10}) -> starts.push(index + 2)
        if source[index + 2] == (U8{10}) -> starts.push(index + 3)
        if source[index + 3] == (U8{10}) -> starts.push(index + 4)
        index += 4
    }
    loop index < count {
        if source[index] == (U8{10}) -> starts.push(index + 1)
        index += 1
    }
    starts
}

parse_tokens: fn(tokens: [Token], tables: TokenTables) -> ParseResult {
    source_end: if {
        tokens.len() > 0 -> {
            last: tokens[tokens.len() - 1]
            if last.kind == TOKEN_EOF -> last.span.start else -> last.span.end
        }
        else -> 0
    }
    owned_tables := tables.copy()
    prepared := parser_prepare_tokens(tokens.copy(), owned_tables)
    parser_join_effect_impls(parser_parse_prepared(prepared, [Diagnostic]{}, source_end, [Int]{}, [U8]{}, false, owned_tables))
}

// Fence expansion runs before parsing. A fence error stops the
// parse like any token-level rejection: no partially expanded AST is built.
parser_parse_prepared: fn(input: ^^ParserFenceExpansion, lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, tables: ^^TokenTables) -> ParseResult {
    prepared := input.move()
    leading := lexer_diagnostics
    if prepared.diagnostics.len() > 0 {
        diagnostics := leading.move()
        loop diagnostic in prepared.diagnostics -> diagnostics.push(diagnostic)
        return ParseResult{program: ast_program(), diagnostics: diagnostics}
    }
    tokens := prepared.tokens.move()
    prepared.tokens = [Token]{}
    word_ids: parser_word_ids_for(tables)
    state := JetParserState{tokens: tokens.move(), tables: [TokenTables]{tables.move()}, position: 0, diagnostics: leading.move(), source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, statement_start: -1, line_starts: line_starts, sources: [[U8]]{source}, allow_environment_reads: allow_environment_reads, words: word_ids}
    state.marker_scopes = parser_marker_scopes(state.tokens, state.tables[0])
    state.bound_size_rows = parser_bound_size_rows(state.tokens, state.tables[0])
    program := parser_parse_program(state)
    program.has_scope_member = state.has_scope_member
    program.has_task_spawn = state.has_task_spawn
    program.block_spans = state.block_spans
    program.else_arms = state.else_arms
    loop declaration in state.block_policy_declarations {
        program.policy_declarations.push(declaration)
    }
    loop application in state.statement_rules {
        program.applied_rules.push(application.copy())
        program.rule_facts.push(application)
    }
    program.fenced_statements = prepared.fenced_statements
    program.used_import_names = parser_used_import_names(state.tokens, state.tables[0], program.imports, program.items)
    // After the names an import reads: a re-export spells its target.
    program.items = parser_reexport_declarations(program.items.move(), program.imports)
    program.debug_sites = parser_debug_trace_sites(state.tokens, state.tables[0], source)
    parser_state_marker_migration(program, source, state.diagnostics)
    ParseResult{program: program, diagnostics: state.diagnostics}
}

// Parallel parsing of one source. The token stream is cut at top-level item
// boundaries and each chunk runs on its own thread with its own compact
// `TokenTables`, its own `source` slice (`source_offset`), and its own
// `line_starts` slice (`line_base`), eliminating 16× whole-file copies.
// `ColonDeclarations`, `parser_marker_scopes`, `parser_used_import_names`,
// `parser_reexport_declarations`, `parser_debug_trace_sites`, and
// `parser_state_marker_migration` all map-reduce per chunk, joining compact
// summaries in source order. Any chunk error or whole-file directive hands
// the untouched stream to the one-thread parse for exact diagnostics, as
// does a chunk that binds a size name (parser_bound_size_rows), which
// changes how the whole file reads that name.

// A chunk thread is admitted for at least this many tokens.
PARSER_CHUNK_MIN_TOKENS: 8192

// Each chunk thread holds only its own slice of the source, line starts,
// tokens and compact tables: about this much per chunk source byte.
PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE: 8

// Per-chunk local import/low-level scan produced inside each parser worker so
// the join reduces `used_import_names` in O(candidates * chunks) without
// scanning whole-file tokens serially.
ParserChunkImportScan: struct {
    ident_seen: [Bool],
    marker_qualifiers: [String],
    low_level_tier: Bool,
}

// Prepared state for one chunk between Phase 1 (prepare/colon/validate/scopes)
// and Phase 2 (apply module heads + parse + local post-passes).
ParserChunkPrepared: struct {
    tokens: [Token],
    tables: TokenTables,
    source: [U8],
    source_offset: Int,
    line_starts: [Int],
    line_base: Int,
    colon: ParserColonLocal,
    marker_scopes: [ParserMarkerScope],
    whole: Bool,
    fences: Bool,
}

// A chunk's parsed program, side tables, and compact post-pass summaries.
ParserChunkOutput: struct {
    program: Program,
    diagnostics: [Diagnostic],
    block_spans: [Span],
    else_arms: [ElseArmSpan],
    block_policy_declarations: [PolicyDeclaration],
    statement_rules: [AppliedRuleApplication],
    has_scope_member: Bool{false},
    has_task_spawn: Bool{false},
    debug_sites: [DebugTraceSite]{[DebugTraceSite]{}},
    import_scan: ParserChunkImportScan{ParserChunkImportScan{ident_seen: [Bool]{}, marker_qualifiers: [String]{}, low_level_tier: false}},
    has_reexport: Bool{false},
    state_marker_sites: [StateMarkerSite]{[StateMarkerSite]{}},
    // Kept in the slot for O(1) `name_find` during `used_import_names` join
    // when the file has imports.
    tables: [TokenTables]{[TokenTables]{}},
}

// One thread's chunk slot: owns its bounds and moves prepared/output payloads
// between Phase 1, Phase 2, and join without copying.
ParserChunkSlot: struct {
    index: Int,
    is_last: Bool,
    tok_start: Int,
    tok_end: Int,
    byte_start: Int,
    byte_end: Int,
    line_idx_start: Int,
    line_idx_end: Int,
    needs_colon: Bool,
    prepared: [ParserChunkPrepared],
    chosen_heads: [Int],
    outputs: [ParserChunkOutput],
}

// Result of running `parser_parse_chunk_slots`: either a clean joined
// `ParseResult`, or a signal to route through whole-file `FencedNames` or
// one-thread parsing.
ParserChunksOutcome: struct {
    ok: Bool,
    fences: Bool,
    result: ParseResult,
}

// Whether token `index` in `tokens[..<to]` opens a valid top-level item head:
// item keywords, `priv`, `#` markers, `#run`/`#if`/`#loop` (`TOKEN_PREP`), or
// `TOKEN_IDENT` ONLY when followed by `TOKEN_COLON` or `TOKEN_COLON_EQ`
// (matching `parser_module_binding_ahead`, never bare script statements).
parser_chunk_head_at: fn(tokens: [Token], index: Int, to: Int) -> Bool Never! {
    if index < 0 || index >= to -> return false
    kind: tokens[index].kind
    if parser_is_item_keyword(kind) || kind == TOKEN_KW_PRIV || kind == TOKEN_HASH || kind == TOKEN_PREP {
        return true
    }
    if kind == TOKEN_IDENT {
        after := index + 1
        loop after < to && parser_is_trivia(tokens[after].kind) -> after += 1
        if after < to {
            next_kind: tokens[after].kind
            return next_kind == TOKEN_COLON || next_kind == TOKEN_COLON_EQ
        }
    }
    false
}

// The chunk bounds for the admitted threads: `[0, c1, …, tokens.len()]`, or
// `[0, tokens.len()]` when the stream parses as one. A cut sits before an
// item head (`parser_chunk_head_at`) at delimiter depth 0 whose previous code
// tokens are a top-level `}` and the line terminator after it.
parser_chunk_bounds: fn(tokens: [Token], tables: TokenTables, source: [U8], threads: CompilerThreads) -> [Int] Never! {
    whole: [Int]{0, tokens.len()}
    workers: compiler_threads_admit(threads, tokens.len(), tokens.len(), PARSER_CHUNK_MIN_TOKENS, (source.len() /% 16 + 1) * PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE, 0)
    if workers <= 1 -> return whole
    scan: parser_chunk_scan(tokens, parser_chunk_file_rules(tables), 0, tokens.len())
    if scan.whole -> return whole
    parser_chunk_bounds_of(scan.candidates, tokens.len(), workers)
}

// The name ids of the file rules that force whole-file parsing because later
// items read their program fields (`#NoPrelude`, `#HTML`, `#Target`).
// `#FX` sets `program.file_cap` only and is merged on chunk join (falling back
// if duplicate `#FX` file caps appear across chunks).
parser_chunk_file_rules: fn(tables: TokenTables) -> [Int] Never! {
    file_rules := [Int]{}
    file_rule_names: [String]{MARKER_NO_PRELUDE, MARKER_HTML, MARKER_TARGET}
    loop rule in file_rule_names {
        if name_find(tables.names, rule) == .Val(name) -> file_rules.push(name_index(name))
    }
    file_rules
}

// A cut scan of one token range: whether the range keeps the stream whole,
// whether it holds a fence token, whether its last depth-0 code token was `}`,
// and its cut candidates.
ParserChunkScan: struct {
    whole: Bool,
    fences: Bool,
    closed_item: Bool,
    candidates: [Int],
}

// The cut scan of `tokens[from..<to]` from the state the one-thread scan
// has at a range that starts the stream or starts an item run (depth 0,
// no `#` marker ahead, no marker list open).
parser_chunk_scan: fn(tokens: [Token], file_rules: [Int], from: Int, to: Int) -> ParserChunkScan Never! {
    candidates := [Int]{}
    fences := false
    depth := 0
    // The previous code token's kind (-1 at the start).
    previous := -1
    // The last code token was a `}` that closed a depth-0 group.
    closed_item := false
    // A line terminator followed that `}`.
    terminated := false
    // A top-level `#` whose marker name is still ahead.
    hash_ahead := false
    // Inside a top-level `#[ … ]` marker list.
    marker_list := false
    loop index in from..<to {
        kind: tokens[index].kind
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> next
        if kind == TOKEN_FENCE_OPEN || kind == TOKEN_FENCE_CLOSE -> fences = true
        if kind == TOKEN_SEMI {
            if tokens[index].span.start < tokens[index].span.end -> return ParserChunkScan{whole: true, fences: fences, closed_item: false, candidates: [Int]{}}
            if closed_item -> terminated = true
            previous = kind
            next
        }
        if kind == TOKEN_IDENT {
            if (hash_ahead || (marker_list && depth == 1 && (previous == TOKEN_LBRACKET || previous == TOKEN_COMMA || previous == TOKEN_BANG))) && file_rules.contains(name_index(tokens[index].decoded)) {
                return ParserChunkScan{whole: true, fences: fences, closed_item: false, candidates: [Int]{}}
            }
        }
        if terminated && depth == 0 && parser_chunk_head_at(tokens, index, to) -> candidates.push(index)
        terminated = false
        closed_item = false
        if hash_ahead {
            if kind == TOKEN_LBRACKET -> marker_list = true
            if kind != TOKEN_BANG -> hash_ahead = false
        } else if kind == TOKEN_HASH && depth == 0 { hash_ahead = true }
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1 else if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            depth -= 1
            if depth < 0 -> return ParserChunkScan{whole: true, fences: fences, closed_item: false, candidates: [Int]{}}
            if depth == 0 {
                marker_list = false
                if kind == TOKEN_RBRACE -> closed_item = true
            }
        }
        previous = kind
    }
    if depth != 0 -> return ParserChunkScan{whole: true, fences: fences, closed_item: false, candidates: [Int]{}}
    ParserChunkScan{whole: false, fences: fences, closed_item: closed_item, candidates: candidates.move()}
}

// The chunk bounds over `candidates` (ascending token indexes): a cut at the
// first candidate at or past each equal share of the tokens.
parser_chunk_bounds_of: fn(candidates: [Int], count: Int, workers: Int) -> [Int] Never! {
    if candidates.len() == 0 -> return [Int]{0, count}
    bounds := [Int]{0}
    candidate := 0
    loop share in 1..<workers {
        target: share * count /% workers
        loop candidate < candidates.len() && candidates[candidate] < target -> candidate += 1
        if candidate >= candidates.len() -> break
        if candidates[candidate] > bounds[bounds.len() - 1] -> bounds.push(candidates[candidate])
    }
    bounds.push(count)
    bounds
}

// Groups lexer item runs `[0, r1, …, count]`, more of them than `workers`,
// into at most `workers` balanced chunk boundaries, keeping every boundary on
// an existing run start.
parser_group_run_bounds: fn(runs: [Int], workers: Int) -> [Int] Never! {
    run_count: runs.len() - 1
    count: runs[runs.len() - 1]
    bounds := [Int]{0}
    run := 1
    loop share in 1..<workers {
        target: share * count /% workers
        loop run < run_count && runs[run] < target -> run += 1
        if run >= run_count -> break
        if runs[run] > bounds[bounds.len() - 1] -> bounds.push(runs[run])
    }
    bounds.push(count)
    bounds
}

// Remaps one `Name` from `old_names` into a compact chunk-local `new_names`
// table, caching each seen old id in `name_map`.
parser_chunk_remap_name: fn(old: Name, old_names: NameTable, new_names: ^NameTable, name_map: ^[Int]) -> Name Never! {
    id: name_index(old)
    if id <= 0 -> return name_empty()
    mapped: name_map[id]
    if mapped >= 0 -> return Name{id: U32{mapped}}
    new_id: name_index(name_intern_bytes(new_names, old_names.bytes, name_start(old_names, id), old_names.ends[id]))
    name_map[id] = new_id
    Name{id: U32{new_id}}
}

// Copies and remaps one `TokenLiteral` row (including nested interpolation
// tokens and typed-head readings) into `new_tables`.
parser_chunk_remap_literal: fn(old_row: Int, old_tables: TokenTables, new_tables: ^TokenTables, name_map: ^[Int]) -> Int Never! {
    literal: old_tables.literals[old_row]
    head: if literal.head >= 0 -> parser_chunk_remap_literal(literal.head, old_tables, new_tables, name_map) else -> -1
    head_decoded: parser_chunk_remap_name(literal.head_decoded, old_tables.names, new_tables.names, name_map)
    suffix: parser_chunk_remap_name(literal.suffix, old_tables.names, new_tables.names, name_map)
    parts := [StringPart]{}
    if literal.string_parts.len() > 0 {
        parts.try_reserve(literal.string_parts.len()) ?? panic("reserve failed")
        loop part in literal.string_parts {
            nested := [Token]{}
            if part.tokens.len() > 0 {
                nested.try_reserve(part.tokens.len()) ?? panic("reserve failed")
                loop tok in part.tokens {
                    text: parser_chunk_remap_name(tok.text, old_tables.names, new_tables.names, name_map)
                    decoded: parser_chunk_remap_name(tok.decoded, old_tables.names, new_tables.names, name_map)
                    lit: if tok.literal >= 0 -> parser_chunk_remap_literal(tok.literal, old_tables, new_tables, name_map) else -> -1
                    nested.push(Token{kind: tok.kind, span: tok.span, text: text, decoded: decoded, literal: lit})
                }
            }
            parts.push(StringPart{kind: part.kind, span: part.span, text: parser_chunk_remap_name(part.text, old_tables.names, new_tables.names, name_map), byte: part.byte, tokens: nested.move()})
        }
    }
    new_tables.literals.push(TokenLiteral{integer: literal.integer, decimal: literal.decimal, suffix: suffix, interpolations: literal.interpolations, string_parts: parts.move(), head: head, head_decoded: head_decoded, deferred: literal.deferred.copy(), escapes: literal.escapes.copy()})
    new_tables.literals.len() - 1
}

// Slices `tokens[tok_start..<tok_end]` and builds a compact chunk-local
// `TokenTables` holding only the names and literal rows referenced by that
// slice, so 16 workers copy `1×` literals and only their own unique names.
parser_slice_chunk_tokens_and_tables: fn(tokens: [Token], tok_start: Int, tok_end: Int, old_tables: TokenTables) -> {tokens: [Token], tables: TokenTables} Never! {
    count: tok_end - tok_start
    local_tokens := [Token]{}
    if count > 0 -> local_tokens.try_reserve(count) ?? panic("reserve failed")
    local_tables := token_tables()
    local_tables.has_fences = old_tables.has_fences
    local_tables.has_paste = old_tables.has_paste
    total_names: name_count(old_tables.names)
    name_map := [Int]{}
    name_map.try_reserve(total_names) ?? panic("reserve failed")
    loop _ in 0..<total_names -> name_map.push(-1)
    if total_names > 0 -> name_map[0] = 0
    loop index in tok_start..<tok_end {
        tok: tokens[index]
        text: parser_chunk_remap_name(tok.text, old_tables.names, local_tables.names, name_map)
        decoded: parser_chunk_remap_name(tok.decoded, old_tables.names, local_tables.names, name_map)
        lit: if tok.literal >= 0 -> parser_chunk_remap_literal(tok.literal, old_tables, local_tables, name_map) else -> -1
        local_tokens.push(Token{kind: tok.kind, span: tok.span, text: text, decoded: decoded, literal: lit})
    }
    {tokens: local_tokens.move(), tables: local_tables.move()}
}

// Computes non-overlapping column-0 byte cut points `[0, b1, …, source.len()]`
// covering the token chunks `bounds`, so chunk source slices partition
// `source` with `1×` total bytes copied across all workers.
parser_chunk_byte_bounds: fn(tokens: [Token], bounds: [Int], source: [U8]) -> [Int] Never! {
    byte_bounds := [Int]{0}
    source_len: source.len()
    chunk_count: bounds.len() - 1
    loop chunk in 1..<chunk_count {
        tok_start: bounds[chunk]
        cut := byte_bounds[byte_bounds.len() - 1]
        // Find the previous chunk's last non-synthetic token and advance past
        // its trailing `[ \t\r]*\n`.
        prev := tok_start - 1
        loop prev >= 0 && tokens[prev].span.start == tokens[prev].span.end -> prev -= 1
        if prev >= 0 {
            at := tokens[prev].span.end
            loop at < source_len && (source[at] == (U8{32}) || source[at] == (U8{9}) || source[at] == (U8{13})) {
                at += 1
            }
            if at < source_len && source[at] == (U8{10}) -> at += 1
            if at > cut -> cut = at
        }
        // Clamp to the line start of the first real token in this chunk so no
        // token in chunk `chunk` ever sits before `byte_bounds[chunk]`.
        first := tok_start
        loop first < bounds[chunk + 1] && tokens[first].span.start == tokens[first].span.end -> first += 1
        if first < bounds[chunk + 1] {
            first_start := tokens[first].span.start
            if first_start < cut {
                cut = first_start
                loop cut > byte_bounds[byte_bounds.len() - 1] && source[cut - 1] != (U8{10}) -> cut -= 1
            }
        }
        if cut > source_len -> cut = source_len
        byte_bounds.push(cut)
    }
    byte_bounds.push(source_len)
    byte_bounds
}

// First index in `line_starts` whose value is `>= offset` (lower bound).
parser_line_starts_lower_bound: fn(line_starts: [Int], offset: Int) -> Int Never! {
    low := 0
    high := line_starts.len()
    loop low < high {
        mid: low + (high - low) /% 2
        if line_starts[mid] < offset -> low = mid + 1 else -> high = mid
    }
    low
}

// Validates a chunk's boundary and token stream in Phase 1. For chunk `k > 0`,
// skips leading `TOKEN_LINE_COMMENT` trivia before asserting a synthetic
// `TOKEN_SEMI` followed by a valid `parser_chunk_head_at` token (Guardrail #1).
parser_chunk_validate_tokens: fn(tokens: [Token], tables: TokenTables, is_first: Bool, is_last: Bool, expect_leading_semi: Bool) -> {whole: Bool, fences: Bool} Never! {
    count: tokens.len()
    scan_from := 0
    if !is_first && expect_leading_semi {
        semi := 0
        loop semi < count && tokens[semi].kind == TOKEN_LINE_COMMENT -> semi += 1
        head := semi + 1
        loop head < count && parser_is_trivia(tokens[head].kind) -> head += 1
        if head >= count || tokens[semi].kind != TOKEN_SEMI || tokens[semi].span.start < tokens[semi].span.end || !parser_chunk_head_at(tokens, head, count) {
            return {whole: true, fences: tables.has_fences}
        }
        scan_from = head
    } else if !is_first {
        head := 0
        loop head < count && parser_is_trivia(tokens[head].kind) -> head += 1
        if head >= count || !parser_chunk_head_at(tokens, head, count) {
            return {whole: true, fences: tables.has_fences}
        }
        scan_from = head
    }
    scan: parser_chunk_scan(tokens, parser_chunk_file_rules(tables), scan_from, count)
    if scan.whole -> return {whole: true, fences: scan.fences || tables.has_fences}
    if !is_last && !scan.closed_item -> return {whole: true, fences: scan.fences || tables.has_fences}
    {whole: false, fences: scan.fences || tables.has_fences}
}

// Phase 1 worker for `parse_lexed_with_source_threads`: slices its chunk's
// tokens, compact tables, source slice, and line_starts slice from the
// read-borrowed whole-file inputs, runs local `ColonDeclarations`, validates
// boundaries/rules, and collects chunk-local `ParserMarkerScope`s.
parser_prepare_sliced_slot: fn(tokens: [Token], tables: TokenTables, source: [U8], line_starts: [Int], expect_leading_semi: Bool, slot: Shared<ParserChunkSlot>) -> Int {
    permit := slot.guard_edit()
    sliced := parser_slice_chunk_tokens_and_tables(tokens, permit.value.tok_start, permit.value.tok_end, tables)
    chunk_tokens := sliced.tokens.move()
    chunk_tables := sliced.tables.move()
    chunk_source := if source.len() > 0 && permit.value.byte_end > permit.value.byte_start -> source.slice(permit.value.byte_start, permit.value.byte_end) else -> [U8]{}
    chunk_lines := if line_starts.len() > 0 && permit.value.line_idx_end > permit.value.line_idx_start -> line_starts.slice(permit.value.line_idx_start, permit.value.line_idx_end) else -> [Int]{}
    colon := if permit.value.needs_colon -> parser_colon_declarations_local(chunk_tokens, chunk_tables) else -> ParserColonLocal{candidates: [ParserColonInstance]{}, declared_modules: [Int]{}, declared_others: [Int]{}, clean: true}
    checked: parser_chunk_validate_tokens(chunk_tokens, chunk_tables, permit.value.index == 0, permit.value.is_last, expect_leading_semi)
    whole: checked.whole || !colon.clean || parser_bound_size_rows(chunk_tokens, chunk_tables) != 0
    scopes := if whole || checked.fences -> [ParserMarkerScope]{} else -> parser_marker_scopes_chunk(chunk_tokens, chunk_tables)
    permit.value.prepared.push(ParserChunkPrepared{tokens: chunk_tokens.move(), tables: chunk_tables.move(), source: chunk_source.move(), source_offset: permit.value.byte_start, line_starts: chunk_lines.move(), line_base: permit.value.line_idx_start, colon: colon.move(), marker_scopes: scopes.move(), whole: whole, fences: checked.fences})
    1
}

parser_prepare_sliced_slots: fn(tokens: [Token], tables: TokenTables, source: [U8], line_starts: [Int], expect_leading_semi: Bool, slots: [Shared<ParserChunkSlot>], from: Int) -> Int {
    if from >= slots.len() - 1 -> return parser_prepare_sliced_slot(tokens, tables, source, line_starts, expect_leading_semi, slots[from])
    prepared := 0
    task.group parser_prepare_slice_threads {
        head: task parser_prepare_sliced_slot(tokens, tables, source, line_starts, expect_leading_semi, slots[from])
        prepared = parser_prepare_sliced_slots(tokens, tables, source, line_starts, expect_leading_semi, slots, from + 1)
        prepared += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    prepared
}

// Phase 1 worker for `parse_source_threads`: the slot ALREADY holds its own
// `LexedChunk` tokens, tables, and line_starts directly from the lexer; it
// slices only its own chunk of `source`, runs local `ColonDeclarations`,
// validates boundaries/rules, and collects chunk-local `ParserMarkerScope`s.
parser_prepare_direct_slot: fn(source: [U8], slot: Shared<ParserChunkSlot>) -> Int {
    permit := slot.guard_edit()
    data := permit.value.prepared.pop() ?? panic("missing direct parser chunk")
    chunk_tokens := data.tokens.move()
    chunk_tables := data.tables.move()
    chunk_source := if source.len() > 0 && permit.value.byte_end > permit.value.byte_start -> source.slice(permit.value.byte_start, permit.value.byte_end) else -> [U8]{}
    colon := parser_colon_declarations_local(chunk_tokens, chunk_tables)
    checked: parser_chunk_validate_tokens(chunk_tokens, chunk_tables, permit.value.index == 0, permit.value.is_last, true)
    whole: checked.whole || !colon.clean || parser_bound_size_rows(chunk_tokens, chunk_tables) != 0
    scopes := if whole || checked.fences -> [ParserMarkerScope]{} else -> parser_marker_scopes_chunk(chunk_tokens, chunk_tables)
    permit.value.prepared.push(ParserChunkPrepared{tokens: chunk_tokens.move(), tables: chunk_tables.move(), source: chunk_source.move(), source_offset: data.source_offset, line_starts: data.line_starts.move(), line_base: data.line_base, colon: colon.move(), marker_scopes: scopes.move(), whole: whole, fences: checked.fences})
    1
}

parser_prepare_direct_slots: fn(source: [U8], slots: [Shared<ParserChunkSlot>], from: Int) -> Int {
    if from >= slots.len() - 1 -> return parser_prepare_direct_slot(source, slots[from])
    prepared := 0
    task.group parser_prepare_direct_threads {
        head: task parser_prepare_direct_slot(source, slots[from])
        prepared = parser_prepare_direct_slots(source, slots, from + 1)
        prepared += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    prepared
}

// One-pass chunk-local scan for `used_import_names`: marks every `TOKEN_IDENT`
// (including inside `STRING_PART_INTERPOLATION`) outside chunk-local
// `import_spans`, collects qualified marker heads (`#Qual.` / `#[..., Qual.`),
// and detects low-level-tier syntax (`*x`, `p.*`, `uninit`, `Ptr`, `FFI(asm)`).
parser_chunk_scan_imports: fn(tokens: [Token], tables: TokenTables, imports: [ImportDecl], items: [Item]) -> ParserChunkImportScan Never! {
    import_spans := [Span]{}
    loop declaration in imports -> import_spans.push(declaration.span)
    loop item in items {
        if item == .CodeModule(definition) {
            if definition.body == None -> import_spans.push(definition.span)
        }
    }
    indexed_spans: if import_spans.len() > 0 -> parser_import_span_index(import_spans) else -> [Span]{}
    has_spans: indexed_spans.len() > 0
    ident_seen := [Bool]{}
    total_names: name_count(tables.names)
    ident_seen.try_reserve(total_names) ?? panic("reserve failed")
    loop _ in 0..<total_names -> ident_seen.push(false)
    marker_qualifiers := [String]{}
    uninit_id: if name_find(tables.names, "uninit") == .Val(id) -> name_index(id) else -> -1
    ptr_id: if name_find(tables.names, "Ptr") == .Val(id) -> name_index(id) else -> -1
    asm_id: if name_find(tables.names, "asm") == .Val(id) -> name_index(id) else -> -1
    ffi_id: if name_find(tables.names, "FFI") == .Val(id) -> name_index(id) else -> -1
    has_asm_ffi: asm_id >= 0 && ffi_id >= 0
    has_ll_idents: uninit_id >= 0 || ptr_id >= 0 || has_asm_ffi
    low_level := false
    depth := 0
    count: tokens.len()
    loop index in 0..<count {
        token: tokens[index]
        kind: token.kind
        if depth > 0 {
            if kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN -> depth += 1
            if kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN -> depth -= 1
        } else if kind == TOKEN_LBRACKET && index > 0 && tokens[index - 1].kind == TOKEN_HASH {
            depth = 1
        }
        if kind == TOKEN_IDENT {
            id: name_index(token.decoded)
            if id < total_names && !ident_seen[id] {
                if !has_spans || !parser_inside_import_span(indexed_spans, token.span) {
                    ident_seen[id] = true
                }
            }
            if index > 0 && index + 1 < count && tokens[index + 1].kind == TOKEN_DOT {
                before: tokens[index - 1].kind
                if before == TOKEN_HASH || (depth == 1 && (before == TOKEN_LBRACKET || before == TOKEN_COMMA)) {
                    name: token_decoded(tables, token)
                    if !marker_qualifiers.contains(name) -> marker_qualifiers.push(name)
                }
            }
            if !low_level && has_ll_idents {
                if id == uninit_id || id == ptr_id {
                    low_level = true
                } else if has_asm_ffi && id == asm_id && index >= 2 && tokens[index - 1].kind == TOKEN_LPAREN && tokens[index - 2].kind == TOKEN_IDENT && name_index(tokens[index - 2].decoded) == ffi_id {
                    low_level = true
                }
            }
        } else if !low_level && kind == TOKEN_STAR {
            if index == 0 {
                low_level = true
            } else {
                before: tokens[index - 1].kind
                value_end: before == TOKEN_IDENT || before == TOKEN_RAW_STRING || before == TOKEN_STRING || before == TOKEN_INT || before == TOKEN_FLOAT || before == TOKEN_UNIT_NUMBER || before == TOKEN_CHAR || before == TOKEN_TRUE || before == TOKEN_FALSE || before == TOKEN_SELF || before == TOKEN_RPAREN || before == TOKEN_RBRACKET || before == TOKEN_RBRACE
                if !value_end -> low_level = true
            }
        }
        if token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION {
                    parser_chunk_scan_interp_idents(part.tokens, tables, indexed_spans, has_spans, ident_seen)
                }
            }
        }
    }
    ParserChunkImportScan{ident_seen: ident_seen.move(), marker_qualifiers: marker_qualifiers.move(), low_level_tier: low_level}
}

parser_chunk_scan_interp_idents: fn(tokens: [Token], tables: TokenTables, indexed_spans: [Span], has_spans: Bool, ident_seen: ^[Bool]) Never! {
    total: ident_seen.len()
    loop token in tokens {
        if token.kind == TOKEN_IDENT {
            id: name_index(token.decoded)
            if id < total && !ident_seen[id] {
                if !has_spans || !parser_inside_import_span(indexed_spans, token.span) {
                    ident_seen[id] = true
                }
            }
        }
        if token.literal < 0 -> next
        loop part in tables.literals[token.literal].string_parts {
            if part.kind == STRING_PART_INTERPOLATION {
                parser_chunk_scan_interp_idents(part.tokens, tables, indexed_spans, has_spans, ident_seen)
            }
        }
    }
}

// Phase 2 worker: applies any cross-chunk `TOKEN_KW_MODULE` insertions, parses
// the chunk with its compact `TokenTables`, chunk `source` slice, and chunk
// `line_starts` slice, and runs all chunk-local post-passes on this thread.
parser_parse_slot_part: fn(marker_scopes: [ParserMarkerScope], source_end: Int, allow_environment_reads: Bool, slot: Shared<ParserChunkSlot>) -> Int {
    permit := slot.guard_edit()
    data := permit.value.prepared.pop() ?? panic("missing prepared parser chunk")
    chosen := [Int]{}
    compiler_transfer_rows<Int>(chosen, permit.value.chosen_heads)
    chunk_tokens := if chosen.len() > 0 -> parser_colon_insert_module_heads(data.tokens.move(), chosen) else -> data.tokens.move()
    word_ids: parser_word_ids_for(data.tables)
    state := JetParserState{tokens: chunk_tokens.move(), tables: [TokenTables]{data.tables.move()}, position: 0, diagnostics: [Diagnostic]{}, source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, statement_start: -1, line_starts: data.line_starts.move(), sources: [[U8]]{data.source.move()}, source_offset: data.source_offset, line_base: data.line_base, allow_environment_reads: allow_environment_reads, words: word_ids}
    if marker_scopes.len() > 0 -> state.marker_scopes = marker_scopes.copy()
    program := parser_parse_program(state)
    debug_sites := parser_debug_trace_sites_at(state.tokens, state.tables[0], state.sources[0], state.source_offset)
    import_scan := parser_chunk_scan_imports(state.tokens, state.tables[0], program.imports, program.items)
    has_reexport: parser_has_reexport_candidate(program.items)
    state_sites := [StateMarkerSite]{}
    parser_state_marker_sites(program.items, state_sites)
    kept_tables := state.tables.move()
    permit.value.outputs.push(ParserChunkOutput{program: program.move(), diagnostics: state.diagnostics.move(), block_spans: state.block_spans.move(), else_arms: state.else_arms.move(), block_policy_declarations: state.block_policy_declarations.move(), statement_rules: state.statement_rules.move(), has_scope_member: state.has_scope_member, has_task_spawn: state.has_task_spawn, debug_sites: debug_sites.move(), import_scan: import_scan.move(), has_reexport: has_reexport, state_marker_sites: state_sites.move(), tables: kept_tables.move()})
    1
}

parser_parse_slot_parts: fn(marker_scopes: [ParserMarkerScope], source_end: Int, allow_environment_reads: Bool, slots: [Shared<ParserChunkSlot>], from: Int) -> Int {
    if from >= slots.len() - 1 -> return parser_parse_slot_part(marker_scopes, source_end, allow_environment_reads, slots[from])
    parsed := 0
    task.group parser_chunk_threads {
        head: task parser_parse_slot_part(marker_scopes, source_end, allow_environment_reads, slots[from])
        parsed = parser_parse_slot_parts(marker_scopes, source_end, allow_environment_reads, slots, from + 1)
        parsed += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    parsed
}

// Reduces `used_import_names` across chunk summaries in O(candidates * chunks).
parser_reduce_used_import_names: fn(imports: [ImportDecl], items: [Item], outputs: [ParserChunkOutput]) -> [String] Never! {
    candidates := [String]{}
    used := [String]{}
    // The chunks' import scans already left import spans out.
    spans := [Span]{}
    parser_import_roots(imports, items, used, candidates, spans)
    if candidates.len() == 0 {
        used.sort()
        return used
    }
    used_set := name_table_sized(32)
    loop name in used -> _ := name_intern(used_set, name)
    any_low_level := false
    loop idx in 0..<outputs.len() {
        if outputs[idx].import_scan.low_level_tier -> any_low_level = true
    }
    loop candidate in candidates.move() {
        if name_find(used_set, candidate) != None -> next
        found := false
        loop idx in 0..<outputs.len() {
            if outputs[idx].tables.len() == 0 -> next
            if name_find(outputs[idx].tables[0].names, candidate) == .Val(id) {
                n: name_index(id)
                if n < outputs[idx].import_scan.ident_seen.len() && outputs[idx].import_scan.ident_seen[n] {
                    found = true
                    break
                }
            }
        }
        if !found {
            spelled: sema_casing_marker_qualifier(candidate)
            if spelled != candidate {
                loop idx in 0..<outputs.len() {
                    if outputs[idx].import_scan.marker_qualifiers.contains(spelled) {
                        found = true
                        break
                    }
                }
            }
        }
        if found {
            _ := name_intern(used_set, candidate)
            used.push(candidate)
        }
    }
    if any_low_level {
        parser_collect_core_mem_gate_names(imports, used)
    }
    used.sort()
    used
}

// Runs Sync Barrier 1 (whole/fence check, cross-chunk ColonDeclarations fixed
// point, marker scopes merge), Phase 2 (parallel parse + local post-passes),
// and compact join over already-prepared `slots`. The joined program takes
// `fenced_statements`; an outcome that isn't `ok` hands them back in its
// result's program for the caller's one-thread parse.
parser_finish_prepared_slots: fn(slots: [Shared<ParserChunkSlot>], source: [U8], source_end: Int, allow_environment_reads: Bool, lexer_diagnostics: [Diagnostic], fenced_input: ^^[FencedStatement]) -> ParserChunksOutcome {
    fenced_statements: fenced_input.move()
    chunk_count: slots.len()
    whole := false
    fences := false
    any_candidates := false
    marker_scopes := [ParserMarkerScope]{}
    loop chunk in 0..<chunk_count {
        permit := slots[chunk].guard_edit()
        if permit.value.prepared[0].whole -> whole = true
        if permit.value.prepared[0].fences -> fences = true
        if permit.value.prepared[0].colon.candidates.len() > 0 -> any_candidates = true
        compiler_transfer_rows<ParserMarkerScope>(marker_scopes, permit.value.prepared[0].marker_scopes)
    }
    if fences || whole {
        return ParserChunksOutcome{ok: false, fences: fences, result: parser_chunks_unjoined(fenced_statements.move())}
    }
    if marker_scopes.len() > 0 {
        file_end: source_end + 1
        loop at in 0..<marker_scopes.len() {
            if marker_scopes[at].end < 0 -> marker_scopes[at].end = file_end
        }
    }
    if any_candidates {
        named_candidates := [ParserColonNamedCandidate]{}
        declared_modules := [String]{}
        declared_others := [String]{}
        loop chunk in 0..<chunk_count {
            reads: slots[chunk].guard_read()
            data: reads.value.prepared[0]
            names: data.tables.names
            loop id in data.colon.declared_modules {
                declared_modules.push(name_text(names, Name{id: U32{id}}))
            }
            loop id in data.colon.declared_others {
                declared_others.push(name_text(names, Name{id: U32{id}}))
            }
            loop cand in data.colon.candidates {
                named_candidates.push(ParserColonNamedCandidate{chunk: chunk, head: cand.head, name: name_text(names, Name{id: U32{cand.name}}), target: name_text(names, Name{id: U32{cand.target}}), typed: cand.typed, snake: cand.snake})
            }
        }
        chosen_by_chunk := parser_colon_resolve_named_instances(chunk_count, named_candidates, declared_modules, declared_others)
        loop chunk in 0..<chunk_count {
            if chosen_by_chunk[chunk].len() > 0 {
                permit := slots[chunk].guard_edit()
                compiler_transfer_rows<Int>(permit.value.chosen_heads, chosen_by_chunk[chunk])
            }
        }
    }
    _ := parser_parse_slot_parts(marker_scopes, source_end, allow_environment_reads, slots, 0)
    outputs := [ParserChunkOutput]{}
    outputs.try_reserve(chunk_count) ?? panic("reserve failed")
    failed := false
    total_imports := 0
    total_items := 0
    total_blocks := 0
    total_elses := 0
    total_debug := 0
    file_cap := ModuleCap?{None}
    any_reexport := false
    loop slot in slots {
        permit: slot.guard_edit()
        output := permit.value.outputs.pop() ?? panic("a chunk parse thread left no output")
        loop diagnostic in output.diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR -> failed = true
        }
        if output.program.file_cap != None {
            if file_cap != None -> failed = true
            file_cap = output.program.file_cap.move()
            output.program.file_cap = None
        }
        if output.has_reexport -> any_reexport = true
        total_imports += output.program.imports.len()
        total_items += output.program.items.len()
        total_blocks += output.block_spans.len()
        total_elses += output.else_arms.len()
        total_debug += output.debug_sites.len()
        outputs.push(output.move())
    }
    if failed {
        return ParserChunksOutcome{ok: false, fences: false, result: parser_chunks_unjoined(fenced_statements.move())}
    }
    program := ast_program()
    program.file_cap = file_cap.move()
    program.has_scope_member = false
    program.has_task_spawn = false
    if total_imports > 0 -> program.imports.try_reserve(total_imports) ?? panic("reserve failed")
    if total_items > 0 -> program.items.try_reserve(total_items) ?? panic("reserve failed")
    diagnostics := [Diagnostic]{}
    loop diagnostic in lexer_diagnostics -> diagnostics.push(diagnostic.copy())
    block_spans := [Span]{}
    if total_blocks > 0 -> block_spans.try_reserve(total_blocks) ?? panic("reserve failed")
    else_arms := [ElseArmSpan]{}
    if total_elses > 0 -> else_arms.try_reserve(total_elses) ?? panic("reserve failed")
    block_policy_declarations := [PolicyDeclaration]{}
    statement_rules := [AppliedRuleApplication]{}
    debug_sites := [DebugTraceSite]{}
    if total_debug > 0 -> debug_sites.try_reserve(total_debug) ?? panic("reserve failed")
    state_marker_sites := [StateMarkerSite]{}
    loop index in 0..<outputs.len() {
        if outputs[index].has_scope_member -> program.has_scope_member = true
        if outputs[index].has_task_spawn -> program.has_task_spawn = true
        compiler_transfer_rows<ImportDecl>(program.imports, outputs[index].program.imports)
        compiler_transfer_rows<Item>(program.items, outputs[index].program.items)
        compiler_transfer_rows<Stmt>(program.script_body, outputs[index].program.script_body)
        compiler_transfer_rows<PolicyDeclaration>(program.policy_declarations, outputs[index].program.policy_declarations)
        compiler_transfer_rows<UserPolicyDecl>(program.user_policy_declarations, outputs[index].program.user_policy_declarations)
        compiler_transfer_rows<AppliedRuleApplication>(program.rule_facts, outputs[index].program.rule_facts)
        compiler_transfer_rows<Diagnostic>(diagnostics, outputs[index].diagnostics)
        compiler_transfer_rows<Span>(block_spans, outputs[index].block_spans)
        compiler_transfer_rows<ElseArmSpan>(else_arms, outputs[index].else_arms)
        compiler_transfer_rows<PolicyDeclaration>(block_policy_declarations, outputs[index].block_policy_declarations)
        compiler_transfer_rows<AppliedRuleApplication>(statement_rules, outputs[index].statement_rules)
        compiler_transfer_rows<DebugTraceSite>(debug_sites, outputs[index].debug_sites)
        compiler_transfer_rows<StateMarkerSite>(state_marker_sites, outputs[index].state_marker_sites)
    }
    program.block_spans = block_spans.move()
    program.else_arms = else_arms.move()
    loop declaration in block_policy_declarations -> program.policy_declarations.push(declaration)
    loop application in statement_rules {
        program.applied_rules.push(application.copy())
        program.rule_facts.push(application)
    }
    program.fenced_statements = fenced_statements.move()
    program.used_import_names = parser_reduce_used_import_names(program.imports, program.items, outputs)
    if any_reexport {
        program.items = parser_reexport_declarations(program.items.move(), program.imports)
    }
    program.debug_sites = debug_sites.move()
    if state_marker_sites.len() > 0 {
        parser_state_marker_migration_from_sites(program, state_marker_sites.move(), source, diagnostics)
    }
    ParserChunksOutcome{ok: true, fences: false, result: ParseResult{program: program.move(), diagnostics: diagnostics.move()}}
}

// The result of chunks that didn't join: no program, only the fenced
// statements given back to the caller's one-thread parse.
parser_chunks_unjoined: fn(fenced: ^^[FencedStatement]) -> ParseResult {
    program := ast_program()
    program.fenced_statements = fenced.move()
    ParseResult{program: program.move(), diagnostics: [Diagnostic]{}}
}

// Parses the fence-expanded stream as the chunks `bounds` names, on one
// thread per chunk with compact per-chunk `TokenTables` and `source` slices,
// and joins the chunk programs in chunk order.
parser_parse_chunked: fn(input: ^^ParserFenceExpansion, bounds: [Int], lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, tables: ^^TokenTables) -> ParseResult {
    prepared := input.move()
    tokens := prepared.tokens.move()
    owned_tables := tables.move()
    byte_bounds: parser_chunk_byte_bounds(tokens, bounds, source)
    chunk_count: bounds.len() - 1
    slots := [Shared<ParserChunkSlot>]{}
    slots.try_reserve(chunk_count) ?? panic("reserve failed")
    loop chunk in 0..<chunk_count {
        line_lo: if line_starts.len() > 0 -> parser_line_starts_lower_bound(line_starts, byte_bounds[chunk]) else -> 0
        line_hi: if line_starts.len() > 0 -> if chunk + 1 == chunk_count -> line_starts.len() else -> parser_line_starts_lower_bound(line_starts, byte_bounds[chunk + 1]) else -> 0
        slots.push(Shared{ParserChunkSlot{index: chunk, is_last: chunk + 1 == chunk_count, tok_start: bounds[chunk], tok_end: bounds[chunk + 1], byte_start: byte_bounds[chunk], byte_end: byte_bounds[chunk + 1], line_idx_start: line_lo, line_idx_end: line_hi, needs_colon: false, prepared: [ParserChunkPrepared]{}, chosen_heads: [Int]{}, outputs: [ParserChunkOutput]{}}})
    }
    _ := parser_prepare_sliced_slots(tokens, owned_tables, source, line_starts, false, slots, 0)
    outcome := parser_finish_prepared_slots(slots, source, source_end, allow_environment_reads, lexer_diagnostics, prepared.fenced_statements.move())
    if outcome.ok -> return outcome.result.move()
    // Recovery after an error skips to the next plausible item, which can
    // lie past the chunk's end: the one-thread parse owns every diagnostic.
    prepared.fenced_statements = outcome.result.program.fenced_statements.move()
    prepared.tokens = tokens.move()
    parser_parse_prepared(prepared, lexer_diagnostics, source_end, line_starts, source, allow_environment_reads, owned_tables.move())
}

// The module roots `imports` read, each once, into `used`, and the names the
// imports and the body-less modules of `items` bind, into `candidates`; the
// span of each of those declarations goes to `spans`.
parser_import_roots: fn(imports: [ImportDecl], items: [Item], used: ^[String], candidates: ^[String], spans: ^[Span]) Never! {
    // The module roots read so far, by id in a table of their own (a root
    // may be a dotted path no token spells): `rooted[id]` once `used` has it.
    roots := name_table_sized(16)
    rooted := [Bool]{}
    loop declaration in imports {
        spans.push(declaration.span)
        if declaration.kind == {
            .Unqualified(module_alias, _, imported_items, _, _) -> {
                root: name_index(name_intern(roots, module_alias))
                loop rooted.len() <= root -> rooted.push(false)
                if !rooted[root] {
                    rooted[root] = true
                    used.push(module_alias.copy())
                }
                loop item in imported_items {
                    parts: item.original.split(".").to_list()
                    candidates.push(item.alias ?? parts[parts.len() - 1])
                }
            }
            .File(_, _) | .Module(_, _) -> candidates.push(declaration.alias)
        }
    }
    loop item in items {
        if item == .CodeModule(definition) {
            if definition.body != None -> next
            spans.push(definition.span)
            candidates.push(definition.name)
        }
    }
}

// L0103 an import's local name is read when the file spells it outside every
// import declaration, interpolations included. The module root of a member
// import (`b` in `use b.[f]`) reads that name as well. A body-less
// `name: module` is the file import the loader binds for it. None (Jet-only
// pass)
parser_used_import_names: fn(tokens: [Token], tables: TokenTables, imports: [ImportDecl], program_items: [Item]) -> [String] Never! {
    candidates := [String]{}
    used := [String]{}
    import_spans := [Span]{}
    parser_import_roots(imports, program_items, used, candidates, import_spans)
    if candidates.len() == 0 {
        used.sort()
        return used
    }
    indexed_spans: parser_import_span_index(import_spans)
    // Per name id: whether the name is a candidate, and whether it is used.
    candidate_ids := [Bool]{}
    used_ids := [Bool]{}
    loop _ in 0..<name_count(tables.names) {
        candidate_ids.push(false)
        used_ids.push(false)
    }
    loop candidate in candidates {
        if name_find(tables.names, candidate) == .Val(name) {
            candidate_ids[name_index(name)] = true
        }
    }
    loop name in used {
        if name_find(tables.names, name) == .Val(found) -> used_ids[name_index(found)] = true
    }
    parser_collect_used_import_names(tokens, tables, indexed_spans, candidate_ids, used_ids, used)
    parser_collect_marker_import_names(tokens, tables, candidates, used)
    if parser_low_level_tier_spelled(tokens, tables) {
        parser_collect_core_mem_gate_names(imports, used)
    }
    // A set, in name order: a layout change that reorders spellings (`jet
    // fmt` putting union members in canonical order) keeps the same tree.
    used.sort()
    used
}

// A `core.mem` import is the discovery gate of the low-level tier (E0424,
// E3102): `Type{ uninit }`, a raw pointer `*x` or `p.*`, a `Ptr` and an inline
// `#FFI(asm)` body need it though none of them spells its name. In a file that
// writes one, every name a `core.mem` import binds is read. None (Jet-only
// pass)
parser_collect_core_mem_gate_names: fn(imports: [ImportDecl], used: ^[String]) Never! {
    loop declaration in imports {
        if declaration.kind == {
            .Module(name, _) -> {
                if name == "core.mem" && !used.contains(declaration.alias) {
                    used.push(declaration.alias)
                }
            }
            .Unqualified(module_alias, _, items, _, _) -> {
                loop item in items {
                    if module_alias != "core.mem" && "{module_alias}.{item.original}" != "core.mem" {
                        next
                    }
                    parts: item.original.split(".").to_list()
                    local: item.alias ?? parts[parts.len() - 1]
                    if !used.contains(local) -> used.push(local)
                }
            }
            .File(_, _) -> {}
        }
    }
}

// Whether the file writes low-level-tier syntax: an `uninit` or `Ptr` name, a
// `*` where an operand starts (`*x`, and `p.*` after its `.`) or an `FFI(asm)`
// marker. None (Jet-only pass)
parser_low_level_tier_spelled: fn(tokens: [Token], tables: TokenTables) -> Bool Never! {
    uninit_id: if name_find(tables.names, "uninit") == .Val(id) -> name_index(id) else -> -1
    ptr_id: if name_find(tables.names, "Ptr") == .Val(id) -> name_index(id) else -> -1
    asm_id: if name_find(tables.names, "asm") == .Val(id) -> name_index(id) else -> -1
    ffi_id: if name_find(tables.names, "FFI") == .Val(id) -> name_index(id) else -> -1
    has_asm_ffi: asm_id >= 0 && ffi_id >= 0
    has_idents: uninit_id >= 0 || ptr_id >= 0 || has_asm_ffi
    count: tokens.len()
    loop index in 0..<count {
        kind: tokens[index].kind
        if kind == TOKEN_STAR {
            if index == 0 -> return true
            before: tokens[index - 1].kind
            value_end: before == TOKEN_IDENT || before == TOKEN_RAW_STRING || before == TOKEN_STRING || before == TOKEN_INT || before == TOKEN_FLOAT || before == TOKEN_UNIT_NUMBER || before == TOKEN_CHAR || before == TOKEN_TRUE || before == TOKEN_FALSE || before == TOKEN_SELF || before == TOKEN_RPAREN || before == TOKEN_RBRACKET || before == TOKEN_RBRACE
            if !value_end -> return true
            next
        }
        if !has_idents || kind != TOKEN_IDENT -> next
        id: name_index(tokens[index].decoded)
        if id == uninit_id || id == ptr_id -> return true
        if has_asm_ffi && id == asm_id && index >= 2 && tokens[index - 1].kind == TOKEN_LPAREN && tokens[index - 2].kind == TOKEN_IDENT && name_index(tokens[index - 2].decoded) == ffi_id {
            return true
        }
    }
    false
}

// A qualified marker names its import through the alias's PascalCase spelling
// (`#Server.Get` uses `server`). A marker head is the identifier after `#`, or
// after `[` or `,` at the top of a `#[ … ]` list, when a `.` follows it. None
// (Jet-only pass)
parser_collect_marker_import_names: fn(tokens: [Token], tables: TokenTables, candidates: [String], used: ^[String]) Never! {
    aliases := [String]{}
    spellings := [String]{}
    loop candidate in candidates {
        spelled: sema_casing_marker_qualifier(candidate)
        if spelled != candidate {
            aliases.push(candidate.copy())
            spellings.push(spelled)
        }
    }
    if aliases.len() == 0 {
        return
    }
    depth := 0
    loop index in 0..<tokens.len() {
        kind: tokens[index].kind
        if depth > 0 {
            if kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN -> depth += 1
            if kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN -> depth -= 1
        } else if kind == TOKEN_LBRACKET && index > 0 && tokens[index - 1].kind == TOKEN_HASH {
            depth = 1
        }
        if kind != TOKEN_IDENT || index == 0 || index + 1 >= tokens.len() || tokens[index + 1].kind != TOKEN_DOT {
            next
        }
        before: tokens[index - 1].kind
        head: before == TOKEN_HASH || (depth == 1 && (before == TOKEN_LBRACKET || before == TOKEN_COMMA))
        if !head -> next
        name: token_decoded(tables, tokens[index])
        loop position in 0..<spellings.len() {
            if spellings[position] == name && !used.contains(aliases[position]) {
                used.push(aliases[position])
            }
        }
    }
}

parser_import_span_index: fn(spans: [Span]) -> [Span] Never! {
    order := [Int]{}
    loop index in 0..<spans.len() -> order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle: if start + width < order.len() -> start + width else -> order.len()
            end: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && spans[order[left]].start <= spans[order[right]].start) {
                    merged.push(order[left])
                    left += 1
                } else {
                    merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width *= 2
    }
    indexed := [Span]{}
    loop position in order {
        span: spans[position]
        // Prefix maximum ends preserve containment even for overlapping spans.
        end: if indexed.len() > 0 && indexed[indexed.len() - 1].end > span.end -> indexed[indexed.len() - 1].end else -> span.end
        indexed.push(Span{start: span.start, end: end})
    }
    indexed
}

parser_inside_import_span: fn(indexed_spans: [Span], span: Span) -> Bool Never! {
    low := 0
    high := indexed_spans.len()
    loop low < high {
        middle: low + (high - low) /% 2
        if indexed_spans[middle].start <= span.start -> low = middle + 1 else -> high = middle
    }
    low > 0 && span.end <= indexed_spans[low - 1].end
}

parser_collect_used_import_names: fn(tokens: [Token], tables: TokenTables, indexed_spans: [Span], candidate_ids: [Bool], used_ids: ^[Bool], used: ^[String]) Never! {
    loop token in tokens {
        id: name_index(token.decoded)
        if token.kind == TOKEN_IDENT && id < candidate_ids.len() && candidate_ids[id] && !used_ids[id] {
            if !parser_inside_import_span(indexed_spans, token.span) {
                used_ids[id] = true
                used.push(token_decoded(tables, token))
            }
        }
        if token.literal < 0 -> next
        loop part in tables.literals[token.literal].string_parts {
            if part.kind == STRING_PART_INTERPOLATION {
                parser_collect_used_import_names(part.tokens, tables, indexed_spans, candidate_ids, used_ids, used)
                parser_collect_selector_import_names(part.tokens, tables, candidate_ids, used_ids, used)
            }
        }
    }
}

// A hole's format selector `:Name` calls trait `NameFormat`, so it uses an
// import of that trait the file never spells.
parser_collect_selector_import_names: fn(tokens: [Token], tables: TokenTables, candidate_ids: [Bool], used_ids: ^[Bool], used: ^[String]) Never! {
    loop index in 1..<tokens.len() {
        if tokens[index - 1].kind != TOKEN_COLON || tokens[index].kind != TOKEN_IDENT -> next
        trait_name: "{token_decoded(tables, tokens[index])}Format"
        name: name_find(tables.names, trait_name) ?? next
        id: name_index(name)
        if id < candidate_ids.len() && candidate_ids[id] && !used_ids[id] {
            used_ids[id] = true
            used.push(trait_name)
        }
    }
}

// Record each `debug(…)` call's argument text as written, so sema
// can name the traced expression and build the E3405 unwrap edit. The text
// runs from the first token after `(` to the last one before its matching
// `)`, leaving out a trailing comma. Interpolations are scanned as well.
parser_debug_trace_sites: fn(tokens: [Token], tables: TokenTables, source: [U8]) -> [DebugTraceSite] Never! {
    parser_debug_trace_sites_at(tokens, tables, source, 0)
}

// Like `parser_debug_trace_sites` when `source` holds the byte slice starting
// at `source_offset` (one parser chunk). Emitted `DebugTraceSite` offsets stay
// global byte offsets.
parser_debug_trace_sites_at: fn(tokens: [Token], tables: TokenTables, source: [U8], source_offset: Int) -> [DebugTraceSite] Never! {
    sites := [DebugTraceSite]{}
    if source.len() == 0 -> return sites
    debug: name_find(tables.names, "debug") ?? return sites
    parser_collect_debug_trace_sites_at(tokens, tables, debug, source, source_offset, sites)
    sites
}

parser_collect_debug_trace_sites_at: fn(tokens: [Token], tables: TokenTables, debug: Name, source: [U8], source_offset: Int, sites: ^[DebugTraceSite]) Never! {
    has_call := false
    count: tokens.len()
    loop index in 0..<count {
        token: tokens[index]
        if token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION {
                    parser_collect_debug_trace_sites_at(part.tokens, tables, debug, source, source_offset, sites)
                }
            }
        }
        if token.kind == TOKEN_IDENT && token.decoded == debug && index + 1 < count && tokens[index + 1].kind == TOKEN_LPAREN {
            has_call = true
        }
    }
    if !has_call -> return
    closes := [Int]{}
    closes.try_reserve(count) ?? panic("reserve failed")
    opens := [Int]{}
    loop index in 0..<count {
        closes.push(-1)
        if tokens[index].kind == TOKEN_LPAREN -> opens.push(index)
        if tokens[index].kind == TOKEN_RPAREN && opens.len() > 0 {
            open: opens.pop() ?? -1
            closes[open] = index
        }
    }
    limit: source_offset + source.len()
    loop index in 0..<count {
        token: tokens[index]
        if token.kind != TOKEN_IDENT || token.decoded != debug || index + 1 >= count || tokens[index + 1].kind != TOKEN_LPAREN {
            next
        }
        open: index + 1
        close: closes[open]
        if close < 0 -> next
        last := close - 1
        if last > open && tokens[last].kind == TOKEN_COMMA -> last -= 1
        if last <= open -> next
        start: tokens[open + 1].span.start
        end: tokens[last].span.end
        close_end: tokens[close].span.end
        if start < source_offset || end <= start || close_end > limit -> next
        text: String.from_bytes(source.slice(start - source_offset, end - source_offset)) ?? next
        grouped: parser_debug_argument_compound(tokens, open + 1, last) && parser_debug_call_tight_at(tokens, source, source_offset, index, close)
        sites.push(DebugTraceSite{name_start: token.span.start, text: text, close_end: close_end, grouped: grouped})
    }
}

// Whether the argument tokens `first` through `last` are more than one
// operand: outside any bracket they hold a token no single operand has (an
// operator or keyword), or two operands side by side (`x as Int`). An
// operand is a name or literal with its member steps, calls, indexes and
// bodies.
parser_debug_argument_compound: fn(tokens: [Token], first: Int, last: Int) -> Bool Never! {
    depth := 0
    operand := false
    loop index in first..<last + 1 {
        kind: tokens[index].kind
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE {
            depth += 1
            next
        }
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 -> operand = true
            next
        }
        if depth > 0 || kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> next
        if kind == TOKEN_DOT || kind == TOKEN_QUESTION_DOT || kind == TOKEN_COLON_COLON {
            operand = false
            next
        }
        if kind == TOKEN_QUESTION || kind == TOKEN_BANG {
            if !operand -> return true
            next
        }
        if !parser_debug_operand_token(kind) || operand -> return true
        operand = true
    }
    false
}

parser_debug_operand_token: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_IDENT || kind == TOKEN_RAW_STRING || kind == TOKEN_STRING || kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_CHAR || kind == TOKEN_TRUE || kind == TOKEN_FALSE || kind == TOKEN_SELF || kind == TOKEN_NULL
}

// Whether the `debug(…)` call from token `name` to its `)` at `close` stands
// where an operator expression would bind differently without its own
// parentheses: anywhere but a whole value (after `:`, `=`, `->`, `return`,
// an opening bracket or `,`, or at a statement start) that ends there.
parser_debug_call_tight_at: fn(tokens: [Token], source: [U8], source_offset: Int, name: Int, close: Int) -> Bool Never! {
    if name > 0 {
        before: tokens[name - 1]
        starts: parser_debug_line_between_at(source, source_offset, before.span.end, tokens[name].span.start) && (parser_debug_operand_token(before.kind) || before.kind == TOKEN_RPAREN || before.kind == TOKEN_RBRACKET || before.kind == TOKEN_RBRACE)
        if !starts && !parser_debug_value_opener(before.kind) -> return true
    }
    if close + 1 >= tokens.len() -> return false
    after: tokens[close + 1]
    if parser_debug_line_between_at(source, source_offset, tokens[close].span.end, after.span.start) {
        return after.kind == TOKEN_DOT || after.kind == TOKEN_QUESTION_DOT
    }
    !parser_debug_value_closer(after.kind)
}

parser_debug_value_opener: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_COLON || kind == TOKEN_COLON_EQ || kind == TOKEN_EQ || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_RETURN || kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_COMMA || kind == TOKEN_SEMI || kind == TOKEN_KW_IF || kind == TOKEN_KW_IN || kind == TOKEN_KW_LOOP || kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT || (kind >= TOKEN_PLUS_EQ && kind <= TOKEN_SHR_EQ) || kind == TOKEN_TILDE_PIPE_EQ || kind == TOKEN_TILDE_EQ || kind == TOKEN_AMP_TILDE_EQ
}

parser_debug_value_closer: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE || kind == TOKEN_COMMA || kind == TOKEN_SEMI || kind == TOKEN_EOF || kind == TOKEN_LBRACE || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

// Whether the source bytes `start..<end` hold a line break.
parser_debug_line_between_at: fn(source: [U8], source_offset: Int, start: Int, end: Int) -> Bool Never! {
    lo: start - source_offset
    hi: end - source_offset
    if lo < 0 || hi > source.len() -> return false
    loop index in lo..<hi {
        if source[index] == 10 -> return true
    }
    false
}

parser_parse_program: fn(state: ^JetParserState) -> Program {
    program := ast_program()
    loop parser_current_kind(state) != TOKEN_EOF {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_EOF -> break
        before := state.position
        unit_start: parser_current(state).span.start
        parser_begin_node_unit(state, unit_start)
        if {
            // A top-level `@` is a misspelled applied rule.
            parser_current_kind(state) == TOKEN_AT -> {
                at: parser_bump(state)
                parser_add_error_code(state, "E0063", at.span, "applied rules use `#`, not `@`", "`#` marks attributes, instructions, and properties; prefix `@` marks compile-time names and fact reads, while infix `@` stays a package-source separator", "replace the leading `@` with `#`")
                parser_sync_top(state)
            }
            parser_user_policy_ahead(state) -> {
                declaration: parser_parse_user_policy(state)
                if declaration.valid -> program.user_policy_declarations.push(declaration.value)
            }
            parser_section_label_ahead(state) -> parser_report_section_label(state)
            parser_file_directive_ahead(state) -> parser_parse_file_directive(state, program)
            parser_file_cap_ahead(state) -> parser_parse_file_cap(state, program)
            parser_policy_file_decl_ahead(state) -> parser_parse_policy_file_decl(state, program)
            parser_unattached_marker_at_end(state) -> {
                marker: parser_parse_marker(state)
                program.rule_facts.push(AppliedRuleApplication{marker: marker, target: None, site: Val(RuleSite.File)})
            }
            parser_persist_binding_ahead(state) -> {
                errors_before: state.diagnostics.len()
                item: parser_parse_persist_binding(state)
                if parser_error_since(state, errors_before) -> parser_sync_top(state) else if item == .Val(value) {
                    program.items.push(value)
                } else { parser_sync_top(state) }
            }
            parser_marked_module_binding_ahead(state) -> {
                markers := [Marker]{}
                loop parser_current_kind(state) == TOKEN_HASH {
                    markers.push(parser_parse_marker(state))
                    // A marker on its own line still marks the binding below.
                    parser_skip_semicolons(state)
                }
                parser_check_step_limit(state, markers)
                start: parser_current(state).span
                errors_before: state.diagnostics.len()
                statement: parser_parse_binding_statement(state)
                definition_option: parser_module_binding_def(statement, start, parser_previous_end(state))
                if parser_error_since(state, errors_before) -> parser_sync_top(state) else if definition_option == .Val(definition) {
                    declared := definition.copy()
                    loop marker in markers {
                        declared.markers.push(marker.copy())
                        state.statement_rules.push(AppliedRuleApplication{marker: marker, target: Val(start), site: Val(RuleSite.Declaration)})
                    }
                    program.items.push(Item.Const{value: declared})
                } else { parser_sync_top(state) }
                if state.position == before -> parser_bump(state)
            }
            parser_item_ahead(state) -> {
                declaration: parser_parse_item_or_import(state)
                loop import in declaration.imports -> program.imports.push(import)
                if declaration.imports.len() == 0 {
                    if declaration.item == {
                        .Val(value) -> {
                            program.items.push(value)
                            loop companion in declaration.companions {
                                program.items.push(companion)
                            }
                        }
                        .None -> {
                            if !declaration.handled {
                                parser_add_error_here(state, "expected a declaration", "a declaration modifier must be followed by an item", "add an item declaration or remove the modifier")
                                parser_recover_statement(state)
                            }
                        }
                    }
                }
            }
            // The binding parser reads one named module binding; a
            // destructuring head or a failed binding reports and resynchronizes
            // at the next item.
            parser_module_binding_ahead(state) -> {
                start: parser_current(state).span
                destructuring: parser_kind_at(state, 1) == TOKEN_LBRACE
                errors_before: state.diagnostics.len()
                statement: if destructuring -> parser_parse_statement(state) else -> parser_parse_binding_statement(state)
                item: parser_module_binding_item(statement, start, parser_previous_end(state))
                if destructuring {
                    parser_add_error_code(state, "E0003", start, "module globals bind one name at a time", "a module binding is a named value available to every function in the file", "write `name: value` or `name := value`")
                    parser_sync_top(state)
                } else if parser_error_since(state, errors_before) { parser_sync_top(state) } else if item == .Val(value) {
                    if value == .Const(definition) {
                        parser_report_parenthesized_reexport(state, definition)
                    }
                    program.items.push(value)
                } else { parser_sync_top(state) }
                if state.position == before -> parser_bump(state)
            }
            parser_unknown_top_word_ahead(state) -> {
                parser_report_unknown_word(state, true)
                parser_sync_top(state)
            }
            else -> {
                // Resynchronize a failed script line like a block line and
                // step over a token the line could not consume.
                program.script_body.push(parser_parse_statement(state))
                parser_recover_aborted_statement(state, before)
                if state.position == before -> parser_bump(state)
            }
        }
        parser_recover_aborted_item(state, before)
        // An abort that no item or line took ends with its item.
        state.abort_mark = 0
        parser_skip_semicolons(state)
        if state.position == before {
            token: parser_current(state)
            parser_add_error_code(state, "E0003", token.span, "the parser could not advance through this source item", "top-level recovery prevents repeated diagnostics at one token", "remove or complete this item")
            parser_bump(state)
        }
    }
    program
}

// Imported group heads cannot reveal their file members until the loader has
// the defining module. Retain an unattached head for that ordinary replay.
parser_unattached_marker_at_end: fn(state: ^JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_HASH -> return false
    offset := 1
    if parser_kind_at(state, offset) == TOKEN_BANG -> offset += 1
    if parser_kind_at(state, offset) != TOKEN_IDENT -> return false
    offset += 1
    loop parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_IDENT {
        offset += 2
    }
    if parser_kind_at(state, offset) == TOKEN_LPAREN {
        depth := 1
        offset += 1
        loop depth > 0 {
            kind: parser_kind_at(state, offset)
            if kind == TOKEN_EOF -> return false
            if kind == TOKEN_LPAREN -> depth += 1
            if kind == TOKEN_RPAREN -> depth -= 1
            offset += 1
        }
    }
    loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    parser_kind_at(state, offset) == TOKEN_EOF
}

// The offset just past one `#[!]Name(.Name)*(…)` marker head at `start`
// (relative to the cursor), or -1 when none starts there.
parser_marker_head_end: fn(state: ^JetParserState, start: Int) -> Int Never! {
    if parser_kind_at(state, start) != TOKEN_HASH -> return -1
    offset := start + 1
    if parser_kind_at(state, offset) == TOKEN_BANG -> offset += 1
    if parser_kind_at(state, offset) != TOKEN_IDENT -> return -1
    offset += 1
    loop parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_IDENT {
        offset += 2
    }
    if parser_kind_at(state, offset) == TOKEN_LPAREN {
        depth := 1
        offset += 1
        loop depth > 0 {
            kind: parser_kind_at(state, offset)
            if kind == TOKEN_EOF -> return -1
            if kind == TOKEN_LPAREN -> depth += 1
            if kind == TOKEN_RPAREN -> depth -= 1
            offset += 1
        }
    }
    offset
}

// `#Rule name: value` at file scope: rules before a lowercase module
// binding, on its line or on lines of their own above it. A marked constant
// (`NAME: …`) and a type (`Name: …`) take the item route. The binding is the
// rules' Declaration site, which sema checks against each rule's row, and it
// carries them as its own markers (a `#ContextKey request_id: 0` is a key by
// its marker).
parser_marked_module_binding_ahead: fn(state: ^JetParserState) -> Bool Never! {
    offset := parser_marker_head_end(state, 0)
    if offset < 0 -> return false
    head_end := offset
    loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    loop parser_kind_at(state, offset) == TOKEN_HASH {
        offset = parser_marker_head_end(state, offset)
        if offset < 0 -> return false
        head_end = offset
        loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    }
    if parser_kind_at(state, offset) != TOKEN_IDENT -> return false
    next: parser_kind_at(state, offset + 1)
    if next != TOKEN_COLON && next != TOKEN_COLON_EQ -> return false
    name: parser_lookahead(state, offset)
    bytes: parser_value(state, name).bytes()
    if bytes.len() == 0 || !((bytes[0] >= 97 && bytes[0] <= 122) || bytes[0] == 95) -> return false
    // Markers on lines of their own above a function or another item take
    // the item route, which attaches them the same way.
    if offset == head_end -> return true
    value: parser_kind_at(state, offset + 2)
    !parser_is_item_keyword(value) && !parser_prep_verb_ahead(state, offset + 2, TOKEN_KW_FN)
}

// File rules bare
// `#NoPrelude`/`#HTML(…)`, a file-level `#Target(…)`, or a `#[…]` list of them.
// A qualified marker (`#HTML.LibraryNote` through `use html: library`) names
// an imported declaration, never the builtin rule its alias spells.
// `#Target(Wasm|JS)` attaches only to the `fn` or
// `module` it heads (the Target row's sites); before any other item it is the
// file ceiling. `#Target(OS.X)` attaches to the `impl` it heads.
parser_file_directive_ahead: fn(state: ^JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_HASH -> return false
    if parser_kind_at(state, 1) == TOKEN_LBRACKET -> return parser_file_marker_group_ahead(state)
    name: parser_lookahead(state, 1)
    if name.kind != TOKEN_IDENT || parser_kind_at(state, 2) == TOKEN_DOT -> return false
    rule: parser_value(state, name)
    if rule == "NoPrelude" || rule == "HTML" -> return true
    if rule != "Target" -> return false
    if parser_target_selects_file_web_at(state, 1) || !parser_hash_leads_to_item(state) {
        return true
    }
    !parser_target_names_os_at(state, 1) && !parser_hash_leads_to_function_or_module(state)
}

// `#FX(…)` above a `use` line at file scope caps the whole file; nothing
// else follows a file's head that way, so the cap would otherwise drop.
parser_file_cap_ahead: fn(state: ^JetParserState) -> Bool Never! {
    if parser_kind_at(state, 1) != TOKEN_IDENT || parser_value_at(state, 1) != MARKER_FX {
        return false
    }
    offset := parser_marker_head_end(state, 0)
    if offset < 0 -> return false
    loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    parser_kind_at(state, offset) == TOKEN_KW_USE
}

// The file's cap; a second one is E0999. Its owner is filled in by sema,
// which knows the file's name.
parser_parse_file_cap: fn(state: ^JetParserState, program: ^Program) {
    marker: parser_parse_marker(state)
    parser_skip_semicolons(state)
    if program.file_cap != None {
        parser_report_repeated_file_marker(state, MARKER_FX, marker.span)
        return
    }
    cap := parser_module_fx_cap(state, marker, "") ?? return
    cap.scope = "file"
    program.file_cap = Val(cap)
}

// `#Target(OS.…)`: an OS gate, never a web ceiling. `name_offset` is the
// offset of the `Target` name.
parser_target_names_os_at: fn(state: ^JetParserState, name_offset: Int) -> Bool Never! {
    parser_kind_at(state, name_offset + 1) == TOKEN_LPAREN && parser_kind_at(state, name_offset + 2) == TOKEN_IDENT && parser_value_at(state, name_offset + 2) == "OS"
}

parser_is_file_rule: fn(name: String) -> Bool Never! {
    name == "NoPrelude" || name == "Target" || name == "HTML"
}

// A `#[…]` list whose every entry is a file rule configures the file, unless
// it heads a type, or every entry is a partition `#Target` that the function
// below can take (`#[Target(JS)] fn`).
parser_file_marker_group_ahead: fn(state: ^JetParserState) -> Bool Never! {
    offset := 2
    every_entry_fits_function := true
    loop {
        if parser_kind_at(state, offset) == TOKEN_BANG -> offset += 1
        name: parser_lookahead(state, offset)
        if name.kind != TOKEN_IDENT || parser_kind_at(state, offset + 1) == TOKEN_DOT || !parser_is_file_rule(parser_value(state, name)) {
            return false
        }
        if parser_value(state, name) != "Target" || parser_target_selects_file_web_at(state, offset) {
            every_entry_fits_function = false
        }
        offset += 1
        if parser_kind_at(state, offset) == TOKEN_LPAREN {
            depth := 0
            loop {
                kind: parser_kind_at(state, offset)
                if kind == TOKEN_EOF -> return false
                offset += 1
                if kind == TOKEN_LPAREN -> depth += 1
                if kind == TOKEN_RPAREN {
                    depth -= 1
                    if depth == 0 -> break
                }
            }
        }
        if parser_kind_at(state, offset) == TOKEN_COMMA {
            offset += 1
            next
        }
        if parser_kind_at(state, offset) != TOKEN_RBRACKET -> return false
        offset += 1
        break
    }
    loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    after: parser_kind_at(state, offset)
    if !every_entry_fits_function -> return true
    if after == TOKEN_KW_STRUCT || after == TOKEN_KW_ENUM -> return false
    function_follows: after == TOKEN_KW_FN || parser_prep_verb_ahead(state, offset, TOKEN_KW_FN) || after == TOKEN_HASH
    !(every_entry_fits_function && function_follows)
}

// `#Target(Web)` (or a path ending in `Target.Web`) is the file default, never
// a marker on the next item. `name_offset` is the offset of the `Target` name.
parser_target_selects_file_web_at: fn(state: ^JetParserState, name_offset: Int) -> Bool Never! {
    if parser_kind_at(state, name_offset + 1) != TOKEN_LPAREN -> return false
    previous := ""
    last := ""
    count := 0
    offset := name_offset + 2
    loop {
        token: parser_lookahead(state, offset)
        if token.kind == TOKEN_RPAREN -> break
        if token.kind != TOKEN_IDENT && token.kind != TOKEN_DOT -> return false
        if token.kind == TOKEN_IDENT {
            previous = last
            last = parser_value(state, token)
            count += 1
        }
        offset += 1
    }
    last == "Web" && (count == 1 || previous == "Target")
}

// One run of file rules, bare or in `#[…]` lists. Two distinct rules belong
// in one list (E0999); each rule then sets its program field. A bare rule
// with `module` after it on the same line heads that module
// (`heads_module`); one that ends its line stays on the file.
parser_parse_file_directive: fn(state: ^JetParserState, program: ^Program) {
    markers := [Marker]{}
    chunks := 0
    bracket_chunks := 0
    heads_module := false
    sequence := parser_current(state).span
    loop parser_file_directive_ahead(state) && !parser_aborting(state) {
        if parser_kind_at(state, 1) == TOKEN_LBRACKET {
            group: parser_parse_marker_group_list(state)
            loop marker in group.markers -> markers.push(marker)
            sequence.end = group.span.end
            bracket_chunks += 1
        } else {
            marker: parser_parse_marker(state)
            markers.push(marker.copy())
            sequence.end = marker.span.end
            heads_module = parser_current_kind(state) == TOKEN_KW_MODULE
            parser_skip_semicolons(state)
        }
        chunks += 1
    }
    parser_report_adjacent_markers(state, markers, chunks, bracket_chunks, sequence, "file")
    single: chunks == 1 && bracket_chunks == 0
    loop marker in markers {
        parser_apply_file_marker(state, program, marker, single, single && heads_module)
    }
}

parser_apply_file_marker: fn(state: ^JetParserState, program: ^Program, marker: Marker, single: Bool, heads_module: Bool) {
    program.rule_facts.push(AppliedRuleApplication{marker: marker, target: None, site: Val(RuleSite.File)})
    hash: Span{start: marker.span.start, end: marker.span.start + 1}
    repeat_span: if single -> hash else -> marker.span
    if marker.name == {
        "NoPrelude" -> {
            if program.no_prelude {
                parser_report_repeated_file_marker(state, "NoPrelude", repeat_span)
                return
            }
            program.no_prelude = true
        }
        "Target" -> parser_apply_file_target(state, program, marker, single, heads_module)
        "HTML" -> {
            if program.html_path != None {
                parser_add_error(state, marker.span, "only one `#HTML(…)` marker is allowed per file", "a file may declare at most one companion host page", "remove the duplicate `#HTML(…)` marker")
                return
            }
            values: parser_bind_marker_arguments(state, marker, [String]{"page"}, 1) ?? return
            page: values[0] ?? return
            program.html_path = parser_html_page_path(page)
        }
        else -> {}
    }
}

parser_report_repeated_file_marker: fn(state: ^JetParserState, name: String, span: Span) {
    parser_add_error_code(state, "E0999", span, "`#{name}` is already applied to this file", "`#{name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
}

// The companion page is `Path{"page.html"}` or a plain literal string; any
// other value names no page.
parser_html_page_path: fn(page: Expr) -> String? {
    if page == .TypedLit(head, body, _, _) && head == .Val(ty) && ty == .Named(type_name) && type_name == "Path" && body == .Value(inner) {
        return parser_expr_literal_string(inner)
    }
    parser_expr_literal_string(page)
}

// `#Target(Web)` picks the file's default CLI backend, `#Target(Wasm|JS)` caps
// its web partition, and `#Target(OS.…)` only gates an `impl`.
parser_apply_file_target: fn(state: ^JetParserState, program: ^Program, marker: Marker, single: Bool, heads_module: Bool) {
    values: parser_bind_marker_arguments(state, marker, [String]{"target"}, 1) ?? return
    target: values[0] ?? return
    name: parser_marker_target_path(target) ?? {
        parser_marker_shape_error(state, marker)
        return
    }
    kept: name.split(".").to_list()
    here: parser_current(state).span
    if kept.len() == 2 && kept[0] == "OS" {
        os: kept[1]
        if target_os_named(os) == None {
            parser_add_error(state, expr_span(target), "`#Target(OS.{os})` is not a known OS", "OS targets are {target_os_gates()}", "write `#Target(OS.Linux)` or another OS of the list")
            return
        }
        if single {
            parser_add_error(state, here, "`#Target(OS.{os})` isn't valid here", "`OS.Linux`/`OS.MacOS`/`OS.Windows` gates a whole `impl` block, not a module, function, or any other item", "write `#Target(OS.{os}) impl Type.Trait {{ … }}`")
        } else { parser_report_grouped_target_conflict(state, marker) }
        return
    }
    if name == "Web" {
        if heads_module {
            parser_add_error(state, here, "`#Target(Web)` isn't valid on a module", "`Web` is a file-level default-backend marker, not a partition ceiling", "move `#Target(Web)` to the top of the file, outside any module; use `#Target(Wasm)` or `#Target(JS)` on a module")
            return
        }
        if program.default_target != None {
            if single {
                parser_add_error(state, here, "only one `#Target(Web)` marker is allowed per file", "a file may declare at most one default backend", "remove the duplicate `#Target(Web)` marker")
            } else { parser_report_grouped_target_conflict(state, marker) }
            return
        }
        program.default_target = Val("web")
        return
    }
    bucket: if name == {
        "Wasm" -> Val(WebBucket.Wasm)
        "JS" -> Val(WebBucket.JS)
        else -> WebBucket?{None}
    }
    if bucket == None {
        parser_add_error(state, expr_span(target), "`#Target({name})` is not a known web partition", "web targets are `Wasm` (compute), `JS` (DOM/view), `Web` (default CLI backend), or `OS.Linux`/`OS.MacOS`/`OS.Windows` (native platform gating)", "write `#Target(Wasm)`, `#Target(JS)`, `#Target(Web)`, or `#Target(OS.{{Linux|MacOS|Windows}})`")
        return
    }
    if program.web_target_ceiling != None {
        if single {
            parser_add_error(state, here, "only one `#Target(…)` ceiling is allowed per file", "a file may declare at most one web partition ceiling", "remove the duplicate `#Target(Wasm)` or `#Target(JS)` marker")
        } else { parser_report_grouped_target_conflict(state, marker) }
        return
    }
    program.web_target_ceiling = bucket
}

parser_report_grouped_target_conflict: fn(state: ^JetParserState, marker: Marker) {
    parser_add_error(state, marker.span, "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`")
}

// A `priv:` section label would let one line flip the visibility of
// everything below it; E0415 rejects the label itself.
parser_section_label_ahead: fn(state: ^JetParserState) -> Bool Never! {
    parser_kind_at(state, 1) == TOKEN_COLON && parser_current_kind(state) == TOKEN_KW_PRIV
}

parser_report_section_label: fn(state: ^JetParserState) {
    first: parser_bump(state)
    colon: parser_bump(state)
    label: parser_cover(first.span, colon.span)
    deletion: parser_deletion_edit(state, label)
    parser_add_error_code_edit(state, "E0415", label, "section visibility labels like `priv:` are not supported", "moving an item above or below a label would silently change its visibility", "delete the label; group internal declarations in a `priv module`", deletion)
}

parser_item_ahead: fn(state: ^JetParserState) -> Bool Never! {
    kind: parser_current_kind(state)
    if {
        parser_item_declaration_ahead_at(state, 0) -> true
        parser_template_loop_ahead(state) -> true
        parser_is_item_keyword(kind) -> true
        parser_prep_verb_ahead(state, 0, TOKEN_KW_USE) -> true
        kind == TOKEN_KW_PRIV -> true
        parser_type_alias_ahead_at(state, 0) -> true
        kind == TOKEN_HASH -> parser_hash_leads_to_item(state)
        else -> false
    }
}

parser_is_item_keyword: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_USE || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_EXTERN
}

// + owner ruling (2026-09-30): an immutable module binding
// is named in ALL_CAPS, `MAX_ROWS: 100`. This is the casing predicate only;
// compile time is always the explicit `NAME: #run value`.
parser_constant_name: fn(name: String) -> Bool Never! {
    if name == "" || name.starts_with("@") || name.starts_with("$") -> return false
    has_upper := false
    loop byte in name.bytes() {
        if byte >= (U8{97}) && byte <= (U8{122}) -> return false
        if byte >= (U8{65}) && byte <= (U8{90}) -> has_upper = true
    }
    has_upper
}

// At `#`: the compiler values `#build`, `#phase` and `#program` and the site
// values `#package`, `#here` and `#caller` written as one word, which is no
// marker path (`#here.Name`); sema decides where `#caller` is legal.
parser_site_value_ahead: fn(state: ^JetParserState) -> Bool Never! {
    word: parser_value_at(state, 1)
    if word != "build" && word != "phase" && word != "program" && word != "package" && word != "here" && word != "caller" {
        return false
    }
    if parser_lookahead(state, 0).span.end != parser_lookahead(state, 1).span.start -> return false
    if parser_kind_at(state, 2) == TOKEN_DOT && parser_kind_at(state, 3) == TOKEN_IDENT {
        next: parser_value_at(state, 3)
        if next != "" && next.bytes()[0] >= (U8{65}) && next.bytes()[0] <= (U8{90}) -> return false
    }
    true
}

// A `$` word in ordinary expression position. An ALL_CAPS `$NAME` is the
// config-only environment read; any other `$word` is no name. Both report
// the whole word. Fatal for the expression.
parser_report_unknown_fact_root: fn(state: ^JetParserState, name: String, span: Span) {
    body: if name.starts_with("$") -> name.slice(1..<name.len()) else -> name
    if body != "" && parser_constant_name(body) {
        parser_add_error(state, span, "`$NAME` is an environment read for config surfaces only", "Jet reserves `$NAME` for typed environment access in `env.jet` and deploy/config files; ordinary program code does not read the environment with `$`", "move the read to `env.jet` or a deploy/config file, or use an explicit program API for runtime environment access")
        return
    }
    parser_add_error(state, span, "`{name}` is not a name", "Jet program source has no `$` words; only config surfaces read `$NAME` from the environment", "write the name without the `$`")
}

// After `#Static` / `#Inline`, a constant binding `NAME: …` is a declaration.
parser_marked_const_ahead: fn(state: ^JetParserState, offset: Int) -> Bool Never! {
    token: parser_lookahead(state, offset)
    if token.kind != TOKEN_IDENT || parser_kind_at(state, offset + 1) != TOKEN_COLON -> return false
    parser_constant_name(parser_value(state, token))
}

// Newline terminators between the markers and before the item are skipped, so
// `#[A, B]` on its own line still attaches to the item below.
parser_hash_leads_to_item: fn(state: ^JetParserState) -> Bool Never! {
    offset: parser_hash_item_offset(state)
    if offset < 0 -> return false
    kind: parser_kind_at(state, offset)
    parser_item_declaration_ahead_at(state, offset) || parser_marked_const_ahead(state, offset) || parser_type_alias_ahead_at(state, offset) || parser_is_item_keyword(kind) || kind == TOKEN_KW_PRIV
}

// The marker run ahead heads a function (`fn`, `#run fn`) or a `module`.
parser_hash_leads_to_function_or_module: fn(state: ^JetParserState) -> Bool Never! {
    offset := parser_hash_item_offset(state)
    if offset < 0 -> return false
    if parser_kind_at(state, offset) == TOKEN_KW_PRIV -> offset += 1
    kind: parser_kind_at(state, offset)
    kind == TOKEN_KW_FN || kind == TOKEN_KW_MODULE || parser_prep_verb_ahead(state, offset, TOKEN_KW_FN)
}

// The offset of the item after the marker run at the cursor (newline
// terminators skipped), or -1 when a marker in the run is malformed.
parser_hash_item_offset: fn(state: ^JetParserState) -> Int Never! {
    offset := 0
    loop {
        loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
        if parser_item_declaration_ahead_at(state, offset) -> return offset
        if parser_kind_at(state, offset) != TOKEN_HASH -> break
        offset += 1
        if parser_kind_at(state, offset) == TOKEN_LBRACKET {
            offset += 1
            nesting := 1
            loop nesting > 0 && parser_kind_at(state, offset) != TOKEN_EOF {
                kind: parser_kind_at(state, offset)
                if kind == {
                    TOKEN_LBRACKET -> nesting += 1
                    TOKEN_RBRACKET -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
            next
        }
        if parser_kind_at(state, offset) == TOKEN_BANG -> offset += 1
        if parser_kind_at(state, offset) != TOKEN_IDENT -> return -1
        offset += 1
        loop parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_IDENT {
            offset += 2
        }
        if parser_kind_at(state, offset) == TOKEN_LPAREN {
            nesting := 1
            offset += 1
            loop nesting > 0 && parser_kind_at(state, offset) != TOKEN_EOF {
                kind: parser_kind_at(state, offset)
                if kind == {
                    TOKEN_LPAREN -> nesting += 1
                    TOKEN_RPAREN -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
        }
    }
    loop parser_kind_at(state, offset) == TOKEN_SEMI -> offset += 1
    offset
}
