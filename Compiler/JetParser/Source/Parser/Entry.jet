// Public parser entry points preserve lexer diagnostics and original byte spans.
use jet_foundation.[
    AppliedRuleApplication,
    CompilerThreads,
    DIAGNOSTIC_ERROR,
    DebugTraceSite,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    ElseArmSpan,
    Expr,
    FencedStatement,
    ImportDecl,
    Item,
    Marker,
    Name,
    ParseResult,
    PolicyDeclaration,
    Program,
    RuleSite,
    Span,
    Stmt,
    TextEdit,
    UserPolicyDecl,
    WebBucket,
    ast_program,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_single,
    compiler_transfer_rows,
    diagnostic_from_registry,
    diagnostic_with_edit_grade,
    expr_span,
    name_count,
    name_find,
    name_index,
]
use jet_lexer.[
    Lexed,
    STRING_PART_INTERPOLATION,
    TOKEN_AT,
    TOKEN_BANG,
    TOKEN_BLOCK_COMMENT,
    TOKEN_COLON,
    TOKEN_COMMA,
    TOKEN_COLON_COLON,
    TOKEN_DOT,
    TOKEN_EOF,
    TOKEN_FENCE_CLOSE,
    TOKEN_FENCE_OPEN,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_KW_COMPTIME,
    TOKEN_KW_CONST,
    TOKEN_KW_DERIVE,
    TOKEN_KW_EFFECT,
    TOKEN_KW_ENUM,
    TOKEN_KW_EXTERN,
    TOKEN_KW_FN,
    TOKEN_KW_IMPL,
    TOKEN_KW_LOOP,
    TOKEN_KW_MODULE,
    TOKEN_KW_PRIV,
    TOKEN_KW_PUB,
    TOKEN_KW_STRUCT,
    TOKEN_KW_TAG,
    TOKEN_KW_TRAIT,
    TOKEN_KW_USE,
    TOKEN_LBRACE,
    TOKEN_LINE_COMMENT,
    TOKEN_LBRACKET,
    TOKEN_LPAREN,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_SEMI,
    Token,
    TokenTables,
    lex,
    lex_generated,
    token_decoded,
]

fn parse_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex(source), source, parser_line_starts(source), false)
}

// Embedded Core library sources are vetted stdlib internals: they may spell
// the reserved `__name` namespace (Rust `Lexer::lex_generated`). Only the
// loader's embedded-Core path parses this way; a user file never does.
fn parse_generated_source(source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(lex_generated(source), source, parser_line_starts(source), false)
}

fn parse_source_with_marker_groups(source: [U8], groups: [NamedMarkerGroupTokens]) -> ParseResult {
    lexed := lex(source)
    lexed.tokens = expand_named_marker_groups(lexed.tokens, &lexed.tables, groups)
    parser_parse_lexed_lines(lexed, source, parser_line_starts(source), false)
}

fn parse_generated_source_with_marker_groups(source: [U8], groups: [NamedMarkerGroupTokens]) -> ParseResult {
    lexed := lex_generated(source)
    lexed.tokens = expand_named_marker_groups(lexed.tokens, &lexed.tables, groups)
    parser_parse_lexed_lines(lexed, source, parser_line_starts(source), false)
}

// The parse entry points take the caller's tokens: they move into the parser
// instead of being copied.
fn parse_lexed(lexed: ^Lexed) -> ParseResult {
    parser_parse_lexed_lines(^lexed, [U8]{}, [Int]{}, false)
}

// Parse just the supplied token slice with its aggregate source available for
// canonical source-dependent diagnostics. REPL turns never reparse old tokens.
fn parse_lexed_with_source(lexed: ^Lexed, source: [U8], line_starts: [Int]) -> ParseResult {
    parser_parse_lexed_lines(^lexed, source, line_starts, false)
}

// parse_lexed_with_source on the admitted compiler threads: a large source
// is cut at top-level item boundaries and its chunks parse at once. `runs`
// are the lexer's item runs (`LexedThreads.runs`: `[0, r1, …, tokens.len()]`,
// each later run starting with the terminator of the item before it and
// then an item head, delimiters nesting within every run), where the cut
// scan itself runs in parallel; `[0, tokens.len()]` scans on this thread.
fn parse_lexed_with_source_threads(lexed: ^Lexed, source: [U8], line_starts: [Int], runs: [Int], threads: CompilerThreads) -> ParseResult {
    parser_parse_lexed_lines_threads(^lexed, source, line_starts, runs, false, threads)
}

// Parse a Jetpack config surface (Rust `parse_config_with_source`): the
// config lexer keeps `$NAME` as one identifier token, which this parser reads
// as the typed environment read `source` stays available
// for config values whose spelling is not a general Jet expression.
fn parse_config_with_source(lexed: ^Lexed, source: [U8]) -> ParseResult {
    parser_parse_lexed_lines(^lexed, source, parser_line_starts(source), true)
}

// The lexed tokens move into the parser state (field moves reset the field,
// so no token list is copied on the way). One thread: this entry spawns
// nothing, so it stays infallible for the `Never!` callers of the parse
// entry points above.
fn parser_parse_lexed_lines(input: ^Lexed, source: [U8], line_starts: [Int], allow_environment_reads: Bool) -> ParseResult {
    lexed := ^input
    source_end :: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    tokens := ^lexed.tokens
    lexed.tokens = [Token]{}
    prepared := parser_prepare_tokens(^tokens, &lexed.tables)
    parser_parse_prepared(^prepared, lexed.diagnostics, source_end, line_starts, source, allow_environment_reads, ^lexed.tables)
}

// parser_parse_lexed_lines on the admitted compiler threads. With one item
// run, fence expansion runs over the whole stream first and the chunk cut
// (parser_chunk_bounds) then decides whether the stream parses as one or as
// parallel item runs. With the lexer's item runs the cut scan runs per run
// on the threads (parser_chunk_bounds_runs); a stream without fences keeps
// the lexer's tokens, so the cut it found applies to them, and a stream
// with fences takes the one-run route. A thread spawn can fail, so this
// entry is fallible like the loader's parse waves that call it.
fn parser_parse_lexed_lines_threads(input: ^Lexed, source: [U8], line_starts: [Int], runs: [Int], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    lexed := ^input
    source_end :: if lexed.tokens.len() > 0 -> lexed.tokens[lexed.tokens.len() - 1].span.start else -> 0
    tokens := ^lexed.tokens
    tables := ^lexed.tables
    diagnostics := ^lexed.diagnostics
    if runs.len() <= 2 -> return parser_parse_tokens_threads(^tokens, ^tables, ^diagnostics, source_end, line_starts, source, allow_environment_reads, threads)
    parser_parse_runs_threads(^tokens, ^tables, ^diagnostics, source_end, line_starts, source, runs, allow_environment_reads, threads)
}

// The item-run route: the cut scan per run on the threads; a stream with
// fences takes the one-run route from here.
fn parser_parse_runs_threads(input: ^[Token], tables_input: ^TokenTables, lexer_diagnostics: ^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], runs: [Int], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    tables := ^tables_input
    diagnostics := ^lexer_diagnostics
    scan := parser_chunk_bounds_runs(^input, tables, source, runs, threads)
    fences :: scan.fences
    bounds := ^scan.bounds
    tokens := ^scan.tokens
    if fences -> return parser_parse_tokens_threads(^tokens, ^tables, ^diagnostics, source_end, line_starts, source, allow_environment_reads, threads)
    parser_parse_bounds_threads(^tokens, bounds, ^tables, ^diagnostics, source_end, line_starts, source, allow_environment_reads)
}

// A fence-free stream with its cut bounds: the lexer's tokens parse as one
// or as the chunks the bounds name.
fn parser_parse_bounds_threads(input: ^[Token], bounds: [Int], tables_input: ^TokenTables, lexer_diagnostics: ^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool) -> ParseResult {
    tables := ^tables_input
    diagnostics := ^lexer_diagnostics
    prepared := ParserFenceExpansion{tokens: ^input, fenced_statements: [FencedStatement]{}, diagnostics: [Diagnostic]{}, budget: ParserFenceBudget{entries: 0, bytes: 0}}
    if bounds.len() <= 2 -> return parser_parse_prepared(^prepared, diagnostics, source_end, line_starts, source, allow_environment_reads, ^tables)
    parser_parse_chunked(^prepared, bounds, diagnostics, source_end, line_starts, source, allow_environment_reads, ^tables)
}

// The one-run route: fence expansion over the whole stream, then the cut
// scan on this thread.
fn parser_parse_tokens_threads(input: ^[Token], tables_input: ^TokenTables, lexer_diagnostics: ^[Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, threads: CompilerThreads) -> ParseResult {
    tables := ^tables_input
    diagnostics := ^lexer_diagnostics
    prepared := parser_prepare_tokens(^input, &tables)
    bounds :: if prepared.diagnostics.len() > 0 -> [Int]{} else -> parser_chunk_bounds(prepared.tokens, tables, source, threads)
    if bounds.len() <= 2 -> return parser_parse_prepared(^prepared, diagnostics, source_end, line_starts, source, allow_environment_reads, ^tables)
    parser_parse_chunked(^prepared, bounds, diagnostics, source_end, line_starts, source, allow_environment_reads, ^tables)
}

fn parser_line_starts(source: [U8]) -> [Int] Never! {
    starts := [Int]{0}
    loop index in 0..<source.len() {
        if source[index] == (U8{10}) -> &starts.push(index + 1)
    }
    starts
}

fn parse_tokens(tokens: [Token], tables: TokenTables) -> ParseResult {
    source_end :: if {
        tokens.len() > 0 -> {
            last :: tokens[tokens.len() - 1]
            if last.kind == TOKEN_EOF -> last.span.start else -> last.span.end
        }
        else -> 0
    }
    owned_tables := tables.copy()
    prepared := parser_prepare_tokens(tokens.copy(), &owned_tables)
    parser_parse_prepared(^prepared, [Diagnostic]{}, source_end, [Int]{}, [U8]{}, false, ^owned_tables)
}

// Fence expansion runs before parsing. A fence error stops the
// parse like any token-level rejection: no partially expanded AST is built.
fn parser_parse_prepared(input: ^ParserFenceExpansion, lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, tables: ^TokenTables) -> ParseResult {
    prepared := ^input
    if prepared.diagnostics.len() > 0 {
        diagnostics := [Diagnostic]{}
        loop diagnostic in lexer_diagnostics -> &diagnostics.push(diagnostic)
        loop diagnostic in prepared.diagnostics -> &diagnostics.push(diagnostic)
        return ParseResult{program: ast_program(), diagnostics: diagnostics}
    }
    tokens := ^prepared.tokens
    prepared.tokens = [Token]{}
    state := JetParserState{tokens: ^tokens, tables: [TokenTables]{^tables}, position: 0, diagnostics: lexer_diagnostics, source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, result_handler_depth: 0, statement_start: -1, line_starts: line_starts, sources: [[U8]]{source}, allow_environment_reads: allow_environment_reads}
    program := parser_parse_program(&state)
    program.block_spans = state.block_spans
    program.else_arms = state.else_arms
    loop declaration in state.block_policy_declarations -> &program.policy_declarations.push(declaration)
    loop application in state.statement_rules {
        &program.applied_rules.push(application)
        &program.rule_facts.push(application)
    }
    program.fenced_statements = prepared.fenced_statements
    program.used_import_names = parser_used_import_names(state.tokens, state.tables[0], program.imports, program.items)
    program.debug_sites = parser_debug_trace_sites(state.tokens, state.tables[0], source)
    ParseResult{program: program, diagnostics: state.diagnostics}
}

// Parallel parsing of one source. The prepared token stream is
// cut at top-level item boundaries and each run of items parses on its own
// thread with its own parser state; the whole-file program is joined from
// the chunk programs in chunk order. Every parser decision inside an item
// reads only that item's tokens, the terminator before it and the source
// text, so a clean chunk parse yields exactly the one-thread parse: the same
// items, spans, lints and side tables, in the same order. The cut never
// applies where the parser keeps whole-file state (parser_chunk_bounds), and
// error recovery resynchronizes past item boundaries, so a chunk error
// hands the whole stream to the one-thread parse for its diagnostics.

// A chunk thread is admitted for at least this many tokens.
PARSER_CHUNK_MIN_TOKENS :: 65536
// Each chunk thread holds its own copy of the source text, line starts and
// name tables beside its tokens: about this much per source byte.
PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE :: 4

// What every chunk thread reads. The one-row lists hand the token stream and
// the tables back to the caller after the join without copying them.
struct ParserChunkShared {
    tokens: [[Token]]
    tables: [TokenTables]
    source: [U8]
    line_starts: [Int]
    source_end: Int
    allow_environment_reads: Bool
}

// One thread's chunk: the token range `start..<end` it parses, and after the
// parse its one output row.
struct ParserChunkPart {
    start: Int
    end: Int
    outputs: [ParserChunkOutput]
}

// A chunk's program and the parser-state side tables the whole-file program
// is joined from.
struct ParserChunkOutput {
    program: Program
    diagnostics: [Diagnostic]
    block_spans: [Span]
    else_arms: [ElseArmSpan]
    block_policy_declarations: [PolicyDeclaration]
    statement_rules: [AppliedRuleApplication]
}

// A token kind that opens a top-level item after a terminator: the item
// keywords, the visibility words and a `#` marker run (whose item follows
// inside the same chunk, since `parser_hash_leads_to_item` reads it there).
fn parser_chunk_head_kind(kind: Int) -> Bool Never! {
    parser_is_item_keyword(kind) || kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV || kind == TOKEN_HASH
}

// The chunk bounds for the admitted threads: `[0, c1, …, tokens.len()]`, or
// `[0, tokens.len()]` when the stream parses as one. A cut sits before an
// item head (parser_chunk_head_kind) at delimiter depth 0 whose previous
// code tokens are a top-level `}` and the line terminator after it, so the
// previous chunk ends exactly where the one-thread parse finishes that item
// (parser_finish_statement consumed the terminator) and the next begins
// where its item loop would. The stream stays whole when the parser reads
// whole-file state: an authored `;` (E0373 reports once per file), a file rule
// (`#PubFile`, `#NoPrelude`, `#HTML`, `#Target`, `#Policy` set program
// fields that later rules read), or unbalanced delimiters.
fn parser_chunk_bounds(tokens: [Token], tables: TokenTables, source: [U8], threads: CompilerThreads) -> [Int] Never! {
    whole :: [Int]{0, tokens.len()}
    workers :: compiler_threads_admit(threads, tokens.len(), tokens.len(), PARSER_CHUNK_MIN_TOKENS, source.len() * PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE, 0)
    if workers <= 1 -> return whole
    scan :: parser_chunk_scan(tokens, source, parser_chunk_file_rules(tables), 0, tokens.len())
    if scan.whole -> return whole
    parser_chunk_bounds_of(scan.candidates, tokens.len(), workers)
}

// The name ids of the file rules (parser_chunk_bounds).
fn parser_chunk_file_rules(tables: TokenTables) -> [Int] Never! {
    file_rules := [Int]{}
    file_rule_names :: [String]{"PubFile", "PublicFile", "NoPrelude", "HTML", "Html", "Target", "Policy"}
    loop rule in file_rule_names {
        if name_find(tables.names, rule) == .Val(name) -> &file_rules.push(name_index(name))
    }
    file_rules
}

// A cut scan of one token range: whether the range keeps the stream whole,
// whether it holds a fence token, and its cut candidates.
struct ParserChunkScan {
    whole: Bool
    fences: Bool
    candidates: [Int]
}

// The cut scan of `tokens[from..<to]` from the state the one-thread scan
// has at a range that starts the stream or starts an item run (depth 0,
// no `#` marker ahead, no marker list open): the candidates inside the
// range, and whether it keeps the stream whole.
fn parser_chunk_scan(tokens: [Token], source: [U8], file_rules: [Int], from: Int, to: Int) -> ParserChunkScan Never! {
    whole :: ParserChunkScan{whole: true, fences: true, candidates: [Int]{}}
    candidates := [Int]{}
    fences := false
    depth := 0
    // The previous code token's kind (-1 at the start).
    previous := -1
    // The last code token was a `}` that closed a depth-0 group.
    closed_item := false
    // A line terminator followed that `}`.
    terminated := false
    // A top-level `#` whose marker name is still ahead.
    hash_ahead := false
    // Inside a top-level `#[ … ]` marker list.
    marker_list := false
    loop index in from..<to {
        kind :: tokens[index].kind
        if kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT -> next
        if kind == TOKEN_FENCE_OPEN || kind == TOKEN_FENCE_CLOSE -> fences = true
        if kind == TOKEN_SEMI {
            if tokens[index].span.start < tokens[index].span.end -> return whole
            if closed_item -> terminated = true
            previous = kind
            next
        }
        if kind == TOKEN_IDENT {
            start :: tokens[index].span.start
            if (hash_ahead || (marker_list && depth == 1 && (previous == TOKEN_LBRACKET || previous == TOKEN_COMMA || previous == TOKEN_BANG))) && file_rules.contains(name_index(tokens[index].decoded)) -> return whole
        }
        if terminated && depth == 0 && parser_chunk_head_kind(kind) -> &candidates.push(index)
        terminated = false
        closed_item = false
        if hash_ahead {
            if kind == TOKEN_LBRACKET -> marker_list = true
            if kind != TOKEN_BANG -> hash_ahead = false
        } else if kind == TOKEN_HASH && depth == 0 {
            hash_ahead = true
        }
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE {
            depth += 1
        } else if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE {
            depth -= 1
            if depth < 0 -> return whole
            if depth == 0 {
                marker_list = false
                if kind == TOKEN_RBRACE -> closed_item = true
            }
        }
        previous = kind
    }
    if depth != 0 -> return whole
    ParserChunkScan{whole: false, fences: fences, candidates: ^candidates}
}

// The chunk bounds over `candidates` (ascending token indexes): a cut at the
// first candidate at or past each equal share of the tokens.
fn parser_chunk_bounds_of(candidates: [Int], count: Int, workers: Int) -> [Int] Never! {
    if candidates.len() == 0 -> return [Int]{0, count}
    bounds := [Int]{0}
    candidate := 0
    loop share in 1..<workers {
        target :: share * count /% workers
        loop candidate < candidates.len() && candidates[candidate] < target -> candidate += 1
        if candidate >= candidates.len() -> break
        if candidates[candidate] > bounds[bounds.len() - 1] -> &bounds.push(candidates[candidate])
    }
    &bounds.push(count)
    bounds
}

// The cut and fence facts of the whole stream, scanned per lexer item run
// on the threads.
struct ParserRunBounds {
    tokens: [Token]
    bounds: [Int]
    fences: Bool
}

// What every run scan thread reads.
struct ParserRunShared {
    tokens: [[Token]]
    source: [U8]
    file_rules: [Int]
}

// One thread's item runs `runs[start..<end]` and, after the scan, its one
// output row.
struct ParserRunPart {
    start: Int
    end: Int
    outputs: [ParserChunkScan]
}

// parser_chunk_bounds over the lexer's item runs: the cut scan of each run
// starts from the one-thread scan's state at a run start (the run's first
// token is the terminator after a depth-0 `}`, so the scan there has depth
// 0 and no marker ahead; only `terminated` differs, which decides exactly
// the run's head token — a candidate by the lexer's cut rule, added here).
// The runs' candidates join in run order and any run that keeps the stream
// whole keeps it whole. The tokens move through the shared inputs and come
// back unchanged.
fn parser_chunk_bounds_runs(input: ^[Token], tables: TokenTables, source: [U8], runs: [Int], threads: CompilerThreads) -> ParserRunBounds {
    tokens := ^input
    count :: tokens.len()
    workers :: compiler_threads_admit(threads, count, count, PARSER_CHUNK_MIN_TOKENS, source.len() * PARSER_CHUNK_SCRATCH_PER_SOURCE_BYTE, 0)
    run_count :: runs.len() - 1
    scanners :: if workers < run_count -> workers else -> run_count
    if scanners <= 1 {
        scan :: parser_chunk_scan(tokens, source, parser_chunk_file_rules(tables), 0, count)
        bounds :: if scan.whole || workers <= 1 -> [Int]{0, count} else -> parser_chunk_bounds_of(scan.candidates, count, workers)
        return ParserRunBounds{tokens: ^tokens, bounds: bounds, fences: scan.fences}
    }
    inputs :: shared ParserRunShared{tokens: [[Token]]{^tokens}, source: source, file_rules: parser_chunk_file_rules(tables)}
    parts := [Shared<ParserRunPart>]{}
    loop part in 0..<scanners -> &parts.push(shared ParserRunPart{start: part * run_count /% scanners, end: (part + 1) * run_count /% scanners, outputs: [ParserChunkScan]{}})
    _ := parser_scan_run_parts(inputs, parts, runs, 0)
    whole := false
    fences := false
    candidates := [Int]{}
    loop part in parts {
        output := parser_run_part_take(part)
        if output.whole -> whole = true
        if output.fences -> fences = true
        compiler_transfer_rows<Int>(&candidates, &output.candidates)
    }
    returned := parser_run_shared_take(inputs)
    bounds :: if whole -> [Int]{0, count} else -> parser_chunk_bounds_of(candidates, count, workers)
    ParserRunBounds{tokens: ^returned, bounds: bounds, fences: fences}
}

// The token stream, back from the shared inputs after the join.
fn parser_run_shared_take(inputs: Shared<ParserRunShared>) -> [Token] {
    permit :: inputs.guard_edit()
    &permit.value.tokens.pop() ?? panic("the run scan token stream left the shared inputs")
}

// A part's output row, after its thread joined.
fn parser_run_part_take(part: Shared<ParserRunPart>) -> ParserChunkScan {
    permit :: part.guard_edit()
    &permit.value.outputs.pop() ?? panic("a run scan thread left no output")
}

// Scans `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts scanned.
fn parser_scan_run_parts(inputs: Shared<ParserRunShared>, parts: [Shared<ParserRunPart>], runs: [Int], from: Int) -> Int {
    if from >= parts.len() - 1 -> return parser_scan_run_part(inputs, parts[from], runs)
    scanned := 0
    task.group parser_run_scan_threads {
        head :: task parser_scan_run_part(inputs, parts[from], runs)
        scanned = parser_scan_run_parts(inputs, parts, runs, from + 1)
        scanned += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    scanned
}

// One thread: the cut scan of its runs, each run's head token first (a
// later run starts with the synthetic terminator and then the head; a run
// that does not keeps the stream whole, as the one-thread scan's state at
// it is then unknown).
fn parser_scan_run_part(inputs: Shared<ParserRunShared>, part: Shared<ParserRunPart>, runs: [Int]) -> Int {
    permit := part.guard_edit()
    reads :: inputs.guard_read()
    whole := false
    fences := false
    candidates := [Int]{}
    loop run in permit.value.start..<permit.value.end {
        from :: runs[run]
        to :: runs[run + 1]
        if run > 0 {
            head :: from + 1
            if head >= to || reads.value.tokens[0][from].kind != TOKEN_SEMI || reads.value.tokens[0][from].span.start < reads.value.tokens[0][from].span.end || !parser_chunk_head_kind(reads.value.tokens[0][head].kind) -> whole = true
            &candidates.push(head)
        }
        scan := parser_chunk_scan(reads.value.tokens[0], reads.value.source, reads.value.file_rules, from, to)
        if scan.whole -> whole = true
        if scan.fences -> fences = true
        compiler_transfer_rows<Int>(&candidates, &scan.candidates)
    }
    &permit.value.outputs.push(ParserChunkScan{whole: whole, fences: fences, candidates: ^candidates})
    1
}

// Parses the fence-expanded stream as the chunks `bounds` names, on one
// thread per chunk, and joins the chunk programs in chunk order.
fn parser_parse_chunked(input: ^ParserFenceExpansion, bounds: [Int], lexer_diagnostics: [Diagnostic], source_end: Int, line_starts: [Int], source: [U8], allow_environment_reads: Bool, tables: ^TokenTables) -> ParseResult {
    prepared := ^input
    tokens := ^prepared.tokens
    prepared.tokens = [Token]{}
    inputs :: shared ParserChunkShared{tokens: [[Token]]{^tokens}, tables: [TokenTables]{^tables}, source: source, line_starts: line_starts, source_end: source_end, allow_environment_reads: allow_environment_reads}
    parts := [Shared<ParserChunkPart>]{}
    loop chunk in 0..<(bounds.len() - 1) -> &parts.push(shared ParserChunkPart{start: bounds[chunk], end: bounds[chunk + 1], outputs: [ParserChunkOutput]{}})
    _ := parser_parse_chunk_parts(inputs, parts, 0)
    outputs := [ParserChunkOutput]{}
    failed := false
    loop part in parts {
        output := parser_chunk_part_take(part)
        loop diagnostic in output.diagnostics {
            if diagnostic.severity == DIAGNOSTIC_ERROR -> failed = true
        }
        &outputs.push(^output)
    }
    taken := parser_chunk_shared_take(inputs)
    if failed {
        // Recovery after an error skips to the next plausible item, which can
        // lie past the chunk's end: the one-thread parse owns every diagnostic.
        prepared.tokens = ^taken.tokens
        return parser_parse_prepared(^prepared, lexer_diagnostics, source_end, line_starts, source, allow_environment_reads, ^taken.tables)
    }
    program := ast_program()
    diagnostics := [Diagnostic]{}
    loop diagnostic in lexer_diagnostics -> &diagnostics.push(diagnostic)
    block_spans := [Span]{}
    else_arms := [ElseArmSpan]{}
    block_policy_declarations := [PolicyDeclaration]{}
    statement_rules := [AppliedRuleApplication]{}
    loop index in 0..<outputs.len() {
        compiler_transfer_rows<ImportDecl>(&program.imports, &outputs[index].program.imports)
        compiler_transfer_rows<Item>(&program.items, &outputs[index].program.items)
        compiler_transfer_rows<Stmt>(&program.script_body, &outputs[index].program.script_body)
        compiler_transfer_rows<PolicyDeclaration>(&program.policy_declarations, &outputs[index].program.policy_declarations)
        compiler_transfer_rows<UserPolicyDecl>(&program.user_policy_declarations, &outputs[index].program.user_policy_declarations)
        compiler_transfer_rows<AppliedRuleApplication>(&program.rule_facts, &outputs[index].program.rule_facts)
        compiler_transfer_rows<Diagnostic>(&diagnostics, &outputs[index].diagnostics)
        compiler_transfer_rows<Span>(&block_spans, &outputs[index].block_spans)
        compiler_transfer_rows<ElseArmSpan>(&else_arms, &outputs[index].else_arms)
        compiler_transfer_rows<PolicyDeclaration>(&block_policy_declarations, &outputs[index].block_policy_declarations)
        compiler_transfer_rows<AppliedRuleApplication>(&statement_rules, &outputs[index].statement_rules)
    }
    program.block_spans = ^block_spans
    program.else_arms = ^else_arms
    loop declaration in block_policy_declarations -> &program.policy_declarations.push(declaration)
    loop application in statement_rules {
        &program.applied_rules.push(application)
        &program.rule_facts.push(application)
    }
    program.fenced_statements = prepared.fenced_statements
    program.used_import_names = parser_used_import_names(taken.tokens, taken.tables, program.imports, program.items)
    program.debug_sites = parser_debug_trace_sites(taken.tokens, taken.tables, source)
    ParseResult{program: program, diagnostics: diagnostics}
}

// The token stream and tables, back from the shared inputs after the join.
fn parser_chunk_shared_take(inputs: Shared<ParserChunkShared>) -> Lexed {
    permit :: inputs.guard_edit()
    tokens := &permit.value.tokens.pop() ?? panic("the chunk parse token stream left the shared inputs")
    tables := &permit.value.tables.pop() ?? panic("the chunk parse tables left the shared inputs")
    Lexed{tokens: ^tokens, tables: ^tables, diagnostics: [Diagnostic]{}}
}

// A part's output row, after its thread joined.
fn parser_chunk_part_take(part: Shared<ParserChunkPart>) -> ParserChunkOutput {
    permit :: part.guard_edit()
    &permit.value.outputs.pop() ?? panic("a chunk parse thread left no output")
}

// Parses `parts[from..]`, one task per part and the last part on this
// thread; returns how many parts parsed.
fn parser_parse_chunk_parts(inputs: Shared<ParserChunkShared>, parts: [Shared<ParserChunkPart>], from: Int) -> Int {
    if from >= parts.len() - 1 -> return parser_parse_chunk_part(inputs, parts[from])
    parsed := 0
    task.group parser_chunk_threads {
        head :: task parser_parse_chunk_part(inputs, parts[from])
        parsed = parser_parse_chunk_parts(inputs, parts, from + 1)
        parsed += head.join() ?? panic(compiler_threads_failure_text(err))
    }
    parsed
}

// One thread: copies its token range, the tables, the source and the line
// starts out of the shared inputs on this thread, parses the range as a
// program with fresh parser state, and leaves its output in its part. The
// end of the range reads as the end of the file (`source_end`), which a
// clean item run never reaches inside an item.
fn parser_parse_chunk_part(inputs: Shared<ParserChunkShared>, part: Shared<ParserChunkPart>) -> Int {
    permit := part.guard_edit()
    reads :: inputs.guard_read()
    tokens := reads.value.tokens[0].slice(permit.value.start, permit.value.end)
    source_end :: reads.value.source_end
    state := JetParserState{tokens: ^tokens, tables: [TokenTables]{reads.value.tables[0]}, position: 0, diagnostics: [Diagnostic]{}, source_end: source_end, block_spans: [Span]{}, pending_type_gt: false, pending_type_gt_span: Span{start: source_end, end: source_end}, result_handler_depth: 0, statement_start: -1, line_starts: reads.value.line_starts, sources: [[U8]]{reads.value.source}, allow_environment_reads: reads.value.allow_environment_reads}
    program := parser_parse_program(&state)
    &permit.value.outputs.push(ParserChunkOutput{program: ^program, diagnostics: ^state.diagnostics, block_spans: ^state.block_spans, else_arms: ^state.else_arms, block_policy_declarations: ^state.block_policy_declarations, statement_rules: ^state.statement_rules})
    1
}

// L0103 an import's local name is read when the file spells
// it outside every import declaration, interpolations included. The module
// root of a member import (`b` in `use b.[f]`) reads that name as well. A
// body-less `module name` is the file import the loader binds for it.
// Rust: none (Jet-only pass)
fn parser_used_import_names(tokens: [Token], tables: TokenTables, imports: [ImportDecl], program_items: [Item]) -> [String] Never! {
    candidates := [String]{}
    used := [String]{}
    used_names := [String:Bool]{}
    import_spans := [Span]{}
    loop declaration in imports {
        &import_spans.push(declaration.span)
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if used_names.get(module_alias) == None {
                    &used_names.add(module_alias, true).drop("checked absent above")
                    &used.push(module_alias)
                }
                loop item in items {
                    parts :: item.original.split(".").to_list()
                    &candidates.push(item.alias ?? parts[parts.len() - 1])
                }
            }
            else -> &candidates.push(declaration.alias)
        }
    }
    loop item in program_items {
        if item == .CodeModule(definition) {
            if definition.body != None -> next
            &import_spans.push(definition.span)
            &candidates.push(definition.name)
        }
    }
    if candidates.len() == 0 -> return used
    indexed_spans :: parser_import_span_index(import_spans)
    // Per name id: whether the name is a candidate, and whether it is used.
    candidate_ids := [Bool]{}
    used_ids := [Bool]{}
    loop _ in 0..<name_count(tables.names) {
        &candidate_ids.push(false)
        &used_ids.push(false)
    }
    loop candidate in candidates {
        if name_find(tables.names, candidate) == .Val(name) -> candidate_ids[name_index(name)] = true
    }
    loop name in used {
        if name_find(tables.names, name) == .Val(found) -> used_ids[name_index(found)] = true
    }
    parser_collect_used_import_names(tokens, tables, indexed_spans, candidate_ids, &used_ids, &used)
    used
}

// Rust: none (Jet-only pass)
fn parser_import_span_index(spans: [Span]) -> [Span] Never! {
    order := [Int]{}
    loop index in 0..<spans.len() -> &order.push(index)
    width := 1
    loop width < order.len() {
        merged := [Int]{}
        start := 0
        loop start < order.len() {
            middle :: if start + width < order.len() -> start + width else -> order.len()
            end :: if start + 2 * width < order.len() -> start + 2 * width else -> order.len()
            left := start
            right := middle
            loop left < middle || right < end {
                if right >= end || (left < middle && spans[order[left]].start <= spans[order[right]].start) {
                    &merged.push(order[left])
                    left += 1
                } else {
                    &merged.push(order[right])
                    right += 1
                }
            }
            start = end
        }
        order = merged
        width *= 2
    }
    indexed := [Span]{}
    loop position in order {
        span :: spans[position]
        // Prefix maximum ends preserve containment even for overlapping spans.
        end :: if indexed.len() > 0 && indexed[indexed.len() - 1].end > span.end -> indexed[indexed.len() - 1].end else -> span.end
        &indexed.push(Span{start: span.start, end: end})
    }
    indexed
}

// Rust: none (Jet-only pass)
fn parser_inside_import_span(indexed_spans: [Span], span: Span) -> Bool Never! {
    low := 0
    high := indexed_spans.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if indexed_spans[middle].start <= span.start -> low = middle + 1 else -> high = middle
    }
    low > 0 && span.end <= indexed_spans[low - 1].end
}

// Rust: none (Jet-only pass)
fn parser_collect_used_import_names(tokens: [Token], tables: TokenTables, indexed_spans: [Span], candidate_ids: [Bool], used_ids: &[Bool], used: &[String]) Never! {
    loop token in tokens {
        id :: name_index(token.decoded)
        if token.kind == TOKEN_IDENT && id < candidate_ids.len() && candidate_ids[id] && !used_ids[id] {
            if !parser_inside_import_span(indexed_spans, token.span) {
                used_ids[id] = true
                &used.push(token_decoded(tables, token))
            }
        }
        if token.literal < 0 -> next
        loop part in tables.literals[token.literal].string_parts {
            if part.kind == STRING_PART_INTERPOLATION -> parser_collect_used_import_names(part.tokens, tables, indexed_spans, candidate_ids, &used_ids, &used)
        }
    }
}

// Record each `debug(…)` call's argument text as written, so sema
// can name the traced expression and build the E3405 unwrap edit. The text
// runs from the first token after `(` to the last one before its matching
// `)`, leaving out a trailing comma. Interpolations are scanned as well.
fn parser_debug_trace_sites(tokens: [Token], tables: TokenTables, source: [U8]) -> [DebugTraceSite] Never! {
    sites := [DebugTraceSite]{}
    if source.len() == 0 -> return sites
    debug :: name_find(tables.names, "debug") ?? return sites
    parser_collect_debug_trace_sites(tokens, tables, debug, source, &sites)
    sites
}

// Rust: none (Jet-only pass)
fn parser_collect_debug_trace_sites(tokens: [Token], tables: TokenTables, debug: Name, source: [U8], sites: &[DebugTraceSite]) Never! {
    closes := [Int]{}
    opens := [Int]{}
    loop index in 0..<tokens.len() {
        &closes.push(-1)
        if tokens[index].kind == TOKEN_LPAREN -> &opens.push(index)
        if tokens[index].kind == TOKEN_RPAREN && opens.len() > 0 {
            open :: &opens.pop() ?? -1
            closes[open] = index
        }
    }
    loop index in 0..<tokens.len() {
        token :: tokens[index]
        if token.literal >= 0 {
            loop part in tables.literals[token.literal].string_parts {
                if part.kind == STRING_PART_INTERPOLATION -> parser_collect_debug_trace_sites(part.tokens, tables, debug, source, &sites)
            }
        }
        if token.kind != TOKEN_IDENT || token.decoded != debug || index + 1 >= tokens.len() || tokens[index + 1].kind != TOKEN_LPAREN -> next
        open :: index + 1
        close :: closes[open]
        if close < 0 -> next
        last := close - 1
        if last > open && tokens[last].kind == TOKEN_COMMA -> last -= 1
        if last <= open -> next
        start :: tokens[open + 1].span.start
        end :: tokens[last].span.end
        close_end :: tokens[close].span.end
        if start < 0 || end <= start || close_end > source.len() -> next
        text :: String.from_bytes(source.slice(start, end)) ?? next
        &sites.push(DebugTraceSite{name_start: token.span.start, text: text, close_end: close_end})
    }
}

fn parser_parse_program(state: &JetParserState) -> Program {
    program := ast_program()
    loop parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_EOF -> break
        before := state.position
        if {
            // A top-level `@` is a misspelled applied rule.
            parser_current_kind(&state) == TOKEN_AT -> {
                at :: parser_bump(&state)
                parser_add_error_code(&state, "E0063", at.span, "applied rules use `#`, not `@`", "`#` marks attributes, instructions, and properties; prefix `@` marks compile-time names and fact reads, while infix `@` stays a package-source separator", "replace the leading `@` with `#`")
                parser_sync_top(&state)
            }
            parser_user_policy_ahead(&state) -> {
                declaration :: parser_parse_user_policy(&state)
                if declaration.valid -> &program.user_policy_declarations.push(declaration.value)
            }
            parser_section_label_ahead(&state) -> parser_report_section_label(&state)
            parser_foreign_top_word_ahead(&state) -> parser_report_foreign_top_word(&state)
            parser_file_directive_ahead(&state) -> parser_parse_file_directive(&state, &program)
            parser_policy_file_decl_ahead(&state) -> parser_parse_policy_file_decl(&state, &program)
            parser_unattached_marker_at_end(&state) -> {
                marker :: parser_parse_marker(&state)
                &program.rule_facts.push(AppliedRuleApplication{marker: marker, target: None, site: Val(RuleSite.File)})
            }
            parser_item_ahead(&state) -> {
                declaration :: parser_parse_item_or_import(&state)
                if declaration.import == {
                    .Val(value) -> &program.imports.push(value)
                    .None -> {
                        if declaration.item == {
                            .Val(value) -> &program.items.push(value)
                            .None -> {
                                if !declaration.handled {
                                    parser_add_error_here(&state, "expected a declaration", "a declaration modifier must be followed by an item", "add an item declaration or remove the modifier")
                                    parser_recover_statement(&state)
                                }
                            }
                        }
                    }
                }
            }
            // (Rust `module_binding_def`): the binding parser
            // reads one named module binding; a destructuring head or a failed
            // binding reports and resynchronizes at the next item.
            parser_module_binding_ahead(&state) -> {
                start :: parser_current(&state).span
                destructuring :: parser_kind_at(&state, 1) == TOKEN_LBRACE
                errors_before :: state.diagnostics.len()
                statement :: if destructuring -> parser_parse_statement(&state) else -> parser_parse_binding_statement(&state)
                item :: parser_module_binding_item(statement, start, parser_previous_end(state))
                if destructuring {
                    parser_add_error_code(&state, "E0003", start, "module globals bind one name at a time", "a module binding is a named value available to every function in the file", "write `name :: value` or `name := value`")
                    parser_sync_top(&state)
                } else if parser_error_since(state, errors_before) {
                    parser_sync_top(&state)
                } else if item == .Val(value) {
                    &program.items.push(value)
                } else {
                    parser_sync_top(&state)
                }
                if state.position == before -> parser_bump(&state)
            }
            else -> {
                // Rust resynchronizes a failed script line like a block line
                // and steps over a token the line could not consume.
                &program.script_body.push(parser_parse_statement(&state))
                parser_recover_aborted_statement(&state, before)
                if state.position == before -> parser_bump(&state)
            }
        }
        parser_recover_aborted_item(&state, before)
        // An abort that no item or line took ends with its item.
        state.abort_mark = 0
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error_code(&state, "E0003", token.span, "the parser could not advance through this source item", "top-level recovery prevents repeated diagnostics at one token", "remove or complete this item")
            parser_bump(&state)
        }
    }
    program
}

// Foreign top-level words that teach the Jet spelling: `namespace` (E0323)
// and `unsafe` (E0031). `unsafe extern rust` keeps its block.
fn parser_foreign_top_word_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind != TOKEN_IDENT -> return false
    word :: parser_value(state, token)
    word == "namespace" || word == "unsafe"
}

fn parser_report_foreign_top_word(state: &JetParserState) {
    word :: parser_bump(&state)
    if parser_value(state, word) == "namespace" {
        parser_add_error_code(&state, "E0323", word.span, "in-file grouping uses `module name {{ }}`, not `namespace`", "Jet has one spelling for in-file grouping: a named `module` block", "write `module mygroup {{ fn foo() {{ … }} }}` instead")
        parser_sync_top(&state)
        return
    }
    parser_add_error_code(&state, "E0031", word.span, "Jet doesn't use `unsafe` to call Rust crates", "foreign Rust functions live in whole `extern rust` blocks — callers never write `unsafe`", "write: extern rust \"crate@version\" {{ fn name(...) T = \"rust::path\"; }}")
    if parser_current_kind(&state) != TOKEN_KW_EXTERN -> parser_sync_top(&state)
}

// Imported group heads cannot reveal their file members until the loader has
// the defining module. Retain an unattached head for that ordinary replay.
fn parser_unattached_marker_at_end(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    offset := 1
    if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
    if parser_kind_at(&state, offset) != TOKEN_IDENT -> return false
    offset += 1
    loop parser_kind_at(&state, offset) == TOKEN_DOT && parser_kind_at(&state, offset + 1) == TOKEN_IDENT -> offset += 2
    if parser_kind_at(&state, offset) == TOKEN_LPAREN {
        depth := 1
        offset += 1
        loop depth > 0 {
            kind :: parser_kind_at(&state, offset)
            if kind == TOKEN_EOF -> return false
            if kind == TOKEN_LPAREN -> depth += 1
            if kind == TOKEN_RPAREN -> depth -= 1
            offset += 1
        }
    }
    loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
    parser_kind_at(&state, offset) == TOKEN_EOF
}

// File rules bare
// `#PubFile`/`#NoPrelude`/`#HTML(…)`, a file-level `#Target(…)`, or a `#[…]`
// list of them. The retired `#PublicFile`/`#Html` spellings are read to teach.
fn parser_file_directive_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    if parser_kind_at(&state, 1) == TOKEN_LBRACKET -> return parser_file_marker_group_ahead(&state)
    name :: parser_lookahead(&state, 1)
    if name.kind != TOKEN_IDENT -> return false
    rule :: parser_value(state, name)
    if rule == "PubFile" || rule == "PublicFile" || rule == "NoPrelude" || rule == "HTML" || rule == "Html" -> return true
    rule == "Target" && (parser_target_selects_file_web_at(&state, 1) || !parser_hash_leads_to_item(&state))
}

fn parser_is_file_rule(name: String) -> Bool Never! {
    name == "PubFile" || name == "NoPrelude" || name == "Target" || name == "HTML" || name == "Html"
}

// Rust `marker_list_is_file_rules`: a `#[…]` list whose every entry is a file
// rule configures the file, unless it heads a type, or every entry is a
// partition `#Target` that the function below can take (`#[Target(JS)] fn`).
fn parser_file_marker_group_ahead(state: &JetParserState) -> Bool Never! {
    offset := 2
    every_entry_fits_function := true
    loop {
        if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
        name :: parser_lookahead(&state, offset)
        if name.kind != TOKEN_IDENT || !parser_is_file_rule(parser_value(state, name)) -> return false
        if parser_value(state, name) != "Target" || parser_target_selects_file_web_at(&state, offset) -> every_entry_fits_function = false
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LPAREN {
            depth := 0
            loop {
                kind :: parser_kind_at(&state, offset)
                if kind == TOKEN_EOF -> return false
                offset += 1
                if kind == TOKEN_LPAREN -> depth += 1
                if kind == TOKEN_RPAREN {
                    depth -= 1
                    if depth == 0 -> break
                }
            }
        }
        if parser_kind_at(&state, offset) == TOKEN_COMMA {
            offset += 1
            next
        }
        if parser_kind_at(&state, offset) != TOKEN_RBRACKET -> return false
        offset += 1
        break
    }
    loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
    after :: parser_kind_at(&state, offset)
    if !every_entry_fits_function -> return true
    if after == TOKEN_KW_STRUCT || after == TOKEN_KW_ENUM -> return false
    function_follows :: after == TOKEN_KW_FN || (after == TOKEN_KW_PUB && parser_kind_at(&state, offset + 1) == TOKEN_KW_FN) || parser_prep_verb_ahead(&state, offset, TOKEN_KW_FN) || after == TOKEN_HASH
    !(every_entry_fits_function && function_follows)
}

// Rust `target_marker_selects_file_web_at`: `#Target(Web)` (or a path ending
// in `Target.Web`) is the file default, never a marker on the next item.
// `name_offset` is the offset of the `Target` name.
fn parser_target_selects_file_web_at(state: &JetParserState, name_offset: Int) -> Bool Never! {
    if parser_kind_at(&state, name_offset + 1) != TOKEN_LPAREN -> return false
    previous := ""
    last := ""
    count := 0
    offset := name_offset + 2
    loop {
        token :: parser_lookahead(&state, offset)
        if token.kind == TOKEN_RPAREN -> break
        if token.kind != TOKEN_IDENT && token.kind != TOKEN_DOT -> return false
        if token.kind == TOKEN_IDENT {
            previous = last
            last = parser_value(state, token)
            count += 1
        }
        offset += 1
    }
    last == "Web" && (count == 1 || previous == "Target")
}

// One run of file rules, bare or in `#[…]` lists. Two distinct rules belong
// in one list (E0999); each rule then sets its program field.
fn parser_parse_file_directive(state: &JetParserState, program: &Program) {
    markers := [Marker]{}
    chunks := 0
    bracket_chunks := 0
    sequence := parser_current(&state).span
    loop parser_file_directive_ahead(&state) && !parser_aborting(&state) {
        if parser_kind_at(&state, 1) == TOKEN_LBRACKET {
            group :: parser_parse_marker_group_list(&state)
            loop marker in group.markers -> &markers.push(marker)
            sequence.end = group.span.end
            bracket_chunks += 1
        } else {
            marker :: parser_parse_marker(&state)
            &markers.push(marker)
            sequence.end = marker.span.end
            parser_skip_semicolons(&state)
        }
        chunks += 1
    }
    parser_report_adjacent_markers(&state, markers, chunks, bracket_chunks, sequence, "file")
    single :: chunks == 1 && bracket_chunks == 0
    loop marker in markers -> parser_apply_file_marker(&state, &program, marker, single)
}

fn parser_apply_file_marker(state: &JetParserState, program: &Program, marker: Marker, single: Bool) {
    &program.rule_facts.push(AppliedRuleApplication{marker: marker, target: None, site: Val(RuleSite.File)})
    hash :: Span{start: marker.span.start, end: marker.span.start + 1}
    repeat_span :: if single -> hash else -> marker.span
    if marker.name == {
        // The retired file marker; E0418 deletes it.
        "PubFile" | "PublicFile" -> {
            deletion :: parser_deletion_edit(state, marker.span)
            parser_add_error_code_edit(&state, "E0418", marker.span, "`#PubFile` was removed: every file is public by default", "declarations are public by default, so the file marker has nothing left to flip", "delete the marker", deletion)
        }
        "NoPrelude" -> {
            if program.no_prelude {
                parser_report_repeated_file_marker(&state, "NoPrelude", repeat_span)
                return
            }
            program.no_prelude = true
        }
        "Target" -> parser_apply_file_target(&state, &program, marker, single)
        "HTML" -> {
            if program.html_path != None {
                parser_add_error(&state, marker.span, "only one `#HTML(…)` marker is allowed per file", "a file may declare at most one companion host page", "remove the duplicate `#HTML(…)` marker")
                return
            }
            values :: parser_bind_marker_arguments(&state, marker, [String]{"page"}, 1) ?? return
            page :: values[0] ?? return
            program.html_path = parser_html_page_path(page)
        }
        else -> {}
    }
}

fn parser_report_repeated_file_marker(state: &JetParserState, name: String, span: Span) {
    parser_add_error_code(&state, "E0999", span, "`#{name}` is already applied to this file", "`#{name}` is not a repeatable rule, so the second copy adds nothing and can only disagree with the first", "remove the repeated marker")
}

// Rust `html_from_marker`: the companion page is `Path{"page.html"}` or a
// plain literal string; any other value names no page.
fn parser_html_page_path(page: Expr) -> String? {
    if page == .TypedLit(head, body, _) && head == .Val(ty) && ty == .Named(type_name) && type_name == "Path" && body == .Value(inner) -> return parser_expr_literal_string(inner)
    parser_expr_literal_string(page)
}

// (Rust `web_target_from_marker`):
// `#Target(Web)` picks the file's default CLI backend, `#Target(Wasm|JS)`
// caps its web partition, and `#Target(OS.…)` only gates an `impl`.
fn parser_apply_file_target(state: &JetParserState, program: &Program, marker: Marker, single: Bool) {
    values :: parser_bind_marker_arguments(&state, marker, [String]{"target"}, 1) ?? return
    target :: values[0] ?? return
    written :: parser_marker_ident_path(target) ?? {
        parser_marker_shape_error(&state, marker)
        return
    }
    // Rust `strip_marker_enum_prefix`: the path after the first `Target`
    // segment, when one follows it.
    segments :: written.split(".").to_list()
    kept := [String]{}
    stripped := false
    loop (index, segment) in segments {
        if !stripped && segment == "Target" && index + 1 < segments.len() {
            stripped = true
            kept = [String]{}
            next
        }
        &kept.push(segment)
    }
    name :: kept.join(".")
    here :: parser_current(&state).span
    if kept.len() == 2 && kept[0] == "OS" {
        os :: kept[1]
        if os != "Linux" && os != "MacOS" && os != "Windows" {
            parser_add_error(&state, expr_span(target), "`#Target(OS.{os})` is not a known native OS", "native OS targets are `OS.Linux`, `OS.MacOS`, or `OS.Windows`", "write `#Target(OS.Linux)`, `#Target(OS.MacOS)`, or `#Target(OS.Windows)`")
            return
        }
        if single {
            parser_add_error(&state, here, "`#Target(OS.{os})` isn't valid here", "`OS.Linux`/`OS.MacOS`/`OS.Windows` gates a whole `impl` block, not a module, function, or any other item", "write `#Target(OS.{os}) impl Type.Trait {{ … }}`")
        } else {
            parser_report_grouped_target_conflict(&state, marker)
        }
        return
    }
    if name == "Web" {
        if single && parser_current_kind(&state) == TOKEN_KW_MODULE {
            parser_add_error(&state, here, "`#Target(Web)` isn't valid on a module", "`Web` is a file-level default-backend marker, not a partition ceiling", "move `#Target(Web)` to the top of the file, outside any module; use `#Target(Wasm)` or `#Target(JS)` on a module")
            return
        }
        if program.default_target != None {
            if single {
                parser_add_error(&state, here, "only one `#Target(Web)` marker is allowed per file", "a file may declare at most one default backend", "remove the duplicate `#Target(Web)` marker")
            } else {
                parser_report_grouped_target_conflict(&state, marker)
            }
            return
        }
        program.default_target = Val("web")
        return
    }
    bucket :: if name == {
        "Wasm" -> Val(WebBucket.Wasm)
        "JS" -> Val(WebBucket.JS)
        else -> WebBucket?{None}
    }
    if bucket == None {
        parser_add_error(&state, expr_span(target), "`#Target({name})` is not a known web partition", "web targets are `Wasm` (compute), `JS` (DOM/view), `Web` (default CLI backend), or `OS.Linux`/`OS.MacOS`/`OS.Windows` (native platform gating)", "write `#Target(Wasm)`, `#Target(JS)`, `#Target(Web)`, or `#Target(OS.{{Linux|MacOS|Windows}})`")
        return
    }
    if program.web_target_ceiling != None {
        if single {
            parser_add_error(&state, here, "only one `#Target(…)` ceiling is allowed per file", "a file may declare at most one web partition ceiling", "remove the duplicate `#Target(Wasm)` or `#Target(JS)` marker")
        } else {
            parser_report_grouped_target_conflict(&state, marker)
        }
        return
    }
    program.web_target_ceiling = bucket
}

fn parser_report_grouped_target_conflict(state: &JetParserState, marker: Marker) {
    parser_add_error(&state, marker.span, "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`")
}

// `pub:` / `priv:` section labels would let one line flip
// the visibility of everything below it; E0415 rejects the label itself.
fn parser_section_label_ahead(state: &JetParserState) -> Bool Never! {
    if parser_kind_at(&state, 1) != TOKEN_COLON -> return false
    token :: parser_current(&state)
    token.kind == TOKEN_KW_PUB || token.kind == TOKEN_KW_PRIV || (token.kind == TOKEN_IDENT && parser_value(state, token) == "private")
}

fn parser_report_section_label(state: &JetParserState) {
    first :: parser_bump(&state)
    colon :: parser_bump(&state)
    label :: parser_cover(first.span, colon.span)
    deletion :: parser_deletion_edit(state, label)
    parser_add_error_code_edit(&state, "E0415", label, "section visibility labels like `pub:` / `priv:` are not supported", "moving an item above or below a label would silently change its visibility", "delete the label; group internal declarations in a `priv module`", deletion)
}

fn parser_item_ahead(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    token :: parser_current(&state)
    if {
        parser_item_declaration_ahead_at(&state, 0) -> true
        parser_template_loop_ahead(&state) -> true
        parser_is_item_keyword(kind) -> true
        kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV -> true
        token.kind == TOKEN_IDENT && parser_value(state, token) == "alias" -> true
        token.kind == TOKEN_IDENT && parser_value(state, token) == "private" -> parser_foreign_private_ahead(&state)
        kind == TOKEN_HASH -> parser_hash_leads_to_item(&state)
        else -> false
    }
}

fn parser_is_item_keyword(kind: Int) -> Bool Never! {
    kind == TOKEN_KW_FN || kind == TOKEN_KW_STRUCT || kind == TOKEN_KW_ENUM || kind == TOKEN_KW_USE || kind == TOKEN_KW_TRAIT || kind == TOKEN_KW_IMPL || kind == TOKEN_KW_MODULE || kind == TOKEN_KW_EFFECT || kind == TOKEN_KW_TAG || kind == TOKEN_KW_EXTERN || kind == TOKEN_KW_DERIVE
}

// + owner ruling (2026-09-30): an immutable module binding
// is named in ALL_CAPS, `MAX_ROWS :: 100`. This is the casing predicate only;
// compile time is always the explicit `NAME :: prep { value }`.
fn parser_constant_name(name: String) -> Bool Never! {
    if name == "" || name.starts_with("@") || name.starts_with("$") -> return false
    has_upper := false
    loop byte in name.bytes() {
        if byte >= (U8{97}) && byte <= (U8{122}) -> return false
        if byte >= (U8{65}) && byte <= (U8{90}) -> has_upper = true
    }
    has_upper
}

// The subjectless compiler fact roots.
fn parser_fact_root(name: String) -> Bool Never! {
    name == "$build" || name == "$package" || name == "$phase" || name == "$program"
}

// Rust `Parser::unknown_fact_root` a `$`
// word in ordinary expression position that is no fact root. An ALL_CAPS
// `$NAME` is the config-only environment read any other
// `$word` is not a compiler fact. Both report the whole word. Fatal, as Rust
// returns it as the expression's `Err`.
fn parser_report_unknown_fact_root(state: &JetParserState, name: String, span: Span) {
    body :: if name.starts_with("$") -> name.slice(1..<name.len()) else -> name
    if body != "" && parser_constant_name(body) {
        parser_add_error(&state, span, "`$NAME` is an environment read for config surfaces only", "Jet reserves `$NAME` for typed environment access in `env.jet` and deploy/config files; ordinary program code does not read the environment with `$`", "move the read to `env.jet` or a deploy/config file, or use an explicit program API for runtime environment access")
        return
    }
    parser_add_error(&state, span, "`{name}` is not a compiler fact", "`$` marks facts the compiler supplies: the roots `$build`, `$package`, `$phase` and `$program`, and `$` members of a type, function or value such as `T.$layout`", "read a fact root such as `$build.os`, or read the fact on its subject, such as `T.$fields`")
}

// After `#Static` / `#Inline`, a constant binding `NAME :: …` is a declaration.
fn parser_marked_const_ahead(state: &JetParserState, offset: Int) -> Bool Never! {
    token :: parser_lookahead(&state, offset)
    if token.kind != TOKEN_IDENT || parser_kind_at(&state, offset + 1) != TOKEN_COLON_COLON -> return false
    parser_constant_name(parser_value(state, token))
}

// Rust `marker_sequence_leads_to_function`: newline terminators between the
// markers and before the item are skipped, so `#[A, B]` on its own line still
// attaches to the item below.
fn parser_hash_leads_to_item(state: &JetParserState) -> Bool Never! {
    offset := 0
    loop {
        loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
        if parser_item_declaration_ahead_at(&state, offset) -> return true
        if parser_kind_at(&state, offset) != TOKEN_HASH -> break
        offset += 1
        if parser_kind_at(&state, offset) == TOKEN_LBRACKET {
            offset += 1
            nesting := 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LBRACKET -> nesting += 1
                    TOKEN_RBRACKET -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
            next
        }
        if parser_kind_at(&state, offset) == TOKEN_BANG -> offset += 1
        if parser_kind_at(&state, offset) != TOKEN_IDENT -> return false
        offset += 1
        loop parser_kind_at(&state, offset) == TOKEN_DOT && parser_kind_at(&state, offset + 1) == TOKEN_IDENT -> offset += 2
        if parser_kind_at(&state, offset) == TOKEN_LPAREN {
            nesting := 1
            offset += 1
            loop nesting > 0 && parser_kind_at(&state, offset) != TOKEN_EOF {
                kind :: parser_kind_at(&state, offset)
                if kind == {
                    TOKEN_LPAREN -> nesting += 1
                    TOKEN_RPAREN -> nesting -= 1
                    else -> {}
                }
                offset += 1
            }
        }
    }
    loop parser_kind_at(&state, offset) == TOKEN_SEMI -> offset += 1
    kind :: parser_kind_at(&state, offset)
    parser_item_declaration_ahead_at(&state, offset) || parser_marked_const_ahead(&state, offset) || parser_is_item_keyword(kind) || (kind == TOKEN_KW_PUB || kind == TOKEN_KW_PRIV) || (kind == TOKEN_IDENT && parser_value_at(&state, offset) == "alias")
}
