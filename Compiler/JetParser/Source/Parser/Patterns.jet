// Pattern grammar maps directly to the shared Jet AST.
use jet_foundation.[
    BinEndian,
    BinMatchPart,
    BinSpec,
    Diagnostic,
    Expr,
    BindName,
    ListPatRest,
    MapPatEntry,
    PatternTypeHead,
    PatSlot,
    Pattern,
    Span,
    StrMatchPart,
    StructPatField,
    Type,
]
use jet_lexer.[
    STRING_PART_BYTE,
    STRING_PART_INTERPOLATION,
    STRING_PART_TEXT,
    StringPart,
    TOKEN_AND_AND,
    TOKEN_COLON,
    TOKEN_COLON_COLON,
    TOKEN_COMMA,
    TOKEN_DOT,
    TOKEN_DOT_DOT,
    TOKEN_DOT_DOT_DOT,
    TOKEN_EOF,
    TOKEN_HASH,
    TOKEN_IDENT,
    TOKEN_INT,
    TOKEN_LAMBDA_ARROW,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_LPAREN,
    TOKEN_NULL,
    TOKEN_PIPE,
    TOKEN_QUESTION,
    TOKEN_RAW_STRING,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_RPAREN,
    TOKEN_SELF,
    TOKEN_SEMI,
    TOKEN_STRING,
    TOKEN_UNIFIED_ARROW,
    Token,
]

struct ParsedPattern {
    pattern: Pattern
    span: Span
}
struct ParsedTakePatternBody {
    binary: Bool
    parts: [StringPart]
    span: Span
}

fn parser_take_pattern_head_kind(ty: Type) -> Int Never! {
    if ty == {
        .String -> {
            return 1
        }
        .List(element) -> {
            if parser_is_byte_type(element) -> return 2
        }
        .FixedList(element, _) -> {
            if parser_is_byte_type(element) -> return 2
        }
        else -> {}
    }
    0
}

fn parser_is_byte_type(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, bits) -> !signed && bits == 8
        else -> false
    }
}

fn parser_try_take_pattern_body(state: &JetParserState, depth: Int) -> ParsedTakePatternBody? {
    first :: parser_current(&state)
    if first.kind != TOKEN_LBRACKET && !(first.kind == TOKEN_IDENT && parser_value(state, first) == "String") -> return None
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_pending_gt := state.pending_type_gt
    saved_pending_gt_span := state.pending_type_gt_span
    head :: parser_parse_type(&state, depth + 1)
    kind := parser_take_pattern_head_kind(head.ty)
    if kind == 0 || state.diagnostics.len() != saved_diagnostics {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    dotted := parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE
    if !dotted && parser_current_kind(&state) != TOKEN_LBRACE {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    if dotted {
        dot :: parser_bump(&state)
        label := if kind == 2 -> "[U8]" else -> "String"
        parser_add_error_code(&state, "E0320", dot.span, "typed pattern construction uses `{label}{{…}}`, not `{label}.{{…}}`", "the constructor dot is omitted from typed literal heads", "write `{label}{{…}}`")
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a take_pattern literal")
    literal :: parser_current(&state)
    if literal.kind != TOKEN_STRING && literal.kind != TOKEN_RAW_STRING {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    text :: parser_bump(&state)
    if parser_current_kind(&state) != TOKEN_RBRACE {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    close :: parser_bump(&state)
    Val(ParsedTakePatternBody{binary: kind == 2, parts: parser_string_parts(state, text), span: parser_cover(head.span, close.span)})
}

fn parser_pattern_byte_text(value: Int) -> String Never! {
    if value < 128 -> return String.from_bytes([U8]{U8{value}}) ?? ""
    high := (192).bit_or((value >> 6))
    low := (128).bit_or(((value).bit_and(63)))
    String.from_bytes([U8]{U8{high}, U8{low}}) ?? ""
}

// Rust `parse_str_match_hole`: a name, then an optional `:Type`. Tokens
// after that are not an error here (the `==` gate and the typed
// `take_pattern` gate reject them first); they only widen the hole span.
// A hole that does not parse is fatal, as Rust returns it as `Err`.
fn parser_take_pattern_text_hole(state: &JetParserState, part: StringPart) -> StrMatchPart {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        result_handler_depth: state.result_handler_depth,
        statement_start: -1,
        allow_environment_reads: state.allow_environment_reads,
    }
    parser_lend_tables(&state, &nested)
    name_token :: parser_expect_name(&nested, "in a pattern hole")
    ty := Type?{None}
    if nested.diagnostics.len() == 0 && parser_current_kind(&nested) == TOKEN_COLON {
        parser_bump(&nested)
        parsed_type :: parser_parse_type(&nested, 1)
        ty = Val(parsed_type.ty)
    }
    parser_return_tables(&state, &nested)
    name :: parser_value(state, name_token)
    if nested.diagnostics.len() > 0 {
        if parser_aborting(&state) -> return StrMatchPart.Hole{name: name, ty: None, span: name_token.span}
        loop diagnostic in nested.diagnostics -> &state.diagnostics.push(diagnostic)
        state.abort_mark = state.diagnostics.len()
        return StrMatchPart.Hole{name: name, ty: None, span: name_token.span}
    }
    span := name_token.span
    if parser_current_kind(&nested) != TOKEN_EOF -> span = Span{start: name_token.span.start, end: parser_current(&nested).span.end}
    StrMatchPart.Hole{name: name, ty: ty, span: span}
}

fn parser_take_pattern_text_parts(state: &JetParserState, parts: [StringPart]) -> [StrMatchPart] {
    match_parts := [StrMatchPart]{}
    loop part in parts {
        if part.kind == {
            STRING_PART_TEXT -> &match_parts.push(StrMatchPart.Lit{text: parser_part_text(state, part)})
            STRING_PART_BYTE -> &match_parts.push(StrMatchPart.Lit{text: parser_pattern_byte_text(part.byte)})
            STRING_PART_INTERPOLATION -> &match_parts.push(parser_take_pattern_text_hole(&state, part))
            else -> {}
        }
    }
    adjacent_index := 0
    loop adjacent_index + 1 < match_parts.len() {
        first_hole := Span?{None}
        second_hole := Span?{None}
        if match_parts[adjacent_index] == {
            .Hole(_, _, span) -> first_hole = Val(span)
            else -> {}
        }
        next_index := adjacent_index + 1
        if match_parts[next_index] == {
            .Lit(text) -> {
                if text == "" {
                    next_index += 1
                }
            }
            else -> {}
        }
        if next_index < match_parts.len() {
            if match_parts[next_index] == {
                .Hole(_, _, span) -> second_hole = Val(span)
                else -> {}
            }
        }
        if first_hole != None && second_hole != None {
            first_span :: first_hole ?? Span{start: 0, end: 0}
            second_span :: second_hole ?? Span{start: 0, end: 0}
            parser_add_error_code(&state, "E0147", parser_cover(first_span, second_span), "these two text holes have nothing between them to split on", "a text pattern needs fixed literal text between adjacent holes", "put literal text between the holes or give them explicit types")
        }
        adjacent_index += 1
    }
    match_parts
}

fn parser_take_pattern_binary_bad_hole(state: &JetParserState, span: Span) {
    parser_add_error_code(&state, "E1007", span, "a binary pattern hole must be `{{name:U<width>}}` or `{{name:...}}`", "a binary hole reads a fixed unsigned bit field or the remaining bytes", "write a hole such as `{{value:U8}}`, `{{value:U16be}}`, or `{{rest:...}}`")
}

fn parser_take_pattern_binary_bits(state: &JetParserState, spec: String, span: Span) -> BinSpec {
    bytes :: spec.bytes()
    endian := BinEndian.Unspecified
    end := bytes.len()
    if {
        bytes.len() >= 2 && Int.from_u8(bytes[end - 2]) == 98 && Int.from_u8(bytes[end - 1]) == 101 -> {
            endian = BinEndian.Big
            end -= 2
        }
        bytes.len() >= 2 && Int.from_u8(bytes[end - 2]) == 108 && Int.from_u8(bytes[end - 1]) == 101 -> {
            endian = BinEndian.Little
            end -= 2
        }
    }
    if end < 2 || Int.from_u8(bytes[0]) != 85 {
        parser_add_error_code(&state, "E1007", span, "`{spec}` is not a valid binary bit width", "a bit field uses `U` followed by a width from 1 through 64", "write `U4`, `U8`, `U16be`, or `U32le`")
        return BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}
    }
    width := 0
    digits := 0
    index := 1
    loop index < end {
        digit :: Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> break
        width = width * 10 + digit - 48
        digits += 1
        index += 1
    }
    if digits == 0 || index != end || width < 1 || width > 64 {
        parser_add_error_code(&state, "E1007", span, "`{spec}` is not a valid binary bit width", "a bit field uses `U` followed by a width from 1 through 64", "write `U4`, `U8`, `U16be`, or `U32le`")
        return BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}
    }
    if {
        width > 8 && endian == BinEndian.Unspecified -> {
            parser_add_error_code(&state, "E1008", span, "`U{width}` spans multiple bytes and needs an endianness", "byte order must be explicit for binary widths greater than 8 bits", "add `be` or `le`, for example `U16be`")
            endian = BinEndian.Big
        }
        width <= 8 && endian != BinEndian.Unspecified -> {
            parser_add_error_code(&state, "E1008", span, "`U{width}` reads at most one byte, so an endianness suffix has no meaning", "byte order only matters for multi-byte reads", "drop the `be` or `le` suffix")
            endian = BinEndian.Unspecified
        }
    }
    BinSpec.Bits{width: width, endian: endian}
}

// Rust `parse_bin_match_hole`: a hole without a name or colon is dropped
// (E1007 at the whole literal or the name); a bad or trailing spec keeps
// the hole with the fallback `U8` reading.
fn parser_take_pattern_binary_hole(state: &JetParserState, part: StringPart, literal_span: Span) -> BinMatchPart? {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        result_handler_depth: state.result_handler_depth,
        statement_start: -1,
        allow_environment_reads: state.allow_environment_reads,
    }
    name_token :: parser_current(&nested)
    if name_token.kind != TOKEN_IDENT {
        parser_take_pattern_binary_bad_hole(&state, literal_span)
        return None
    }
    parser_bump(&nested)
    if parser_current_kind(&nested) != TOKEN_COLON {
        parser_take_pattern_binary_bad_hole(&state, name_token.span)
        return None
    }
    parser_bump(&nested)
    spec_token :: parser_bump(&nested)
    spec := BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}
    if parser_current_kind(&nested) != TOKEN_EOF {
        parser_take_pattern_binary_bad_hole(&state, spec_token.span)
    } else if spec_token.kind == TOKEN_DOT_DOT_DOT {
        spec = BinSpec.Rest
    } else if spec_token.kind == TOKEN_IDENT {
        spec_text :: parser_value(state, spec_token)
        spec = parser_take_pattern_binary_bits(&state, spec_text, spec_token.span)
    } else {
        parser_take_pattern_binary_bad_hole(&state, spec_token.span)
    }
    Val(BinMatchPart.Hole{name: parser_value(state, name_token), spec: spec, span: parser_cover(name_token.span, spec_token.span)})
}

fn parser_take_pattern_binary_parts(state: &JetParserState, parts: [StringPart], literal_span: Span) -> [BinMatchPart] {
    match_parts := [BinMatchPart]{}
    loop part in parts {
        if part.kind == {
            STRING_PART_TEXT -> {
                text :: parser_part_text(state, part)
                if text != "" -> &match_parts.push(BinMatchPart.Lit{bytes: text.bytes()})
            }
            STRING_PART_BYTE -> &match_parts.push(BinMatchPart.Lit{bytes: [U8]{U8{part.byte}}})
            STRING_PART_INTERPOLATION -> {
                if parser_take_pattern_binary_hole(&state, part, literal_span) == .Val(hole) -> &match_parts.push(hole)
            }
            else -> {}
        }
    }
    index := 0
    loop index < match_parts.len() {
        if match_parts[index] == {
            .Hole(_, spec, rest_span) -> {
                if spec == BinSpec.Rest {
                    if index + 1 < match_parts.len() {
                        parser_add_error_code(&state, "E1009", rest_span, "a binary rest capture must be the last pattern part", "a rest capture consumes every remaining byte", "move the rest capture to the end")
                        break
                    }
                }
            }
            else -> {}
        }
        index += 1
    }
    match_parts
}

// Rust `parse_take_pattern_literal`: a typed `[U8]{"…"}` / `String{"…"}`
// first; typed text holes must be bare names, optionally typed (fatal
// E0003 at the hole's first token), while a bare string takes any hole.
fn parser_parse_take_pattern_literal(state: &JetParserState, depth: Int) -> ParsedExpr {
    typed :: parser_try_take_pattern_body(&state, depth + 1)
    if typed == .Val(body) {
        if body.binary {
            parts := parser_take_pattern_binary_parts(&state, body.parts, body.span)
            return ParsedExpr{expr: Expr.BinMatchLit{parts: parts, span: body.span}, span: body.span}
        }
        loop part in body.parts {
            if part.kind != STRING_PART_INTERPOLATION || parser_pattern_hole_shape_ok(part) -> next
            bad_span :: if part.tokens.len() > 0 -> part.tokens[0].span else -> body.span
            parser_add_error(&state, bad_span, "a `take_pattern` hole must be a bare name, optionally typed", "each hole binds a name or a typed, fallibly-parsed name, the same grammar an `if ==` pattern hole uses", "write `{{name}}` or `{{name:Type}}`")
            return ParsedExpr{expr: Expr.Unit{span: body.span}, span: body.span}
        }
        parts := parser_take_pattern_text_parts(&state, body.parts)
        return ParsedExpr{expr: Expr.StrMatchLit{parts: parts, span: body.span}, span: body.span}
    }
    token :: parser_current(&state)
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        parser_bump(&state)
        token_parts :: parser_string_parts(state, token)
        parts := parser_take_pattern_text_parts(&state, token_parts)
        return ParsedExpr{expr: Expr.StrMatchLit{parts: parts, span: token.span}, span: token.span}
    }
    parser_add_error_code(&state, "E0003", token.span, "`take_pattern` needs a literal text or binary pattern", "the pattern is matched at compile time and cannot be computed", "write a string literal, or use `[U8]{{\"…\"}}` for bytes")
    ParsedExpr{expr: Expr.Unit{span: token.span}, span: token.span}
}
// S31 only equality against `Val(name)` introduces a binding.
// Other payload expressions construct a value. This restriction belongs to
// comparison RHS parsing, not dispatch-arm or nested leading-dot patterns.
fn parser_comparison_pattern_rhs_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind == TOKEN_IDENT && parser_value(state, token) == "Val" {
        return parser_kind_at(&state, 1) == TOKEN_LPAREN && parser_kind_at(&state, 2) == TOKEN_IDENT && parser_kind_at(&state, 3) == TOKEN_RPAREN
    }
    parser_pattern_rhs_ahead(&state)
}

// Rust `try_pattern_rhs`: the heads that start a pattern after `==` or as a
// bare arm head. Anything else is an ordinary value.
fn parser_pattern_rhs_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind == {
        TOKEN_DOT -> {
            next :: parser_lookahead(&state, 1)
            if next.kind == TOKEN_IDENT {
                word :: parser_value(state, next)
                return parser_pascal_name(word) || word.starts_with("$")
            }
            next.kind == TOKEN_NULL || next.kind == TOKEN_LBRACE
        }
        TOKEN_NULL -> true
        TOKEN_LBRACKET -> parser_typed_pattern_ahead(&state) || parser_bracket_pattern_ahead(&state)
        TOKEN_LBRACE -> parser_literal_fields_ahead(&state) || ((parser_kind_at(&state, 1) == TOKEN_STRING || parser_kind_at(&state, 1) == TOKEN_RAW_STRING) && parser_kind_at(&state, 2) == TOKEN_COLON)
        TOKEN_STRING -> parser_string_pattern_ahead(state, token)
        // A bare `Variant(…)` or `Variant | …` is a pattern that
        // lacks its leading dot (E0367).
        TOKEN_IDENT -> parser_typed_pattern_ahead(&state) || parser_bare_variant_head(&state) || parser_named_struct_pattern_ahead(&state)
        else -> false
    }
}

// Rust `named_struct_pattern_ahead` `Point{…}` starts a
// named struct pattern only when the head is a non-constant type name and
// its brace body reads as pattern entries: `..`, `field:`, `field,`, or a
// lone `field}` followed by what ends the pattern. Typed literals such as
// `I64{0}`, `I64{-4}` and a constant compared before a body (`CONST {`)
// stay values.
fn parser_named_struct_pattern_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind != TOKEN_IDENT || parser_kind_at(&state, 1) != TOKEN_LBRACE -> return false
    name :: parser_value(state, token)
    if !parser_pascal_name(name) || parser_constant_name(name) || name == "String" -> return false
    first :: parser_lookahead(&state, 2)
    if first.kind == TOKEN_DOT_DOT -> return true
    if first.kind != TOKEN_IDENT || parser_value(state, first) == "_" -> return false
    second :: parser_kind_at(&state, 3)
    if second == TOKEN_COLON || second == TOKEN_COMMA -> return true
    if second != TOKEN_RBRACE -> return false
    after :: parser_kind_at(&state, 4)
    after == TOKEN_LBRACE || after == TOKEN_UNIFIED_ARROW || after == TOKEN_LAMBDA_ARROW || after == TOKEN_COMMA || after == TOKEN_RPAREN || after == TOKEN_RBRACKET || after == TOKEN_RBRACE || after == TOKEN_AND_AND
}

// Rust `try_typed_pattern_str_body`: `[U8]{"…"}`, `[U8#N]{"…"}` or
// `String{"…"}` (the retired `.{` spelling too). A `String` head is a
// pattern only when its string has holes that all read as bare names.
fn parser_typed_pattern_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    text :: token.kind == TOKEN_IDENT && parser_value(state, token) == "String"
    offset := 1
    if !text {
        if token.kind != TOKEN_LBRACKET || parser_kind_at(&state, 1) != TOKEN_IDENT || parser_value_at(&state, 1) != "U8" -> return false
        offset = 2
        if parser_kind_at(&state, 2) == TOKEN_HASH {
            loop offset < 8 && parser_kind_at(&state, offset) != TOKEN_RBRACKET && parser_kind_at(&state, offset) != TOKEN_EOF -> offset += 1
        }
        if parser_kind_at(&state, offset) != TOKEN_RBRACKET -> return false
        offset += 1
    }
    if parser_kind_at(&state, offset) == TOKEN_DOT -> offset += 1
    if parser_kind_at(&state, offset) != TOKEN_LBRACE || parser_kind_at(&state, offset + 2) != TOKEN_RBRACE -> return false
    literal :: parser_lookahead(&state, offset + 1)
    if literal.kind == TOKEN_STRING && (!text || parser_string_pattern_ahead(state, literal)) -> return true
    literal.kind == TOKEN_RAW_STRING && !text
}

// Rust `try_str_match_pattern`: a string with holes, each a bare name
// optionally followed by `:Type`.
fn parser_string_pattern_ahead(state: JetParserState, token: Token) -> Bool Never! {
    if parser_interpolations(state, token) == 0 -> return false
    loop part in parser_string_parts(state, token) {
        if part.kind == STRING_PART_INTERPOLATION && !parser_pattern_hole_shape_ok(part) -> return false
    }
    true
}

fn parser_pattern_hole_shape_ok(part: StringPart) -> Bool Never! {
    if part.tokens.len() == 0 || part.tokens[0].kind != TOKEN_IDENT -> return false
    if part.tokens.len() == 1 || part.tokens[1].kind == TOKEN_EOF -> return true
    part.tokens[1].kind == TOKEN_COLON && part.tokens.len() >= 3
}

// `allow_named` admits the named payload form
// `.Case{field: pat, ..}`. It is false where a following `{` opens a block
// (an `if` condition), exactly as for struct literals.
fn parser_parse_pattern(state: &JetParserState, depth: Int, allow_named: Bool) -> ParsedPattern {
    if depth > 128 {
        span :: parser_current(&state).span
        parser_add_error(&state, span, "this pattern is nested too deeply", "pattern recursion is bounded against adversarial nesting", "reduce the pattern nesting depth")
        return ParsedPattern{pattern: Pattern.Variant{variant: "_", bindings: [PatSlot]{}, leading_dot: false, span: span}, span: span}
    }
    first :: parser_parse_pattern_atom(&state, depth + 1, allow_named)
    alternatives := [Pattern]{first.pattern}
    end := first.span
    loop parser_current_kind(&state) == TOKEN_PIPE {
        parser_bump(&state)
        if !parser_pattern_rhs_ahead(&state) && !(parser_current_kind(&state) == TOKEN_IDENT && parser_pascal_name(parser_value_at(&state, 0)) && !parser_constant_name(parser_value_at(&state, 0))) {
            parser_add_error_here(&state, "expected a variant pattern after `|` in an or-pattern", "or-patterns join two variant patterns: `.A(x) | .B(x)`", "write a leading-dot variant after `|`")
            break
        }
        // Any bare PascalCase alternative lacks its leading dot.
        alternative :: parser_current(&state)
        alternative_name :: parser_value(state, alternative)
        if alternative.kind == TOKEN_IDENT && parser_pascal_name(alternative_name) && !parser_constant_name(alternative_name) && parser_kind_at(&state, 1) != TOKEN_LPAREN && parser_kind_at(&state, 1) != TOKEN_PIPE && parser_kind_at(&state, 1) != TOKEN_DOT {
            parser_report_bare_variant(&state, alternative, "")
        }
        next :: parser_parse_pattern_atom(&state, depth + 1, allow_named)
        &alternatives.push(next.pattern)
        end = next.span
    }
    if alternatives.len() == 1 -> return first
    span :: parser_cover(first.span, end)
    ParsedPattern{pattern: Pattern.Or{alternatives: alternatives, span: span}, span: span}
}

fn parser_parse_pattern_atom(state: &JetParserState, depth: Int, allow_named: Bool) -> ParsedPattern {
    start :: parser_current(&state)
    if parser_try_take_pattern_body(&state, depth + 1) == .Val(body) {
        if body.binary -> return ParsedPattern{pattern: Pattern.BinMatch{parts: parser_take_pattern_binary_parts(&state, body.parts, body.span), span: body.span}, span: body.span}
        return ParsedPattern{pattern: Pattern.StrMatch{parts: parser_take_pattern_text_parts(&state, body.parts), span: body.span}, span: body.span}
    }
    if start.kind == TOKEN_LBRACKET -> return parser_parse_bracket_pattern(&state, depth + 1)
    if start.kind == TOKEN_NULL {
        parser_bump(&state)
        return ParsedPattern{pattern: Pattern.Variant{variant: "None", bindings: [PatSlot]{}, leading_dot: false, span: start.span}, span: start.span}
    }
    if start.kind == TOKEN_LBRACE -> return parser_parse_struct_pattern(&state, start.span, depth + 1, None)
    if start.kind == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        parser_add_fatal_code(&state, "E0320", start.span, "inferred record patterns use `{{…}}`, not `.{{…}}`", "D-LIT-DOT1 drops the constructor dot from every literal head", "write `{{ kind: …, field, .. }}`")
        parser_bump(&state)
        return parser_parse_struct_pattern(&state, start.span, depth + 1, None)
    }
    if start.kind == TOKEN_STRING -> return parser_parse_string_pattern(&state)
    leading_dot := false
    path := ""
    path_span := start.span
    if {
        start.kind == TOKEN_DOT -> {
            parser_bump(&state)
            leading_dot = true
            name :: if parser_current_kind(&state) == TOKEN_NULL -> parser_bump(&state) else -> parser_expect_name(&state, "after `.` in a variant pattern")
            path = parser_value(state, name)
            path_span = name.span
        }
        start.kind == TOKEN_IDENT || start.kind == TOKEN_SELF -> {
            // `Val(x)` is the present-value literal, not a bare variant (Rust
            // `try_pattern_rhs` takes it before the E0367 check).
            if start.kind == TOKEN_IDENT && parser_value(state, start) != "Val" && parser_bare_variant_head(&state) {
                payload :: if parser_kind_at(&state, 1) == TOKEN_LPAREN -> "(…)" else -> ""
                parser_report_bare_variant(&state, start, payload)
            }
            parser_bump(&state)
            path = parser_value(state, start)
            path_span = start.span
        }
        else -> {
            found :: parser_text(state, start)
            parser_add_error(&state, start.span, "expected a pattern, found `{found}`", "patterns bind values, name variants, and express range or string cases", "write a binding name, variant, or pattern constructor")
            if start.kind != TOKEN_EOF && start.kind != TOKEN_RBRACE && start.kind != TOKEN_COMMA -> parser_bump(&state)
            return ParsedPattern{pattern: Pattern.Variant{variant: "_", bindings: [PatSlot]{}, leading_dot: false, span: start.span}, span: start.span}
        }
    }
    loop {
        separator_kind :: parser_current_kind(&state)
        if separator_kind != TOKEN_DOT && separator_kind != TOKEN_COLON_COLON -> break
        parser_bump(&state)
        member :: parser_expect_name(&state, "after a separator in a variant pattern")
        path = "{path}.{parser_value(state, member)}"
        path_span = member.span
    }
    if parser_current_kind(&state) == TOKEN_LBRACE {
        if !leading_dot -> return parser_parse_struct_pattern(&state, path_span, depth + 1, Val(PatternTypeHead{name: path, span: path_span}))
        if allow_named || parser_named_pattern_brace_ahead(&state) {
            named :: parser_parse_named_pattern_slots(&state, path, depth + 1)
            span :: parser_cover(start.span, named.end)
            return ParsedPattern{pattern: Pattern.Variant{variant: path, bindings: named.slots, leading_dot: true, span: span}, span: span}
        }
    }
    bindings := [PatSlot]{}
    end := path_span
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_RPAREN {
            loop {
                &bindings.push(parser_parse_pattern_slot(&state, depth + 1))
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
                if parser_current_kind(&state) != TOKEN_COMMA -> break
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
            }
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after variant pattern bindings")
        end = close.span
    }
    span :: parser_cover(start.span, end)
    ParsedPattern{pattern: Pattern.Variant{variant: path, bindings: bindings, leading_dot: leading_dot, span: span}, span: span}
}

fn parser_pascal_name(name: String) -> Bool Never! {
    if name.len() == 0 -> return false
    first :: Int.from_u8(name.bytes()[0])
    first >= 65 && first <= 90
}

// `Variant(…)`, or a non-constant `Variant |`, at the cursor.
fn parser_bare_variant_head(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind != TOKEN_IDENT || !parser_pascal_name(parser_value(state, token)) -> return false
    next :: parser_kind_at(&state, 1)
    next == TOKEN_LPAREN || (next == TOKEN_PIPE && !parser_constant_name(parser_value(state, token)))
}

fn parser_report_bare_variant(state: &JetParserState, token: Token, payload: String) {
    name :: parser_value(state, token)
    parser_add_error_code(&state, "E0367", token.span, "pattern `{name}` needs a leading `.`", "match patterns take a leading dot so the name isn't read as a variable or call (D-ENUMDOT1)", "write `.{name}{payload}`")
}

fn parser_parse_pattern_slot(state: &JetParserState, depth: Int) -> PatSlot {
    start :: parser_current(&state)
    // S31: a leading-dot pattern nests inside the payload slot.
    if start.kind == TOKEN_DOT -> return PatSlot.Nested{pattern: parser_parse_pattern(&state, depth + 1, true).pattern}
    if start.kind == TOKEN_INT {
        parser_bump(&state)
        low :: parser_integer(state, start) ?? 0
        parser_expect(&state, TOKEN_DOT_DOT, "`..` after the lower bound of a range pattern")
        high :: parser_expect(&state, TOKEN_INT, "an integer at the end of a pattern range")
        return PatSlot.Range{lo: low, hi: parser_integer(state, high) ?? low}
    }
    name :: parser_expect_name(&state, "in a variant binding")
    if parser_value(state, name) == "_" -> PatSlot.Wildcard else -> PatSlot.Bind{name: parser_value(state, name), span: name.span}
}

// In a condition, where `{` usually opens the body,
// `.Case{` starts named payload entries only when its first entry reads as
// one: `..`, `field:`, `field,`, or a lone `field}` directly followed by the
// body (`{` or `->`). No block starts with those tokens.
fn parser_named_pattern_brace_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_LBRACE -> return false
    first :: parser_lookahead(&state, 1)
    if first.kind == TOKEN_DOT_DOT -> return true
    if first.kind != TOKEN_IDENT || parser_value(state, first) == "_" -> return false
    second :: parser_kind_at(&state, 2)
    if second == TOKEN_COLON || second == TOKEN_COMMA -> return true
    if second != TOKEN_RBRACE -> return false
    after :: parser_kind_at(&state, 3)
    after == TOKEN_LBRACE || after == TOKEN_UNIFIED_ARROW
}

// Line breaks inside a multi-line named-field pattern lex as `;`.
fn parser_skip_named_pattern_line_breaks(state: &JetParserState) Never! {
    loop parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
}

// The brace body of `.Case{field: pat, field, ..}`.
// Each entry is `field: slot` or the shorthand `field` (binds `field`); an
// optional `..` ends the list. Sema places the entries on the case's
// positional payload slots.
fn parser_parse_named_pattern_slots(state: &JetParserState, variant: String, depth: Int) -> (slots: [PatSlot], end: Span) {
    parser_bump(&state)
    slots := [PatSlot]{}
    loop {
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE || parser_current_kind(&state) == TOKEN_EOF -> break
        entry :: parser_current(&state)
        if entry.kind == TOKEN_DOT_DOT {
            parser_bump(&state)
            parser_skip_named_pattern_line_breaks(&state)
            if parser_current_kind(&state) != TOKEN_RBRACE {
                parser_add_error(&state, entry.span, "`..` must be the last entry of a named-field pattern", "`..` stands for every field the pattern does not name", "move `..` to the end: `.{variant}{{field: pattern, ..}}`")
            }
            &slots.push(PatSlot.Rest{span: entry.span})
            break
        }
        if entry.kind != TOKEN_IDENT || parser_value(state, entry) == "_" {
            parser_add_error(&state, entry.span, "`.{variant}{{…}}` mixes a positional entry with field names", "a named-field pattern labels every entry; one pattern uses one form", "write `field: pattern` for this entry, or match by position with `.{variant}(…)`")
            parser_parse_pattern_slot(&state, depth + 1)
        } else {
            parser_bump(&state)
            slot := PatSlot.Bind{name: parser_value(state, entry), span: entry.span}
            if parser_current_kind(&state) == TOKEN_COLON {
                parser_bump(&state)
                slot = parser_parse_pattern_slot(&state, depth + 1)
            }
            &slots.push(PatSlot.Named{field: parser_value(state, entry), field_span: entry.span, slot: slot})
        }
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after named-field pattern entries")
    (end: close.span, slots: slots)
}

fn parser_parse_struct_pattern(state: &JetParserState, type_span: Span, depth: Int, type_name: PatternTypeHead?) -> ParsedPattern {
    open :: parser_bump(&state)
    fields := [StructPatField]{}
    rest := Span?{None}
    if parser_current_kind(&state) != TOKEN_RBRACE {
        loop {
            if parser_current_kind(&state) == TOKEN_DOT_DOT {
                rest = Val(parser_bump(&state).span)
                break
            }
            field :: parser_expect_name(&state, "in a struct pattern")
            if {
                parser_current_kind(&state) == TOKEN_COLON -> {
                    parser_bump(&state)
                    if parser_current_kind(&state) == TOKEN_IDENT && (parser_kind_at(&state, 1) == TOKEN_COMMA || parser_kind_at(&state, 1) == TOKEN_RBRACE) {
                        local :: parser_bump(&state)
                        &fields.push(StructPatField.Bind{field: parser_value(state, field), field_span: field.span, local: parser_value(state, local), local_span: local.span})
                    } else {
                        value :: parser_parse_expression_no_struct_lit(&state, depth + 1)
                        &fields.push(StructPatField.Value{field: parser_value(state, field), field_span: field.span, value: value.expr})
                    }
                }
                else -> {
                    &fields.push(StructPatField.Bind{field: parser_value(state, field), field_span: field.span, local: parser_value(state, field), local_span: field.span})
                }
            }
            if parser_current_kind(&state) == TOKEN_RBRACE -> break
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RBRACE -> break
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after struct pattern fields")
    span :: parser_cover(type_span, close.span)
    ParsedPattern{pattern: Pattern.Struct{fields: ^fields, rest: ^rest, span: span, type_name: type_name}, span: span}
}

fn parser_parse_string_pattern(state: &JetParserState) -> ParsedPattern {
    token :: parser_bump(&state)
    token_parts :: parser_string_parts(state, token)
    parts := parser_take_pattern_text_parts(&state, token_parts)
    if parser_string_part_count(state, token) == 0 -> &parts.push(StrMatchPart.Lit{text: parser_value(state, token)})
    ParsedPattern{pattern: Pattern.StrMatch{parts: parts, span: token.span}, span: token.span}
}

fn parser_bracket_pattern_ahead(state: &JetParserState) -> Bool Never! {
    offset := 1
    depth := 0
    parens := 0
    shaped := parser_kind_at(&state, 1) == TOKEN_RBRACKET || (parser_kind_at(&state, 1) == TOKEN_COLON && parser_kind_at(&state, 2) == TOKEN_RBRACKET)
    loop parser_kind_at(&state, offset) != TOKEN_EOF {
        token :: parser_lookahead(&state, offset)
        if token.kind == TOKEN_RBRACKET && depth == 0 {
            after :: parser_kind_at(&state, offset + 1)
            return shaped && after != TOKEN_LBRACE && after != TOKEN_HASH
        }
        if token.kind == TOKEN_DOT_DOT || token.kind == TOKEN_QUESTION -> shaped = true
        // Rust `pattern_item`: only a bare lowercase slot name directly
        // closed by `,` `)` `]` `}` binds (never a call argument), and only a
        // slot-leading `.Variant` nests; `[n - 1]`, `[f(x)]` and `[a.b]` stay
        // list values.
        if token.kind == TOKEN_IDENT && parens == 0 && !parser_pascal_name(parser_value(state, token)) && !parser_constant_name(parser_value(state, token)) && parser_slot_start(parser_kind_at(&state, offset - 1)) && parser_bind_slot_end(parser_kind_at(&state, offset + 1)) -> shaped = true
        if token.kind == TOKEN_DOT && parser_kind_at(&state, offset + 1) == TOKEN_IDENT && parser_pascal_name(parser_value_at(&state, offset + 1)) && parser_slot_start(parser_kind_at(&state, offset - 1)) -> shaped = true
        if token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACE -> depth += 1
        if token.kind == TOKEN_RBRACKET || token.kind == TOKEN_RPAREN || token.kind == TOKEN_RBRACE -> depth -= 1
        if token.kind == TOKEN_LPAREN -> parens += 1
        if token.kind == TOKEN_RPAREN -> parens -= 1
        offset += 1
    }
    false
}

fn parser_bind_slot_end(kind: Int) -> Bool Never! {
    kind == TOKEN_COMMA || kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE || kind == TOKEN_SEMI
}

fn parser_slot_start(kind: Int) -> Bool Never! {
    kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN || kind == TOKEN_LBRACE || kind == TOKEN_COMMA || kind == TOKEN_COLON || kind == TOKEN_SEMI
}

fn parser_map_pattern_entry_ahead(state: &JetParserState) -> Bool Never! {
    offset := 0
    depth := 0
    loop parser_kind_at(&state, offset) != TOKEN_EOF {
        kind :: parser_kind_at(&state, offset)
        if depth == 0 {
            if kind == TOKEN_COLON -> return true
            if kind == TOKEN_QUESTION -> return parser_kind_at(&state, offset + 1) == TOKEN_COLON
            if kind == TOKEN_COMMA || kind == TOKEN_DOT_DOT || kind == TOKEN_RBRACKET -> return false
        }
        if kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN || kind == TOKEN_LBRACE -> depth += 1
        if kind == TOKEN_RBRACKET || kind == TOKEN_RPAREN || kind == TOKEN_RBRACE -> depth -= 1
        offset += 1
    }
    false
}

fn parser_parse_map_pattern_key(state: &JetParserState, depth: Int) -> ParsedExpr {
    key := parser_parse_prefix(&state, depth + 1, false, false)
    loop parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT {
        parser_bump(&state)
        member :: parser_bump(&state)
        key = ParsedExpr{expr: Expr.Field{base: key.expr, member: parser_value(state, member), span: member.span}, span: parser_cover(key.span, member.span)}
    }
    key
}

fn parser_parse_bracket_pattern(state: &JetParserState, depth: Int) -> ParsedPattern {
    open :: parser_bump(&state)
    parser_skip_named_pattern_line_breaks(&state)
    if parser_current_kind(&state) == TOKEN_COLON && parser_kind_at(&state, 1) == TOKEN_RBRACKET {
        parser_bump(&state)
        close :: parser_bump(&state)
        span :: parser_cover(open.span, close.span)
        return ParsedPattern{pattern: Pattern.Map{entries: [MapPatEntry]{}, rest: None, span: span}, span: span}
    }
    is_map :: parser_map_pattern_entry_ahead(&state)
    items := [PatSlot]{}
    entries := [MapPatEntry]{}
    list_rest := ListPatRest?{None}
    map_rest := Span?{None}
    loop parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) == TOKEN_DOT_DOT {
            dots :: parser_bump(&state).span
            name := BindName?{None}
            if !is_map && parser_current_kind(&state) == TOKEN_IDENT {
                token :: parser_bump(&state)
                name = Val(BindName{name: parser_value(state, token), span: token.span, rename: None})
            }
            parser_skip_named_pattern_line_breaks(&state)
            if parser_current_kind(&state) != TOKEN_RBRACKET -> parser_add_error_code(&state, "E0003", dots, "`..` must be the last entry of a pattern", "the rest marker stands for all remaining entries", "move `..` to the end")
            if is_map -> map_rest = Val(dots) else -> list_rest = Val(ListPatRest{name: name, span: dots})
            break
        }
        if is_map {
            key :: parser_parse_map_pattern_key(&state, depth + 1)
            optional :: parser_current_kind(&state) == TOKEN_QUESTION
            if optional -> parser_bump(&state)
            parser_expect(&state, TOKEN_COLON, "`:` between a map key and pattern")
            slot :: parser_parse_pattern_slot(&state, depth + 1)
            &entries.push(MapPatEntry{key: key.expr, optional: optional, slot: ^slot, span: parser_cover(key.span, parser_lookahead(&state, -1).span)})
        } else {
            &items.push(parser_parse_pattern_slot(&state, depth + 1))
        }
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
        parser_skip_named_pattern_line_breaks(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACKET, "`]` after a pattern")
    span :: parser_cover(open.span, close.span)
    pattern :: if is_map -> Pattern.Map{entries: entries, rest: map_rest, span: span} else -> Pattern.List{items: items, rest: list_rest, span: span}
    ParsedPattern{pattern: pattern, span: span}
}
