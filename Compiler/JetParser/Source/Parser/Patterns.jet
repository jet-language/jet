// Pattern grammar maps directly to the shared Jet AST.

pub struct ParsedPattern {
    pub pattern: Pattern
    pub span: Span
}
struct ParsedTakePatternBody {
    pub binary: Bool
    pub parts: [StringPart]
    pub span: Span
}

fn parser_take_pattern_head_kind(ty: Type) -> Int Never! {
    if ty == {
        .String -> {
            return 1
        }
        .List(element) -> {
            if parser_is_byte_type(element) -> return 2
        }
        .FixedList(element, _) -> {
            if parser_is_byte_type(element) -> return 2
        }
        else -> {}
    }
    0
}

fn parser_is_byte_type(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, bits) -> !signed && bits == 8
        else -> false
    }
}

fn parser_try_take_pattern_body(state: &JetParserState, depth: Int) -> ParsedTakePatternBody? Err! {
    first :: parser_current(&state)
    if first.kind != TOKEN_LBRACKET && !(first.kind == TOKEN_IDENT && first.payload.decoded == "String") -> return None
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_pending_gt := state.pending_type_gt
    saved_pending_gt_span := state.pending_type_gt_span
    head :: parser_parse_type(&state, depth + 1)
    kind := parser_take_pattern_head_kind(head.ty)
    if kind == 0 || state.diagnostics.len() != saved_diagnostics {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    dotted := parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE
    if !dotted && parser_current_kind(&state) != TOKEN_LBRACE {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    if dotted {
        dot :: parser_bump(&state)
        label := if kind == 2 -> "[U8]" else -> "String"
        parser_add_error_code(&state, "E0320", dot.span, "typed pattern construction uses `{label}{{…}}`, not `{label}.{{…}}`", "the constructor dot is omitted from typed literal heads", "write `{label}{{…}}`")
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a take_pattern literal")
    literal :: parser_current(&state)
    if literal.kind != TOKEN_STRING && literal.kind != TOKEN_RAW_STRING {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    text :: parser_bump(&state)
    if parser_current_kind(&state) != TOKEN_RBRACE {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_pending_gt
        state.pending_type_gt_span = saved_pending_gt_span
        return None
    }
    close :: parser_bump(&state)
    Val(ParsedTakePatternBody{binary: kind == 2, parts: text.payload.string_parts, span: parser_cover(head.span, close.span)})
}

fn parser_pattern_byte_text(value: Int) -> String Never! {
    if value < 128 -> return String.from_bytes([U8]{U8{value}}) ?? ""
    high := 192 | (value >> 6)
    low := 128 | (value & 63)
    String.from_bytes([U8]{U8{high}, U8{low}}) ?? ""
}

fn parser_take_pattern_bad_hole(state: &JetParserState, span: Span) {
    parser_add_error_code(&state, "E0003", span, "a take_pattern hole must be a bare name, optionally typed", "each text hole binds a name, optionally with a type", "write a name or a name followed by `:Type`")
}

fn parser_take_pattern_text_hole(state: &JetParserState, part: StringPart) -> StrMatchPart {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        result_handler_depth: state.result_handler_depth,
        statement_start: -1,
    }
    name_token :: parser_current(&nested)
    if name_token.kind != TOKEN_IDENT {
        parser_take_pattern_bad_hole(&state, part.span)
        return StrMatchPart.Hole{name: "_", ty: None, span: part.span}
    }
    parser_bump(&nested)
    ty := Type?{None}
    if parser_current_kind(&nested) == TOKEN_COLON {
        parser_bump(&nested)
        if parser_current_kind(&nested) == TOKEN_EOF {
            parser_take_pattern_bad_hole(&state, name_token.span)
            return StrMatchPart.Hole{name: name_token.payload.decoded, ty: None, span: name_token.span}
        }
        parsed_type :: parser_parse_type(&nested, 1)
        ty = Val(parsed_type.ty)
    }
    if parser_current_kind(&nested) != TOKEN_EOF {
        parser_take_pattern_bad_hole(&state, Span{start: name_token.span.start, end: parser_current(&nested).span.end})
        return StrMatchPart.Hole{name: name_token.payload.decoded, ty: None, span: name_token.span}
    }
    index := 0
    loop index < nested.diagnostics.len() {
        &state.diagnostics.push(nested.diagnostics[index])
        index += 1
    }
    end := name_token.span.end
    if nested.position > 0 -> end = parser_lookahead(&nested, -1).span.end
    StrMatchPart.Hole{name: name_token.payload.decoded, ty: ty, span: Span{start: name_token.span.start, end: end}}
}

fn parser_take_pattern_text_parts(state: &JetParserState, parts: [StringPart]) -> [StrMatchPart] {
    match_parts := [StrMatchPart]{}
    loop part in parts {
        if part.kind == {
            STRING_PART_TEXT -> &match_parts.push(StrMatchPart.Lit{text: part.text})
            STRING_PART_BYTE -> &match_parts.push(StrMatchPart.Lit{text: parser_pattern_byte_text(part.byte)})
            STRING_PART_INTERPOLATION -> &match_parts.push(parser_take_pattern_text_hole(&state, part))
            else -> {}
        }
    }
    adjacent_index := 0
    loop adjacent_index + 1 < match_parts.len() {
        first_hole := Span?{None}
        second_hole := Span?{None}
        if match_parts[adjacent_index] == {
            .Hole(_, _, span) -> first_hole = Val(span)
            else -> {}
        }
        next_index := adjacent_index + 1
        if match_parts[next_index] == {
            .Lit(text) -> {
                if text == "" {
                    next_index += 1
                }
            }
            else -> {}
        }
        if next_index < match_parts.len() {
            if match_parts[next_index] == {
                .Hole(_, _, span) -> second_hole = Val(span)
                else -> {}
            }
        }
        if first_hole != None && second_hole != None {
            first_span :: first_hole ?? Span{start: 0, end: 0}
            second_span :: second_hole ?? Span{start: 0, end: 0}
            parser_add_error_code(&state, "E0147", parser_cover(first_span, second_span), "these two text holes have nothing between them to split on", "a text pattern needs fixed literal text between adjacent holes", "put literal text between the holes or give them explicit types")
        }
        adjacent_index += 1
    }
    match_parts
}

fn parser_take_pattern_binary_bad_hole(state: &JetParserState, span: Span) {
    parser_add_error_code(&state, "E1007", span, "a binary pattern hole must be `{{name:U<width>}}` or `{{name:...}}`", "a binary hole reads a fixed unsigned bit field or the remaining bytes", "write a hole such as `{{value:U8}}`, `{{value:U16be}}`, or `{{rest:...}}`")
}

fn parser_take_pattern_binary_bits(state: &JetParserState, spec: String, span: Span) -> BinSpec {
    bytes :: spec.bytes()
    endian := BinEndian.Unspecified
    end := bytes.len()
    if {
        bytes.len() >= 2 && Int.from_u8(bytes[end - 2]) == 98 && Int.from_u8(bytes[end - 1]) == 101 -> {
            endian = BinEndian.Big
            end -= 2
        }
        bytes.len() >= 2 && Int.from_u8(bytes[end - 2]) == 108 && Int.from_u8(bytes[end - 1]) == 101 -> {
            endian = BinEndian.Little
            end -= 2
        }
    }
    if end < 2 || Int.from_u8(bytes[0]) != 85 {
        parser_add_error_code(&state, "E1007", span, "`{spec}` is not a valid binary bit width", "a bit field uses `U` followed by a width from 1 through 64", "write `U4`, `U8`, `U16be`, or `U32le`")
        return BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}
    }
    width := 0
    digits := 0
    index := 1
    loop index < end {
        digit :: Int.from_u8(bytes[index])
        if digit < 48 || digit > 57 -> break
        width = width * 10 + digit - 48
        digits += 1
        index += 1
    }
    if digits == 0 || index != end || width < 1 || width > 64 {
        parser_add_error_code(&state, "E1007", span, "`{spec}` is not a valid binary bit width", "a bit field uses `U` followed by a width from 1 through 64", "write `U4`, `U8`, `U16be`, or `U32le`")
        return BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}
    }
    if {
        width > 8 && endian == BinEndian.Unspecified -> {
            parser_add_error_code(&state, "E1008", span, "`U{width}` spans multiple bytes and needs an endianness", "byte order must be explicit for binary widths greater than 8 bits", "add `be` or `le`, for example `U16be`")
            endian = BinEndian.Big
        }
        width <= 8 && endian != BinEndian.Unspecified -> {
            parser_add_error_code(&state, "E1008", span, "`U{width}` reads at most one byte, so an endianness suffix has no meaning", "byte order only matters for multi-byte reads", "drop the `be` or `le` suffix")
            endian = BinEndian.Unspecified
        }
    }
    BinSpec.Bits{width: width, endian: endian}
}

fn parser_take_pattern_binary_hole(state: &JetParserState, part: StringPart) -> BinMatchPart {
    nested := JetParserState{
        tokens: part.tokens,
        position: 0,
        diagnostics: [Diagnostic]{},
        source_end: part.span.end,
        block_spans: [Span]{},
        pending_type_gt: false,
        pending_type_gt_span: Span{start: 0, end: 0},
        result_handler_depth: state.result_handler_depth,
        statement_start: -1,
    }
    name_token :: parser_current(&nested)
    if name_token.kind != TOKEN_IDENT {
        parser_take_pattern_binary_bad_hole(&state, part.span)
        return BinMatchPart.Hole{name: "_", spec: BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}, span: part.span}
    }
    parser_bump(&nested)
    if parser_current_kind(&nested) != TOKEN_COLON {
        parser_take_pattern_binary_bad_hole(&state, name_token.span)
        return BinMatchPart.Hole{name: name_token.payload.decoded, spec: BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}, span: name_token.span}
    }
    parser_bump(&nested)
    spec_token :: parser_current(&nested)
    if spec_token.kind == TOKEN_DOT_DOT_DOT {
        parser_bump(&nested)
        if parser_current_kind(&nested) != TOKEN_EOF {
            parser_take_pattern_binary_bad_hole(&state, Span{start: name_token.span.start, end: parser_current(&nested).span.end})
        }
        return BinMatchPart.Hole{name: name_token.payload.decoded, spec: BinSpec.Rest, span: parser_cover(name_token.span, spec_token.span)}
    }
    if spec_token.kind != TOKEN_IDENT {
        parser_take_pattern_binary_bad_hole(&state, spec_token.span)
        return BinMatchPart.Hole{name: name_token.payload.decoded, spec: BinSpec.Bits{width: 8, endian: BinEndian.Unspecified}, span: parser_cover(name_token.span, spec_token.span)}
    }
    parser_bump(&nested)
    if parser_current_kind(&nested) != TOKEN_EOF {
        parser_take_pattern_binary_bad_hole(&state, Span{start: name_token.span.start, end: parser_current(&nested).span.end})
    }
    spec := parser_take_pattern_binary_bits(&state, spec_token.payload.decoded, spec_token.span)
    BinMatchPart.Hole{name: name_token.payload.decoded, spec: spec, span: parser_cover(name_token.span, spec_token.span)}
}

fn parser_take_pattern_binary_parts(state: &JetParserState, parts: [StringPart]) -> [BinMatchPart] {
    match_parts := [BinMatchPart]{}
    loop part in parts {
        if part.kind == {
            STRING_PART_TEXT -> if part.text != "" -> &match_parts.push(BinMatchPart.Lit{bytes: part.text.bytes()})
            STRING_PART_BYTE -> &match_parts.push(BinMatchPart.Lit{bytes: [U8]{U8{part.byte}}})
            STRING_PART_INTERPOLATION -> &match_parts.push(parser_take_pattern_binary_hole(&state, part))
            else -> {}
        }
    }
    index := 0
    loop index < match_parts.len() {
        if match_parts[index] == {
            .Hole(_, spec, rest_span) -> {
                if spec == BinSpec.Rest {
                    if index + 1 < match_parts.len() {
                        parser_add_error_code(&state, "E1009", rest_span, "a binary rest capture must be the last pattern part", "a rest capture consumes every remaining byte", "move the rest capture to the end")
                        break
                    }
                }
            }
            else -> {}
        }
        index += 1
    }
    match_parts
}

fn parser_parse_take_pattern_literal(state: &JetParserState, depth: Int) -> ParsedExpr {
    typed :: parser_try_take_pattern_body(&state, depth + 1)
    if typed == .Val(body) {
        if body.binary {
            parts := parser_take_pattern_binary_parts(&state, body.parts)
            return ParsedExpr{expr: Expr.BinMatchLit{parts: parts, span: body.span}, span: body.span}
        }
        parts := parser_take_pattern_text_parts(&state, body.parts)
        return ParsedExpr{expr: Expr.StrMatchLit{parts: parts, span: body.span}, span: body.span}
    }
    token :: parser_current(&state)
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        parser_bump(&state)
        parts := parser_take_pattern_text_parts(&state, token.payload.string_parts)
        return ParsedExpr{expr: Expr.StrMatchLit{parts: parts, span: token.span}, span: token.span}
    }
    parser_add_error_code(&state, "E0003", token.span, "`take_pattern` needs a literal text or binary pattern", "the pattern is matched at compile time and cannot be computed", "write a string literal, or use `[U8]{{\"…\"}}` for bytes")
    ParsedExpr{expr: Expr.Unit{span: token.span}, span: token.span}
}
fn parser_pattern_rhs_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind == {
        TOKEN_DOT -> parser_kind_at(&state, 1) == TOKEN_IDENT
        TOKEN_NULL -> true
        TOKEN_BANG -> true
        TOKEN_QUESTION -> true
        TOKEN_LBRACE -> true
        TOKEN_INT -> {
            next_kind :: parser_kind_at(&state, 1)
            next_kind == TOKEN_DOT_DOT || next_kind == TOKEN_DOT_DOT_LT
        }
        TOKEN_STRING -> token.payload.interpolations > 0
        TOKEN_RAW_STRING -> token.payload.interpolations > 0
        else -> false
    }
}

// D-PAT-NAMED-NEST1=A: `allow_named` admits the named payload form
// `.Case{field: pat, ..}`. It is false where a following `{` opens a block
// (an `if` condition), exactly as for struct literals.
fn parser_parse_pattern(state: &JetParserState, depth: Int, allow_named: Bool) -> ParsedPattern {
    if depth > 128 {
        span :: parser_current(&state).span
        parser_add_error(&state, span, "this pattern is nested too deeply", "pattern recursion is bounded against adversarial nesting", "reduce the pattern nesting depth")
        return ParsedPattern{pattern: Pattern.Variant{variant: "_", bindings: [PatSlot]{}, leading_dot: false, span: span}, span: span}
    }
    first :: parser_parse_pattern_atom(&state, depth + 1, allow_named)
    alternatives := [Pattern]{first.pattern}
    end := first.span
    loop parser_current_kind(&state) == TOKEN_PIPE {
        parser_bump(&state)
        next :: parser_parse_pattern_atom(&state, depth + 1, allow_named)
        &alternatives.push(next.pattern)
        end = next.span
    }
    if alternatives.len() == 1 -> return first
    span :: parser_cover(first.span, end)
    ParsedPattern{pattern: Pattern.Or{alternatives: alternatives, span: span}, span: span}
}

fn parser_parse_pattern_atom(state: &JetParserState, depth: Int, allow_named: Bool) -> ParsedPattern {
    start :: parser_current(&state)
    if start.kind == TOKEN_QUESTION {
        parser_bump(&state)
        binding :: parser_expect_name(&state, "after `?` in a present-value pattern")
        span :: parser_cover(start.span, binding.span)
        return ParsedPattern{pattern: Pattern.Present{binding: binding.payload.decoded, binding_span: binding.span, inner: None, span: span}, span: span}
    }
    if start.kind == TOKEN_BANG || start.kind == TOKEN_NULL {
        parser_bump(&state)
        return ParsedPattern{pattern: Pattern.Absent{span: start.span}, span: start.span}
    }
    if start.kind == TOKEN_LBRACE -> return parser_parse_struct_pattern(&state, start.span, depth + 1)
    if start.kind == TOKEN_STRING || start.kind == TOKEN_RAW_STRING -> return parser_parse_string_pattern(&state)
    if start.kind == TOKEN_INT {
        parser_bump(&state)
        low :: start.payload.integer ?? 0
        range_kind :: parser_current_kind(&state)
        if range_kind == TOKEN_DOT_DOT || range_kind == TOKEN_DOT_DOT_LT {
            parser_bump(&state)
            high :: parser_expect(&state, TOKEN_INT, "an integer at the end of a pattern range")
            value :: high.payload.integer ?? low
            span :: parser_cover(start.span, high.span)
            return ParsedPattern{pattern: Pattern.Range{lo: low, hi: value, span: span}, span: span}
        }
        return ParsedPattern{pattern: Pattern.Range{lo: low, hi: low, span: start.span}, span: start.span}
    }
    if start.kind == TOKEN_LPAREN || start.kind == TOKEN_LBRACKET -> return parser_parse_pattern_sequence(&state, depth + 1)
    leading_dot := false
    path := ""
    path_span := start.span
    if {
        start.kind == TOKEN_DOT -> {
            parser_bump(&state)
            leading_dot = true
            name :: parser_expect_name(&state, "after `.` in a variant pattern")
            path = name.payload.decoded
            path_span = name.span
        }
        start.kind == TOKEN_IDENT || start.kind == TOKEN_SELF -> {
            parser_bump(&state)
            path = start.payload.decoded
            path_span = start.span
        }
        else -> {
            parser_add_error(&state, start.span, "expected a pattern, found `{start.payload.text}`", "patterns bind values, name variants, and express range or string cases", "write a binding name, variant, or pattern constructor")
            if start.kind != TOKEN_EOF && start.kind != TOKEN_RBRACE && start.kind != TOKEN_COMMA -> parser_bump(&state)
            return ParsedPattern{pattern: Pattern.Variant{variant: "_", bindings: [PatSlot]{}, leading_dot: false, span: start.span}, span: start.span}
        }
    }
    loop {
        separator_kind :: parser_current_kind(&state)
        if separator_kind != TOKEN_DOT && separator_kind != TOKEN_COLON_COLON -> break
        parser_bump(&state)
        member :: parser_expect_name(&state, "after a separator in a variant pattern")
        path = "{path}.{member.payload.decoded}"
        path_span = member.span
    }
    if path == "Ok" || path == "Err" {
        open :: parser_expect(&state, TOKEN_LPAREN, "`(` after a result pattern")
        slot :: parser_parse_pattern_slot(&state, depth + 1)
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after a result pattern")
        span :: parser_cover(start.span, close.span)
        binding := "_"
        binding_span := open.span
        inner := Pattern?{None}
        if slot == {
            .Bind(name, name_span) -> {
                binding = name
                binding_span = name_span
            }
            .Nested(nested) -> inner = Val(nested)
            .Wildcard -> {}
            .Range(_, _) -> parser_add_error(&state, open.span, "a result pattern binds its payload", "`Ok(…)` and `Err(…)` take a binding, `_`, or a nested pattern", "bind the payload and compare it explicitly")
            // A payload slot never parses as a named entry.
            .Named(_, _, _) | .Rest(_) -> {}
        }
        if path == "Ok" -> return ParsedPattern{pattern: Pattern.Ok{binding: binding, binding_span: binding_span, inner: inner, span: span}, span: span}
        return ParsedPattern{pattern: Pattern.Err{binding: binding, binding_span: binding_span, inner: inner, span: span}, span: span}
    }
    if parser_current_kind(&state) == TOKEN_LBRACE {
        if !leading_dot -> return parser_parse_struct_pattern(&state, path_span, depth + 1)
        if allow_named || parser_named_pattern_brace_ahead(&state) {
            named :: parser_parse_named_pattern_slots(&state, path, depth + 1)
            span :: parser_cover(start.span, named.end)
            return ParsedPattern{pattern: Pattern.Variant{variant: path, bindings: named.slots, leading_dot: true, span: span}, span: span}
        }
    }
    bindings := [PatSlot]{}
    end := path_span
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_RPAREN {
            loop {
                &bindings.push(parser_parse_pattern_slot(&state, depth + 1))
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
                if parser_current_kind(&state) != TOKEN_COMMA -> break
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RPAREN -> break
            }
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after variant pattern bindings")
        end = close.span
    }
    span :: parser_cover(start.span, end)
    ParsedPattern{pattern: Pattern.Variant{variant: path, bindings: bindings, leading_dot: leading_dot, span: span}, span: span}
}

fn parser_parse_pattern_slot(state: &JetParserState, depth: Int) -> PatSlot {
    start :: parser_current(&state)
    // S31: a leading-dot pattern nests inside the payload slot.
    if start.kind == TOKEN_DOT -> return PatSlot.Nested{pattern: parser_parse_pattern(&state, depth + 1, true).pattern}
    if start.kind == TOKEN_INT {
        parser_bump(&state)
        low :: start.payload.integer ?? 0
        range_kind :: parser_current_kind(&state)
        if range_kind == TOKEN_DOT_DOT || range_kind == TOKEN_DOT_DOT_LT {
            parser_bump(&state)
            high :: parser_expect(&state, TOKEN_INT, "an integer at the end of a pattern range")
            return PatSlot.Range{lo: low, hi: high.payload.integer ?? low}
        }
        return PatSlot.Range{lo: low, hi: low}
    }
    name :: parser_expect_name(&state, "in a variant binding")
    if name.payload.decoded == "_" -> PatSlot.Wildcard else -> PatSlot.Bind{name: name.payload.decoded, span: name.span}
}

// D-PAT-NAMED-NEST1=A: in a condition, where `{` usually opens the body,
// `.Case{` starts named payload entries only when its first entry reads as
// one: `..`, `field:`, `field,`, or a lone `field}` directly followed by the
// body (`{` or `->`). No block starts with those tokens.
fn parser_named_pattern_brace_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_LBRACE -> return false
    first :: parser_lookahead(&state, 1)
    if first.kind == TOKEN_DOT_DOT -> return true
    if first.kind != TOKEN_IDENT || first.payload.decoded == "_" -> return false
    second :: parser_kind_at(&state, 2)
    if second == TOKEN_COLON || second == TOKEN_COMMA -> return true
    if second != TOKEN_RBRACE -> return false
    after :: parser_kind_at(&state, 3)
    after == TOKEN_LBRACE || after == TOKEN_UNIFIED_ARROW
}

// Line breaks inside a multi-line named-field pattern lex as `;`.
fn parser_skip_named_pattern_line_breaks(state: &JetParserState) Never! {
    loop parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
}

// D-PAT-NAMED-NEST1=A: the brace body of `.Case{field: pat, field, ..}`.
// Each entry is `field: slot` or the shorthand `field` (binds `field`); an
// optional `..` ends the list. Sema places the entries on the case's
// positional payload slots.
fn parser_parse_named_pattern_slots(state: &JetParserState, variant: String, depth: Int) -> (slots: [PatSlot], end: Span) {
    parser_bump(&state)
    slots := [PatSlot]{}
    loop {
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE || parser_current_kind(&state) == TOKEN_EOF -> break
        entry :: parser_current(&state)
        if entry.kind == TOKEN_DOT_DOT {
            parser_bump(&state)
            parser_skip_named_pattern_line_breaks(&state)
            if parser_current_kind(&state) != TOKEN_RBRACE {
                parser_add_error(&state, entry.span, "`..` must be the last entry of a named-field pattern", "`..` stands for every field the pattern does not name", "move `..` to the end: `.{variant}{{field: pattern, ..}}`")
            }
            &slots.push(PatSlot.Rest{span: entry.span})
            break
        }
        if entry.kind != TOKEN_IDENT || entry.payload.decoded == "_" {
            parser_add_error(&state, entry.span, "`.{variant}{{…}}` mixes a positional entry with field names", "a named-field pattern labels every entry; one pattern uses one form", "write `field: pattern` for this entry, or match by position with `.{variant}(…)`")
            parser_parse_pattern_slot(&state, depth + 1)
        } else {
            parser_bump(&state)
            slot := PatSlot.Bind{name: entry.payload.decoded, span: entry.span}
            if parser_current_kind(&state) == TOKEN_COLON {
                parser_bump(&state)
                slot = parser_parse_pattern_slot(&state, depth + 1)
            }
            &slots.push(PatSlot.Named{field: entry.payload.decoded, field_span: entry.span, slot: slot})
        }
        parser_skip_named_pattern_line_breaks(&state)
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after named-field pattern entries")
    (slots: slots, end: close.span)
}

fn parser_parse_pattern_sequence(state: &JetParserState, depth: Int) -> ParsedPattern {
    open :: parser_bump(&state)
    close_kind :: if open.kind == TOKEN_LBRACKET -> TOKEN_RBRACKET else -> TOKEN_RPAREN
    variant :: if open.kind == TOKEN_LBRACKET -> "list" else -> "tuple"
    bindings := [PatSlot]{}
    if parser_current_kind(&state) != close_kind {
        loop {
            &bindings.push(parser_parse_pattern_slot(&state, depth + 1))
            if parser_current_kind(&state) == close_kind -> break
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == close_kind -> break
        }
    }
    close :: parser_expect(&state, close_kind, "the matching delimiter after pattern bindings")
    span :: parser_cover(open.span, close.span)
    ParsedPattern{pattern: Pattern.Variant{variant: variant, bindings: bindings, leading_dot: false, span: span}, span: span}
}

fn parser_parse_struct_pattern(state: &JetParserState, type_span: Span, depth: Int) -> ParsedPattern {
    open :: parser_bump(&state)
    fields := [StructPatField]{}
    rest := Span?{None}
    if parser_current_kind(&state) != TOKEN_RBRACE {
        loop {
            if parser_current_kind(&state) == TOKEN_DOT_DOT {
                rest = Val(parser_bump(&state).span)
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
            }
            field :: parser_expect_name(&state, "in a struct pattern")
            if {
                parser_current_kind(&state) == TOKEN_COLON -> {
                    parser_bump(&state)
                    value :: parser_parse_expression(&state, 1, depth + 1)
                    &fields.push(StructPatField.Value{field: field.payload.decoded, field_span: field.span, value: value.expr})
                }
                else -> {
                    &fields.push(StructPatField.Bind{field: field.payload.decoded, field_span: field.span, local: field.payload.decoded, local_span: field.span})
                }
            }
            if parser_current_kind(&state) == TOKEN_RBRACE -> break
            if parser_current_kind(&state) != TOKEN_COMMA -> break
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_RBRACE -> break
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after struct pattern fields")
    span :: parser_cover(type_span, close.span)
    ParsedPattern{pattern: Pattern.Struct{fields: fields, rest: rest, span: span}, span: span}
}

fn parser_parse_string_pattern(state: &JetParserState) -> ParsedPattern Never! {
    token :: parser_bump(&state)
    parts := [StrMatchPart]{}
    if {
        token.payload.string_parts.len() > 0 -> {
            loop part in token.payload.string_parts {
                if part.kind == {
                    STRING_PART_TEXT -> &parts.push(StrMatchPart.Lit{text: part.text})
                    STRING_PART_INTERPOLATION -> {
                        name :: if part.tokens.len() > 1 && part.tokens[0].kind == TOKEN_IDENT -> part.tokens[0].payload.decoded else -> "_"
                        &parts.push(StrMatchPart.Hole{name: name, ty: None, span: part.span})
                    }
                    else -> {}
                }
            }
        }
        else -> {
            &parts.push(StrMatchPart.Lit{text: token.payload.decoded})
        }
    }
    ParsedPattern{pattern: Pattern.StrMatch{parts: parts, span: token.span}, span: token.span}
}
