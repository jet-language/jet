// Effect types: a struct's or enum's `impl Effect { … }` block.
use {
    jet_foundation.[
        AccessConvention,
        BinOp,
        Diagnostic,
        EFFECT_VOCABULARY_ROWS,
        EffectDecl,
        EffectImpl,
        Expr,
        Func,
        ImplDef,
        Item,
        MarkerDecl,
        NamedSpan,
        Span,
        Variant,
        diagnostic_from_registry,
        expr_span,
    ]
    jet_lexer.[
        TOKEN_COLON,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_IDENT,
        TOKEN_LBRACE,
        TOKEN_RBRACE,
    ]
}

// What a struct or enum declares beside itself: its marker, then its effect
// names.
parser_type_companions: fn(marker: MarkerDecl?, effect_impl: EffectImpl?) -> [Item] Never! {
    items := [Item]{}
    if marker == .Val(declaration) -> items.push(Item.MarkerDecl{value: declaration})
    if effect_impl == .Val(declared) {
        loop declaration in declared.decls -> items.push(Item.EffectDecl{value: declaration})
    }
    items
}

// `impl Effect { … }` in a struct or enum body: empty, the method
// `irreversible: fn(self) -> Bool { … }` whose body is `true`, `false`,
// `self == .Case` or an `||` of those, a toolchain effect's `expert` method
// of the same form, and a package effect's one setting `parent: Name`. The
// effect names are built when the type closes (parser_finish_effect_type),
// once an enum's cases are known. A `repeated` block is reported and parsed
// for recovery; it yields None so the type keeps its first block.
parser_parse_effect_impl: fn(state: ^JetParserState, type_name: String, repeated: Bool) -> EffectImpl? {
    start: parser_bump(state)
    if repeated -> parser_add_report(state, parser_effect_repeated_report(start.span, type_name))
    parser_bump(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `impl Effect` body")
    declared := EffectImpl{span: start.span, irreversible: None, method_span: None, decls: [EffectDecl]{}}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        token: parser_current(state)
        if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON && !parser_method_starts_here(state) {
            written: parser_parse_effect_setting(state) ?? next
            if declared.parent != None {
                parser_add_report(state, parser_effect_parent_twice_report(written.span))
                next
            }
            declared.parent = Val(written)
            next
        }
        if !parser_method_starts_here(state) {
            found: parser_describe_token(state, token)
            parser_add_error(state, token.span, "expected `irreversible: fn` or `parent:` in `impl Effect`, found {found}", "an `impl Effect` block is empty or holds the method `irreversible: fn(self) -> Bool` and a package effect's `parent: Name`", "write `irreversible: fn(self) -> Bool {{ true }}`, write `parent: Log` for a kind of `Log`, or leave the block empty for an effect a rollback can undo")
            break
        }
        method: parser_parse_type_method(state)
        reports := [Diagnostic]{}
        parser_effect_method_take(declared, method, type_name, reports)
        loop report in reports -> parser_add_report(state, report)
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the `impl Effect` body")
    if repeated -> return None
    Val(declared)
}

// One method of `impl Effect` joins `declared`: the `irreversible` or
// `expert` fact, each once, or a report.
parser_effect_method_take: fn(declared: ^EffectImpl, method: Func, type_name: String, reports: ^[Diagnostic]) Never! {
    if parser_effect_method_problem(method) == .Val(problem) {
        reports.push(problem)
        return
    }
    expert: method.name == "expert"
    if (expert && declared.expert_span != None) || (!expert && declared.method_span != None) {
        reports.push(parser_effect_method_twice_report(method.name_span, method.name))
        return
    }
    if expert -> declared.expert_span = Val(method.span) else {
        declared.method_span = Val(method.span)
    }
    body: parser_effect_method_body(method) ?? {
        reports.push(parser_effect_body_report(method.name_span, type_name, method.name))
        return
    }
    if expert -> declared.expert = Val(body) else -> declared.irreversible = Val(body)
}

// `name: value` in `impl Effect`: the one setting `parent: Name`, a dotted
// name as a row writes it. None, reported, for any other setting.
parser_parse_effect_setting: fn(state: ^JetParserState) -> NamedSpan? {
    key_token: parser_bump(state)
    parser_bump(state)
    key: parser_value(state, key_token)
    if key != "parent" {
        _ := parser_parse_expression(state, 1, 0)
        parser_finish_data_member(state, "setting")
        parser_add_report(state, parser_effect_setting_report(key_token.span, key))
        return None
    }
    first: parser_expect_name(state, "for the parent effect after `parent:`")
    name := parser_value(state, first)
    end := first.span
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        segment: parser_expect_name(state, "for an effect path segment after `.`")
        name = "{name}.{parser_value(state, segment)}"
        end = segment.span
    }
    parser_finish_data_member(state, "setting")
    Val(NamedSpan{name: name, span: parser_cover(first.span, end)})
}

parser_effect_body_report: fn(span: Span, type_name: String, method: String) -> Diagnostic Never! {
    diagnostic_from_registry("E0633", Val(span), "this `{method}: fn` body is not an effect fact", "the compiler reads `{method}` without running it, so its body is `true`, `false`, `self == .Case` or an `||` of those, naming cases of `{type_name}`", "write `{{ true }}`, `{{ false }}` or `{{ self == .Write }}`")
}

// `report`, unless the parser is abandoning the item it is in.
parser_add_report: fn(state: ^JetParserState, report: ^^Diagnostic) {
    if !parser_aborting(state) -> state.diagnostics.push(report.move())
}

// The report for a second `impl Effect` block of `type_name` at `span`.
parser_effect_repeated_report: fn(span: Span, type_name: String) -> Diagnostic Never! {
    diagnostic_from_registry("E0908", Val(span), "`{type_name}` has a second `impl Effect` block", "a type declares one effect, so its one method shares one block", "move these members into the first `impl Effect` block")
}

// The report for a method of `impl Effect` that is not `irreversible: fn(self)
// -> Bool` or `expert: fn(self) -> Bool`, or None for one of those.
parser_effect_method_problem: fn(method: Func) -> Diagnostic? Never! {
    returns_bool := false
    if method.return_type == .Val(returned) && returned == .Bool -> returns_bool = true
    if method.return_type == .Val(returned) && returned == .Named(returned_name) && returned_name == "Bool" {
        returns_bool = true
    }
    known: method.name == "irreversible" || method.name == "expert"
    shaped: known && method.type_params.len() == 0 && method.params.len() == 1 && method.params[0].name == "self" && method.params[0].convention == AccessConvention.Read && returns_bool && method.declared_effects == None
    if shaped -> return None
    what: if known -> "`{method.name}: fn` doesn't match the `Effect` contract" else -> "`{method.name}` is not a method of `Effect`"
    Val(diagnostic_from_registry("E0907", Val(method.name_span), what, "`impl Effect` has one method, which says whether the effect's work can be rolled back", "write `irreversible: fn(self) -> Bool {{ … }}`"))
}

parser_effect_method_twice_report: fn(span: Span, method: String) -> Diagnostic Never! {
    diagnostic_from_registry("E0105", Val(span), "`{method}: fn` is defined twice in `impl Effect`", "an effect states each of its facts once", "remove one of the definitions")
}

parser_effect_parent_twice_report: fn(span: Span) -> Diagnostic Never! {
    diagnostic_from_registry("E0105", Val(span), "`parent` is given twice in `impl Effect`", "a package effect is a kind of one effect", "remove one `parent: …`")
}

parser_effect_setting_report: fn(span: Span, key: String) -> Diagnostic Never! {
    diagnostic_from_registry("E0907", Val(span), "`{key}` is not a setting of `Effect`", "an `impl Effect` block gives one setting, a package effect's `parent`, beside its `irreversible: fn(self) -> Bool` method", "remove `{key}`, or write `parent: Log` to make this effect a kind of `Log`")
}

// The one expression an `irreversible` body holds, or None.
parser_effect_method_body: fn(method: Func) -> Expr? Never! {
    if method.body.len() == 1 && method.body[0] == .Expr(value) -> return Val(value)
    None
}

// At the type's close the effect names are built (parser_effect_type_decls).
parser_finish_effect_type: fn(state: ^JetParserState, type_name: String, name_span: Span, effect_impl: EffectImpl?, cases: [Variant]) -> EffectImpl? {
    declared: effect_impl ?? return None
    reports := [Diagnostic]{}
    finished: parser_effect_type_decls(type_name, name_span, declared, cases, reports)
    loop report in reports -> parser_add_report(state, report)
    Val(finished)
}

// The effect names a type declares: a struct declares its own name; an enum
// declares each case `T.Case` and its root `T`, which is irreversible when
// any case is. A package effect with a Prelude parent and no `irreversible`
// body is irreversible when its parent is.
parser_effect_type_decls: fn(type_name: String, name_span: Span, effect_impl: EffectImpl, cases: [Variant], reports: ^[Diagnostic]) -> EffectImpl Never! {
    declared := effect_impl
    // A toolchain family under a declared case: its cases are that case's
    // children (EffectVocabulary.jet), and it declares no name of its own.
    nested := String?{None}
    if cases.len() > 0 && declared.parent == .Val(written) {
        if parser_effect_vocabulary_children(written.name, cases) -> nested = Val(written.name) else {
            reports.push(diagnostic_from_registry("E0907", Val(written.span), "the effect family `{type_name}` names a parent", "a package effect that is a kind of another effect is a struct; an enum family's cases are the kinds of the family itself", "remove `parent: {written.name}`, or declare `{type_name}` as a struct with `impl Effect {{ parent: {written.name} }}`"))
            declared.parent = None
        }
    }
    prefix: nested ?? type_name
    names := [String]{}
    loop member in cases {
        unit := false
        if member.payload == .Unit -> unit = true
        if !unit {
            reports.push(diagnostic_from_registry("E0634", Val(member.name_span), "the effect family case `{type_name}.{member.name}` carries a payload", "an effect family's cases are effect names, which a row writes as `-[{prefix}.{member.name}]>`; a name carries no value", "remove the payload from `{member.name}`"))
            next
        }
        names.push(member.name)
    }
    body := declared.irreversible
    if body == .Val(value) && parser_effect_fact_problem(value, names, cases.len() > 0) == .Val(span) {
        reports.push(parser_effect_body_report(span, type_name, "irreversible"))
        body = None
    }
    if declared.expert == .Val(value) {
        if {
            parser_effect_fact_problem(value, names, cases.len() > 0) == .Val(span) -> {
                reports.push(parser_effect_body_report(span, type_name, "expert"))
                declared.expert = None
            }
            !parser_effect_vocabulary_declares(type_name, nested, names) -> {
                reports.push(diagnostic_from_registry("E0907", Val(declared.expert_span ?? name_span), "`expert: fn` is not a method of a package's `Effect`", "only the toolchain's own effects are expert, which only the main package holds by naming them", "remove `expert: fn`"))
                declared.expert = None
            }
        }
    }
    case_decls := [EffectDecl]{}
    any := false
    loop member in cases {
        if !names.contains(member.name) -> next
        irreversible: parser_effect_fact_value(body, Val(member.name))
        if irreversible -> any = true
        case_decls.push(EffectDecl{name: "{prefix}.{member.name}", name_span: member.name_span, irreversible: irreversible, span: member.name_span})
    }
    root := if cases.len() == 0 -> parser_effect_fact_value(body, None) else -> any
    if body == None && nested == None && declared.parent == .Val(written) {
        loop row in EFFECT_VOCABULARY_ROWS {
            if row.name == written.name -> root = row.irreversible
        }
    }
    decls := [EffectDecl]{}
    if nested == None {
        decls.push(EffectDecl{name: type_name, name_span: name_span, irreversible: root, span: name_span})
    }
    loop declaration in case_decls -> decls.push(declaration)
    declared.decls = decls
    declared.irreversible = body
    declared
}

// Whether the toolchain's vocabulary declares each of `cases` as a child of
// the case `parent` (`Meta.Code.Raw` for `parent: Meta.Code`).
parser_effect_vocabulary_children: fn(parent: String, cases: [Variant]) -> Bool Never! {
    loop member in cases {
        if !parser_effect_vocabulary_has("{parent}.{member.name}") -> return false
    }
    true
}

// Whether the toolchain's vocabulary declares the effect `type_name` (or,
// under `nested`, the children) with the cases `names`: the toolchain's own
// declaration, the one place an `expert` fact is written.
parser_effect_vocabulary_declares: fn(type_name: String, nested: String?, names: [String]) -> Bool Never! {
    if nested == None && !parser_effect_vocabulary_has(type_name) -> return false
    prefix: nested ?? type_name
    loop name in names {
        if !parser_effect_vocabulary_has("{prefix}.{name}") -> return false
    }
    true
}

parser_effect_vocabulary_has: fn(name: String) -> Bool Never! {
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name -> return true
    }
    false
}

// An `impl Name.Effect { … }` block written outside `Name`, in the file or
// inline module body that declares `Name`, joins the type once the whole
// file is parsed: the type declares its effect as if its body held the
// block, and a second block is E0908. A block whose type is declared
// elsewhere stays an ordinary impl. The items change in place: each joined
// type gains its effect, its effect names follow it, and its blocks leave.
parser_attach_effect_impls: fn(items: ^[Item], reports: ^[Diagnostic]) Never! {
    pending := [Int]{}
    loop (index, item) in items {
        if item == .Impl(definition) && parser_effect_impl_joins(items, definition) {
            pending.push(index)
        }
    }
    joined := [Int]{}
    groups := [[Item]]{}
    loop index in 0..<items.len() {
        replaced := Item?{None}
        if items[index] == .Struct(definition) {
            attached: parser_joined_effect_impl(definition.name, definition.name_span, definition.effect_impl, [Variant]{}, items, pending, reports)
            if attached != None {
                updated := definition
                updated.effect_impl = attached
                groups.push(parser_type_companions(None, updated.effect_impl))
                replaced = Val(Item.Struct{value: updated})
            }
        }
        if items[index] == .Enum(definition) {
            attached: parser_joined_effect_impl(definition.name, definition.name_span, definition.effect_impl, definition.variants, items, pending, reports)
            if attached != None {
                updated := definition
                updated.effect_impl = attached
                groups.push(parser_type_companions(None, updated.effect_impl))
                replaced = Val(Item.Enum{value: updated})
            }
        }
        if items[index] == .CodeModule(definition) && definition.body == .Val(inner) {
            body := inner
            parser_attach_effect_impls(body, reports)
            updated := definition
            updated.body = Val(body)
            replaced = Val(Item.CodeModule{value: updated})
        }
        item: replaced ?? next
        if item == .Struct(_) || item == .Enum(_) -> joined.push(index)
        items[index] = item
    }
    // From the end, so the indexes still to visit stay put.
    index := items.len()
    loop index > 0 {
        index -= 1
        if pending.contains(index) {
            _ := items.remove(index, .Slot)
            next
        }
        if joined.len() == 0 || joined[joined.len() - 1] != index -> next
        _ := joined.pop()
        group := groups.pop() ?? [Item]{}
        loop {
            companion: group.pop() ?? break
            items.insert(index + 1, companion)
        }
    }
}

// Whether `definition` is an `impl Name.Effect` block of a struct or enum
// `items` declare.
parser_effect_impl_joins: fn(items: [Item], definition: ImplDef) -> Bool Never! {
    trait_name: definition.trait_name ?? return false
    if trait_name != "Effect" || definition.type_params.len() > 0 -> return false
    loop item in items {
        if item == .Struct(declared) && declared.name == definition.type_name -> return true
        if item == .Enum(declared) && declared.name == definition.type_name -> return true
    }
    false
}

// Whether `items`, or an inline module body among them, hold an `impl
// Name.Effect` block that joins its type (parser_attach_effect_impls).
parser_effect_impls_outside: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == .Impl(definition) && parser_effect_impl_joins(items, definition) -> return true
        if item == .CodeModule(definition) && definition.body == .Val(inner) && parser_effect_impls_outside(inner) {
            return true
        }
    }
    false
}

// The effect the outside blocks at `pending` (indexes into `items`) give the
// type `type_name`, with its effect names; None when no block names the type.
// A block beside one the body wrote (`own`), or beside an earlier outside
// block, is E0908.
parser_joined_effect_impl: fn(type_name: String, name_span: Span, own: EffectImpl?, cases: [Variant], items: [Item], pending: [Int], reports: ^[Diagnostic]) -> EffectImpl? Never! {
    found := EffectImpl?{None}
    loop index in pending {
        if items[index] == .Impl(definition) && definition.type_name == type_name {
            if own != None || found != None {
                reports.push(parser_effect_repeated_report(definition.trait_span ?? definition.type_span, type_name))
                next
            }
            found = Val(parser_effect_impl_from(definition, type_name, reports))
        }
    }
    written: found ?? return None
    Val(parser_effect_type_decls(type_name, name_span, written, cases, reports))
}

// An outside `impl Name.Effect` block read as the block a type body holds:
// the methods `irreversible: fn(self) -> Bool` and `expert`, and the setting
// `parent`.
parser_effect_impl_from: fn(definition: ImplDef, type_name: String, reports: ^[Diagnostic]) -> EffectImpl Never! {
    declared := EffectImpl{span: definition.span, irreversible: None, method_span: None, decls: [EffectDecl]{}}
    parent := NamedSpan?{None}
    loop assoc in definition.assoc_type_impls {
        reports.push(parser_effect_setting_report(assoc.span, assoc.name))
    }
    loop constant in definition.constants {
        if constant.name != "parent" {
            reports.push(parser_effect_setting_report(constant.name_span, constant.name))
            next
        }
        value_span: expr_span(constant.value)
        if parent != None {
            reports.push(parser_effect_parent_twice_report(value_span))
            next
        }
        name: parser_effect_parent_name(constant.value) ?? {
            reports.push(diagnostic_from_registry("E0907", Val(value_span), "`parent` names no effect", "a package effect's `parent` is the effect it is a kind of, written as a name like `Log` or `Log.Audit`", "write `parent: Log` to make this effect a kind of `Log`"))
            next
        }
        parent = Val(NamedSpan{name: name, span: value_span})
    }
    loop method in definition.methods {
        parser_effect_method_take(declared, method, type_name, reports)
    }
    declared.parent = parent
    declared
}

// The dotted name `Log` or `Log.Audit` a `parent:` value spells, or None.
parser_effect_parent_name: fn(value: Expr) -> String? Never! {
    if value == .Ident(name, _, _) -> return Val(name)
    if value == .Field(base, member, _, _) {
        head: parser_effect_parent_name(base) ?? return None
        return Val("{head}.{member}")
    }
    None
}

// A written body's value for one case; no body says the effect's work can be
// rolled back.
parser_effect_fact_value: fn(body: Expr?, member: String?) -> Bool Never! {
    value: body ?? return false
    parser_effect_fact_holds(value, member)
}

// The first part of an `irreversible` body outside the effect fact form, or
// None when the whole body is `true`, `false`, `self == .Case` (a case of
// this enum) or an `||` of those.
parser_effect_fact_problem: fn(expr: Expr, cases: [String], family: Bool) -> Span? Never! {
    if expr == {
        .Bool(_, _, _) -> return None
        .Paren(value, _, _) -> return parser_effect_fact_problem(value, cases, family)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or {
                if parser_effect_fact_problem(left, cases, family) == .Val(span) -> return Val(span)
                return parser_effect_fact_problem(right, cases, family)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    named: parser_effect_fact_case(expr) ?? return Val(expr_span(expr))
    if !family || !cases.contains(named) -> return Val(expr_span(expr))
    None
}

// The case `self == .Case` names; the parser reads that comparison as a
// pattern test of `self` against the case.
parser_effect_fact_case: fn(expr: Expr) -> String? Never! {
    if expr == .PatternTest(subject, pattern, _, _) && pattern == .Variant(variant, bindings, leading_dot, _) && leading_dot && bindings.len() == 0 && !variant.contains(".") {
        if subject == .Ident(name, _, _) && name == "self" -> return Val(variant)
    }
    None
}

// The body's value for one case (None for a struct); the body has passed
// parser_effect_fact_problem.
parser_effect_fact_holds: fn(expr: Expr, member: String?) -> Bool Never! {
    if expr == {
        .Bool(value, _, _) -> return value
        .Paren(value, _, _) -> return parser_effect_fact_holds(value, member)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or {
                return parser_effect_fact_holds(left, member) || parser_effect_fact_holds(right, member)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    named: parser_effect_fact_case(expr) ?? return false
    if member == .Val(case_name) -> return case_name == named
    false
}
