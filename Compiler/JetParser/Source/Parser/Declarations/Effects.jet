// Effect types (a struct's or enum's `impl Effect { … }` block) and the
// `Root.Leaf: effect` package leaf declaration.
use {
    jet_foundation.[
        AccessConvention,
        BinOp,
        EFFECT_VOCABULARY_ROWS,
        EffectDecl,
        EffectImpl,
        Expr,
        Item,
        MarkerDecl,
        NamedSpan,
        Span,
        Variant,
        expr_span,
    ]
    jet_lexer.[
        TOKEN_COLON,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_IDENT,
        TOKEN_LBRACE,
        TOKEN_RBRACE,
    ]
}

// What a struct or enum declares beside itself: its marker, then its effect
// names.
parser_type_companions: fn(marker: MarkerDecl?, effect_impl: EffectImpl?) -> [Item] Never! {
    items := [Item]{}
    if marker == .Val(declaration) -> items.push(Item.MarkerDecl{value: declaration})
    if effect_impl == .Val(declared) {
        loop declaration in declared.decls -> items.push(Item.EffectDecl{value: declaration})
    }
    items
}

// `impl Effect { … }` in a struct or enum body: empty, the one method
// `irreversible: fn(self) -> Bool { … }` whose body is `true`, `false`,
// `self == .Case` or an `||` of those, and a package effect's one setting
// `parent: Name`. The effect names are built when the type closes
// (parser_finish_effect_type), once an enum's cases are known. A `repeated`
// block is reported and parsed for recovery; it yields None so the type
// keeps its first block.
parser_parse_effect_impl: fn(state: &JetParserState, type_name: String, repeated: Bool) -> EffectImpl? {
    start: parser_bump(state)
    if repeated -> parser_add_error_code(state, "E0908", start.span, "`{type_name}` has a second `impl Effect` block", "a type declares one effect, so its one method shares one block", "move these members into the first `impl Effect` block")
    parser_bump(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `impl Effect` body")
    irreversible := Expr?{None}
    method_span := Span?{None}
    parent := NamedSpan?{None}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        token: parser_current(state)
        if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON && !parser_method_starts_here(state) {
            written: parser_parse_effect_setting(state) ?? next
            if parent != None {
                parser_add_error_code(state, "E0105", written.span, "`parent` is given twice in `impl Effect`", "a package effect is a kind of one effect", "remove one `parent: …`")
                next
            }
            parent = Val(written)
            next
        }
        if !parser_method_starts_here(state) {
            found: parser_describe_token(state, token)
            parser_add_error(state, token.span, "expected `irreversible: fn` or `parent:` in `impl Effect`, found {found}", "an `impl Effect` block is empty or holds the method `irreversible: fn(self) -> Bool` and a package effect's `parent: Name`", "write `irreversible: fn(self) -> Bool {{ true }}`, write `parent: Log` for a kind of `Log`, or leave the block empty for an effect a rollback can undo")
            break
        }
        method: parser_parse_type_method(state)
        returns_bool := false
        if method.return_type == .Val(returned) && returned == .Bool -> returns_bool = true
        if method.return_type == .Val(returned) && returned == .Named(returned_name) && returned_name == "Bool" -> returns_bool = true
        shaped: method.name == "irreversible" && method.type_params.len() == 0 && method.params.len() == 1 && method.params[0].name == "self" && method.params[0].convention == AccessConvention.Read && returns_bool && method.declared_effects == None
        if !shaped {
            what: if method.name == "irreversible" -> "`irreversible: fn` doesn't match the `Effect` contract" else -> "`{method.name}` is not a method of `Effect`"
            parser_add_error_code(state, "E0907", method.name_span, what, "`impl Effect` has one method, which says whether the effect's work can be rolled back", "write `irreversible: fn(self) -> Bool {{ … }}`")
            next
        }
        if method_span != None {
            parser_add_error_code(state, "E0105", method.name_span, "`irreversible: fn` is defined twice in `impl Effect`", "an effect says once whether its work can be rolled back", "remove one of the definitions")
            next
        }
        method_span = Val(method.span)
        body := Expr?{None}
        if method.body.len() == 1 && method.body[0] == .Expr(value) -> body = Val(value)
        if body == None {
            parser_report_effect_body(state, method.name_span, type_name)
            next
        }
        irreversible = body
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the `impl Effect` body")
    if repeated -> return None
    Val(EffectImpl{span: start.span, irreversible: irreversible, method_span: method_span, parent: parent, decls: [EffectDecl]{}})
}

// `name: value` in `impl Effect`: the one setting `parent: Name`, a dotted
// name as a row writes it. None, reported, for any other setting.
parser_parse_effect_setting: fn(state: &JetParserState) -> NamedSpan? {
    key_token: parser_bump(state)
    parser_bump(state)
    key: parser_value(state, key_token)
    if key != "parent" {
        _ := parser_parse_expression(state, 1, 0)
        parser_finish_statement(state)
        parser_add_error_code(state, "E0907", key_token.span, "`{key}` is not a setting of `Effect`", "an `impl Effect` block gives one setting, a package effect's `parent`, beside its `irreversible: fn(self) -> Bool` method", "remove `{key}`, or write `parent: Log` to make this effect a kind of `Log`")
        return None
    }
    first: parser_expect_name(state, "for the parent effect after `parent:`")
    name := parser_value(state, first)
    end := first.span
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        segment: parser_expect_name(state, "for an effect path segment after `.`")
        name = "{name}.{parser_value(state, segment)}"
        end = segment.span
    }
    parser_finish_statement(state)
    Val(NamedSpan{name: name, span: parser_cover(first.span, end)})
}

parser_report_effect_body: fn(state: &JetParserState, span: Span, type_name: String) {
    parser_add_error_code(state, "E0633", span, "this `irreversible: fn` body is not an effect fact", "the compiler reads `irreversible` without running it, so its body is `true`, `false`, `self == .Case` or an `||` of those, naming cases of `{type_name}`", "write `{{ true }}`, `{{ false }}` or `{{ self == .Write }}`")
}

// At the type's close the effect names are built: a struct declares its own
// name; an enum declares each case `T.Case` and its root `T`, which is
// irreversible when any case is. A package effect with a Prelude parent and
// no `irreversible` body is irreversible when its parent is.
parser_finish_effect_type: fn(state: &JetParserState, type_name: String, name_span: Span, effect_impl: EffectImpl?, cases: [Variant]) -> EffectImpl? {
    declared := effect_impl ?? return None
    if cases.len() > 0 && declared.parent == .Val(written) {
        parser_add_error_code(state, "E0907", written.span, "the effect family `{type_name}` names a parent", "a package effect that is a kind of another effect is a struct; an enum family's cases are the kinds of the family itself", "remove `parent: {written.name}`, or declare `{type_name}` as a struct with `impl Effect {{ parent: {written.name} }}`")
        declared.parent = None
    }
    names := [String]{}
    loop member in cases {
        unit := false
        if member.payload == .Unit -> unit = true
        if !unit {
            parser_add_error_code(state, "E0634", member.name_span, "the effect family case `{type_name}.{member.name}` carries a payload", "an effect family's cases are effect names, which a row writes as `-[{type_name}.{member.name}]>`; a name carries no value", "remove the payload from `{member.name}`")
            next
        }
        names.push(member.name)
    }
    body := declared.irreversible
    if body == .Val(value) && parser_effect_fact_problem(value, names, cases.len() > 0) == .Val(span) {
        parser_report_effect_body(state, span, type_name)
        body = None
    }
    case_decls := [EffectDecl]{}
    any := false
    loop member in cases {
        if !names.contains(member.name) -> next
        irreversible: parser_effect_fact_value(body, Val(member.name))
        if irreversible -> any = true
        case_decls.push(EffectDecl{name: "{type_name}.{member.name}", name_span: member.name_span, irreversible: irreversible, span: member.name_span})
    }
    root := if cases.len() == 0 -> parser_effect_fact_value(body, None) else -> any
    if body == None && declared.parent == .Val(written) {
        loop row in EFFECT_VOCABULARY_ROWS {
            if row.name == written.name -> root = row.irreversible
        }
    }
    decls := [EffectDecl]{EffectDecl{name: type_name, name_span: name_span, irreversible: root, span: name_span}}
    loop declaration in case_decls -> decls.push(declaration)
    declared.decls = decls
    declared.irreversible = body
    Val(declared)
}

// A written body's value for one case; no body says the effect's work can be
// rolled back.
parser_effect_fact_value: fn(body: Expr?, member: String?) -> Bool Never! {
    value: body ?? return false
    parser_effect_fact_holds(value, member)
}

// The first part of an `irreversible` body outside the effect fact form, or
// None when the whole body is `true`, `false`, `self == .Case` (a case of
// this enum) or an `||` of those.
parser_effect_fact_problem: fn(expr: Expr, cases: [String], family: Bool) -> Span? Never! {
    if expr == {
        .Bool(_, _, _) -> return None
        .Paren(value, _, _) -> return parser_effect_fact_problem(value, cases, family)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or {
                if parser_effect_fact_problem(left, cases, family) == .Val(span) -> return Val(span)
                return parser_effect_fact_problem(right, cases, family)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    named: parser_effect_fact_case(expr) ?? return Val(expr_span(expr))
    if !family || !cases.contains(named) -> return Val(expr_span(expr))
    None
}

// The case `self == .Case` names; the parser reads that comparison as a
// pattern test of `self` against the case.
parser_effect_fact_case: fn(expr: Expr) -> String? Never! {
    if expr == .PatternTest(subject, pattern, _, _) && pattern == .Variant(variant, bindings, leading_dot, _) && leading_dot && bindings.len() == 0 && !variant.contains(".") {
        if subject == .Ident(name, _, _) && name == "self" -> return Val(variant)
    }
    None
}

// The body's value for one case (None for a struct); the body has passed
// parser_effect_fact_problem.
parser_effect_fact_holds: fn(expr: Expr, member: String?) -> Bool Never! {
    if expr == {
        .Bool(value, _, _) -> return value
        .Paren(value, _, _) -> return parser_effect_fact_holds(value, member)
        .Binary(op, left, right, _, _) -> {
            if op == BinOp.Or -> return parser_effect_fact_holds(left, member) || parser_effect_fact_holds(right, member)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    named: parser_effect_fact_case(expr) ?? return false
    if member == .Val(case_name) -> return case_name == named
    false
}

// `Root.Leaf: effect` declares a package leaf. A root effect is a type with an
// `impl Effect { … }` block, and a Prelude effect is already declared.
parser_parse_effect_word: fn(state: &JetParserState) -> EffectDecl? {
    start: parser_bump(state)
    name: parser_effect_path_name(state)
    parser_finish_statement(state)
    head: parser_cover(start.span, name.span)
    if !name.name.contains(".") {
        parser_add_error_code(state, "E0003", head, "`{name.name}: effect` names no effect leaf", "an `effect` line declares a package leaf, `Root.Leaf: effect`; a root effect is a struct or enum with an `impl Effect {{ … }}` block", "write `{name.name}.Leaf: effect`, or declare `{name.name}: struct {{ impl Effect {{}} }}`")
        return None
    }
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name.name {
            parser_add_error_code(state, "E0003", head, "`{name.name}` is already a Prelude effect", "the Prelude declares `{name.name}`, so every program already names it", "delete this line")
            return None
        }
    }
    Val(EffectDecl{name: name.name, name_span: name.span, irreversible: false, span: head})
}

parser_effect_path_name: fn(state: &JetParserState) -> NamedSpan {
    first: parser_expect_name(state, "after the `effect` declaration keyword")
    name := parser_value(state, first)
    end := first.span
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        segment: parser_expect_name(state, "for an effect path segment after `.`")
        name = "{name}.{parser_value(state, segment)}"
        end = segment.span
    }
    NamedSpan{name: name, span: parser_cover(first.span, end)}
}
