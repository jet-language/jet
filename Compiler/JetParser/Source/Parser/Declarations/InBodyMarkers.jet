// Markers written inside a declaration's body as `#X: value` lines. They
// fill the same marker list `#X(args)` above the declaration fills. This file
// reads those lines, joins them to the markers above, and builds the one edit
// that writes a declaration's whole marker set above it or into its body
// (the mixing fix, `jet fix --markers`, and the editor's code actions).
use {
    jet_foundation.[
        CallLabel,
        Expr,
        Func,
        Item,
        Marker,
        MarkerCallArg,
        Span,
        TextEdit,
        TraitImplBlock,
        ast_program,
        diagnostic_from_registry,
        diagnostic_with_alternative_edit,
        diagnostic_with_edit,
        owned_trait_auto_derive_marker,
    ]
    jet_lexer.[
        TOKEN_COLON,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_FALSE,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SEMI,
        TOKEN_TRUE,
        Token,
    ]
}

// One piece of a marker move: the source in [start, end) becomes `text`.
ParserMarkerSplice: struct {
    start: Int
    end: Int
    text: String
}

// `#Name:` or `#lib.Name:` starts a marker line. Nothing else puts `:`
// right after a marker name, so field, variant and statement markers and the
// `#Name` value expression never read as one.
parser_inbody_marker_ahead: fn(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_HASH || parser_kind_at(state, 1) != TOKEN_IDENT -> return false
    offset := 2
    loop parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_IDENT -> offset += 2
    parser_kind_at(state, offset) == TOKEN_COLON
}

parser_inbody_line_ends: fn(state: &JetParserState) -> Bool Never! {
    kind: parser_current_kind(state)
    kind == TOKEN_SEMI || kind == TOKEN_RBRACE || kind == TOKEN_EOF
}

// The token offset past the `#X: value` lines (and the line ends after
// them) that start `offset` tokens ahead, so the value line before a body's
// trailing marker lines is still its last line.
parser_skip_inbody_marker_lines: fn(state: &JetParserState, offset: Int) -> Int Never! {
    at := offset
    loop parser_kind_at(state, at) == TOKEN_HASH && parser_kind_at(state, at + 1) == TOKEN_IDENT {
        name_end := at + 2
        loop parser_kind_at(state, name_end) == TOKEN_DOT && parser_kind_at(state, name_end + 1) == TOKEN_IDENT -> name_end += 2
        if parser_kind_at(state, name_end) != TOKEN_COLON -> return at
        end := name_end + 1
        depth := 0
        loop {
            kind: parser_kind_at(state, end)
            if kind == TOKEN_EOF || (depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_RBRACE)) -> break
            if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
            if (kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE) && depth > 0 -> depth -= 1
            end += 1
        }
        loop parser_kind_at(state, end) == TOKEN_SEMI -> end += 1
        at = end
    }
    at
}

// One `#X: value` line. `true` applies the marker with its defaults,
// `false` is the signed `#!X`, `(…)` holds the arguments exactly as `#X(…)`
// does, and one name path, string or number is the one argument. None when
// the value needs parentheses; that is reported with the edit adding them.
parser_parse_inbody_marker: fn(state: &JetParserState) -> Marker? {
    hash: parser_bump(state)
    name: parser_expect_marker_path(state, "after `#` in a marker line")
    parser_expect(state, TOKEN_COLON, "`:` after the marker name")
    marker_name: parser_value(state, name)
    value: parser_current(state)
    negated := false
    args := [MarkerCallArg]{}
    labels := [CallLabel?]{}
    if value.kind == TOKEN_TRUE {
        parser_bump(state)
    } else if value.kind == TOKEN_FALSE {
        parser_bump(state)
        negated = true
        if !owned_trait_auto_derive_marker(marker_name) {
            parser_add_fatal_code(state, "E0931", parser_cover(hash.span, value.span), "`#{marker_name}: false` is not a signed auto-derive trait", "`false` rejects compiler generation only for structurally auto-derived traits", "write `#{marker_name}: true`, or use `false` with an auto-derived trait")
        }
    } else if value.kind == TOKEN_LPAREN {
        parsed: parser_parse_marker_args(state, false)
        args = parsed.args
        labels = parsed.labels
    } else {
        argument: parser_parse_inbody_marker_value(state, value) ?? return None
        args.push(MarkerCallArg.Expr{value: argument})
        labels.push(None)
    }
    if !parser_inbody_line_ends(state) && !parser_aborting(state) {
        parser_report_inbody_parentheses(state, value.span.start)
        return None
    }
    end: parser_lookahead(state, -1)
    Val(Marker{name: marker_name, negated: negated, name_span: name.span, args: args, arg_labels: labels, span: parser_cover(hash.span, end.span), ct: None, inside: true})
}

// The one bare argument of a marker line; a longer value is rewound and
// reported.
parser_parse_inbody_marker_value: fn(state: &JetParserState, first: Token) -> Expr? {
    position: state.position
    diagnostics: state.diagnostics.len()
    blocks: state.block_spans.len()
    else_arms: state.else_arms.len()
    parsed: parser_parse_expression(state, 1, 2)
    if parser_marker_simple_value(parsed.expr) && parser_inbody_line_ends(state) && !parser_error_since(state, diagnostics) -> return Val(parsed.expr)
    parser_rewind(state, position, diagnostics, blocks, else_arms)
    parser_report_inbody_parentheses(state, first.span.start)
    None
}

// Skip to the end of a marker line whose value starts at `value_start` and
// report that it needs parentheses, with the edit that adds them.
parser_report_inbody_parentheses: fn(state: &JetParserState, value_start: Int) {
    depth := 0
    end := parser_prev_token_end(state)
    if end < value_start -> end = value_start
    loop parser_current_kind(state) != TOKEN_EOF {
        kind: parser_current_kind(state)
        if depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_RBRACE) -> break
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if (kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE) && depth > 0 -> depth -= 1
        end = parser_bump(state).span.end
    }
    span: Span{start: value_start, end: end}
    written: parser_source_slice(state, value_start, end)
    what: "this marker line's value needs parentheses"
    why: "a marker line's value is `true`, `false`, one name, string or number, or the arguments `#X(…)` would hold, in parentheses"
    if written == "" {
        parser_add_error_code(state, "E0943", span, what, why, "write the value in parentheses")
        return
    }
    parser_add_error_code_edit(state, "E0943", span, what, why, "write `({written})`", TextEdit{span: span, new_text: "({written})"})
}

// A value a marker line writes without parentheses: a name path, a string or
// a number. A Bool is not one, since `true` alone means "no arguments".
parser_marker_simple_value: fn(value: Expr) -> Bool Never! {
    if value == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) -> parser_marker_name_path(base)
        .EnumLit(_, _, _, enum_args, leading_dot, _, _) -> enum_args.len() == 0 && !leading_dot
        .Str(_, _, _) -> true
        .Int(_, _, _, _, _) -> true
        .Float(_, _, _, _, _) -> true
        .UnitLit(_, _, _, _, _, _, _) -> true
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

parser_marker_name_path: fn(value: Expr) -> Bool Never! {
    if value == {
        .Ident(_, _, _) -> true
        .Field(base, _, _, _) -> parser_marker_name_path(base)
        .EnumLit(_, _, _, enum_args, leading_dot, _, _) -> enum_args.len() == 0 && !leading_dot
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// A marker whose one unlabeled argument is written bare on its line.
parser_marker_has_simple_value: fn(marker: Marker) -> Bool Never! {
    if marker.args.len() != 1 -> return false
    if marker.arg_labels.len() > 0 {
        if marker.arg_labels[0] != None -> return false
    }
    if marker.args[0] == .Expr(value) -> return parser_marker_simple_value(value)
    false
}

// One declaration's marker list: the markers above it, then its marker lines.
// Writing both is E0942, whose edits move the whole set above (primary) or
// into the body. `head` is where the declaration's text starts and `close`
// the offset of its body's `}`.
parser_merge_inbody_markers: fn(state: &JetParserState, above: [Marker], inside: [Marker], head: Int, close: Int, noun: String) -> [Marker] {
    if inside.len() == 0 -> return above.copy()
    merged := above.copy()
    loop marker in inside -> merged.push(marker.copy())
    if above.len() == 0 || parser_aborting(state) -> return merged
    diagnostic: diagnostic_from_registry("E0942", Val(inside[0].span), "{noun} writes markers both above it and inside its body", "a declaration's markers are one set, written in one place, so a reader finds all of them together", "move every marker above {noun}, or every marker into its body as `#X: value` lines")
    upward: parser_marker_move_edit(state.sources[0], merged, head, close, false, false) ?? {
        state.diagnostics.push(diagnostic)
        return merged
    }
    downward: parser_marker_move_edit(state.sources[0], merged, head, close, true, false) ?? {
        state.diagnostics.push(diagnostic_with_edit(diagnostic, upward))
        return merged
    }
    state.diagnostics.push(diagnostic_with_alternative_edit(diagnostic_with_edit(diagnostic, upward), downward))
    merged
}

// The text of one marker after its `#`, as `jet fmt` prints it above a
// declaration.
parser_marker_above_text: fn(marker: Marker) -> String {
    f := jfmt_new(ast_program(), "", [Token]{}, false)
    jfmt_fmt_marker(f, marker)
    jfmt_out_text(f)
}

// One marker as a body line, as `jet fmt` prints it.
parser_marker_inside_text: fn(marker: Marker) -> String {
    f := jfmt_new(ast_program(), "", [Token]{}, false)
    jfmt_fmt_inbody_marker(f, marker)
    jfmt_out_text(f)
}

// The lines of a marker set above a declaration: one bare marker per line
// while every marker names the same rule, else one `#[A, B]` list.
parser_marker_above_lines: fn(markers: [Marker]) -> [String] {
    distinct := [String]{}
    loop marker in markers {
        if !distinct.contains(marker.name) -> distinct.push(marker.name)
    }
    texts := [String]{}
    loop marker in markers -> texts.push(parser_marker_above_text(marker))
    if distinct.len() > 1 {
        joined: texts.join(", ")
        return [String]{"#[{joined}]"}
    }
    lines := [String]{}
    loop text in texts -> lines.push("#{text}")
    lines
}

parser_marker_byte: fn(source: [U8], index: Int) -> Int Never! {
    if index < 0 || index >= source.len() -> return -1
    Int.from_u8(source[index])
}

parser_marker_line_start: fn(source: [U8], offset: Int) -> Int Never! {
    start := offset
    loop start > 0 && parser_marker_byte(source, start - 1) != 10 -> start -= 1
    start
}

// The spaces and tabs that start the line holding `offset`.
parser_marker_line_indent: fn(source: [U8], offset: Int) -> String Never! {
    start: parser_marker_line_start(source, offset)
    end := start
    loop end < offset && (parser_marker_byte(source, end) == 32 || parser_marker_byte(source, end) == 9) -> end += 1
    String.from_bytes(source.slice(start, end)) ?? ""
}

// The source of the markers written above a declaration, from the first `#`
// through the last marker or closing `]`.
parser_marker_above_region: fn(source: [U8], above: [Marker]) -> Span Never! {
    start := above[0].span.start
    if parser_marker_byte(source, start) != 35 {
        loop parser_marker_byte(source, start - 1) == 32 || parser_marker_byte(source, start - 1) == 9 -> start -= 1
        if parser_marker_byte(source, start - 1) == 91 -> start -= 1
        loop parser_marker_byte(source, start - 1) == 32 || parser_marker_byte(source, start - 1) == 9 -> start -= 1
        if parser_marker_byte(source, start - 1) == 35 -> start -= 1
    }
    end := above[above.len() - 1].span.end
    probe := end
    loop parser_marker_byte(source, probe) == 32 || parser_marker_byte(source, probe) == 9 -> probe += 1
    if parser_marker_byte(source, probe) == 93 -> end = probe + 1
    Span{start: start, end: end}
}

// The cut that removes one marker line: the whole line when the marker is
// alone on it, else the marker and the blanks after it.
parser_marker_line_cut: fn(source: [U8], span: Span) -> ParserMarkerSplice Never! {
    line: parser_marker_line_start(source, span.start)
    before := line
    loop before < span.start && (parser_marker_byte(source, before) == 32 || parser_marker_byte(source, before) == 9) -> before += 1
    after := span.end
    loop parser_marker_byte(source, after) == 32 || parser_marker_byte(source, after) == 9 -> after += 1
    if before == span.start && parser_marker_byte(source, after) == 10 -> return ParserMarkerSplice{start: line, end: after + 1, text: ""}
    ParserMarkerSplice{start: span.start, end: after, text: ""}
}

// The edit that writes every marker of one declaration in one place: above
// it (`inside` false) or as `#X: value` lines, in source order, before the
// body's closing `}` at `close`. `head` is where the declaration's text
// starts; markers moved there go on the same line when `same_line` (a
// module's, since a lone `#Policy(…)` line is the file's policy). None when
// the set already sits there or `close` is not a `}`.
parser_marker_move_edit: fn(source: [U8], markers: [Marker], head: Int, close: Int, inside: Bool, same_line: Bool) -> TextEdit? {
    if markers.len() == 0 || parser_marker_byte(source, close) != 125 -> return None
    placed := true
    loop marker in markers {
        if marker.inside != inside -> placed = false
    }
    if placed -> return None
    above := [Marker]{}
    within := [Marker]{}
    loop marker in markers {
        if marker.inside {
            within.push(marker.copy())
        } else {
            above.push(marker.copy())
        }
    }
    ordered := above.copy()
    loop marker in within -> ordered.push(marker)
    region := Span{start: head, end: head}
    if above.len() > 0 -> region = parser_marker_above_region(source, above)
    indent: parser_marker_line_indent(source, region.start)
    splices := [ParserMarkerSplice]{}
    if inside {
        if above.len() > 0 {
            end := region.end
            loop parser_marker_byte(source, end) == 32 || parser_marker_byte(source, end) == 9 || parser_marker_byte(source, end) == 10 || parser_marker_byte(source, end) == 13 -> end += 1
            splices.push(ParserMarkerSplice{start: region.start, end: end, text: ""})
        }
    } else {
        lines: parser_marker_above_lines(ordered)
        joined: lines.join("\n{indent}")
        if above.len() > 0 {
            splices.push(ParserMarkerSplice{start: region.start, end: region.end, text: joined})
        } else if same_line {
            splices.push(ParserMarkerSplice{start: head, end: head, text: "{lines.join(" ")} "})
        } else {
            splices.push(ParserMarkerSplice{start: head, end: head, text: "{joined}\n{indent}"})
        }
    }
    loop marker in within -> splices.push(parser_marker_line_cut(source, marker.span))
    if inside {
        text := ""
        loop marker in ordered -> text = "{text}{indent}    {parser_marker_inside_text(marker)}\n"
        brace_line: parser_marker_line_start(source, close)
        blank := true
        loop offset in brace_line..<close {
            byte: parser_marker_byte(source, offset)
            if byte != 32 && byte != 9 -> blank = false
        }
        if blank {
            splices.push(ParserMarkerSplice{start: brace_line, end: brace_line, text: text})
        } else {
            splices.push(ParserMarkerSplice{start: close, end: close, text: "\n{text}{indent}"})
        }
    }
    parser_marker_apply_splices(source, splices)
}

// Join `splices` (each cut or insertion over the original text) into one edit
// over the span they cover. Splices are applied in start order; at one offset
// a cut applies before an insertion.
parser_marker_apply_splices: fn(source: [U8], splices: [ParserMarkerSplice]) -> TextEdit? {
    if splices.len() == 0 -> return None
    ordered := splices.copy()
    loop index in 1..<ordered.len() {
        at := index
        loop at > 0 && ordered[at - 1].start > ordered[at].start {
            moved: ordered[at - 1]
            ordered[at - 1] = ordered[at]
            ordered[at] = moved
            at -= 1
        }
    }
    low: ordered[0].start
    high := low
    loop splice in ordered {
        if splice.end > high -> high = splice.end
    }
    text := ""
    position := low
    loop splice in ordered {
        if splice.start > position {
            between: String.from_bytes(source.slice(position, splice.start)) ?? return None
            text = "{text}{between}"
            position = splice.start
        }
        text = "{text}{splice.text}"
        if splice.end > position -> position = splice.end
    }
    if high > position {
        rest: String.from_bytes(source.slice(position, high)) ?? return None
        text = "{text}{rest}"
    }
    Val(TextEdit{span: Span{start: low, end: high}, new_text: text})
}

// `jet fix --markers inside|above`: for every declaration, the edit that
// writes its whole marker set in that place. A nested declaration's edit
// overlaps its parent's, so the caller applies them in rounds, reparsing in
// between. A function whose markers shape how its body is read (`#FFI`,
// `#Import(c)`) keeps them above.
parser_marker_placement_edits: fn(source: [U8], inside: Bool) -> [TextEdit] {
    parser_marker_placements(source, inside, -1)
}

// The editor's code action: the same edit for the innermost declaration
// whose text or markers hold byte `offset`.
parser_marker_placement_edit_at: fn(source: [U8], offset: Int, inside: Bool) -> TextEdit? {
    found := TextEdit?{None}
    loop edit in parser_marker_placements(source, inside, offset) {
        if found == .Val(best) {
            if edit.span.end - edit.span.start >= best.span.end - best.span.start -> next
        }
        found = Val(edit)
    }
    found
}

// Every declaration's edit, or with `at >= 0` only those around byte `at`.
parser_marker_placements: fn(source: [U8], inside: Bool, at: Int) -> [TextEdit] {
    parsed: parse_source(source)
    edits := [TextEdit]{}
    loop item in parsed.program.items -> parser_marker_item_placement(source, item, inside, at, edits)
    edits
}

parser_marker_item_placement: fn(source: [U8], item: Item, inside: Bool, at: Int, edits: &[TextEdit]) {
    if item == {
        .Func(function) -> parser_marker_function_placement(source, function, inside, at, edits)
        .Struct(definition) -> {
            parser_marker_place(source, definition.type_markers, definition.span, inside, false, at, edits)
            loop method in definition.methods -> parser_marker_function_placement(source, method, inside, at, edits)
            loop block in definition.trait_impls -> parser_marker_block_placement(source, block, inside, at, edits)
        }
        .Enum(definition) -> {
            parser_marker_place(source, definition.type_markers, definition.span, inside, false, at, edits)
            loop method in definition.methods -> parser_marker_function_placement(source, method, inside, at, edits)
            loop block in definition.trait_impls -> parser_marker_block_placement(source, block, inside, at, edits)
        }
        .Trait(definition) -> parser_marker_place(source, definition.markers, definition.span, inside, false, at, edits)
        .Impl(implementation) -> {
            parser_marker_place(source, implementation.markers, implementation.span, inside, false, at, edits)
            loop method in implementation.methods -> parser_marker_function_placement(source, method, inside, at, edits)
        }
        .CodeModule(code_module) -> {
            parser_marker_place(source, code_module.markers, code_module.span, inside, true, at, edits)
            if code_module.body == .Val(body) {
                loop nested in body -> parser_marker_item_placement(source, nested, inside, at, edits)
            }
        }
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

parser_marker_function_placement: fn(source: [U8], function: Func, inside: Bool, at: Int, edits: &[TextEdit]) {
    if inside {
        loop marker in function.markers {
            if parser_marker_shapes_body(marker) -> return
        }
    }
    parser_marker_place(source, function.markers, function.span, inside, false, at, edits)
}

parser_marker_block_placement: fn(source: [U8], block: TraitImplBlock, inside: Bool, at: Int, edits: &[TextEdit]) {
    span: block.span ?? return
    parser_marker_place(source, block.markers, span, inside, false, at, edits)
    loop method in block.methods -> parser_marker_function_placement(source, method, inside, at, edits)
}

// One declaration spanning `span`, whose body closes at its last byte. Its
// text starts at the first non-blank byte of the line `span` starts on, so
// a visibility word before the keyword stays after the markers.
parser_marker_place: fn(source: [U8], markers: [Marker], span: Span, inside: Bool, same_line: Bool, at: Int, edits: &[TextEdit]) {
    if markers.len() == 0 || span.end <= span.start -> return
    head := parser_marker_line_start(source, span.start)
    loop head < span.start && (parser_marker_byte(source, head) == 32 || parser_marker_byte(source, head) == 9) -> head += 1
    edit: parser_marker_move_edit(source, markers, head, span.end - 1, inside, same_line) ?? return
    low: if edit.span.start < head -> edit.span.start else -> head
    if at >= 0 && (at < low || at >= span.end) -> return
    edits.push(edit)
}
