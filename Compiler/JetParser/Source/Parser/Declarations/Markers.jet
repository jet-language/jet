// Marker types (a struct's `impl Marker { … }` block), fact planes (a
// field-less struct's `impl Fact { … }` block) and bracketed marker groups.
// A marker's settings are the constants of the Core `Marker` trait
// (Core/Prelude/Prelude.jet): the block is also the struct's `impl Marker`,
// whose constants sema checks against the trait.
use {
    jet_foundation.[
        AccessConvention,
        CallLabel,
        DeriveBodyItem,
        EffectRowEntry,
        Expr,
        FactDecl,
        Func,
        ImplConstValue,
        Item,
        ItemTemplateLoop,
        Marker,
        MarkerCallArg,
        MarkerDecl,
        MarkerDeclParam,
        MarkerHook,
        NamedType,
        STATE_ARROW_LABEL,
        Span,
        StructDef,
        TextEdit,
        TraitImplBlock,
        Type,
        diagnostic_from_registry,
        diagnostic_with_structured_edit,
        owned_trait_auto_derive_marker,
    ]
    jet_lexer.[
        TOKEN_BANG,
        TOKEN_COLON,
        TOKEN_COMMA,
        TOKEN_DOT_DOT_DOT,
        TOKEN_EOF,
        TOKEN_GT,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_KW_ELSE,
        TOKEN_KW_ENUM,
        TOKEN_KW_FN,
        TOKEN_KW_IF,
        TOKEN_KW_IMPL,
        TOKEN_KW_IN,
        TOKEN_KW_LOOP,
        TOKEN_KW_PRIV,
        TOKEN_KW_PUB,
        TOKEN_KW_STRUCT,
        TOKEN_KW_TAG,
        TOKEN_KW_USE,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_MINUS,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_UNIFIED_ARROW,
        Token,
    ]
}

ParsedMarkerArgs: struct {
    args: [MarkerCallArg]
    labels: [CallLabel?]
    required: [Int]{[Int]{}}
}

ParsedMarkerGroup: struct {
    markers: [Marker]
    span: Span
}

parser_marker_expression: fn(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() -> return None
    if marker.args[index] == {
        .Expr(value) -> Val(value)
        .EffectRow(_, _) -> None
    }
}

parser_marker_label: fn(marker: Marker, index: Int) -> String Never! {
    if index < 0 || index >= marker.arg_labels.len() -> return ""
    label: marker.arg_labels[index]
    if label == {
        .Val(value) -> value.name
        .None -> ""
    }
}

// `impl Marker { … }` in a struct body: the marker's settings as
// `name: value`, a fixed `group: #[…]`, and the
// `expand: fn(self, target: Target)` template. The struct's fields join as
// the marker's parameters when the struct closes (parser_finish_marker_struct).
// A marker that is not a group implements `Marker`: its settings are the
// constants of that impl, which sema checks against the trait (E0933-E0937).
parser_parse_marker_impl: fn(state: &JetParserState, value: &StructDef) {
    start: parser_bump(state)
    repeated: value.marker != None
    if repeated -> parser_add_error_code(state, "E0908", start.span, "`{value.name}` has a second `impl Marker` block", "a struct declares one marker, so its settings, group and template share one block", "move these members into the first `impl Marker` block")
    trait_token: parser_bump(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `impl Marker` body")
    declaration := MarkerDecl{name: value.name, name_span: value.name_span, is_pub: value.is_pub, is_package_pub: value.is_package_pub, params: [MarkerDeclParam]{}, body: None, span: value.name_span}
    constants := [ImplConstValue]{}
    expand_span := Span?{None}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        token: parser_current(state)
        if token.kind == TOKEN_IDENT && parser_kind_at(state, 1) == TOKEN_COLON {
            parser_parse_marker_setting(state, declaration, constants)
            next
        }
        if token.kind == TOKEN_KW_FN {
            span: parser_parse_marker_expand(state, declaration)
            if expand_span == None -> expand_span = Val(span)
            next
        }
        found: parser_describe_token(state, token)
        parser_add_error(state, token.span, "expected a marker setting or `expand: fn`, found {found}", "an `impl Marker` block holds `name: value` settings, a `group: #[…]` and the `expand: fn(self, target: Target)` template", "write a setting such as `sites: [.Function]`, or `expand: fn(self, target: Target) {{ … }}`")
        break
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the `impl Marker` body")
    if repeated -> return
    value.marker = Val(declaration)
    value.marker_span = Val(start.span)
    value.marker_expand_span = expand_span
    if declaration.group != None -> return
    // The block itself prints as the marker member, so the impl is generated.
    value.trait_impls.push(TraitImplBlock{trait_name: parser_value(state, trait_token), trait_span: trait_token.span, operator_rhs: None, operator_marker: None, methods: [Func]{}, compiler_generated: true, assoc_type_impls: [NamedType]{}, constants: constants})
}

// `name: value` in `impl Marker`: a `Marker` constant, also kept as the
// `$name` fact the marker rules read; the marker's `group: #[…]`; or its
// `companion: [Rule, .Site]`, which names a rule and so is no constant value.
parser_parse_marker_setting: fn(state: &JetParserState, declaration: &MarkerDecl, constants: &[ImplConstValue]) {
    name_token: parser_bump(state)
    parser_bump(state)
    key: parser_value(state, name_token)
    if key == "group" {
        group: parser_parse_marker_group_entries(state, true)
        if declaration.group != None {
            parser_add_error_code(state, "E0937", name_token.span, "the `impl Marker` block gives `group` twice", "a marker has one group", "remove one `group: …`")
            return
        }
        declaration.group = Val(group.markers)
        return
    }
    parsed: parser_parse_expression(state, 1, 0)
    span: parser_cover(name_token.span, parser_lookahead(state, -1).span)
    parser_finish_statement(state)
    fact: "${key}"
    if key != "companion" -> constants.push(ImplConstValue{name: key, name_span: name_token.span, value: parsed.expr, span: span})
    // A setting given twice is reported on the constant (E0937).
    loop earlier in declaration.params {
        if earlier.name == fact -> return
    }
    declaration.params.push(MarkerDeclParam{name: fact, name_span: name_token.span, ty: None, value: Val(parsed.expr), variadic: false})
}

// `expand: fn(self, target: Target) { … }`: the marker's template, which the
// compiler expands with the marked item bound to `target`. A row written
// before the body, `-[Meta.Generate]>` or `-[]>`, narrows the template's.
parser_parse_marker_expand: fn(state: &JetParserState, declaration: &MarkerDecl) -> Span {
    start: parser_bump(state)
    name: parser_expect_name(state, "after `fn` in `impl Marker`")
    method: parser_value(state, name)
    params: parser_parse_param_list(state)
    row := [EffectRowEntry]?{None}
    row_span := Span?{None}
    if parser_current_kind(state) == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_LBRACKET {
        row_start: parser_current(state).span
        row = Val(parser_parse_effect_arrow_row(state))
        row_span = Val(parser_cover(row_start, parser_lookahead(state, -1).span))
    }
    signature: parser_cover(start.span, parser_lookahead(state, -1).span)
    shaped: method == "expand" && params.len() == 2 && params[0].name == "self" && params[0].convention == AccessConvention.Read && params[1].name == "target" && params[1].convention == AccessConvention.Read && params[1].ty == Type.Named{name: "Target"} && parser_current_kind(state) == TOKEN_LBRACE
    if !shaped {
        what: if method == "expand" -> "`expand: fn` doesn't match the `Marker` contract" else -> "`{method}` is not a method of `Marker`"
        parser_add_error_code(state, "E0907", signature, what, "`impl Marker` has one method, the template the compiler expands with the marked item bound to `target`", "write `expand: fn(self, target: Target) {{ … }}`")
        loop parser_current_kind(state) != TOKEN_LBRACE && parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF -> parser_bump(state)
        if parser_current_kind(state) != TOKEN_LBRACE -> return signature
    }
    body: parser_marker_body(state)
    span: parser_cover(start.span, parser_lookahead(state, -1).span)
    if !shaped -> return span
    if declaration.body != None {
        parser_add_error_code(state, "E0105", name.span, "`expand: fn` is defined twice in `impl Marker`", "a marker has one template", "remove one of the definitions")
        return span
    }
    declaration.body = Val(body)
    declaration.row = row
    declaration.row_span = row_span
    span
}

// At the struct's close the fields become the marker's parameters, ahead of
// its settings. A last list field with no default takes the use site's
// remaining arguments one by one.
parser_finish_marker_struct: fn(state: &JetParserState, value: &StructDef) {
    declaration := value.marker ?? return
    settings: declaration.params.len()
    params := [MarkerDeclParam]{}
    loop (index, field) in value.fields {
        if index == value.fields.len() - 1 && field.default == None {
            if field.ty == .List(element) {
                params.push(MarkerDeclParam{name: field.name, name_span: field.name_span, ty: Val(element), value: None, variadic: true})
                next
            }
        }
        params.push(MarkerDeclParam{name: field.name, name_span: field.name_span, ty: Val(field.ty), value: field.default, variadic: false})
    }
    loop setting in declaration.params -> params.push(setting)
    if declaration.group != None && (value.fields.len() > 0 || settings > 0 || declaration.body != None) {
        parser_add_error_code(state, "E0999", value.name_span, "the marker group `{value.name}` has fields, settings or a template", "a group names a fixed marker stack, so a use site passes nothing into it and it expands to its members", "remove everything but `group: #[…]`, or declare a marker without a group")
    }
    declaration.params = params
    declaration.span = value.span
    value.marker = Val(declaration)
}

// `impl Fact { … }` in a struct body: a compiler fact plane's settings as
// `name: value` lines (`holds`, `safe`, `gates`, `name`, `identity`,
// `proved_by`), read in the named form of marker settings. The struct
// declares the plane and no type (parser_finish_fact_struct).
parser_parse_fact_impl: fn(state: &JetParserState, value: &StructDef) {
    start: parser_bump(state)
    repeated: value.fact != None
    if repeated -> parser_add_error_code(state, "E0908", start.span, "`{value.name}` has a second `impl Fact` block", "a struct declares one fact plane, so its settings share one block", "move these settings into the first `impl Fact` block")
    parser_bump(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` to open the `impl Fact` body")
    params := [MarkerDeclParam]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        token: parser_current(state)
        if token.kind != TOKEN_IDENT || parser_kind_at(state, 1) != TOKEN_COLON {
            found: parser_describe_token(state, token)
            parser_add_error(state, token.span, "expected a fact setting, found {found}", "an `impl Fact` block holds only `name: value` settings", "write a setting such as `holds: .Value`")
            break
        }
        name_token: parser_bump(state)
        parser_bump(state)
        parsed: parser_parse_expression(state, 1, 0)
        parser_finish_statement(state)
        params.push(MarkerDeclParam{name: parser_value(state, name_token), name_span: name_token.span, ty: None, value: Val(parsed.expr), variadic: false})
    }
    parser_expect(state, TOKEN_RBRACE, "`}}` to close the `impl Fact` body")
    if repeated -> return
    value.fact = Val(FactDecl{name: value.name, name_span: value.name_span, params: params, span: start.span})
}

// A fact plane is a field-less struct whose one member is its `impl Fact`
// block: the compiler tracks the plane, and no value of it exists. At the
// struct's close the plane takes the struct's span.
parser_finish_fact_struct: fn(state: &JetParserState, value: &StructDef) {
    declaration := value.fact ?? return
    members: value.fields.len() + value.methods.len() + value.trait_impls.len() + value.cli_bindings.len() + value.type_params.len()
    if members > 0 || value.marker != None || value.effect_impl != None || value.state != None || value.validate_span != None {
        parser_add_error(state, value.name_span, "the fact plane `{value.name}` declares more than its `impl Fact` block", "a fact plane is a field-less struct: the compiler tracks it, and no value of it exists", "remove every member but `impl Fact {{ … }}`")
    }
    declaration.span = value.span
    value.fact = Val(declaration)
}

// Rust `derive_body_items`: the body is a template, so nested `#loop`
// statements are template loops and a body-level `#if` selects the
// items of one branch.
parser_marker_body: fn(state: &JetParserState) -> [DeriveBodyItem] {
    parser_expect(state, TOKEN_LBRACE, "`{{` before a marker body")
    state.derive_template_depth += 1
    body := [DeriveBodyItem]{}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
        parser_skip_semicolons(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        if parser_template_loop_ahead(state) {
            body.push(parser_marker_template_loop(state))
            next
        }
        if parser_prep_verb_ahead(state, 0, TOKEN_KW_IF) {
            body.push(parser_marker_template_if(state))
            next
        }
        // Visibility words and declaration markers (`#Codable Name: struct …`) on
        // their own line attach to the member item below.
        if parser_current_kind(state) == TOKEN_KW_PUB || parser_current_kind(state) == TOKEN_KW_PRIV || (parser_current_kind(state) == TOKEN_HASH && !parser_test_ahead(state) && parser_hash_leads_to_item(state)) {
            modifiers: parser_parse_item_modifiers(state, true)
            body.push(DeriveBodyItem.Item{value: parser_marker_body_item(state, modifiers)})
            next
        }
        if {
            parser_current_kind(state) == TOKEN_KW_FN || parser_current_kind(state) == TOKEN_KW_STRUCT || parser_current_kind(state) == TOKEN_KW_ENUM || parser_current_kind(state) == TOKEN_KW_IMPL || parser_current_kind(state) == TOKEN_KW_TAG -> {
                modifiers: ParsedItemModifiers{is_pub: false, is_package_pub: false, is_comptime: false, markers: [Marker]{}, start_span: parser_current(state).span}
                body.push(DeriveBodyItem.Item{value: parser_marker_body_item(state, modifiers)})
            }
            parser_test_ahead(state) -> body.push(DeriveBodyItem.Item{value: parser_parse_test(state, [Marker]{})})
            else -> body.push(DeriveBodyItem.Stmt{value: parser_parse_statement(state)})
        }
    }
    state.derive_template_depth -= 1
    parser_expect(state, TOKEN_RBRACE, "`}}` after a marker body")
    body
}

parser_marker_body_item: fn(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    if parser_current_kind(state) == {
        TOKEN_KW_FN -> {
            parsed: parser_parse_function(state, modifiers, true)
            Item.Func{value: parsed.value}
        }
        TOKEN_KW_STRUCT -> Item.Struct{value: parser_parse_struct(state, modifiers)}
        TOKEN_KW_ENUM -> Item.Enum{value: parser_parse_enum(state, modifiers)}
        TOKEN_KW_IMPL -> parser_parse_impl(state, modifiers)
        TOKEN_KW_TAG -> Item.Tag{value: parser_parse_tag_decl(state, modifiers)}
        else -> {
            parser_add_error_here(state, "expected an item in a marker body", "marker templates contain declarations or statements", "write a function, struct, enum, impl, or statement")
            Item.Const{value: parser_parse_const(state, modifiers)}
        }
    }
}

// A declaration loop is `#loop`, in marker bodies and at the root.
parser_template_loop_ahead: fn(state: &JetParserState) -> Bool Never! {
    parser_prep_verb_ahead(state, 0, TOKEN_KW_LOOP)
}

parser_parse_template_loop: fn(state: &JetParserState) -> ItemTemplateLoop {
    start: parser_bump(state)
    parser_expect(state, TOKEN_KW_LOOP, "after `#` in a declaration loop")
    variable: parser_expect_name(state, "for a declaration loop binding")
    parser_expect(state, TOKEN_KW_IN, "between a declaration loop binding and source")
    // Rust `derive_body_loop`: `expr_no_struct_lit`, so `T.reflect().fields {` opens
    // the loop body instead of a struct literal.
    source: parser_parse_expression_no_struct_lit(state, 0)
    body: parser_marker_body(state)
    end: parser_lookahead(state, -1).span
    ItemTemplateLoop{var: parser_value(state, variable), var_span: variable.span, source: source.expr, body: body.move(), span: parser_cover(start.span, end)}
}

parser_marker_template_loop: fn(state: &JetParserState) -> DeriveBodyItem {
    parsed: parser_parse_template_loop(state)
    DeriveBodyItem.Loop{var: parsed.var, var_span: parsed.var_span, source: parsed.source, body: parsed.body, span: parsed.span}
}

// `#if cond { … } else #if … else { … }` in a template body.
// Each branch is a template body of its own; an `else #if` is an
// `else` holding one more template `if`.
parser_marker_template_if: fn(state: &JetParserState) -> DeriveBodyItem {
    start: parser_bump(state)
    parser_expect(state, TOKEN_KW_IF, "`if` after `#`")
    condition: parser_parse_expression_no_struct_lit(state, 1)
    then_body: parser_marker_body(state)
    else_body := [DeriveBodyItem]?{None}
    if parser_current_kind(state) == TOKEN_KW_ELSE {
        parser_bump(state)
        else_body = Val(if parser_prep_verb_ahead(state, 0, TOKEN_KW_IF) -> [DeriveBodyItem]{parser_marker_template_if(state)} else -> parser_marker_body(state))
    }
    DeriveBodyItem.If{cond: condition.expr, cond_span: condition.span, then_body: then_body.move(), else_body: else_body.move(), span: parser_cover(start.span, parser_lookahead(state, -1).span)}
}

// One `#[A, B(…)]` list. Rust `parse_marker_bracket_group`: every
// entry is read like a bare marker, and a list of one is E0999.
parser_parse_marker_group_list: fn(state: &JetParserState) -> ParsedMarkerGroup {
    parser_parse_marker_group_entries(state, false)
}

parser_parse_marker_group_entries: fn(state: &JetParserState, declaration: Bool) -> ParsedMarkerGroup {
    hash: parser_expect(state, TOKEN_HASH, "before a marker group")
    parser_expect(state, TOKEN_LBRACKET, "`[` after a marker-group sigil")
    markers := [Marker]{}
    loop parser_current_kind(state) != TOKEN_RBRACKET && parser_current_kind(state) != TOKEN_EOF {
        negated := false
        start: parser_current(state).span
        if parser_current_kind(state) == TOKEN_BANG {
            parser_bump(state)
            negated = true
        }
        name: parser_expect_marker_path(state, "for a marker in a marker group")
        if negated && !declaration -> parser_check_signed_marker(state, start.start, name)
        args := ParsedMarkerArgs{args: [MarkerCallArg]{}, labels: [CallLabel?]{}}
        end := name.span
        if parser_current_kind(state) == TOKEN_LPAREN {
            marker_name: parser_value(state, name)
            args = parser_parse_marker_args(state, marker_name)
            if state.position > 0 -> end = parser_lookahead(state, -1).span
        }
        markers.push(Marker{name: parser_value(state, name), negated: negated, name_span: name.span, args: args.args, arg_labels: args.labels, span: parser_cover(start, end), ct: None, required: args.required})
        if parser_current_kind(state) == TOKEN_COMMA {
            parser_bump(state)
            next
        }
        if parser_current_kind(state) != TOKEN_RBRACKET {
            parser_add_error_here(state, "expected `,` between marker-group entries", "marker groups are ordered comma-separated lists", "add a comma or close the marker group")
            break
        }
    }
    close: parser_expect(state, TOKEN_RBRACKET, "`]` after marker-group entries")
    span: parser_cover(hash.span, close.span)
    if declaration && markers.len() < 2 {
        parser_add_error_code(state, "E0999", span, "a named marker group needs at least two members", "a group names a marker stack, not a marker alias or an empty rule", "write the marker directly at its use site, or give the group at least two members")
    } else if markers.len() == 1 -> parser_report_singleton_marker_group(state, span, markers[0])
    // Rust `parse_marker_bracket_group`: a group on its own line still
    // attaches to the declaration below.
    parser_skip_semicolons(state)
    ParsedMarkerGroup{markers: markers, span: span}
}

// `!` refuses only a trait the
// structural auto-derive engine can provide, bare or inside `#[…]`.
parser_check_signed_marker: fn(state: &JetParserState, bang_start: Int, name: Token) {
    marker_name: parser_value(state, name)
    if owned_trait_auto_derive_marker(marker_name) -> return
    parser_add_fatal_code(state, "E0931", Span{start: bang_start, end: name.span.end}, "`!{marker_name}` is not a signed auto-derive trait", "`!` rejects compiler generation only for structurally auto-derived traits", "remove `!` from `#{marker_name}`, or use it with an auto-derived trait")
}

// Rust `marker_call_arg`: a marker argument is an ordinary (optionally
// labeled) call argument or an effect row `-[Effects]>`, which keeps its own
// carrier until sema checks the rule's effect slot. `#State`'s `A -> B` is two
// arguments: B carries STATE_ARROW_LABEL, which no written label can spell.
// `#run { value }` is the argument `value` whose answer is required while
// building; its position joins `required`.
parser_parse_marker_args: fn(state: &JetParserState, marker_name: String) -> ParsedMarkerArgs {
    parser_expect(state, TOKEN_LPAREN, "`(` before marker arguments")
    args := [MarkerCallArg]{}
    labels := [CallLabel?]{}
    required := [Int]{}
    if parser_current_kind(state) != TOKEN_RPAREN {
        loop {
            label := CallLabel?{None}
            label_kind: parser_current_kind(state)
            if (label_kind == TOKEN_IDENT || label_kind == TOKEN_KW_TAG || label_kind == TOKEN_KW_USE) && parser_kind_at(state, 1) == TOKEN_COLON {
                label_token: parser_bump(state)
                parser_bump(state)
                label_name := parser_value(state, label_token)
                if label_token.kind == TOKEN_KW_TAG -> label_name = "tag"
                if label_token.kind == TOKEN_KW_USE -> label_name = "use"
                label = Val(CallLabel{name: label_name, span: label_token.span})
            }
            if parser_current_kind(state) == TOKEN_MINUS && parser_kind_at(state, 1) == TOKEN_LBRACKET {
                start: parser_bump(state)
                parser_bump(state)
                effects: parser_parse_effect_row_entries(state, TOKEN_RBRACKET)
                parser_expect(state, TOKEN_RBRACKET, "`]` to close the effect row")
                close: parser_expect(state, TOKEN_GT, "`>` after the effect row")
                args.push(MarkerCallArg.EffectRow{effects: effects, span: parser_cover(start.span, close.span)})
            } else {
                label = parser_parse_marker_value_arg(state, marker_name, label, args, labels, required)
            }
            labels.push(label)
            if parser_current_kind(state) == TOKEN_RPAREN -> break
            if parser_current_kind(state) != TOKEN_COMMA {
                if parser_unclosed_delimiter(state, "call") -> return ParsedMarkerArgs{args: args, labels: labels, required: required}
                token: parser_current(state)
                parser_add_error(state, token.span, "expected `,` between marker arguments", "marker arguments are comma-separated", "add a comma or close the marker arguments")
                break
            }
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RPAREN -> break
        }
    }
    parser_expect(state, TOKEN_RPAREN, "`)` after marker arguments")
    ParsedMarkerArgs{args: args, labels: labels, required: required}
}

// One marker value argument: `#run { value }`, or an expression, which for
// `#State` may continue as a chain `A -> B -> C`. Returns the label of the
// last argument it pushed.
parser_parse_marker_value_arg: fn(state: &JetParserState, marker_name: String, label: CallLabel?, args: &[MarkerCallArg], labels: &[CallLabel?], required: &[Int]) -> CallLabel? {
    if parser_prep_verb_ahead(state, 0, TOKEN_LBRACE) && parser_text(state, parser_current(state)) == "#run" {
        if parser_parse_marker_required_arg(state, args, marker_name, label) -> required.push(args.len() - 1)
        return label.copy()
    }
    // A marker value is read, never written or taken. A name that reaches the
    // `#State` hook is never a struct literal or a bare `name -> body` lambda.
    at: parser_current(state).span.start
    arrow: parser_marker_name_is_hook(state, marker_name, at, MarkerHook.State)
    argument: if arrow -> parser_parse_expression_no_struct_lit(state, 2) else -> parser_parse_expression(state, 1, 2)
    args.push(MarkerCallArg.Expr{value: argument.expr})
    // A chain `A -> B -> C` keeps every step; the `#State` applicator refuses
    // any shape but one step (E0930).
    if !arrow || label != None -> return label.copy()
    last := label.copy()
    loop parser_current_kind(state) == TOKEN_UNIFIED_ARROW {
        arrow_token: parser_bump(state)
        labels.push(last)
        to: parser_parse_expression_no_struct_lit(state, 2)
        args.push(MarkerCallArg.Expr{value: to.expr})
        last = Val(CallLabel{name: STATE_ARROW_LABEL, span: arrow_token.span})
    }
    last
}

// `#run { value }` as an argument of the marker written `marker`, with
// `label`, pushed onto `args`. True when it is a `#Pre` or `#Post` condition
// (the first unlabeled argument, or the one labeled `condition`), the marker
// value decided while building; any other place, or a block with more than
// its value, is E0391. Like the contract projection (Items.jet), it keys the
// contract markers by their written names.
parser_parse_marker_required_arg: fn(state: &JetParserState, args: &[MarkerCallArg], marker: String, label: CallLabel?) -> Bool {
    slot: if label == .Val(written) -> written.name == "condition" else -> args.len() == 0
    condition: (marker == "Pre" || marker == "Post") && slot
    head: parser_bump(state)
    block: parser_parse_value_block(state, 0, true)
    span: parser_cover(head.span, block.span)
    if condition && block.statements.len() == 0 {
        if block.tail == .Val(tail) {
            args.push(MarkerCallArg.Expr{value: tail})
            return true
        }
    }
    if condition -> parser_add_error_code(state, "E0391", span, "`#run {{ … }}` in a marker holds more than one value", "a `#Pre` or `#Post` condition decided while building is the one value its block ends with", "write `#run {{ condition }}` with one final expression")
    if !condition -> parser_add_error_code(state, "E0391", span, "`#run {{ … }}` is used as a marker value this compiler does not decide while building", "today only a `#Pre` or `#Post` condition is decided while building, for each call", "write `#Pre(#run {{ condition }}, \"message\")` or `#Post(#run {{ condition }}, \"message\")`, or drop `#run`")
    args.push(MarkerCallArg.Expr{value: Expr.Unit{span: span, id: parser_node_id(state)}})
    false
}

// The marker as written after its `#`, for E0999 repair edits; None when the
// parse has no source text.
parser_marker_written_text: fn(state: &JetParserState, marker: Marker) -> String? {
    start := marker.span.start
    end: marker.span.end
    if start < 0 || end > state.sources[0].len() || end <= start -> return None
    if state.sources[0][start] == (U8{35}) -> start += 1
    text: String.from_bytes(state.sources[0].slice(start, end)) ?? return None
    Val(text)
}

parser_report_singleton_marker_group: fn(state: &JetParserState, span: Span, marker: Marker) {
    if parser_aborting(state) -> return
    diagnostic: diagnostic_from_registry("E0999", Val(span), "one marker is written without brackets", "brackets group two or more markers; one marker stays bare", "replace `#[{marker.name}]` with `#{marker.name}`")
    written: parser_marker_written_text(state, marker) ?? {
        state.diagnostics.push(diagnostic)
        return
    }
    state.diagnostics.push(diagnostic_with_structured_edit(diagnostic, TextEdit{span: span, new_text: "#{written}"}))
}

// (Rust `parse_attached_marker_sequence`): two or more
// distinct rules on one target are one ordered `#[A, B]` list. `chunks`
// counts the bare markers and lists written; `span` covers all of them.
parser_report_adjacent_markers: fn(state: &JetParserState, markers: [Marker], chunks: Int, bracket_chunks: Int, span: Span, noun: String) {
    if (chunks == 1 && bracket_chunks == 1) || parser_aborting(state) -> return
    distinct := [String]{}
    loop marker in markers {
        if !distinct.contains(marker.name) -> distinct.push(marker.name)
    }
    if distinct.len() <= 1 -> return
    diagnostic: diagnostic_from_registry("E0999", Val(span), "adjacent {noun} markers belong in one bracket list", "two or more rules attached to one {noun} use one ordered `#[A, B]` group", "replace the adjacent markers with one bracket list")
    rendered := [String]{}
    loop marker in markers {
        text: parser_marker_written_text(state, marker) ?? {
            state.diagnostics.push(diagnostic)
            return
        }
        rendered.push(text)
    }
    joined: rendered.join(", ")
    state.diagnostics.push(diagnostic_with_structured_edit(diagnostic, TextEdit{span: span, new_text: "#[{joined}]"}))
}
