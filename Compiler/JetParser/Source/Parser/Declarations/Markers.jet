// Marker/fact declarations and bracketed marker groups.  The declaration
// parameter list is deliberately shared by marker and fact items so typed
// arguments and fixed `@` facts retain one source shape.

fn parser_marker_expression(marker: Marker, index: Int) -> Expr? {
    if index < 0 || index >= marker.args.len() -> return None
    if marker.args[index] == { .Expr(value) -> Val(value) else -> None }
}

fn parser_marker_label(marker: Marker, index: Int) -> String {
    if index < 0 || index >= marker.arg_labels.len() -> return ""
    label :: marker.arg_labels[index]
    if label == { .Val(value) -> value.name else -> "" }
}

fn parser_marker_decl_ahead(state: &JetParserState) -> Bool {
    parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "marker" && parser_kind_at(&state, 1) == TOKEN_IDENT
}

fn parser_fact_decl_ahead(state: &JetParserState) -> Bool {
    parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "fact" && parser_kind_at(&state, 1) == TOKEN_IDENT
}

fn parser_parse_marker_decl(state: &JetParserState) -> Item {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "for a marker declaration name")
    params :: parser_marker_decl_params(&state)
    body := [DeriveBodyItem]?{None}
    end := parser_lookahead(&state, -1).span
    if parser_current_kind(&state) == TOKEN_LBRACE {
        body = Val(parser_marker_body(&state))
        end = parser_lookahead(&state, -1).span
    }
    if parser_current_kind(&state) == TOKEN_SEMI -> end = parser_bump(&state).span
    Item.MarkerDecl{value: MarkerDecl{name: name.payload.decoded, name_span: name.span, params: params, body: body, span: parser_cover(start.span, end)}}
}

fn parser_parse_fact_decl(state: &JetParserState) -> Item {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "for a fact declaration name")
    params :: parser_marker_decl_params(&state)
    end := parser_lookahead(&state, -1).span
    if parser_current_kind(&state) == TOKEN_SEMI -> end = parser_bump(&state).span
    Item.FactDecl{value: FactDecl{name: name.payload.decoded, name_span: name.span, params: params, span: parser_cover(start.span, end)}}
}

fn parser_marker_decl_params(state: &JetParserState) -> [MarkerDeclParam] {
    parser_expect(&state, TOKEN_LPAREN, "`(` before marker declaration parameters")
    params := [MarkerDeclParam]{}
    loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF {
        marked := false
        name_span := parser_current(&state).span
        name := ""
        if {
            parser_current_kind(&state) == TOKEN_AT -> {
                at :: parser_bump(&state)
                name_token :: parser_expect_name(&state, "after `@` in marker declaration metadata")
                name = "@{name_token.payload.decoded}"
                name_span = parser_cover(at.span, name_token.span)
                marked = true
            }
            else -> {
                name_token :: parser_expect_name(&state, "for a marker declaration parameter")
                name = name_token.payload.decoded
                name_span = name_token.span
            }
        }
        parser_expect(&state, TOKEN_COLON, "between a marker parameter name and its type or value")
        if {
            marked -> {
                value :: parser_parse_expression(&state, 1, 0)
                &params.push(MarkerDeclParam{name: name, name_span: name_span, ty: None, value: Val(value.expr), variadic: false})
            }
            else -> {
                variadic := false
                if parser_current_kind(&state) == TOKEN_DOT_DOT_DOT {
                    parser_bump(&state)
                    variadic = true
                }
                parsed :: parser_parse_type(&state, 0)
                default := Expr?{None}
                if parser_current_kind(&state) == TOKEN_LBRACE {
                    parser_bump(&state)
                    default = Val(parser_parse_expression(&state, 1, 0).expr)
                    parser_expect(&state, TOKEN_RBRACE, "`}}` after a marker parameter default")
                }
                &params.push(MarkerDeclParam{name: name, name_span: name_span, ty: Val(parsed.ty), value: default, variadic: variadic})
            }
        }
        if parser_current_kind(&state) == TOKEN_RPAREN -> break
        if parser_current_kind(&state) != TOKEN_COMMA {
            parser_add_error_here(&state, "expected `,` between marker declaration parameters", "marker parameters are comma-separated", "add a comma or close the parameter list")
            break
        }
        parser_bump(&state)
    }
    parser_expect(&state, TOKEN_RPAREN, "`)` after marker declaration parameters")
    params
}

fn parser_marker_body(state: &JetParserState) -> [DeriveBodyItem] {
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a marker body")
    body := [DeriveBodyItem]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        if parser_template_loop_ahead(&state) {
            &body.push(parser_marker_template_loop(&state))
            next
        }
        if parser_current_kind(&state) == TOKEN_KW_PUB || parser_current_kind(&state) == TOKEN_KW_PRIV {
            modifiers :: parser_parse_item_modifiers(&state)
            &body.push(DeriveBodyItem.Item{value: parser_marker_body_item(&state, modifiers)})
            next
        }
        if {
            parser_current_kind(&state) == TOKEN_KW_FN || parser_current_kind(&state) == TOKEN_KW_STRUCT || parser_current_kind(&state) == TOKEN_KW_ENUM || parser_current_kind(&state) == TOKEN_KW_IMPL || parser_current_kind(&state) == TOKEN_KW_TAG -> {
                modifiers :: ParsedItemModifiers{is_pub: false, is_package_pub: false, is_comptime: false, markers: [Marker]{}, start_span: parser_current(&state).span}
                &body.push(DeriveBodyItem.Item{value: parser_marker_body_item(&state, modifiers)})
            }
            parser_test_ahead(&state) -> &body.push(DeriveBodyItem.Item{value: parser_parse_test(&state)})
            else -> &body.push(DeriveBodyItem.Stmt{value: parser_parse_statement(&state)})
        }
    }
    parser_expect(&state, TOKEN_RBRACE, "`}}` after a marker body")
    body
}

fn parser_marker_body_item(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    if parser_current_kind(&state) == {
        TOKEN_KW_FN -> {
            parsed :: parser_parse_function(&state, modifiers)
            Item.Func{value: parsed.value}
        }
        TOKEN_KW_STRUCT -> Item.Struct{value: parser_parse_struct(&state, modifiers)}
        TOKEN_KW_ENUM -> Item.Enum{value: parser_parse_enum(&state, modifiers)}
        TOKEN_KW_IMPL -> parser_parse_impl(&state)
        TOKEN_KW_TAG -> Item.Tag{value: parser_parse_tag_decl(&state, modifiers)}
        else -> {
            parser_add_error_here(&state, "expected an item in a marker body", "marker templates contain declarations or statements", "write a function, struct, enum, impl, or statement")
            Item.Const{value: parser_parse_const(&state, modifiers)}
        }
    }
}

// D-STRUCT-ONCE1=A / D-PREP-BRANCH1=A: a declaration loop is `prep loop`,
// in marker bodies and at the root. The retired `@loop` head teaches E0388
// and recovers.
fn parser_template_loop_ahead(state: &JetParserState) -> Bool {
    parser_prep_verb_ahead(&state, 0, TOKEN_KW_LOOP) || (parser_current_kind(&state) == TOKEN_AT && parser_kind_at(&state, 1) == TOKEN_KW_LOOP)
}

fn parser_parse_template_loop(state: &JetParserState) -> ItemTemplateLoop {
    start :: parser_take_prep_head(&state, "loop")
    parser_expect(&state, TOKEN_KW_LOOP, "after `prep` in a declaration loop")
    variable :: parser_expect_name(&state, "for a declaration loop binding")
    parser_expect(&state, TOKEN_KW_IN, "between a declaration loop binding and source")
    source :: parser_parse_expression(&state, 1, 0)
    body :: parser_marker_body(&state)
    end :: parser_lookahead(&state, -1).span
    ItemTemplateLoop{var: variable.payload.decoded, var_span: variable.span, source: source.expr, body: body, span: parser_cover(start.span, end)}
}

fn parser_marker_template_loop(state: &JetParserState) -> DeriveBodyItem {
    parsed :: parser_parse_template_loop(&state)
    DeriveBodyItem.Loop{var: parsed.var, var_span: parsed.var_span, source: parsed.source, body: parsed.body, span: parsed.span}
}

fn parser_parse_marker_group(state: &JetParserState) -> [Marker] {
    hash :: parser_expect(&state, TOKEN_HASH, "before a marker group")
    parser_expect(&state, TOKEN_LBRACKET, "`[` after a marker-group sigil")
    markers := [Marker]{}
    loop parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF {
        negated := false
        start :: parser_current(&state).span
        if parser_current_kind(&state) == TOKEN_BANG {
            parser_bump(&state)
            negated = true
        }
        name :: parser_expect_name(&state, "for a marker in a marker group")
        args := [MarkerCallArg]{}
        labels := [CallLabel?]{}
        end := name.span
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parsed :: parser_parse_call_args(&state, 1, true)
            loop arg in parsed {
                &args.push(MarkerCallArg.Expr{value: arg.expr})
                &labels.push(arg.label)
            }
            if state.position > 0 -> end = parser_lookahead(&state, -1).span
        }
        &markers.push(Marker{name: name.payload.decoded, negated: negated, name_span: name.span, args: args, arg_labels: labels, span: parser_cover(start, end), ct: None})
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            next
        }
        if parser_current_kind(&state) != TOKEN_RBRACKET {
            parser_add_error_here(&state, "expected `,` between marker-group entries", "marker groups are ordered comma-separated lists", "add a comma or close the marker group")
            break
        }
    }
    parser_expect(&state, TOKEN_RBRACKET, "`]` after marker-group entries")
    group_end :: parser_lookahead(&state, -1).span
    if markers.len() == 1 -> parser_add_error(&state, parser_cover(hash.span, group_end), "one marker is written without brackets", "brackets group two or more markers", "replace `#[Name]` with `#Name`")
    markers
}
