// A `#Policy(...)` line that ends at its closing parenthesis
// is a file-scoped source policy (Rust `policy_is_file_decl` and
// `policy_declarations_from_marker`). Its arguments become the module's
// policy declarations; a callable policy (`#Policy(retry(3))`) stays a marker
// on the declaration that follows it, and so does a policy naming
// `arithmetic` written directly above a declaration.
use {
    jet_foundation.[
        Marker,
        PolicyDeclaration,
        PolicyScope,
        PolicyValue,
        Program,
        Span,
        Stmt,
        arithmetic_mode_parse,
        marker_registered_site_bound,
        policy_key_parse,
        type_name,
    ]
    jet_lexer.[
        TOKEN_EOF,
        TOKEN_HASH,
        TOKEN_IDENT,
        TOKEN_LPAREN,
        TOKEN_RPAREN,
        TOKEN_SEMI,
    ]
}

parser_policy_file_decl_ahead: fn(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_HASH -> return false
    name: parser_lookahead(state, 1)
    if name.kind != TOKEN_IDENT || parser_value(state, name) != "Policy" -> return false
    if parser_kind_at(state, 2) != TOKEN_LPAREN -> return false
    // A callable policy starts with a policy call.
    if parser_kind_at(state, 3) == TOKEN_IDENT && parser_kind_at(state, 4) == TOKEN_LPAREN -> return false
    offset := 2
    depth := 0
    loop parser_kind_at(state, offset) != TOKEN_EOF {
        kind: parser_kind_at(state, offset)
        if kind == TOKEN_LPAREN -> depth += 1
        if kind == TOKEN_RPAREN {
            depth -= 1
            if depth == 0 {
                after: parser_kind_at(state, offset + 1)
                if after == TOKEN_EOF -> return true
                if after != TOKEN_SEMI -> return false
                // An arithmetic mode has no module rung: on the line just
                // above a declaration, `#Policy(arithmetic: …)` is that
                // declaration's policy. Only a blank line or the end of the
                // file leaves it a module declaration, which E0355 refuses.
                if parser_policy_names_arithmetic(state, offset) && !parser_policy_blank_line_follows(state, offset) -> return false
                return true
            }
        }
        offset += 1
    }
    true
}

// True when an argument of the `#Policy(...)` whose closing parenthesis is at
// lookahead `close` is the `arithmetic` key.
parser_policy_names_arithmetic: fn(state: &JetParserState, close: Int) -> Bool Never! {
    loop offset in 3..<close {
        if parser_kind_at(state, offset) == TOKEN_IDENT && parser_value(state, parser_lookahead(state, offset)) == "arithmetic" -> return true
    }
    false
}

// True when a blank line, or only line breaks up to the end of the file,
// follows the closing parenthesis at lookahead `close`. A comment line is not
// blank. Without the source text the policy stays a module declaration.
parser_policy_blank_line_follows: fn(state: &JetParserState, close: Int) -> Bool Never! {
    next := close + 1
    loop parser_kind_at(state, next) == TOKEN_SEMI {
        next += 1
    }
    if parser_kind_at(state, next) == TOKEN_EOF || state.sources.len() == 0 -> return true
    bytes: state.sources[0]
    start: parser_lookahead(state, close).span.end
    end: parser_lookahead(state, next).span.start
    if start < 0 || end > bytes.len() || end <= start -> return true
    saw_newline := false
    only_space_since_newline := true
    loop index in start..<end {
        byte: Int{bytes[index]}
        if byte == 10 {
            if saw_newline && only_space_since_newline -> return true
            saw_newline = true
            only_space_since_newline = true
        } else if byte != 32 && byte != 9 && byte != 13 && byte != 59 {
            only_space_since_newline = false
        }
    }
    false
}

parser_parse_policy_file_decl: fn(state: &JetParserState, program: &Program) {
    marker: parser_parse_marker(state)
    declarations: parser_policy_declarations_from_marker(state, marker, PolicyScope.Module) ?? {
        parser_sync_top(state)
        return
    }
    loop declaration in declarations -> program.policy_declarations.push(declaration)
}

// `#Policy(...) { … }` scopes its declarations to the block
// (Rust `at_policy_stmt`). Each declaration targets the whole statement.
parser_policy_block_stmt: fn(state: &JetParserState, marker: Marker, body: [Stmt], span: Span) -> Stmt? {
    declarations := parser_policy_declarations_from_marker(state, marker, PolicyScope.Block) ?? return None
    loop index in 0..<declarations.len() -> declarations[index].target = Val(span)
    loop declaration in declarations -> state.block_policy_declarations.push(declaration)
    Val(Stmt.Policy{declarations: declarations, body: body, span: span})
}

// `#Unsafe(reason, obligations: .Track)` selects the gate's per-site
// obligation mode (Rust `at_unsafe_stmt` / `unsafe_obligation_policy`).
// Returns the declaration targeting `target`, or None when the mode is
// absent or `.None`. A package-level mode written at a gate is E3108;
// other argument shapes are left to sema's typed marker-argument check.
parser_unsafe_obligation_policy: fn(state: &JetParserState, marker: Marker, scope: PolicyScope, target: Span) -> PolicyDeclaration? {
    values: parser_marker_bindings(marker, [String]{"reason", "obligations"}) ?? return None
    written: values[1] ?? return None
    if written == .EnumLit(type_name, variant, _, args, _, span, _) {
        if type_name != "" || args.len() > 0 -> return None
        value: if variant == {
            "Track" -> PolicyValue.Track
            "Skip" -> PolicyValue.Skip
            "GateOnly" | "Obligations" | "PerSite" -> {
                parser_add_error_code(state, "E3108", span, "`.{variant}` is not a per-site obligation mode", "a gate tracks typed obligations, skips them when policy permits, or keeps the default", "write `.Track`, `.Skip`, or `.None`")
                return None
            }
            else -> {
                return None
            }
        }
        return Val(PolicyDeclaration{key: PolicyKey.Unsafe, value: value, scope: scope, span: marker.span, target: Val(target), source: "<source>"})
    }
    None
}

// Rust `CallablePolicyChain::parse(..).is_ok()`: every argument is a policy
// call (`retry(3)`) whose own arguments are plain positional values.
parser_callable_policy_marker: fn(marker: Marker) -> Bool Never! {
    loop index in 0..<marker.args.len() {
        expr: parser_marker_expression(marker, index) ?? return false
        if expr == .Call(call, _) {
            loop argument in call.args {
                if argument.label != None || argument.spread -> return false
            }
        } else {
            return false
        }
    }
    true
}

// One declaration per argument, or None after reporting the first refusal.
parser_policy_declarations_from_marker: fn(state: &JetParserState, marker: Marker, scope: PolicyScope) -> [PolicyDeclaration]? {
    out := [PolicyDeclaration]{}
    loop index in 0..<marker.args.len() {
        expr: parser_marker_expression(marker, index) ?? {
            parser_marker_shape_error(state, marker)
            return None
        }
        label: parser_marker_label(marker, index)
        name := label
        name_span := marker.span
        mode := PolicyValue?{None}
        if label == "copies" || label == "writes" || label == "sentries" || label == "arithmetic" {
            variant: if expr == {
                .EnumLit(type_name, written, _, args, _, _, _) -> if type_name == "" && args.len() == 0 -> written else -> ""
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
            }
            mode = if {
                variant == "Explicit" && label == "copies" -> Val(PolicyValue.Explicit)
                variant == "Explicit" && label == "writes" -> Val(PolicyValue.Explicit)
                variant == "On" && label == "sentries" -> Val(PolicyValue.On)
                variant == "Off" && label == "sentries" -> Val(PolicyValue.Off)
                label == "arithmetic" && arithmetic_mode_parse(variant) == .Val(arithmetic) -> Val(PolicyValue.Arithmetic{mode: arithmetic})
                else -> {
                    parser_marker_shape_error(state, marker)
                    return None
                }
            }
            // An arithmetic mode is lexical to one body.
            if label == "arithmetic" && scope == PolicyScope.Module {
                parser_add_error_code(state, "E0355", marker.span, "`arithmetic` is not a module policy", "an arithmetic mode governs one function, method or block body and never crosses a call", "write `#Policy(arithmetic: …)` on the function, method or block")
                return None
            }
        } else {
            if expr == .Ident(written, span, _) {
                name = written
                name_span = span
            } else {
                parser_marker_shape_error(state, marker)
                return None
            }
        }
        key: policy_key_parse(name) ?? {
            // A registered rule outside policy inheritance stays at its own
            // site, so the refusal points there instead of at the policy keys.
            if marker_registered_site_bound(name) {
                parser_add_error_code(state, "E0355", name_span, "`{name}` is not a scoped policy", "authority markers stay attached to the audited operation or declaration; policy scope cannot widen them", "use `#{name}` at its sound site")
            } else {
                parser_add_error_code(state, "E0355", name_span, "`{name}` is not a scoped policy", "the compiler owns the closed policy registry and its scope rules", "use `gc`, `explicit_units`, `copies: .Explicit`, `writes: .Explicit`, `sentries: .Off`, or `arithmetic: .Wrapping`; write memory floors as `!Mem.*` effect denials")
            }
            return None
        }
        value: if key == {
            .Copies -> mode ?? {
                parser_add_error_code(state, "E0355", name_span, "`copies` needs an explicit mode", "read-only views copy at owning destinations by default; the policy only restores explicit-copy syntax", "write `copies: .Explicit`")
                return None
            }
            .Writes -> mode ?? {
                parser_add_error_code(state, "E0355", name_span, "`writes` needs an explicit mode", "calls are written plain by default; the policy requires the `&` and `&&` marks a call's signature implies", "write `writes: .Explicit`")
                return None
            }
            .Sentries -> mode ?? {
                parser_add_error_code(state, "E0355", name_span, "`sentries` needs an explicit mode", "sentry instrumentation is either on or off; it is not a boolean memory fact", "write `sentries: .Off` or `sentries: .On`")
                return None
            }
            .Arithmetic -> mode ?? {
                parser_add_error_code(state, "E0355", name_span, "`arithmetic` needs an explicit mode", "fixed-width arithmetic is checked, wrapping or saturating", "write `arithmetic: .Checked`, `arithmetic: .Wrapping` or `arithmetic: .Saturating`")
                return None
            }
            .ScopedGC | .ExplicitUnits -> PolicyValue.Enabled
            .Unsafe | .Impure | .Nondeterministic | .DependencyGrant | .BuildFlag | .SessionFlag | .TrustGrant | .ForcePin | .TaintScrub | .DutyDrop | .StateTransition | .PrecisionDemotion | .Structure | .LintAllow | .CheckRemoval | .LinkOverride -> {
                parser_add_error_code(state, "E0355", name_span, "`{name}` is not a source policy", "organization and package policy own the audited-escape floor; source code can only write the corresponding marker", "use the audited marker, or `policy: {{ {name}: .Forbid }}` in `package.jet`")
                return None
            }
        }
        out.push(PolicyDeclaration{key: key, value: value, scope: scope, span: marker.span, target: None, source: "<source>"})
    }
    Val(out)
}
