// State declarations and owner-context state sections.
// These identifier-led forms are selected by the declaration dispatcher.
use {
    jet_foundation.[
        Expr,
        ExprField,
        MARKER_STATES,
        Marker,
        NamedSpan,
        Span,
        StateArrow,
        StateDecl,
        StateGroup,
        expr_span,
    ]
    jet_lexer.[
        TOKEN_COLON,
        TOKEN_COMMA,
        TOKEN_DOT,
        TOKEN_EOF,
        TOKEN_IDENT,
        TOKEN_LBRACE,
        TOKEN_PIPE,
        TOKEN_RBRACE,
        TOKEN_SEMI,
        TOKEN_UNIFIED_ARROW,
    ]
}

parser_state_ahead: fn(state: ^JetParserState) -> Bool Never! {
    parser_current_kind(state) == TOKEN_IDENT && parser_value_at(state, 0) == "state" && parser_kind_at(state, 1) == TOKEN_IDENT
}

parser_state_section_ahead: fn(state: ^JetParserState) -> Bool Never! {
    parser_current_kind(state) == TOKEN_IDENT && parser_value_at(state, 0) == "state" && parser_kind_at(state, 1) == TOKEN_LBRACE
}

parser_parse_state_decl: fn(state: ^JetParserState, modifiers: ParsedItemModifiers) -> StateDecl {
    start: parser_bump(state)
    type_name: parser_state_dotted_name(state, "for a state owner type")
    parser_expect(state, TOKEN_LBRACE, "`{{` before state names")
    list: parser_state_list(state)
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after state names")
    StateDecl{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, type_name: type_name.name, type_name_span: type_name.span, states: list.states, arrows: list.arrows, groups: list.groups, span: parser_cover(start.span, close.span)}
}

parser_parse_state_section: fn(state: ^JetParserState, type_name: String, type_name_span: Span) -> StateDecl {
    start: parser_bump(state)
    parser_expect(state, TOKEN_LBRACE, "`{{` before a state section")
    list: parser_state_list(state)
    close: parser_expect(state, TOKEN_RBRACE, "`}}` after a state section")
    StateDecl{is_pub: false, is_package_pub: false, type_name: type_name, type_name_span: type_name_span, states: list.states, arrows: list.arrows, groups: list.groups, span: parser_cover(start.span, close.span)}
}

ParsedStateList: struct {
    states: [NamedSpan],
    arrows: [StateArrow],
    groups: [StateGroup],
}

// The entries of a state list, separated by commas or line ends:
//   `Draft`                       a state
//   `Draft -> Confirmed, Canceled`  a state and its moves
//   `Open: Draft | Confirmed`     a named group of states
// After `->`, commas join the targets until the line ends.
parser_state_list: fn(state: ^JetParserState) -> ParsedStateList {
    ^list: ParsedStateList{states: [NamedSpan]{}, arrows: [StateArrow]{}, groups: [StateGroup]{}}
    loop parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF && !parser_aborting(state) {
        if parser_current_kind(state) == TOKEN_COMMA || parser_current_kind(state) == TOKEN_SEMI {
            parser_bump(state)
            next
        }
        before: state.position
        head: parser_state_name(state, "for a state name")
        if {
            parser_current_kind(state) == TOKEN_COLON -> {
                parser_bump(state)
                ^members: [NamedSpan]{parser_state_name(state, "for a state in a group")}
                loop parser_current_kind(state) == TOKEN_PIPE {
                    parser_bump(state)
                    members.push(parser_state_name(state, "after `|` in a state group"))
                }
                span: parser_cover(head.span, members[members.len() - 1].span)
                list.groups.push(StateGroup{name: head, members: members, span: span})
            }
            else -> {
                ^targets: [NamedSpan]{}
                if parser_current_kind(state) == TOKEN_UNIFIED_ARROW {
                    parser_bump(state)
                    targets.push(parser_state_name(state, "after `->` in a state list"))
                    loop parser_current_kind(state) == TOKEN_COMMA && parser_kind_at(state, 1) == TOKEN_IDENT {
                        parser_bump(state)
                        targets.push(parser_state_name(state, "after `,` in a state's moves"))
                    }
                }
                end: if targets.len() > 0 -> targets[targets.len() - 1].span else -> head.span
                list.arrows.push(StateArrow{from: head.copy(), to: targets, span: parser_cover(head.span, end)})
                list.states.push(head)
            }
        }
        // A token that is no state entry is reported once and skipped.
        if state.position == before -> parser_bump(state)
    }
    list
}

parser_state_name: fn(state: ^JetParserState, context: String) -> NamedSpan {
    name: parser_expect_name(state, context)
    NamedSpan{name: parser_value(state, name), span: name.span}
}

parser_state_dotted_name: fn(state: ^JetParserState, context: String) -> NamedSpan {
    first: parser_expect_name(state, context)
    ^name: parser_value(state, first)
    ^end: first.span
    loop parser_current_kind(state) == TOKEN_DOT {
        parser_bump(state)
        part: parser_expect_name(state, "after `.` in a declaration type name")
        name = "{name}.{parser_value(state, part)}"
        end = part.span
    }
    NamedSpan{name: name, span: parser_cover(first.span, end)}
}

parser_states_record_fields: fn(expr: Expr) -> [ExprField]? Never! {
    if expr == {
        .StructLit(type_name, _, _, _, fields, inferred, _, _) -> if inferred && type_name == "" -> Val(fields) else -> None
        .TypedLit(head, body, _, _) -> if head == None && body == .Empty -> Val([ExprField]{}) else -> None
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

parser_states_member_name: fn(expr: Expr) -> NamedSpan? Never! {
    if expr == {
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, _) -> {
            if leading_dot && type_name == "" && args.len() == 0 {
                return Val(NamedSpan{name: variant, span: variant_span ?? span})
            }
            None
        }
        .Ident(name, span, _) -> Val(NamedSpan{name: name, span: span})
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

parser_states_has_name: fn(states: [NamedSpan], name: String) -> Bool Never! {
    loop entry in states {
        if entry.name == name -> return true
    }
    false
}

parser_states_list_members: fn(state: ^JetParserState, expr: Expr, context: String) -> [NamedSpan] {
    ^members: [NamedSpan]{}
    if expr == .ListLit(elements, _, _) {
        loop element in elements {
            if parser_states_member_name(element) == .Val(named) {
                members.push(named)
            } else {
                parser_add_error(state, expr_span(element), "expected a state name such as `.Confirmed` {context}", "each entry in a `#States` list names a state of this type", "write `.StateName` inside the list")
            }
        }
        return members
    }
    parser_add_error(state, expr_span(expr), "expected a list of state names {context}", "`#States` maps each state or group to a `[.State, ...]` list", "write `[.Target]` or `[]`")
    members
}

// Lowers `#States({ Draft: [.Confirmed, .Canceled], … }, groups: { Open: [.Draft, .Confirmed] })`
// on a struct or enum into the exact `StateDecl` produced by `state { … }`,
// auto-including target-only states so terminal states do not need empty rows.
parser_apply_states_marker: fn(state: ^JetParserState, type_name: String, type_name_span: Span, existing: ^StateDecl?, markers: [Marker]) {
    loop marker in markers {
        if marker.name != MARKER_STATES -> next
        values: parser_bind_marker_arguments(state, marker, [String]{"transitions", "groups"}, 1) ?? next
        transitions_expr: values[0] ?? next
        fields: parser_states_record_fields(transitions_expr) ?? {
            parser_add_error(state, expr_span(transitions_expr), "`#States` expects a record of state transitions", "write `{{ State: [.Next, ...], ... }}` to declare a type's states and legal moves", "write `#States({{ Draft: [.Confirmed], Confirmed: [] }})`")
            next
        }
        ^states: [NamedSpan]{}
        ^arrows: [StateArrow]{}
        ^groups: [StateGroup]{}
        loop field in fields {
            targets: parser_states_list_members(state, field.value, "in `#States` transitions")
            arrows.push(StateArrow{from: NamedSpan{name: field.name, span: field.name_span}, to: targets, span: parser_cover(field.name_span, expr_span(field.value))})
            states.push(NamedSpan{name: field.name, span: field.name_span})
        }
        // Auto-include target-only states so terminal states (`Shipped`, `Canceled`)
        // participate in typestate checking even when written only as targets.
        ^extra_targets: [NamedSpan]{}
        loop arrow in arrows {
            loop target in arrow.to {
                if !parser_states_has_name(states, target.name) && !parser_states_has_name(extra_targets, target.name) {
                    extra_targets.push(NamedSpan{name: target.name, span: target.span})
                }
            }
        }
        loop target in extra_targets {
            arrows.push(StateArrow{from: NamedSpan{name: target.name, span: target.span}, to: [NamedSpan]{}, span: target.span})
            states.push(target)
        }
        if values[1] == .Val(groups_expr) {
            group_fields: parser_states_record_fields(groups_expr) ?? {
                parser_add_error(state, expr_span(groups_expr), "`#States(..., groups: ...)` expects a record of state groups", "each group maps a group name to the list of states it includes", "write `groups: {{ Open: [.Draft, .Confirmed] }}`")
                [ExprField]{}
            }
            loop gfield in group_fields {
                members: parser_states_list_members(state, gfield.value, "in `#States` group `{gfield.name}`")
                groups.push(StateGroup{name: NamedSpan{name: gfield.name, span: gfield.name_span}, members: members, span: parser_cover(gfield.name_span, expr_span(gfield.value))})
            }
        }
        section: StateDecl{is_pub: false, is_package_pub: false, type_name: type_name, type_name_span: type_name_span, states: states, arrows: arrows, groups: groups, span: marker.span}
        if existing == {
            .None -> { existing = Val(section) }
            .Val(_) -> parser_report_repeated_state_section(state, section, type_name)
        }
    }
}
