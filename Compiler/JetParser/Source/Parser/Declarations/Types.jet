// Distinct nominal types and quantity/unit-family declarations.  The shared
// type parser supplies the carrier and this file owns declaration-only metadata
// such as ranges, dimensions, exact conversion ratios, and provenance.

fn parser_distinct_ahead(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON_COLON && parser_kind_at(&state, 2) == TOKEN_IDENT && parser_lookahead(&state, 2).payload.decoded == "distinct"
}

fn parser_unit_family_ahead(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == "UnitFamily" && parser_kind_at(&state, 2) == TOKEN_LPAREN
}

fn parser_distinct_marker_derives(markers: [Marker]) -> [NamedSpan] Never! {
    derives := [NamedSpan]{}
    loop marker in markers {
        if marker.name == {
            "Numeric" | "Comparable" | "Printable" -> &derives.push(NamedSpan{name: marker.name, span: marker.name_span})
            "CodableAsBase" -> {
                &derives.push(NamedSpan{name: "Encode", span: marker.name_span})
                &derives.push(NamedSpan{name: "Decode", span: marker.name_span})
            }
            else -> {}
        }
    }
    derives
}

fn parser_parse_distinct(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    start :: modifiers.start_span
    name :: parser_expect_name(&state, "as the distinct type name")
    parser_expect(&state, TOKEN_COLON_COLON, "`::` after a distinct type name")
    keyword :: parser_expect_name(&state, "after `::` in a distinct declaration")
    if keyword.payload.decoded != "distinct" {
        parser_add_error(&state, keyword.span, "expected `distinct` in a distinct type declaration", "nominal declarations use `Name :: distinct Base`", "write `Name :: distinct Int`")
    }
    base :: parser_parse_type(&state, 0)
    range_value := IntegerRange?{None}
    if parser_current_kind(&state) == TOKEN_LPAREN {
        open :: parser_bump(&state)
        lower :: parser_distinct_range_bound(&state, "as the lower range bound")
        parser_expect(&state, TOKEN_DOT_DOT, "between distinct range bounds")
        upper :: parser_distinct_range_bound(&state, "as the upper range bound")
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after a distinct range")
        if lower.value > upper.value {
            parser_type_declaration_error(&state, "E0137", parser_cover(lower.span, upper.span), "this distinct range is empty", "a range lower bound cannot be greater than its upper bound", "swap the two bounds")
        }
        range_value = Val(IntegerRange{lo: lower.value, hi: upper.value, span: parser_cover(open.span, close.span)})
    }
    // The declaration ends at its last significant token; the statement
    // terminator is consumed but never widens the span.
    end :: if range_value == {
        .Val(value) -> value.span
        .None -> base.span
    }
    parser_expect(&state, TOKEN_SEMI, "after a distinct type declaration")
    markers :: modifiers.markers
    value :: DistinctDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, type_markers: markers, derives: parser_distinct_marker_derives(markers), quantity: None, name: name.payload.decoded, name_span: name.span, base: base.ty, base_span: base.span, range: range_value, span: parser_cover(start, end)}
    Item.Distinct{value: value}
}

pub struct DistinctRangeBound {
    pub value: Int
    pub span: Span
}

fn parser_distinct_range_bound(state: &JetParserState, context: String) -> DistinctRangeBound {
    token :: parser_current(&state)
    if token.kind == TOKEN_MINUS {
        parser_add_error(&state, token.span, "expected a non-negative whole number {context}", "distinct ranges use literal integer bounds", "write a plain integer such as `0..10`")
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_INT {
            value :: parser_bump(&state)
            return DistinctRangeBound{value: 0, span: parser_cover(token.span, value.span)}
        }
        return DistinctRangeBound{value: 0, span: token.span}
    }
    if token.kind != TOKEN_INT {
        parser_add_error(&state, token.span, "expected a whole number {context}", "distinct ranges use literal integer bounds", "write a plain integer such as `0..10`")
        if token.kind != TOKEN_EOF -> parser_bump(&state)
        return DistinctRangeBound{value: 0, span: token.span}
    }
    parser_bump(&state)
    DistinctRangeBound{value: token.payload.integer ?? 0, span: token.span}
}

fn parser_type_declaration_error(state: &JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    parser_add_error_code(&state, code, span, what, why, fix)
}

fn parser_parse_unit_family(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    marker :: if {
        parser_current_kind(&state) == TOKEN_HASH -> parser_parse_marker(&state)
        else -> {
            found := Marker?{None}
            loop candidate in modifiers.markers {
                if candidate.name == "UnitFamily" {
                    found = Val(candidate)
                    break
                }
            }
            found ?? Marker{name: "UnitFamily", negated: false, name_span: parser_current(&state).span, args: [MarkerCallArg]{}, arg_labels: [CallLabel?]{}, span: parser_current(&state).span, ct: None}
        }
    }
    family_expr :: parser_marker_expression(marker, 0)
    family := ""
    family_span := marker.span
    if family_expr == {
        .Val(value) -> {
            if value == { .Ident(name, span) -> { family = name; family_span = span } else -> {} }
        }
        else -> {}
    }
    if family == "" {
        parser_type_declaration_error(&state, "E0003", marker.span, "`UnitFamily` needs a family name", "the first UnitFamily argument names the nominal unit family", "write `#UnitFamily(Time)`")
    }
    dimension := UnitDimensionDecl?{None}
    base := NamedSpan?{None}
    loop index in 1..<marker.args.len() {
        value :: parser_marker_expression(marker, index)
        label :: parser_marker_label(marker, index)
        if {
            label == "base" -> {
                if value == .Val(expr) {
                    if expr == .Ident(name, span) -> base = Val(NamedSpan{name: name, span: span})
                }
            }
            index == 1 -> {
                if value == .Val(expr) {
                    if expr == {
                        .Ident(name, span) -> {
                            if name == "dimension" -> dimension = Val(UnitDimensionDecl.Base{span: span}) else -> dimension = Val(UnitDimensionDecl.Derived{expr: expr})
                        }
                        else -> dimension = Val(UnitDimensionDecl.Derived{expr: expr})
                    }
                }
            }
            index == 2 && base == None -> {
                if value == .Val(expr) {
                    if expr == .Ident(name, span) -> base = Val(NamedSpan{name: name, span: span})
                }
            }
            else -> {}
        }
    }
    derived_without_base :: if dimension == {
        .Val(value) -> {
            if value == { .Derived(_) -> base == None else -> false }
        }
        .None -> false
    }
    if derived_without_base {
        parser_type_declaration_error(&state, "E0003", family_span, "a derived dimension needs a canonical base", "derived unit dimensions require one member with scale one and offset zero", "add `base: member_name` to `#UnitFamily`")
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` before unit-family members")
    members := [UnitFamilyMember]{}
    has_conversion := false
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        member :: parser_expect_name(&state, "as a unit-family member")
        scale := UnitRatio{numerator: 1, denominator: 1}
        scale_provenance := UnitScaleProvenance.Rational
        offset := UnitRatio{numerator: 0, denominator: 1}
        saw_scale := false
        saw_offset := false
        if parser_current_kind(&state) == TOKEN_LPAREN {
            parser_bump(&state)
            loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF {
                field :: parser_expect_name(&state, "as unit conversion metadata")
                parser_expect(&state, TOKEN_COLON, "after unit conversion metadata")
                if field.payload.decoded == {
                    "scale" -> {
                        if saw_scale {
                            parser_type_declaration_error(&state, "E0003", field.span, "unit scale is repeated", "each unit member has one scale fact", "keep one `scale:` entry")
                        }
                        parsed :: parser_unit_scale(&state)
                        scale = parsed.ratio
                        scale_provenance = parsed.provenance
                        saw_scale = true
                    }
                    "offset" -> {
                        if saw_offset {
                            parser_type_declaration_error(&state, "E0003", field.span, "unit offset is repeated", "each unit member has one offset fact", "keep one `offset:` entry")
                        }
                        offset = parser_unit_ratio(&state)
                        saw_offset = true
                    }
                    else -> {
                        parser_type_declaration_error(&state, "E0003", field.span, "unknown unit conversion metadata", "unit members accept scale and offset facts", "use `scale:` or `offset:`")
                        parser_parse_expression(&state, 1, 0)
                    }
                }
                if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state) else -> break
            }
            parser_expect(&state, TOKEN_RPAREN, "`)` after unit conversion metadata")
        }
        if scale.numerator == 0 {
            parser_type_declaration_error(&state, "E0003", member.span, "a unit scale cannot be zero", "unit conversion must remain invertible", "write a nonzero exact scale")
        }
        if saw_scale || saw_offset -> has_conversion = true
        &members.push(UnitFamilyMember{name: member.payload.decoded, name_span: member.span, scale: scale, scale_provenance: scale_provenance, offset: offset})
        loop parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after unit-family members")
    if base == None && !derived_without_base && (dimension != None || has_conversion) && members.len() > 0 {
        first :: members[0]
        base = Val(NamedSpan{name: first.name, span: first.name_span})
    }
    if base == {
        .Val(base_value) -> {
            found := false
            loop member in members {
                if member.name == base_value.name {
                    found = true
                    if member.scale.numerator != member.scale.denominator || member.offset.numerator != 0 {
                        parser_type_declaration_error(&state, "E0003", member.name_span, "the unit-family base must have scale one and offset zero", "the canonical base carries the family's unchanged value", "remove conversion metadata from the base member")
                    }
                }
            }
            if !found -> parser_type_declaration_error(&state, "E0003", base_value.span, "the unit-family base is not a member", "the canonical base must be declared in the same family", "name an existing member as `base`")
        }
        else -> {}
    }
    Item.UnitFamily{value: UnitFamilyDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, family: family, family_span: family_span, dimension: dimension, resolved_dimension: None, resolved_owner: None, base: base, members: members, span: parser_cover(marker.span, close.span)}}
}

pub struct ParsedUnitScale {
    pub ratio: UnitRatio
    pub provenance: UnitScaleProvenance
}

fn parser_unit_scale(state: &JetParserState) -> ParsedUnitScale {
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "pi" {
        parser_bump(&state)
        parser_expect(&state, TOKEN_SLASH, "`/` after `pi`")
        denominator :: parser_unit_integer(&state, "as a symbolic pi denominator")
        denominator_value :: parser_unit_decimal_to_ratio(denominator.text).numerator
        if denominator_value == 0 -> parser_type_declaration_error(&state, "E0003", denominator.span, "a symbolic scale denominator cannot be zero", "unit conversion factors must be invertible", "write a nonzero denominator")
        value :: UnitRatio{numerator: 3141592653589793, denominator: 1000000000000000 * denominator_value}
        return ParsedUnitScale{ratio: value, provenance: UnitScaleProvenance.SymbolicPi{numerator: UnitRatio{numerator: 1, denominator: 1}, denominator: UnitRatio{numerator: denominator_value, denominator: 1}}}
    }
    if parser_current_kind(&state) == TOKEN_IDENT && (parser_current(&state).payload.decoded == "conventional" || parser_current(&state).payload.decoded == "measured") {
        kind :: parser_bump(&state)
        measured :: kind.payload.decoded == "measured"
        parser_expect(&state, TOKEN_LPAREN, "`(` after scale provenance")
        central :: parser_unit_decimal(&state, "as the scale value")
        parser_expect(&state, TOKEN_COMMA, "after a scale value")
        label :: parser_expect_name(&state, "for scale provenance")
        parser_expect(&state, TOKEN_COLON, "after scale provenance label")
        expected_label :: if measured -> "uncertainty" else -> "source"
        if label.payload.decoded != expected_label {
            parser_type_declaration_error(&state, "E0003", label.span, "unexpected scale provenance label", "conventional scales name source and measured scales name uncertainty then source", "write `{expected_label}: ...`")
        }
        if measured {
            uncertainty :: parser_unit_decimal(&state, "as a standard uncertainty")
            parser_expect(&state, TOKEN_COMMA, "after a standard uncertainty")
            source_label :: parser_expect_name(&state, "for a measurement source")
            parser_expect(&state, TOKEN_COLON, "after a measurement source label")
            if source_label.payload.decoded != "source" {
                parser_type_declaration_error(&state, "E0003", source_label.span, "expected a measurement source label", "measured scales name their provenance source explicitly", "write `source: \"...\"`")
            }
            source :: parser_unit_plain_string(&state, "as a measurement source")
            parser_expect(&state, TOKEN_RPAREN, "`)` after measured scale provenance")
            return ParsedUnitScale{ratio: parser_unit_decimal_ratio(central.text), provenance: UnitScaleProvenance.Measured{central_value: central.text, standard_uncertainty: uncertainty.text, source: source}}
        }
        source :: parser_unit_plain_string(&state, "as a convention source")
        parser_expect(&state, TOKEN_RPAREN, "`)` after conventional scale provenance")
        return ParsedUnitScale{ratio: parser_unit_decimal_ratio(central.text), provenance: UnitScaleProvenance.Conventional{value: central.text, source: source}}
    }
    ParsedUnitScale{ratio: parser_unit_ratio(&state), provenance: UnitScaleProvenance.Rational}
}

pub struct UnitText {
    pub text: String
    pub span: Span
}

fn parser_unit_decimal(state: &JetParserState, context: String) -> UnitText {
    sign := ""
    start :: parser_current(&state).span
    if parser_current_kind(&state) == TOKEN_MINUS {
        parser_bump(&state)
        sign = "-"
    }
    token :: parser_current(&state)
    if token.kind != TOKEN_INT && token.kind != TOKEN_FLOAT {
        parser_add_error(&state, token.span, "expected a decimal {context}", "unit conversion metadata is numeric", "write an integer or decimal literal")
        if token.kind != TOKEN_EOF -> parser_bump(&state)
        return UnitText{text: "0", span: parser_cover(start, token.span)}
    }
    parser_bump(&state)
    UnitText{text: "{sign}{token.payload.text}", span: parser_cover(start, token.span)}
}

fn parser_unit_integer(state: &JetParserState, context: String) -> UnitText {
    sign := ""
    start :: parser_current(&state).span
    if parser_current_kind(&state) == TOKEN_MINUS {
        parser_bump(&state)
        sign = "-"
    }
    token :: parser_current(&state)
    if token.kind != TOKEN_INT {
        parser_add_error(&state, token.span, "expected an integer {context}", "unit ratios use exact integer numerators and denominators", "write an integer")
        if token.kind != TOKEN_EOF -> parser_bump(&state)
        return UnitText{text: "0", span: parser_cover(start, token.span)}
    }
    parser_bump(&state)
    UnitText{text: "{sign}{token.payload.text}", span: parser_cover(start, token.span)}
}

fn parser_unit_ratio(state: &JetParserState) -> UnitRatio {
    numerator :: parser_unit_integer(&state, "as a conversion numerator")
    denominator := UnitText{text: "1", span: numerator.span}
    if parser_current_kind(&state) == TOKEN_SLASH {
        parser_bump(&state)
        denominator = parser_unit_integer(&state, "as a conversion denominator")
        if parser_unit_decimal_to_ratio(denominator.text).numerator == 0 {
            parser_type_declaration_error(&state, "E0003", denominator.span, "a ratio denominator cannot be zero", "unit conversion factors must be finite and invertible", "write a nonzero integer denominator")
        }
    }
    parser_unit_ratio_from_text(numerator.text, denominator.text)
}

fn parser_unit_plain_string(state: &JetParserState, context: String) -> String {
    token :: parser_current(&state)
    if token.kind != TOKEN_STRING && token.kind != TOKEN_RAW_STRING {
        parser_add_error(&state, token.span, "expected a plain string {context}", "unit provenance sources are fixed text", "write a non-interpolated string")
        if token.kind != TOKEN_EOF -> parser_bump(&state)
        return ""
    }
    parser_bump(&state)
    if token.payload.interpolations > 0 {
        parser_add_error(&state, token.span, "unit provenance strings cannot interpolate", "conversion provenance must be stable source text", "write a plain string")
    }
    token.payload.decoded
}

fn parser_unit_ratio_from_text(numerator_text: String, denominator_text: String) -> UnitRatio Never! {
    numerator :: parser_unit_decimal_to_ratio(numerator_text)
    denominator :: parser_unit_decimal_to_ratio(denominator_text)
    if denominator.numerator == 0 -> return UnitRatio{numerator: numerator.numerator, denominator: 0}
    UnitRatio{numerator: numerator.numerator * denominator.denominator, denominator: numerator.denominator * denominator.numerator}
}

fn parser_unit_decimal_to_ratio(text: String) -> UnitRatio Never! {
    clean :: text.replace("_", "")
    bytes :: clean.bytes()
    sign := 1
    index := 0
    if bytes.len() > 0 && (Int.from_u8(bytes[0]) == 45 || Int.from_u8(bytes[0]) == 43) {
        if Int.from_u8(bytes[0]) == 45 -> sign = -1
        index = 1
    }
    whole := 0
    fraction := 0
    fraction_digits := 0
    saw_dot := false
    exponent := 0
    exponent_sign := 1
    loop index < bytes.len() {
        value :: Int.from_u8(bytes[index])
        if value == 101 || value == 69 {
            index += 1
            if index < bytes.len() && (Int.from_u8(bytes[index]) == 45 || Int.from_u8(bytes[index]) == 43) {
                if Int.from_u8(bytes[index]) == 45 -> exponent_sign = -1
                index += 1
            }
            loop index < bytes.len() {
                digit :: Int.from_u8(bytes[index])
                if digit >= 48 && digit <= 57 -> exponent = exponent * 10 + digit - 48
                index += 1
            }
            break
        }
        if {
            value == 46 -> saw_dot = true
            value >= 48 && value <= 57 -> {
                if {
                    saw_dot -> {
                        fraction = fraction * 10 + value - 48
                        fraction_digits += 1
                    }
                    else -> {
                        whole = whole * 10 + value - 48
                    }
                }
            }
        }
        index += 1
    }
    denominator := 1
    fraction_scale := 0
    loop fraction_scale < fraction_digits {
        denominator *= 10
        fraction_scale += 1
    }
    numerator := sign * (whole * denominator + fraction)
    power :: exponent_sign * exponent
    if {
        power >= 0 -> {
            scale := 0
            loop scale < power {
                numerator *= 10
                scale += 1
            }
        }
        else -> {
            scale := 0
            loop scale < 0 - power {
                denominator *= 10
                scale += 1
            }
        }
    }
    UnitRatio{numerator: numerator, denominator: denominator}
}

fn parser_unit_decimal_ratio(text: String) -> UnitRatio Never! {
    parser_unit_ratio_from_text(text, "1")
}

