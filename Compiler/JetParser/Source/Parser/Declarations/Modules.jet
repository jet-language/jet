fn parser_parse_module_vmtest_lit(state: &JetParserState) -> VmTestLit {
    explicit_type := None
    record_start := parser_current(&state).span
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "VmTest" && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        explicit :: parser_bump(&state)
        explicit_type = Val(explicit.span)
        record_start = explicit.span
