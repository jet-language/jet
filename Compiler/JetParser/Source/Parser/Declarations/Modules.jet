// Module, code-module, and role-module declaration grammar.
// Module names and role payloads use a contextual head contract; nested
// expressions and types still use the canonical parser.


fn parser_module_dashed_name(state: &JetParserState, context: String) -> NamedSpan {
    first :: parser_expect_name(&state, context)
    name := first.payload.decoded
    end := first.span
    loop parser_current_kind(&state) == TOKEN_MINUS && parser_kind_at(&state, 1) == TOKEN_IDENT {
        parser_bump(&state)
        part :: parser_bump(&state)
        name = "{name}-{part.payload.decoded}"
        end = part.span
    }
    NamedSpan{name: name, span: parser_cover(first.span, end)}
}

fn parser_module_namespace(name: String) -> ?Namespace {
    normalized := name
    if name.starts_with("_") && name.len() > 1 -> normalized = name.slice(1, name.len())
    if normalized == "env" -> return Val(Namespace.Env)
    if normalized == "system" -> return Val(Namespace.System)
    if normalized == "image" -> return Val(Namespace.Image)
    if normalized == "fleet" -> return Val(Namespace.Fleet)
    if normalized == "vmtest" -> return Val(Namespace.VmTest)
    if normalized == "profile" -> return Val(Namespace.Profile)
    if normalized == "perf" -> return Val(Namespace.Perf)
    None
}

fn parser_module_is_dashed(name: String) -> Bool {
    bytes := name.bytes()
    index := 0
    loop index < bytes.len() {
        if Int.from_u8(bytes[index]) == 45 -> return true
        index += 1
    }
    false
}

fn parser_module_config_body_ahead(state: &JetParserState) -> Bool {
    if parser_current_kind(&state) != TOKEN_LBRACE -> return false
    first := parser_lookahead(&state, 1)
    if first.kind != TOKEN_IDENT -> return false
    if parser_kind_at(&state, 2) == TOKEN_DOT -> return true
    if parser_kind_at(&state, 2) != TOKEN_COLON -> return false
    first.payload.decoded == "sources" || first.payload.decoded == "imports" || first.payload.decoded == "members"
}

fn parser_module_error(state: &JetParserState, code: String, span: Span, what: String, why: String, fix: String) {
    parser_add_error_code(&state, code, span, what, why, fix)
}

fn parser_module_ahead(state: &JetParserState) -> Bool {
    if parser_current_kind(&state) != TOKEN_KW_MODULE -> return false
    if parser_kind_at(&state, 1) != TOKEN_IDENT -> return false
    if parser_kind_at(&state, 2) == TOKEN_DOT -> return true
    parser_kind_at(&state, 2) == TOKEN_MINUS || parser_kind_at(&state, 2) == TOKEN_LBRACE || parser_kind_at(&state, 2) == TOKEN_SEMI || parser_kind_at(&state, 2) == TOKEN_LT || parser_kind_at(&state, 2) == TOKEN_LPAREN || parser_kind_at(&state, 2) == TOKEN_COLON_COLON
}



// One entry point for the dispatcher.  `modifiers` has already consumed
// visibility/comptime markers; this function consumes `module` itself.
fn parser_parse_module(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    start :: parser_bump(&state)
    name_head :: parser_module_dashed_name(&state, "for the module name")
    if parser_current_kind(&state) == TOKEN_DOT {
        return parser_parse_role_module(&state, modifiers, start.span, name_head)
    }
    if parser_current_kind(&state) == TOKEN_COLON_COLON {
        return parser_parse_module_alias_after_name(&state, modifiers, start.span, name_head)
    }
    if parser_current_kind(&state) == TOKEN_LT || parser_current_kind(&state) == TOKEN_LPAREN {
        return parser_parse_generic_module_after_name(&state, modifiers, start.span, name_head)
    }
    if parser_module_is_dashed(name_head.name) || parser_module_config_body_ahead(&state) {
        return parser_parse_module_decl_after_name(&state, modifiers, start.span, name_head)
    }
    parser_parse_code_module_after_name(&state, modifiers, start.span, name_head)
}
fn parser_parse_module_decl_after_name(state: &JetParserState, modifiers: ParsedItemModifiers, start: Span, name_head: NamedSpan) -> Item {
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a module body")
    sources := [SourceDecl]{}
    imports := [Expr]{}
    members := [Expr]{}
    contributions := [Contribution]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        if parser_state_section_ahead(&state) {
            section := parser_parse_state_section(&state, "", parser_current(&state).span)
            parser_report_ineligible_state_section(&state, section, "module")
            next
        }
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "sources" && parser_kind_at(&state, 1) == TOKEN_COLON {
            parsed_sources := parser_module_sources(&state)
            source_index := 0
            loop source_index < parsed_sources.len() {
                sources.push(parsed_sources[source_index])
                source_index += 1
            }
            next
        }
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "imports" && parser_kind_at(&state, 1) == TOKEN_COLON {
            parser_bump(&state)
            parser_bump(&state)
            imports.push(parser_parse_expression(&state, 1, 0).expr)
            if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state)
            next
        }
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "members" && parser_kind_at(&state, 1) == TOKEN_COLON {
            parser_bump(&state)
            parser_bump(&state)
            members.push(parser_parse_expression(&state, 1, 0).expr)
            if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state)
            next
        }
        if parser_current_kind(&state) != TOKEN_IDENT || parser_kind_at(&state, 1) != TOKEN_DOT {
            parser_add_error(&state, parser_current(&state).span, "expected a module field or namespace contribution", "a module body contains sources, imports, members, or a typed namespace contribution", "write `sources: {{ ... }}`, `members: ...`, or `env.dev: ...`")
            parser_recover_statement(&state)
            next
        }
        contributions.push(parser_parse_module_contribution(&state))
        if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after module declarations")
    Item.Module(value: ModuleDecl{name: name_head.name, name_span: name_head.span, auto_discovered: !parser_module_name_starts_with_underscore(name_head.name), sources: sources, imports: imports, members: members, contributions: contributions, span: parser_cover(start, close.span)})
}

fn parser_parse_module_contribution(state: &JetParserState) -> Contribution {
    namespace_token :: parser_expect_name(&state, "for a namespace contribution")
    namespace := parser_module_namespace(namespace_token.payload.decoded)
    if namespace == None {
        parser_module_error(&state, "E0960", namespace_token.span, "`{namespace_token.payload.decoded}` is not a module namespace", "namespace contributions use env, system, image, fleet, vmtest, or profile", "start the contribution with a supported namespace")
        namespace = Val(Namespace.Env)
    }
    namespace_value :: namespace ?? Namespace.Env
    parser_expect(&state, TOKEN_DOT, "after the namespace name")
    path :: parser_module_dashed_name(&state, "for a contribution name")
    parser_expect(&state, TOKEN_COLON, "after a contribution name")
    value := if {
        namespace_value == Namespace.System -> ContribValue.System(value: parser_parse_module_system_lit(&state))
        namespace_value == Namespace.Image -> ContribValue.Image(value: parser_parse_module_image_lit(&state))
        namespace_value == Namespace.Fleet -> ContribValue.Fleet(value: parser_parse_module_fleet_lit(&state))
        namespace_value == Namespace.VmTest -> ContribValue.VmTest(value: parser_parse_module_vmtest_lit(&state))
        namespace_value == Namespace.Perf -> {
            parser_module_error(&state, "E2903", namespace_token.span, "performance contributions use a role module", "performance budgets need one typed budgets list and are not ordinary namespace values", "write `module perf.name {{ budgets: [...] }}`")
            ContribValue.Expr(value: parser_parse_expression(&state, 1, 0).expr)
        }
        else -> ContribValue.Expr(value: parser_parse_expression(&state, 1, 0).expr)
    }
    end := parser_module_contribution_end(value)
    Contribution{namespace: namespace ?? Namespace.Env, path: path.name, path_span: path.span, value: value, span: parser_cover(namespace_token.span, end)}
}

fn parser_module_contribution_end(value: ContribValue) -> Span {
    if value == {
        .Expr(expr) -> expr_span(expr)
        .Env(lit) -> lit.span
        .System(lit) -> lit.span
        .Image(lit) -> lit.span
        .Fleet(lit) -> lit.span
        .VmTest(lit) -> lit.span
        .Profile(lit) -> lit.span
        .Perf(lit) -> lit.span
    }
}
 

fn parser_parse_module_system_lit(state: &JetParserState) -> SystemLit {
    explicit_type := None
    record_start := parser_current(&state).span
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "System" && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        explicit :: parser_bump(&state)
        explicit_type = Val(explicit.span)
        record_start = explicit.span
    }
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a system record")
    fields := [SystemField]{}
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        fields.push(parser_module_system_field(&state))
        if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after a system record")
    SystemLit{explicit_type: explicit_type, fields: fields, span: parser_cover(record_start, close.span)}
}

