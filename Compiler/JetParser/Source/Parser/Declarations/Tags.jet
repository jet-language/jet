use jet_foundation.[
    Expr,
    MarkerDecl,
    NamedSpan,
    Span,
    StructDef,
    TagDef,
    expr_span,
]

// A value tag is a field-less struct whose `impl Marker` block has
// `sites: [.TypeUse]`: it marks a value's type (`#CardNumber String`) and
// declares no marker rule. Its denials are its own `#FX(!…)` row. `from`
// names the effects or functions whose results carry it, and `timing` and
// `protects` are cases of core.compiler.lang TagTiming and TagProtects. The
// parser returns the tag in place of the struct; None: the struct is no tag.
parser_tag_struct: fn(state: ^JetParserState, value: StructDef) -> TagDef? {
    declaration: value.marker ?? return None
    if !parser_tag_sites(state, value.name, declaration) -> return None
    ^from: [NamedSpan]{}
    ^timing: NamedSpan?{None}
    ^protects: NamedSpan?{None}
    loop setting in declaration.params {
        written: setting.value ?? next
        if setting.name == {
            "$sites" -> {}
            "$from" -> from = parser_tag_from(state, value.name, written)
            "$timing" -> {
                timing = parser_tag_case(state, value.name, "timing", written, "Free", "Fixed")
            }
            "$protects" -> {
                protects = parser_tag_case(state, value.name, "protects", written, "Secrecy", "Integrity")
            }
            else -> {
                key: setting.name.slice(1, setting.name.len())
                parser_tag_error(state, setting.name_span, "the tag `{value.name}` sets `{key}`", "a value tag's `impl Marker` block holds only `sites`, `from`, `timing` and `protects`", "remove `{key}: …`")
            }
        }
    }
    parser_tag_repeats(state, value)
    if declaration.group != None || declaration.body != None {
        parser_tag_error(state, value.name_span, "the tag `{value.name}` has a marker group or template", "a value tag marks a type use and expands to nothing", "remove `group: …` and `expand: fn …` from its `impl Marker` block")
    }
    parser_tag_members(state, value)
    Val(TagDef{is_pub: value.is_pub, is_package_pub: value.is_package_pub, name: value.name, name_span: value.name_span, deny: parser_tag_denials(state, value), from: from, span: value.span, timing: timing, protects: protects})
}

// Whether the marker's `sites` name `.TypeUse`; another site beside it is
// E0734, since a value tag is written only at a type use.
parser_tag_sites: fn(state: ^JetParserState, name: String, declaration: MarkerDecl) -> Bool {
    loop setting in declaration.params {
        if setting.name != "$sites" -> next
        written: setting.value ?? return false
        elements: parser_tag_list(written) ?? return false
        ^type_use: false
        loop element in elements {
            if element == .EnumLit(_, variant, _, _, _, _, _) {
                if variant == "TypeUse" -> type_use = true
            }
        }
        if !type_use -> return false
        loop element in elements {
            if element == .EnumLit(_, variant, _, _, _, _, _) {
                if variant == "TypeUse" -> next
            }
            parser_tag_error(state, expr_span(element), "the tag `{name}` names another site beside `.TypeUse`", "a value tag is written only at a type use (`#{name} String`)", "write `sites: [.TypeUse]`, and declare a separate marker for the other sites")
        }
        return true
    }
    false
}

// The tag's `#FX` row: each `!Effect` entry is a destination it denies. A
// ceiling entry, or a row with no denial, is E0734.
parser_tag_denials: fn(state: ^JetParserState, value: StructDef) -> [NamedSpan] {
    ^deny: [NamedSpan]{}
    if value.cap == .Val(cap) {
        loop entry in cap.entries {
            if entry.name.starts_with("!") {
                // The destination's span leaves out the `!`, so a fix that
                // respells it keeps the denial.
                deny.push(NamedSpan{name: entry.name.slice(1, entry.name.len()), span: Span{start: entry.span.start + 1, end: entry.span.end}})
                next
            }
            parser_tag_error(state, entry.span, "`{entry.name}` in the tag `{value.name}`'s `#FX` row is a ceiling, not a denial", "a value tag's `#FX` row lists the destinations its values may not reach; a tag grants no effects", "write `!{entry.name}` to deny it, or remove it")
        }
    }
    if deny.len() == 0 {
        parser_tag_error(state, value.name_span, "the tag `{value.name}` denies no destination", "a value tag's denials are its own `#FX(!…)` row, and a tag that denies nothing has no policy to enforce", "write the destinations it may not reach above it: `#FX(!Net) {value.name}: struct {{ … }}`")
    }
    deny
}

// `from: [Effect, module.function, …]`: the sources whose results carry the
// tag, as written; sema resolves them (E0735).
parser_tag_from: fn(state: ^JetParserState, name: String, written: Expr) -> [NamedSpan] {
    ^from: [NamedSpan]{}
    elements: parser_tag_list(written) ?? {
        parser_tag_error(state, expr_span(written), "`from` on the tag `{name}` is not a list", "`from` lists the effects or functions whose results carry the tag", "write `from: [Effect, module.function]`")
        return from
    }
    loop element in elements {
        if parser_marker_ident_path(element) == .Val(path) {
            from.push(NamedSpan{name: path, span: expr_span(element)})
            next
        }
        parser_tag_error(state, expr_span(element), "a `from` entry on the tag `{name}` is not an effect or function path", "`from` lists the effects or functions whose results carry the tag", "write an effect such as `Net` or a path such as `store.read`")
    }
    from
}

// The entries of a `[…]` setting, or None for another value.
parser_tag_list: fn(written: Expr) -> [Expr]? {
    if written == .ListLit(elements, _, _) -> return Val(elements)
    None
}

// `timing: .Free | .Fixed` or `protects: .Secrecy | .Integrity`; another
// value is E0734.
parser_tag_case: fn(state: ^JetParserState, name: String, field: String, written: Expr, first: String, second: String) -> NamedSpan? {
    if written == .EnumLit(_, variant, _, _, leading_dot, span, _) {
        if leading_dot && (variant == first || variant == second) {
            return Val(NamedSpan{name: variant, span: span})
        }
    }
    parser_tag_error(state, expr_span(written), "`{field}` on the tag `{name}` is not `.{first}` or `.{second}`", "a tag's `{field}` is a case of core.compiler.lang's Tag{parser_tag_case_type(field)}", "write `{field}: .{first}` or `{field}: .{second}`")
    None
}

parser_tag_case_type: fn(field: String) -> String Never! {
    if field == "timing" -> "Timing" else -> "Protects"
}

// A tag struct reaches no sema impl check, so a setting given twice is E0937
// here, in the words sema uses for any impl.
parser_tag_repeats: fn(state: ^JetParserState, value: StructDef) {
    loop (block_index, block) in value.trait_impls {
        loop (index, constant) in block.constants {
            if parser_tag_given_before(value, block_index, index, constant.name) {
                parser_add_error_code(state, "E0937", constant.name_span, "the impl gives the constant `{constant.name}` twice", "an implementation has one value for each trait constant", "remove one `{constant.name}: …`")
            }
        }
    }
}

// Whether a constant written before the one at `index` of the impl block at
// `block_index` already gives `name`.
parser_tag_given_before: fn(value: StructDef, block_index: Int, index: Int, name: String) -> Bool Never! {
    loop (at, block) in value.trait_impls {
        if at > block_index -> return false
        loop (place, constant) in block.constants {
            if at == block_index && place >= index -> return false
            if constant.name == name -> return true
        }
    }
    false
}

// A value tag erases at runtime: a field, a method or a type parameter has
// no value to belong to (E0732).
parser_tag_members: fn(state: ^JetParserState, value: StructDef) {
    loop field in value.fields {
        parser_add_error_code(state, "E0732", field.name_span, "the tag `{value.name}` declares a field `{field.name}`, but tags have no fields", "a value tag is a field-less struct that erases at runtime; only a type with values carries fields", "remove the field, or declare a separate struct for the data")
    }
    loop method in value.methods {
        parser_tag_method_error(state, value.name, method.name, method.name_span)
    }
    loop block in value.trait_impls {
        loop method in block.methods {
            parser_tag_method_error(state, value.name, method.name, method.name_span)
        }
    }
    if value.type_params.len() > 0 {
        parser_add_error_code(state, "E0732", value.name_span, "the tag `{value.name}` declares type parameters, but tags have no fields", "a value tag is a field-less struct that erases at runtime, so a type parameter has nothing to type", "remove the type parameters")
    }
}

parser_tag_method_error: fn(state: ^JetParserState, name: String, method: String, span: Span) {
    parser_add_error_code(state, "E0732", span, "the tag `{name}` declares a method `{method}`, but tags have no methods", "a value tag is a field-less struct that erases at runtime; only a `trait` carries methods and dispatches", "make `{name}` a `trait` if `{method}` should dispatch, or remove the method to keep `{name}` a value tag")
}

parser_tag_error: fn(state: ^JetParserState, span: Span, what: String, why: String, fix: String) {
    parser_add_error_code(state, "E0734", span, what, why, fix)
}
