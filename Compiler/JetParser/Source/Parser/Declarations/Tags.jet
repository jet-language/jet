use jet_foundation.[
    Item,
    NamedSpan,
    Span,
    TagDef,
]
use jet_lexer.[
    TOKEN_COLON,
    TOKEN_COMMA,
    TOKEN_DOT,
    TOKEN_EOF,
    TOKEN_KW_FN,
    TOKEN_KW_TAG,
    TOKEN_LBRACE,
    TOKEN_LBRACKET,
    TOKEN_RBRACE,
    TOKEN_RBRACKET,
    TOKEN_SEMI,
]

fn parser_tag_decl_ahead(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_KW_TAG
}

fn parser_parse_tag_policy(state: &JetParserState, modifiers: ParsedItemModifiers) -> Item {
    start :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `tag`")
    deny := [NamedSpan]{}
    from := [NamedSpan]{}
    parser_expect(&state, TOKEN_LBRACE, "`{{` before a tag policy")
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parser_skip_semicolons(&state)
        if parser_current_kind(&state) == TOKEN_RBRACE -> break
        // A tag is a marker that erases at runtime; only a trait has methods.
        if parser_current_kind(&state) == TOKEN_KW_FN {
            parser_bump(&state)
            method :: parser_expect_name(&state, "after `fn`")
            tag_name :: parser_value(state, name)
            method_name :: parser_value(state, method)
            parser_add_error_code(&state, "E0732", method.span, "the tag `{tag_name}` declares a method `{method_name}`, but tags have no methods", "a `tag` is a marker that erases at runtime; only a `trait` carries methods and dispatches", "make `{tag_name}` a `trait` if `{method_name}` should dispatch, or remove the method to keep `{tag_name}` a marker tag")
            parser_sync_top(&state)
            return Item.Tag{value: TagDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: parser_value(state, name), name_span: name.span, deny: deny, from: from, span: parser_cover(start.span, method.span)}}
        }
        field :: parser_expect_name(&state, "for a tag policy field")
        parser_expect(&state, TOKEN_COLON, "after a tag policy field")
        values :: parser_tag_path_list(&state)
        if parser_value(state, field) == {
            "deny" -> {
                if deny.len() > 0 -> parser_tag_error(&state, field.span, "tag `deny` is repeated", "each tag policy field is declared once", "keep one `deny: [...]` field")
                deny = values
            }
            "from" -> {
                if from.len() > 0 -> parser_tag_error(&state, field.span, "tag `from` is repeated", "each tag policy field is declared once", "keep one `from: [...]` field")
                from = values
            }
            else -> parser_tag_error(&state, field.span, "unknown tag policy field", "tag bodies contain deny and from paths", "write `deny: [...]` or `from: [...]`")
        }
        if parser_current_kind(&state) == TOKEN_COMMA || parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` after a tag policy")
    if deny.len() == 0 -> parser_tag_error(&state, name.span, "a tag needs at least one denied destination", "an empty tag policy has no enforceable effect", "add a path to `deny: [...]`")
    Item.Tag{value: TagDef{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: parser_value(state, name), name_span: name.span, deny: deny, from: from, span: parser_cover(start.span, close.span)}}
}

fn parser_tag_path_list(state: &JetParserState) -> [NamedSpan] {
    parser_expect(&state, TOKEN_LBRACKET, "`[` before tag policy paths")
    paths := [NamedSpan]{}
    loop parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF {
        first :: parser_expect_name(&state, "in a tag policy path")
        path := parser_value(state, first)
        end := first.span
        loop parser_current_kind(&state) == TOKEN_DOT {
            parser_bump(&state)
            part :: parser_expect_name(&state, "after `.` in a tag policy path")
            path = "{path}.{parser_value(state, part)}"
            end = part.span
        }
        &paths.push(NamedSpan{name: path, span: parser_cover(first.span, end)})
        if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state) else -> break
    }
    parser_expect(&state, TOKEN_RBRACKET, "`]` after tag policy paths")
    paths
}

fn parser_tag_error(state: &JetParserState, span: Span, what: String, why: String, fix: String) {
    parser_add_error_code(&state, "E0734", span, what, why, fix)
}
