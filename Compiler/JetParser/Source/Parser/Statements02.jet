fn parser_retired_known_error(state: &JetParserState, span: Span, fix: String) {
    parser_add_error_code(&state, "E0377", span, "`#Known` is retired", "compile-time work carries the word `prep`, and a compile-time constant is `NAME :: prep {{ value }}`", fix)
}
