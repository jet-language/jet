// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1084
fn layout_anchor_method(field: String) -> String? Never! {
    if field == {
        "left" | "right" | "width" -> Val("h")
        "top" | "bottom" | "height" -> Val("v")
        else -> None
    }
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1102
fn desugar_layout_anchors(layout_name: String, stmt: &Stmt) -> Unit Never! {
    if stmt == {
        .Expr(e) | .DeferClose(e, _) -> desugar_layout_expr(layout_name, &e)
        .Val(binding) -> desugar_layout_expr(layout_name, &binding.init)
        else -> {}
    }
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:1110
fn desugar_layout_expr(layout_name: String, e: &Expr) -> Unit Never! {
    if e == .Field(base, field, field_span) && base == .Ident(box_name, ident_span) {
        if method := layout_anchor_method(field) {
            box :: if box_name == "self" -> ~layout_name else -> ~box_name
            anchor :: ~field
            span :: field_span
            name_span :: ident_span
            e = Expr.MethodCall{
                receiver: Expr.Ident{name: ~layout_name, span: name_span}, method: ^method, method_span: span,
                owner_type_args: [], type_args: [], args: [
                    CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart.Lit{text: ^box}], span: name_span}, span: name_span, flags: ast_empty_call_arg_flags(), label: None, spread: false},
                    CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart.Lit{text: ^anchor}], span: span}, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
                ], recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false
            }
            return
        }
    }
    if e == {
        .Binary(_, l, r, _) -> { desugar_layout_expr(layout_name, &l); desugar_layout_expr(layout_name, &r) }
        .Unary(_, x, _) -> desugar_layout_expr(layout_name, &x)
        .Field(base, _, _) -> desugar_layout_expr(layout_name, &base)
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _) -> {
            desugar_layout_expr(layout_name, &receiver)
            loop arg in &args -> desugar_layout_expr(layout_name, &arg.expr)
        }
        .Call(call) -> { loop arg in &call.args -> desugar_layout_expr(layout_name, &arg.expr) }
        else -> {}
    }
}
