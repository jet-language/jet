fn parser_take_mark(state: &JetParserState) -> Span {
    if parser_prep_verb_ahead(&state, 0, TOKEN_KW_IF) || parser_prep_verb_ahead(&state, 0, TOKEN_KW_LOOP) || parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) -> return parser_bump(&state).span
    if parser_at_known_lead(&state) {
        marker :: parser_read_marker_head(&state)
        token :: parser_current(&state)
        fix :: if token.kind == TOKEN_KW_IF -> "write `prep if <condition> {{ … }}`"
            else if token.kind == TOKEN_LBRACE -> "write `prep {{ … }}`"
            else if token.kind == TOKEN_IDENT {
                name :: canonical_name_case(token.payload.decoded, NameCase.Snake)
                "write `{name} :: prep {{ … }}`"
            } else -> "write a prepared value: `name :: prep {{ … }}`"
        parser_retired_known_error(&state, marker.span, fix)
        return marker.span
    }
    if parser_current_kind(&state) == TOKEN_KW_COMPTIME {
        span :: parser_bump(&state).span
        parser_add_error_code(&state, "E0374", span, "`comptime` is retired", "Jet folds ordinary foldable expressions automatically; explicit compile-time demand lives on the marker plane", "remove the keyword; a build-time value is written `name :: prep {{ … }}`, and `prep {{ … }}` runs other work while building")
        return span
    }
    if parser_current_kind(&state) == TOKEN_AT {
        if parser_kind_at(&state, 1) == TOKEN_KW_IF -> return parser_retired_at_verb(&state, "if")
        if parser_kind_at(&state, 1) == TOKEN_KW_LOOP -> return parser_retired_at_verb(&state, "loop")
        if parser_kind_at(&state, 1) == TOKEN_LBRACE -> return parser_retired_at_block(&state)
        return parser_bump(&state).span
    }
    parser_read_marker_head(&state).span
}
