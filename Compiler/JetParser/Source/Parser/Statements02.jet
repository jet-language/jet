// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:935
fn parser_report_retired_const_declaration(state: &JetParserState, old: String, new: String, name_span: Span, value: Expr, prepared: Bool, mutable: Bool) {
    value_span :: expr_span(value)
    if prepared || mutable {
        diagnostic :: diagnostic_from_registry("E0388", Val(name_span), "`{old}` is retired; write `{new}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{old}` with `{new}`")
        &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: name_span, new_text: ~new}))
        return
    }
    if !state.source.is_empty() && value_span.start >= 0 && value_span.end <= state.source.len() {
        text :: String.from_bytes(state.source.slice(value_span.start, value_span.end)) ?? ""
        replacement :: "{new} :: prep {{ {text} }}"
        diagnostic :: diagnostic_from_registry("E0388", Val(name_span), "`{old}` is retired; write `{replacement}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{old}` with `{replacement}`")
        &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: name_span.start, end: value_span.end}, new_text: replacement}))
    } else {
        parser_add_error_code(&state, "E0388", name_span, "`{old}` is retired; write `{new} :: prep {{ … }}`", "compile time is always explicit, `NAME :: prep {{ value }}`; prefix `@` now marks a live link", "replace `{old}` with `{new} :: prep {{ … }}`")
    }
}
