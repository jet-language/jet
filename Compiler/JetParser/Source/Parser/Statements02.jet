fn parser_binding_value(state: &JetParserState, mutable: Bool) -> (value: Expr, prepared: Bool)? {
    if mutable || !parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) {
        value :: parser_parse_expression(&state, 1, 0)
        if parser_aborting(&state) -> return None
        return Val((value.expr, false))
    }
    if state.prep_value_block == Val((_, statements_depth)) && statements_depth == state.block_depth && state.position >= 2 {
        binding_start :: state.position - 2
        if state.tokens[binding_start].kind == TOKEN_IDENT && state.tokens[binding_start + 1].kind == TOKEN_COLON_COLON {
            state.prep_value_escape = Val(binding_start)
            parser_add_fatal_code(&state, "E0391", parser_current(&state).span,
                "`prep {{ … }}` is used as a value, which this compiler does not support yet",
                "D-PREP-SURFACE2=A makes the block's final expression its value; only a block holding a single final expression is folded today",
                "write `name :: prep {{ value }}` with one final expression, or a `prep {{ … }}` statement")
            return None
        }
    }
    start :: parser_bump(&state).span.start
    open_span :: parser_current(&state).span
    saved_block :: state.prep_value_block
    state.prep_value_block = Val((open_span, state.block_depth + 1))
    diags_before :: state.diagnostics.len()
    block :: parser_parse_value_block(&state, 0, true)
    state.prep_value_block = saved_block
    if binding_start := state.prep_value_escape {
        state.prep_value_escape = None
        loop state.diagnostics.len() > diags_before -> _ :: &state.diagnostics.pop()
        return Val((parser_unclosed_prep_value(&state, open_span, binding_start), true))
    }
    if parser_aborting(&state) -> return None
    if block.statements.is_empty() && block.tail == Val(value) -> return Val((^value, true))
    parser_add_fatal_code(&state, "E0391", Span{start: start, end: parser_previous_end(state)},
        "`prep {{ … }}` is used as a value, which this compiler does not support yet",
        "D-PREP-SURFACE2=A makes the block's final expression its value; only a block holding a single final expression is folded today",
        "write `name :: prep {{ value }}` with one final expression, or a `prep {{ … }}` statement")
    None
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:831
fn parser_unclosed_prep_value(state: &JetParserState, open_span: Span, binding_start: Int) -> Expr {
    state.position = binding_start
    if binding_start > 0 && state.tokens[binding_start - 1].kind == TOKEN_SEMI -> state.position = binding_start - 1
    token :: state.tokens[binding_start]
    name :: if token.kind == TOKEN_IDENT -> token.payload.decoded else -> ""
    opener :: parser_synthetic_token(TOKEN_LBRACE, open_span)
    // Canonical unclosed reporting owns E0083 and its optional source-line detail.
    parser_report_unclosed(&state, opener, "the binding `{name}`", "prepared value")
    Expr.Unit{span: open_span}
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:860
fn parser_retired_at_verb(state: &JetParserState, verb: String) -> Span {
    at :: parser_bump(&state).span
    head :: parser_cover(at, parser_current(&state).span)
    old :: "@{verb}"
    new :: "prep {verb}"
    diagnostic :: diagnostic_from_registry("E0388", Val(head), "`{old}` is retired; write `{new}`", "build-time blocks, branches, loops and functions carry the word `prep`, the same word Jet uses for every build-time step; the meaning and the checks are unchanged", "replace `{old}` with `{new}`")
    &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: at, new_text: "prep "}))
    at
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:879
fn parser_retired_at_block(state: &JetParserState) -> Span {
    at :: parser_bump(&state).span
    head :: parser_cover(at, parser_current(&state).span)
    diagnostic :: diagnostic_from_registry("E0388", Val(head), "`@ {{ … }}` is retired; write `prep {{ … }}`", "build-time blocks, branches, loops and functions carry the word `prep`, the same word Jet uses for every build-time step; the meaning and the checks are unchanged", "replace `@ {{ … }}` with `prep {{ … }}`")
    &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: at, new_text: "prep"}))
    at
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:900
fn parser_retired_const_name(state: &JetParserState, name: String, read: Bool) -> String? Never! {
    new :: retired_constant_respelling(name) ?? return None
    bytes :: name.bytes()
    rest := name.slice(1, bytes.len()) // #4303
    if state.block_depth == 0 || (read && parser_constant_name(rest)) -> return Val(^new)
    Val(canonical_name_case(new, NameCase.Snake))
}
