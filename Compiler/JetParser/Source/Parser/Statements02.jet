fn parser_at_known_lead(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == "Known"
}
