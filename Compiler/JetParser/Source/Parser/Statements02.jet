// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:307
fn parser_expect_bind_sigil(state: &JetParserState) -> (mutable: Bool, span: Span)? {
    token :: parser_current(&state)
    if token.kind == TOKEN_COLON_COLON || token.kind == TOKEN_COLON_EQ {
        parser_bump(&state)
        return Val((token.kind == TOKEN_COLON_EQ, token.span))
    }
    parser_add_fatal_code(&state, "E0003", token.span,
        "expected `::` or `:=` in a binding, found {parser_describe_token(token)}",
        "a binding is `name :: value` (immutable) or `name := value` (mutable)",
        "write `name :: value`")
    None
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:342
fn parser_looks_like_sigil_binding(state: &JetParserState) -> Bool Never! {
    kind :: parser_current_kind(&state)
    second :: parser_kind_at(&state, 1)
    if (kind == TOKEN_IDENT || kind == TOKEN_KW_SELF) && (second == TOKEN_COLON_COLON || second == TOKEN_COLON_EQ || second == TOKEN_COLON) -> return true
    if kind == TOKEN_LBRACKET || kind == TOKEN_LPAREN -> return parser_pattern_target_is_binding(&state)
    if kind == TOKEN_IDENT && second == TOKEN_LBRACE -> return parser_pattern_target_is_binding(&state)
    if kind == TOKEN_IDENT && second == TOKEN_DOT && parser_kind_at(&state, 2) == TOKEN_LBRACE -> return parser_pattern_target_is_binding_dot(&state)
    false
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:375
fn parser_pattern_target_is_binding(state: &JetParserState) -> Bool Never! {
    i := state.position
    if i < state.tokens.len() && state.tokens[i].kind == TOKEN_IDENT -> i += 1
    if i >= state.tokens.len() -> return false
    open :: state.tokens[i].kind
    close :: if open == { TOKEN_LBRACKET -> TOKEN_RBRACKET, TOKEN_LBRACE -> TOKEN_RBRACE, TOKEN_LPAREN -> TOKEN_RPAREN, else -> return false }
    depth := 0
    loop i < state.tokens.len() {
        kind :: state.tokens[i].kind
        if kind == open -> depth += 1
        else if kind == close {
            depth -= 1
            if depth == 0 -> return i + 1 < state.tokens.len() && (state.tokens[i + 1].kind == TOKEN_COLON_COLON || state.tokens[i + 1].kind == TOKEN_COLON_EQ)
        }
        i += 1
    }
    false
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:409
fn parser_pattern_target_is_binding_dot(state: &JetParserState) -> Bool Never! {
    i := state.position
    if i < state.tokens.len() && state.tokens[i].kind == TOKEN_IDENT -> i += 1
    if i < state.tokens.len() && state.tokens[i].kind == TOKEN_DOT -> i += 1
    if i >= state.tokens.len() || state.tokens[i].kind != TOKEN_LBRACE -> return false
    depth := 0
    loop i < state.tokens.len() {
        kind :: state.tokens[i].kind
        if kind == TOKEN_LBRACE -> depth += 1
        else if kind == TOKEN_RBRACE {
            depth -= 1
            if depth == 0 -> return i + 1 < state.tokens.len() && (state.tokens[i + 1].kind == TOKEN_COLON_COLON || state.tokens[i + 1].kind == TOKEN_COLON_EQ)
        }
        i += 1
    }
    false
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:447
fn parser_try_bind_pattern(state: &JetParserState) -> BindPattern? {
    kind :: parser_current_kind(&state)
    if kind == TOKEN_LBRACKET || (kind == TOKEN_LPAREN && !parser_looks_like_named_tuple(&state, false)) {
        start :: parser_bump(&state).span
        close :: if kind == TOKEN_LBRACKET -> TOKEN_RBRACKET else -> TOKEN_RPAREN
        context :: if kind == TOKEN_LBRACKET -> "for a list-pattern binding" else -> "for a tuple-pattern binding"
        elems := [BindName]{}
        if parser_current_kind(&state) != close {
            loop {
                name :: parser_expect_name(&state, context)
                if parser_aborting(&state) -> return None
                &elems.push(BindName{name: name.payload.decoded, span: name.span, rename: None})
                if parser_current_kind(&state) == TOKEN_COMMA { parser_bump(&state); next }
                break
            }
        }
        end :: parser_current(&state).span
        parser_expect(&state, close, if kind == TOKEN_LBRACKET -> "to close the list pattern" else -> "to close the tuple pattern")
        if parser_aborting(&state) -> return None
        span :: parser_cover(start, end)
        if kind == TOKEN_LBRACKET -> Val(BindPattern.List{elems: ^elems, span: span}) else -> Val(BindPattern.Tuple{elems: ^elems, span: span})
    } else if kind == TOKEN_IDENT && (parser_kind_at(&state, 1) == TOKEN_LBRACE || (parser_kind_at(&state, 1) == TOKEN_DOT && parser_kind_at(&state, 2) == TOKEN_LBRACE)) {
        type_name :: parser_expect_name(&state, "for a struct pattern")
        if parser_current_kind(&state) == TOKEN_DOT {
            dot :: parser_bump(&state)
            name :: type_name.payload.decoded
            // migration_mode is the canonical retained parser option.
            if !state.migration_mode {
                parser_add_fatal_code(&state, "E0320", dot.span, "struct pattern uses `{name}{{…}}`, not `{name}.{{…}}`", "literal heads place no dot before their brace (D-LIT-DOT1)", "write `{name}{{…}}`")
                return None
            }
            parser_add_error_code(&state, "E0320", dot.span, "struct pattern uses `{name}{{…}}`, not `{name}.{{…}}`", "literal heads place no dot before their brace (D-LIT-DOT1)", "write `{name}{{…}}`")
        }
        parser_expect(&state, TOKEN_LBRACE, "to open the struct pattern")
        (fields, rest) :: parser_struct_pattern_fields(&state)
        end :: parser_current(&state).span
        parser_expect(&state, TOKEN_RBRACE, "to close the struct pattern")
        if parser_aborting(&state) -> return None
        Val(BindPattern.Struct{type_name: type_name.payload.decoded, type_span: type_name.span, fields: ^fields, rest: rest, span: parser_cover(type_name.span, end)})
    } else -> None
}
// Rust: crates/jet-parser/src/Parser/Statements/bindings.rs:558
fn parser_struct_pattern_fields(state: &JetParserState) -> (fields: [BindName], rest: Span?) {
    fields := [BindName]{}
    rest := Span?{None}
    if parser_current_kind(&state) != TOKEN_RBRACE {
        loop {
            if parser_current_kind(&state) == TOKEN_DOT_DOT { rest = Val(parser_bump(&state).span); break }
            name :: parser_expect_name(&state, "for a struct-pattern field")
            if parser_aborting(&state) -> break
            rename := BindNameRename?{None}
            if parser_current_kind(&state) == TOKEN_COLON {
                parser_bump(&state)
                target :: parser_expect_name(&state, "as the renamed binding")
                if parser_aborting(&state) -> break
                rename = Val(BindNameRename{name: target.payload.decoded, span: target.span})
            }
            &fields.push(BindName{name: name.payload.decoded, span: name.span, rename: rename})
            if parser_current_kind(&state) == TOKEN_COMMA {
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_RBRACE -> break
                next
            }
            break
        }
    }
    (^fields, rest)
}
