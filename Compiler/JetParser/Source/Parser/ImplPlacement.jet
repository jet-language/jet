// Impl placement (L0535, #6561): a struct or enum holds its own impls, so a
// top-level `impl T` or `impl T.Trait` in the file that declares `T` is a
// finding unless one of the exception rules keeps it outside. `jet check
// --style`, `jet fix --style` and the repository guard
// tests/guards/impl_placement all call this one rule.
use {
    jet_foundation.[DIAGNOSTIC_ERROR, Diagnostic, ImplDef, MARKER_TARGET, Program, Span, diagnostic_from_registry]
}

// Why a top-level impl stays outside its type's body. Two exceptions need no
// rule here: a type declared in another file, module or package (a) has no
// body in this file, and an error conversion `impl A -> B` (b) parses as its
// own item, never an impl. The body holds every other impl form, `using`
// delegation and operator impls included, so no rule names a form the body
// cannot hold.
JetParserImplPlacementRule: enum {
    // (c) `impl X.Client` or `impl X.Server`: a protocol side.
    ProtocolSide
    // (d) `#Target(OS.…)`: an impl for one target.
    TargetSpecific
    // (e) an impl a derive writes; a generated source file is never read.
    Generated
    // (f) an impl whose head already carries an error of the same check:
    // that error is the finding, and the head may not name the type at all.
    HeadError
    // (g) an inherent impl with its own markers, which in the body would
    // become the type's markers.
    MarkedInherent
    // (h) a conditional impl, `impl Pair<T: Priced>.Describe`: a nested
    // impl applies wherever its type does, so it cannot state the bounds.
    Conditional
}

// L0535 for each top-level impl of a struct or enum the same program
// declares that no exception rule keeps outside the body. `source` is the
// parsed text and `diagnostics` the check's own reports on it so far; an
// error inside an impl's head keeps that impl out (rule f).
parser_impl_placement_lints: fn(program: Program, source: [U8], diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    declared := [String:Bool]{}
    loop item in program.items {
        if item == {
            .Struct(value) -> declared[value.name] = true
            .Enum(value) -> declared[value.name] = true
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    found := [Diagnostic]{}
    loop item in program.items {
        if item == .Impl(value) {
            if !declared.has_key(value.type_name) || parser_impl_placement_rule(value, source, diagnostics) != None -> next
            head: if value.trait_name == .Val(name) -> "{value.type_name}.{name}" else -> value.type_name.copy()
            span: Span{start: value.span.start, end: (value.trait_span ?? value.type_span).end}
            found.push(diagnostic_from_registry("L0535", Val(span), "`impl {head}` sits outside the body of `{value.type_name}`", "`{value.type_name}` is declared in this file, and a struct or enum holds its own impls; a top-level impl stays only where it has to be somewhere else", "Move it into the body of `{value.type_name}`: its methods as `fn` members, a trait impl as a nested `impl Trait {{ … }}`"))
        }
    }
    found
}

// The exception rule that keeps `value` outside its type's body, if any:
// the head error rule (f) first, then the rules of the impl's own form.
parser_impl_placement_rule: fn(value: ImplDef, source: [U8], diagnostics: [Diagnostic]) -> JetParserImplPlacementRule? Never! {
    // The head runs from `impl` to the end of the line its type (or trait)
    // name ends on.
    head_end := (value.trait_span ?? value.type_span).end
    loop head_end < source.len() && source[head_end] != 10 -> head_end += 1
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if diagnostic.span == .Val(at) && at.start >= value.span.start && at.start <= head_end -> return Val(JetParserImplPlacementRule.HeadError)
    }
    parser_impl_placement_exception(value)
}

// The exception rule of the impl's own form that keeps `value` outside its
// type's body, if any.
parser_impl_placement_exception: fn(value: ImplDef) -> JetParserImplPlacementRule? Never! {
    if value.type_name.ends_with(".Client") || value.type_name.ends_with(".Server") -> return Val(JetParserImplPlacementRule.ProtocolSide)
    if value.os_target != None -> return Val(JetParserImplPlacementRule.TargetSpecific)
    loop marker in value.markers {
        if marker.name == MARKER_TARGET -> return Val(JetParserImplPlacementRule.TargetSpecific)
    }
    if value.is_generated_serde -> return Val(JetParserImplPlacementRule.Generated)
    if value.trait_name == None && value.markers.len() > 0 -> return Val(JetParserImplPlacementRule.MarkedInherent)
    if value.type_params.len() > 0 -> return Val(JetParserImplPlacementRule.Conditional)
    None
}
