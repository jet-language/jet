// enums_traits extends the canonical Parser/Items declaration grammar.
// Existing grammar bodies stay in Items.jet; genuine missing projections and
// lookahead helpers live here, without introducing another parser/AST universe.
use jet_foundation.[EnumDef, Item, Marker, OperatorMarker, Span]
use jet_foundation.Policy.[RuleSite]
use jet_lexer.[Token, TOKEN_BANG, TOKEN_HASH, TOKEN_IDENT, TOKEN_KW_ENUM, TOKEN_KW_IMPL, TOKEN_KW_PUB, TOKEN_KW_STRUCT, TOKEN_LBRACKET, TOKEN_LPAREN, TOKEN_RBRACKET, TOKEN_RPAREN, TOKEN_SEMI]

// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:10
// Canonical owner: Items.jet::parser_parse_enum; EnumDef is assembled by ast_enum.
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:85
// Canonical owner: Items.jet::parser_parse_variant_entry; groups and leaves stay
// in EnumDef.groups/variants. Attach rule targets through the helper below.
fn parser_bind_variant_marker_facts(state: &JetParserState, markers: [Marker], name_span: Span) {
    loop marker in markers -> parser_bind_rule_fact(&state, marker.name_span, Val(name_span), RuleSite.Variant)
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:186
// Canonical owner: Items.jet::parser_parse_variant_payload; named fields and the
// one positional payload are VariantPayload.Named/Single, not new carriers.
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:245
// Canonical owner: Items.jet::parser_parse_operator_rhs; only Add/Sub/Mul/Div
// admit an explicit RHS, preserving all three teaching diagnostics.

// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:289
fn parser_operator_marker_from_markers(markers: [Marker]) -> OperatorMarker? Never! {
    loop marker in markers {
        if marker.name == "Commutative" -> return Val(OperatorMarker.Commutative)
    }
    None
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:298
fn parser_bind_operator_marker_facts(state: &JetParserState, markers: [Marker], target: Span) {
    loop marker in markers -> parser_bind_rule_fact(&state, marker.name_span, Val(target), RuleSite.Impl)
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:310
// Canonical owner: Items.jet::parser_parse_impl. The Type.Literal.Int/Float,
// Client/Server inherent, dotted trait, retired colon, error conversion,
// delegation, associated type and method branches remain at that owner.

// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:508
fn parser_os_gated_impl(state: &JetParserState, os: String) -> Item? {
    parser_skip_semicolons(&state)
    if parser_current_kind(&state) != TOKEN_KW_IMPL {
        parser_add_fatal_code(&state, "E0003", parser_current(&state).span,
            "`#Target(OS.{os})` isn't valid here",
            "`OS.Linux`/`OS.MacOS`/`OS.Windows` gates a whole `impl` block, not a module, function, or any other item",
            "write `#Target(OS.{os}) impl Type.Trait {{ … }}`")
        return None
    }
    item := parser_parse_impl(&state)
    if parser_aborting(&state) -> return None
    if item == {
        .Impl(value) -> { value.os_target = Val(~os); Val(Item.Impl{value: ^value}) }
        .ErrorConv(value) -> {
            parser_add_fatal_code(&state, "E0003", value.from_span,
                "`#Target(OS.{os})` isn't valid on an error-conversion `impl`",
                "`impl Source -> Target {{ … }}` error conversions run on every platform; OS gating only makes sense for a real trait/inherent impl",
                "remove the `#Target(OS.{os})` marker")
            None
        }
        else -> Val(^item)
    }
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:544
// Canonical owner: Items.jet::parser_parse_trait_impl_block; NamedType carries
// associated-type spans and the canonical TraitImplBlock carries methods/RHS.
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:597
// Canonical owner: Items.jet::parser_report_retired_derive_line (E0922/E0929).

// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:614
fn parser_at_marker_list(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_LBRACKET
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:619
fn parser_at_single_type_marker(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    offset :: if parser_kind_at(&state, 1) == TOKEN_BANG -> 2 else -> 1
    token :: parser_lookahead(&state, offset)
    if token.kind != TOKEN_IDENT -> return false
    name :: token.payload.decoded
    if !parser_is_pascal_type_marker_name(name) || parser_is_reserved_item_rule_prefix(name) -> return false
    parser_type_marker_prefix_leads_to_type_def(&state, state.position + offset + 1)
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:640
fn parser_is_pascal_type_marker_name(name: String) -> Bool Never! {
    // Rust uses Unicode uppercase, unlike Patterns.jet's ASCII type-name probe.
    for character in name.chars() -> return character.is_uppercase()
    false
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:646
fn parser_is_reserved_item_rule_prefix(name: String) -> Bool Never! {
    name == "Test" || name == "Unsafe" || name == "Reactive" || name == "Pure" || name == "Sanitizer" || name == "State" || name == "Transition" || name == "PubFile" || name == "UnitFamily" || name == "Layout" || name == "PublishedSchema" || name == "SingleUse" || name == "MustUse" || name == "Import" || name == "Bindgen" || name == "Target" || name == "WasmExport"
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:670
fn parser_type_marker_prefix_leads_to_type_def(state: &JetParserState, start: Int) -> Bool Never! {
    i := start
    if i >= state.tokens.len() -> return false
    i = parser_skip_balanced_parens(state.tokens, i) ?? return false
    loop {
        loop i < state.tokens.len() && state.tokens[i].kind == TOKEN_SEMI -> i += 1
        if i >= state.tokens.len() -> return false
        if state.tokens[i].kind != TOKEN_HASH -> break
        if i + 1 >= state.tokens.len() -> break
        token :: state.tokens[i + 1]
        if token.kind == TOKEN_LBRACKET {
            i = parser_skip_bracket_group(state.tokens, i + 1) ?? return false
        } else if token.kind == TOKEN_IDENT && parser_is_pascal_type_marker_name(token.payload.decoded) {
            i += 2
            i = parser_skip_balanced_parens(state.tokens, i) ?? return false
        } else -> break
    }
    if i < state.tokens.len() && state.tokens[i].kind == TOKEN_KW_PUB -> i += 1
    i < state.tokens.len() && (state.tokens[i].kind == TOKEN_KW_STRUCT || state.tokens[i].kind == TOKEN_KW_ENUM)
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:721
fn parser_skip_balanced_parens(tokens: [Token], start: Int) -> Int? Never! {
    i := start
    if i >= tokens.len() || tokens[i].kind != TOKEN_LPAREN -> return Val(i)
    depth := 0
    loop {
        if i >= tokens.len() -> return None
        if tokens[i].kind == TOKEN_LPAREN -> depth += 1
        else if tokens[i].kind == TOKEN_RPAREN {
            depth = (depth - 1).max(0)
            if depth == 0 -> return Val(i + 1)
        }
        i += 1
    }
}
// Rust: crates/jet-parser/src/Parser/Items/enums_traits.rs:747
fn parser_skip_bracket_group(tokens: [Token], start: Int) -> Int? Never! {
    assert(tokens[start].kind == TOKEN_LBRACKET)
    i := start
    depth := 0
    loop {
        if i >= tokens.len() -> return None
        if tokens[i].kind == TOKEN_LBRACKET -> depth += 1
        else if tokens[i].kind == TOKEN_RBRACKET {
            depth = (depth - 1).max(0)
            if depth == 0 -> return Val(i + 1)
        }
        i += 1
    }
}
