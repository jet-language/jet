fn suffix_optional_typed_head_ahead(state: &JetParserState) -> Bool Never! {
    index := state.position
    if index >= state.tokens.len() || state.tokens[index].kind != TOKEN_IDENT -> return false
    last_segment := index
    index += 1
    while index + 1 < state.tokens.len() && state.tokens[index].kind == TOKEN_DOT && state.tokens[index + 1].kind == TOKEN_IDENT {
        last_segment = index + 1
        index += 2
    }
    first :: state.tokens[last_segment].payload.decoded.chars().next() ?? return false
    if !first.is_uppercase() -> return false
    if index < state.tokens.len() && state.tokens[index].kind == TOKEN_LT {
        depth := 0
        loop {
            if index >= state.tokens.len() -> return false
            kind :: state.tokens[index].kind
            if kind == {
                TOKEN_LT -> { depth += 1 }
                TOKEN_GT -> { depth -= 1 }
                TOKEN_SHR -> { depth -= 2 }
                TOKEN_IDENT | TOKEN_COMMA | TOKEN_DOT | TOKEN_QUESTION | TOKEN_LBRACKET | TOKEN_RBRACKET | TOKEN_COLON -> {}
                _ -> return false
            }
            index += 1
            if depth <= 0 -> break
        }
        if depth != 0 -> return false
    }
    index + 1 < state.tokens.len() && state.tokens[index].kind == TOKEN_QUESTION && state.tokens[index + 1].kind == TOKEN_LBRACE
}
