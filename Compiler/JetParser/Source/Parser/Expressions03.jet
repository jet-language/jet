// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:9
fn brace_body_looks_like_fields(toks: View<Token>, pos: Int) -> Bool Never! {
    first :: toks.get(pos) ?? return false
    if first.kind == TOKEN_RBRACE -> return true
    if first.kind != TOKEN_IDENT -> return false
    next :: toks.get(pos + 1) ?? return false
    next.kind == TOKEN_COLON || next.kind == TOKEN_COMMA || next.kind == TOKEN_SEMI || next.kind == TOKEN_RBRACE
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:20
fn brace_body_looks_like_record(toks: View<Token>, pos: Int) -> Bool Never! {
    if brace_body_looks_like_fields(toks, pos) -> return true
    first :: toks.get(pos) ?? return false
    next :: toks.get(pos + 1) ?? return false
    (first.kind == TOKEN_STRING || first.kind == TOKEN_RAW_STRING) && next.kind == TOKEN_COLON
}
