// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:274
fn typed_lit_body_for_head(state: &JetParserState, head: Type, depth: Int) -> TypedLitBody {
    parser_expect(state, TOKEN_LBRACE, "to open a typed literal")
    if parser_current_kind(state) == TOKEN_RBRACE {
        parser_bump(state)
        return TypedLitBody.Empty
    }
    if head == {
        .Map(_, _, _) -> return finish_typed_lit_entries(state, depth)
        .List(_) | .FixedList(_, _) -> {
            if parser_typed_literal_byte_head(Val(head)) &&
                (parser_current_kind(state) == TOKEN_STRING || parser_current_kind(state) == TOKEN_RAW_STRING) &&
                parser_kind_at(state, 1) == TOKEN_RBRACE -> return finish_byte_text(state, depth)
            return finish_typed_lit_elements(state, depth)
        }
        .Named(name) -> {
            if name == "Layout" -> return finish_typed_lit_elements(state, depth)
            if brace_body_looks_like_fields(state.tokens.view(), state.position) -> return TypedLitBody.Fields{fields: finish_struct_fields_already_open(state, depth)}
        }
        .Apply(_, _) -> {
            if brace_body_looks_like_fields(state.tokens.view(), state.position) -> return TypedLitBody.Fields{fields: finish_struct_fields_already_open(state, depth)}
        }
        _ -> {}
    }
    value :: parser_parse_expression(state, 1, depth + 1)
    parser_literal_close_terminators(state)
    parser_expect(state, TOKEN_RBRACE, "to close a typed literal")
    TypedLitBody.Value{value: value.expr}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:311
fn finish_byte_text(state: &JetParserState, depth: Int) -> TypedLitBody {
    token :: parser_current(state)
    interpolated := false
    loop part in token.payload.string_parts {
        if part.kind == STRING_PART_INTERPOLATION -> interpolated = true
    }
    if interpolated {
        value :: parser_parse_string(state, depth + 1)
        parser_literal_close_terminators(state)
        parser_expect(state, TOKEN_RBRACE, "to close a typed literal")
        return TypedLitBody.Value{value: value.expr}
    }
    parser_bump(state)
    parts := [ByteTextPart]{}
    if token.kind == TOKEN_RAW_STRING {
        parts.push(ByteTextPart.Lit{text: token.payload.decoded})
    } else {
        loop part in token.payload.string_parts {
            if part.kind == {
                STRING_PART_TEXT -> parts.push(ByteTextPart.Lit{text: part.text})
                STRING_PART_BYTE -> parts.push(ByteTextPart.Byte{value: part.byte as U8})
                _ -> panic("interpolation handled above")
            }
        }
    }
    parser_literal_close_terminators(state)
    parser_expect(state, TOKEN_RBRACE, "to close a typed literal")
    TypedLitBody.ByteText{parts: ^parts}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:340
fn finish_typed_lit_elements(state: &JetParserState, depth: Int) -> TypedLitBody {
    elems := [Expr]{list_elem(state, depth).expr}
    while !parser_aborting(state) && parser_current_kind(state) == TOKEN_COMMA {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        elems.push(list_elem(state, depth).expr)
    }
    parser_literal_close_terminators(state)
    parser_expect(state, TOKEN_RBRACE, "to close a typed literal")
    TypedLitBody.Elements{elements: ^elems}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:354
fn finish_typed_lit_entries(state: &JetParserState, depth: Int) -> TypedLitBody {
    key :: parser_parse_expression(state, 1, depth + 1)
    if parser_current_kind(state) == TOKEN_RBRACE || parser_current_kind(state) == TOKEN_SEMI {
        parser_literal_close_terminators(state)
        if parser_current_kind(state) == TOKEN_RBRACE {
            parser_bump(state)
            return TypedLitBody.Value{value: key.expr}
        }
    }
    parser_expect(state, TOKEN_COLON, "between a map key and its value")
    value :: parser_parse_expression(state, 1, depth + 1)
    entries := [ExprPair]{ExprPair{key: key.expr, value: value.expr}}
    while !parser_aborting(state) && parser_current_kind(state) == TOKEN_COMMA {
        parser_bump(state)
        if parser_current_kind(state) == TOKEN_RBRACE -> break
        next_key :: parser_parse_expression(state, 1, depth + 1)
        parser_expect(state, TOKEN_COLON, "between a map key and its value")
        next_value :: parser_parse_expression(state, 1, depth + 1)
        entries.push(ExprPair{key: next_key.expr, value: next_value.expr})
    }
    parser_literal_close_terminators(state)
    parser_expect(state, TOKEN_RBRACE, "to close a typed map literal")
    TypedLitBody.Entries{entries: ^entries}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:383
fn finish_struct_fields_already_open(state: &JetParserState, depth: Int) -> [ExprField] {
    fields := [ExprField]{}
    while !parser_aborting(state) && parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
        if parser_current_kind(state) == TOKEN_SEMI {
            parser_bump(state)
            continue
        }
        if parser_state_section_ahead(state) {
            section_start :: parser_current(state).span
            section :: parser_parse_state_section(state, "", section_start)
            parser_report_ineligible_state_section(state, section, "anonymous shape")
            state.abort_mark = state.diagnostics.len()
            state.abort_position = state.position
            return ^fields
        }
        token :: parser_expect_name(state, "for a field name")
        value := Expr.Ident{name: token.payload.decoded, span: token.span}
        if parser_current_kind(state) == TOKEN_COLON {
            parser_bump(state)
            value = parser_parse_expression(state, 1, depth + 1).expr
        }
        fields.push(ExprField{name: token.payload.decoded, name_span: token.span, value: value})
        if parser_current_kind(state) == TOKEN_COMMA -> parser_bump(state)
    }
    if !parser_aborting(state) -> parser_bump(state)
    ^fields
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:419
fn typed_lit_after_type(state: &JetParserState, head: Type, start_span: Span, depth: Int) -> ParsedExpr {
    body :: typed_lit_body_for_head(state, head, depth)
    span :: parser_cover(start_span, parser_lookahead(state, -1).span)
    ParsedExpr{expr: Expr.TypedLit{head: Val(head), body: body, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:434
fn list_elem(state: &JetParserState, depth: Int) -> ParsedExpr {
    if parser_current_kind(state) == TOKEN_DOT_DOT_DOT {
        start :: parser_bump(state).span
        inner :: parser_parse_expression(state, 1, depth + 1)
        span :: parser_cover(start, inner.span)
        return ParsedExpr{expr: Expr.Spread{value: inner.expr, span: span}, span: span}
    }
    parser_parse_expression(state, 1, depth + 1)
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:444
fn struct_lit_after_name(state: &JetParserState, type_name: String, type_args: [Type], start_span: Span, depth: Int) -> ParsedExpr {
    head := jet_foundation.AST.numeric_type_from_name(type_name)
    if head == None {
        if type_name == "Bool" -> head = Val(Type.Bool)
        if type_name == "String" -> head = Val(Type.String)
        if type_name == "Char" -> head = Val(Type.Char)
    }
    if head != None || !brace_body_looks_like_fields(state.tokens.view(), state.position + 1) {
        ty :: head ?? if type_args.is_empty() { Type.Named{name: type_name} } else { Type.Apply{name: type_name, args: type_args} }
        return typed_lit_after_type(state, ty, start_span, depth)
    }
    parser_expect(state, TOKEN_LBRACE, "to open a struct literal")
    fields :: finish_struct_fields_already_open(state, depth)
    span :: parser_cover(start_span, parser_lookahead(state, -1).span)
    ParsedExpr{expr: Expr.StructLit{type_name: type_name, type_args: type_args, import_ns: None,
        as_trait: None, fields: fields, inferred: false, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:490
fn struct_lit_after_path(state: &JetParserState, type_name: String, type_args: [Type], start_span: Span, depth: Int) -> ParsedExpr {
    if type_name.split_once('.') == .Val(parts) {
        (import_ns, local_name) :: parts
        first :: import_ns.chars().next()
        if first == .Val(ch) && ch.is_ascii_lowercase() -> return struct_lit_after_import(state, import_ns.to_string(), local_name.to_string(), start_span.start, depth)
    }
    struct_lit_after_name(state, type_name, type_args, start_span, depth)
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:512
fn struct_lit_after_import(state: &JetParserState, alias: String, type_name: String, start: Int, depth: Int) -> ParsedExpr {
    start_span :: Span{start: start, end: start}
    if !brace_body_looks_like_fields(state.tokens.view(), state.position + 1) {
        return typed_lit_after_type(state, Type.Named{name: "{alias}.{type_name}"}, start_span, depth)
    }
    parser_expect(state, TOKEN_LBRACE, "to open a struct literal")
    fields :: finish_struct_fields_already_open(state, depth)
    span :: parser_cover(start_span, parser_lookahead(state, -1).span)
    ParsedExpr{expr: Expr.StructLit{type_name: type_name, type_args: [], import_ns: Val(alias),
        as_trait: None, fields: fields, inferred: false, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:551
fn struct_lit_inferred(state: &JetParserState, dot_start: Int, depth: Int) -> ParsedExpr {
    open :: parser_expect(state, TOKEN_LBRACE, "to open an inferred struct literal")
    start :: Span{start: dot_start, end: open.span.end}
    if parser_state_section_ahead(state) {
        section :: parser_parse_state_section(state, "", parser_current(state).span)
        parser_report_ineligible_state_section(state, section, "anonymous shape")
        if parser_current_kind(state) == TOKEN_RBRACE -> parser_bump(state)
        state.abort_mark = state.diagnostics.len()
        state.abort_position = state.position
        span :: parser_cover(start, parser_lookahead(state, -1).span)
        return ParsedExpr{expr: Expr.StructLit{type_name: "", type_args: [], import_ns: None,
            as_trait: None, fields: [], inferred: true, span: span}, span: span}
    }
    if brace_body_looks_like_fields(state.tokens.view(), state.position) {
        fields :: finish_struct_fields_already_open(state, depth)
        span :: parser_cover(start, parser_lookahead(state, -1).span)
        return ParsedExpr{expr: Expr.StructLit{type_name: "", type_args: [], import_ns: None,
            as_trait: None, fields: fields, inferred: true, span: span}, span: span}
    }
    first :: list_elem(state, depth)
    parser_literal_close_terminators(state)
    body := TypedLitBody.Value{value: first.expr}
    if parser_current_kind(state) == TOKEN_COLON {
        parser_bump(state)
        value :: parser_parse_expression(state, 1, depth + 1)
        entries := [ExprPair]{ExprPair{key: first.expr, value: value.expr}}
        while !parser_aborting(state) && parser_current_kind(state) == TOKEN_COMMA {
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RBRACE -> break
            key :: parser_parse_expression(state, 1, depth + 1)
            parser_expect(state, TOKEN_COLON, "between a map key and its value")
            next_value :: parser_parse_expression(state, 1, depth + 1)
            entries.push(ExprPair{key: key.expr, value: next_value.expr})
        }
        body = TypedLitBody.Entries{entries: ^entries}
    } else if parser_current_kind(state) != TOKEN_RBRACE {
        elems := [Expr]{first.expr}
        while !parser_aborting(state) && parser_current_kind(state) == TOKEN_COMMA {
            parser_bump(state)
            if parser_current_kind(state) == TOKEN_RBRACE -> break
            elems.push(list_elem(state, depth).expr)
        }
        body = TypedLitBody.Elements{elements: ^elems}
    }
    parser_literal_close_terminators(state)
    close :: parser_expect(state, TOKEN_RBRACE, "to close an inferred literal")
    span :: parser_cover(start, close.span)
    ParsedExpr{expr: Expr.TypedLit{head: None, body: body, span: span}, span: span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/collections_structs.rs:648
fn enum_lit_named_fields(state: &JetParserState, depth: Int) -> (args: [EnumLitArg], end: Int) {
    parser_expect(state, TOKEN_LBRACE, "to open a named enum-variant literal")
    args := [EnumLitArg]{}
    while !parser_aborting(state) && parser_current_kind(state) != TOKEN_RBRACE && parser_current_kind(state) != TOKEN_EOF {
        if parser_current_kind(state) == TOKEN_SEMI {
            parser_bump(state)
            continue
        }
        label :: parser_expect_name(state, "for a variant field name")
        value := Expr.Ident{name: label.payload.decoded, span: label.span}
        if parser_current_kind(state) == TOKEN_COLON {
            parser_bump(state)
            value = parser_parse_expression(state, 1, depth + 1).expr
        }
        args.push(EnumLitArg.Named{label: label.payload.decoded, expr: value})
        if parser_current_kind(state) == TOKEN_COMMA -> parser_bump(state)
    }
    end :: parser_current(state).span.end
    if !parser_aborting(state) -> parser_bump(state)
    (args: ^args, end: end)
}
