fn bracket_starts_typed_lit(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(state) != TOKEN_LBRACKET -> return false
    nested := 0
    index := state.position + 1
    while index < state.tokens.len() {
        kind :: state.tokens[index].kind
        if kind == TOKEN_LBRACKET -> nested += 1
        if kind == TOKEN_RBRACKET {
            if nested == 0 {
                body := index + 1
                if body < state.tokens.len() && state.tokens[body].kind == TOKEN_QUESTION -> body += 1
                if body >= state.tokens.len() -> return false
                next :: state.tokens[body].kind
                return next == TOKEN_LBRACE || (next == TOKEN_DOT && body + 1 < state.tokens.len() && state.tokens[body + 1].kind == TOKEN_LBRACE)
            }
            nested -= 1
        }
        if kind == TOKEN_EOF -> return false
        index += 1
    }
    false
}
