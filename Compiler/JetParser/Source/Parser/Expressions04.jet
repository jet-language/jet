// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:7
// Shared primary entry used by the provider fragment. Ordinary atoms and the
// already-canonical qualified/generic call machinery keep their existing owner.
fn parser_expr_primary(state: &JetParserState, allow_struct_lit: Bool, depth: Int) -> ParsedExpr {
    timeout :: parser_parse_task_timeout(&state, depth)
    if timeout == .Val(parsed) -> return parsed
    contextual :: parser_parse_primary_contextual(&state, depth, allow_struct_lit, false)
    if contextual == .Val(parsed) -> return parsed
    ordinary :: parser_parse_prefix(&state, depth, allow_struct_lit, false)
    parser_parse_postfix(&state, ordinary, depth, allow_struct_lit)
}

// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:7
// expr_primary's ordinary literal/name/call path is parser_parse_prefix plus
// parser_parse_postfix in Expressions.jet. This hook runs after simple literals
// and before generic names; it supplies the contextual branches absent there.
fn parser_parse_primary_contextual(state: &JetParserState, depth: Int, allow_struct_lit: Bool, stop_before_comparison: Bool) -> ParsedExpr? {
    token :: parser_current(&state)
    kind :: token.kind
    if allow_struct_lit && (kind == TOKEN_QUESTION || parser_typed_literal_head_ahead(&state)) {
        optional :: parser_try_parse_typed_literal(&state, depth + 1)
        if optional == .Val(parsed) -> return Val(parsed)
    }
    if kind == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT {
        member :: parser_lookahead(&state, 1)
        first :: member.payload.decoded.chars().next()
        if first == .Val(ch) && ch.is_lowercase() {
            parser_bump(&state)
            parser_bump(&state)
            // Rust Field retains the member span, not the entire dot-head span.
            return Val(ParsedExpr{expr: .Field(.Ident("", token.span), member.payload.decoded, member.span), span: member.span})
        }
    }
    if kind == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT {
        head :: read_marker_head(&state)
        if parser_aborting(&state) -> return Val(ParsedExpr{expr: .Unit(head.span), span: head.span})
        rule :: applied_rule(head.name)
        if rule == .Val(row) {
            if row.status == .Active && !rule_allows(head.name, .Expression) {
                parser_primary_fail(&state, marker_wrong_site_error(head.name, .Expression, head.span))
                return Val(ParsedExpr{expr: .Unit(head.span), span: head.span})
            }
        } else {
            next :: parser_current_kind(&state)
            if next == TOKEN_SEMI || next == TOKEN_RBRACE || next == TOKEN_RPAREN || next == TOKEN_RBRACKET || next == TOKEN_COMMA || next == TOKEN_EOF {
                parser_primary_fail(&state, marker_unknown_error(head.name, active_rule_names(), head.name_span))
                return Val(ParsedExpr{expr: .Unit(head.span), span: head.span})
            }
        }
        if head.name == Syntax.MARKER_META {
            parser_primary_fail(&state, meta_attr_wrong_place_diag(head.span, "binding or function"))
            return Val(ParsedExpr{expr: .Unit(head.span), span: head.span})
        }
        if head.name == Syntax.MARKER_OFF || head.name == Syntax.MARKER_DEBUG_ONLY {
            parser_add_fatal_code(&state, "E0343", head.span, "`#{head.name}` does not produce a value", "statement switch attributes control a whole statement; expressions must still produce values in every build", "put it before the statement: `#{head.name} <statement>`")
            return Val(ParsedExpr{expr: .Unit(head.span), span: head.span})
        }
        if head.name == Syntax.KW_TODO -> return Val(ParsedExpr{expr: .Todo(head.span, None), span: head.span})
        if head.name == Syntax.KW_TAINTED {
            tag := "Input"
            if parser_current_kind(&state) == TOKEN_LPAREN {
                parser_bump(&state)
                if parser_current_kind(&state) == TOKEN_IDENT -> tag = parser_bump(&state).payload.decoded
                if parser_current_kind(&state) == TOKEN_RPAREN -> parser_bump(&state)
                if tag.is_empty() -> tag = "Input"
            }
            parser_add_error_code(&state, "E0927", head.span, "`#Tainted` is retired", "taint kinds are ordinary declared fact tags", "write `#{tag} value`")
            inner :: parser_expr_primary(&state, allow_struct_lit, depth + 1)
            span :: Span{start: head.span.start, end: inner.span.end}
            return Val(ParsedExpr{expr: .Tainted(inner.expr, Val(tag), span), span: span})
        }
        if head.name == "Add" || head.name == "Mul" || head.name == "Min" || head.name == "Max" -> return Val(ParsedExpr{expr: .ReduceMarker(head.name, head.span), span: head.span})
        inner :: parser_expr_primary(&state, allow_struct_lit, depth + 1)
        span :: Span{start: head.span.start, end: inner.span.end}
        return Val(ParsedExpr{expr: .Tainted(inner.expr, Val(head.name), span), span: span})
    }
    if kind == TOKEN_DOLLAR {
        mark :: parser_bump(&state)
        diagnostic :: if state.allow_environment_reads -> invalid_environment_read(mark.span) else -> unknown_fact_root(Syntax.COMPTIME_MARK, mark.span)
        parser_primary_fail(&state, diagnostic)
        return Val(ParsedExpr{expr: .Unit(mark.span), span: mark.span})
    }
    if kind == TOKEN_AT {
        mark :: parser_bump(&state)
        parser_add_fatal_code(&state, "E0003", mark.span, "`@` needs a compile-time name or a package ref here", "prefix `@` marks compile-time names and fact reads; infix `@` joins a package target to its source (D-ONCE-AT1=D)", "write `@name`, `T.$layout`, or a complete `target@source` ref")
        return Val(ParsedExpr{expr: .Unit(mark.span), span: mark.span})
    }
    if kind == TOKEN_KW_IN {
        mark :: parser_bump(&state)
        parser_add_fatal_code(&state, "E0003", mark.span, "`{Syntax.KW_IN}` is reserved as the source-loop keyword", "the `{Syntax.KW_IN}` keyword marks the boundary between a loop binding and its source", "choose a different identifier name, or use `{Syntax.KW_IN}` in a source loop; after `.` it is allowed as a member name")
        return Val(ParsedExpr{expr: .Unit(mark.span), span: mark.span})
    }
    if kind == TOKEN_IDENT {
        name :: token.payload.decoded
        retired :: name.starts_with(Syntax.RETIRED_COMPTIME_MARK)
        if state.derive_template_depth > 0 && retired && Syntax.retired_fact_spelling(name) == None {
            parser_bump(&state)
            suffix := name.slice(Syntax.RETIRED_COMPTIME_MARK.bytes().len()..<name.bytes().len()) // #4303
            new :: "{Syntax.COMPTIME_MARK}{suffix}"
            diagnostic :: Diagnostic.from_row("E0388", [("old", name), ("new", new)], Val(token.span)).with_edit(TextEdit{span: token.span, new_text: new})
            &state.diagnostics.push(diagnostic)
            return Val(ParsedExpr{expr: .ComptimeName(new, token.span, None), span: token.span})
        }
        if Syntax.is_comptime_name(name) && !(state.derive_template_depth > 0 && allow_struct_lit && parser_kind_at(&state, 1) == TOKEN_LT) {
            parser_bump(&state)
            if !state.allow_environment_reads && state.derive_template_depth == 0 && !Syntax.is_fact_root(name) {
                parser_primary_fail(&state, unknown_fact_root(name, token.span))
                return Val(ParsedExpr{expr: .Unit(token.span), span: token.span})
            }
            return Val(ParsedExpr{expr: .ComptimeName(name, token.span, None), span: token.span})
        }
        if allow_struct_lit && (parser_kind_at(&state, 1) == TOKEN_UNIFIED_ARROW || parser_kind_at(&state, 1) == TOKEN_LAMBDA_ARROW) {
            return Val(parse_bare_lambda(&state, depth + 1))
        }
    }
    // Rust's false-guarded foreign-word recovery arms are unreachable. Those
    // words remain ordinary names; no duplicate retirement grammar is added.
    None
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:7 — diagnostic Result adaptation.
fn parser_primary_fail(state: &JetParserState, diagnostic: ^Diagnostic) {
    if parser_aborting(&state) -> return
    &state.diagnostics.push(^diagnostic)
    state.abort_mark = state.diagnostics.len()
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:669
// simple_primary -> Expressions.jet parser_parse_prefix:734-798 and
// parser_parse_collection. Byte string behavior is replaced below.
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:745
fn parser_at_literal_head_path(state: JetParserState) -> Bool Never! {
    offset := 0
    loop parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_IDENT -> offset += 2
    parser_kind_at(state, offset) == TOKEN_LBRACE || (parser_kind_at(state, offset) == TOKEN_DOT && parser_kind_at(state, offset + 1) == TOKEN_LBRACE)
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:768
fn parser_consume_literal_head_path(state: &JetParserState, type_name: String) -> (String, Bool) {
    out := [U8]{}
    loop byte in type_name.bytes() -> &out.push(byte)
    loop parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT {
        parser_bump(&state)
        segment :: parser_expect_name(&state, "after `.` in a literal head")
        &out.push(U8{46})
        loop byte in segment.payload.decoded.bytes() -> &out.push(byte)
    }
    retired :: parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_LBRACE
    if retired -> parser_bump(&state)
    (String.from_bytes(out) ?? panic("identifier path preserves UTF-8"), retired)
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:794
// task_surface_expr -> Expressions.jet parser_parse_task_surface:1330;
// parser_task_spawn:1321, parser_task_call supply the same internal receiver,
// lambda metadata, take names, named tuple vs positional list, and tail rewind.
// The only gap is timeout's full call-argument convention, provided here.
fn parser_parse_task_timeout(state: &JetParserState, depth: Int) -> ParsedExpr? {
    if parser_current_kind(&state) != TOKEN_IDENT || parser_current(&state).payload.decoded != Syntax.KW_CONC_TASK || parser_kind_at(&state, 1) != TOKEN_DOT || parser_kind_at(&state, 2) != TOKEN_IDENT || parser_lookahead(&state, 2).payload.decoded != Syntax.TASK_TIMEOUT_SELECTOR -> return None
    head :: parser_bump(&state).span
    parser_bump(&state)
    selector :: parser_bump(&state)
    parser_expect(&state, TOKEN_LPAREN, "after `task.timeout`")
    argument :: call_arg(&state, depth + 1)
    close :: parser_expect(&state, TOKEN_RPAREN, "to finish `task.timeout`")
    span :: parser_cover(head, close.span)
    Val(ParsedExpr{expr: .MethodCall(.Ident(Syntax.INTERNAL_TASK_RECEIVER, head), Syntax.INTERNAL_TASK_TIMEOUT_METHOD, selector.span, [], [], [argument], None, None, None, false), span: span})
}

// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1065
// Replacement of Expressions.jet's same-named string reader: ordinary Byte
// tokens become Latin-1 text, while the separate typed byte-text reader keeps
// its Byte carriers. No native capability is used in this Rust window.
fn parser_parse_string(state: &JetParserState, depth: Int) -> ParsedExpr {
    token :: parser_bump(&state)
    parts := [StrPart]{}
    if token.kind == TOKEN_RAW_STRING || token.payload.string_parts.is_empty() -> &parts.push(.Lit(token.payload.decoded))
    else {
        loop part in token.payload.string_parts {
            if part.kind == {
                STRING_PART_TEXT -> &parts.push(.Lit(part.text))
                STRING_PART_BYTE -> &parts.push(.Lit(parser_primary_byte_text(part.byte)))
                STRING_PART_INTERPOLATION -> {
                    parser_parse_interpolation(&state, part, depth, &parts)
                    if parser_aborting(&state) -> break
                }
                else -> panic("lexer string-part carrier is exhaustive")
            }
        }
    }
    ParsedExpr{expr: .Str(^parts, token.span), span: token.span}
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1074
fn parser_primary_byte_text(byte: Int) -> String Never! {
    bytes :: if byte < 128 -> [U8]{U8{byte}} else -> [U8]{U8{192 + byte /% 64}, U8{128 + byte % 64}}
    String.from_bytes(bytes) ?? panic("one Latin-1 scalar is valid UTF-8")
}
