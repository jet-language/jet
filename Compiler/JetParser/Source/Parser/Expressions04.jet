fn parser_parse_interpolation(state: &JetParserState, part: StringPart, depth: Int, parts: &[StrPart]) {
    nested := JetParserState{tokens: part.tokens, position: 0, diagnostics: [], source_end: part.span.end, block_spans: [], pending_type_gt: false, pending_type_gt_span: Span{start: 0, end: 0}, result_handler_depth: state.result_handler_depth, statement_start: -1,
        in_layout_body: state.in_layout_body, allow_lowercase_leading_dot: state.allow_lowercase_leading_dot, allow_environment_reads: state.allow_environment_reads, migration_mode: state.migration_mode, derive_template_depth: state.derive_template_depth}
    if parser_current_kind(&nested) == TOKEN_EQ {
        parser_add_fatal_code(&state, "E0003", parser_current(&nested).span, "empty debug-label interpolation `{{=}}`", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}` or `{{x + 1=}}`")
        return
    }
    value :: parser_parse_expression(&nested, 1, depth + 1)
    if nested.abort_mark != 0 {
        parser_take_nested_failure(&state, nested.diagnostics)
        return
    }
    if !nested.diagnostics.is_empty() {
        teaching :: state.migration_mode && nested.diagnostics.iter().all(fn(diag) { diag.severity == 2 || parser_is_teaching_parse_diag(diag.code) })
        if !teaching {
            // Rust retains the remaining nested diagnostics before its first
            // error is returned; canonical abort state records that error last.
            first :: nested.diagnostics[0]
            loop index in 1..<nested.diagnostics.len() -> &state.diagnostics.push(nested.diagnostics[index])
            parser_primary_fail(&state, ~first)
            return
        }
        loop diagnostic in nested.diagnostics -> &state.diagnostics.push(diagnostic)
    }
    label := [U8]{}
    has_label := false
    if parser_current_kind(&nested) == TOKEN_EQ {
        loop index in 0..<nested.position {
            token :: nested.tokens[index]
            piece :: parser_debug_label_piece(token)
            if piece.is_empty() {
                parser_add_fatal_code(&state, "E0003", token.span, "`{{…=}}` debug labels need a simple expression, not {parser_describe_token(token)}", "the label reprints the expression text before `=`", "use a name or a short expression such as `{{count=}}`")
                return
            }
            loop byte in piece.bytes() -> &label.push(byte)
        }
        if label.is_empty() {
            parser_add_fatal_code(&state, "E0003", parser_current(&nested).span, "empty debug-label interpolation", "`{{expr=}}` needs an expression before `=`", "write `{{count=}}`")
            return
        }
        parser_bump(&nested)
        has_label = true
    }
    // Old nested teaching diagnostics were already transferred; selector
    // diagnostics are independently transferred exactly once.
    &nested.diagnostics.clear()
    format :: parser_parse_string_format(&nested)
    if nested.abort_mark != 0 { parser_take_nested_failure(&state, nested.diagnostics); return }
    loop diagnostic in nested.diagnostics -> &state.diagnostics.push(diagnostic)
    if parser_current_kind(&nested) != TOKEN_EOF {
        extra :: parser_current(&nested)
        unit_selector :: Syntax.interpolation_selector_for_kind(.Unit).name
        parser_add_fatal_code(&state, "E0003", extra.span, "unexpected {parser_describe_token(extra)} inside this interpolated `{{ }}`", "the braces hold exactly one value, optional trailing `=`, and one optional format selector", "keep one value per `{{ }}`, for example \"{{a}}\", \"{{a=}}\", or \"{{a:{unit_selector}(bare)}}\"")
        return
    }
    if has_label {
        &parts.push(.Lit(String.from_bytes(label) ?? panic("debug label preserves UTF-8")))
        &parts.push(.Lit(" = "))
    }
    &parts.push(.Interp(value.expr, format))
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1190
fn parser_parse_string_format(state: &JetParserState) -> StrFormat {
    if parser_current_kind(&state) != TOKEN_COLON && parser_current_kind(&state) != TOKEN_HASH -> return .Display
    parser_bump(&state)
    selector :: parser_expect_name(&state, "after `:` in interpolation")
    if parser_aborting(&state) -> return .Display
    descriptor :: Syntax.interpolation_selector(selector.payload.decoded)
    registered :: descriptor ?? {
        &state.diagnostics.push(jet_foundation.Generics.e0914(selector.payload.decoded, selector.span))
        return .Display
    }
    head :: "{Syntax.INTERPOLATION_SELECTOR_RAIL}{registered.name}"
    if registered.kind == {
        .Debug -> .Debug
        .Pretty -> .Pretty
        .Fixed -> .Fixed(parser_parse_precision_selector(&state, head))
        .Grouped -> .Grouped(parser_parse_precision_selector(&state, head))
        .Hex -> parser_parse_hex_selector(&state, head)
        .Pad -> { (width, fill) :: parser_parse_padding_selector(&state, head); .Pad(width, fill) }
        .PadLeft -> { (width, fill) :: parser_parse_padding_selector(&state, head); .PadLeft(width, fill) }
        .Sci -> .Sci(parser_parse_precision_selector(&state, head))
        .Percent -> .Percent(parser_parse_precision_selector(&state, head))
        .Bin -> .Bin
        .Oct -> .Oct
        .Unit -> {
            parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
            style :: parser_expect_name(&state, "inside `{head}( )`")
            styles :: if registered.arguments == .UnitStyle(values) -> values else -> panic("the Unit selector declares unit styles")
            style_index := Int?{None}
            loop index in 0..<styles.len() { if styles[index] == style.payload.decoded { style_index = Val(index); break } }
            format :: if style_index == {
                .Val(0) -> StrFormat.Unit(.Name)
                .Val(1) -> StrFormat.Unit(.Bare)
                else -> {
                    accepted :: styles.iter().map(fn(s) { "`{s}`" }).collect().join(" or ")
                    examples :: styles.iter().map(fn(s) { "`{head}({s})`" }).collect().join(" or ")
                    parser_add_fatal_code(&state, "E0003", style.span, "unknown unit style `{style.payload.decoded}`", "`{head}` accepts {accepted}", "write {examples}")
                    return .Display
                }
            }
            parser_expect(&state, TOKEN_RPAREN, "after the style in `{head}( )`")
            format
        }
    }
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1343
fn parser_parse_hex_selector(state: &JetParserState, head: String) -> StrFormat {
    parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
    width :: parser_parse_selector_integer(&state, head, "width")
    parser_expect(&state, TOKEN_RPAREN, "after the width in `{head}(n)`")
    .Hex(width)
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1356
fn parser_parse_precision_selector(state: &JetParserState, head: String) -> Int {
    parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
    precision :: parser_parse_selector_integer(&state, head, "decimal places")
    parser_expect(&state, TOKEN_RPAREN, "after the decimal places in `{head}(n)`")
    precision
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1369
fn parser_parse_padding_selector(state: &JetParserState, head: String) -> (Int, String) {
    parser_expect(&state, TOKEN_LPAREN, "after `{head}` in interpolation")
    width :: parser_parse_selector_integer(&state, head, "width")
    fill := [U8]{}
    if parser_current_kind(&state) == TOKEN_COMMA {
        parser_bump(&state)
        token :: parser_bump(&state)
        if token.kind != TOKEN_STRING && token.kind != TOKEN_RAW_STRING {
            parser_add_fatal_code(&state, "E0003", token.span, "expected a literal fill string inside `{head}( )`", "`{head}(n, fill)` takes a quoted fill string", "write a fill such as `{head}(8, \"0\")`")
            return (width, "")
        }
        if token.kind == TOKEN_RAW_STRING || token.payload.string_parts.is_empty() {
            loop byte in token.payload.decoded.bytes() -> &fill.push(byte)
        } else {
            loop part in token.payload.string_parts {
                if part.kind == STRING_PART_INTERPOLATION {
                    parser_add_fatal_code(&state, "E0003", token.span, "padding fill inside `{head}( )` cannot interpolate", "a padding fill is fixed text, not a second interpolation", "write a quoted fill such as `{head}(8, \"0\")`")
                    return (width, "")
                }
                text :: if part.kind == STRING_PART_BYTE -> parser_primary_byte_text(part.byte) else -> part.text
                loop byte in text.bytes() -> &fill.push(byte)
            }
        }
    }
    parser_expect(&state, TOKEN_RPAREN, "after the fill in `{head}(n, fill)`")
    (width, String.from_bytes(fill) ?? panic("padding text preserves UTF-8"))
}
// Rust: crates/jet-parser/src/Parser/Expressions/primary.rs:1419
fn parser_parse_selector_integer(state: &JetParserState, head: String, parameter: String) -> Int {
    token :: parser_bump(&state)
    if token.kind == TOKEN_INT -> return token.payload.integer ?? panic("integer token has its checked payload")
    example :: if parameter == "width" -> "16" else -> "2"
    noun :: if parameter == "width" -> "width" else -> "precision"
    parser_add_fatal_code(&state, "E0003", token.span, "expected {parameter} inside `{head}( )`", "`{head}(n)` takes one nonnegative integer literal", "write a {noun} such as `{head}({example})`")
    0
}
