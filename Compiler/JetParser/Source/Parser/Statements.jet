fn parser_statement_is_keyword(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind == TOKEN_RETURN || token.kind == TOKEN_BREAK || token.kind == TOKEN_KW_YIELD -> return true
    if token.kind == TOKEN_KW_LOOP || token.kind == TOKEN_HASH || token.kind == TOKEN_AT -> return true
    if parser_scope_member_ahead(&state) -> return true
    if token.kind == TOKEN_IDENT {
        word :: token.payload.decoded
        if parser_next_statement_ahead(&state) || word == "defer" -> return true
        if parser_prep_verb_ahead(&state, 0, TOKEN_KW_IF) || parser_prep_verb_ahead(&state, 0, TOKEN_KW_LOOP) || parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) -> return true
        next_kind :: parser_kind_at(&state, 1)
        if next_kind == TOKEN_COLON_COLON {
            following_kind :: parser_kind_at(&state, 2)
            if following_kind == TOKEN_KW_LOOP || following_kind == TOKEN_IDENT -> return true
        }
        if next_kind == TOKEN_COLON_EQ || next_kind == TOKEN_COLON_COLON -> return true
        if next_kind == TOKEN_COLON -> return true
    }
    false
}

// Can the line at the cursor be a value block's tail? An expression never
// spans a `;` outside its groups, so only a line that runs to the closing
// `}` (or to one `;` right before it) can end there. A `;` before `else`
// may still continue an `if` value, so the scan reads on past it. Value
// blocks parse every other line straight as a statement, as Rust's failed
// tail speculation does, without parsing it twice.
fn parser_value_tail_ahead(state: JetParserState) -> Bool Never! {
    depth := 0
    index := state.position
    loop index < state.tokens.len() {
        kind :: state.tokens[index].kind
        if kind == TOKEN_EOF -> return true
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if (kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET) && depth > 0 -> depth -= 1
        if kind == TOKEN_RBRACE {
            if depth == 0 -> return true
            depth -= 1
        }
        if kind == TOKEN_SEMI && depth == 0 {
            following :: parser_lookahead_forward(state, index + 1, 0).kind
            if following != TOKEN_KW_ELSE -> return following == TOKEN_RBRACE || following == TOKEN_EOF
        }
        index += 1
    }
    true
}

fn parser_expression_definitely_diverges(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(value, _) -> parser_expression_definitely_diverges(value)
        .Todo(_, _) -> true
        .Call(call) -> call.name == "panic"
        else -> false
    }
}

fn parser_expression_is_true(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(value, _) -> parser_expression_is_true(value)
        .Bool(value, _) -> value
        else -> false
    }
}

fn parser_is_subjectless_guard(subject: Expr, span: Span) -> Bool Never! {
    if subject == {
        .Bool(value, subject_span) -> value && subject_span == span
        else -> false
    }
}

fn parser_block_definitely_exits_value_block(statements: [Stmt]) -> Bool Never! {
    loop stmt in statements {
        if parser_statement_definitely_exits_value_block(stmt) -> return true
    }
    false
}

fn parser_switch_definitely_exits_value_block(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    fallback_exits :: if else_body == {
        .Val(body) -> parser_block_definitely_exits_value_block(body)
        .None -> !parser_is_subjectless_guard(subject, span)
    }
    all_arms_exit :: loop arm in arms {
        if !parser_block_definitely_exits_value_block(arm.body) -> break false
    } ?? true
    all_arms_exit && fallback_exits
}

fn parser_statement_definitely_exits_value_block(stmt: Stmt) -> Bool Never! {
    if stmt == {
        .Return(_, _) -> true
        .Break(_) -> true
        .BreakValue(_, _) -> true
        .Continue(_) -> true
        .BreakLabel(_, _) -> true
        .BreakLabelValue(_, _, _, _) -> true
        .ContinueLabel(_, _) -> true
        .Expr(expr) -> parser_expression_definitely_diverges(expr)
        .Switch(subject, arms, else_body, span) -> parser_switch_definitely_exits_value_block(subject, arms, else_body, span)
        .Loop(body, _, _, _) -> !parser_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> parser_expression_is_true(cond) && !parser_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> parser_expression_is_true(cond) && !parser_loop_body_can_break(body)
        else -> false
    }
}

fn parser_loop_labels_with_current(nested_labels: [String], label: NamedSpan?) -> [String] Never! {
    labels := [String]{}
    loop nested_label in nested_labels -> &labels.push(nested_label)
    if label == .Val(value) -> &labels.push(value.name)
    labels
}

fn parser_loop_body_can_break(statements: [Stmt]) -> Bool Never! {
    parser_loop_body_can_break_inner(statements, [String]{}, true)
}

fn parser_loop_body_can_break_inner(statements: [Stmt], nested_labels: [String], allow_unlabelled: Bool) -> Bool Never! {
    loop stmt in statements {
        can_break := if stmt == {
            .Break(_) -> allow_unlabelled
            .BreakValue(_, _) -> allow_unlabelled
            .BreakLabel(name, _) -> {
                nested :: loop nested_label in nested_labels {
                    if nested_label == name -> break true
                } ?? false
                !nested
            }
            .BreakLabelValue(name, _, _, _) -> {
                nested :: loop nested_label in nested_labels {
                    if nested_label == name -> break true
                } ?? false
                !nested
            }
            .Switch(_, arms, else_body, _) -> {
                found_in_arms :: loop arm in arms {
                    if parser_loop_body_can_break_inner(arm.body, nested_labels, allow_unlabelled) -> break true
                } ?? false
                if else_body == {
                    .Val(body) -> found_in_arms || parser_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
                    .None -> found_in_arms
                }
            }
            .Loop(body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .While(_, body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .For(_, _, _, _, body, _, _, label, _) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .CountedLoop(_, _, _, body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            else -> false
        }
        if can_break -> return true
        if parser_statement_definitely_exits_value_block(stmt) -> return false
    }
    false
}

fn parser_parse_block(state: &JetParserState) -> ParsedBlock {
    parser_parse_body_block(&state, false)
}

// Rust `callable_tail_block_depth` (#18): the last line of a callable body
// may be a bare value. `value_tail` marks the body of a callable with a
// declared result (D-TAIL-RETURN1=A): its final line is in value position,
// where a finite source loop with `->` keeps its collecting meaning
// (D-LOOP-STMT-ARROW1=C).
fn parser_parse_callable_body(state: &JetParserState, value_tail: Bool) -> ParsedBlock {
    saved_tail_depth :: state.callable_tail_depth
    state.callable_tail_depth = state.block_depth + 1
    block :: parser_parse_body_block(&state, value_tail)
    state.callable_tail_depth = saved_tail_depth
    block
}

// Rust `block_stmts`: every braced statement list is one block level deeper.
fn parser_parse_body_block(state: &JetParserState, value_tail: Bool) -> ParsedBlock {
    state.block_depth += 1
    block :: parser_parse_body_lines(&state, value_tail)
    state.block_depth -= 1
    block
}

fn parser_parse_body_lines(state: &JetParserState, value_tail: Bool) -> ParsedBlock {
    open :: parser_expect(&state, TOKEN_LBRACE, "`{{` to begin the block")
    statements := [Stmt]{}
    parser_skip_semicolons(&state)
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        // An abort still pending here was raised by an enclosing construct;
        // its recovery rescans from the error, so reading on is wasted work.
        if parser_aborting(&state) -> return ParsedBlock{span: parser_cover(open.span, parser_current(&state).span), statements: statements, tail: None}
        before := state.position
        kind :: parser_current_kind(&state)
        statement :: if {
            value_tail && kind == TOKEN_KW_LOOP -> parser_parse_tail_loop(&state)
            value_tail && kind == TOKEN_KW_IF -> parser_parse_tail_if(&state)
            else -> parser_parse_statement(&state)
        }
        &statements.push(statement)
        parser_recover_aborted_statement(&state, before)
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error_code(&state, "E0003", token.span, "the parser could not advance through this statement", "statement recovery stops infinite retries on malformed input", "remove or complete this statement")
            parser_bump(&state)
        }
    }
    if parser_current_kind(&state) == TOKEN_EOF {
        // E0083 (#3719): a block cut off by the end of the file names its opener.
        parser_report_unclosed(&state, open, "the end of the file", "block")
        end :: parser_current(&state).span.start
        &state.block_spans.push(Span{start: open.span.end, end: end})
        return ParsedBlock{span: Span{start: open.span.start, end: end}, statements: statements, tail: None}
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` to close the block")
    inner :: Span{start: open.span.end, end: close.span.start}
    &state.block_spans.push(inner)
    ParsedBlock{span: parser_cover(open.span, close.span), statements: statements, tail: None}
}

// The final line of a value body: a collecting loop that ends the block is
// the block's value. Any other loop form, or a loop with lines after it, is
// parsed again as a statement.
fn parser_parse_tail_loop(state: &JetParserState) -> Stmt {
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    parsed :: parser_parse_expression(&state, 1, 0)
    at_tail :: parser_current_kind(&state) == TOKEN_RBRACE || (parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE)
    if at_tail && parser_expression_is_collecting_loop(parsed.expr) -> return Stmt.Expr{expr: parsed.expr}
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    parser_parse_statement(&state)
}

// D-BODY-LAST1=B: in the body of a callable with a declared result, a final
// `if` in a value form (`->` branches, a guard table or a dispatch) is the
// body's value. Any other `if` there is parsed again as a statement.
fn parser_parse_tail_if(state: &JetParserState) -> Stmt {
    if !parser_expression_form_if_ahead(&state) -> return parser_parse_statement(&state)
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    parsed :: parser_parse_expression(&state, 1, 0)
    at_tail :: parser_current_kind(&state) == TOKEN_RBRACE || (parser_current_kind(&state) == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE)
    if at_tail && !parser_error_since(state, saved_diagnostics) -> return Stmt.Expr{expr: parsed.expr}
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    parser_parse_statement(&state)
}

fn parser_expression_is_collecting_loop(expr: Expr) -> Bool Never! {
    if expr == .CallValue(callee, _, _) {
        if callee == .Lambda(lambda) -> return lambda.meta.collecting_loop
    }
    false
}

// `prepared_value` marks the block of `name :: prep { value }`. A binding
// `other :: prep { … }` directly inside it means that block was never closed
// (a prepared value holds one expression, never a binding): report the
// unclosed `{` and stop before the binding, so it parses on as the next
// statement or declaration instead of nesting every later prepared binding
// inside the first one without bound.
fn parser_parse_value_block(state: &JetParserState, depth: Int, prepared_value: Bool) -> ParsedBlock {
    if !prepared_value -> return parser_parse_value_lines(&state, depth, false)
    // Rust reads a prepared value's lines as a callable body (#18).
    saved_tail_depth :: state.callable_tail_depth
    state.block_depth += 1
    state.callable_tail_depth = state.block_depth
    block :: parser_parse_value_lines(&state, depth, true)
    state.block_depth -= 1
    state.callable_tail_depth = saved_tail_depth
    block
}

fn parser_parse_value_lines(state: &JetParserState, depth: Int, prepared_value: Bool) -> ParsedBlock {
    open :: parser_expect(&state, TOKEN_LBRACE, "`{{` to begin the value block")
    statements := [Stmt]{}
    tail := Expr?{None}
    // S6-R: nested block statements leave a zero-width terminator before the
    // next value-block item; authored semicolons stay visible to diagnostics.
    parser_skip_synthetic_semicolons(&state)
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        // As in `parser_parse_body_block`: stop under an enclosing abort.
        if parser_aborting(&state) -> return ParsedBlock{span: parser_cover(open.span, parser_current(&state).span), statements: statements, tail: tail}
        before := state.position
        if prepared_value && parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON_COLON && parser_prep_verb_ahead(&state, 2, TOKEN_LBRACE) {
            binding :: parser_current(&state)
            parser_report_unclosed(&state, open, "the binding `{binding.payload.decoded}`", "prepared value")
            // Leave the line terminator before the binding to end this one.
            if state.position > 0 && state.tokens[state.position - 1].kind == TOKEN_SEMI -> state.position = state.position - 1
            return ParsedBlock{span: Span{start: open.span.start, end: binding.span.start}, statements: [Stmt]{}, tail: Val(Expr.Unit{span: open.span})}
        }
        if {
            parser_statement_is_keyword(&state) || !parser_value_tail_ahead(state) -> &statements.push(parser_parse_statement(&state))
            else -> {
                // As in Rust's value blocks: speculate on a tail value (a zero-width
                // line terminator may sit before `}`), else reparse as a statement.
                saved_position :: state.position
                saved_diagnostics :: state.diagnostics.len()
                saved_blocks :: state.block_spans.len()
                saved_else_arms :: state.else_arms.len()
                value :: parser_parse_expression(&state, 1, depth + 1)
                current :: parser_current(&state)
                if !parser_error_since(state, saved_diagnostics) && (current.kind == TOKEN_RBRACE || (current.kind == TOKEN_SEMI && current.span.start == current.span.end && parser_kind_at(&state, 1) == TOKEN_RBRACE)) {
                    if current.kind == TOKEN_SEMI -> parser_bump(&state)
                    tail = Val(value.expr)
                    break
                }
                parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
                &statements.push(parser_parse_statement(&state))
            }
        }
        parser_recover_aborted_statement(&state, before)
        parser_skip_synthetic_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error_code(&state, "E0003", token.span, "the parser could not advance through this block", "block recovery stops infinite retries on malformed input", "remove or complete this statement")
            parser_bump(&state)
        }
    }
    if parser_current_kind(&state) == TOKEN_EOF {
        parser_report_unclosed(&state, open, "the end of the file", "block")
        end :: parser_current(&state).span.start
        &state.block_spans.push(Span{start: open.span.end, end: end})
        return ParsedBlock{span: Span{start: open.span.start, end: end}, statements: statements, tail: tail}
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` to close the value block")
    inner :: Span{start: open.span.end, end: close.span.start}
    &state.block_spans.push(inner)
    ParsedBlock{span: parser_cover(open.span, close.span), statements: statements, tail: tail}
}

fn parser_parse_statement(state: &JetParserState) -> Stmt {
    parser_skip_semicolons(&state)
    token :: parser_current(&state)
    state.statement_start = token.span.start
    if parser_scope_member_ahead(&state) -> return parser_parse_scope_member(&state)
    if token.kind == {
        TOKEN_KW_IF -> parser_parse_if_statement(&state)
        TOKEN_KW_LOOP -> parser_parse_loop_statement(&state)
        TOKEN_RETURN -> parser_parse_return_statement(&state)
        TOKEN_BREAK -> parser_parse_break_statement(&state)
        TOKEN_KW_YIELD -> {
            start :: parser_bump(&state)
            value :: parser_parse_expression(&state, 1, 0)
            parser_finish_statement(&state)
            Stmt.Yield{value: value.expr, span: parser_cover(start.span, value.span)}
        }
        TOKEN_HASH -> parser_parse_marked_statement(&state)
        TOKEN_KW_COMPTIME -> parser_parse_retired_comptime_statement(&state)
        TOKEN_IDENT -> {
            if parser_next_statement_ahead(&state) -> return parser_parse_next_statement(&state)
            if token.payload.decoded == "defer" -> return parser_parse_defer_statement(&state)
            if parser_task_group_ahead(&state) -> return parser_parse_task_group(&state)
            if token.payload.decoded == "assert" && parser_kind_at(&state, 1) == TOKEN_IDENT -> return parser_parse_assert_names(&state)
            if parser_prep_verb_ahead(&state, 0, TOKEN_KW_IF) -> return parser_parse_prep_if(&state)
            if parser_prep_verb_ahead(&state, 0, TOKEN_KW_LOOP) -> return parser_parse_prep_loop(&state)
            if parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) -> return parser_parse_prep_block(&state)
            if parser_kind_at(&state, 1) == TOKEN_COLON_COLON && parser_kind_at(&state, 2) == TOKEN_KW_LOOP && !parser_named_loop_is_value(&state) -> return parser_parse_labeled_loop(&state)
            binding_kind :: parser_kind_at(&state, 1)
            if {
                binding_kind == TOKEN_COLON_EQ || binding_kind == TOKEN_COLON_COLON || binding_kind == TOKEN_COLON -> parser_parse_binding_statement(&state)
                (binding_kind == TOKEN_LBRACE || binding_kind == TOKEN_DOT) && parser_pattern_binding_ahead(&state) -> parser_parse_pattern_binding_statement(&state)
                else -> parser_parse_assignment_or_expression(&state)
            }
        }
        TOKEN_AT -> {
            if parser_kind_at(&state, 1) == TOKEN_KW_IF -> return parser_parse_prep_if(&state)
            if parser_kind_at(&state, 1) == TOKEN_KW_LOOP -> return parser_parse_prep_loop(&state)
            if parser_kind_at(&state, 1) == TOKEN_LBRACE -> return parser_parse_prep_block(&state)
            parser_parse_comptime_binding(&state)
        }
        else -> {
            if (token.kind == TOKEN_LBRACKET || token.kind == TOKEN_LPAREN || token.kind == TOKEN_LBRACE) && parser_pattern_binding_ahead(&state) -> return parser_parse_pattern_binding_statement(&state)
            parser_parse_assignment_or_expression(&state)
        }
    }
}

fn parser_scope_member_ahead(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_IDENT
        && (parser_kind_at(&state, 2) == TOKEN_LPAREN || parser_kind_at(&state, 2) == TOKEN_LBRACE)
}

// Rust `stmt` (D-CONC-SPAWN1=D): `task.group g { … }` or
// `task.group g(limit: n) { … }` opens a structured task scope.
fn parser_task_group_ahead(state: &JetParserState) -> Bool Never! {
    if parser_current(&state).payload.decoded != "task" || parser_kind_at(&state, 1) != TOKEN_DOT -> return false
    selector :: parser_lookahead(&state, 2)
    if selector.kind != TOKEN_IDENT || selector.payload.decoded != "group" || parser_kind_at(&state, 3) != TOKEN_IDENT -> return false
    opener :: parser_kind_at(&state, 4)
    opener == TOKEN_LBRACE || opener == TOKEN_LPAREN
}

fn parser_parse_task_group(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    parser_expect(&state, TOKEN_DOT, "after `task`")
    parser_expect_name(&state, "for the `group` selector")
    name :: parser_expect_name(&state, "for the task group name")
    limit := Expr?{None}
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        label :: parser_expect_name(&state, "for the group limit label")
        if label.payload.decoded != "limit" {
            parser_add_error_code(&state, "E0003", label.span, "task-group parameter `{label.payload.decoded}` is not supported", "the group parameter names the maximum number of active children", "write `limit: n`")
        }
        parser_expect(&state, TOKEN_COLON, "after `limit`")
        value :: parser_parse_expression(&state, 1, 0)
        limit = Val(value.expr)
        parser_expect(&state, TOKEN_RPAREN, "after the task-group limit")
    }
    body :: parser_parse_block(&state)
    Stmt.TaskGroup{name: name.payload.decoded, name_span: name.span, limit: limit, body: body.statements, span: parser_cover(start.span, body.span)}
}

fn parser_parse_scope_member(state: &JetParserState) -> Stmt {
    dot :: parser_bump(&state)
    name :: parser_expect_name(&state, "for the scope-member name")
    args := [Expr]{}
    args_span := Span?{None}
    if parser_current_kind(&state) == TOKEN_LPAREN {
        open :: parser_bump(&state)
        loop parser_current_kind(&state) != TOKEN_RPAREN && parser_current_kind(&state) != TOKEN_EOF {
            if parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON {
                label :: parser_bump(&state)
                parser_bump(&state)
                value :: parser_parse_expression(&state, 1, 0)
                &args.push(Expr.TupleLit{fields: [TupleField]{TupleField{name: label.payload.decoded, value: value.expr}}, span: parser_cover(label.span, value.span), ty: None})
            } else {
                value :: parser_parse_expression(&state, 1, 0)
                &args.push(value.expr)
            }
            if parser_current_kind(&state) == TOKEN_RPAREN -> break
            parser_expect(&state, TOKEN_COMMA, "between scope-member arguments")
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "to close the scope-member arguments")
        args_span = Val(parser_cover(open.span, close.span))
    }
    body :: parser_parse_block(&state)
    Stmt.ScopeMember{name: name.payload.decoded, name_span: name.span, args: args, args_span: args_span, body: body.statements, dsl: false, dot_span: dot.span, span: parser_cover(dot.span, body.span)}
}

// Rust `stmt`: `next` is the loop-control word only before a line end, `}`,
// or a `(name)` target; anywhere else it is an ordinary name (`next := 0`).
fn parser_next_statement_ahead(state: &JetParserState) -> Bool Never! {
    token :: parser_current(&state)
    if token.kind != TOKEN_IDENT || token.payload.decoded != "next" -> return false
    following :: parser_kind_at(&state, 1)
    following == TOKEN_SEMI || following == TOKEN_RBRACE || (following == TOKEN_LPAREN && parser_kind_at(&state, 2) == TOKEN_IDENT && parser_kind_at(&state, 3) == TOKEN_RPAREN)
}

// `next` or `next(name)`: continue the innermost or the named loop.
fn parser_parse_next_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        name :: parser_expect_name(&state, "as the loop name in `next(name)`")
        parser_expect(&state, TOKEN_RPAREN, "`)` after the named next target")
        parser_finish_statement(&state)
        return Stmt.ContinueLabel{name: name.payload.decoded, span: start.span}
    }
    parser_finish_statement(&state)
    Stmt.Continue{span: start.span}
}

// D-IF3 / D-IFDIST1 / D-IFGUARD1=A / D-ONELINE-BODY1=B: the statement `if`.
// `if {` opens an ordered Boolean guard table, `if subject OP {` opens value
// or pattern dispatch, and a plain `if cond` gates one `->` statement or a
// braced body, with an optional `else` chain. Every form builds the one flat
// `Stmt.Switch` arm table; the guard and classic forms carry a
// compiler-private `true` subject whose span is the `if` keyword.
fn parser_parse_if_statement(state: &JetParserState) -> Stmt {
    branch_start :: state.position
    start :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_LBRACE {
        parser_bump(&state)
        return parser_parse_if_guard_arms(&state, start.span)
    }
    // Parse the subject below comparison precedence so a trailing `OP {`
    // dispatch marker stays in the token stream.
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    subject :: parser_parse_expression_no_struct_lit_no_cmp(&state, 1)
    dispatch :: parser_expression_form_dispatch_op(parser_current_kind(&state))
    if dispatch == .Val(op) && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        parser_bump(&state)
        parser_expect(&state, TOKEN_LBRACE, "`{{` to open the `if` dispatch body")
        return parser_parse_if_arms(&state, subject.expr, start.span, op)
    }
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    cond_start :: parser_current(&state).span.start
    condition :: parser_parse_expression_no_struct_lit(&state, 1)
    cond_span :: Span{start: cond_start, end: parser_prev_token_end(state)}
    // D-ASSIGNCOND1: a bare `=` in a condition is an assignment, not `==`.
    if parser_current_kind(&state) == TOKEN_EQ {
        eq_span :: parser_current(&state).span
        parser_add_error_code(&state, "E0322", eq_span, "assignment `=` cannot appear in an `if` condition", "`=` binds a name; use `==` to compare two values", "replace `=` with `==` to compare, or move the assignment before the `if`")
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: condition.expr}
    }
    braced :: parser_current_kind(&state) == TOKEN_LBRACE
    if braced {
        // E0992: an old implicit-dispatch body (its first line is `head ->`)
        // with no comparison marker teaches the explicit form, then parses
        // the body as arms so the rest of the file still checks.
        open_position :: state.position
        parser_bump(&state)
        if parser_if_body_is_arms(&state) {
            parser_add_error_code(&state, "E0992", start.span, "a multi-arm `if` needs a comparison between the subject and `{{`", "`if subject == {{ … }}` (or `<`, `>`, `!=`, `<=`, `>=`) marks value dispatch explicitly, so a plain `if cond {{ … }}` body is always statements", "write `if subject == {{ value -> body }}`")
            return parser_parse_if_arms(&state, condition.expr, start.span, BinOp.Eq)
        }
        state.position = open_position
    }
    parts := [ParserBranchPart]{}
    body :: parser_parse_if_body(&state, &parts, cond_span)
    arms := [SwitchArm]{SwitchArm{cond: condition.expr, body: body, span: expr_span(condition.expr)}}
    else_body := [Stmt]?{None}
    chained :: parser_current_kind(&state) == TOKEN_KW_ELSE && parser_kind_at(&state, 1) == TOKEN_KW_IF
    // After a braced body, a final `else` is braced too; an `else if` link
    // and the arms after it take every body shape.
    if braced && parser_current_kind(&state) == TOKEN_KW_ELSE && !chained {
        parser_bump(&state)
        else_start :: parser_current(&state).span.start
        else_body = Val(parser_parse_block(&state).statements)
        &parts.push(ParserBranchPart{is_else: true, cond: Span{start: else_start, end: else_start}, body: Span{start: else_start, end: parser_prev_token_end(state)}})
    } else {
        else_body = parser_parse_if_else_chain(&state, &arms, &parts)
    }
    // L0507: a chained branch, or a braced one with `else` over several
    // lines, prefers one ordered arm table.
    if chained || (braced && else_body != None && parser_authored_line_break(state, branch_start, state.position)) -> parser_prefer_arm_table(&state, start.span, parts, saved_diagnostics)
    Stmt.Switch{subject: Expr.Bool{value: true, span: start.span}, arms: arms, else_body: else_body, span: start.span}
}

// The `else if` links and final `else` of a classic `if`. Each link takes the
// same body shapes as the leading `if`.
fn parser_parse_if_else_chain(state: &JetParserState, arms: &[SwitchArm], parts: &[ParserBranchPart]) -> [Stmt]? {
    loop parser_current_kind(&state) == TOKEN_KW_ELSE {
        parser_bump(&state)
        if parser_current_kind(&state) != TOKEN_KW_IF -> return Val(parser_parse_else_body(&state, &parts))
        parser_bump(&state)
        cond_start :: parser_current(&state).span.start
        condition :: parser_parse_expression_no_struct_lit(&state, 1)
        cond_span :: Span{start: cond_start, end: parser_prev_token_end(state)}
        body :: parser_parse_if_body(&state, &parts, cond_span)
        &arms.push(SwitchArm{cond: condition.expr, body: body, span: expr_span(condition.expr)})
    }
    None
}

// D-ONELINE-BODY1=B: an `if` body is one `->` statement or a braced block.
// Anything else teaches braces (E0372) and parses as the one statement. The
// condition and body are recorded in `parts` for the L0507 fix.
fn parser_parse_if_body(state: &JetParserState, parts: &[ParserBranchPart], cond: Span) -> [Stmt] {
    token :: parser_current(&state)
    if token.kind == TOKEN_UNIFIED_ARROW {
        parser_bump(&state)
        body_start :: parser_current(&state).span.start
        arrow_body :: parser_parse_adjacent_effect_body(&state)
        &parts.push(ParserBranchPart{is_else: false, cond: cond, body: Span{start: body_start, end: parser_prev_token_end(state)}})
        return arrow_body
    }
    if token.kind != TOKEN_LBRACE && token.kind != TOKEN_SEMI {
        parser_teach_control_braces(&state, "if", token.span)
        bare_body :: parser_parse_adjacent_effect_body(&state)
        &parts.push(ParserBranchPart{is_else: false, cond: cond, body: Span{start: token.span.start, end: parser_prev_token_end(state)}})
        return bare_body
    }
    block :: parser_parse_block(&state)
    &parts.push(ParserBranchPart{is_else: false, cond: cond, body: Span{start: token.span.start, end: parser_prev_token_end(state)}})
    block.statements
}

fn parser_parse_else_body(state: &JetParserState, parts: &[ParserBranchPart]) -> [Stmt] {
    token :: parser_current(&state)
    if token.kind == TOKEN_LBRACE {
        block :: parser_parse_block(&state)
        &parts.push(ParserBranchPart{is_else: true, cond: Span{start: token.span.start, end: token.span.start}, body: Span{start: token.span.start, end: parser_prev_token_end(state)}})
        return block.statements
    }
    if token.kind == TOKEN_UNIFIED_ARROW {
        parser_bump(&state)
    } else {
        parser_teach_control_braces(&state, "else", token.span)
    }
    body_start :: parser_current(&state).span.start
    body :: parser_parse_adjacent_effect_body(&state)
    &parts.push(ParserBranchPart{is_else: true, cond: Span{start: body_start, end: body_start}, body: Span{start: body_start, end: parser_prev_token_end(state)}})
    body
}

// An adjacent `->` body owns one non-`if` statement (E0329).
fn parser_parse_adjacent_effect_body(state: &JetParserState) -> [Stmt] {
    token :: parser_current(&state)
    if token.kind == TOKEN_KW_IF {
        parser_add_fatal_code(&state, "E0329", token.span, "a nested one-line `if` needs braces", "an adjacent body owns one non-`if` statement, so direct nesting is ambiguous", "wrap the nested `if` in `{{ ... }}`")
        return [Stmt]{}
    }
    state.adjacent_if_body_depth += 1
    statement :: parser_parse_statement(&state)
    state.adjacent_if_body_depth -= 1
    [Stmt]{statement}
}

fn parser_teach_control_braces(state: &JetParserState, body: String, span: Span) {
    parser_add_error_code(&state, "E0372", span, "This `{body}` body needs braces.", "Use `->` for one effect statement; braces make a multi-statement or scoped body's boundary visible to readers, editors, and the compiler.", "Write `-> statement` for one statement, or wrap the body in `{{ ... }}`; `jet fmt` applies this fix.")
}

// D-IFGUARD1=A: `if { Bool -> body … [else -> body] }` statement guards.
fn parser_parse_if_guard_arms(state: &JetParserState, start: Span) -> Stmt {
    arms := [SwitchArm]{}
    else_body := [Stmt]?{None}
    loop {
        parser_skip_semicolons(&state)
        token :: parser_current(&state)
        if token.kind == TOKEN_RBRACE {
            if arms.len() == 0 {
                parser_add_error(&state, token.span, "a statement guard table needs at least one condition", "an empty guard table can never perform an action", "add a `condition -> statement` arm")
                return Stmt.Expr{expr: Expr.Unit{span: start}}
            }
            parser_bump(&state)
            break
        }
        if token.kind == TOKEN_EOF {
            parser_add_error(&state, token.span, "expected `}}` to close this guard table, found the end of the file", "every `{{` needs a matching `}}`", "add a closing `}}`")
            return Stmt.Expr{expr: Expr.Unit{span: start}}
        }
        if token.kind == TOKEN_KW_ELSE {
            parser_bump(&state)
            parser_expect_unified_arrow(&state, "after `else` in a guard table")
            else_body = Val(parser_parse_guard_arm_body(&state))
            parser_skip_semicolons(&state)
            parser_expect(&state, TOKEN_RBRACE, "`}}` after the final `else` guard arm")
            break
        }
        arm_position :: state.position
        condition :: parser_parse_subjectless_arm_head(&state)
        parser_expect_unified_arrow(&state, "after a guard condition")
        body :: parser_parse_guard_arm_body(&state)
        &arms.push(SwitchArm{cond: condition, body: body, span: Span{start: token.span.start, end: parser_previous_end(state)}})
        // Malformed input that consumed nothing must not retry forever.
        if state.position == arm_position -> parser_bump(&state)
    }
    Stmt.Switch{subject: Expr.Bool{value: true, span: start}, arms: arms, else_body: else_body, span: start}
}

// D-CONC-CHAN2=D: a subjectless readiness arm is a `value, receiver` pair or
// an `after duration` head, carried in the one-field tuple node sema
// recognizes; any other head is a Boolean condition.
fn parser_parse_subjectless_arm_head(state: &JetParserState) -> Expr {
    token :: parser_current(&state)
    if token.kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COMMA {
        parser_bump(&state)
        parser_bump(&state)
        source :: parser_parse_expression_no_struct_lit(&state, 1)
        return Expr.TupleLit{fields: [TupleField]{TupleField{name: token.payload.decoded, value: source.expr}}, span: Span{start: token.span.start, end: expr_span(source.expr).end}, ty: None}
    }
    if token.kind == TOKEN_IDENT && token.payload.decoded == "after" {
        parser_bump(&state)
        duration :: parser_parse_expression_no_struct_lit(&state, 1)
        return Expr.TupleLit{fields: [TupleField]{TupleField{name: parser_select_after_field(), value: duration.expr}}, span: Span{start: token.span.start, end: expr_span(duration.expr).end}, ty: None}
    }
    parser_parse_expression_no_struct_lit(&state, 1).expr
}

// Rust `Syntax::INTERNAL_SELECT_AFTER_FIELD`: a NUL-led member name no source
// tuple can spell, so the `after` readiness head cannot collide with a user's.
fn parser_select_after_field() -> String Never! {
    nul :: String.from_bytes([U8]{U8{0}}) ?? ""
    "{nul}jet.select.after"
}

fn parser_parse_guard_arm_body(state: &JetParserState) -> [Stmt] {
    token :: parser_current(&state)
    if token.kind == TOKEN_LBRACE -> return parser_parse_block(&state).statements
    if token.kind == TOKEN_KW_IF {
        parser_add_fatal_code(&state, "E0329", token.span, "a nested guard body needs braces", "a braceless guard owns exactly one non-`if` statement, so direct nesting would be ambiguous", "wrap the nested `if` in `{{ ... }}`")
        return [Stmt]{}
    }
    [Stmt]{parser_parse_statement(&state)}
}

// D-IF2 Q2: a dispatch arm body is a braced block or one braceless statement.
fn parser_parse_arm_body(state: &JetParserState) -> [Stmt] {
    if parser_current_kind(&state) == TOKEN_LBRACE -> return parser_parse_block(&state).statements
    [Stmt]{parser_parse_statement(&state)}
}

// D-IF1: with the cursor just past `{`, does the body open with an arm (an
// `else ->` catch-all, a range head, or an expression followed by `->`)?
// Pure lookahead.
fn parser_if_body_is_arms(state: &JetParserState) -> Bool {
    first :: parser_current_kind(&state)
    if first == TOKEN_KW_ELSE && parser_kind_at(&state, 1) == TOKEN_UNIFIED_ARROW -> return true
    if first == TOKEN_RBRACE -> return false
    // D-PATR: `lo .. hi ->`, plus the `lo .. hi step n ->` (E0319) and
    // `lo ..= hi ->` (E0318) porting hazards, without a full expression parse.
    if first == TOKEN_INT && parser_kind_at(&state, 1) == TOKEN_DOT_DOT {
        if parser_kind_at(&state, 3) == TOKEN_UNIFIED_ARROW -> return true
        third :: parser_lookahead(&state, 3)
        if third.kind == TOKEN_IDENT && third.payload.decoded == "step" && parser_kind_at(&state, 5) == TOKEN_UNIFIED_ARROW -> return true
        return parser_kind_at(&state, 2) == TOKEN_EQ && parser_kind_at(&state, 4) == TOKEN_UNIFIED_ARROW
    }
    // An arm head is followed by `->` on its own line, outside any group.
    // Without one the line is a statement, and the expression parse below
    // would read a nested body (`if c {`, `loop x in xs {`) only to undo it.
    if !parser_line_arrow_ahead(state) -> return false
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    _ := parser_parse_expression_no_struct_lit(&state, 1)
    is_arm :: !parser_error_since(state, saved_diagnostics) && parser_at_unified_arrow(&state)
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    is_arm
}

// Pure token scan: does the line at the cursor hold an arrow (`->`, or the
// retired `=>`) outside its groups before the line ends?
fn parser_line_arrow_ahead(state: JetParserState) -> Bool Never! {
    depth := 0
    index := state.position
    loop index < state.tokens.len() {
        kind :: state.tokens[index].kind
        if kind == TOKEN_EOF -> return false
        if depth == 0 && (kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_LAMBDA_ARROW) -> return true
        if depth == 0 && kind == TOKEN_SEMI -> return false
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
        if parser_is_closer(kind) {
            if depth == 0 -> return false
            depth -= 1
        }
        index += 1
    }
    false
}

// D-IF3 / D-IFDIST1: the arms of `if subject OP { … }` (cursor just past
// `{`). Each arm is `head -> body`; `else -> body` is the catch-all. A
// pattern head binds against the subject itself when it is a plain name and
// against the synthesised `it` otherwise.
fn parser_parse_if_arms(state: &JetParserState, subject: Expr, start: Span, op: BinOp) -> Stmt {
    pattern_subject :: if subject == {
        .Ident(_, _) -> subject
        else -> Expr.Ident{name: "it", span: expr_span(subject)}
    }
    arms := [SwitchArm]{}
    else_body := [Stmt]?{None}
    loop {
        parser_skip_semicolons(&state)
        token :: parser_current(&state)
        if token.kind == TOKEN_RBRACE {
            parser_bump(&state)
            break
        }
        if token.kind == TOKEN_EOF {
            parser_add_error(&state, token.span, "expected `}}` to close this `if`, found the end of the file", "every `{{` needs a matching `}}`", "add a closing `}}`")
            return Stmt.Expr{expr: Expr.Unit{span: start}}
        }
        if token.kind == TOKEN_KW_ELSE {
            parser_bump(&state)
            parser_expect_unified_arrow(&state, "after `else` in an `if`")
            else_body = Val(parser_parse_arm_body(&state))
            next
        }
        arm_position :: state.position
        condition :: parser_parse_if_arm_head(&state, subject, pattern_subject, op)
        parser_expect_unified_arrow(&state, "after an `if` arm value or condition")
        body :: parser_parse_arm_body(&state)
        &arms.push(SwitchArm{cond: condition, body: body, span: Span{start: token.span.start, end: parser_previous_end(state)}})
        // Malformed input that consumed nothing must not retry forever.
        if state.position == arm_position -> parser_bump(&state)
    }
    Stmt.Switch{subject: subject, arms: arms, else_body: else_body, span: start}
}

// D-IF3 / D-MATCHARM1 / D-IFDIST1: one bare arm head bound to the subject.
// A range or pattern head tests `pattern_subject`; a pattern may carry a
// Boolean guard (`.Key(key) && key == "b" ->`). Value heads use the
// distributed arm grammar; a redundant `subject OP` prefix reports E0994.
fn parser_parse_if_arm_head(state: &JetParserState, subject: Expr, pattern_subject: Expr, op: BinOp) -> Expr {
    range :: parser_parse_range_arm_head(&state, pattern_subject)
    if range == .Val(head) -> return head
    if parser_pattern_rhs_ahead(&state) {
        saved_position :: state.position
        saved_diagnostics :: state.diagnostics.len()
        saved_blocks :: state.block_spans.len()
        saved_else_arms :: state.else_arms.len()
        pattern :: parser_parse_pattern(&state, 1, true)
        // Rust `try_pattern_rhs(true)?`: a fatal error inside the pattern
        // ends the arm; only a complete pattern without `->` is reread.
        if state.abort_mark > saved_diagnostics -> return parser_expression_form_pattern_condition(&state, pattern_subject, pattern, op)
        after :: parser_current_kind(&state)
        if after == TOKEN_UNIFIED_ARROW -> return parser_expression_form_pattern_condition(&state, pattern_subject, pattern, op)
        if after == TOKEN_AND_AND || after == TOKEN_OR_OR {
            result := parser_expression_form_pattern_condition(&state, pattern_subject, pattern, op)
            if op != BinOp.Eq -> return result
            // `&&` binds tighter than `||`, with the pattern as the first operand.
            loop parser_current_kind(&state) == TOKEN_AND_AND {
                parser_bump(&state)
                result = parser_expression_form_combine(result, parser_parse_arm_bool_operand(&state, subject, op), BinOp.And)
            }
            loop parser_current_kind(&state) == TOKEN_OR_OR {
                parser_bump(&state)
                group := parser_parse_arm_bool_operand(&state, subject, op)
                loop parser_current_kind(&state) == TOKEN_AND_AND {
                    parser_bump(&state)
                    group = parser_expression_form_combine(group, parser_parse_arm_bool_operand(&state, subject, op), BinOp.And)
                }
                result = parser_expression_form_combine(result, group, BinOp.Or)
            }
            return result
        }
        parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    }
    parser_expression_form_redundant_dispatch(&state, subject, op)
    parser_expression_form_dispatch_condition(&state, subject, op, 1)
}

// The operand after `&&` / `||` in an arm head: a parenthesized group or a
// `|` union, where a lone predicate stays a Boolean expression.
fn parser_parse_arm_bool_operand(state: &JetParserState, subject: Expr, op: BinOp) -> Expr {
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        inner :: parser_expression_form_dispatch_condition(&state, subject, op, 1)
        parser_expect(&state, TOKEN_RPAREN, "`)` to close the arm head group")
        return inner
    }
    parser_expression_form_arm_alternates(&state, subject, op, true, 1)
}

// D-PATR / C25: a `lo..hi` range arm head. Rust's inclusive `..=` (E0318) and
// a trailing loop `step n` (E0319) are porting hazards that teach and
// recover; None when the cursor is not a range head.
fn parser_parse_range_arm_head(state: &JetParserState, subject: Expr) -> Expr? {
    low_token :: parser_current(&state)
    if low_token.kind != TOKEN_INT || parser_kind_at(&state, 1) != TOKEN_DOT_DOT -> return None
    low :: low_token.payload.integer ?? 0
    parser_bump(&state)
    parser_bump(&state)
    inclusive :: parser_current_kind(&state) == TOKEN_EQ
    if inclusive -> parser_bump(&state)
    high_token :: parser_current(&state)
    if high_token.kind != TOKEN_INT {
        if inclusive {
            parser_add_error_code(&state, "E0318", high_token.span, "`..=` is not a Jet operator — Jet's `..` is already inclusive", "in Rust, `..` is exclusive and `..=` is inclusive; in Jet, `..` includes both ends", "write `lo..hi` — that already includes `hi`")
        } else {
            parser_add_error(&state, high_token.span, "expected an integer after `..` in a range arm", "range arms need both ends: `lo..hi -> body`", "write `0..59 -> {{ body }}` for an inclusive range arm")
        }
        return Val(Expr.Bool{value: false, span: high_token.span})
    }
    parser_bump(&state)
    high :: high_token.payload.integer ?? 0
    span :: parser_cover(low_token.span, high_token.span)
    if inclusive {
        parser_add_error_code(&state, "E0318", span, "`..=` is not a Jet operator — Jet's `..` is already inclusive", "in Rust, `..` is exclusive and `..=` is inclusive; in Jet, `..` includes both ends", "write `{low}..{high}` — that already includes `{high}`")
    } else {
        step :: parser_current(&state)
        if step.kind == TOKEN_IDENT && step.payload.decoded == "step" {
            parser_add_error_code(&state, "E0319", span, "`step` is not allowed in a range arm — range arms test a band, not a sequence", "`step` is a retired loop spelling; a range arm just checks if the subject falls between the two ends", "remove `step …`, or use a full condition: `subject >= {low} && subject <= {high} && subject % n == 0 ->`")
            parser_bump(&state)
            if parser_current_kind(&state) == TOKEN_INT -> parser_bump(&state)
        }
    }
    Val(Expr.PatternTest{subject: subject, pattern: Pattern.Range{lo: low, hi: high, span: span}, span: span})
}

// D-ONELINE-BODY1=B: a statement loop body is a braced block or one `->`
// statement; a nested `if`/`loop` there needs braces (E0329).
fn parser_parse_loop_effect_body(state: &JetParserState) -> ParsedBlock {
    token :: parser_current(&state)
    if parser_at_unified_arrow(&state) {
        arrow :: parser_expect_unified_arrow(&state, "after a loop header")
        nested :: parser_current(&state)
        if nested.kind == TOKEN_KW_IF || nested.kind == TOKEN_KW_LOOP || (nested.kind == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_COLON_COLON && parser_kind_at(&state, 2) == TOKEN_KW_LOOP) {
            parser_add_fatal_code(&state, "E0329", nested.span, "a nested one-line control body needs braces", "an adjacent loop body owns one simple statement", "wrap the nested control statement in `{{ ... }}`")
            return ParsedBlock{span: arrow.span, statements: [Stmt]{}, tail: None}
        }
        statement :: parser_parse_statement(&state)
        end := parser_lookahead(&state, -1).span
        return ParsedBlock{span: parser_cover(arrow.span, end), statements: [Stmt]{statement}, tail: None}
    }
    if token.kind == TOKEN_LBRACE -> return parser_parse_block(&state)
    if token.kind == TOKEN_SEMI || token.kind == TOKEN_EOF {
        parser_add_fatal_code(&state, "E0003", token.span, "this loop has no body", "a loop header must be followed by a braced block", "add a body written as `{{ ... }}`")
        return ParsedBlock{span: token.span, statements: [Stmt]{}, tail: None}
    }
    if token.kind == TOKEN_KW_IF || token.kind == TOKEN_KW_LOOP {
        parser_add_fatal_code(&state, "E0329", token.span, "a nested one-line control body needs braces", "an adjacent loop body owns one simple statement", "wrap the nested control statement in `{{ ... }}`")
        return ParsedBlock{span: token.span, statements: [Stmt]{}, tail: None}
    }
    parser_teach_control_braces(&state, "loop", token.span)
    statement :: parser_parse_statement(&state)
    end := parser_lookahead(&state, -1).span
    ParsedBlock{span: parser_cover(token.span, end), statements: [Stmt]{statement}, tail: None}
}

fn parser_loop_body_start(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_LBRACE || parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
}

// A `, stride` after a loop source, unless the comma opens the body.
fn parser_loop_stride(state: &JetParserState) -> Expr? {
    if parser_current_kind(&state) != TOKEN_COMMA -> return None
    parser_bump(&state)
    if parser_loop_body_start(&state) -> return None
    Val(parser_parse_expression_no_struct_lit(&state, 1).expr)
}

// D-LOOP-IN1=A: `x`, `(key, value)`, or the retired bare `x, y;` binding.
fn parser_loop_source_binding(state: &JetParserState) -> ParserExpressionFormLoopClause {
    if parser_current_kind(&state) == TOKEN_LPAREN -> return parser_expression_form_loop_binding(&state)
    first :: parser_expect_name(&state, "as the loop variable")
    if parser_current_kind(&state) == TOKEN_COMMA && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_kind_at(&state, 2) == TOKEN_SEMI {
        parser_bump(&state)
        second :: parser_expect_name(&state, "as the second loop variable")
        return ParserExpressionFormLoopClause{var: first.payload.decoded, var_span: first.span, var2: Val(NamedSpan{name: second.payload.decoded, span: second.span}), kind: ForKind.In{collection: Expr.Unit{span: first.span}, step: None}}
    }
    ParserExpressionFormLoopClause{var: first.payload.decoded, var_span: first.span, var2: None, kind: ForKind.In{collection: Expr.Unit{span: first.span}, step: None}}
}

fn parser_loop_source_separator(state: &JetParserState) {
    token :: parser_current(&state)
    if token.kind == TOKEN_KW_IN || (token.kind == TOKEN_SEMI && token.span.start < token.span.end) {
        parser_bump(&state)
        return
    }
    if token.kind == TOKEN_COMMA {
        parser_bump(&state)
        parser_expression_form_error(&state, "E0383", token.span, "a loop source needs `in`", "the source separator names the collection or range after the loop variable", "write `in` between the variable and source")
        return
    }
    parser_expect(&state, TOKEN_KW_IN, "between the loop binding and source").drop("parser_expect records the missing-token diagnostic")
}

// S19-amend: `loop` reads all loop forms by header: `loop {}` (infinite),
// `loop name := value, cond {}` (state), `loop x in source[, stride] {}`
// (iteration, `(key, value)` for two names) and `loop cond {}` (conditional).
fn parser_parse_loop_after_keyword(state: &JetParserState, start: Span, label: NamedSpan?) -> Stmt {
    first_kind :: parser_current_kind(&state)
    if first_kind == TOKEN_LBRACE || first_kind == TOKEN_UNIFIED_ARROW {
        arrow_body :: first_kind == TOKEN_UNIFIED_ARROW
        body :: parser_parse_loop_effect_body(&state)
        return Stmt.Loop{body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label}
    }
    second_kind :: parser_kind_at(&state, 1)
    if first_kind == TOKEN_IDENT && second_kind == TOKEN_COLON_EQ {
        // D-LOOP-HEADER2=A: a state loop starts with one mutable name binding.
        name :: parser_bump(&state)
        sigil :: parser_bump(&state)
        initial :: parser_parse_expression(&state, 1, 0)
        init :: ast_binding(name.payload.decoded, name.span, true, initial.expr, Val(sigil.span))
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
        } else {
            parser_expect(&state, TOKEN_COMMA, "after the state initializer").drop("parser_expect records the missing-token diagnostic")
        }
        condition :: parser_parse_expression_no_struct_lit(&state, 1)
        // D-LOOP-HEADER3=D: the three-slot C-style counter header is retired.
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            if !parser_loop_body_start(&state) {
                step_span :: parser_current(&state).span
                parser_parse_expression(&state, 1, 0)
                if parser_is_assignment_operator(parser_current_kind(&state)) {
                    parser_bump(&state)
                    parser_parse_expression(&state, 1, 0)
                }
                parser_add_fatal_code(&state, "E0376", step_span, "C-style counter loop headers are retired", "a three-slot loop header is binding, source, and step rule — not init, condition, and assignment", "write `loop i in 0..<n {{ … }}` or `loop i in 0..n, 2 {{ … }}`; keep `loop name := value, condition {{ … }}` for mutable state")
                return Stmt.Expr{expr: Expr.Unit{span: start}}
            }
        }
        arrow_body :: parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
        body :: parser_parse_loop_effect_body(&state)
        return Stmt.CountedLoop{init: init, cond: condition.expr, step: None, body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label}
    }
    if (first_kind == TOKEN_IDENT && (second_kind == TOKEN_SEMI || second_kind == TOKEN_COMMA || second_kind == TOKEN_KW_IN)) || first_kind == TOKEN_LPAREN {
        binding :: parser_loop_source_binding(&state)
        parser_loop_source_separator(&state)
        first :: parser_parse_expression_no_struct_lit(&state, 1)
        kind := ForKind.In{collection: first.expr, step: None}
        if first.expr == {
            .Range(range_start, range_end, exclusive, _) -> kind = ForKind.Range{start: range_start, end: range_end, step: parser_loop_stride(&state), exclusive: exclusive}
            else -> {
                if parser_current_kind(&state) == TOKEN_DOT_DOT || parser_current_kind(&state) == TOKEN_DOT_DOT_LT {
                    // D-RANGE-EXCL1=C: `..` is inclusive; `..<` is half-open.
                    exclusive :: parser_current_kind(&state) == TOKEN_DOT_DOT_LT
                    parser_bump(&state)
                    finish :: parser_parse_expression_no_struct_lit(&state, 1)
                    kind = ForKind.Range{start: first.expr, end: finish.expr, step: parser_loop_stride(&state), exclusive: exclusive}
                } else {
                    kind = ForKind.In{collection: first.expr, step: parser_loop_stride(&state)}
                }
            }
        }
        arrow_body :: parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
        body :: parser_parse_loop_effect_body(&state)
        return Stmt.For{var: binding.var, var_span: binding.var_span, var2: binding.var2, kind: kind, body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label, auto_vectorization: None}
    }
    condition :: parser_parse_expression_no_struct_lit(&state, 1)
    arrow_body :: parser_current_kind(&state) == TOKEN_UNIFIED_ARROW
    body :: parser_parse_loop_effect_body(&state)
    Stmt.While{cond: condition.expr, body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label}
}

fn parser_parse_loop_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    parser_parse_loop_after_keyword(&state, start.span, None)
}

fn parser_parse_labeled_loop(state: &JetParserState) -> Stmt {
    name :: parser_bump(&state)
    parser_bump(&state)
    parser_bump(&state)
    parser_parse_loop_after_keyword(&state, name.span, Val(NamedSpan{name: name.payload.decoded, span: name.span}))
}

// Rust `named_loop_is_value`: `name :: loop …` binds a loop value when an
// item arrow follows the header outside any group, or when a payload `break`
// leaves this loop (labelled, or bare and not under a nested loop); otherwise
// `name ::` labels a statement loop.
fn parser_named_loop_is_value(state: &JetParserState) -> Bool Never! {
    label :: parser_current(&state).payload.decoded
    braces := 0
    parens := 0
    brackets := 0
    saw_body := false
    nested_loop_pending := false
    nested_loop_braces := [Int]{}
    // Skip the `name`, `::` and `loop` tokens.
    index := parser_next_code_index(state, state.position)
    if index >= 0 -> index = parser_next_code_index(state, index + 1)
    if index >= 0 -> index = parser_next_code_index(state, index + 1)
    if index >= 0 -> index = parser_next_code_index(state, index + 1)
    loop index >= 0 {
        kind :: state.tokens[index].kind
        next_index :: parser_next_code_index(state, index + 1)
        if kind == {
            TOKEN_LBRACE -> {
                braces += 1
                saw_body = true
                if nested_loop_pending {
                    &nested_loop_braces.push(braces)
                    nested_loop_pending = false
                }
            }
            TOKEN_RBRACE -> {
                if braces == 0 -> return false
                if nested_loop_braces.len() > 0 && nested_loop_braces[nested_loop_braces.len() - 1] == braces {
                    _ := &nested_loop_braces.pop()
                }
                braces -= 1
                if saw_body && braces == 0 -> return false
            }
            TOKEN_LPAREN -> parens += 1
            TOKEN_RPAREN -> {
                if parens > 0 -> parens -= 1
            }
            TOKEN_LBRACKET -> brackets += 1
            TOKEN_RBRACKET -> {
                if brackets > 0 -> brackets -= 1
            }
            TOKEN_UNIFIED_ARROW | TOKEN_LAMBDA_ARROW -> {
                if braces == 0 && parens == 0 && brackets == 0 -> return true
            }
            TOKEN_KW_LOOP -> {
                if braces >= 1 -> nested_loop_pending = true
            }
            TOKEN_BREAK -> {
                if parens == 0 && brackets == 0 {
                    next_kind :: if next_index >= 0 -> state.tokens[next_index].kind else -> TOKEN_EOF
                    name_index :: if next_index >= 0 -> parser_next_code_index(state, next_index + 1) else -> -1
                    comma_index :: if name_index >= 0 -> parser_next_code_index(state, name_index + 1) else -> -1
                    targets_label :: next_kind == TOKEN_LPAREN && name_index >= 0 && state.tokens[name_index].kind == TOKEN_IDENT && state.tokens[name_index].payload.decoded == label && comma_index >= 0 && state.tokens[comma_index].kind == TOKEN_COMMA
                    // D-CHOOSE-FIND1=A: a search payload may sit under an
                    // `if`, but not under an explicitly nested loop.
                    bare_payload :: braces >= 1 && nested_loop_braces.len() == 0 && next_kind != TOKEN_SEMI && next_kind != TOKEN_RBRACE && next_kind != TOKEN_LPAREN
                    if targets_label || bare_payload -> return true
                }
            }
            TOKEN_EOF -> {
                if braces == 0 && parens == 0 && brackets == 0 -> return false
            }
            else -> {}
        }
        index = next_index
    }
    false
}

fn parser_parse_return_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    value := Expr?{None}
    end := start.span
    if parser_current_kind(&state) != TOKEN_SEMI && parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parsed :: parser_parse_expression(&state, 1, 0)
        value = Val(parsed.expr)
        end = parsed.span
    }
    parser_finish_statement(&state)
    Stmt.Return{value: value, span: parser_cover(start.span, end)}
}

fn parser_parse_break_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        name :: parser_expect_name(&state, "as a loop label")
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            value :: parser_parse_expression(&state, 1, 0)
            close :: parser_expect(&state, TOKEN_RPAREN, "`)` after labeled break")
            parser_finish_statement(&state)
            return Stmt.BreakLabelValue{name: name.payload.decoded, name_span: name.span, value: value.expr, span: parser_cover(start.span, close.span)}
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after loop label")
        parser_finish_statement(&state)
        return Stmt.BreakLabel{name: name.payload.decoded, span: parser_cover(start.span, close.span)}
    }
    if parser_current_kind(&state) != TOKEN_SEMI && parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        value :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        return Stmt.BreakValue{value: value.expr, span: parser_cover(start.span, value.span)}
    }
    parser_finish_statement(&state)
    Stmt.Break{span: start.span}
}

// D-PREP-SURFACE2=A: `@ name :: value` is a retired constant. The mark always
// meant compile time, so E0388 teaches `name :: prep { value }` and the parse
// continues as that prepared binding.
fn parser_parse_comptime_binding(state: &JetParserState) -> Stmt {
    at :: parser_bump(&state)
    name :: parser_expect_name(&state, "after `@` in a constant")
    plain :: parser_retire_const_decl(&state, parser_cover(at.span, name.span), "@{name.payload.decoded}")
    sigil :: parser_expect(&state, TOKEN_COLON_COLON, "`::` after a constant name")
    value :: parser_parse_expression(&state, 1, 0)
    binding := ast_binding(plain, name.span, false, value.expr, Val(sigil.span))
    binding.is_comptime = true
    parser_finish_statement(&state)
    Stmt.Val{binding: binding}
}

// Rust `KwComptime` statements: the retired keyword teaches E0374 and the
// statement recovers as `prep if`, `prep { … }`, or the retired compile-time
// binding `comptime name = value`.
fn parser_parse_retired_comptime_statement(state: &JetParserState) -> Stmt {
    keyword :: parser_current(&state)
    parser_add_error_code(&state, "E0374", keyword.span, "`comptime` is retired", "Jet folds ordinary foldable expressions automatically; explicit compile-time demand lives on the marker plane", "remove the keyword; a build-time value is written `name :: prep {{ … }}`, and `prep {{ … }}` runs other work while building")
    if parser_kind_at(&state, 1) == TOKEN_KW_IF -> return parser_parse_prep_if(&state)
    if parser_kind_at(&state, 1) == TOKEN_LBRACE -> return parser_parse_prep_block(&state)
    parser_bump(&state)
    name :: parser_expect_name(&state, "for the compile-time binding")
    parser_expect(&state, TOKEN_EQ, "`=` in the retired comptime binding")
    value :: parser_parse_expression(&state, 1, 0)
    binding := ast_binding(name.payload.decoded, name.span, false, value.expr, None)
    binding.is_comptime = true
    parser_finish_statement(&state)
    Stmt.Val{binding: binding}
}

// D-PREP-BRANCH1=A / D-PREP-FN1=A: `prep` leads a build-time verb only when
// the verb keyword follows it on the same line; everywhere else `prep` is an
// ordinary name, so the lexer never reserves it.
fn parser_prep_verb_ahead(state: &JetParserState, offset: Int, verb: Int) -> Bool Never! {
    token :: parser_lookahead(&state, offset)
    token.kind == TOKEN_IDENT && token.payload.decoded == "prep" && parser_kind_at(&state, offset + 1) == verb
}

// Consume `prep` ahead of a build-time verb. The retired `@if`, `@loop` and
// `@fn` heads teach E0388 once and recover as the `prep` form.
fn parser_take_prep_head(state: &JetParserState, verb: String) -> Token {
    head :: parser_current(&state)
    if head.kind == TOKEN_AT {
        verb_token :: parser_lookahead(&state, 1)
        parser_add_error_code(&state, "E0388", parser_cover(head.span, verb_token.span), "`@{verb}` is retired; write `prep {verb}`", "build-time blocks, branches, loops and functions carry the word `prep`, the same word Jet uses for every build-time step; the meaning and the checks are unchanged", "replace `@{verb}` with `prep {verb}`")
    }
    parser_bump(&state)
}

// D-PREP-SURFACE2=A: `prep { … }` is the explicit shared-preparation block. It
// runs while building and emits no runtime code. The retired `@ { … }` head
// teaches E0388 once and recovers as the `prep` block.
fn parser_parse_prep_block(state: &JetParserState) -> Stmt {
    start :: parser_current(&state)
    if start.kind == TOKEN_AT {
        brace :: parser_lookahead(&state, 1)
        parser_add_error_code(&state, "E0388", parser_cover(start.span, brace.span), "`@ {{ … }}` is retired; write `prep {{ … }}`", "build-time blocks, branches, loops and functions carry the word `prep`, the same word Jet uses for every build-time step; the meaning and the checks are unchanged", "replace `@ {{ … }}` with `prep {{ … }}`")
    }
    parser_bump(&state)
    block :: parser_parse_block(&state)
    Stmt.ComptimeBlock{body: block.statements, is_template_loop: false, span: parser_cover(start.span, block.span)}
}

// D-PREP-FN1=A: a build-time method writes `prep fn` directly before `fn`.
fn parser_prep_fn_ahead(state: &JetParserState) -> Bool Never! {
    parser_prep_verb_ahead(&state, 0, TOKEN_KW_FN) || (parser_current_kind(&state) == TOKEN_AT && parser_kind_at(&state, 1) == TOKEN_KW_FN)
}

fn parser_take_prep_fn(state: &JetParserState) -> Bool {
    if !parser_prep_fn_ahead(&state) -> return false
    parser_take_prep_head(&state, "fn")
    true
}

// D-PREP-BRANCH1=A: `prep if <cond> { … } else prep if … else { … }` and the
// D-OSTARGET2=B dispatch `prep if <subject> == { .Arm -> … else -> … }`, which
// shares the `if` arm grammar. Sema selects the arm; unselected arms are
// name-checked only (D-WHEN2).
fn parser_parse_prep_if(state: &JetParserState) -> Stmt {
    start :: parser_take_prep_head(&state, "if")
    parser_expect(&state, TOKEN_KW_IF, "`if` after `prep`")
    saved_position :: state.position
    saved_diagnostics :: state.diagnostics.len()
    saved_blocks :: state.block_spans.len()
    saved_else_arms :: state.else_arms.len()
    subject :: parser_parse_expression_no_struct_lit_no_cmp(&state, 1)
    if parser_current_kind(&state) == TOKEN_EQ_EQ && parser_kind_at(&state, 1) == TOKEN_LBRACE {
        parser_bump(&state)
        parser_expect(&state, TOKEN_LBRACE, "`{{` to open the `prep if` dispatch body")
        dispatch :: parser_parse_if_arms(&state, subject.expr, start.span, BinOp.Eq)
        span :: Span{start: start.span.start, end: parser_previous_end(state)}
        if dispatch == .Switch(dispatch_subject, arms, else_body, _) -> return Stmt.ComptimeSwitch{subject: dispatch_subject, arms: arms, else_body: else_body, span: span}
        return dispatch
    }
    parser_rewind(&state, saved_position, saved_diagnostics, saved_blocks, saved_else_arms)
    condition :: parser_parse_expression_no_struct_lit(&state, 1)
    then_block :: parser_parse_block(&state)
    else_body := [Stmt]?{None}
    end := then_block.span
    if parser_current_kind(&state) == TOKEN_KW_ELSE {
        parser_bump(&state)
        if parser_prep_verb_ahead(&state, 0, TOKEN_KW_IF) || (parser_current_kind(&state) == TOKEN_AT && parser_kind_at(&state, 1) == TOKEN_KW_IF) {
            chained :: parser_parse_prep_if(&state)
            else_body = Val([Stmt]{chained})
            end = parser_lookahead(&state, -1).span
        } else {
            final_block :: parser_parse_block(&state)
            else_body = Val(final_block.statements)
            end = final_block.span
        }
    }
    Stmt.ComptimeIf{cond: condition.expr, cond_span: condition.span, then_body: then_block.statements, else_body: else_body, span: parser_cover(start.span, end), selected_then: None}
}

// D-PREP-BRANCH1=A: `prep loop …` is the ordinary loop run while building. It
// is one compile-time block holding that loop, so it emits no runtime code.
fn parser_parse_prep_loop(state: &JetParserState) -> Stmt {
    start :: parser_take_prep_head(&state, "loop")
    keyword :: parser_expect(&state, TOKEN_KW_LOOP, "`loop` after `prep`")
    body :: parser_parse_loop_after_keyword(&state, keyword.span, None)
    end :: parser_lookahead(&state, -1).span
    Stmt.ComptimeBlock{body: [Stmt]{body}, is_template_loop: state.derive_template_depth > 0, span: parser_cover(start.span, end)}
}

// D-BIND-BARE1 / S74 (Rust `looks_like_sigil_binding` destructuring arms): a
// `[ … ]`, `( … )`, `Type{ … }` or retired `Type.{ … }` target whose matching
// close is followed by `::` or `:=`. Bounded by the bracket depth.
fn parser_pattern_binding_ahead(state: &JetParserState) -> Bool Never! {
    offset := 0
    if parser_current_kind(&state) == TOKEN_IDENT {
        offset = 1
        if parser_kind_at(&state, 1) == TOKEN_DOT && parser_kind_at(&state, 2) == TOKEN_LBRACE -> offset = 2
        if parser_kind_at(&state, offset) != TOKEN_LBRACE -> return false
    }
    open :: parser_kind_at(&state, offset)
    close := TOKEN_RBRACE
    if open == TOKEN_LBRACKET -> close = TOKEN_RBRACKET
    if open == TOKEN_LPAREN -> close = TOKEN_RPAREN
    if open != TOKEN_LBRACKET && open != TOKEN_LPAREN && open != TOKEN_LBRACE -> return false
    // Rust `try_bind_pattern`: `( name: … )` opens a named tuple, never a pattern.
    if open == TOKEN_LPAREN && parser_kind_at(&state, offset + 1) == TOKEN_IDENT && parser_kind_at(&state, offset + 2) == TOKEN_COLON -> return false
    depth := 0
    loop {
        kind :: parser_kind_at(&state, offset)
        if kind == TOKEN_EOF -> return false
        if kind == open -> depth += 1
        if kind == close {
            depth -= 1
            if depth == 0 {
                after :: parser_kind_at(&state, offset + 1)
                return after == TOKEN_COLON_COLON || after == TOKEN_COLON_EQ
            }
        }
        offset += 1
    }
    false
}

// S74 (Rust `sigil_binding` + `try_bind_pattern`): a destructuring binding
// `[a, b] :: list`, `(a, b) :: tuple` or `Type{x, y: local, ..} :: value`.
fn parser_parse_pattern_binding_statement(state: &JetParserState) -> Stmt {
    start :: parser_current(&state)
    pattern := BindPattern.List{elems: [BindName]{}, span: start.span}
    if start.kind == {
        TOKEN_LBRACKET -> {
            parser_bump(&state)
            elems :: parser_pattern_binding_names(&state, TOKEN_RBRACKET, "for a list-pattern binding")
            close :: parser_expect(&state, TOKEN_RBRACKET, "`]` to close the list pattern")
            pattern = BindPattern.List{elems: elems, span: parser_cover(start.span, close.span)}
        }
        TOKEN_LPAREN -> {
            parser_bump(&state)
            elems :: parser_pattern_binding_names(&state, TOKEN_RPAREN, "for a tuple-pattern binding")
            close :: parser_expect(&state, TOKEN_RPAREN, "`)` to close the tuple pattern")
            pattern = BindPattern.Tuple{elems: elems, span: parser_cover(start.span, close.span)}
        }
        else -> {
            type_name := ""
            type_span := start.span
            if start.kind != TOKEN_LBRACE {
                head :: parser_expect_name(&state, "for a struct pattern")
                type_name = head.payload.decoded
                type_span = head.span
                if parser_current_kind(&state) == TOKEN_DOT {
                    dot :: parser_bump(&state)
                    parser_add_fatal_code(&state, "E0320", dot.span, "struct pattern uses `{type_name}{{…}}`, not `{type_name}.{{…}}`", "literal heads place no dot before their brace (D-LIT-DOT1)", "write `{type_name}{{…}}`")
                }
            }
            parser_expect(&state, TOKEN_LBRACE, "`{{` to open the struct pattern")
            fields := [BindName]{}
            rest := Span?{None}
            if parser_current_kind(&state) != TOKEN_RBRACE {
                loop {
                    if parser_current_kind(&state) == TOKEN_DOT_DOT {
                        rest = Val(parser_bump(&state).span)
                        break
                    }
                    field :: parser_expect_name(&state, "for a struct-pattern field")
                    rename := BindNameRename?{None}
                    if parser_current_kind(&state) == TOKEN_COLON {
                        parser_bump(&state)
                        local :: parser_expect_name(&state, "as the renamed binding")
                        rename = Val(BindNameRename{name: local.payload.decoded, span: local.span})
                    }
                    &fields.push(BindName{name: field.payload.decoded, span: field.span, rename: rename})
                    if parser_current_kind(&state) != TOKEN_COMMA -> break
                    parser_bump(&state)
                    if parser_current_kind(&state) == TOKEN_RBRACE -> break
                }
            }
            close :: parser_expect(&state, TOKEN_RBRACE, "`}}` to close the struct pattern")
            span :: parser_cover(type_span, close.span)
            pattern = BindPattern.Struct{type_name: type_name, type_span: type_span, fields: fields, rest: rest, span: span}
        }
    }
    sigil :: parser_bump(&state)
    value :: parser_parse_expression(&state, 1, 0)
    binding := ast_binding("", parser_bind_pattern_span(pattern), sigil.kind == TOKEN_COLON_EQ, value.expr, Val(sigil.span))
    binding.pattern = Val(pattern)
    parser_finish_statement(&state)
    Stmt.Val{binding: binding}
}

// The comma-separated names of a list or tuple pattern, up to `close`.
fn parser_pattern_binding_names(state: &JetParserState, close: Int, context: String) -> [BindName] {
    elems := [BindName]{}
    if parser_current_kind(&state) == close -> return elems
    loop {
        name :: parser_expect_name(&state, context)
        &elems.push(BindName{name: name.payload.decoded, span: name.span, rename: None})
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
    }
    elems
}

fn parser_bind_pattern_span(pattern: BindPattern) -> Span Never! {
    if pattern == {
        .Struct(_, _, _, _, span) | .List(_, span) | .Tuple(_, span) | .Refutable(_, _, _, span) -> span
    }
}

fn parser_parse_binding_statement(state: &JetParserState) -> Stmt {
    name :: parser_expect_name(&state, "in a binding")
    if parser_current_kind(&state) == TOKEN_COLON {
        retired :: parser_parse_retired_typed_binding(&state, name)
        if retired == .Val(statement) -> return statement
    }
    sigil :: parser_current(&state)
    mutable :: if {
        sigil.kind == TOKEN_COLON_EQ || sigil.kind == TOKEN_COLON_COLON -> {
            parser_bump(&state)
            sigil.kind == TOKEN_COLON_EQ
        }
        else -> {
            parser_add_error(&state, sigil.span, "expected `:=` or `::` in a binding", "the binding sigil distinguishes a mutable value from an immutable one", "write `:=` for mutable or `::` for immutable")
            false
        }
    }
    // D-PREP-SURFACE2=A: `name :: prep { value }` is the prepared-value
    // binding. A block holding only its final expression lowers to the one
    // compile-time binding path; any other block keeps E0391.
    if !mutable && parser_prep_verb_ahead(&state, 0, TOKEN_LBRACE) {
        head :: parser_bump(&state)
        block :: parser_parse_value_block(&state, 0, true)
        span :: parser_cover(head.span, block.span)
        if block.statements.len() == 0 && block.tail == .Val(tail) {
            prepared := ast_binding(parser_retire_const_mark(&state, name), name.span, false, tail, Val(sigil.span))
            prepared.is_comptime = true
            parser_finish_statement(&state)
            return Stmt.Val{binding: prepared}
        }
        parser_add_error_code(&state, "E0391", span, "`prep {{ … }}` is used as a value, which this compiler does not support yet", "D-PREP-SURFACE2=A makes the block's final expression its value; only a block holding a single final expression is folded today", "write `name :: prep {{ value }}` with one final expression, or a `prep {{ … }}` statement")
        parser_finish_statement(&state)
        return Stmt.Val{binding: ast_binding(name.payload.decoded, name.span, false, Expr.Unit{span: span}, Val(sigil.span))}
    }
    // Bare `name := uninit` — an explicit type must precede the literal body.
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "uninit" {
        after :: parser_kind_at(&state, 1)
        if after == TOKEN_SEMI || after == TOKEN_RBRACE || after == TOKEN_EOF {
            uninit_token :: parser_current(&state)
            parser_add_error_code(&state, "E0421", uninit_token.span, "`uninit` needs an explicit type", "an uninitialized binding has no value to infer its type from, so the type must appear before the literal body", "write `{name.payload.decoded} := <Type>{{ uninit }}`, e.g. `buffer := [U8#4096]{{ uninit }}`")
            parser_sync_stmt(&state)
            return Stmt.Expr{expr: Expr.Unit{span: uninit_token.span}}
        }
    }
    value :: parser_parse_expression(&state, 1, 0)
    // A retired `@name :: value` recovers as `name :: prep { value }`.
    retired :: !mutable && name.payload.decoded.starts_with("@")
    binding_name :: if retired -> parser_retire_const_decl(&state, name.span, name.payload.decoded) else -> parser_retire_const_mark(&state, name)
    binding := ast_binding(binding_name, name.span, mutable, value.expr, Val(sigil.span))
    binding.is_comptime = retired
    // D-UNINIT-SENTINEL2: `name := Type{ uninit }` — `uninit` only as the
    // whole typed-literal body, and only on a mutable binding. Sema proves
    // write-before-read; the type rides on the binding.
    if mutable && value.expr == .TypedLit(head, body, literal_span) {
        if parser_typed_literal_uninit_marker(head, body) == .Val(marker_span) {
            binding.ty = head
            binding.ty_span = Val(literal_span)
            binding.init = Expr.Int{value: 0, span: marker_span, width: None, raw: None}
            binding.uninit = true
        }
    }
    parser_finish_statement(&state)
    Stmt.Val{binding: binding}
}

// D-UNINIT-SENTINEL2: the `uninit` span when a headed typed literal's whole
// body is the bare word `uninit`. Named heads parse it as a one-field
// shorthand, list heads as one element.
fn parser_typed_literal_uninit_marker(head: Type?, body: TypedLitBody) -> Span? {
    if head == None -> return None
    if body == {
        .Value(inner) -> {
            if inner == .Ident(word, span) && word == "uninit" -> return Val(span)
        }
        .Elements(elements) -> {
            if elements.len() == 1 && elements[0] == .Ident(word, span) && word == "uninit" -> return Val(span)
        }
        .Fields(fields) -> {
            if fields.len() == 1 && fields[0].name == "uninit" && fields[0].value == .Ident(word, _) && word == "uninit" -> return Val(fields[0].name_span)
        }
        else -> {}
    }
    None
}

// D-BIND-TYPE2=A: the retired `name: Type :: value` (or `:=`) teaches E0393
// with a behavior-preserving edit to `name :: Type{value}`, then parses on as
// the untyped binding so one mistake reports once. Returns None with the
// cursor restored when the tokens after `:` are not a type and a sigil.
fn parser_parse_retired_typed_binding(state: &JetParserState, name: Token) -> Stmt? {
    saved_position := state.position
    saved_diagnostics := state.diagnostics.len()
    saved_gt := state.pending_type_gt
    saved_gt_span := state.pending_type_gt_span
    colon :: parser_bump(&state)
    type_start :: state.position
    parsed :: parser_parse_type(&state, 0)
    type_end :: state.position
    sigil :: parser_current(&state)
    if state.diagnostics.len() != saved_diagnostics || (sigil.kind != TOKEN_COLON_COLON && sigil.kind != TOKEN_COLON_EQ) {
        state.position = saved_position
        loop state.diagnostics.len() > saved_diagnostics -> _ := &state.diagnostics.pop()
        state.pending_type_gt = saved_gt
        state.pending_type_gt_span = saved_gt_span
        return None
    }
    parser_bump(&state)
    mutable :: sigil.kind == TOKEN_COLON_EQ
    value_start :: state.position
    value :: parser_parse_expression(&state, 1, 0)
    value_end :: state.position
    binding_name :: name.payload.decoded
    type_text :: parser_tokens_text(state, type_start, type_end)
    value_text :: parser_tokens_text(state, value_start, value_end)
    sigil_text :: if mutable -> ":=" else -> "::"
    replacement :: "{binding_name} {sigil_text} {type_text}{{{value_text}}}"
    diagnostic :: diagnostic_from_registry("E0393", Val(parser_cover(colon.span, parsed.span)), "`{binding_name}: {type_text}` puts a type after the binding name, which Jet does not accept.", "A binding carries no type of its own (D-BIND-BARE1); `Type{{ … }}` on the value states the type, checking the value or converting it the way a parameter of that type would.", "Write `{replacement}`.")
    // The edit ends at the value's last token; `value.span` is only the head
    // of some forms (a method call's span is its method name).
    &state.diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: name.span.start, end: parser_previous_end(state)}, new_text: replacement}))
    binding :: ast_binding(binding_name, name.span, mutable, value.expr, Val(sigil.span))
    parser_finish_statement(&state)
    Val(Stmt.Val{binding: binding})
}

// Rust `KW_DEFER`: `defer close(^resource)` keeps the whole close call; any
// other shape is fatal at the statement.
fn parser_parse_defer_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    close :: parser_parse_expression(&state, 1, 0)
    valid :: if close.expr == {
        .Call(call) -> call.name == "close" && call.args.len() == 1 && call.args[0].convention == AccessConvention.Move && call.args[0].expr == .Ident(_, _)
        else -> false
    }
    span :: parser_cover(start.span, close.span)
    if !valid {
        parser_add_error(&state, span, "`defer` only schedules a consuming resource close", "Jet has no general deferred-action mechanism; resource cleanup stays explicit and ownership-checked through the move marker `^`", "write `defer close(^resource)` with the move marker `^`")
        return Stmt.Expr{expr: Expr.Unit{span: start.span}}
    }
    parser_finish_statement(&state)
    Stmt.DeferClose{close: close.expr, span: span}
}

// Rust `KW_ASSERT`: `assert a, b` records unsafe-evidence names as the
// internal assertion call that sema removes before TIR.
fn parser_parse_assert_names(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    args := [CallArg]{}
    loop {
        name :: parser_expect_name(&state, "after `assert`")
        &args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Ident{name: name.payload.decoded, span: name.span}, span: name.span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
        if parser_current_kind(&state) != TOKEN_COMMA -> break
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_RPAREN -> break
    }
    parser_finish_statement(&state)
    Stmt.Expr{expr: Expr.Call{call: Call{name: "__jet_unsafe_assert", name_span: start.span, type_args: [Type]{}, args: args, resolved_ret: None, range_checked: false, widen_approx: false}}}
}

// Rust `stmt`, its name/`self` arm and its general expression arm (#18): a
// line must do something. A computed value is allowed only as the bare last
// line of a callable body; any other unused value is fatal E0003.
fn parser_parse_assignment_or_expression(state: &JetParserState) -> Stmt {
    start :: parser_current(&state)
    if start.kind == TOKEN_KW_IN {
        parser_bump(&state)
        parser_add_error(&state, start.span, "`in` is reserved as the source-loop keyword", "the `in` keyword marks the boundary between a loop binding and its source", "choose a different identifier name, or use `in` in a source loop; after `.` it is allowed as a member name")
        return Stmt.Expr{expr: Expr.Unit{span: start.span}}
    }
    named :: start.kind == TOKEN_IDENT || start.kind == TOKEN_SELF
    if !named && !parser_starts_expression(start.kind) {
        parser_report_not_a_statement(&state, start)
        return Stmt.Expr{expr: Expr.Unit{span: start.span}}
    }
    left :: parser_parse_expression(&state, 1, 0)
    if parser_refutable_test_binding(left.expr) == .Val(binding) {
        parser_finish_statement(&state)
        return Stmt.Val{binding: binding}
    }
    operator :: parser_current_kind(&state)
    if parser_is_assignment_operator(operator) {
        op_token :: parser_bump(&state)
        right :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        target :: parser_expression_lvalue(&state, left.expr, left.span, op_token)
        return Stmt.Assign{target: target, op: parser_assignment_binop(operator), op_span: op_token.span, value: right.expr}
    }
    if named && !parser_named_line_does_work(&state, left.expr) {
        parser_add_error(&state, expr_span(left.expr), "this line computes a value but doesn't do anything with it", "only calls, bindings, assignments, and `return` are allowed here", "use the value, e.g. `x :: ...` or `print(...)`")
        return Stmt.Expr{expr: left.expr}
    }
    if !named && !parser_marked_line_does_work(&state, left.expr, start.kind) {
        parser_report_not_a_statement(&state, start)
        return Stmt.Expr{expr: left.expr}
    }
    parser_finish_statement(&state)
    Stmt.Expr{expr: left.expr}
}

fn parser_report_not_a_statement(state: &JetParserState, start: Token) {
    parser_add_error(&state, start.span, "expected a call, binding, assignment, or `return`, found {parser_describe_token(start)}", "inside a function body, write a call, binding, assignment, or `return`", "e.g. print(\"hello\") or x :: 1")
}

// Rust `starts_expr`: the tokens that can open an expression line.
fn parser_starts_expression(kind: Int) -> Bool Never! {
    if kind == TOKEN_IDENT || kind == TOKEN_INT || kind == TOKEN_FLOAT || kind == TOKEN_UNIT_NUMBER || kind == TOKEN_RAW_STRING || kind == TOKEN_STRING || kind == TOKEN_CHAR -> return true
    if kind == TOKEN_TRUE || kind == TOKEN_FALSE || kind == TOKEN_NULL || kind == TOKEN_KW_IT || kind == TOKEN_SELF || kind == TOKEN_KW_LOOP || kind == TOKEN_KW_IF || kind == TOKEN_KW_MOVE || kind == TOKEN_KW_COPY -> return true
    if kind == TOKEN_LPAREN || kind == TOKEN_LBRACE || kind == TOKEN_LBRACKET || kind == TOKEN_HASH || kind == TOKEN_DOLLAR || kind == TOKEN_DOT -> return true
    kind == TOKEN_MINUS || kind == TOKEN_BANG || kind == TOKEN_TILDE || kind == TOKEN_STAR || kind == TOKEN_AMP || kind == TOKEN_CARET || kind == TOKEN_PLUS_PLUS || kind == TOKEN_MINUS_MINUS
}

// A line that starts with a name or `self` works when it calls, names a
// field place, propagates or falls back (`?`, `??`), names a compile-time
// value, or is the compact Result handler. `x?.m()` is Rust's `CallValue`
// on an `OptField`.
fn parser_named_line_does_work(state: &JetParserState, expr: Expr) -> Bool Never! {
    works :: if expr == {
        .Call(_) | .Field(_, _, _) | .MethodCall(_, _, _, _, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _) | .ComptimeName(_, _, _) | .Try(_, _, _, _) | .OrFallback(_, _, _, _) -> true
        .CallValue(callee, _, _) -> callee == .OptField(_, _, _, _, _)
        .If(_, _, _, _, _, _) -> parser_is_result_handler_expr(expr)
        else -> false
    }
    works || parser_at_callable_tail(&state) || parser_recovered_retired_step(&state, expr)
}

// D-CAP-RECEIVER1=D: any other line works when it starts with the `&`/`^`
// mark of the call that writes or takes that place (`&buf.push(x)`).
fn parser_marked_line_does_work(state: &JetParserState, expr: Expr, start_kind: Int) -> Bool Never! {
    if start_kind == TOKEN_AMP || start_kind == TOKEN_CARET {
        call :: if expr == {
            .Call(_) | .MethodCall(_, _, _, _, _, _, _, _, _, _) | .Try(_, _, _, _) | .OrFallback(_, _, _, _) -> true
            else -> false
        }
        if call -> return true
    }
    parser_recovered_retired_step(&state, expr) || parser_at_callable_tail(&state)
}

// The line ends the innermost callable body (before its `}`).
fn parser_at_callable_tail(state: &JetParserState) -> Bool Never! {
    if state.callable_tail_depth != state.block_depth -> return false
    kind :: parser_current_kind(&state)
    kind == TOKEN_RBRACE || (kind == TOKEN_SEMI && parser_kind_at(&state, 1) == TOKEN_RBRACE)
}

// Rust `recovered_retired_step`: the operand of a retired `++`/`--` step
// that ends right here; E0160 already covers the line.
fn parser_recovered_retired_step(state: &JetParserState, expr: Expr) -> Bool Never! {
    previous_end :: parser_lookahead(&state, -1).span.end
    whole :: state.retired_step ?? return false
    span :: expr_span(expr)
    whole.end == previous_end && whole.start <= span.start && span.end <= whole.end
}

// Rust `is_result_handler_expr`: `value ? ok -> … ! err -> …` is the one
// value `if` allowed as an effect line.
fn parser_is_result_handler_expr(expr: Expr) -> Bool Never! {
    if expr == .If(cond, _, _, _, else_value, _) {
        if cond == .PatternTest(_, ok_pattern, _) {
            if else_value == .If(err_cond, _, _, _, terminal, _) {
                if err_cond == .PatternTest(_, err_pattern, _) -> return ok_pattern == .Ok(_, _, _, _) && err_pattern == .Err(_, _, _, _) && terminal == .NoElse(_)
            }
        }
    }
    false
}

// Rust `try_refutable_test_binding` (D-CHOOSE-TEST1=A): a pattern test with
// a diverging fallback that captures names is a statement binding; the
// tested subject is the binding's value.
fn parser_refutable_test_binding(expr: Expr) -> Binding? {
    if expr == .OrFallback(value, fallback, _, span) {
        if value == .PatternTest(subject, pattern, pattern_span) {
            names :: pattern_binding_names(pattern)
            if names.len() == 0 -> return None
            binding := ast_binding("", pattern_span, false, subject, None)
            binding.pattern = Val(BindPattern.Refutable{pattern: pattern, fallback: fallback, names: names, span: span})
            return Val(binding)
        }
    }
    None
}

fn parser_is_assignment_operator(kind: Int) -> Bool Never! {
    kind == TOKEN_EQ || kind == TOKEN_PLUS_EQ || kind == TOKEN_MINUS_EQ || kind == TOKEN_STAR_EQ || kind == TOKEN_SLASH_EQ || kind == TOKEN_SLASH_PERCENT_EQ || kind == TOKEN_PERCENT_EQ || kind == TOKEN_PERCENT_PERCENT_EQ || kind == TOKEN_AMP_EQ || kind == TOKEN_PIPE_EQ || kind == TOKEN_CARET_EQ || kind == TOKEN_TILDE_PIPE_EQ || kind == TOKEN_SHL_EQ || kind == TOKEN_SHR_EQ
}

fn parser_assignment_binop(kind: Int) -> BinOp? {
    if kind == {
        TOKEN_EQ -> None
        TOKEN_PLUS_EQ -> Val(BinOp.Add)
        TOKEN_MINUS_EQ -> Val(BinOp.Sub)
        TOKEN_STAR_EQ -> Val(BinOp.Mul)
        TOKEN_SLASH_EQ -> Val(BinOp.Div)
        TOKEN_SLASH_PERCENT_EQ -> Val(BinOp.FloorDiv)
        TOKEN_PERCENT_EQ -> Val(BinOp.Mod)
        TOKEN_PERCENT_PERCENT_EQ -> Val(BinOp.Rem)
        TOKEN_AMP_EQ -> Val(BinOp.BitAnd)
        TOKEN_PIPE_EQ -> Val(BinOp.BitOr)
        TOKEN_CARET_EQ -> Val(BinOp.Pow)
        TOKEN_TILDE_PIPE_EQ -> Val(BinOp.BitXor)
        TOKEN_SHL_EQ -> Val(BinOp.Shl)
        TOKEN_SHR_EQ -> Val(BinOp.Shr)
        else -> None
    }
}

// S17: an assignment target is a name, an indexed slot or a field place,
// after any parentheses; a compound update of anything else is E0165.
fn parser_expression_lvalue(state: &JetParserState, expr: Expr, fallback_span: Span, operator: Token) -> LValue {
    if expr == {
        .Paren(inner, _) -> return parser_expression_lvalue(&state, inner, fallback_span, operator)
        .Ident(name, span) -> return LValue.Local{name: name, name_span: span}
        .Field(base, member, span) -> return LValue.Field{base: base, field: member, span: span}
        .Index(base, index, span, kind) -> return LValue.Index{base: base, index: index, span: span, kind: kind}
        else -> {}
    }
    if operator.kind != TOKEN_EQ {
        parser_add_fatal_code(&state, "E0165", expr_span(expr), "Compound assignment needs a mutable place.", "S17 permits updates only on a mutable name or an `&` parameter; a computed value has no place to update.", "Bind the value with `:=`, then write `name {operator.payload.text} value`")
    } else {
        parser_add_error(&state, expr_span(expr), "this value can't be assigned to", "only a name or an indexed slot like `items[0]` can appear on the left of `=`", "use `name := ...` or `map[key] = ...`")
    }
    LValue.Local{name: "__jet_error", name_span: fallback_span}
}

// S6-R: a statement ends at its line terminator, or before a closing `}` or
// the end of the file; a one-statement `->` body may also end before `else`.
// Anything else shares the line and is a fatal error.
fn parser_finish_statement(state: &JetParserState) {
    token :: parser_current(&state)
    if token.kind == TOKEN_SEMI {
        parser_bump(&state)
        return
    }
    if token.kind == TOKEN_RBRACE || token.kind == TOKEN_EOF || (token.kind == TOKEN_KW_ELSE && state.adjacent_if_body_depth > 0) -> return
    parser_add_error(&state, token.span, "something unexpected appeared after this line, found {parser_describe_token(token)}", "each line ends where the line break is (no `;` needed)", "put the next line of code on a new line")
}

fn parser_parse_marked_statement(state: &JetParserState) -> Stmt {
    hash :: parser_bump(&state)
    negated := false
    if parser_current_kind(&state) == TOKEN_BANG {
        parser_bump(&state)
        negated = true
    }
    name :: parser_expect_name(&state, "after `#` in a statement marker")
    word :: name.payload.decoded
    // D-PERSIST1: persistence is keyed by module + name, so a local binding
    // has no stable identity across a reload.
    if word == "Persist" {
        parser_add_error_code(&state, "E0145", parser_cover(hash.span, name.span), "only module-level state can persist across reloads", "persistence is keyed by module + name; a local has no stable identity across a reload", "move it to module level, or drop `#Persist`")
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
    }
    // D-UNINIT-SENTINEL1/2: the retired `#Uninit name: Type` marker teaches
    // `name := Type{ uninit }`.
    if word == "Uninit" && !negated {
        end := name.span.end
        fix := "write `name := Type{{ uninit }}`"
        if parser_current_kind(&state) == TOKEN_IDENT {
            hint :: parser_current(&state)
            end = hint.span.end
            fix = "write `{hint.payload.decoded} := <Type>.{{ uninit }}`"
        }
        parser_add_error_code(&state, "E0426", Span{start: hash.span.start, end: end}, "`#Uninit` is retired", "uninitialized storage is a fact about the value — it now reads `name := Type{{ uninit }}`", fix)
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
    }
    // D-SHIELDNAME1=A: `#Shield { … }` is a bare block.
    if word == "Shield" && parser_current_kind(&state) == TOKEN_LPAREN {
        lparen :: parser_current(&state)
        parser_add_error_code(&state, "E0430", parser_cover(name.span, lparen.span), "`#Shield` takes no arguments", "a shield region protects whatever runs inside it; there is nothing to configure", "write `#Shield {{ … }}`")
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
    }
    // D-CTX1: a context field is set with `name: value`.
    if word == "Context" && parser_current_kind(&state) == TOKEN_LPAREN && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_kind_at(&state, 2) == TOKEN_EQ {
        field :: parser_lookahead(&state, 1)
        eq :: parser_lookahead(&state, 2)
        parser_add_error_code(&state, "E0760", eq.span, "context fields are set with `:`, not `=`", "`=` is reassignment (S17); the `name: value` form sets a context field", "write `#Context({field.payload.decoded}: …) {{ … }}`")
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
    }
    args := [CallArg]{ }
    end := name.span
    if parser_current_kind(&state) == TOKEN_LPAREN {
        args = parser_parse_call_args(&state, 1, true)
        if state.position > 0 -> end = parser_lookahead(&state, -1).span
    }
    marker_args := [MarkerCallArg]{ }
    labels := [CallLabel?]{ }
    loop arg in args {
        &marker_args.push(MarkerCallArg.Expr{value: arg.expr})
        &labels.push(arg.label)
    }
    marker_span :: parser_cover(hash.span, end)
    marker :: Marker{name: name.payload.decoded, negated: negated, name_span: name.span, args: marker_args, arg_labels: labels, span: marker_span, ct: None}
    // D-UNSAFE-REASON1=A: every unsafe gate records its reason.
    if word == "Unsafe" && args.len() == 0 {
        parser_add_error_code(&state, "E3112", marker_span, "an `#Unsafe` block needs a reason", "every unsafe gate records why its unchecked operations preserve memory safety", "write `#Unsafe(\"why this is safe\") {{ … }}`")
        parser_sync_stmt(&state)
        return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
    }
    if word == "Context" {
        loop label in labels {
            if label == .Val(field) {
                if field.name != "allocator" && field.name != "logger" && field.name != "deadline" {
                    parser_add_error_code(&state, "E0761", field.span, "`{field.name}` isn't a context field", "the context bundle holds `allocator`, `logger`, and `deadline`", "write `#Context(allocator: …)`, `#Context(logger: …)`, or `#Context(deadline: …)`")
                    parser_sync_stmt(&state)
                    return Stmt.Expr{expr: Expr.Unit{span: hash.span}}
                }
            }
        }
    }
    // D-CANVASSTATE1=D: a switch-off attribute governs a block or the one
    // statement after it; two on one statement is E0344.
    if word == "Off" || word == "DebugOnly" {
        if parser_current_kind(&state) == TOKEN_HASH {
            second_hash :: parser_current(&state)
            second :: parser_lookahead(&state, 1)
            if second.kind == TOKEN_IDENT && (second.payload.decoded == "Off" || second.payload.decoded == "DebugOnly") {
                parser_add_error_code(&state, "E0344", Span{start: second_hash.span.start, end: second.span.end}, "only one switch-off attribute can be written on a statement", "`#{word}` and `#{second.payload.decoded}` both control whether the same statement emits code", "keep one marker: `#Off <statement>` or `#DebugOnly <statement>`")
            }
        }
        if parser_current_kind(&state) != TOKEN_LBRACE {
            statement :: parser_parse_statement(&state)
            return Stmt.Switched{marker: marker, body: [Stmt]{statement}, span: Span{start: hash.span.start, end: parser_previous_end(state)}}
        }
    }
    body :: parser_parse_block(&state)
    span :: parser_cover(hash.span, body.span)
    if marker.name == {
        "Unsafe" -> {
            reason := String?{None}
            audit_expr := Expr?{None}
            if args.len() > 0 {
                audit_expr = Val(args[0].expr)
                reason = parser_expr_literal_string(args[0].expr)
            }
            Stmt.Unsafe{audit: reason, audit_expr: audit_expr, body: body.statements, span: span}
        }
        "Impure" -> {
            reason := String?{None}
            reason_expr := Expr?{None}
            if args.len() > 0 {
                reason_expr = Val(args[0].expr)
                reason = parser_expr_literal_string(args[0].expr)
            }
            Stmt.Impure{reason: reason, reason_expr: reason_expr, body: body.statements, span: span}
        }
        "Reactive" -> Stmt.Reactive{body: body.statements, span: span}
        "Shield" -> Stmt.Shield{body: body.statements, span: span}
        "Off" | "DebugOnly" -> Stmt.Switched{marker: marker, body: body.statements, span: span}
        "FX" -> parser_authority_scope_stmt(&state, marker, args, body.statements, span) ?? Stmt.Expr{expr: Expr.Unit{span: hash.span}}
        "Policy" -> parser_policy_block_stmt(&state, marker, body.statements, span) ?? Stmt.Expr{expr: Expr.Unit{span: hash.span}}
        "Region" -> {
            region_name := ""
            region_span := name.span
            if args.len() > 0 {
                if args[0].expr == .Ident(value, value_span) {
                    region_name = value
                    region_span = value_span
                }
            }
            Stmt.Region{name: region_name, name_span: region_span, body: body.statements, span: span}
        }
        "Transact" -> {
            transaction_name := String?{None}
            transaction_span := Span?{None}
            if args.len() > 0 {
                if args[0].expr == .Ident(value, value_span) {
                    transaction_name = Val(value)
                    transaction_span = Val(value_span)
                }
            }
            Stmt.Transact{name: transaction_name, name_span: transaction_span, body: body.statements, implicit: false, span: span}
        }
        else -> Stmt.ScopeMember{name: marker.name, name_span: marker.name_span, args: [Expr]{}, args_span: None, body: body.statements, dsl: true, dot_span: hash.span, span: span}
    }
}

fn parser_expr_literal_string(expr: Expr) -> String? {
    if expr == {
        .Str(parts, _) -> if parts.len() == 1 -> if parts[0] == { .Lit(text) -> Val(text) else -> None } else -> None
        else -> None
    }
}
