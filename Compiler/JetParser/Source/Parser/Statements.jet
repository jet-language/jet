// Statement blocks, bindings, assignments, and control flow.

fn parser_statement_is_keyword(state: &JetParserState) -> Bool {
    token :: parser_current(&state)
    if token.kind == TOKEN_RETURN || token.kind == TOKEN_BREAK || token.kind == TOKEN_KW_YIELD -> return true
    if token.kind == TOKEN_KW_LOOP || token.kind == TOKEN_HASH || token.kind == TOKEN_AT -> return true
    if token.kind == TOKEN_IDENT {
        word := token.payload.decoded
        if word == "next" | "defer" -> return true
        next_kind := parser_kind_at(&state, 1)
        if next_kind == TOKEN_COLON_COLON {
            following_kind := parser_kind_at(&state, 2)
            if following_kind == TOKEN_KW_LOOP || following_kind == TOKEN_IDENT -> return true
        }
        if next_kind == TOKEN_COLON_EQ || next_kind == TOKEN_COLON_COLON -> return true
        if next_kind == TOKEN_COLON -> return true
    }
    false
}

fn parser_expression_definitely_diverges(expr: Expr) -> Bool {
    if expr == {
        .Paren(value, _) -> parser_expression_definitely_diverges(value)
        .Todo(_, _) -> true
        .Call(call) -> call.name == "panic"
        else -> false
    }
}

fn parser_expression_is_true(expr: Expr) -> Bool {
    if expr == {
        .Paren(value, _) -> parser_expression_is_true(value)
        .Bool(value, _) -> value
        else -> false
    }
}

fn parser_is_subjectless_guard(subject: Expr, span: Span) -> Bool {
    if subject == {
        .Bool(value, subject_span) -> value && subject_span == span
        else -> false
    }
}

fn parser_block_definitely_exits_value_block(statements: [Stmt]) -> Bool {
    index := 0
    loop index < statements.len() {
        if parser_statement_definitely_exits_value_block(statements[index]) -> return true
        index += 1
    }
    false
}

fn parser_switch_definitely_exits_value_block(subject: Expr, arms: [SwitchArm], else_body: ?[Stmt], span: Span) -> Bool {
    if arms.len() == 0 -> return false
    fallback_exits := if else_body == {
        .Val(body) -> parser_block_definitely_exits_value_block(body)
        .None -> !parser_is_subjectless_guard(subject, span)
    }
    all_arms_exit := true
    index := 0
    loop index < arms.len() && all_arms_exit {
        if !parser_block_definitely_exits_value_block(arms[index].body) -> all_arms_exit = false
        index += 1
    }
    return all_arms_exit && fallback_exits
}

fn parser_statement_definitely_exits_value_block(stmt: Stmt) -> Bool {
    return if stmt == {
        .Return(_, _) -> true
        .Break(_) -> true
        .BreakValue(_, _) -> true
        .Continue(_) -> true
        .BreakLabel(_, _) -> true
        .BreakLabelValue(_, _, _, _) -> true
        .ContinueLabel(_, _) -> true
        .Expr(expr) -> parser_expression_definitely_diverges(expr)
        .Switch(subject, arms, else_body, span) -> parser_switch_definitely_exits_value_block(subject, arms, else_body, span)
        .Loop(body, _, _, _) -> !parser_loop_body_can_break(body)
        .While(cond, body, _, _, _) -> parser_expression_is_true(cond) && !parser_loop_body_can_break(body)
        .CountedLoop(_, cond, _, body, _, _, _) -> parser_expression_is_true(cond) && !parser_loop_body_can_break(body)
        else -> false
    }
}

fn parser_loop_labels_with_current(nested_labels: [String], label: ?NamedSpan) -> [String] {
    labels := [String]{}
    index := 0
    loop index < nested_labels.len() {
        labels.push(nested_labels[index])
        index += 1
    }
    if label == { .Val(value) -> labels.push(value.name) }
    labels
}

fn parser_loop_body_can_break(statements: [Stmt]) -> Bool {
    parser_loop_body_can_break_inner(statements, [String]{}, true)
}

fn parser_loop_body_can_break_inner(statements: [Stmt], nested_labels: [String], allow_unlabelled: Bool) -> Bool {
    index := 0
    loop index < statements.len() {
        stmt :: statements[index]
        can_break := if stmt == {
            .Break(_) -> allow_unlabelled
            .BreakValue(_, _) -> allow_unlabelled
            .BreakLabel(name, _) -> {
                nested := false
                label_index := 0
                loop label_index < nested_labels.len() {
                    if nested_labels[label_index] == name { nested = true }
                    label_index += 1
                }
                !nested
            }
            .BreakLabelValue(name, _, _, _) -> {
                nested := false
                label_index := 0
                loop label_index < nested_labels.len() {
                    if nested_labels[label_index] == name { nested = true }
                    label_index += 1
                }
                !nested
            }
            .Switch(_, arms, else_body, _) -> {
                arm_index := 0
                found := false
                loop arm_index < arms.len() && !found {
                    found = parser_loop_body_can_break_inner(arms[arm_index].body, nested_labels, allow_unlabelled)
                    arm_index += 1
                }
                if !found && else_body != None {
                    body :: else_body ?? [Stmt]{}
                    found = parser_loop_body_can_break_inner(body, nested_labels, allow_unlabelled)
                }
                found
            }
            .Loop(body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .While(_, body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .For(_, _, _, _, body, _, _, label, _) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            .CountedLoop(_, _, _, body, _, _, label) -> parser_loop_body_can_break_inner(body, parser_loop_labels_with_current(nested_labels, label), false)
            else -> false
        }
        if can_break -> return true
        if parser_statement_definitely_exits_value_block(stmt) -> return false
        index += 1
    }
    false
}

fn parser_parse_block(state: &JetParserState) -> ParsedBlock {
    open :: parser_expect(&state, TOKEN_LBRACE, "`{{` to begin the block")
    statements := [Stmt]{}
    parser_skip_semicolons(&state)
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        before := state.position
        statements.push(parser_parse_statement(&state))
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error(&state, token.span, "the parser could not advance through this statement", "statement recovery stops infinite retries on malformed input", "remove or complete this statement")
            parser_bump(&state)
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` to close the block")
    inner := Span{start: open.span.end, end: close.span.start}
    state.block_spans.push(inner)
    ParsedBlock{span: parser_cover(open.span, close.span), statements: statements, tail: None}
}

fn parser_parse_value_block(state: &JetParserState, depth: Int) -> ParsedBlock {
    open :: parser_expect(&state, TOKEN_LBRACE, "`{{` to begin the value block")
    statements := [Stmt]{}
    tail := None
    parser_skip_semicolons(&state)
    loop parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        before := state.position
        if {
            parser_statement_is_keyword(&state) -> statements.push(parser_parse_statement(&state))
            else -> {
                value :: parser_parse_expression(&state, 1, depth + 1)
                if {
                    parser_current_kind(&state) == TOKEN_SEMI -> {
                        parser_bump(&state)
                        statements.push(Stmt.Expr(expr: value.expr))
                    }
                    parser_current_kind(&state) == TOKEN_RBRACE -> {
                        tail = Val(value.expr)
                        break
                    }
                    else -> {
                        parser_add_error(&state, parser_current(&state).span, "expected a statement terminator or the end of the block", "a block's final expression is its value only when it is last", "add a terminator or move this expression to the end")
                        statements.push(Stmt.Expr(expr: value.expr))
                        parser_recover_statement(&state)
                    }
                }
            }
        }
        parser_skip_semicolons(&state)
        if state.position == before {
            token :: parser_current(&state)
            parser_add_error(&state, token.span, "the parser could not advance through this block", "block recovery stops infinite retries on malformed input", "remove or complete this statement")
            parser_bump(&state)
        }
    }
    close :: parser_expect(&state, TOKEN_RBRACE, "`}}` to close the value block")
    inner := Span{start: open.span.end, end: close.span.start}
    state.block_spans.push(inner)
    ParsedBlock{span: parser_cover(open.span, close.span), statements: statements, tail: tail}
}

fn parser_parse_statement(state: &JetParserState) -> Stmt {
    parser_skip_semicolons(&state)
    token :: parser_current(&state)
    if token.kind == TOKEN_KW_IF -> return parser_parse_if_statement(&state)
    if token.kind == TOKEN_KW_LOOP -> return parser_parse_loop_statement(&state)
    if token.kind == TOKEN_RETURN -> return parser_parse_return_statement(&state)
    if token.kind == TOKEN_BREAK -> return parser_parse_break_statement(&state)
    if token.kind == TOKEN_KW_YIELD {
        start :: parser_bump(&state)
        value :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        return Stmt.Yield(value: value.expr, span: parser_cover(start.span, value.span))
    }
    if token.kind == TOKEN_HASH -> return parser_parse_marked_statement(&state)
    if token.kind == TOKEN_IDENT {
        word := token.payload.decoded
        if word == "next" {
            parser_bump(&state)
            parser_finish_statement(&state)
            return Stmt.Continue(span: token.span)
        }
        if word == "defer" -> return parser_parse_defer_statement(&state)
        if parser_kind_at(&state, 1) == TOKEN_COLON_COLON && parser_kind_at(&state, 2) == TOKEN_KW_LOOP -> return parser_parse_labeled_loop(&state)
        binding_kind := parser_kind_at(&state, 1)
        if binding_kind == TOKEN_COLON_EQ || binding_kind == TOKEN_COLON_COLON || binding_kind == TOKEN_COLON -> return parser_parse_binding_statement(&state)
    }
    if token.kind == TOKEN_AT -> return parser_parse_comptime_binding(&state)
    parser_parse_assignment_or_expression(&state)
}

fn parser_parse_if_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    arms := [SwitchArm]{}
    else_body := None
    end := start.span
    loop {
        condition :: parser_parse_expression(&state, 1, 0)
        body :: parser_parse_block(&state)
        arms.push(SwitchArm{cond: condition.expr, body: body.statements, span: parser_cover(condition.span, body.span)})
        end = body.span
        if parser_current_kind(&state) != TOKEN_KW_ELSE -> break
        parser_bump(&state)
        if parser_current_kind(&state) == TOKEN_KW_IF {
            parser_bump(&state)
            next_condition :: parser_parse_expression(&state, 1, 0)
            next_body :: parser_parse_block(&state)
            arms.push(SwitchArm{cond: next_condition.expr, body: next_body.statements, span: parser_cover(next_condition.span, next_body.span)})
            end = next_body.span
            next
        }
        final_body :: parser_parse_block(&state)
        else_body = Val(final_body.statements)
        end = final_body.span
        break
    }
    span := parser_cover(start.span, end)
    Stmt.Switch(subject: Expr.Bool(value: true, span: start.span), arms: arms, else_body: else_body, span: span)
}


fn parser_parse_loop_effect_body(state: &JetParserState) -> ParsedBlock {
    if parser_current_kind(&state) == TOKEN_LBRACE -> return parser_parse_block(&state)
    arrow :: parser_expect(&state, TOKEN_ARROW, "`->` before a single-statement loop body")
    statement :: parser_parse_statement(&state)
    end := parser_lookahead(&state, -1).span
    ParsedBlock{span: parser_cover(arrow.span, end), statements: [Stmt]{statement}, tail: None}
}

fn parser_parse_loop_after_keyword(state: &JetParserState, start: Span, label: ?NamedSpan) -> Stmt {
    if parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == "in" {
        name :: parser_bump(&state)
        parser_bump(&state)
        collection :: parser_parse_expression(&state, 1, 0)
        arrow_body := parser_current_kind(&state) == TOKEN_ARROW
        body :: parser_parse_loop_effect_body(&state)
        kind := ForKind.In(collection: collection.expr, step: None)
        if collection.expr == {
            .Range(range_start, range_end, exclusive, _) -> kind = ForKind.Range(start: range_start, end: range_end, step: None, exclusive: exclusive)
        }
        return Stmt.For(var: name.payload.decoded, var_span: name.span, var2: None, kind: kind, body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label, auto_vectorization: None)
    }
    body_kind := parser_current_kind(&state)
    if body_kind == TOKEN_LBRACE || body_kind == TOKEN_ARROW {
        arrow_body := body_kind == TOKEN_ARROW
        body :: parser_parse_loop_effect_body(&state)
        return Stmt.Loop(body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label)
    }
    condition :: parser_parse_expression(&state, 1, 0)
    arrow_body := parser_current_kind(&state) == TOKEN_ARROW
    body :: parser_parse_loop_effect_body(&state)
    Stmt.While(cond: condition.expr, body: body.statements, span: parser_cover(start, body.span), arrow_body: arrow_body, label: label)
}

fn parser_parse_loop_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    parser_parse_loop_after_keyword(&state, start.span, None)
}

fn parser_parse_labeled_loop(state: &JetParserState) -> Stmt {
    name :: parser_bump(&state)
    parser_bump(&state)
    parser_bump(&state)
    parser_parse_loop_after_keyword(&state, name.span, Val(NamedSpan{name: name.payload.decoded, span: name.span}))
}

fn parser_parse_return_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    value := None
    end := start.span
    if parser_current_kind(&state) != TOKEN_SEMI && parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        parsed :: parser_parse_expression(&state, 1, 0)
        value = Val(parsed.expr)
        end = parsed.span
    }
    parser_finish_statement(&state)
    Stmt.Return(value: value, span: parser_cover(start.span, end))
}

fn parser_parse_break_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_LPAREN {
        parser_bump(&state)
        name :: parser_expect_name(&state, "as a loop label")
        if parser_current_kind(&state) == TOKEN_COMMA {
            parser_bump(&state)
            value :: parser_parse_expression(&state, 1, 0)
            close :: parser_expect(&state, TOKEN_RPAREN, "`)` after labeled break")
            parser_finish_statement(&state)
            return Stmt.BreakLabelValue(name: name.payload.decoded, name_span: name.span, value: value.expr, span: parser_cover(start.span, close.span))
        }
        close :: parser_expect(&state, TOKEN_RPAREN, "`)` after loop label")
        parser_finish_statement(&state)
        return Stmt.BreakLabel(name: name.payload.decoded, span: parser_cover(start.span, close.span))
    }
    if parser_current_kind(&state) != TOKEN_SEMI && parser_current_kind(&state) != TOKEN_RBRACE && parser_current_kind(&state) != TOKEN_EOF {
        value :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        return Stmt.BreakValue(value: value.expr, span: parser_cover(start.span, value.span))
    }
    parser_finish_statement(&state)
    Stmt.Break(span: start.span)
}

fn parser_parse_comptime_binding(state: &JetParserState) -> Stmt {
    parser_bump(&state)
    name :: parser_expect_name(&state, "after `@` in a compile-time binding")
    sigil :: parser_expect(&state, TOKEN_COLON_COLON, "`::` after a compile-time binding name")
    value :: parser_parse_expression(&state, 1, 0)
    binding := ast_binding(name.payload.decoded, name.span, false, value.expr, Val(sigil.span))
    binding.is_comptime = true
    parser_finish_statement(&state)
    Stmt.Val(binding: binding)
}


fn parser_parse_binding_statement(state: &JetParserState) -> Stmt {
    name :: parser_expect_name(&state, "in a binding")
    sigil :: parser_current(&state)
    mutable := false
    if sigil.kind == {
        .TOKEN_COLON_EQ | .TOKEN_COLON_COLON -> {
            parser_bump(&state)
            mutable = sigil.kind == TOKEN_COLON_EQ
        }
        else -> parser_add_error(&state, sigil.span, "expected `:=` or `::` in a binding", "the binding sigil distinguishes a mutable value from an immutable one", "write `:=` for mutable or `::` for immutable")
    }
    value :: parser_parse_expression(&state, 1, 0)
    binding := ast_binding(name.payload.decoded, name.span, mutable, value.expr, Val(sigil.span))
    parser_finish_statement(&state)
    Stmt.Val(binding: binding)
}

fn parser_parse_defer_statement(state: &JetParserState) -> Stmt {
    start :: parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == "close" {
        parser_bump(&state)
        close :: parser_parse_expression(&state, 1, 0)
        parser_finish_statement(&state)
        return Stmt.DeferClose(close: close.expr, span: parser_cover(start.span, close.span))
    }
    parser_add_error(&state, start.span, "expected `close` after `defer`", "deferred resource cleanup uses the consuming close operation", "write `defer close(^resource)`")
    parser_finish_statement(&state)
    Stmt.Expr(expr: Expr.Unit(span: start.span))
}

fn parser_parse_assignment_or_expression(state: &JetParserState) -> Stmt {
    left :: parser_parse_expression(&state, 1, 0)
    operator := parser_current_kind(&state)
    if parser_is_assignment_operator(operator) {
        op_token :: parser_bump(&state)
        right :: parser_parse_expression(&state, 1, 0)
        target :: parser_expression_lvalue(&state, left.expr, left.span)
        parser_finish_statement(&state)
        return Stmt.Assign(target: target, op: parser_assignment_binop(operator), op_span: op_token.span, value: right.expr)
    }
    parser_finish_statement(&state)
    Stmt.Expr(expr: left.expr)
}

fn parser_is_assignment_operator(kind: Int) -> Bool {
    kind == TOKEN_EQ || kind == TOKEN_PLUS_EQ || kind == TOKEN_MINUS_EQ || kind == TOKEN_STAR_EQ || kind == TOKEN_SLASH_EQ || kind == TOKEN_SLASH_PERCENT_EQ || kind == TOKEN_PERCENT_EQ || kind == TOKEN_PERCENT_PERCENT_EQ || kind == TOKEN_AMP_EQ || kind == TOKEN_PIPE_EQ || kind == TOKEN_CARET_EQ || kind == TOKEN_TILDE_PIPE_EQ || kind == TOKEN_SHL_EQ || kind == TOKEN_SHR_EQ
}

fn parser_assignment_binop(kind: Int) -> ?BinOp {
    if kind == TOKEN_EQ -> return None
    if kind == TOKEN_PLUS_EQ -> return Val(BinOp.Add)
    if kind == TOKEN_MINUS_EQ -> return Val(BinOp.Sub)
    if kind == TOKEN_STAR_EQ -> return Val(BinOp.Mul)
    if kind == TOKEN_SLASH_EQ -> return Val(BinOp.Div)
    if kind == TOKEN_SLASH_PERCENT_EQ -> return Val(BinOp.FloorDiv)
    if kind == TOKEN_PERCENT_EQ -> return Val(BinOp.Mod)
    if kind == TOKEN_PERCENT_PERCENT_EQ -> return Val(BinOp.Rem)
    if kind == TOKEN_AMP_EQ -> return Val(BinOp.BitAnd)
    if kind == TOKEN_PIPE_EQ -> return Val(BinOp.BitOr)
    if kind == TOKEN_CARET_EQ -> return Val(BinOp.Pow)
    if kind == TOKEN_TILDE_PIPE_EQ -> return Val(BinOp.BitXor)
    if kind == TOKEN_SHL_EQ -> return Val(BinOp.Shl)
    if kind == TOKEN_SHR_EQ -> return Val(BinOp.Shr)
    None
}

fn parser_expression_lvalue(state: &JetParserState, expr: Expr, fallback_span: Span) -> LValue {
    if expr == {
        .Ident(name, span) -> LValue.Local(name: name, name_span: span)
        .Field(base, member, span) -> LValue.Field(base: base, field: member, span: span)
        .Index(base, index, span, kind) -> LValue.Index(base: base, index: index, span: span, kind: kind)
        else -> {
            parser_add_error(&state, fallback_span, "this expression is not an assignable place", "assignment targets must be local names, fields, or indexed elements", "assign to a mutable name, field, or index")
            LValue.Local(name: "__jet_error", name_span: fallback_span)
        }
    }
}

fn parser_finish_statement(state: &JetParserState) {
    if parser_current_kind(&state) == TOKEN_SEMI -> parser_skip_semicolons(&state)
}

fn parser_parse_marked_statement(state: &JetParserState) -> Stmt {
    hash :: parser_bump(&state)
    negated := false
    if parser_current_kind(&state) == TOKEN_BANG {
        parser_bump(&state)
        negated = true
    }
    name :: parser_expect_name(&state, "after `#` in a statement marker")
    args := [CallArg]{ }
    end := name.span
    if parser_current_kind(&state) == TOKEN_LPAREN {
        args = parser_parse_call_args(&state, 1, true)
        if state.position > 0 -> end = parser_lookahead(&state, -1).span
    }
    marker_args := [MarkerCallArg]{ }
    labels := [?CallLabel]{ }
    index := 0
    loop index < args.len() {
        marker_args.push(MarkerCallArg.Expr(value: args[index].expr))
        labels.push(args[index].label)
        index += 1
    }
    marker_span := parser_cover(hash.span, end)
    marker := Marker{name: name.payload.decoded, negated: negated, name_span: name.span, args: marker_args, arg_labels: labels, span: marker_span, ct: None}
    body :: parser_parse_block(&state)
    span := parser_cover(hash.span, body.span)
    if marker.name == "Unsafe" {
        reason := None
        audit_expr := None
        if args.len() > 0 {
            audit_expr = Val(args[0].expr)
            reason = parser_expr_literal_string(args[0].expr)
        }
        return Stmt.Unsafe(audit: reason, audit_expr: audit_expr, body: body.statements, span: span)
    }
    if marker.name == "Impure" {
        reason := None
        reason_expr := None
        if args.len() > 0 {
            reason_expr = Val(args[0].expr)
            reason = parser_expr_literal_string(args[0].expr)
        }
        return Stmt.Impure(reason: reason, reason_expr: reason_expr, body: body.statements, span: span)
    }
    if marker.name == "Reactive" -> return Stmt.Reactive(body: body.statements, span: span)
    if marker.name == "Shield" -> return Stmt.Shield(body: body.statements, span: span)
    if marker.name == "Off" | "DebugOnly" -> return Stmt.Switched(marker: marker, body: body.statements, span: span)
    if marker.name == "Region" {
        region_name := ""
        region_span := name.span
        if args.len() > 0 {
            if args[0].expr == { .Ident(value, value_span) -> { region_name = value; region_span = value_span } }
        }
        return Stmt.Region(name: region_name, name_span: region_span, body: body.statements, span: span)
    }
    if marker.name == "Transact" {
        transaction_name := None
        transaction_span := None
        if args.len() > 0 {
            if args[0].expr == { .Ident(value, value_span) -> { transaction_name = Val(value); transaction_span = Val(value_span) } }
        }
        return Stmt.Transact(name: transaction_name, name_span: transaction_span, body: body.statements, implicit: false, span: span)
    }
    Stmt.ScopeMember(name: marker.name, name_span: marker.name_span, args: [Expr]{}, args_span: None, body: body.statements, dsl: true, dot_span: hash.span, span: span)
}

fn parser_expr_literal_string(expr: Expr) -> ?String {
    if expr == {
        .Str(parts, _) -> if parts.len() == 1 -> if parts[0] == { .Lit(text) -> Val(text) else -> None } else -> None
        else -> None
    }
}
