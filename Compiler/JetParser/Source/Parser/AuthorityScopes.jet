// `#FX(Net, DB) { … }` restricts the effects a
// block may use; a named head `#FX(grant: FS, Net) { … }` also binds a scoped
// `Authority` handle (Rust `at_fx_stmt`). Effect names are dotted paths; sema
// validates them against the effect vocabulary.
use jet_foundation.[
    CallArg,
    Expr,
    Marker,
    NamedSpan,
    Span,
    Stmt,
    expr_span,
]

parser_authority_effect_path: fn(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, member, _, _) -> {
            prefix: parser_authority_effect_path(base) ?? return None
            Val("{prefix}.{member}")
        }
        else -> None
    }
}

// The whole written path `Log.Audit`; a field's own span is its member. A
// bound authority (`#FX(authority: Log.Audit)`) is reported over this path,
// a bare capability over its leaf.
parser_authority_path_span: fn(expr: Expr) -> Span {
    if expr == .Field(base, _, span, _) -> return Span{start: parser_authority_path_span(base).start, end: span.end}
    expr_span(expr)
}

parser_authority_scope_stmt: fn(state: &JetParserState, marker: Marker, args: [CallArg], body: [Stmt], span: Span) -> Stmt? {
    caps := [NamedSpan]{}
    loop argument in args {
        written: parser_authority_effect_path(argument.expr) ?? {
            parser_marker_shape_error(state, marker)
            return None
        }
        name := written
        if name.starts_with("Effect.") -> name = name.slice(7, name.len())
        cap_span: if argument.label == None -> expr_span(argument.expr) else -> parser_authority_path_span(argument.expr)
        caps.push(NamedSpan{name: name, span: cap_span})
    }
    binding := NamedSpan?{None}
    caps_span := Span{start: marker.name_span.end, end: marker.span.end}
    if args.len() > 0 && args[0].label == .Val(label) {
        binding = Val(NamedSpan{name: label.name, span: label.span})
        if caps.len() > 0 -> caps_span = Span{start: caps[0].span.start, end: marker.span.end}
    }
    Val(Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding, body: body, span: span})
}
