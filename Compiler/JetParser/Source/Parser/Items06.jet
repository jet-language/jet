            paths.push(NamedSpan{name: ^path, span: Span.new(first.span.start, end)})
            if parser_current_kind(&self) == TOKEN_COMMA { _ :: parser_bump(&self) } else { break }
        }
        _ :: parser_expect(&self, TOKEN_RBRACKET, "to close a tag policy list")
