    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:534
    fn marker_fix_source(marker: &Marker) -> String? Never! {
        // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:535
        fn expr_source(expr: &Expr) -> String? Never! {
            match expr {
                Expr.Str(parts, _) => { if parts.len() == 1 && parts[0] is StrPart.Lit(value) { return Val(value.debug()) }; None }
                Expr.Ident(name, _) => Val(name.clone())
                Expr.Int(value, _, _, source) => Val(source.clone().unwrap_or_else(fn() { value.to_string() }))
                Expr.Bool(value, _) => Val(value.to_string())
                Expr.UnitLit{raw: raw, suffix: suffix, ..} => Val("{raw}{suffix}")
                Expr.Field(base, field, _) => { prefix :: expr_source(base) ?? return None; Val("{prefix}.{field}") }
                Expr.EnumLit(type_name, variant, _, args, _, _) => { if !args.is_empty() { return None }; Val(if type_name.is_empty() { ".{variant}" } else { "{type_name}.{variant}" }) }
                _ => None
            }
        }
        sign :: if marker.negated { "!" } else { "" }
        if marker.args.is_empty() { return Val("{sign}{marker.name}") }
        args := [String]{}
        loop (argument, label) in marker.args.iter().zip(&marker.arg_labels) {
            expression :: argument.as_expr() ?? return None
            value :: expr_source(expression) ?? return None
            args.push(match label { Val(label) => "{label.name}: {value}", None => value })
        }
        Val("{sign}{marker.name}({args.join(", ")})")
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:590
    fn parse_marker_bracket_group(self: &JetParserState, site: Policy.RuleSite, noun: String) -> [Marker] Diagnostic! {
        group_span :: parser_bump(&self).span
        _ :: parser_bump(&self)
        group := [Marker]{}
        loop {
            m :: self.parse_one_marker_at_site(site)
            self.bind_rule_fact(m.name_span, None, site)
            group.push(^m)
            if parser_current_kind(&self) == TOKEN_COMMA { _ :: parser_bump(&self); if parser_current_kind(&self) == TOKEN_RBRACKET { break } } else { break }
        }
        close :: parser_current(&self).span
        _ :: parser_expect(&self, TOKEN_RBRACKET, "to close an `#[…]` rule list")
        loop marker in &group {
            if Policy.applied_rule(marker.name).is_some_and(fn(rule) { rule.status == Policy.RuleStatus.Active }) && !Policy.rule_allows_with_companions(marker.name, site, group.iter().map(fn(other) { other.name })) { return Err(JetParserState.wrong_rule_site(marker, site, noun)) }
        }
        if group.len() == 1 {
            diagnostic := Diagnostic.error("E0999", "one marker is written without brackets", "brackets group two or more markers; one marker stays bare", "replace `#[{group[0].name}]` with `#{group[0].name}`", Val(Span.new(group_span.start, close.end)))
            if JetParserState.marker_fix_source(&group[0]) is Val(marker) { diagnostic.set_structured_edit(TextEdit{span: Span.new(group_span.start, close.end), new_text: "#{marker}"}) }
            self.diagnostics.push(^diagnostic)
        }
        loop parser_current_kind(&self) == TOKEN_SEMI { _ :: parser_bump(&self) }
        ^group
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:647
    fn parse_attached_marker_sequence(self: &JetParserState, site: Policy.RuleSite, noun: String) -> [Marker] Diagnostic! {
        sequence_start :: parser_current(&self).span.start
        sequence_end := sequence_start
        markers := [Marker]{}
        chunks := 0
        bracket_chunks := 0
        loop {
            loop parser_current_kind(&self) == TOKEN_SEMI { _ :: parser_bump(&self) }
            if self.at_marker_list() {
                if !markers.is_empty() && !self.bracket_group_allows_site(self.position + 1, site) { break }
                close_index :: match JetParserState.skip_bracket_group(&self.tokens, self.position + 1) { Val(value) => value, None => { return Err(Diagnostic.error("E0003", "this marker list is not closed", "a marker group ends with `]`", "close the marker group with `]`", Val(parser_current(&self).span))) } }
                sequence_end = self.tokens[close_index - 1].span.end
                chunks += 1
                bracket_chunks += 1
                markers.extend(self.parse_marker_bracket_group(site, noun))
                continue
            }
            name :: match self.marker_name_at(self.position) { Val(value) => value, None => { break } }
            if !markers.is_empty() && Policy.applied_rule(name).is_some_and(fn(rule) { rule.status == Policy.RuleStatus.Active }) && !Policy.rule_allows(name, site) { break }
            chunks += 1
            marker :: self.parse_rule_marker_at_site(site)
            self.bind_rule_fact(marker.name_span, None, site)
            if Policy.applied_rule(name).is_some_and(fn(rule) { rule.status == Policy.RuleStatus.Active }) && !Policy.rule_allows(name, site) { return Err(JetParserState.wrong_rule_site(&marker, site, noun)) }
            sequence_end = marker.span.end
            markers.push(^marker)
        }
        distinct_markers :: markers.iter().map(fn(marker) { marker.name }).collect<Set<String>>().len()
        if distinct_markers > 1 && !(chunks == 1 && bracket_chunks == 1) {
            span :: Span.new(sequence_start, sequence_end)
            diagnostic := Diagnostic.error("E0999", "adjacent {noun} markers belong in one bracket list", "two or more rules attached to one {noun} use one ordered `#[A, B]` group", "replace the adjacent markers with one bracket list", Val(span))
            if markers.iter().map(JetParserState.marker_fix_source).collect<[String]?>() is Val(rendered) { diagnostic.set_structured_edit(TextEdit{span: span, new_text: "#[{rendered.join(", ")}]"}) }
            self.diagnostics.push(^diagnostic)
        }
        self.diagnose_repeated_markers(markers.view(), noun)
        ^markers
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:737
    fn diagnose_repeated_markers(self: &JetParserState, markers: View<Marker>, noun: String) Never! {
        loop (index, marker) in markers.iter().enumerate() {
            if Policy.applied_rule(marker.name).is_none_or(fn(rule) { rule.repeatable }) { continue }
            if !markers[..index].iter().any(fn(earlier) { earlier.name == marker.name }) { continue }
            self.diagnostics.push(Policy.marker_repeated_error(marker.name, noun, marker.span))
        }
    }
