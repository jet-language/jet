    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:850
    fn skip_bare_marker(self: &JetParserState, index: Int) -> Int? Never! {
        if !self.tokens.get(index).is_some_and(fn(token) { token.kind == TOKEN_HASH }) { return None }
        _ :: self.marker_name_at(index) ?? return None
        cursor := index + if self.tokens.get(index + 1).is_some_and(fn(token) { token.kind == TOKEN_BANG }) { 3 } else { 2 }
        if self.tokens.get(cursor).is_some_and(fn(token) { token.kind == TOKEN_LPAREN }) {
            depth := 0
            loop self.tokens.get(cursor) is Val(token) {
                match token.kind {
                    TOKEN_LPAREN => depth += 1,
                    TOKEN_RPAREN => { depth = depth.checked_sub(1) ?? return None; cursor += 1; if depth == 0 { break }; continue },
                    TOKEN_EOF => { return None }, _ => {}
                }
                cursor += 1
            }
            if depth != 0 { return None }
        }
