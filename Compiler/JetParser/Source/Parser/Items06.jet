        deny := None as [NamedSpan]?
        from := None as [NamedSpan]?
        loop parser_current_kind(&self) != TOKEN_RBRACE && parser_current_kind(&self) != TOKEN_EOF {
            if parser_current_kind(&self) == TOKEN_SEMI || parser_current_kind(&self) == TOKEN_COMMA { _ :: parser_bump(&self); continue }
            if parser_current_kind(&self) == TOKEN_KW_FN { method :: self.trait_method_sig(false); return Err(Generics.e0732(name, method.name, method.name_span)) }
            field_token :: parser_expect_name(&self, "for a tag policy field")
