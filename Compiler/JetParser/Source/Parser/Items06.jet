    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:462
    fn parse_registered_marker_at_site(self: &JetParserState, site: Policy.RuleSite) -> Marker Diagnostic! {
        marker :: self.parse_rule_marker_at_site(site)
        self.bind_rule_fact(marker.name_span, None, site)
        rule :: match Policy.applied_rule(marker.name) {
            Val(value) => value,
            None => {
                if self.source_declares_marker(marker.name) { return ^marker }
                return Err(Policy.marker_unknown_error(marker.name, Policy.active_rule_names(), marker.name_span))
            }
        }
        if rule.status is Policy.RuleStatus.Retired{..} { return Err(Policy.marker_unknown_error(marker.name, Policy.active_rule_names(), marker.name_span)) }
        if !Policy.rule_allows(marker.name, site) { return Err(Policy.marker_wrong_site_error(marker.name, site, marker.span)) }
        ^marker
    }
