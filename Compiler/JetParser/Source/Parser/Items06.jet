    fn type_def_with_any_markers(self: &JetParserState) -> Item Diagnostic! {
        markers :: self.parse_attached_marker_sequence(Policy.RuleSite.Type, "type")
        item :: self.parse_type_after_markers()
        self.attach_type_markers(^markers, ^item)
