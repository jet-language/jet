// Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:45
// marker_ident_path is owned by DeclarationMarkers.jet:143 (recursive Ident/Field projection).
// Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:55
fn strip_marker_enum_prefix(path: String, enum_name: String) -> String Never! {
    segments :: path.split('.').collect<[String]>()
    segments.iter().position(fn(segment) { segment == enum_name }).and_then(fn(index) { segments.get(index + 1..) }).filter(fn(parts) { !parts.is_empty() }).map(fn(parts) { parts.join(".") }).unwrap_or(path)
}
// Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:66
fn marker_enum_path(expression: &Expr, enum_name: String) -> String? Never! {
    parser_marker_ident_path(expression).map(fn(path) { strip_marker_enum_prefix(path, enum_name) })
}
