    fn trait_def(self: &JetParserState, nested: Bool) -> TraitDef Diagnostic! {
        item_start :: parser_current(&self).span.start
        (is_pub, is_package_pub) :: if nested { (false, false) } else { self.parse_item_visibility() }
        _ :: parser_expect(&self, TOKEN_KW_TRAIT, "to start a trait definition")
        name_token :: parser_expect_name(&self, "after `trait`")
        name :: name_token.payload.decoded
        name_span :: name_token.span
        supertraits :: if parser_current_kind(&self) == TOKEN_COLON { _ :: parser_bump(&self); self.parse_trait_bounds() } else { [String]{} }
        _ :: parser_expect(&self, TOKEN_LBRACE, "to open the trait body")
        methods := [TraitMethod]{} 
        assoc_types := [NamedSpan]{}
        loop parser_current_kind(&self) != TOKEN_RBRACE && parser_current_kind(&self) != TOKEN_EOF {
            if parser_current_kind(&self) == TOKEN_SEMI { _ :: parser_bump(&self); continue }
            if self.at_state_section() { return Err(self.reject_state_section("trait")) }
            if parser_current_kind(&self) == TOKEN_IDENT && parser_current(&self).payload.decoded == "type" {
                kw_span :: parser_bump(&self).span
                assoc_name :: parser_expect_name(&self, "after `type` in trait body")
                self.finish_stmt()
                assoc_types.push(NamedSpan{name: assoc_name.payload.decoded, span: Span.new(kw_span.start, assoc_name.span.end)})
                continue
            }
            markers :: if parser_current_kind(&self) == TOKEN_HASH { self.parse_method_marker_sequence() } else { [Marker]{} }
            loop parser_current_kind(&self) == TOKEN_SEMI { _ :: parser_bump(&self) }
            loop marker in &markers {
                if Policy.applied_rule(marker.name).map(fn(rule) { rule.status }) is Val(Policy.RuleStatus.Retired{replacement: replacement}) {
                    self.diagnostics.push(Diagnostic.error("E0927", "`#{marker.name}` is retired", "the applied-rule registry owns retired spellings and replacements", "write `{replacement}`", Val(marker.span)))
                    continue
                }
                if Policy.applied_rule(marker.name) == None { return Err(Policy.marker_unknown_error(marker.name, Policy.active_rule_names(), marker.name_span)) }
