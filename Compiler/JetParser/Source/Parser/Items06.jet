    fn parse_type_after_markers(self: &JetParserState) -> Item Diagnostic! {
        loop parser_current_kind(&self) == TOKEN_SEMI { _ :: parser_bump(&self) }
        is_pub :: parser_current_kind(&self) == TOKEN_KW_PUB
        if is_pub { _ :: parser_bump(&self) }
        token :: parser_current(&self)
        match token.kind {
            TOKEN_KW_STRUCT => Item.Struct{value: self.struct_def_after_pub(is_pub)},
            TOKEN_KW_ENUM => Item.Enum{value: self.enum_def_after_pub(is_pub, false)},
            TOKEN_IDENT if parser_kind_at(&self, 1) == TOKEN_COLON_COLON && parser_kind_at(&self, 2) == TOKEN_IDENT && parser_lookahead(&self, 2).payload.decoded == Syntax.KW_DISTINCT => Item.Distinct{value: self.distinct_def(is_pub, false)},
            TOKEN_HASH if parser_kind_at(&self, 1) == TOKEN_IDENT && parser_lookahead(&self, 1).payload.decoded == Syntax.MARKER_LAYOUT => self.layout_type_def(is_pub),
            TOKEN_HASH if parser_kind_at(&self, 1) == TOKEN_IDENT && parser_lookahead(&self, 1).payload.decoded == Syntax.MARKER_PUBLISHED_SCHEMA => Item.Struct{value: self.published_schema_struct_def(is_pub)},
            _ => Err(Diagnostic.error("E0003", "type markers must sit before a struct or enum, found {describe(token.kind)}", "derive markers like `#Codable` / `#[Codable]` and serde attributes attach to a type", "write `#Codable struct Name { … }` or `#[Codable, RenameAll(camel)] struct …`", Val(token.span)))
        }
    }
