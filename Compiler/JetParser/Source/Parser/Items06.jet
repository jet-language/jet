//RS                     derives.push((Syntax::MARKER_ENCODE.to_string(), m.name_span))
//RS                 }
//RS                 Syntax::MARKER_DECODE => {
//RS                     derives.push((Syntax::MARKER_DECODE.to_string(), m.name_span))
//RS                 }
//RS                 Syntax::MARKER_RENAME_ALL
//RS                 | Syntax::MARKER_DENY_UNKNOWN_FIELDS
//RS                 | Syntax::MARKER_TAG
//RS                 | Syntax::MARKER_UNTAGGED
