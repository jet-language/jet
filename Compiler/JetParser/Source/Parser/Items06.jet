            field_span :: field_token.span
            _ :: parser_expect(&self, TOKEN_COLON, "after a tag policy field")
            values :: self.tag_policy_path_list()
            match field {
                "deny" if deny == None => { deny = Val(^values) },
                "from" if from == None => { from = Val(^values) },
                "deny" | "from" => { return Err(Diagnostic.error("E0734", "tag `{name}` repeats `{field}`", "each tag policy field is declared once", "keep one `{field}: [...]` entry", Val(field_span))) },
                _ => { return Err(Diagnostic.error("E0734", "`{field}` is not a tag policy field", "tag bodies have required `deny` and optional `from` fields", "write `deny: [...]` or `from: [...]`", Val(field_span))) }
            }
        }
        end :: parser_current(&self).span.end
        _ :: parser_expect(&self, TOKEN_RBRACE, "to close the tag policy")
        deny :: deny.unwrap_or_default()
        if deny.is_empty() { return Err(Diagnostic.error("E0734", "tag `{name}` needs at least one denied destination", "a tag without a denied destination has no enforceable policy", "add a sink or effect to `deny: [...]`", Val(name_span))) }
        TagDef{is_pub: is_pub, is_package_pub: is_package_pub, name: ^name, name_span: name_span, deny: ^deny, from: from.unwrap_or_default(), span: Span.new(start.start, end)}
