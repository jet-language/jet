//RS                 | Syntax::MARKER_DEFAULT
//RS                 | Syntax::MARKER_FLATTEN => serde.push(m),
//RS                 // D-REPRC1: `Layout` is a type-layout fact, not a derive.
//RS                 // Keep it in `type_markers`; `attach_type_markers` projects
