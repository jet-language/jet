    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:2160
    fn tag_policy_path_list(self: &JetParserState) -> [NamedSpan] Diagnostic! {
        _ :: parser_expect(&self, TOKEN_LBRACKET, "to open a tag policy list")
        paths := [NamedSpan]{}
        loop parser_current_kind(&self) != TOKEN_RBRACKET && parser_current_kind(&self) != TOKEN_EOF {
            first :: parser_expect_name(&self, "in a tag policy list")
            path := first.payload.decoded
            end := first.span.end
            loop parser_current_kind(&self) == TOKEN_DOT {
                _ :: parser_bump(&self)
                segment :: parser_expect_name(&self, "after `.` in a tag policy path")
                path = "{path}.{segment.payload.decoded}"
                end = segment.span.end
