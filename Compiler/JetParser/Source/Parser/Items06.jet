    fn parse_field_markers(self: &JetParserState, site: Policy.RuleSite) -> [Marker] Diagnostic! { self.parse_attached_marker_sequence(site, if site == Policy.RuleSite.Variant { "variant" } else { "field" }) }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:774
    fn marker_name_at(self: &JetParserState, index: Int) -> String? Never! {
        if !self.tokens.get(index).is_some_and(fn(token) { token.kind == TOKEN_HASH }) { return None }
        name_index :: index + if self.tokens.get(index + 1).is_some_and(fn(token) { token.kind == TOKEN_BANG }) { 2 } else { 1 }
        self.tokens.get(name_index).filter(fn(token) { token.kind == TOKEN_IDENT }).map(fn(token) { token.payload.decoded })
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:796
    fn target_marker_selects_file_web_at(self: &JetParserState, name_index: Int) -> Bool Never! {
        if !self.tokens.get(name_index).is_some_and(fn(token) { token.kind == TOKEN_IDENT && token.payload.decoded == Syntax.MARKER_TARGET }) || !self.tokens.get(name_index + 1).is_some_and(fn(token) { token.kind == TOKEN_LPAREN }) { return false }
        segments := [String]{}
        cursor := name_index + 2
        loop {
            token :: self.tokens.get(cursor) ?? return false
            match token.kind { TOKEN_IDENT => segments.push(token.payload.decoded), TOKEN_DOT => {}, TOKEN_RPAREN => { break }, _ => { return false } }
            cursor += 1
        }
        segments == [String]{Syntax.WEB_TARGET_DEFAULT_WEB} || segments.ends_with([String]{"Target", Syntax.WEB_TARGET_DEFAULT_WEB}.view())
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:821
    fn target_marker_selects_web_partition_at(self: &JetParserState, name_index: Int) -> Bool Never! {
        if !self.tokens.get(name_index).is_some_and(fn(token) { token.kind == TOKEN_IDENT && token.payload.decoded == Syntax.MARKER_TARGET }) || !self.tokens.get(name_index + 1).is_some_and(fn(token) { token.kind == TOKEN_LPAREN }) { return false }
        segments := [String]{}
        cursor := name_index + 2
        loop {
            token :: self.tokens.get(cursor) ?? return false
            match token.kind { TOKEN_IDENT => segments.push(token.payload.decoded), TOKEN_DOT => {}, TOKEN_RPAREN => { break }, _ => { return false } }
            cursor += 1
        }
        segments == [String]{Syntax.WEB_BUCKET_JS} || segments == [String]{Syntax.WEB_BUCKET_WASM} || segments.ends_with([String]{"Target", Syntax.WEB_BUCKET_JS}.view()) || segments.ends_with([String]{"Target", Syntax.WEB_BUCKET_WASM}.view())
