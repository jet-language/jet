    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:256
    fn validate_registered_rule_marker(self: &JetParserState, marker: &Marker, parenthesized: Bool, site: Policy.RuleSite?) -> () Diagnostic! {
        rule :: match Policy.applied_rule(marker.name) { Val(value) => value, None => { return } }
        if rule.status is Policy.RuleStatus.Retired{..} { return }
        if marker.name == Syntax.MARKER_POLICY && CallablePolicyChain.parse(marker.expr_args_owned()).is_ok() {
            if !parenthesized { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
            _ :: self.callable_policy_chain_from_marker(marker)
            return
        }
        if marker.name == Syntax.MARKER_HTML {
            if site == Val(Policy.RuleSite.Block) && !parenthesized && marker.args.is_empty() { return }
            if (site == Val(Policy.RuleSite.Block) || site == Val(Policy.RuleSite.File)) && (!parenthesized || site == Val(Policy.RuleSite.Block)) { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
        }
        if parenthesized && !rule.signature.accepts_arguments() { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
        if !parenthesized && rule.signature.arguments_required() && marker.name != Syntax.KW_UNSAFE { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
        if marker.name == Syntax.KW_UNSAFE && marker.args.is_empty() { return }
        self.validate_registered_rule_arguments(marker)
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:324
    fn validate_registered_rule_arguments(self: &JetParserState, marker: &Marker) -> () Diagnostic! {
        rule :: match Policy.applied_rule(marker.name) { Val(value) => value, None => { return } }
        if rule.status is Policy.RuleStatus.Retired{..} || marker.name == Syntax.KW_UNSAFE && marker.args.is_empty() { return }
        if marker.name == Syntax.MARKER_POLICY && CallablePolicyChain.parse(marker.expr_args_owned()).is_ok() { _ :: self.callable_policy_chain_from_marker(marker); return }
        if marker.name == Syntax.CTX_BLOCK {
            if marker.arg_labels.iter().flatten().find(fn(label) { label.name != Syntax.CTX_FIELD_ALLOCATOR && label.name != Syntax.CTX_FIELD_LOGGER && label.name != Syntax.CTX_FIELD_DEADLINE }) is Val(label) {
                return Err(Diagnostic.error("E0761", "`{label.name}` isn't a context field", "the context bundle holds `allocator`, `logger`, and `deadline`", "write `#{Syntax.CTX_BLOCK}(allocator: …)`, `#{Syntax.CTX_BLOCK}(logger: …)`, or `#{Syntax.CTX_BLOCK}(deadline: …)`", Val(label.span)))
            }
        }
        if marker.name == Syntax.MARKER_ALLOW {
            loop argument in marker.expr_args() {
                if argument is Expr.Ident(name, _) { if LintPolicy.selection_code_error(name, "`#allow(...)`", Val(expr_span(argument))) is Val(diagnostic) { return Err(^diagnostic) } }
            }
        }
        if marker.name == Syntax.MARKER_MEMO && !(marker.args.is_empty() || marker.args.len() == 1 && marker.arg_labels.first().and_then(fn(label) { label }).is_some_and(fn(label) { label.name == "bound" }) && match parser_marker_expression(marker, 0) { Val(Expr.Ident(name, _)) => name == "none", _ => false }) { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
        if rule.signature.marker_argument_bindings(marker) == None { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) }
    }
    // Rust: crates/jet-parser/src/Parser/Items/marker_groups.rs:407
    fn bound_registered_rule_arguments(self: &JetParserState, marker: &Marker) -> BoundRuleArguments Diagnostic! {
        rule :: match Policy.applied_rule(marker.name) { Val(value) => value, None => { return BoundRuleArguments{marker: marker, bindings: []} } }
        if rule.status is Policy.RuleStatus.Retired{..} { return BoundRuleArguments{marker: marker, bindings: []} }
        bindings :: match rule.signature.marker_argument_bindings(marker) { Val(value) => ^value, None => { return Err(Policy.marker_argument_shape_error(marker.name, marker.span)) } }
        BoundRuleArguments{marker: marker, bindings: ^bindings}
    }
