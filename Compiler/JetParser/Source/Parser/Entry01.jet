// Canonical Items.jet:1648 exact Ident + Eq predicate.
fn cli_binding_starts_here(state: &JetParserState) -> Bool Never! { parser_current_kind(&state) == TOKEN_IDENT && parser_kind_at(&state, 1) == TOKEN_EQ }
// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:214
// Canonical Items.jet:1648-1653 owns CLICommandBinding construction. The
// registered field-site binding below is the missing rule-fact projection.
fn cli_binding(state: &JetParserState, markers: [Marker]) -> CLICommandBinding {
    name :: parser_expect_name(&state, "for a CLI command name")
    parser_expect(&state, TOKEN_EQ, "between a CLI command name and callable")
    target :: parser_parse_expression(&state, 1, 0)
    loop marker in markers { bind_rule_fact(&state, marker.name_span, Val(name.span), RuleSite.Field) }
    CLICommandBinding{name: name.payload.decoded, name_span: name.span, markers: ^markers, target: target.expr}
}
// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:240
fn at_persist_binding(state: &JetParserState) -> Bool Never! {
    parser_current_kind(&state) == TOKEN_HASH && parser_kind_at(&state, 1) == TOKEN_IDENT && parser_lookahead(&state, 1).payload.decoded == Syntax.MARKER_PERSIST
}
