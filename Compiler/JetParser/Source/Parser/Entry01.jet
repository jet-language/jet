// Canonical Items.jet:1944 parser_parse_const: Static/Inline marker projection,
// RustConstKind.Static selection and ordinary prepared binding-value path.
// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:433
fn output_def(state: &JetParserState) -> ConstDef? {
    start :: parser_current(&state).span.start
    name :: parser_expect_name(&state, "for the Output name")
    parser_expect(&state, TOKEN_COLON_COLON, "after the Output name")
    type_name :: parser_expect_name(&state, "for the Output constructor")
    if type_name.payload.decoded != Syntax.TYPE_OUTPUT {
        parser_add_fatal_code(&state, "E0003", type_name.span, "expected `Output` in an Output constructor", "the Output kind carries its closed sum type", "write `Output`.<Kind>{{ ... }}")
        return None
    }
    parser_expect(&state, TOKEN_DOT, "between `Output` and its kind")
    variant :: parser_expect_name(&state, "for the Output kind")
    fields :: parser_parse_expression_fields(&state, 1)
    args :: fields.fields.iter().map(fn(field) { EnumLitArg.Named{label: field.name, expr: field.value} }).collect_vec()
    if parser_aborting(&state) -> return None
    end :: parser_lookahead(&state, -1).span.end
    value :: Expr.EnumLit{type_name: type_name.payload.decoded, variant: variant.payload.decoded, variant_span: Val(variant.span), args: args, leading_dot: false, span: Span{start: type_name.span.start, end: end}}
    definition := ast_const(name.payload.decoded, name.span, Span{start: start, end: end}, value)
    definition.is_pub = false
    definition.is_package_pub = false
    definition.meta = None
    definition.attrs = []
    definition.rust_kind = RustConstKind.Const
    definition.is_comptime = false
    definition.ct = None
    definition.ty = Val(Type.Named{name: Syntax.TYPE_OUTPUT})
    definition.is_persist = false
    definition.persist_span = None
    definition.mutable = false
    definition.resolved_output = None
    Val(^definition)
}
