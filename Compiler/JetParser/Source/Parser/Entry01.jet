// Canonical Items.jet:1616 parser_parse_struct; field-specific missing admission
// (computed arrow, retired =, invalid @name) is supplied by field below.
fn field(state: &JetParserState) -> Field? {
    modifiers :: parser_parse_item_modifiers(&state, false)
    name :: parser_expect_name(&state, "for a field name")
    if Syntax.is_comptime_name(name.payload.decoded) {
        parser_add_fatal_code(&state, "E0003", name.span, "`{name.payload.decoded}` is not a field name", "the compile-time mark `@` belongs to the compiler's own members and to compile-time bindings, never to a declared field", "drop the `@`, or read the compiler fact as `T.{name.payload.decoded}`")
        return None
    }
    parser_expect(&state, TOKEN_COLON, "after a field name")
    ty :: parser_parse_type(&state, 0)
    if parser_aborting(&state) -> return None
    computed := Expr?{None}
    default := Expr?{None}
    if parser_current_kind(&state) == TOKEN_UNIFIED_ARROW {
        parser_expect_unified_arrow(&state, "before a computed field expression")
        value :: parser_parse_expression(&state, 1, 0)
        computed = Val(value.expr)
    } else if parser_current_kind(&state) == TOKEN_LBRACE {
        parser_bump(&state)
        value :: parser_parse_expression(&state, 1, 0)
        default = Val(value.expr)
        parser_expect(&state, TOKEN_RBRACE, "after a field default")
    } else if parser_current_kind(&state) == TOKEN_EQ {
        eq :: parser_bump(&state).span
        &state.diagnostics.push(Diagnostic.from_row("E0385", [], Val(eq)))
        value :: parser_parse_expression(&state, 1, 0)
        default = Val(value.expr)
    }
    if parser_aborting(&state) -> return None
    Val(Field{is_pub: modifiers.is_pub, is_package_pub: modifiers.is_package_pub, name: name.payload.decoded, name_span: name.span, ty: ty.ty, ty_span: ty.span, serde_markers: [], redact: false, computed: computed, default: default, default_ct: None})
}
