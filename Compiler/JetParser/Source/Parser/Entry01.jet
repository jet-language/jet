// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:247
fn at_retired_at_c_module(state: &JetParserState) -> Bool Never! {
    if parser_current_kind(&state) != TOKEN_HASH -> return false
    marker :: parser_lookahead(&state, 1)
    (marker.kind == TOKEN_KW_EXTERN || (marker.kind == TOKEN_IDENT && marker.payload.decoded == Syntax.MARKER_BINDGEN_RETIRED)) && parser_kind_at(&state, 2) == TOKEN_KW_MODULE
}
// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:262
// Canonical Declarations/Foreign.jet:71 parser_parse_c_module. Import is a
// guest boundary fact, Bindgen a registered module marker; preserve RuleSite.
// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:340
fn retired_at_c_module(state: &JetParserState) -> Item {
    start :: parser_bump(&state).span
    marker :: parser_bump(&state)
    kind :: if marker.kind == {
        TOKEN_KW_EXTERN -> {
            &state.diagnostics.push(retired_c_module_marker_diag("#extern", "#Import", parser_cover(start, marker.span)))
            CModuleKind.Extern
        }
        TOKEN_IDENT -> {
            assert marker.payload.decoded == Syntax.MARKER_BINDGEN_RETIRED
            &state.diagnostics.push(retired_c_module_marker_diag("#{Syntax.MARKER_BINDGEN_RETIRED}", "#Bindgen", parser_cover(start, marker.span)))
            CModuleKind.Bindgen
        }
        else -> panic("at_retired_at_c_module guards marker spelling")
    }
    // Canonical Foreign parser owns the path/body; shared entry begins after
    // the already consumed intro instead of parsing a second C module grammar.
    c_module_after_kind(&state, start, kind)
}
// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:363
fn retired_c_module_marker_diag(old: String, new: String, span: Span) -> Diagnostic Never! {
    diagnostic_from_registry("E0060", Val(span), "C FFI modules use `{new}`, not `{old}`", "C FFI rules use the one PascalCase `#Rule` family in generated and hand-written bindings", "write `{new}` before `module c.<lib>`")
}
// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:374
// Canonical Declarations/Foreign.jet:74-120 shared c_module_after_kind body;
// callback metadata :123 retains precedence native-start/managed/managed-close/
// emit-task, SHA256 framing with one NUL byte, stable lib.function identity.
// Rust: crates/jet-parser/src/Parser/Items/reactive_unsafe_c.rs:526
// Canonical Declarations/Foreign.jet:39 parser_foreign_plain_string; the
// exact context/why/fix overload below preserves this source's diagnostics.
fn expect_plain_string(state: &JetParserState, context: String, why_interp: String, fix: String) -> NamedSpan? {
    token :: parser_current(&state)
    if token.kind != TOKEN_STRING && token.kind != TOKEN_RAW_STRING {
        parser_add_fatal_code(&state, "E0003", token.span, "expected a piece of quoted text {context}, found {token.payload.text}", why_interp, fix)
        return None
    }
    parser_bump(&state)
    if token.kind == TOKEN_RAW_STRING -> return Val(NamedSpan{name: token.payload.decoded, span: token.span})
    if token.payload.string_parts.len() != 1 || token.payload.string_parts[0].kind != STRING_PART_TEXT {
        parser_add_fatal_code(&state, "E0003", token.span, "expected a piece of quoted text {context}, found interpolation", why_interp, fix)
        return None
    }
    Val(NamedSpan{name: token.payload.string_parts[0].text, span: token.span})
}

