// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:255
// Canonical Entry.jet:634 parser_constant_name, with retired @name admitted
// by marked_const_ahead and respelled by the shared constant parser.
// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:261
// Canonical Items.jet:1944 parser_parse_const / :1938 parser_report_retired_const.
// Rust: crates/jet-parser/src/Parser/Items/type_methods_fields.rs:268
fn persist_def(state: &JetParserState) -> ConstDef? {
    item_start :: parser_current(&state).span.start
    meta := MetaAttr?{None}
    if at_meta_attr(&state) {
        meta = Val(parse_meta_attr_at_site(&state, RuleSite.Declaration))
        parser_skip_semicolons(&state)
    }
    marker :: parse_registered_marker_at_site(&state, RuleSite.Declaration)
    persist_span :: marker.span
    if parser_aborting(&state) -> return None
    if parser_current_kind(&state) == TOKEN_KW_CONST || parser_current_kind(&state) == TOKEN_KW_COMPTIME {
        bad :: parser_bump(&state)
        word :: if bad.kind == TOKEN_KW_CONST { "const" } else { "comptime" }
        parser_add_fatal_code(&state, "E0003", parser_cover(persist_span, bad.span), "`#Persist` marks a bare binding, not `{word}`", "`#Persist` attaches to `name :: …` or `name := …` (D-PERSIST1 / D-BIND-BARE1)", "write `#Persist name := …` (or `::` for an immutable bare bind)")
        return None
    }
    name :: parser_expect_name(&state, "after `#Persist`")
    mutable :: if parser_current_kind(&state) == {
        TOKEN_COLON_COLON -> { parser_bump(&state); false }
        TOKEN_COLON_EQ -> { parser_bump(&state); true }
        else -> {
            parser_add_fatal_code(&state, "E0003", parser_current(&state).span, "expected `::` or `:=` after the `#Persist` name", "`#Persist` marks a bare binding (D-PERSIST1 / D-BIND-BARE1)", "write `#Persist {name.payload.decoded} := …` (or `{name.payload.decoded} :: …`)")
            return None
        }
    }
    value :: parser_parse_expression(&state, 1, 0)
    close :: parser_expect(&state, TOKEN_SEMI, "after a `#Persist` value")
    if parser_aborting(&state) -> return None
    definition := ast_const(name.payload.decoded, name.span, Span{start: item_start, end: close.span.end}, value.expr)
    definition.is_pub = false
    definition.is_package_pub = false
    definition.meta = meta
    definition.attrs = []
    definition.rust_kind = RustConstKind.Const
    definition.is_comptime = false
    definition.ct = None
    definition.ty = None
    definition.is_persist = true
    definition.persist_span = Val(persist_span)
    definition.mutable = mutable
    definition.resolved_output = None
    Val(^definition)
}
