fn output_defaults_def(state: &JetParserState) -> ConstDef? {
    start :: parser_current(&state).span.start
    name :: parser_expect_name(&state, "for Output defaults")
    parser_expect(&state, TOKEN_COLON, "after `defaults`")
    value :: parser_parse_expression(&state, 1, 0)
    if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
    if parser_aborting(&state) -> return None
    definition := ast_const(name.payload.decoded, name.span, Span{start: start, end: parser_lookahead(&state, -1).span.end}, value.expr)
    definition.is_pub = false
    definition.is_package_pub = false
    definition.meta = None
    definition.attrs = []
    definition.rust_kind = RustConstKind.Const
    definition.is_comptime = false
    definition.ct = None
    definition.ty = Val(Type.Named{name: Syntax.TYPE_OUTPUT_DEFAULTS})
    definition.is_persist = false
    definition.persist_span = None
    definition.mutable = false
    definition.resolved_output = None
    Val(^definition)
}
