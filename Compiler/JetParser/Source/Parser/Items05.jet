// program maps to Entry.jet:264 parser_parse_program with the existing one
// dispatcher/parser_parse_item_or_import and file-rule path. Arm mapping:
// 718-744 user-policy -> user_policy_decl above (public flag consumed by entry).
// 746-788 EOF/Semi/use/effect/file Policy -> Entry:266/267, Items:482/2370,
// Policies:49; callable-shape and marker-function lookahead must precede file Policy.
// 789-812 unsafe/extern -> Entry:352 parser_report_foreign_top_word + Items extern.
// 813-1023 PubFile/NoPrelude/PublicFile/grouped file markers -> Entry:444
// parser_parse_file_directive and :468 parser_apply_file_marker.
// 1028-1142 Target/HTML -> Entry:517 parser_apply_file_target / :489 HTML arm,
// Items parser item modifier target for attached OS impl and bucket module.
// 1143-1507 every code-bearing item/visibility/marker/binding arm -> existing
// Items:199 parser_parse_item_or_import and parse-item dispatcher. Disabled
// foreign test/class/interface/import teaching remains disabled, never revived.
// 1462-1469 environment reads -> canonical parser expression environment guards.
// 1473-1500 prep loop/retired @/unknown marker -> item template parser / Entry:273.
// 1509-1621 module binding / foreign namespace / script -> Entry:306/352/324.
// 1623-1629 normalize_external_method_item -> canonical item normalization owner.
// 1630-1671 final policy resolution is the genuine missing suffix below.
// 1672-1687 Program construction -> ast_program carrier plus move collected
// state metadata (block spans, policy/user policy/applied rules/rule facts).
fn resolve_program_policies(state: &JetParserState, program: Program) -> Unit Never! {
    loop rule in POLICY_RULES {
        key :: rule.key
        module_chain :: program.policy_declarations.filter(fn(declaration) { declaration.scope == PolicyScope.Module }).map(fn(declaration) { ~declaration })
        if policy_resolve(key, module_chain) == .Err(error) {
            span :: if error == { .ProhibitedScope{span: span, ..} | .Widening{span: span, ..} -> span .Conflict{second: span, ..} -> span }
            parser_add_error_code(&state, "E0355", span, "invalid module `{key.name()}` policy", "the nearest scope may declare a key once, and inner scopes may only tighten it according to the compiler registry", "remove the conflict or tighten the inherited value")
        }
        targets :: program.policy_declarations.filter(fn(declaration) { declaration.scope == PolicyScope.Function && declaration.key == key }).filter_map(fn(declaration) { declaration.target })
        loop target in targets {
            chain :: program.policy_declarations.filter(fn(declaration) { declaration.scope == PolicyScope.Module || (declaration.scope == PolicyScope.Function && declaration.target == Val(target)) }).map(fn(declaration) { ~declaration })
            if policy_resolve(key, chain) == .Err(error) {
                span :: if error == { .ProhibitedScope{span: span, ..} | .Widening{span: span, ..} -> span .Conflict{second: span, ..} -> span }
                parser_add_error_code(&state, "E0355", span, "invalid function `{key.name()}` policy", "the nearest scope may declare a key once, and inner scopes may only tighten it according to the compiler registry", "remove the conflict or tighten the inherited value")
            }
        }
    }
}
