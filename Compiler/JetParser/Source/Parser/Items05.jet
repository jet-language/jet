fn callable_policy_marker_shape(state: &JetParserState) -> Bool Never! {
    parser_kind_at(&state, 3) == TOKEN_IDENT && parser_kind_at(&state, 4) == TOKEN_LPAREN
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:148
fn policy_decl(state: &JetParserState, scope: PolicyScope) -> [PolicyDeclaration] Diagnostic! {
    site :: if scope == { .Package | .Organization -> RuleSite.Package .Module -> RuleSite.Module .Function -> RuleSite.Function .Block -> RuleSite.Block }
    marker :: state.parse_registered_marker_at_site(site)?
    policy_declarations_from_marker(&state, ^marker, scope)
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:162
fn retired_memory_policy_diagnostic(name: String, name_span: Span, limit: Int?) -> Diagnostic? Never! {
    if name != "no_alloc" && name != "zero_rc" && name != "arena_bounded" -> return None
    replacement :: if name == {
        "no_alloc" -> "`-[!Mem.Alloc]>`"
        "zero_rc" -> "`-[!Mem.Rc]>`"
        else -> if limit == { .Val(bytes) -> "`-[!Mem.Alloc(above: {bytes})]>`" .None -> "`-[!Mem.Alloc(above: N)]>`" }
    }
    Val(diagnostic_from_registry("E0355", Val(name_span), "`{name}` is a retired memory policy", "memory floors are rights-tree prohibitions, not policy-marker arguments", "write {replacement} on the function signature"))
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:187
fn retired_memory_policy_marker_diagnostic(marker: Marker) -> Diagnostic? Never! {
    loop expr in marker.expr_args_owned() {
        (name, span, limit) :: if expr == {
            .Ident(name, span) -> (name, span, None)
            .Call(call) -> {
                limit :: if call.args.len() == 0 { Int?{None} } else if call.args.len() == 1 && call.args[0].label == None && !call.args[0].spread {
                    if call.args[0].expr == { .Int(value, _, _, _) -> Val(value) else -> continue }
                } else -> continue
                (call.name, call.name_span, limit)
            }
            else -> continue
        }
        if retired_memory_policy_diagnostic(name, span, limit) == .Val(diagnostic) -> return Val(^diagnostic)
    }
    None
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:216
fn policy_declarations_from_marker(state: &JetParserState, marker: ^Marker, scope: PolicyScope) -> [PolicyDeclaration] Diagnostic! {
    marker_span :: marker.span
    _ :: state.bound_registered_rule_arguments(marker)?
    labels :: marker.arg_labels
    out := [PolicyDeclaration]{}
    args :: marker.expr_args_owned()
    loop index in 0..<args.len() {
        expr :: args[index]
        label :: labels.get(index).and_then(fn(value) { value.map(fn(named) { named.0 }) })
        name := ""
        name_span := marker_span
        limit := Int?{None}
        explicit_value := PolicyValue?{None}
        sentry_value := PolicyValue?{None}
        if label == Val("copies") || label == Val("sentries") {
            value :: if expr == {
                .EnumLit(type_name, variant, _, enum_args, _, span) -> {
                    if !type_name.is_empty() || !enum_args.is_empty() -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, span))
                    if variant == {
                        "Explicit" -> { if label != Val("copies") -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, span)); PolicyValue.Explicit }
                        "On" -> { if label != Val("sentries") -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, span)); PolicyValue.On }
                        "Off" -> { if label != Val("sentries") -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, span)); PolicyValue.Off }
                        else -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, span))
                    }
                }
                else -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, expr_span(expr)))
            }
            name = label.expect("named policy")
            if label == Val("copies") -> explicit_value = Val(value) else -> sentry_value = Val(value)
        } else {
            if expr == {
                .Ident(written, span) -> { name = ~written; name_span = span }
                .Call(call) -> {
                    if call.args.len() != 1 -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, expr_span(expr)))
                    argument :: call.args[0]
                    value :: if argument.expr == { .Int(value, _, _, _) -> value else -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, marker_span)) }
                    if argument.label != None -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, marker_span))
                    name = ~call.name; name_span = call.name_span; limit = Val(value)
                }
                else -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, expr_span(expr)))
            }
        }
        if retired_memory_policy_diagnostic(name, name_span, limit) == .Val(diagnostic) -> return Err(^diagnostic)
        key :: parser_policy_key(name) ?? {
            site_bound :: applied_rule(name).is_some_and(fn(row) { !row.inherits })
            package_only :: name == Syntax.POLICY_FIELD_CONTAIN || name == Syntax.POLICY_FIELD_HARDEN
            why :: if package_only { "contain and harden govern package dependencies and release profiles, not source scopes" } else if site_bound { "authority markers stay attached to the audited operation or declaration; policy scope cannot widen them" } else { "the compiler owns the closed policy registry and its scope rules" }
            fix :: if package_only { "write `policy: {{ contain: [\"dependency\"], harden: true }}` in `package.jet`" } else if site_bound { "use `#{name}` at its sound site" } else { "use `gc`, `explicit_units`, `copies: .Explicit`, or `sentries: .Off`; write memory floors as `!Mem.*` effect denials" }
            return Err(diagnostic_from_registry("E0355", Val(name_span), "`{name}` is not a scoped policy", why, fix))
        }
        value :: if key == {
            .Copies -> explicit_value ?? return Err(diagnostic_from_registry("E0355", Val(name_span), "`copies` needs an explicit mode", "read-only views copy at owning destinations by default; the policy only restores explicit-copy syntax", "write `copies: .Explicit`"))
            .Sentries -> sentry_value ?? return Err(diagnostic_from_registry("E0355", Val(name_span), "`sentries` needs an explicit mode", "sentry instrumentation is either on or off; it is not a boolean memory fact", "write `sentries: .Off` or `sentries: .On`"))
            .ScopedGC | .ExplicitUnits -> {
                if explicit_value != None || sentry_value != None -> return Err(marker_argument_shape_error(Syntax.MARKER_POLICY, marker_span))
                PolicyValue.Enabled
            }
            .Unsafe | .Impure | .Nondeterministic -> return Err(diagnostic_from_registry("E0355", Val(name_span), "`{name}` is not a source policy", "organization and package policy own the audited-escape floor; source code can only write the corresponding marker", "use the audited marker, or `policy: {{ {name}: .Forbid }}` in `package.jet`"))
        }
        &out.push(PolicyDeclaration{key: key, value: value, scope: scope, span: marker_span, target: None, source: "<source>"})
    }
    Ok(^out)
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:349
fn import_decl(state: &JetParserState) -> ImportDecl Diagnostic! {
    start :: parser_bump(&state).span
    token :: parser_current(&state)
    if token.kind == TOKEN_STRING || token.kind == TOKEN_RAW_STRING {
        path :: string_literal_token_value(token)?
        path_span :: parser_bump(&state).span
        alias := path.rsplit('/').next() ?? "module"
        alias_span := start
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == Syntax.KW_AS {
            parser_bump(&state)
            local :: parser_expect_name(&state, "after `as`")
            alias = ~local.payload.decoded; alias_span = local.span
        }
        parser_expect(&state, TOKEN_SEMI, "after an import")
        if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
        end :: parser_lookahead(&state, -1).span.end
        return Ok(ImportDecl{kind: ImportKind.File{path: ^path, span: path_span}, alias: ~alias, alias_span: alias_span, span: Span{start: start.start, end: end}, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: None})
    }
    if token.kind != TOKEN_IDENT -> return Err(diagnostic_from_registry("E0003", Val(token.span), "expected a file path in quotes or a module name after `{Syntax.KW_USE}`, found {parser_describe_token(token)}", "write `{Syntax.KW_USE} \"path/to/file\";` or `{Syntax.KW_USE} module_name;`", "e.g. `{Syntax.KW_USE} \"util/helpers\";` or `{Syntax.KW_USE} scoring;`"))
    first :: parser_expect_name(&state, "after `use`")
    if parser_current_kind(&state) == TOKEN_DOT {
        if parser_kind_at(&state, 1) == TOKEN_IDENT && first.payload.decoded != Syntax.PROJECT_IMPORT_ROOT && (parser_kind_at(&state, 2) == TOKEN_SEMI || parser_kind_at(&state, 2) == TOKEN_EOF) {
            parser_bump(&state)
            item :: parser_expect_name(&state, "after `.` in a `use` import")
            parser_expect(&state, TOKEN_SEMI, "after an import")
            if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
            span :: Span{start: start.start, end: parser_lookahead(&state, -1).span.end}
            return Ok(ImportDecl{kind: ImportKind.Unqualified{module_alias: ~first.payload.decoded, module_alias_span: first.span, items: [ImportedItem{original: ~item.payload.decoded, alias: None}], items_span: item.span, span: span}, alias: ~item.payload.decoded, alias_span: item.span, span: span, item_spans: [item.span], local_spans: [item.span], is_pub: false, is_package_pub: false, inline_version: None})
        }
        return import_decl_module_path(&state, start, ~first.payload.decoded, first.span)
    }
    version := InlineVersion?{None}
    if parser_current_kind(&state) == TOKEN_HASH -> version = Val(inline_version(&state)?)
    alias := ~first.payload.decoded
    alias_span := first.span
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == Syntax.KW_AS {
        parser_bump(&state)
        local :: parser_expect_name(&state, "after `as`")
        alias = ~local.payload.decoded; alias_span = local.span
    }
    parser_expect(&state, TOKEN_SEMI, "after an import")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    Ok(ImportDecl{kind: ImportKind.Module{name: ~first.payload.decoded, span: first.span}, alias: ^alias, alias_span: alias_span, span: Span{start: start.start, end: parser_lookahead(&state, -1).span.end}, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: ^version})
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:485
fn import_decl_module_path(state: &JetParserState, start: Span, first: ^String, first_span: Span) -> ImportDecl Diagnostic! {
    name := ^first
    end := first_span.end
    loop parser_current_kind(&state) == TOKEN_DOT {
        next :: parser_kind_at(&state, 1)
        if next == TOKEN_LBRACKET || next == TOKEN_LBRACE || next == TOKEN_STAR -> break
        parser_bump(&state)
        part :: parser_expect_name(&state, "after `.` in an import")
        if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
        &name.push('.'); &name.push_str(part.payload.decoded)
        end = part.span.end
    }
    module_span :: Span{start: first_span.start, end: end}
    if parser_current_kind(&state) == TOKEN_DOT -> parser_bump(&state)
    if parser_current_kind(&state) == TOKEN_STAR {
        star :: parser_bump(&state).span
        return Err(diagnostic_from_registry("E0612", Val(star), "wildcard imports are not supported", "`use {name}.*` would hide where each name comes from", "list each item instead: `use {name}.[item, other]`"))
    }
    if parser_current_kind(&state) == TOKEN_LBRACE {
        brace :: parser_bump(&state).span
        depth := 1
        loop depth > 0 && parser_current_kind(&state) != TOKEN_EOF {
            kind :: parser_current_kind(&state)
            if kind == TOKEN_LBRACE -> depth += 1
            if kind == TOKEN_RBRACE -> depth -= 1
            parser_bump(&state)
        }
        return Err(diagnostic_from_registry("E0003", Val(brace), "brace import groups are not supported", "`use {name}.{{…}}` is the retired grouped-import spelling", "write `use {name}.[item, other as local]`"))
    }
    if parser_current_kind(&state) == TOKEN_LBRACKET -> return import_decl_unqualified_list(&state, start, ^name, module_span)
    alias := name.rsplit('.').next() ?? name
    alias_span := start
    if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == Syntax.KW_AS {
        parser_bump(&state)
        local :: parser_expect_name(&state, "after `as`")
        alias = ~local.payload.decoded; alias_span = local.span
    }
    parser_expect(&state, TOKEN_SEMI, "after an import")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    Ok(ImportDecl{kind: ImportKind.Module{name: ^name, span: module_span}, alias: ~alias, alias_span: alias_span, span: Span{start: start.start, end: parser_lookahead(&state, -1).span.end}, item_spans: [], local_spans: [], is_pub: false, is_package_pub: false, inline_version: None})
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:579
fn import_decl_unqualified_list(state: &JetParserState, start: Span, module_alias: ^String, module_alias_span: Span) -> ImportDecl Diagnostic! {
    open :: parser_bump(&state).span
    if parser_current_kind(&state) == TOKEN_RBRACKET || parser_current_kind(&state) == TOKEN_EOF -> return Err(diagnostic_from_registry("E0003", Val(parser_current(&state).span), "an import member list cannot be empty", "the canonical `.[…]` form must name at least one member", "write `use prefix.[member]`"))
    items := [ImportedItem]{}
    item_spans := [Span]{}
    local_spans := [Span]{}
    loop parser_current_kind(&state) != TOKEN_RBRACKET && parser_current_kind(&state) != TOKEN_EOF {
        first :: parser_expect_name(&state, "inside `use prefix.[…]`")
        item := ~first.payload.decoded
        item_end := first.span.end
        local_span := first.span
        loop parser_current_kind(&state) == TOKEN_DOT {
            parser_bump(&state)
            part :: parser_expect_name(&state, "after `.` in an import list")
            if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
            &item.push('.'); &item.push_str(part.payload.decoded)
            item_end = part.span.end; local_span = part.span
        }
        alias := String?{None}
        if parser_current_kind(&state) == TOKEN_IDENT && parser_current(&state).payload.decoded == Syntax.KW_AS {
            parser_bump(&state)
            local :: parser_expect_name(&state, "after `as` in import list")
            local_span = local.span; alias = Val(~local.payload.decoded)
        }
        if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
        &items.push(ImportedItem{original: ^item, alias: ^alias})
        &item_spans.push(Span{start: first.span.start, end: item_end})
        &local_spans.push(local_span)
        if parser_current_kind(&state) == TOKEN_COMMA -> parser_bump(&state) else -> break
    }
    close :: parser_current(&state).span
    parser_expect(&state, TOKEN_RBRACKET, "to close `use prefix.[…]`")
    parser_expect(&state, TOKEN_SEMI, "after an import")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    span :: Span{start: start.start, end: parser_lookahead(&state, -1).span.end}
    Ok(ImportDecl{kind: ImportKind.Unqualified{module_alias: ~module_alias, module_alias_span: module_alias_span, items: ^items, items_span: Span{start: open.start, end: close.end}, span: span}, alias: ^module_alias, alias_span: module_alias_span, span: span, item_spans: ^item_spans, local_spans: ^local_spans, is_pub: false, is_package_pub: false, inline_version: None})
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:665
fn inline_version(state: &JetParserState) -> InlineVersion Diagnostic! {
    hash :: parser_bump(&state).span
    first :: parser_current(&state)
    text := if first.kind == {
        TOKEN_INT -> first.payload.integer.expect("integer payload").to_string()
        TOKEN_FLOAT -> format_version_segment(first.payload.decimal.expect("float payload"))
        else -> return Err(diagnostic_from_registry("E0003", Val(first.span), "expected a version number after `#`", "`use pkg#version;` (U11) pins an inline script dependency to a version.", "write digits after `#`, e.g. `use textkit#1.4;` or `use textkit#1.4.2;`"))
    }
    end := parser_bump(&state).span.end
    loop parser_current_kind(&state) == TOKEN_DOT && parser_kind_at(&state, 1) == TOKEN_INT {
        parser_bump(&state)
        part :: parser_bump(&state)
        &text.push('.'); &text.push_str(part.payload.integer.expect("integer payload").to_string())
        end = part.span.end
    }
    Ok(InlineVersion{text: ^text, span: Span{start: hash.start, end: end}})
}
