// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:884
// This program arm preserves grouped-marker admission separately from parsing:
// field effects remain visible on failure, but applied-rule receipts do not.
fn apply_grouped_file_markers(state: &JetParserState, program: &Program, markers: ^[Marker], html_seen: &Bool) -> Unit Never! {
    failed := false
    had_pub_file :: program.pub_file
    had_no_prelude :: program.no_prelude
    loop marker in markers {
        if marker.name == {
            Syntax.MARKER_PUB_FILE -> {
                if program.pub_file {
                    if had_pub_file -> &state.diagnostics.push(marker_repeated_error(Syntax.MARKER_PUB_FILE, "file", marker.span))
                    failed = true
                } else {
                    program.pub_file = true
                    state.pub_file_default = true
                }
            }
            Syntax.MARKER_NO_PRELUDE -> {
                if program.no_prelude {
                    if had_no_prelude -> &state.diagnostics.push(marker_repeated_error(Syntax.MARKER_NO_PRELUDE, "file", marker.span))
                    failed = true
                } else -> program.no_prelude = true
            }
            Syntax.MARKER_TARGET -> {
                if state.web_target_from_marker(marker) == {
                    .Ok(TargetMarker.DefaultWeb) -> {
                        if program.default_target == None -> program.default_target = Val(Syntax.BUILD_TARGET_WEB)
                        else {
                            &state.diagnostics.push(diagnostic_from_registry("E0003", Val(marker.span), "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`"))
                            failed = true
                        }
                    }
                    .Ok(TargetMarker.Bucket(target)) -> {
                        if program.web_target_ceiling == None -> program.web_target_ceiling = Val(target)
                        else {
                            &state.diagnostics.push(diagnostic_from_registry("E0003", Val(marker.span), "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`"))
                            failed = true
                        }
                    }
                    .Ok(_) -> {
                        &state.diagnostics.push(diagnostic_from_registry("E0003", Val(marker.span), "this grouped `#Target` duplicates or cannot attach at file scope", "a file marker list may contain one file target and one companion `#HTML` marker", "remove the duplicate, or move an OS target directly onto its `impl`"))
                        failed = true
                    }
                    .Err(diagnostic) -> { &state.diagnostics.push(^diagnostic); failed = true }
                }
            }
            Syntax.MARKER_HTML -> {
                if state.html_from_marker(marker) == {
                    .Ok(path) -> {
                        if !html_seen { html_seen = true; program.html_path = ^path }
                        else {
                            &state.diagnostics.push(diagnostic_from_registry("E0003", Val(marker.span), "only one `#HTML(…)` marker is allowed per file", "a file may declare at most one companion host page", "remove the duplicate `#HTML(…)` marker"))
                            failed = true
                        }
                    }
                    .Err(diagnostic) -> { &state.diagnostics.push(^diagnostic); failed = true }
                }
            }
            else -> {
                diagnostic :: if applied_rule(marker.name) == {
                    .Val(row) -> if row.status == RuleStatus.Active {
                        marker_wrong_site_error(marker.name, RuleSite.File, marker.span)
                    } else { marker_unknown_error(marker.name, active_rule_names(), marker.name_span) }
                    .None -> marker_unknown_error(marker.name, active_rule_names(), marker.name_span)
                }
                &state.diagnostics.push(^diagnostic)
                failed = true
            }
        }
    }
    if failed -> parser_sync_top(&state)
    else {
        loop marker in ^markers -> &program.applied_rules.push(AppliedRuleApplication{marker: ^marker, target: None, site: Val(RuleSite.File)})
    }
}

// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:1114
fn apply_program_html_marker(state: &JetParserState, program: &Program, marker: ^Marker, path: ^String?, html_seen: &Bool) -> Unit Never! {
    if html_seen {
        &state.diagnostics.push(diagnostic_from_registry("E0003", Val(parser_current(&state).span), "only one `#HTML(…)` marker is allowed per file", "a file may declare at most one companion host page", "remove the duplicate `#HTML(…)` marker"))
        parser_sync_top(&state)
        return
    }
    html_seen = true
    program.html_path = ^path
    &program.applied_rules.push(AppliedRuleApplication{marker: ^marker, target: None, site: Val(RuleSite.File)})
}
