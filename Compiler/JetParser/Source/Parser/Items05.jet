// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:12
fn user_policy_decl(state: &JetParserState, is_pub: Bool) -> UserPolicyDecl Diagnostic! {
    start :: parser_current(&state).span
    parser_expect_name(&state, "to start a policy declaration")
    name :: parser_expect_name(&state, "the policy setting name")
    if parser_current_kind(&state) != TOKEN_LPAREN -> parser_expect(&state, TOKEN_LPAREN, "to open the policy parameter list")
    params :: parser_parse_param_list(&state)
    parser_expect(&state, TOKEN_LBRACE, "to open the policy declaration")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    wrap :: parser_expect_name(&state, "`wrap` in a policy declaration")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    if wrap.payload.decoded != Syntax.KW_WRAP -> return Err(diagnostic_from_registry("E0003", Val(wrap.span), "expected `{Syntax.KW_WRAP}` in a policy declaration, found `{wrap.payload.decoded}`", "a user policy has one checked wrapper boundary around the supplied callable", "write `{Syntax.KW_WRAP}`(call) {{ … }}"))
    parser_expect(&state, TOKEN_LPAREN, "after `wrap` in a policy declaration")
    call :: parser_expect_name(&state, "the callable name in `wrap(call)`")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    if call.payload.decoded != "call" -> return Err(diagnostic_from_registry("E0003", Val(call.span), "a policy wrapper must receive `call`, found `{call.payload.decoded}`", "D-STRUCT-POLICY1 gives the wrapper one callable value and no AST or signature-edit power", "write `wrap(call) {{ … }}`"))
    parser_expect(&state, TOKEN_RPAREN, "to close `wrap(call)`")
    body :: parser_parse_block(&state)
    parser_skip_semicolons(&state)
    close :: parser_expect(&state, TOKEN_RBRACE, "to close the policy declaration")
    if parser_aborting(&state) -> return Err(&state.diagnostics.pop().expect("parse error"))
    if parser_current_kind(&state) == TOKEN_SEMI -> parser_bump(&state)
    if !is_pub -> return Err(diagnostic_from_registry("E0003", Val(start), "a user policy setting must be public", "policy settings are nominal package vocabulary and their users must resolve one package-owned name", "write `pub policy name(...) {{ wrap(call) {{ … }} }}`"))
    Ok(UserPolicyDecl{is_pub: is_pub, name: ~name.payload.decoded, name_span: name.span, params: ^params, body: ^body.statements, span: Span{start: start.start, end: close.span.end}})
}
// Rust: crates/jet-parser/src/Parser/Items/imports_policy.rs:83
fn callable_policy_chain_from_marker(marker: Marker) -> CallablePolicyChain Diagnostic! {
    CallablePolicyChain.parse(marker.expr_args_owned()).map_err(fn(reason) {
        names :: CallablePolicyChain.NAMES.map(fn(name) { "{name}(…)" }).join(", ")
        diagnostic_from_registry("E0355", Val(marker.span), "`#Policy` needs callable policy values: {reason}", "callable policies are typed values and preserve the complete function signature", "write `#Policy({names})`")
    })
}
