// Private continuation of JetParser.Parser.Items.
// Rust: crates/jet-parser/src/Parser/Items/helpers.rs:1
// Float-lexed major.minor segments always contained a decimal point. Float
// formatting drops it for whole numbers; restore it to preserve `pkg#1.0`.
// Trailing fractional zeroes (1.10 versus 1.1) remain indistinguishable.
// Rust: crates/jet-parser/src/Parser/Items/helpers.rs:9
fn format_version_segment(f: F64) -> String Never! {
    s :: f.to_string()
    if s.contains('.') { s } else { "{s}.0" }
}
