// Expression, type, pattern and literal printing: a 1:1 port of the Rust
// formatter's. Every Rust `Fmt` method is `jfmt_<name>(f: &JetFmt, …)`; shared
// driver state and the source scans live in Formatter.jet.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        BinMatchPart,
        BinOp,
        ByteTextPart,
        CallContractRow,
        Call,
        CallArg,
        EnumLitArg,
        Expr,
        ExprField,
        ForKind,
        Lambda,
        NamedSpan,
        OrFallback,
        ParamZone,
        PatSlot,
        Pattern,
        PipeStep,
        PlaceAccess,
        Span,
        Stmt,
        StrFormat,
        StrMatchPart,
        StrPart,
        Type,
        TypedLitBody,
        LIST_TYPE_OWNER,
        access_sigil,
        dimension_display_name,
        expr_source_start,
        expr_span,
        measure_expression,
        pipe_value_is_name,
        type_name,
    ]
    jet_lexer.[
        TOKEN_COLON,
        TOKEN_GT,
        TOKEN_IDENT,
        TOKEN_KW_FN,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SEMI,
        TOKEN_SHR,
    ]
}

// Rust `dispatch_value_head`: `(subject, table_op)`.
JetFmtDispatchHead: struct {
    subject: Expr
    op: BinOp
}

// One `fn(…)` type entry: a parameter or a `/` `*` zone separator.
JetFmtFnEntry: struct {
    index: Int
    zone: String
}

// Rust `let Expr::If { … } = expr else { … }` as an optional record.
JetFmtIf: struct {
    cond: Expr
    then_body: [Stmt]
    then_value: Expr
    else_body: [Stmt]
    else_value: Expr
    span: Span
}

JetFmtBinary: struct {
    op: BinOp
    left: Expr
    right: Expr
    span: Span
}

jfmt_if_parts: fn(expr: Expr) -> JetFmtIf? Never! {
    // copy: `cond`, `then_value` and `else_value` are payloads of read parameter `expr`, which keeps the originals; the new JetFmtIf's fields own `cond`, `then_value` and `else_value`
    if expr == .If(cond, then_body, then_value, else_body, else_value, span, _) -> return Val(JetFmtIf{cond: cond.copy(), then_body: then_body, then_value: then_value.copy(), else_body: else_body, else_value: else_value.copy(), span: span})
    None
}

jfmt_binary_parts: fn(expr: Expr) -> JetFmtBinary? Never! {
    // copy: `left` and `right` are payloads of read parameter `expr`, which keeps the originals; the new JetFmtBinary's fields own `left` and `right`
    if expr == .Binary(op, left, right, span, _) -> return Val(JetFmtBinary{op: op, left: left.copy(), right: right.copy(), span: span})
    None
}

jfmt_same_op: fn(left: BinOp, right: BinOp) -> Bool Never! {
    jfmt_bin_op_spell(left) == jfmt_bin_op_spell(right)
}

jfmt_same_span: fn(left: Span, right: Span) -> Bool Never! {
    left.start == right.start && left.end == right.end
}

jfmt_is_no_else: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .NoElse(_, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

jfmt_is_if: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .If(_, _, _, _, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

jfmt_if_span: fn(expr: Expr) -> Span? Never! {
    if expr == .If(_, _, _, _, _, span, _) -> return Val(span)
    None
}

// Skip leading ASCII whitespace (Rust `trim_start` on source text).
jfmt_trim_start_bytes: fn(bytes: [U8], start: Int) -> Int Never! {
    index := start
    loop index < bytes.len() && (bytes[index] == 32 || bytes[index] == 9 || bytes[index] == 10 || bytes[index] == 13) -> index += 1
    index
}

// A copy of the writer state with no source, for rendering a type to text.
jfmt_scratch: fn(f: JetFmt) -> JetFmt Never! {
    JetFmt{
        src: "",
        src_bytes: [U8]{},
        newlines: [Int]{},
        source_toks: f.source_toks,
        comments: [JetFmtComment]{},
        comment_i: 0,
        out: [U8]{},
        col: 0,
        at_line_start: false,
        indent: 0,
        pending_blank: false,
        trailing_comment_limit: JFMT_NO_LIMIT,
        items: f.items,
        policy_declarations: f.policy_declarations,
        fenced_statements: f.fenced_statements,
        simplify: f.simplify,
        expected_return_type: None,
        force_control_braces: false,
    }
}

jfmt_type_text: fn(f: JetFmt, ty: Type) -> String {
    scratch := jfmt_scratch(f)
    jfmt_fmt_type(scratch, ty)
    jfmt_out_text(scratch)
}

// R3: a direct returned struct literal already has its
// type from the function contract, so its `Type.` head is redundant.
jfmt_struct_lit_head_is_redundant: fn(f: JetFmt, type_name: String, type_args: [Type], import_ns: String?) -> Bool {
    expected: f.expected_return_type ?? return false
    name: if import_ns == .Val(ns) -> "{ns}.{type_name}" else -> type_name
    if expected == {
        .Named(expected_name) -> type_args.len() == 0 && expected_name == name
        .Apply(expected_name, args) -> {
            if expected_name != name || args.len() != type_args.len() -> return false
            loop index in 0..<args.len() {
                if jfmt_type_text(f, args[index]) != jfmt_type_text(f, type_args[index]) -> return false
            }
            true
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Render an `if`-expression chain with a shared `inline` decision.
jfmt_fmt_if_expr: fn(f: &JetFmt, expr: Expr, inline: Bool) {
    parts: jfmt_if_parts(expr) ?? return
    jfmt_write(f, "if ")
    jfmt_fmt_cond(f, parts.cond)
    jfmt_write(f, " -> ")
    if parts.then_body.len() == 0 && !jfmt_value_was_braced(f, parts.then_value) {
        jfmt_fmt_expr(f, parts.then_value, JFMT_PREC_OR_FALLBACK)
    } else {
        jfmt_fmt_value_block(f, parts.then_body, parts.then_value, inline)
    }
    // An `else` value that is a table of its own (`else -> if s == { … }`)
    // is not the next link of this chain: as `else if s == .A -> …` it
    // would read as a chain of tests.
    if {
        parts.else_body.len() == 0 && jfmt_is_if(parts.else_value) && !jfmt_is_guard_expr(f, parts.else_value) -> {
            jfmt_write(f, " else ")
            jfmt_fmt_if_expr(f, parts.else_value, inline)
        }
        parts.else_body.len() == 0 && !jfmt_value_was_braced(f, parts.else_value) -> {
            jfmt_write(f, " else -> ")
            jfmt_fmt_expr(f, parts.else_value, JFMT_PREC_OR_FALLBACK)
        }
        else -> {
            jfmt_write(f, " else -> ")
            jfmt_fmt_value_block(f, parts.else_body, parts.else_value, inline)
        }
    }
}

// The offset of an expression's first source byte. `expr_span` is a
// diagnostic anchor, not an extent, so descend the leftmost operand.
jfmt_expr_start: fn(expr: Expr) -> Int Never! {
    own: expr_span(expr).start
    leftmost := Expr?{None}
    if expr == {
        // copy: `base` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Field(base, _, _, _) -> leftmost = Val(base.copy())
        // copy: `base` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .MemberSpread(base, _, _, _) -> leftmost = Val(base.copy())
        // copy: `base` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .OptField(base, _, _, _, _, _) -> leftmost = Val(base.copy())
        // copy: `base` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Index(base, _, _, _, _) -> leftmost = Val(base.copy())
        // copy: `base` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Slice(base, _, _, _, _, _) -> leftmost = Val(base.copy())
        // copy: `receiver` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .MethodCall(receiver, _, _, _, _, _, _) -> leftmost = Val(receiver.copy())
        // copy: `receiver` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .OptMethodCall(receiver, _, _, _, _, _, _) -> leftmost = Val(receiver.copy())
        // copy: `callee` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .CallValue(callee, _, _, _) -> leftmost = Val(callee.copy())
        // copy: `left` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Binary(_, left, _, _, _) -> leftmost = Val(left.copy())
        .CompareChain(operands, _, _, _, _) -> {
            if operands.len() > 0 -> leftmost = Val(operands[0])
        }
        // copy: `start` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Range(start, _, _, _, _) -> leftmost = Val(start.copy())
        // copy: `inner` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Deref(inner, _, _) -> leftmost = Val(inner.copy())
        // copy: `inner` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .Try(inner, _, _, _, _) -> leftmost = Val(inner.copy())
        // copy: `value` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .OrFallback(value, _, _, _, _) -> leftmost = Val(value.copy())
        // copy: `subject` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
        .PatternTest(subject, _, _, _) -> leftmost = Val(subject.copy())
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Ok(_, _, _) | .Err(_, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    if leftmost == .Val(child) {
        child_start: jfmt_expr_start(child)
        return if child_start < own -> child_start else -> own
    }
    own
}

// Every postfix member spelling is emitted verbatim.
jfmt_write_postfix_member: fn(f: &JetFmt, member: String) Never! {
    jfmt_write(f, member)
}

// A fact read `x.reflect().fact` is the `$fact` member of `x` in the tree,
// spanned at the plain `fact`; a template's written `$` member stays as is.
jfmt_write_field_member: fn(f: &JetFmt, member: String, span: Span) Never! {
    if member.starts_with("$") && !jfmt_src_text(f, span.start, span.end).starts_with("$") {
        jfmt_write(f, "reflect().")
        jfmt_write(f, member.slice(1..<member.len()))
        return
    }
    jfmt_write(f, member)
}

// True when the author wrote this value inside its own `{ … }`: the source
// token before the value's left edge is the only surviving evidence. An
// interpolation hole has no tokens of its own (the whole string is one), so
// there the byte before the value decides.
jfmt_value_was_braced: fn(f: JetFmt, value: Expr) -> Bool Never! {
    start: jfmt_expr_start(value)
    if f.interp_depth > 0 {
        if start <= 0 || start > f.src_bytes.len() -> return false
        before := start - 1
        loop before > 0 && (f.src_bytes[before] == 32 || f.src_bytes[before] == 9 || f.src_bytes[before] == 10 || f.src_bytes[before] == 13) -> before -= 1
        return f.src_bytes[before] == 123
    }
    index := f.source_toks.len() - 1
    loop index >= 0 {
        token: f.source_toks[index]
        if token.span.end <= start && !jfmt_is_comment_kind(token.kind) && token.kind != TOKEN_SEMI -> return token.kind == TOKEN_LBRACE
        index -= 1
    }
    false
}

jfmt_is_guard_expr: fn(f: JetFmt, expr: Expr) -> Bool Never! {
    span: jfmt_if_span(expr) ?? return false
    if !jfmt_src_valid(f, span.start, span.end) -> return false
    if !jfmt_bytes_starts_at(f.src_bytes, span.start, "if") -> return false
    rest: jfmt_trim_start_bytes(f.src_bytes, span.start + 2)
    if rest < span.end && f.src_bytes[rest] == 123 -> return true
    // `if subject OP { … }` value tables share the guard surface.
    jfmt_dispatch_value_head(f, expr) != None
}

// A guarded table arm (`.Rect(w, h) && w == h -> …`) is an `&&` whose
// leftmost operand holds the arm's test of the subject.
jfmt_guard_arm_test: fn(cond: Expr) -> Expr Never! {
    test := cond.copy()
    loop {
        if test == .Binary(op, left, _, _, _) {
            if jfmt_bin_op_spell(op) == "&&" {
                test = left.copy()
                next
            }
        }
        break
    }
    test
}

// Recover `(subject, table_op)` from a nested value-dispatch `Expr::If` chain.
jfmt_dispatch_value_head: fn(f: JetFmt, expr: Expr) -> JetFmtDispatchHead? Never! {
    head: jfmt_if_parts(expr) ?? return None
    cond: jfmt_guard_arm_test(head.cond)
    span: head.span
    if !jfmt_src_valid(f, span.start, span.end) || !jfmt_bytes_starts_at(f.src_bytes, span.start, "if") -> return None
    rest: jfmt_trim_start_bytes(f.src_bytes, span.start + 2)
    if rest < span.end && f.src_bytes[rest] == 123 -> return None
    table_op: jfmt_cmp_op_before_brace(f.src_bytes, rest, span.end) ?? return None
    if cond == {
        .Binary(op, left, _, _, _) -> {
            if jfmt_same_op(op, table_op) -> return Val(JetFmtDispatchHead{subject: left, op: table_op})
            if jfmt_bin_op_spell(op) == "||" {
                // A table arm may start with `"a" | "b"`, lowered to an Or of
                // comparisons; keep the table surface only when every
                // alternative compares the same subject.
                first := cond
                loop {
                    if first == .Binary(inner_op, inner_left, _, _, _) {
                        if jfmt_bin_op_spell(inner_op) == "||" {
                            first = inner_left
                            next
                        }
                    }
                    break
                }
                first_binary: jfmt_binary_parts(first) ?? return None
                if jfmt_same_op(first_binary.op, table_op) && jfmt_is_all_value_alts(f, first_binary.left, table_op, cond) -> return Val(JetFmtDispatchHead{subject: first_binary.left, op: table_op})
            }
            JetFmtDispatchHead?{None}
        }
        // Card #1440: a pattern-headed value table's first arm is a
        // PatternTest; the table subject is the test's subject (`==` only).
        .PatternTest(subject, _, _, _) -> {
            if jfmt_bin_op_spell(table_op) == "==" -> return Val(JetFmtDispatchHead{subject: subject, op: table_op})
            JetFmtDispatchHead?{None}
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> JetFmtDispatchHead?{None}
    }
}

// The comparison operator just before the table's `{` in `rest..end`: the
// first `{` outside parentheses, brackets and string literals, so a typed
// literal in the subject's arguments (`if set(.RoundRobin{priority: 1}) == {`)
// is not taken for the table. `if cond -> { … }` is a braced arm body, not a
// table. Bytes, not tokens: a table inside an interpolation hole has no
// tokens of its own.
jfmt_cmp_op_before_brace: fn(bytes: [U8], rest: Int, end: Int) -> BinOp? Never! {
    depth := 0
    brace := -1
    index := rest
    loop index < end && index < bytes.len() {
        byte: bytes[index]
        if {
            byte == 34 -> {
                index += 1
                loop index < end && index < bytes.len() && bytes[index] != 34 {
                    if bytes[index] == 92 -> index += 1
                    index += 1
                }
            }
            byte == 40 || byte == 91 -> depth += 1
            byte == 41 || byte == 93 -> {
                depth -= 1
                if depth < 0 -> return None
            }
            byte == 123 && depth == 0 -> {
                brace = index
                break
            }
        }
        index += 1
    }
    if brace < 0 -> return None
    last := brace
    loop last > rest && (bytes[last - 1] == 32 || bytes[last - 1] == 9 || bytes[last - 1] == 10 || bytes[last - 1] == 13) -> last -= 1
    if {
        jfmt_bytes_ends_at(bytes, rest, last, "->") -> None
        jfmt_bytes_ends_at(bytes, rest, last, "==") -> Val(BinOp.Eq)
        jfmt_bytes_ends_at(bytes, rest, last, "!=") -> Val(BinOp.Ne)
        jfmt_bytes_ends_at(bytes, rest, last, "<=") -> Val(BinOp.Le)
        jfmt_bytes_ends_at(bytes, rest, last, ">=") -> Val(BinOp.Ge)
        jfmt_bytes_ends_at(bytes, rest, last, "<") -> Val(BinOp.Lt)
        jfmt_bytes_ends_at(bytes, rest, last, ">") -> Val(BinOp.Gt)
        else -> None
    }
}

// `bytes[from..end]` ends with `needle`.
jfmt_bytes_ends_at: fn(bytes: [U8], from: Int, end: Int, needle: String) -> Bool Never! {
    start: end - needle.bytes().len()
    start >= from && jfmt_bytes_starts_at(bytes, start, needle)
}

jfmt_fmt_guard_arm_value: fn(f: &JetFmt, body: [Stmt], value: Expr) {
    if body.len() == 0 {
        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
    } else {
        jfmt_fmt_value_block(f, body, value, false)
    }
}

// The next arm of a dispatch table: an `else` If that shares the table span.
jfmt_table_continues: fn(else_body: [Stmt], else_value: Expr, arm_span: Span, table_span: Span) -> Bool Never! {
    if else_body.len() > 0 -> return false
    next_span: jfmt_if_span(else_value) ?? return false
    jfmt_same_span(next_span, arm_span) && jfmt_same_span(arm_span, table_span)
}

// A table the author wrote on one line without comments stays on one line,
// arms split by `,`, when it fits: `if r == { .Val(n) -> n, .None -> 0 }`.
// Any other table expands to one arm per line, without commas.
jfmt_fmt_guard_expr: fn(f: &JetFmt, expr: Expr) {
    table_span: jfmt_if_span(expr) ?? return
    if jfmt_one_line_trial_lost(f) -> return
    // A line break in an interpolation hole would split the string.
    if f.interp_depth > 0 {
        jfmt_fmt_guard_table(f, expr, table_span, true)
        return
    }
    if jfmt_written_on_one_line(f, table_span) {
        // Inside a one-line trial the expanded form would fail it as well.
        if f.one_line_trials > 0 {
            jfmt_fmt_guard_table(f, expr, table_span, true)
            return
        }
        mark: jfmt_one_line_trial_begin(f)
        jfmt_fmt_guard_table(f, expr, table_span, true)
        if jfmt_one_line_trial_end(f, mark) -> return
    }
    jfmt_fmt_guard_table(f, expr, table_span, false)
}

// The source of `span` holds no line break and no comment.
jfmt_written_on_one_line: fn(f: JetFmt, span: Span) -> Bool Never! {
    jfmt_src_valid(f, span.start, span.end) && jfmt_line_of(f, span.start) == jfmt_line_of(f, span.end) && !jfmt_span_has_comment(f, span.start, span.end)
}

// Open, separate and close the arms of a table on one line or one per line.
jfmt_table_open: fn(f: &JetFmt, compact: Bool) {
    jfmt_write(f, "{{")
    if compact {
        jfmt_write(f, " ")
    } else {
        jfmt_newline(f)
        f.indent += 1
    }
}

jfmt_table_arm_break: fn(f: &JetFmt, compact: Bool) {
    if compact -> jfmt_write(f, ", ") else -> jfmt_newline(f)
}

jfmt_table_close: fn(f: &JetFmt, compact: Bool) {
    if compact {
        jfmt_write(f, " }}")
    } else {
        f.indent -= 1
        jfmt_end_block(f)
    }
}

jfmt_fmt_guard_table: fn(f: &JetFmt, expr: Expr, table_span: Span, compact: Bool) {
    if jfmt_dispatch_value_head(f, expr) == .Val(head) {
        jfmt_write(f, "if ")
        jfmt_fmt_expr(f, head.subject, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, " ")
        jfmt_write(f, jfmt_bin_op_spell(head.op))
        jfmt_write(f, " ")
        jfmt_table_open(f, compact)
        arm := expr
        loop {
            parts: jfmt_if_parts(arm) ?? break
            jfmt_fmt_dispatch_value_cond(f, head.subject, head.op, parts.cond)
            jfmt_write(f, " -> ")
            jfmt_fmt_guard_arm_value(f, parts.then_body, parts.then_value)
            // Card #1440: an exhaustive all-pattern table ends in NoElse.
            if parts.else_body.len() == 0 && jfmt_is_no_else(parts.else_value) -> break
            jfmt_table_arm_break(f, compact)
            if jfmt_table_continues(parts.else_body, parts.else_value, parts.span, table_span) {
                arm = parts.else_value
                next
            }
            jfmt_write(f, "else -> ")
            jfmt_fmt_guard_arm_value(f, parts.else_body, parts.else_value)
            break
        }
        jfmt_table_close(f, compact)
        return
    }
    jfmt_write(f, "if ")
    jfmt_table_open(f, compact)
    arm := expr
    loop {
        parts: jfmt_if_parts(arm) ?? break
        if !jfmt_fmt_readiness_head(f, parts.cond) -> jfmt_fmt_expr(f, parts.cond, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, " -> ")
        jfmt_fmt_guard_arm_value(f, parts.then_body, parts.then_value)
        jfmt_table_arm_break(f, compact)
        if jfmt_table_continues(parts.else_body, parts.else_value, parts.span, table_span) {
            arm = parts.else_value
            next
        }
        jfmt_write(f, "else -> ")
        jfmt_fmt_guard_arm_value(f, parts.else_body, parts.else_value)
        break
    }
    jfmt_table_close(f, compact)
}

// Print a value-dispatch arm head, stripping `subject table_op` atoms.
jfmt_fmt_dispatch_value_cond: fn(f: &JetFmt, subject: Expr, table_op: BinOp, cond: Expr) {
    if jfmt_is_all_value_alts(f, subject, table_op, cond) {
        jfmt_fmt_value_alts(f, subject, table_op, cond)
        return
    }
    if cond == .Binary(op, left, right, _, _) {
        spelled: jfmt_bin_op_spell(op)
        if spelled == "&&" || spelled == "||" {
            jfmt_fmt_dispatch_value_operand(f, subject, table_op, left)
            jfmt_write(f, " {spelled} ")
            jfmt_fmt_dispatch_value_operand(f, subject, table_op, right)
            return
        }
        if jfmt_same_op(op, table_op) && jfmt_same_dispatch_subject(f, left, subject) {
            jfmt_fmt_expr(f, right, JFMT_PREC_CMP)
            return
        }
    }
    // Card #1440: a pattern arm head renders as its bare pattern.
    if cond == .PatternTest(test_subject, pattern, _, _) {
        if jfmt_bin_op_spell(table_op) == "==" && jfmt_same_dispatch_subject(f, test_subject, subject) {
            jfmt_fmt_pattern(f, pattern)
            return
        }
    }
    jfmt_fmt_expr(f, cond, JFMT_PREC_OR_FALLBACK)
}

jfmt_fmt_dispatch_value_operand: fn(f: &JetFmt, subject: Expr, table_op: BinOp, expr: Expr) {
    grouped: jfmt_expr_was_parenthesized(f, expr)
    if grouped -> jfmt_write(f, "(")
    jfmt_fmt_dispatch_value_cond(f, subject, table_op, expr)
    if grouped -> jfmt_write(f, ")")
}

jfmt_expr_was_parenthesized: fn(f: JetFmt, expr: Expr) -> Bool Never! {
    binary: jfmt_binary_parts(expr) ?? return false
    span: binary.span
    spelled: jfmt_bin_op_spell(binary.op)
    if spelled != "&&" && spelled != "||" -> return false
    next_index := -1
    loop (index, token) in f.source_toks {
        if token.span.start >= span.end && !jfmt_is_comment_kind(token.kind) {
            next_index = index
            break
        }
    }
    if next_index < 0 || f.source_toks[next_index].kind != TOKEN_RPAREN -> return false
    depth := 1
    index := next_index - 1
    loop index >= 0 {
        kind: f.source_toks[index].kind
        if !jfmt_is_comment_kind(kind) {
            if kind == TOKEN_RPAREN {
                depth += 1
            } else if kind == TOKEN_LPAREN {
                depth -= 1
                if depth == 0 -> return true
            }
        }
        index -= 1
    }
    false
}

jfmt_is_all_value_alts: fn(f: JetFmt, subject: Expr, table_op: BinOp, expr: Expr) -> Bool Never! {
    if expr == .Binary(op, left, right, _, _) {
        if jfmt_bin_op_spell(op) == "||" -> return jfmt_is_value_alt_leaf(f, subject, table_op, left) && jfmt_is_value_alt_leaf(f, subject, table_op, right)
    }
    false
}

jfmt_is_value_alt_leaf: fn(f: JetFmt, subject: Expr, table_op: BinOp, expr: Expr) -> Bool Never! {
    if expr == .Binary(op, left, right, _, _) {
        if jfmt_same_op(op, table_op) -> return jfmt_same_dispatch_subject(f, left, subject)
        if jfmt_bin_op_spell(op) == "||" -> return jfmt_is_value_alt_leaf(f, subject, table_op, left) && jfmt_is_value_alt_leaf(f, subject, table_op, right)
    }
    false
}

jfmt_fmt_value_alts: fn(f: &JetFmt, subject: Expr, table_op: BinOp, expr: Expr) {
    binary: jfmt_binary_parts(expr) ?? return
    if jfmt_same_op(binary.op, table_op) {
        jfmt_fmt_expr(f, binary.right, JFMT_PREC_CMP)
        return
    }
    jfmt_fmt_value_alts(f, subject, table_op, binary.left)
    jfmt_write(f, " | ")
    jfmt_fmt_value_alts(f, subject, table_op, binary.right)
}

// True when `candidate` denotes the dispatch subject: the `it` placeholder or
// the same source text, sliced from `expr_start` to the anchor's end.
jfmt_same_dispatch_subject: fn(f: JetFmt, candidate: Expr, subject: Expr) -> Bool Never! {
    if candidate == .Ident(name, _, _) {
        if name == "it" -> return true
    }
    candidate_span: expr_span(candidate)
    subject_span: expr_span(subject)
    if jfmt_same_span(candidate_span, subject_span) -> return true
    candidate_start: jfmt_expr_start(candidate)
    subject_start: jfmt_expr_start(subject)
    if !jfmt_src_valid(f, candidate_start, candidate_span.end) || !jfmt_src_valid(f, subject_start, subject_span.end) -> return false
    jfmt_src_text(f, candidate_start, candidate_span.end) == jfmt_src_text(f, subject_start, subject_span.end)
}

// Every branch of an `if`-expression chain is inline-eligible.
jfmt_if_expr_chain_inlineable: fn(f: JetFmt, expr: Expr) -> Bool {
    parts: jfmt_if_parts(expr) ?? return false
    if !jfmt_value_block_inlineable(f, parts.then_body, parts.then_value) -> return false
    if parts.else_body.len() == 0 && jfmt_is_if(parts.else_value) && !jfmt_is_guard_expr(f, parts.else_value) -> return jfmt_if_expr_chain_inlineable(f, parts.else_value)
    jfmt_value_block_inlineable(f, parts.else_body, parts.else_value)
}

// ---- types ----

jfmt_fmt_type: fn(f: &JetFmt, ty: Type) {
    jfmt_fmt_type_at(f, ty, None)
}

jfmt_fmt_type_list: fn(f: &JetFmt, types: [Type], list_source: JetFmtSourceList?, fallback: Span) {
    item_spans: jfmt_list_item_spans(f, list_source)
    multiline: jfmt_comma_begin(f, types.len(), list_source)
    loop (index, arg) in types {
        span: jfmt_item_span_or(item_spans, index, fallback)
        jfmt_comma_before(f, index, multiline, span.start)
        jfmt_fmt_type(f, arg)
        jfmt_comma_after(f, multiline, span.end)
    }
    jfmt_comma_end(f, multiline, list_source)
}

jfmt_source_list_at: fn(f: JetFmt, source: Span?, delimiter: Int) -> JetFmtSourceList? Never! {
    if source == .Val(span) -> return jfmt_source_list_span_after(f, span.start, delimiter)
    None
}

jfmt_zone_is: fn(zone: ParamZone, wanted: String) -> Bool Never! {
    if zone == {
        .PositionalOnly -> wanted == "positional"
        .LabelOnly -> wanted == "label"
        .Either -> wanted == "either"
    }
}

jfmt_fmt_type_at: fn(f: &JetFmt, ty: Type, source: Span?) {
    fallback_span: source ?? Span{start: 0, end: 0}
    if ty == {
        .Int -> jfmt_write(f, "Int")
        .Float -> jfmt_write(f, "Float")
        .IntN(signed, bits) -> {
            jfmt_write(f, if signed -> "I" else -> "U")
            jfmt_write(f, "{bits}")
        }
        .InlineRange(base, lo, hi) -> {
            jfmt_fmt_type(f, base)
            jfmt_write(f, "({lo}..{hi})")
        }
        .Float32 -> jfmt_write(f, "F32")
        .Bool -> jfmt_write(f, "Bool")
        .String -> jfmt_write(f, "String")
        .Char -> jfmt_write(f, "Char")
        // A nested type passes the source span on, so a tuple inside can
        // find its written field order; the tuple checks the names it finds.
        .List(inner) -> {
            jfmt_write(f, "[")
            jfmt_fmt_type_at(f, inner, source)
            jfmt_write(f, "]")
        }
        .Map(key, _, value) -> {
            jfmt_write(f, "[")
            jfmt_fmt_type(f, key)
            jfmt_write(f, ":")
            jfmt_fmt_type(f, value)
            jfmt_write(f, "]")
        }
        .Shared(inner) -> {
            jfmt_write(f, "Shared<")
            jfmt_fmt_type(f, inner)
            jfmt_write(f, ">")
        }
        // The optional mark follows the type it marks. A type marks once
        // (`Int??` does not parse), so an optional optional keeps the
        // `Option<Int?>` spelling.
        .Option(inner) -> {
            if {
                inner == .Option(_) -> {
                    jfmt_write(f, "Option<")
                    jfmt_fmt_type(f, inner)
                    jfmt_write(f, ">")
                }
                else -> {
                    jfmt_fmt_marked_type(f, inner)
                    jfmt_write(f, "?")
                }
            }
        }
        .Result(ok, err) -> {
            if jfmt_is_unit_type(ok) {
                jfmt_fmt_error_contract(f, err)
            } else {
                jfmt_fmt_marked_type(f, ok)
                jfmt_write(f, " ")
                jfmt_fmt_error_contract(f, err)
            }
        }
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            jfmt_write(f, "fn(")
            // Reprint the declared call contract — labels and
            // the `/` and `*` zone separators.
            contract: param_contract ?? [CallContractRow]{}
            entries := [JetFmtFnEntry]{}
            star_done := false
            loop index in 0..<params.len() {
                has_zone: index < contract.len()
                if has_zone && jfmt_zone_is(contract[index].zone, "label") && !star_done {
                    star_done = true
                    entries.push(JetFmtFnEntry{index: -1, zone: "*"})
                }
                entries.push(JetFmtFnEntry{index: index, zone: ""})
                if has_zone && jfmt_zone_is(contract[index].zone, "positional") {
                    next_positional: index + 1 < contract.len() && jfmt_zone_is(contract[index + 1].zone, "positional")
                    if !next_positional -> entries.push(JetFmtFnEntry{index: -1, zone: "/"})
                }
            }
            param_source: jfmt_source_list_at(f, source, JFMT_DELIM_PAREN)
            item_spans: jfmt_list_item_spans(f, param_source)
            multiline: jfmt_comma_begin(f, entries.len(), param_source)
            loop (entry_index, entry) in entries {
                span: jfmt_item_span_or(item_spans, entry_index, fallback_span)
                jfmt_comma_before(f, entry_index, multiline, span.start)
                if entry.index < 0 {
                    jfmt_write(f, entry.zone)
                } else {
                    if entry.index < contract.len() && contract[entry.index].label.len() > 0 {
                        jfmt_write(f, contract[entry.index].label)
                        jfmt_write(f, ": ")
                    }
                    if call_metadata == .Val(metadata) && entry.index < metadata.conventions.len() -> jfmt_write(f, access_sigil(metadata.conventions[entry.index]))
                    jfmt_fmt_type(f, params[entry.index])
                }
                jfmt_comma_after(f, multiline, span.end)
            }
            jfmt_comma_end(f, multiline, param_source)
            jfmt_write(f, ")")
            if effect_bound == .Val(bound) {
                jfmt_write(f, " -[")
                row_source := JetFmtSourceList?{None}
                if source == .Val(span) -> row_source = jfmt_source_effect_row_span_after(f, span.start)
                jfmt_fmt_effect_row(f, bound, row_source)
                jfmt_write(f, "]>")
                if ret == .Val(returned) {
                    if jfmt_is_unit_fallible_type(returned) {
                        jfmt_fmt_unit_fallible_return(f, returned)
                    } else {
                        jfmt_write(f, " ")
                        jfmt_fmt_type(f, returned)
                    }
                }
            } else if ret == .Val(returned) {
                if jfmt_is_unit_fallible_type(returned) {
                    jfmt_fmt_unit_fallible_return(f, returned)
                } else {
                    jfmt_write(f, " -> ")
                    jfmt_fmt_type(f, returned)
                }
            }
            if return_view_provenance == .Val(map) {
                // Function types keep no parameter names; the parser's
                // synthetic `_N` owners let `from` round-trip.
                if map.entries.len() == 1 && map.entries[0].slot.len() == 0 {
                    jfmt_write(f, " from ")
                    loop (index, source_path) in map.entries[0].value.sources {
                        if index > 0 -> jfmt_write(f, " | ")
                        if source_path.source == {
                            .Receiver -> jfmt_write(f, "self")
                            .Parameter(parameter) -> {
                                if parameter < params.len() -> jfmt_write(f, "_{parameter}")
                            }
                            .Static(module_path, name) -> {
                                jfmt_write(f, "static.")
                                if module_path.len() > 0 -> jfmt_write(f, "{module_path}.")
                                jfmt_write(f, name)
                            }
                        }
                    }
                }
            }
        }
        .Named(name) -> jfmt_write(f, if name == "Unit" -> "()" else -> name)
        // The raw-pointer type renders as the canonical `*T`.
        .Apply(name, args) -> {
            if name == "Ptr" && args.len() == 1 {
                jfmt_write(f, "*")
                jfmt_fmt_type(f, args[0])
                return
            }
            jfmt_write(f, name)
            jfmt_write(f, "<")
            type_source: jfmt_source_list_at(f, source, JFMT_DELIM_ANGLE)
            jfmt_fmt_type_list(f, args, type_source, fallback_span)
            jfmt_write(f, ">")
        }
        // Sema-synthesized; kept for exhaustiveness.
        .Quantity(base, dimension) -> {
            jfmt_write(f, "Quantity<")
            jfmt_fmt_type(f, base)
            jfmt_write(f, ", ")
            jfmt_write(f, dimension_display_name(dimension))
            jfmt_write(f, ">")
        }
        // Shape arguments use the measure spelling.
        .Measure(measure) -> jfmt_write(f, measure_expression(measure))
        .TraitObject(bounds) -> jfmt_write(f, bounds.join(" + "))
        .Tuple(fields) -> {
            jfmt_write(f, "(")
            list_source: jfmt_source_list_at(f, source, JFMT_DELIM_PAREN)
            item_spans: jfmt_list_item_spans(f, list_source)
            multiline: jfmt_comma_begin(f, fields.len(), list_source)
            written: jfmt_tuple_written_names(f, fields, list_source)
            loop index in 0..<fields.len() {
                span: jfmt_item_span_or(item_spans, index, fallback_span)
                jfmt_comma_before(f, index, multiline, span.start)
                // The field this position writes, and where its type starts.
                slot := index
                at := Span?{None}
                if index < written.len() {
                    name: jfmt_src_text(f, written[index].start, written[index].end)
                    loop (candidate, field) in fields {
                        if field.name == name {
                            slot = candidate
                            break
                        }
                    }
                    at = Val(Span{start: written[index].end, end: written[index].end})
                }
                jfmt_write(f, fields[slot].name)
                jfmt_write(f, ": ")
                jfmt_fmt_type_at(f, fields[slot].ty, at)
                jfmt_comma_after(f, multiline, span.end)
            }
            jfmt_comma_end(f, multiline, list_source)
            jfmt_write(f, ")")
        }
        .FixedList(elem, len) -> {
            jfmt_write(f, "[")
            jfmt_fmt_type(f, elem)
            jfmt_write(f, "#")
            jfmt_write(f, measure_expression(len))
            jfmt_write(f, "]")
        }
        // `#TagName Type` — prefix value-tag.
        .Tagged(marker, inner) -> {
            jfmt_write(f, "#")
            if marker == .User(name) -> jfmt_write(f, name)
            jfmt_write(f, " ")
            jfmt_fmt_type(f, inner)
        }
        // `A | B | …` (canonical order).
        .Union(members) -> {
            loop (index, member) in members {
                if index > 0 -> jfmt_write(f, " | ")
                jfmt_fmt_type(f, member)
            }
        }
    }
}

// The name spans of a tuple type's fields in the order the source writes
// them: the `name :` token pairs at the list's top level. The parser keeps the
// fields sorted, because tuple identity ignores order; printing that order
// would move the author's fields. Empty, so the parsed order stays, without a
// source list whose names match the parsed fields one for one.
jfmt_tuple_written_names: fn(f: JetFmt, fields: [TypeTupleField], source: JetFmtSourceList?) -> [Span] Never! {
    list: source ?? return [Span]{}
    names := [Span]{}
    depth := 0
    loop index in (jfmt_first_token_at(f, list.span.start) + 1)..<f.source_toks.len() {
        token: f.source_toks[index]
        if token.span.start >= list.close_start -> break
        kind: token.kind
        if kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE || kind == TOKEN_LT {
            depth += 1
            next
        }
        if kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE || kind == TOKEN_GT {
            depth = jfmt_saturating_sub(depth, 1)
            next
        }
        if kind == TOKEN_SHR {
            depth = jfmt_saturating_sub(depth, 2)
            next
        }
        if depth != 0 || kind != TOKEN_IDENT || index + 1 >= f.source_toks.len() || f.source_toks[index + 1].kind != TOKEN_COLON -> next
        name: jfmt_src_text(f, token.span.start, token.span.end)
        found := false
        loop field in fields {
            if field.name == name {
                found = true
                break
            }
        }
        if !found -> return [Span]{}
        names.push(token.span)
    }
    if names.len() != fields.len() -> return [Span]{}
    names
}

jfmt_is_unit_fallible_type: fn(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) -> return jfmt_is_unit_type(ok)
    false
}

jfmt_is_unit_type: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return name == "Unit"
    false
}

// A type before a suffix mark, grouped when the mark would
// otherwise bind to its last member.
jfmt_fmt_marked_type: fn(f: &JetFmt, ty: Type) {
    grouped: if ty == {
        .Union(_) | .Fn(_, _, _, _, _, _) | .Result(_, _) | .Tagged(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> false
    }
    if grouped {
        jfmt_write(f, "(")
        jfmt_fmt_type(f, ty)
        jfmt_write(f, ")")
    } else {
        jfmt_fmt_type(f, ty)
    }
}

// The error contract `E!` / `(E1 | E2)!`.
jfmt_fmt_error_contract: fn(f: &JetFmt, err: Type) {
    jfmt_fmt_marked_type(f, err)
    jfmt_write(f, "!")
}

jfmt_fmt_unit_fallible_return: fn(f: &JetFmt, ty: Type) {
    jfmt_write(f, " ")
    jfmt_fmt_type(f, ty)
}

jfmt_fmt_return_type: fn(f: &JetFmt, ty: Type) {
    jfmt_fmt_type(f, ty)
}

jfmt_fmt_named_struct_head: fn(f: &JetFmt, type_name: String, type_args: [Type], import_ns: String?, source_span: Span?) {
    if import_ns == .Val(ns) {
        jfmt_write(f, ns)
        jfmt_write(f, ".")
    }
    jfmt_write(f, type_name)
    if type_args.len() > 0 {
        jfmt_write(f, "<")
        type_source: jfmt_source_list_at(f, source_span, JFMT_DELIM_ANGLE)
        jfmt_fmt_type_list(f, type_args, type_source, source_span ?? Span{start: 0, end: 0})
        jfmt_write(f, ">")
    }
}

jfmt_fmt_struct_lit_body: fn(f: &JetFmt, fields: [ExprField], span: Span) {
    jfmt_write(f, "{{")
    multiline: jfmt_source_span_multiline(f, span)
    if multiline {
        jfmt_newline(f)
        f.indent += 1
    }
    loop (index, field) in fields {
        if index > 0 {
            if multiline {
                jfmt_newline(f)
            } else {
                jfmt_write(f, ", ")
            }
        }
        if multiline -> jfmt_emit_leading(f, field.name_span.start)
        jfmt_write(f, field.name)
        jfmt_write(f, ": ")
        if multiline -> jfmt_emit_leading(f, expr_span(field.value).start)
        jfmt_fmt_expr(f, field.value, JFMT_PREC_OR_FALLBACK)
        if multiline {
            jfmt_write(f, ",")
            jfmt_emit_trailing(f, expr_span(field.value).end)
        }
    }
    if multiline {
        jfmt_emit_leading(f, span.end)
        f.indent -= 1
        if !f.at_line_start -> jfmt_newline(f)
    }
    jfmt_write(f, "}}")
}

// One multiline list of expressions: `[`/`(` already written by the caller.
jfmt_fmt_expr_list: fn(f: &JetFmt, elements: [Expr], span: Span) {
    if jfmt_source_span_multiline(f, span) {
        jfmt_newline(f)
        f.indent += 1
        loop (index, element) in elements {
            if index > 0 -> jfmt_newline(f)
            jfmt_emit_leading(f, expr_span(element).start)
            jfmt_fmt_expr(f, element, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ",")
            jfmt_emit_trailing(f, expr_span(element).end)
        }
        jfmt_emit_leading(f, span.end)
        f.indent -= 1
        if !f.at_line_start -> jfmt_newline(f)
    } else {
        loop (index, element) in elements {
            if index > 0 -> jfmt_write(f, ", ")
            jfmt_fmt_expr(f, element, JFMT_PREC_OR_FALLBACK)
        }
    }
}

jfmt_layout_selector_name: fn(name: String) -> String? Never! {
    prefix: jfmt_internal_name("jet.layout.selector.")
    if !name.starts_with(prefix) -> return None
    bytes: name.bytes()
    Val(jfmt_bytes_text(bytes, prefix.bytes().len(), bytes.len()))
}

jfmt_fmt_err_constructor: fn(f: &JetFmt, fields: [ExprField], span: Span) {
    // Sema stores the constructor as a private three-field
    // value; source has one canonical call shape.
    jfmt_write(f, "Err(")
    source: jfmt_source_list_span_after(f, span.start, JFMT_DELIM_PAREN)
    multiline := false
    if source == .Val(list) -> multiline = jfmt_source_span_multiline(f, list.span)
    if multiline -> jfmt_newline(f)
    first := true
    loop field in fields {
        if field.name != "message" -> next
        jfmt_fmt_expr(f, field.value, JFMT_PREC_OR_FALLBACK)
        if multiline {
            jfmt_write(f, ",")
            jfmt_emit_trailing(f, expr_span(field.value).end)
        }
        first = false
        break
    }
    labels: [String]{"code", "cause"}
    loop label in labels {
        loop field in fields {
            if field.name != label -> next
            if field.value == .Present(value, _, _) {
                if !first {
                    if multiline {
                        jfmt_newline(f)
                    } else {
                        jfmt_write(f, ", ")
                    }
                }
                jfmt_write(f, label)
                jfmt_write(f, ": ")
                jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
                if multiline {
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(value).end)
                }
                first = false
            }
            break
        }
    }
    if multiline && !f.at_line_start -> jfmt_newline(f)
    jfmt_write(f, ")")
}

jfmt_fmt_typed_lit: fn(f: &JetFmt, head: Type?, body: TypedLitBody, span: Span) {
    // Print the head (when present) and the body shape.
    if head == .Val(head_type) -> jfmt_fmt_type_at(f, head_type, Val(span))
    jfmt_write(f, "{{")
    multiline: jfmt_source_span_multiline(f, span)
    if multiline {
        jfmt_newline(f)
        f.indent += 1
    }
    if body == {
        .Empty -> {}
        .Fields(fields) -> {
            loop (index, field) in fields {
                if index > 0 {
                    if multiline {
                        jfmt_newline(f)
                    } else {
                        jfmt_write(f, ", ")
                    }
                }
                if multiline -> jfmt_emit_leading(f, field.name_span.start)
                jfmt_write(f, field.name)
                jfmt_write(f, ": ")
                if multiline -> jfmt_emit_leading(f, expr_span(field.value).start)
                jfmt_fmt_expr(f, field.value, JFMT_PREC_OR_FALLBACK)
                if multiline {
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(field.value).end)
                }
            }
        }
        .Elements(elements) -> {
            loop (index, element) in elements {
                if index > 0 {
                    if multiline {
                        jfmt_newline(f)
                    } else {
                        jfmt_write(f, ", ")
                    }
                }
                if multiline -> jfmt_emit_leading(f, expr_span(element).start)
                jfmt_fmt_expr(f, element, JFMT_PREC_OR_FALLBACK)
                if multiline {
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(element).end)
                }
            }
        }
        .Entries(entries) -> {
            loop (index, entry) in entries {
                if index > 0 {
                    if multiline {
                        jfmt_newline(f)
                    } else {
                        jfmt_write(f, ", ")
                    }
                }
                if multiline -> jfmt_emit_leading(f, expr_span(entry.key).start)
                jfmt_fmt_expr(f, entry.key, JFMT_PREC_OR_FALLBACK)
                jfmt_write(f, ": ")
                if multiline -> jfmt_emit_leading(f, expr_span(entry.value).start)
                jfmt_fmt_expr(f, entry.value, JFMT_PREC_OR_FALLBACK)
                if multiline {
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(entry.value).end)
                }
            }
        }
        .Value(value) -> {
            if multiline -> jfmt_emit_leading(f, expr_span(value).start)
            // Only a headed body (`Regex{"\d+"}`) keeps its backslashes as
            // written; a bare `{"\\d+"}` is an ordinary string.
            if {
                head != None && value == .Str(parts, string_span, _) -> jfmt_fmt_typed_head_str(f, parts, string_span)
                else -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
            }
            if multiline -> jfmt_emit_trailing(f, expr_span(value).end)
        }
        .ByteText(parts) -> jfmt_fmt_byte_text_parts(f, parts)
    }
    if multiline {
        jfmt_emit_leading(f, span.end)
        f.indent -= 1
        if !f.at_line_start -> jfmt_newline(f)
    }
    jfmt_write(f, "}}")
}

jfmt_enum_lit_arg_span: fn(arg: EnumLitArg) -> Span Never! {
    if arg == {
        .Positional(value) -> expr_span(value)
        .Named(_, value) -> expr_span(value)
    }
}

jfmt_fmt_enum_lit: fn(f: &JetFmt, type_name: String, variant: String, variant_span: Span?, args: [EnumLitArg], leading_dot: Bool, span: Span) {
    head_at: jfmt_write_at(f)
    if type_name.len() == 0 {
        if leading_dot -> jfmt_write(f, ".")
    } else {
        jfmt_write(f, type_name)
        jfmt_write(f, ".")
    }
    jfmt_write(f, variant)
    if args.len() == 0 -> return
    // `Val(value)` holds exactly one value and its parser takes no trailing
    // comma, so it prints inline like the Present form.
    if type_name.len() == 0 && !leading_dot && variant == "Val" && args.len() == 1 && args[0] == .Positional(value) {
        jfmt_write(f, "(")
        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, ")")
        return
    }
    // Named payloads use braces; positional payloads keep the paren call
    // form. In an `if` condition a `{` would open the body, and at the head
    // of a statement `.Name{` opens a scope member, so a named payload there
    // keeps `(label: value)`.
    named: if args[0] == {
        .Named(_, _) -> true
        .Positional(_) -> false
    }
    statement_head: type_name.len() == 0 && leading_dot && f.stmt_head_at == head_at
    braces: named && !f.in_condition && !statement_head
    jfmt_write(f, if braces -> "{{" else -> "(")
    source_start: if variant_span == .Val(source) -> source.end else -> span.start
    // The author's own payload group gives the layout: a named payload
    // written `.Text(value: x)` has no brace group of its own, and the next
    // one in the file would decide its line breaks.
    first: jfmt_first_token_at(f, source_start)
    written_paren: variant_span != None && first < f.source_toks.len() && f.source_toks[first].kind == TOKEN_LPAREN
    delimiter: if braces && !written_paren -> JFMT_DELIM_BRACE else -> JFMT_DELIM_PAREN
    source: jfmt_source_list_span_after(f, source_start, delimiter)
    item_spans: jfmt_list_item_spans(f, source)
    multiline: jfmt_comma_begin(f, args.len(), source)
    loop (index, arg) in args {
        item_span: jfmt_item_span_or(item_spans, index, jfmt_enum_lit_arg_span(arg))
        jfmt_comma_before(f, index, multiline, item_span.start)
        if arg == {
            .Positional(value) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
            .Named(label, value) -> {
                jfmt_write(f, label)
                jfmt_write(f, ": ")
                jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
            }
        }
        jfmt_comma_after(f, multiline, item_span.end)
    }
    jfmt_comma_end(f, multiline, source)
    jfmt_write(f, if braces -> "}}" else -> ")")
}

jfmt_fmt_method_call: fn(f: &JetFmt, receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg]) {
    // A `Shared{value}` cell prints as written, with `<T>` when the owner
    // type is written. A written `Shared.new(value)` call stays a call: its
    // value is passed, not moved into the cell.
    if receiver == .Ident(name, _, _) {
        if name == "Shared" && method == "new" && args.len() == 1 && args[0].flags.shared_operand {
            jfmt_write(f, "Shared")
            if owner_type_args.len() == 1 {
                jfmt_write(f, "<")
                jfmt_fmt_type(f, owner_type_args[0])
                jfmt_write(f, ">")
            }
            jfmt_write(f, "{{")
            jfmt_fmt_expr(f, args[0].expr, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, "}}")
            return
        }
        if name == jfmt_internal_name("jet.task") && jfmt_fmt_task_surface_method(f, method, args) -> return
    }
    // A list-type static `[T#N].filled(value)` prints its owner type as written.
    list_type_owner: if receiver == .Ident(name, _, _) -> name == LIST_TYPE_OWNER && owner_type_args.len() == 1 else -> false
    if list_type_owner -> jfmt_fmt_type(f, owner_type_args[0]) else -> jfmt_fmt_expr(f, receiver, JFMT_PREC_POSTFIX)
    receiver_end: expr_span(receiver).end
    if !list_type_owner -> jfmt_fmt_call_type_args(f, owner_type_args, receiver_end)
    // S69 keep an author-placed break before `.method(...)`.
    if jfmt_chain_break_between(f, receiver_end, method_span.start) {
        jfmt_emit_trailing(f, receiver_end)
        f.indent += 1
        jfmt_newline(f)
        jfmt_write(f, ".")
        jfmt_write_postfix_member(f, method)
        jfmt_fmt_call_type_args(f, type_args, method_span.end)
        jfmt_fmt_method_args(f, method, args, Val(method_span.end))
        f.indent -= 1
    } else {
        jfmt_write(f, ".")
        jfmt_write_postfix_member(f, method)
        jfmt_fmt_call_type_args(f, type_args, method_span.end)
        jfmt_fmt_method_args(f, method, args, Val(method_span.end))
    }
}

jfmt_fmt_expr: fn(f: &JetFmt, expr: Expr, prec: Int) {
    if expr == {
        // S68 `if` used as a value.
        .If(_, _, _, _, _, _, _) -> {
            if jfmt_is_guard_expr(f, expr) {
                jfmt_fmt_guard_expr(f, expr)
                return
            }
            // The whole chain shares one line shape.
            if jfmt_if_expr_chain_inlineable(f, expr) {
                mark: jfmt_mark(f)
                jfmt_fmt_if_expr(f, expr, true)
                // Never leave a mixed inline/expanded chain.
                if jfmt_out_since_has_newline(f, mark.out_len) {
                    jfmt_rollback(f, mark)
                    jfmt_fmt_if_expr(f, expr, false)
                }
            } else {
                jfmt_fmt_if_expr(f, expr, false)
            }
        }
        .Str(parts, span, _) -> {
            // Source spans identify raw ordinary strings.
            if {
                jfmt_src_valid(f, span.start, span.end) && jfmt_bytes_starts_at(f.src_bytes, span.start, "`") -> jfmt_fmt_str_raw(f, parts)
                jfmt_src_valid(f, span.start, span.start + 3) && jfmt_bytes_starts_at(f.src_bytes, span.start, "\"\"\"") -> jfmt_fmt_str_multiline(f, parts)
                else -> jfmt_fmt_str(f, parts)
            }
        }
        // (c7shift): a pattern-literal argument.
        .StrMatchLit(parts, span, _) -> {
            typed_head: jfmt_is_typed_head_body(f, span)
            if !typed_head && jfmt_str_match_has_computed_hole(f, span) {
                // The parts keep only each hole's name; a computed hole
                // (`{id + 1}`, which check reports) prints as written.
                written: jfmt_src_text(f, span.start, span.end)
                jfmt_write(f, written)
            } else {
                jfmt_fmt_str_match_parts(f, parts, typed_head)
            }
        }
        // The byte-mode sibling.
        .BinMatchLit(parts, _, _) -> jfmt_fmt_bin_match_parts(f, parts)
        // S34/S67: keep the author's radix, separators and hex case.
        .Int(value, span, _, raw, _) -> {
            spelling: jfmt_int_literal_spelling(f, span, value, raw)
            jfmt_write(f, spelling)
        }
        .Float(value, _, _, raw, _) -> jfmt_write(f, jfmt_float_literal_spelling(value, raw))
        // `500ms` — no space between number and suffix.
        .UnitLit(raw, _, _, suffix, _, _, _) -> {
            jfmt_write(f, raw)
            jfmt_write(f, suffix)
        }
        .Bool(value, _, _) -> jfmt_write(f, if value -> "true" else -> "false")
        .Unit(span, _) -> if !jfmt_fmt_expression_rule(f, span) -> jfmt_write(f, "()")
        .Char(value, _, _) -> jfmt_write(f, jfmt_fmt_char(value))
        .ListLit(elements, span, _) -> {
            // Plain formatting preserves explicit constructor heads.
            jfmt_write(f, "[")
            jfmt_fmt_expr_list(f, elements, span)
            jfmt_write(f, "]")
        }
        // Re-emit member spread sugar.
        .MemberSpread(base, members, span, _) -> {
            jfmt_fmt_expr(f, base, JFMT_PREC_POSTFIX)
            jfmt_write(f, ".[")
            found: jfmt_source_list_span_after(f, expr_span(base).end, JFMT_DELIM_BRACKET)
            source := JetFmtSourceList?{None}
            if found == .Val(list) {
                if list.span.end <= span.end -> source = Val(list)
            }
            multiline: jfmt_comma_begin(f, members.len(), source)
            loop (index, member) in members {
                jfmt_comma_before(f, index, multiline, member.span.start)
                jfmt_write(f, member.name)
                jfmt_comma_after(f, multiline, member.span.end)
            }
            jfmt_comma_end(f, multiline, source)
            jfmt_write(f, "]")
        }
        .TupleLit(fields, span, _, _) -> {
            jfmt_write(f, "(")
            if jfmt_source_span_multiline(f, span) {
                jfmt_newline(f)
                f.indent += 1
                loop (index, field) in fields {
                    if index > 0 -> jfmt_newline(f)
                    value_start: expr_span(field.value).start
                    field_start: if index == 0 -> span.start else -> expr_span(fields[index - 1].value).end
                    colon := value_start
                    if jfmt_src_valid(f, field_start, value_start) {
                        found: jfmt_bytes_rfind(f.src_bytes, value_start, ":")
                        if found >= field_start -> colon = found
                    }
                    jfmt_emit_leading(f, colon)
                    jfmt_write(f, field.name)
                    jfmt_write(f, ": ")
                    jfmt_emit_leading(f, value_start)
                    jfmt_fmt_expr(f, field.value, JFMT_PREC_OR_FALLBACK)
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(field.value).end)
                }
                f.indent -= 1
                if !f.at_line_start -> jfmt_newline(f)
            } else {
                loop (index, field) in fields {
                    if index > 0 -> jfmt_write(f, ", ")
                    jfmt_write(f, field.name)
                    jfmt_write(f, ": ")
                    jfmt_fmt_expr(f, field.value, JFMT_PREC_OR_FALLBACK)
                }
            }
            jfmt_write(f, ")")
        }
        // An empty map is spelled `[]`, like an empty list.
        .MapLit(entries, span, _) -> {
            jfmt_write(f, "[")
            if jfmt_source_span_multiline(f, span) {
                jfmt_newline(f)
                f.indent += 1
                loop (index, entry) in entries {
                    if index > 0 -> jfmt_newline(f)
                    jfmt_emit_leading(f, expr_span(entry.key).start)
                    jfmt_fmt_expr(f, entry.key, JFMT_PREC_OR_FALLBACK)
                    jfmt_write(f, ": ")
                    jfmt_emit_leading(f, expr_span(entry.value).start)
                    jfmt_fmt_expr(f, entry.value, JFMT_PREC_OR_FALLBACK)
                    jfmt_write(f, ",")
                    jfmt_emit_trailing(f, expr_span(entry.value).end)
                }
                jfmt_emit_leading(f, span.end)
                f.indent -= 1
                if !f.at_line_start -> jfmt_newline(f)
            } else {
                loop (index, entry) in entries {
                    if index > 0 -> jfmt_write(f, ", ")
                    jfmt_fmt_expr(f, entry.key, JFMT_PREC_OR_FALLBACK)
                    jfmt_write(f, ": ")
                    jfmt_fmt_expr(f, entry.value, JFMT_PREC_OR_FALLBACK)
                }
            }
            jfmt_write(f, "]")
        }
        .Index(base, index, _, _, _) -> {
            jfmt_fmt_expr(f, base, JFMT_PREC_POSTFIX)
            jfmt_write(f, "[")
            selector := String?{None}
            if index == .Ident(name, _, _) -> selector = jfmt_layout_selector_name(name)
            if selector == .Val(field) {
                jfmt_write(f, ".")
                jfmt_write(f, field)
            } else {
                jfmt_fmt_expr(f, index, JFMT_PREC_OR_FALLBACK)
            }
            jfmt_write(f, "]")
        }
        .Slice(base, start, end, range, _, _) -> {
            jfmt_fmt_expr(f, base, JFMT_PREC_POSTFIX)
            jfmt_write(f, "[")
            if range == .Val(range_expr) {
                jfmt_fmt_expr(f, range_expr, JFMT_PREC_OR_FALLBACK)
            } else {
                jfmt_fmt_expr(f, start, JFMT_PREC_OR_FALLBACK)
                jfmt_write(f, "..")
                jfmt_fmt_expr(f, end, JFMT_PREC_OR_FALLBACK)
            }
            jfmt_write(f, "]")
        }
        .Range(start, end, exclusive, _, _) -> {
            wrap: prec > JFMT_PREC_RANGE
            if wrap -> jfmt_write(f, "(")
            jfmt_fmt_expr(f, start, JFMT_PREC_OR)
            jfmt_write(f, if exclusive -> "..<" else -> "..")
            jfmt_fmt_expr(f, end, JFMT_PREC_OR)
            if wrap -> jfmt_write(f, ")")
        }
        // A pipe step's hidden name, or the head's name its first step
        // reads in place, is written `<>`.
        .Ident(name, _, _) -> jfmt_write(f, if pipe_value_is_name(name) || f.pipe_names.contains(name) -> "<>" else -> name)
        .Call(call, _) -> jfmt_fmt_call(f, call)
        .Unary(op, inner, _, _) -> {
            // Wrap only when the surrounding slot binds tighter.
            if prec > JFMT_PREC_UNARY -> jfmt_write(f, "(")
            if op == {
                .Neg -> jfmt_write(f, "-")
                .Not -> jfmt_write(f, "!")
            }
            jfmt_fmt_expr(f, inner, JFMT_PREC_UNARY)
            if prec > JFMT_PREC_UNARY -> jfmt_write(f, ")")
        }
        .Binary(op, left, right, _, _) -> {
            op_prec: jfmt_prec_of_bin(op)
            if prec > op_prec -> jfmt_write(f, "(")
            if jfmt_bin_op_method(op) == .Val(method) {
                jfmt_fmt_expr(f, left, JFMT_PREC_POSTFIX)
                jfmt_write(f, ".{method}(")
                jfmt_fmt_expr(f, right, JFMT_PREC_OR_FALLBACK)
                jfmt_write(f, ")")
            } else {
                spelled: jfmt_bin_op_spell(op)
                left_prec := op_prec
                right_prec := jfmt_prec_add_rhs(op_prec)
                // E0082 an `&&` operand of `||` always
                // prints with its grouping parentheses.
                if spelled == "||" {
                    if jfmt_is_and_operand(left) -> left_prec = jfmt_prec_add_rhs(JFMT_PREC_AND)
                    if jfmt_is_and_operand(right) -> right_prec = jfmt_prec_add_rhs(JFMT_PREC_AND)
                }
                jfmt_fmt_expr(f, left, left_prec)
                jfmt_write(f, " {spelled} ")
                jfmt_fmt_expr(f, right, right_prec)
            }
            if prec > op_prec -> jfmt_write(f, ")")
        }
        // `0 <= sev < 10` — same-direction relational chain.
        .CompareChain(operands, ops, _, _, _) -> {
            op_prec: jfmt_prec_of_bin(ops[0])
            if prec > op_prec -> jfmt_write(f, "(")
            jfmt_fmt_expr(f, operands[0], op_prec)
            loop (index, op) in ops {
                if index + 1 >= operands.len() -> break
                jfmt_write(f, " {jfmt_bin_op_spell(op)} ")
                jfmt_fmt_expr(f, operands[index + 1], jfmt_prec_add_rhs(op_prec))
            }
            if prec > op_prec -> jfmt_write(f, ")")
        }
        // Postfix `p.*` deref.
        .Deref(inner, _, _) -> {
            jfmt_fmt_expr(f, inner, JFMT_PREC_POSTFIX)
            jfmt_write(f, ".*")
        }
        // Prefix `*x` raw-pointer-of.
        .RawOf(inner, _, _) -> {
            jfmt_write(f, "*")
            jfmt_fmt_expr(f, inner, JFMT_PREC_UNARY)
        }
        // Prefix `x.copy()`.
        .Copy(inner, _, _) -> {
            jfmt_write(f, "~")
            jfmt_fmt_expr(f, inner, JFMT_PREC_UNARY)
        }
        .Place(inner, access, span, id) -> {
            // Parsed places are write windows (`&values[2..3]`), plain reads,
            // and marked receivers (`&xs.push(4)`, `&&buf.seal()`), which start
            // at their mark; a take sema builds is spelled `.move()` here.
            written_take: access == PlaceAccess.Take && id != AST_NODE_GENERATED && span.start < expr_source_start(inner)
            if access == {
                .Write -> jfmt_write(f, "&")
                .Take -> if written_take -> jfmt_write(f, "&&")
                .Read -> {}
            }
            sema_take: access == PlaceAccess.Take && !written_take
            jfmt_fmt_expr(f, inner, if sema_take -> JFMT_PREC_POSTFIX else -> JFMT_PREC_UNARY)
            if sema_take -> jfmt_write(f, ".move()")
        }
        .Field(base, field, span, _) -> {
            jfmt_fmt_expr(f, base, JFMT_PREC_POSTFIX)
            base_end: expr_span(base).end
            // S69 keep an author-placed break before `.field`.
            if jfmt_chain_break_between(f, base_end, span.end) {
                jfmt_emit_trailing(f, base_end)
                f.indent += 1
                jfmt_newline(f)
                jfmt_write(f, ".")
                jfmt_write_field_member(f, field, span)
                f.indent -= 1
            } else {
                jfmt_write(f, ".")
                jfmt_write_field_member(f, field, span)
            }
        }
        .OptField(base, member, _, _, _, _) -> {
            jfmt_fmt_expr(f, base, JFMT_PREC_POSTFIX)
            jfmt_write(f, "?.")
            jfmt_write_postfix_member(f, member)
        }
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _) -> jfmt_fmt_method_call(f, receiver, method, method_span, owner_type_args, type_args, args)
        // S71 `receiver?.method(args)`.
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> {
            jfmt_fmt_expr(f, receiver, JFMT_PREC_POSTFIX)
            jfmt_write(f, "?.")
            jfmt_write_postfix_member(f, method)
            jfmt_fmt_call_type_args(f, type_args, method_span.end)
            jfmt_fmt_method_args(f, method, args, Val(method_span.end))
        }
        .StructLit(type_name, type_args, import_ns, _, fields, inferred, span, _) -> {
            if type_name == "Err" {
                jfmt_fmt_err_constructor(f, fields, span)
                return
            }
            // `Type{ … }` (named) or `{ … }` (inferred).
            head_dropped: inferred || (f.simplify && jfmt_struct_lit_head_is_redundant(f, type_name, type_args, import_ns))
            if !head_dropped -> jfmt_fmt_named_struct_head(f, type_name, type_args, import_ns, Val(span))
            jfmt_fmt_struct_lit_body(f, fields, span)
        }
        .TypedLit(head, body, span, _) -> jfmt_fmt_typed_lit(f, head, body, span)
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, _) -> jfmt_fmt_enum_lit(f, type_name, variant, variant_span, args, leading_dot, span)
        // A direct value-fact application.
        .Tainted(inner, kind, _, _) -> {
            fact: kind ?? "Input"
            jfmt_write(f, "#{fact} ")
            jfmt_fmt_expr(f, inner, JFMT_PREC_UNARY)
        }
        .Present(inner, _, _) -> {
            jfmt_write(f, "Val(")
            jfmt_fmt_expr(f, inner, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ")")
        }
        .Absent(_, _) -> jfmt_write(f, "None")
        .Todo(_, _, _) -> jfmt_write(f, "#Todo")
        // Card #1440: the synthesized end of an else-less table; never printed.
        .NoElse(_, _) -> {}
        .PatternTest(subject, pattern, _, _) -> {
            jfmt_fmt_expr(f, subject, JFMT_PREC_CMP)
            jfmt_write(f, " == ")
            jfmt_fmt_pattern(f, pattern)
        }
        .Ok(inner, _, _) -> {
            jfmt_write(f, "Ok(")
            jfmt_fmt_expr(f, inner, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ")")
        }
        .Err(inner, _, _) -> {
            jfmt_write(f, "Err(")
            jfmt_fmt_expr(f, inner, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ")")
        }
        // A value's bare `x?` (only before a `)`) and the context frame
        // `x?(note)`. A call propagates by itself, so its bare mark (the
        // retired `call()?`) is left out.
        .Try(inner, _, _, note, _) -> {
            jfmt_fmt_expr(f, inner, JFMT_PREC_POSTFIX)
            if note == .Val(context) {
                jfmt_write(f, "?(")
                jfmt_fmt_expr(f, context, JFMT_PREC_POSTFIX)
                jfmt_write(f, ")")
            } else if !parser_expression_is_call(inner) {
                jfmt_write(f, "?")
            }
        }
        .OrFallback(value, fallback, _, _, _) -> {
            if prec > JFMT_PREC_OR_FALLBACK -> jfmt_write(f, "(")
            // `??` groups to the right, so a fallback group on its left keeps
            // its parens; census mode reads that slot one level tighter.
            value_prec: if f.drop_grouping -> JFMT_PREC_RANGE else -> jfmt_prec_add_rhs(JFMT_PREC_OR_FALLBACK)
            jfmt_fmt_expr(f, value, value_prec)
            jfmt_write(f, " ?? ")
            jfmt_fmt_or_fallback(f, fallback)
            if prec > JFMT_PREC_OR_FALLBACK -> jfmt_write(f, ")")
        }
        .Lambda(lambda, _) -> jfmt_fmt_lambda(f, lambda)
        .CallValue(callee, args, _, _) -> {
            if callee == .Lambda(lambda, _) {
                if lambda.meta.collecting_loop {
                    jfmt_fmt_collecting_loop(f, lambda)
                    return
                }
                if lambda.meta.result_loop {
                    if lambda.body == .Block(stmts) {
                        if stmts.len() == 1 {
                            if stmts[0] == .Loop(body, _, _, _) {
                                if lambda.meta.requires_exhaustion_route {
                                    jfmt_fmt_value_loop(f, body, lambda.meta.exhaustion_route_attached)
                                } else {
                                    jfmt_write(f, "loop {{")
                                    jfmt_newline(f)
                                    f.indent += 1
                                    jfmt_fmt_block_stmts(f, body)
                                    f.indent -= 1
                                    jfmt_newline(f)
                                    jfmt_write(f, "}}")
                                }
                                return
                            }
                        }
                    }
                }
            }
            // Direct calls on lambdas, fields and indexes keep
            // their spelling.
            if prec > JFMT_PREC_POSTFIX -> jfmt_write(f, "(")
            jfmt_fmt_expr(f, callee, JFMT_PREC_POSTFIX)
            jfmt_fmt_call_args_with_template(f, args, Val(expr_span(callee).end))
            if prec > JFMT_PREC_POSTFIX -> jfmt_write(f, ")")
        }
        // S58 (E2-M13): `alias.Ptr<T>.from_addr(addr)`.
        .PtrFromAddr(alias, _, elem, addr, _, _) -> {
            jfmt_write(f, alias)
            jfmt_write(f, ".Ptr<")
            jfmt_fmt_type(f, elem)
            jfmt_write(f, ">.from_addr(")
            jfmt_fmt_expr(f, addr, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ")")
        }
        // A pipe: the head, then one `|> step` per line, one level in; a
        // lone step stays on the head's line. A step that only calls a
        // method on `<>` joins the line above as `.method(…)`.
        .Pipe(head, steps, _, _) -> {
            // copy: the joined pieces are new expressions; the pipe keeps its own.
            joined := head.copy()
            rest := [Expr]{}
            // A first step that reads the head's name in place prints that
            // name as `<>` while it stays its own line.
            in_place := ""
            loop (index, step) in steps {
                if rest.len() == 0 {
                    if jfmt_pipe_step_joins(step, joined) == .Val(call) {
                        joined = call
                        next
                    }
                } else {
                    last: rest.len() - 1
                    if jfmt_pipe_step_joins(step, rest[last]) == .Val(call) {
                        rest[last] = call
                        next
                    }
                }
                // copy: the printed step is the pipe's own value, read in place.
                rest.push(step.value.copy())
                // copy: the printer's open-name stack keeps the step's name.
                if index == 0 && !pipe_value_is_name(step.name) -> in_place = step.name.copy()
            }
            if rest.len() == 0 {
                jfmt_fmt_expr(f, joined, prec)
            } else {
                if prec > JFMT_PREC_OR_FALLBACK -> jfmt_write(f, "(")
                jfmt_fmt_expr(f, joined, JFMT_PREC_OR_FALLBACK)
                f.indent += if rest.len() == 1 -> 0 else -> 1
                loop (index, value) in rest {
                    if rest.len() == 1 {
                        jfmt_write(f, " |> ")
                    } else {
                        jfmt_newline(f)
                        jfmt_write(f, "|> ")
                    }
                    // copy: the stack keeps its own name while the step prints.
                    if index == 0 && in_place != "" -> f.pipe_names.push(in_place.copy())
                    jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
                    if index == 0 && in_place != "" -> _ := f.pipe_names.pop()
                }
                f.indent -= if rest.len() == 1 -> 0 else -> 1
                if prec > JFMT_PREC_OR_FALLBACK -> jfmt_write(f, ")")
            }
        }
        // The mark is part of the name.
        .ComptimeName(name, _, _, _) -> jfmt_write(f, name)
        .TypeValue(ty, span, _) -> jfmt_fmt_type_at(f, ty, Val(span))
        // Author-written grouping parens are re-emitted; the generated one
        // around a value table's subject prints the subject as written. In
        // census mode a pair the slot's precedence does not need is left out.
        .Paren(inner, span, node) -> {
            if node == AST_NODE_GENERATED {
                jfmt_fmt_expr(f, inner, prec)
                return
            }
            if f.drop_grouping && jfmt_grouping_is_redundant(f, inner, span, prec) {
                f.dropped_grouping.push(span.copy())
                jfmt_fmt_expr(f, inner, prec)
                return
            }
            jfmt_write(f, "(")
            jfmt_fmt_expr(f, inner, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, ")")
        }
        // Spread call argument.
        .Spread(inner, _, _) -> {
            jfmt_write(f, "...")
            jfmt_fmt_expr(f, inner, JFMT_PREC_POSTFIX)
        }
    }
}

// Whether `expr`, inside any author grouping parens, is an `&&`.
jfmt_is_and_operand: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> jfmt_is_and_operand(inner)
        .Binary(op, _, _, _, _) -> op == BinOp.And
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Whether author parens around `inner` in a slot printed at `prec` can be left
// out without changing the parse. Parens that span lines carry the
// expression's continuation and stay. A comparison inside a comparison slot
// stays grouped (`(a < b) == c` is not a chain), as does a prefix operator
// under another (`-(-x)`) and a literal or struct receiver (`(1).abs()`). A
// form that never wraps itself (`if`, a lambda, a pattern test) stays.
jfmt_grouping_is_redundant: fn(f: JetFmt, inner: Expr, span: Span, prec: Int) -> Bool Never! {
    if !jfmt_src_range_valid(f, span.start, span.end) -> return false
    loop index in span.start..<span.end {
        if Int.from_u8(f.src_bytes[index]) == 10 -> return false
    }
    // A brace at the group's own depth would open an `if` or `loop` body once
    // the parens go, and an interpolated string right of `==` would become a
    // string pattern. Both groups carry meaning, so both stay.
    if jfmt_grouping_has_open_brace(f, span) -> return false
    if inner == {
        .Ident(_, _, _) | .Str(_, _, _) | .Char(_, _, _) | .Bool(_, _, _) | .ListLit(_, _, _) | .MapLit(_, _, _) | .TupleLit(_, _, _, _) | .Paren(_, _, _) | .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .Field(_, _, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Deref(_, _, _) -> true
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) -> prec <= JFMT_PREC_UNARY
        .Unary(_, _, _, _) -> prec < JFMT_PREC_UNARY
        .Range(_, _, _, _, _) -> prec <= JFMT_PREC_RANGE
        .Binary(op, _, _, _, _) -> {
            op_prec: jfmt_prec_of_bin(op)
            if op_prec == JFMT_PREC_CMP -> return prec < JFMT_PREC_CMP
            prec <= op_prec
        }
        .CompareChain(_, _, _, _, _) -> prec < JFMT_PREC_CMP
        .OrFallback(_, _, _, _, _) | .Pipe(_, _, _, _) -> prec <= JFMT_PREC_OR_FALLBACK
        .CallValue(_, _, _, _) -> prec <= JFMT_PREC_POSTFIX
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// True when a `{` sits at the group's own nesting depth, inside or outside a
// string literal. Brackets and inner parens hide their braces.
jfmt_grouping_has_open_brace: fn(f: JetFmt, span: Span) -> Bool Never! {
    depth := 0
    in_string := false
    escaped := false
    loop index in span.start + 1..<span.end - 1 {
        byte: Int.from_u8(f.src_bytes[index])
        if byte == 123 && depth == 0 -> return true
        if in_string {
            if byte == 34 && !escaped -> in_string = false
            escaped = !escaped && byte == 92
            next
        }
        if byte == 34 -> in_string = true
        if byte == 40 || byte == 91 -> depth += 1
        if byte == 41 || byte == 93 -> depth -= 1
    }
    false
}

// A pipe step that only calls a method on its `<>`, read once, written as
// that call on `previous` when `previous` already prints as a postfix
// operand; a `?? route` or operator line above keeps the step.
jfmt_pipe_step_joins: fn(step: PipeStep, previous: Expr) -> Expr? {
    if step.reads != 1 -> return None
    postfix: if previous == {
        .Ident(_, _, _) | .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .Field(_, _, _, _) | .Index(_, _, _, _, _) | .Paren(_, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    if !postfix -> return None
    if step.value == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) {
        if receiver == .Ident(name, _, _) {
            // copy: the joined call is a new expression; the pipe keeps its parts.
            if name == step.name -> return Val(Expr.MethodCall{receiver: previous.copy(), method: method.copy(), method_span: method_span, owner_type_args: owner_type_args.copy(), type_args: type_args.copy(), args: args.copy(), id: node})
        }
    }
    None
}

jfmt_fmt_value_loop: fn(f: &JetFmt, body: [Stmt], route_attached: Bool) {
    if body.len() == 0 -> return
    controller: body[0]
    if controller == {
        .For(var, _, var2, kind, inner, span, _, _, _) -> {
            jfmt_write(f, "loop ")
            jfmt_fmt_for_header(f, var, var2, kind)
            current := inner
            loop current.len() == 1 {
                nested := false
                if current[0] == .For(next_var, _, next_var2, next_kind, next_body, _, _, _, _) {
                    jfmt_write(f, ", ")
                    jfmt_fmt_for_header(f, next_var, next_var2, next_kind)
                    current = next_body
                    nested = true
                }
                if !nested -> break
            }
            jfmt_fmt_value_loop_body(f, current, span)
        }
        .CountedLoop(init, cond, step, inner, span, _, _) -> {
            jfmt_write(f, "loop ")
            jfmt_fmt_binding(f, init)
            jfmt_write(f, ", ")
            jfmt_fmt_expr(f, cond, JFMT_PREC_OR_FALLBACK)
            if step == .Val(step_stmt) {
                jfmt_write(f, ", ")
                jfmt_fmt_stmt(f, step_stmt)
            }
            jfmt_fmt_value_loop_body(f, inner, span)
        }
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> return
    }
    if route_attached && body.len() > 1 {
        route: body[body.len() - 1]
        jfmt_write(f, " ?? ")
        if route == {
            .BreakLabelValue(_, _, value, _) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
            .Return(value, _) -> {
                jfmt_write(f, "return")
                if value == .Val(returned) {
                    jfmt_write(f, " ")
                    jfmt_fmt_expr(f, returned, JFMT_PREC_OR_FALLBACK)
                }
            }
            .Expr(value) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
            .BreakLabel(name, _) -> jfmt_write(f, if jfmt_is_generated_label(name) -> "break" else -> "break({name})")
            .ContinueLabel(name, _) -> jfmt_write(f, if jfmt_is_generated_label(name) -> "next" else -> "next({name})")
            .Val(_) | .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
        }
    }
}

jfmt_fmt_for_header: fn(f: &JetFmt, var: String, var2: NamedSpan?, kind: ForKind) {
    // The bindingless form writes its subject bare.
    if !(var2 == None && var == "it") {
        if var2 != None -> jfmt_write(f, "(")
        jfmt_write(f, var)
        if var2 == .Val(second) {
            jfmt_write(f, ", ")
            jfmt_write(f, second.name)
            jfmt_write(f, ")")
        }
        jfmt_write(f, " in ")
    }
    if kind == {
        .Range(start, end, step, exclusive) -> {
            jfmt_fmt_expr(f, start, JFMT_PREC_OR_FALLBACK)
            jfmt_write(f, if exclusive -> "..<" else -> "..")
            jfmt_fmt_expr(f, end, JFMT_PREC_OR_FALLBACK)
            if step == .Val(step_expr) {
                jfmt_write(f, ", ")
                jfmt_fmt_expr(f, step_expr, JFMT_PREC_OR_FALLBACK)
            }
        }
        .In(collection, step) -> {
            jfmt_fmt_expr(f, collection, JFMT_PREC_OR_FALLBACK)
            if step == .Val(step_expr) {
                jfmt_write(f, ", ")
                jfmt_fmt_expr(f, step_expr, JFMT_PREC_OR_FALLBACK)
            }
        }
    }
}

// Rust `AST::is_subjectless_guard`: a `Stmt::Switch` with a compiler-private
// `true` subject at the `if` span.
jfmt_is_subjectless_guard: fn(subject: Expr, span: Span) -> Bool Never! {
    if subject == .Bool(value, subject_span, _) -> return value && jfmt_same_span(subject_span, span)
    false
}

// A loop body that is one subjectless single-arm guard prints as `if cond`;
// returns the statements that remain for the braces.
jfmt_guarded_loop_body: fn(f: &JetFmt, body: [Stmt], loop_span: Span?) -> [Stmt] {
    if body.len() != 1 -> return body.copy()
    if body[0] == .Switch(subject, arms, else_body, span) {
        if else_body != None -> return body.copy()
        if loop_span == .Val(required) {
            if !jfmt_same_span(span, required) -> return body.copy()
        }
        if !jfmt_is_subjectless_guard(subject, span) || arms.len() != 1 -> return body.copy()
        jfmt_write(f, " if ")
        jfmt_fmt_expr(f, arms[0].cond, JFMT_PREC_OR_FALLBACK)
        return arms[0].body.copy()
    }
    body.copy()
}

jfmt_fmt_value_loop_body: fn(f: &JetFmt, body: [Stmt], loop_span: Span) {
    statements: jfmt_guarded_loop_body(f, body, Val(loop_span))
    jfmt_write(f, " {{")
    jfmt_newline(f)
    f.indent += 1
    jfmt_fmt_block_stmts(f, statements)
    f.indent -= 1
    jfmt_newline(f)
    jfmt_write(f, "}}")
}

jfmt_fmt_collecting_loop: fn(f: &JetFmt, lambda: Lambda) {
    stmts := [Stmt]{}
    if lambda.body == .Block(block) -> stmts = block
    if stmts.len() == 0 -> return
    current := stmts[0]
    jfmt_write(f, "loop ")
    first_clause := true
    loop {
        if current == {
            .For(var, _, var2, kind, body, _, _, _, _) -> {
                if !first_clause -> jfmt_write(f, ", ")
                first_clause = false
                jfmt_fmt_for_header(f, var, var2, kind)
                if body.len() == 1 {
                    if body[0] == .For(_, _, _, _, _, _, _, _, _) {
                        current = body[0]
                        next
                    }
                }
                jfmt_fmt_collecting_body(f, body)
                break
            }
            .CountedLoop(init, cond, step, body, _, _, _) -> {
                jfmt_fmt_binding(f, init)
                jfmt_write(f, ", ")
                jfmt_fmt_expr(f, cond, JFMT_PREC_OR_FALLBACK)
                if step == .Val(step_stmt) {
                    jfmt_write(f, ", ")
                    jfmt_fmt_stmt(f, step_stmt)
                }
                jfmt_fmt_collecting_body(f, body)
                break
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> break
        }
    }
}

jfmt_fmt_collecting_body: fn(f: &JetFmt, body: [Stmt]) {
    statements: jfmt_guarded_loop_body(f, body, None)
    if statements.len() == 0 {
        jfmt_write(f, " -> {{}}")
        return
    }
    tail_value := Expr?{None}
    if statements[statements.len() - 1] == .Yield(yielded, _) -> tail_value = Val(yielded)
    value: tail_value ?? {
        jfmt_write(f, " -> {{}}")
        return
    }
    jfmt_write(f, " -> ")
    if statements.len() == 1 {
        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        return
    }
    jfmt_write(f, "{{")
    jfmt_newline(f)
    f.indent += 1
    loop index in 0..<statements.len() - 1 {
        jfmt_fmt_stmt(f, statements[index])
        jfmt_newline(f)
    }
    jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
    f.indent -= 1
    jfmt_newline(f)
    jfmt_write(f, "}}")
}

// Run `jfmt_fmt_block_stmts` with an indent and a trailing-comment limit
// (Rust `with_trailing_comment_limit(limit, with_indent(fmt_block_stmts))`).
jfmt_fmt_limited_block: fn(f: &JetFmt, statements: [Stmt], limit: Int) {
    previous: f.trailing_comment_limit
    if limit < previous -> f.trailing_comment_limit = limit
    f.indent += 1
    jfmt_fmt_block_stmts(f, statements)
    f.indent -= 1
    f.trailing_comment_limit = previous
}

jfmt_fmt_lambda: fn(f: &JetFmt, lambda: Lambda) {
    if jfmt_lambda_fn_form(f, lambda) -> return jfmt_fmt_fn_lambda(f, lambda)
    // Preserve the bare one-parameter spelling.
    bare_param: lambda.take_names.len() == 0 && lambda.params.len() == 1 && lambda.params[0].ty == None && lambda.span.start == lambda.params[0].name_span.start
    if !bare_param -> jfmt_write(f, "(")
    loop (index, param) in lambda.params {
        if index > 0 -> jfmt_write(f, ", ")
        jfmt_write(f, param.name)
        if param.ty == .Val(ty) {
            jfmt_write(f, ": {access_sigil(param.convention)}")
            jfmt_fmt_type(f, ty)
        }
    }
    if !bare_param -> jfmt_write(f, ")")
    if lambda.effects == .Val(effects) {
        jfmt_write(f, " -[")
        row_source: jfmt_source_effect_row_span_after(f, lambda.span.start)
        jfmt_fmt_effect_row(f, effects, row_source)
        jfmt_write(f, "]> ")
    } else {
        jfmt_write(f, " -> ")
    }
    if lambda.body == {
        .Expr(value) -> jfmt_fmt_expr(f, value, jfmt_prec_add_rhs(JFMT_PREC_OR_FALLBACK))
        .Block(statements) -> {
            saved_tail: jfmt_value_tail_begin(f, statements)
            // A lone statement written after `->` keeps its line, as an arm's
            // does: `(n: &Int) -> n += 1`.
            if jfmt_arm_body_was_braceless(f, statements) {
                mark: jfmt_mark(f)
                jfmt_fmt_stmt_inline(f, statements[0])
                if f.col <= JFMT_MAX_WIDTH && !jfmt_out_since_has_newline(f, mark.out_len) {
                    f.value_tail_at = saved_tail
                    return
                }
                jfmt_rollback(f, mark)
            }
            jfmt_write(f, "{{")
            jfmt_newline(f)
            jfmt_fmt_limited_block(f, statements, lambda.span.end)
            jfmt_end_block(f)
            f.value_tail_at = saved_tail
        }
    }
}

// Whether `lambda` is written `fn(…) {…}`.
jfmt_lambda_fn_form: fn(f: JetFmt, lambda: Lambda) -> Bool Never! {
    first: jfmt_first_token_at(f, lambda.span.start)
    first < f.source_toks.len() && f.source_toks[first].span.start == lambda.span.start && f.source_toks[first].kind == TOKEN_KW_FN
}

// `fn(params) interface {{ body }}`: the interface is written as a named
// function's, the unit failure contract before the effect row.
jfmt_fmt_fn_lambda: fn(f: &JetFmt, lambda: Lambda) {
    jfmt_write(f, "fn(")
    loop (index, param) in lambda.params {
        if index > 0 -> jfmt_write(f, ", ")
        jfmt_write(f, param.name)
        if param.ty == .Val(ty) {
            jfmt_write(f, ": ")
            jfmt_fmt_type(f, ty)
        }
    }
    jfmt_write(f, ")")
    unit_fallible: if lambda.result == .Val(ret) -> jfmt_is_unit_fallible_type(ret) else -> false
    if unit_fallible && lambda.result == .Val(ret) -> jfmt_fmt_unit_fallible_return(f, ret)
    if lambda.effects == .Val(effects) {
        jfmt_write(f, " -[")
        row_source: jfmt_source_effect_row_span_after(f, lambda.span.start)
        jfmt_fmt_effect_row(f, effects, row_source)
        jfmt_write(f, "]>")
    }
    if !unit_fallible && lambda.result == .Val(ret) {
        jfmt_write(f, if lambda.effects == None -> " -> " else -> " ")
        jfmt_fmt_type(f, ret)
    }
    statements: if lambda.body == .Block(body) -> body else -> [Stmt]{}
    // A one-line lambda of one value keeps its line: `fn(n) {{ n > 2 }}`.
    if statements.len() == 1 && !jfmt_source_span_multiline(f, lambda.span) && statements[0] == .Expr(value) {
        jfmt_write(f, " {{ ")
        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, " }}")
        return
    }
    jfmt_write(f, " {{")
    jfmt_newline(f)
    saved_tail: jfmt_value_tail_begin(f, statements)
    jfmt_fmt_limited_block(f, statements, lambda.span.end)
    f.value_tail_at = saved_tail
    jfmt_end_block(f)
}

jfmt_fmt_or_fallback: fn(f: &JetFmt, fallback: OrFallback) {
    if fallback == {
        .Value(value) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        .Block(body, value, _) -> {
            if value == .Val(tail) {
                jfmt_fmt_value_block(f, body, tail, false)
            } else {
                jfmt_write(f, "{{")
                jfmt_newline(f)
                f.indent += 1
                jfmt_fmt_block_stmts(f, body)
                f.indent -= 1
                jfmt_end_block(f)
            }
        }
        .Return(value, _) -> {
            jfmt_write(f, "return")
            if value == .Val(returned) {
                jfmt_write(f, " ")
                jfmt_fmt_expr(f, returned, JFMT_PREC_OR_FALLBACK)
            }
        }
        .Panic(_, args) -> {
            jfmt_write(f, "panic(")
            jfmt_fmt_call_args(f, args)
            jfmt_write(f, ")")
        }
        .Break(_) -> jfmt_write(f, "break")
        .Continue(_) -> jfmt_write(f, "next")
        .BreakLabel(name, _) -> jfmt_write(f, if jfmt_is_generated_label(name) -> "break" else -> "break({name})")
        .ContinueLabel(name, _) -> jfmt_write(f, if jfmt_is_generated_label(name) -> "next" else -> "next({name})")
    }
}

jfmt_slot_bind_name: fn(slot: PatSlot) -> String? Never! {
    if slot == .Bind(name, _) -> return Val(name)
    None
}

jfmt_fmt_pattern: fn(f: &JetFmt, pattern: Pattern) {
    if pattern == {
        .Variant(variant, bindings, leading_dot, _) -> {
            // Leading dot is canonical for variant patterns, except where the
            // dot means something: a dotless `None` and `Val(x)` test an
            // optional whatever the subject. Those keep their spelling
            // (jfmt_structure keeps the bit for them).
            if leading_dot || !jfmt_pattern_dot_means(variant) -> jfmt_write(f, ".")
            jfmt_write(f, variant)
            named := false
            loop slot in bindings {
                if slot == {
                    .Named(_, _, _) | .Rest(_) -> named = true
                    .Wildcard | .Bind(_, _) | .Range(_, _) | .Nested(_) | .Value(_) -> {}
                }
            }
            if named {
                // `field: field` prints as `field`.
                jfmt_write(f, "{{")
                loop (index, slot) in bindings {
                    if index > 0 -> jfmt_write(f, ", ")
                    if slot == .Named(field, _, inner) {
                        jfmt_write(f, field)
                        if (jfmt_slot_bind_name(inner) ?? "") != field {
                            jfmt_write(f, ": ")
                            jfmt_fmt_pat_slot(f, inner)
                        }
                    } else {
                        jfmt_fmt_pat_slot(f, slot)
                    }
                }
                jfmt_write(f, "}}")
            } else if bindings.len() > 0 {
                jfmt_write(f, "(")
                loop (index, slot) in bindings {
                    if index > 0 -> jfmt_write(f, ", ")
                    jfmt_fmt_pat_slot(f, slot)
                }
                jfmt_write(f, ")")
            }
        }
        .Present(binding, _, inner, _) -> jfmt_fmt_payload_pattern(f, "Val", binding, inner)
        .Ok(binding, _, inner, _) -> jfmt_fmt_payload_pattern(f, "Ok", binding, inner)
        .Err(binding, _, inner, _) -> jfmt_fmt_payload_pattern(f, "Err", binding, inner)
        .Absent(_) -> jfmt_write(f, ".None")
        // Range pattern at arm-head level.
        .Range(lo, hi, _) -> jfmt_write(f, "{lo}..{hi}")
        // Or-pattern `A(x) | B(x)`.
        .Or(alternatives, _) -> {
            loop (index, alternative) in alternatives {
                if index > 0 -> jfmt_write(f, " | ")
                jfmt_fmt_pattern(f, alternative)
            }
        }
        // Struct-shaped dispatch arm head.
        .Struct(fields, rest, _, type_head) -> {
            if type_head == .Val(head) -> jfmt_write(f, head.name)
            jfmt_write(f, "{{")
            loop (index, field) in fields {
                if index > 0 -> jfmt_write(f, ", ")
                if field == {
                    .Bind(name, _, local, _) -> {
                        jfmt_write(f, name)
                        if name != local {
                            jfmt_write(f, ": ")
                            jfmt_write(f, local)
                        }
                    }
                    .Value(name, _, value) -> {
                        jfmt_write(f, name)
                        jfmt_write(f, ": ")
                        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
                    }
                    .Nested(name, _, inner) -> {
                        jfmt_write(f, name)
                        jfmt_write(f, ": ")
                        jfmt_fmt_pattern(f, inner)
                    }
                }
            }
            if rest != None {
                if fields.len() > 0 -> jfmt_write(f, ", ")
                jfmt_write(f, "..")
            }
            jfmt_write(f, "}}")
        }
        .List(items, rest, _) -> {
            jfmt_write(f, "[")
            loop (index, item) in items {
                if index > 0 -> jfmt_write(f, ", ")
                jfmt_fmt_pat_slot(f, item)
            }
            if rest == .Val(tail) {
                if items.len() > 0 -> jfmt_write(f, ", ")
                jfmt_write(f, "..")
                if tail.name == .Val(name) -> jfmt_write(f, name.name)
            }
            jfmt_write(f, "]")
        }
        .Map(entries, rest, _) -> {
            jfmt_write(f, "[")
            if entries.len() == 0 && rest == None -> jfmt_write(f, ":")
            loop (index, entry) in entries {
                if index > 0 -> jfmt_write(f, ", ")
                jfmt_fmt_expr(f, entry.key, JFMT_PREC_OR_FALLBACK)
                if entry.optional -> jfmt_write(f, "?")
                jfmt_write(f, ": ")
                jfmt_fmt_pat_slot(f, entry.slot)
            }
            if rest != None {
                if entries.len() > 0 -> jfmt_write(f, ", ")
                jfmt_write(f, "..")
            }
            jfmt_write(f, "]")
        }
        // An interpolation literal used as a pattern.
        .StrMatch(parts, span) -> {
            typed_head: jfmt_is_typed_head_body(f, span)
            jfmt_fmt_str_match_parts(f, parts, typed_head)
        }
        // `[U8]{"…"}` binary pattern.
        .BinMatch(parts, _) -> jfmt_fmt_bin_match_parts(f, parts)
    }
}

jfmt_fmt_payload_pattern: fn(f: &JetFmt, head: String, binding: String, inner: Pattern?) {
    jfmt_write(f, ".{head}(")
    if inner == .Val(nested) {
        jfmt_fmt_pattern(f, nested)
    } else {
        jfmt_write(f, binding)
    }
    jfmt_write(f, ")")
}

// One variant payload slot.
jfmt_fmt_pat_slot: fn(f: &JetFmt, slot: PatSlot) {
    if slot == {
        .Bind(name, _) -> jfmt_write(f, name)
        .Wildcard -> jfmt_write(f, "_")
        .Range(lo, hi) -> jfmt_write(f, "{lo}..{hi}")
        .Nested(inner) -> jfmt_fmt_pattern(f, inner)
        .Value(value) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        .Named(field, _, inner) -> {
            jfmt_write(f, field)
            jfmt_write(f, ": ")
            jfmt_fmt_pat_slot(f, inner)
        }
        .Rest(_) -> jfmt_write(f, "..")
    }
}

jfmt_hex2: fn(value: Int) -> String Never! {
    digits: "0123456789ABCDEF".bytes()
    bytes: [U8]{digits[(value /% 16) % 16], digits[value % 16]}
    String.from_bytes(bytes) ?? "00"
}

// Retain byte escapes in the canonical `[U8]{"..."}` form.
jfmt_fmt_byte_text_parts: fn(f: &JetFmt, parts: [ByteTextPart]) Never! {
    jfmt_write(f, "\"")
    loop part in parts {
        if part == {
            .Lit(text) -> jfmt_write(f, jfmt_escape_str_lit(text))
            .Byte(value) -> jfmt_write(f, "\\x{jfmt_hex2(Int.from_u8(value))}")
        }
    }
    jfmt_write(f, "\"")
}

jfmt_escape_binary_lit: fn(bytes: [U8]) -> String Never! {
    out := [U8]{}
    loop byte in bytes {
        if {
            byte == 34 -> {
                out.push(U8{92})
                out.push(U8{34})
            }
            byte == 92 -> {
                out.push(U8{92})
                out.push(U8{92})
            }
            byte == 10 -> {
                out.push(U8{92})
                out.push(U8{110})
            }
            byte == 9 -> {
                out.push(U8{92})
                out.push(U8{116})
            }
            byte == 123 || byte == 125 -> {
                out.push(byte)
                out.push(byte)
            }
            byte >= 32 && byte <= 126 -> out.push(byte)
            else -> {
                loop escaped in "\\x{jfmt_hex2(Int.from_u8(byte))}".bytes() -> out.push(escaped)
            }
        }
    }
    String.from_bytes(out) ?? ""
}

// A `BinMatchPart` list as `[U8]{"…"}`.
jfmt_fmt_bin_match_parts: fn(f: &JetFmt, parts: [BinMatchPart]) Never! {
    jfmt_write(f, "[U8]{{\"")
    loop part in parts {
        if part == {
            .Lit(bytes) -> jfmt_write(f, jfmt_escape_binary_lit(bytes))
            .Hole(name, spec, _) -> {
                jfmt_write(f, "{{{name}:")
                if spec == {
                    .Rest -> jfmt_write(f, "...")
                    .Bits(width, endian) -> {
                        jfmt_write(f, "U{width}")
                        if endian == {
                            .Big -> jfmt_write(f, "be")
                            .Little -> jfmt_write(f, "le")
                            .Unspecified -> {}
                        }
                    }
                }
                jfmt_write(f, "}}")
            }
        }
    }
    jfmt_write(f, "\"}}")
}

// A `StrMatchPart` list renders like a format literal plus a
// `:Type` suffix on typed holes.
jfmt_fmt_str_match_parts: fn(f: &JetFmt, parts: [StrMatchPart], raw_head: Bool) {
    if raw_head -> jfmt_write(f, "String{{")
    jfmt_write(f, "\"")
    loop part in parts {
        if part == {
            .Lit(text) -> jfmt_write(f, if raw_head -> jfmt_escape_typed_head_single_line(text) else -> jfmt_escape_str_lit(text))
            .Hole(name, ty, _) -> {
                jfmt_write(f, "{{{name}")
                if ty == .Val(hole_type) {
                    jfmt_write(f, ":")
                    jfmt_fmt_type(f, hole_type)
                }
                jfmt_write(f, "}}")
            }
        }
    }
    jfmt_write(f, "\"")
    if raw_head -> jfmt_write(f, "}}")
}

// Only an explicit `String{"…"}` pattern body owns backslashes.
jfmt_is_typed_head_body: fn(f: JetFmt, span: Span) -> Bool Never! {
    jfmt_src_valid(f, span.start, span.end) && jfmt_bytes_starts_at(f.src_bytes, span.start, "String")
}

// A bare pattern string whose source holds a `{…}` hole that is not a bare
// name, optionally typed.
jfmt_str_match_has_computed_hole: fn(f: JetFmt, span: Span) -> Bool Never! {
    if !jfmt_src_valid(f, span.start, span.end) -> return false
    bytes: f.src_bytes
    index := span.start
    loop index < span.end {
        if bytes[index] != 123 {
            index += 1
            next
        }
        if index + 1 < span.end && bytes[index + 1] == 123 {
            index += 2
            next
        }
        cursor := index + 1
        loop cursor < span.end && bytes[cursor] != 125 && bytes[cursor] != 58 {
            byte: bytes[cursor]
            name_byte: (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
            if !name_byte -> return true
            cursor += 1
        }
        if cursor == index + 1 -> return true
        loop cursor < span.end && bytes[cursor] != 125 -> cursor += 1
        index = cursor + 1
    }
    false
}

jfmt_fmt_call: fn(f: &JetFmt, call: Call) {
    jfmt_write(f, call.name)
    // `#code { items }` is its item block alone (parser_parse_code_value).
    if call.name == "#code" && call.args.len() == 1 {
        jfmt_fmt_template_block(f, call.args[0])
        return
    }
    jfmt_fmt_call_type_args(f, call.type_args, call.name_span.end)
    jfmt_fmt_call_args_with_template(f, call.args, Val(call.name_span.end))
}

// Call-site type arguments `<T, …>`.
jfmt_fmt_call_type_args: fn(f: &JetFmt, type_args: [Type], start: Int) {
    if type_args.len() == 0 -> return
    jfmt_write(f, "<")
    type_source: jfmt_source_list_span_after(f, start, JFMT_DELIM_ANGLE)
    jfmt_fmt_type_list(f, type_args, type_source, Span{start: 0, end: 0})
    jfmt_write(f, ">")
}

jfmt_fmt_spawn_body: fn(f: &JetFmt, lambda: Lambda) {
    if lambda.body == {
        .Expr(value) -> jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        .Block(statements) -> {
            jfmt_write(f, "{{")
            jfmt_newline(f)
            f.indent += 1
            jfmt_fmt_block_stmts(f, statements)
            f.indent -= 1
            jfmt_end_block(f)
        }
    }
}

// Restore the one-word task surface
// from its compiler-private method-call form.
jfmt_fmt_task_surface_method: fn(f: &JetFmt, method: String, args: [CallArg]) -> Bool {
    if method == jfmt_internal_name("jet.task.timeout") && args.len() == 1 {
        jfmt_write(f, "task.timeout")
        jfmt_fmt_method_args(f, "timeout", args, None)
        return true
    }
    if method == jfmt_internal_name("jet.task.spawn") {
        if args.len() != 1 -> return false
        lambda: jfmt_lambda_of(args[0].expr) ?? return false
        if lambda.params.len() > 0 -> return false
        jfmt_write(f, "task ")
        loop taken in lambda.take_names {
            jfmt_write(f, "&&")
            jfmt_write(f, taken.name)
            jfmt_write(f, " ")
        }
        if lambda.body == .Expr(value) {
            // `task expr` and `task { expr }` fold to one node; ask the source.
            if jfmt_value_was_braced(f, value) {
                jfmt_write(f, "{{")
                if !jfmt_try_inline_value_block(f, [Stmt]{}, value) {
                    jfmt_newline(f)
                    previous: f.trailing_comment_limit
                    if lambda.span.end < previous -> f.trailing_comment_limit = lambda.span.end
                    f.indent += 1
                    jfmt_emit_leading(f, jfmt_expr_start(value))
                    jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
                    jfmt_emit_trailing(f, expr_span(value).end)
                    f.indent -= 1
                    f.trailing_comment_limit = previous
                    jfmt_end_block(f)
                }
                return true
            }
        }
        jfmt_fmt_spawn_body(f, lambda)
        return true
    }
    selector: if {
        method == jfmt_internal_name("jet.task.all") -> "all"
        method == jfmt_internal_name("jet.task.race") -> "race"
        method == jfmt_internal_name("jet.task.any") -> "any"
        else -> ""
    }
    if selector == "" || args.len() != 1 -> return false
    branches := [Expr]{}
    names := [String]{}
    named := false
    if args[0].expr == {
        .ListLit(elements, _, _) -> branches = elements
        .TupleLit(fields, _, _, _) -> {
            named = true
            loop field in fields {
                names.push(field.name)
                branches.push(field.value)
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
    jfmt_write(f, "task.{selector} {{")
    loop (index, branch) in branches {
        if index > 0 -> jfmt_write(f, ", ")
        if named {
            jfmt_write(f, names[index])
            jfmt_write(f, ": ")
        }
        if branch == .MethodCall(receiver, spawn_method, _, _, _, spawn_args, _) {
            if receiver == .Ident(receiver_name, _, _) {
                if receiver_name == jfmt_internal_name("jet.task") && spawn_method == jfmt_internal_name("jet.task.spawn") && spawn_args.len() == 1 {
                    if spawn_args[0].expr == .Lambda(lambda, _) {
                        jfmt_fmt_spawn_body(f, lambda)
                        next
                    }
                }
            }
        }
        jfmt_fmt_expr(f, branch, JFMT_PREC_OR_FALLBACK)
    }
    jfmt_write(f, "}}")
    true
}

jfmt_fmt_method_args: fn(f: &JetFmt, method: String, args: [CallArg], source_start: Int?) {
    jfmt_fmt_view_or_call_args(f, method, args, source_start)
}

// `view(a..b)` keeps its range spelling.
jfmt_fmt_view_or_call_args: fn(f: &JetFmt, method: String, args: [CallArg], source_start: Int?) {
    if method == "view" && args.len() == 2 {
        jfmt_write(f, "(")
        jfmt_fmt_expr(f, args[0].expr, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, "..")
        jfmt_fmt_expr(f, args[1].expr, JFMT_PREC_OR_FALLBACK)
        jfmt_write(f, ")")
        return
    }
    jfmt_fmt_call_args_with_template(f, args, source_start)
}

jfmt_fmt_call_args_with_template: fn(f: &JetFmt, args: [CallArg], source_start: Int?) {
    // A typed template rides as a hidden final argument.
    template := CallArg?{None}
    if args.len() > 0 {
        last: args[args.len() - 1]
        if last.flags.template_items != None -> template = Val(last)
    }
    call_args := args
    if template != None -> _ := call_args.pop()
    source := JetFmtSourceList?{None}
    if source_start == .Val(start) -> source = jfmt_source_list_span_after(f, start, JFMT_DELIM_PAREN)
    // A final `fn` lambda hugs the parentheses when everything else in the
    // list sits on the call's line: `xs.map(fn(n) {` … `})`.
    hug: call_args.len() > 0 && jfmt_hugs_fn_lambda(f, call_args[call_args.len() - 1], source)
    mark: jfmt_mark(f)
    jfmt_write(f, "(")
    multiline: !hug && jfmt_comma_begin(f, call_args.len(), source)
    last_start := mark.out_len
    loop (index, arg) in call_args {
        jfmt_comma_before(f, index, multiline, arg.span.start)
        if index == call_args.len() - 1 -> last_start = f.out.len()
        jfmt_fmt_call_arg(f, arg)
        jfmt_comma_after(f, multiline, arg.span.end)
    }
    jfmt_comma_end(f, multiline, source)
    // A nested lambda/body can break a one-line call; choose the expanded
    // argument layout now so the first pass is stable.
    hugged: hug && !jfmt_bytes_have_newline(f.out, mark.out_len, last_start)
    if !multiline && !hugged && jfmt_out_since_has_newline(f, mark.out_len) {
        jfmt_rollback(f, mark)
        jfmt_write(f, "(")
        jfmt_fmt_call_args_multiline(f, call_args, source)
    }
    jfmt_write(f, ")")
    if template == .Val(template_arg) -> jfmt_fmt_template_block(f, template_arg)
}

// A typed template's ` { items }` block.
jfmt_fmt_template_block: fn(f: &JetFmt, template_arg: CallArg) {
    jfmt_write(f, " {{")
    jfmt_newline(f)
    f.indent += 1
    if template_arg.flags.template_items == .Val(items) -> jfmt_fmt_derive_body_items(f, items)
    f.indent -= 1
    jfmt_emit_leading(f, template_arg.span.end)
    if !f.at_line_start -> jfmt_newline(f)
    jfmt_write(f, "}}")
}

// Whether `arg` is a `fn` lambda that can hug its call's parentheses: no
// label, and nothing between the list's `(` and the lambda, or after it,
// starts a new line or holds a comment.
jfmt_hugs_fn_lambda: fn(f: JetFmt, arg: CallArg, source: JetFmtSourceList?) -> Bool Never! {
    if arg.label != None || arg.spread -> return false
    lambda: jfmt_lambda_of(arg.expr) ?? return false
    if !jfmt_lambda_fn_form(f, lambda) -> return false
    list: source ?? return true
    !jfmt_source_span_multiline(f, Span{start: list.span.start, end: lambda.span.start}) && !jfmt_source_span_multiline(f, Span{start: lambda.span.end, end: list.close_start})
}

jfmt_fmt_call_args_multiline: fn(f: &JetFmt, args: [CallArg], source: JetFmtSourceList?) {
    if args.len() > 0 -> jfmt_newline(f)
    f.indent += 1
    loop (index, arg) in args {
        if index > 0 -> jfmt_newline(f)
        jfmt_emit_leading(f, arg.span.start)
        jfmt_fmt_call_arg(f, arg)
        jfmt_write(f, ",")
        jfmt_emit_trailing(f, arg.span.end)
    }
    if source == .Val(list) -> jfmt_emit_leading(f, list.close_start)
    f.indent -= 1
    if !f.at_line_start -> jfmt_newline(f)
}

jfmt_fmt_call_args: fn(f: &JetFmt, args: [CallArg]) {
    loop (index, arg) in args {
        if index > 0 -> jfmt_write(f, ", ")
        jfmt_fmt_call_arg(f, arg)
    }
}

jfmt_fmt_call_arg: fn(f: &JetFmt, arg: CallArg) {
    // Calls are plain: a parameter's mark lives in the signature. Under
    // `#Policy(writes: .Explicit)` a written `&`/`&&` stays (CallArg.mark).
    // `f(...xs)` call spread.
    if arg.spread -> jfmt_write(f, "...")
    // S61: the call-site argument label `name:`.
    if arg.label == .Val(label) {
        jfmt_write(f, label.name)
        jfmt_write(f, ": ")
    }
    if arg.mark == .Val(mark) -> jfmt_write(f, if mark.access == PlaceAccess.Take -> "&&" else -> "&")
    jfmt_fmt_expr(f, arg.expr, JFMT_PREC_OR_FALLBACK)
}

jfmt_fmt_str_raw: fn(f: &JetFmt, parts: [StrPart]) {
    text := ""
    loop part in parts {
        literal: jfmt_str_part_lit(part) ?? {
            jfmt_fmt_str(f, parts)
            return
        }
        text = "{text}{literal}"
    }
    if text.len() == 0 {
        jfmt_fmt_str(f, parts)
        return
    }
    max_run := 0
    run := 0
    any_other := false
    loop byte in text.bytes() {
        if byte == 96 {
            run += 1
            if run > max_run -> max_run = run
        } else {
            run = 0
        }
        if byte != 32 -> any_other = true
    }
    fence := ""
    loop _ in 0..<max_run + 1 -> fence = "{fence}`"
    padded: text.starts_with(" ") && text.ends_with(" ") && any_other
    jfmt_write(f, fence)
    if padded -> jfmt_write(f, " ")
    jfmt_write(f, text)
    if padded -> jfmt_write(f, " ")
    jfmt_write(f, fence)
}

// The parser expands `{expr=}` to Lit(label) + Lit(" = ") +
// Interp; reprint the surface form. Returns true when parts[i..i+3] matched.
jfmt_fmt_debug_interp: fn(f: &JetFmt, parts: [StrPart], index: Int) -> Bool {
    if index + 2 >= parts.len() -> return false
    if jfmt_str_part_lit(parts[index]) == None -> return false
    if (jfmt_str_part_lit(parts[index + 1]) ?? "") != " = " -> return false
    if parts[index + 2] == .Interp(value, format) {
        jfmt_write(f, "{{")
        f.interp_depth += 1
        jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
        f.interp_depth -= 1
        jfmt_write(f, "=")
        jfmt_fmt_str_format(f, format, parts, index + 3)
        jfmt_write(f, "}}")
        return true
    }
    false
}

jfmt_str_part_lit: fn(part: StrPart) -> String? Never! {
    if part == .Lit(text) -> return Val(text)
    None
}

jfmt_lambda_of: fn(expr: Expr) -> Lambda? Never! {
    // copy: `lambda` is a payload of read parameter `expr`, which keeps the original; the Val carrier owns this one
    if expr == .Lambda(lambda, _) -> return Val(lambda.copy())
    None
}

// `next` is the index of the part after this one, which holds the computed
// selector number when it is a StrFormat.Count part.
jfmt_fmt_interp: fn(f: &JetFmt, value: Expr, format: StrFormat, parts: [StrPart], next: Int) {
    jfmt_write(f, "{{")
    f.interp_depth += 1
    jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
    f.interp_depth -= 1
    jfmt_fmt_str_format(f, format, parts, next)
    jfmt_write(f, "}}")
}

jfmt_fmt_str: fn(f: &JetFmt, parts: [StrPart]) {
    jfmt_write(f, "\"")
    index := 0
    loop index < parts.len() {
        if jfmt_fmt_debug_interp(f, parts, index) {
            index += 3
            next
        }
        if parts[index] == {
            .Lit(text) -> jfmt_write(f, jfmt_escape_str_lit(text))
            .Interp(value, format) -> if format != .Count -> jfmt_fmt_interp(f, value, format, parts, index + 1)
            .Byte(value) -> jfmt_write(f, "\\x{jfmt_hex2(Int.from_u8(value))}")
        }
        index += 1
    }
    jfmt_write(f, "\"")
}

// Typed head bodies preserve written backslashes.
jfmt_fmt_typed_head_str: fn(f: &JetFmt, parts: [StrPart], span: Span) {
    if {
        jfmt_src_valid(f, span.start, span.end) && jfmt_bytes_starts_at(f.src_bytes, span.start, "`") -> jfmt_fmt_str_raw(f, parts)
        jfmt_src_valid(f, span.start, span.start + 3) && jfmt_bytes_starts_at(f.src_bytes, span.start, "\"\"\"") -> jfmt_fmt_typed_head_str_multiline(f, parts)
        else -> {
            jfmt_write(f, "\"")
            jfmt_fmt_typed_head_str_parts(f, parts)
            jfmt_write(f, "\"")
        }
    }
}

jfmt_fmt_typed_head_str_parts: fn(f: &JetFmt, parts: [StrPart]) {
    index := 0
    loop index < parts.len() {
        if jfmt_fmt_debug_interp(f, parts, index) {
            index += 3
            next
        }
        if parts[index] == {
            .Lit(text) -> jfmt_write(f, jfmt_escape_typed_head_single_line(text))
            .Interp(value, format) -> if format != .Count -> jfmt_fmt_interp(f, value, format, parts, index + 1)
            .Byte(value) -> jfmt_write(f, "\\x{jfmt_hex2(Int.from_u8(value))}")
        }
        index += 1
    }
}

jfmt_fmt_typed_head_str_multiline: fn(f: &JetFmt, parts: [StrPart]) {
    jfmt_write(f, "\"\"\"")
    jfmt_newline(f)
    index := 0
    loop index < parts.len() {
        if jfmt_fmt_debug_interp(f, parts, index) {
            index += 3
            next
        }
        if parts[index] == {
            .Lit(text) -> {
                loop (line_index, line) in text.split("\n").to_list() {
                    if line_index > 0 -> jfmt_newline(f)
                    jfmt_write(f, jfmt_escape_typed_head_lit(line))
                }
            }
            .Interp(value, format) -> if format != .Count -> jfmt_fmt_interp(f, value, format, parts, index + 1)
            .Byte(value) -> jfmt_write(f, "\\x{jfmt_hex2(Int.from_u8(value))}")
        }
        index += 1
    }
    jfmt_newline(f)
    jfmt_write(f, "\"\"\"")
}

// A StrFormat.Count part prints inside the selector before it.
jfmt_fmt_str_format: fn(f: &JetFmt, format: StrFormat, parts: [StrPart], next: Int) {
    if format == {
        .Display | .Count -> {}
        .Debug -> jfmt_write(f, ":Debug")
        .Pretty -> jfmt_write(f, ":Pretty")
        .Fixed(digits) -> jfmt_fmt_selector_number(f, ":Fixed(", digits, parts, next, ")")
        .Grouped(digits) -> jfmt_fmt_selector_number(f, ":Grouped(", digits, parts, next, ")")
        .Hex(digits) -> jfmt_fmt_selector_number(f, ":Hex(", digits, parts, next, ")")
        .Pad(width, fill) -> {
            jfmt_fmt_selector_number(f, ":Pad(", width, parts, next, "")
            if fill.len() > 0 -> jfmt_write(f, ", \"{jfmt_escape_str_lit(fill)}\"")
            jfmt_write(f, ")")
        }
        .PadLeft(width, fill) -> {
            jfmt_fmt_selector_number(f, ":PadLeft(", width, parts, next, "")
            if fill.len() > 0 -> jfmt_write(f, ", \"{jfmt_escape_str_lit(fill)}\"")
            jfmt_write(f, ")")
        }
        .Sci(digits) -> jfmt_fmt_selector_number(f, ":Sci(", digits, parts, next, ")")
        .Percent(digits) -> jfmt_fmt_selector_number(f, ":Percent(", digits, parts, next, ")")
        .Bin -> jfmt_write(f, ":Bin")
        .Oct -> jfmt_write(f, ":Oct")
        .Unit(style) -> {
            if style == {
                .Symbol -> {}
                .Name -> jfmt_write(f, ":Unit(name)")
                .Bare -> jfmt_write(f, ":Unit(bare)")
            }
        }
    }
}

// A selector's number: the computed expression of the Count part at `next`,
// else the literal.
jfmt_fmt_selector_number: fn(f: &JetFmt, open: String, literal: Int, parts: [StrPart], next: Int, close: String) {
    jfmt_write(f, open)
    if next < parts.len() {
        if parts[next] == .Interp(count, .Count) {
            f.interp_depth += 1
            jfmt_fmt_expr(f, count, JFMT_PREC_OR_FALLBACK)
            f.interp_depth -= 1
            jfmt_write(f, close)
            return
        }
    }
    jfmt_write(f, "{literal}{close}")
}

// S70 re-emit a triple-quoted string at the current indent, so
// re-lexing strips exactly the prefix the closing `"""` sets.
jfmt_fmt_str_multiline: fn(f: &JetFmt, parts: [StrPart]) {
    jfmt_write(f, "\"\"\"")
    jfmt_newline(f)
    index := 0
    loop index < parts.len() {
        if jfmt_fmt_debug_interp(f, parts, index) {
            index += 3
            next
        }
        if parts[index] == {
            .Lit(text) -> {
                loop (line_index, line) in text.split("\n").to_list() {
                    if line_index > 0 -> jfmt_newline(f)
                    if line.len() > 0 -> jfmt_write(f, jfmt_escape_str_multiline(line))
                }
            }
            .Interp(value, format) -> if format != .Count -> jfmt_fmt_interp(f, value, format, parts, index + 1)
            .Byte(value) -> jfmt_write(f, "\\x{jfmt_hex2(Int.from_u8(value))}")
        }
        index += 1
    }
    jfmt_newline(f)
    jfmt_write(f, "\"\"\"")
}

jfmt_escape_typed_head_lit: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        out.push(byte)
        if byte == 123 || byte == 125 -> out.push(byte)
    }
    String.from_bytes(out) ?? text
}

// Single-line typed bodies keep written slashes; a quote still needs a
// preceding slash so it is not the closer.
jfmt_escape_typed_head_single_line: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if {
            byte == 34 && !(out.len() > 0 && out[out.len() - 1] == 92) -> {
                out.push(U8{92})
                out.push(U8{34})
            }
            byte == 123 || byte == 125 -> {
                out.push(byte)
                out.push(byte)
            }
            else -> out.push(byte)
        }
    }
    String.from_bytes(out) ?? text
}
