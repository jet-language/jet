//RS 
//RS /// One member of a struct or enum body, tagged with where the author wrote it.
//RS ///
//RS /// The parser splits a type body into parallel vectors — `fields`,
//RS /// `cli_bindings`, `trait_impls`, `methods`, `validate_block` — which erases the
//RS /// authored interleaving. Printing those vectors back to back rewrites every
//RS /// program that did not happen to use that order: a `fn` written before an
//RS /// `impl Trait { … }` block comes back out after it. `emit_leading` consumes
//RS /// comments in ascending-offset order, so the same reordering additionally hands
//RS /// each comment to whichever member happens to be printing at the time. Rethread
//RS /// the vectors into one source-ordered list before printing.
//RS #[derive(Clone, Copy)]
//RS enum TypeBodyMember<'b> {
//RS     State(&'b StateDecl),
//RS     Field(&'b Field),
//RS     CLIBinding(&'b crate::AST::CLICommandBinding),
//RS     TraitImpl(&'b TraitImplBlock),
//RS     Method(&'b Func),
//RS     /// D-VALIDATE1 (card #506): `validate { … }`, keyed by its `validate` keyword.
//RS     Validate {
//RS         start: usize,
//RS         body: &'b [crate::AST::Stmt],
//RS     },
//RS }
//RS 
//RS impl TypeBodyMember<'_> {
//RS     /// The member's leftmost authored offset. Every arm names a span *inside*
//RS     /// the member, so the keys rise exactly as the source does — a field's or
//RS     /// binding's markers, a method's `fn`, and a block's `impl` keyword all sit
//RS     /// between the previous member and the span used here, and no two members
//RS     /// can share a start.
//RS     fn start(&self) -> usize {
//RS         match self {
//RS             Self::State(state) => state.span.start,
//RS             Self::Field(field) => field.name_span.start,
//RS             Self::CLIBinding(binding) => binding.name_span.start,
//RS             Self::TraitImpl(block) => block.trait_span.start,
//RS             Self::Method(method) => method.span.start,
//RS             Self::Validate { start, .. } => *start,
//RS         }
//RS     }
//RS 
//RS     /// Data declarations stack on adjacent lines; anything carrying a body is
//RS     /// set off from its neighbour by a blank line.
//RS     fn is_compact(&self) -> bool {
//RS         matches!(self, Self::Field(_))
//RS     }
//RS }
//RS 
//RS /// One member of an `impl` body, tagged with where the author wrote it. Same
//RS /// split-vector hazard as `TypeBodyMember`: D-LIB2 `type Name = Concrete` rows
//RS /// live in `assoc_type_impls`, methods in `methods`.
