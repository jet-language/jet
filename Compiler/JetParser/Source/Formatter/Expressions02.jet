// Canonical: Expressions.jet::jet_format_if_expr.

// Rust: crates/jet-parser/src/Formatter/Expressions.rs:74
struct JetFormatResultHandlerParts {
    pub subject: Expr
    pub ok_binding: String
    pub ok_body: [Stmt]
    pub ok_value: Expr
    pub err_binding: String
    pub err_body: [Stmt]
    pub err_value: Expr
}
fn jet_format_result_handler_parts(context: &JetFormatterContext, expr: Expr) -> JetFormatResultHandlerParts? Never! {
    if expr == .If(cond, then_body, then_value, _, else_value, _) {
        if cond == .PatternTest(subject, pattern, _) && pattern == .Ok(binding, _, _, _) {
            if else_value == .If(err_cond, err_body, err_value, _, terminal, _) {
                if err_cond == .PatternTest(_, err_pattern, _) && err_pattern == .Err(err_binding, _, _, _) {
                    if terminal != .NoElse(_) -> return None
                    source :: jet_format_source_slice(&context, jet_format_expr_start(expr), expr_span(expr).end) ?? return None
                    question :: source.find("?")
                    if question < 0 -> return None
                    if !source.slice(question + 1, source.len()).contains("!") -> return None
                    return Val(JetFormatResultHandlerParts{
                        subject: subject, ok_binding: binding, ok_body: then_body,
                        ok_value: then_value, err_binding: err_binding,
                        err_body: err_body, err_value: err_value,
                    })
                }
            }
        }
    }
    None
}

// Rust: crates/jet-parser/src/Formatter/Expressions.rs:145
// Canonical: Expressions.jet::jet_format_result_handler_branch_inlineable.
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:159
fn jet_format_result_handler_compact_source(context: &JetFormatterContext, expr: Expr) -> Bool Never! {
    start :: jet_format_expr_start(expr)
    end :: jet_format_result_handler_source_end(&context, expr)
    source :: jet_format_source_slice(&context, start, end) ?? return false
    !jet_format_span_has_comment(&context, start, end)
}
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:167
// Canonical: Expressions.jet::jet_format_is_result_handler_source.
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:171
// Canonical: Expressions.jet::jet_format_result_handler_branch_start.
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:181
// Canonical: Expressions.jet::jet_format_result_handler_branch_end.
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:208
// Canonical: Expressions.jet::jet_format_result_handler_comments_end.
// Rust: crates/jet-parser/src/Formatter/Expressions.rs:220
fn jet_format_result_handler_source_end(context: &JetFormatterContext, expr: Expr) -> Int Never! {
    if expr == .If(_, _, _, _, else_value, _) {
        if else_value == .If(cond, _, _, _, _, _) {
            start :: jet_format_result_handler_branch_start(&context, expr_span(cond).end)
            return jet_format_result_handler_branch_end(&context, start, expr_span(expr).end)
        }
    }
    expr_span(expr).end
}
