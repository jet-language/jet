//RS     /// True when `a` denotes the dispatch subject: either the `it` placeholder
//RS     /// or an expression with byte-for-byte the same source text as `subject`.
//RS     ///
//RS     /// The slice has to begin at `expr_start`, never at `span().start`: an
//RS     /// anchor span cuts the receiver off the front, so an arm head `other.code`
//RS     /// and a bare `code` subject both read as `code` — and the arm then prints
//RS     /// with its `other.` deleted, because a matching subject is elided from the
//RS     /// table. The right edge is still the anchor's end, which truncates a call's
//RS     /// argument list, so two heads differing only inside those parens still
//RS     /// compare equal.
//RS     fn same_dispatch_subject(&self, a: &Expr, subject: &Expr) -> bool {
//RS         if let Expr::Ident(name, _) = a {
//RS             if name == Syntax::KW_IT {
//RS                 return true;
//RS             }
//RS         }
//RS         if a.span() == subject.span() {
//RS             return true;
//RS         }
//RS         let a_src = self.src.get(Self::expr_start(a)..a.span().end);
//RS         let subj_src = self.src.get(Self::expr_start(subject)..subject.span().end);
//RS         matches!((a_src, subj_src), (Some(x), Some(y)) if x == y)
//RS     }
