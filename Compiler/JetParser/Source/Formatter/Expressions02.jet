// Expression formatter continuation. Existing printers remain canonical in Expressions.jet;
// their source items are reused here rather than defining competing formatter APIs.
use jet_foundation.[Expr, Stmt, expr_span]

// Rust: crates/jet-parser/src/Formatter/Expressions.rs:10
// Canonical: Expressions.jet::jet_format_struct_lit_head_is_redundant.
