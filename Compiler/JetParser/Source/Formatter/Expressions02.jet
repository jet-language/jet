//RS     /// The offset of an expression's first source byte.
//RS     ///
//RS     /// `Expr::span` is a diagnostic *anchor*, not an extent: `Expr::Field`
//RS     /// carries the member name's span, `Expr::MethodCall` the method name's,
//RS     /// `Expr::CallValue` the argument parens'. Asking which token precedes an
//RS     /// expression therefore has to start from its real left edge — descend the
//RS     /// leftmost operand until a node whose own span already leads. `min` keeps
//RS     /// the answer right for the nodes whose span does cover their operand.
//RS     pub(super) fn expr_start(expr: &Expr) -> usize {
//RS         let own = expr.span().start;
//RS         let leftmost = match expr {
//RS             Expr::Field(base, ..)
//RS             | Expr::MemberSpread { base, .. }
//RS             | Expr::OptField { base, .. }
//RS             | Expr::Index { base, .. }
//RS             | Expr::Slice { base, .. } => Some(base.as_ref()),
//RS             Expr::MethodCall { receiver, .. } => Some(receiver.as_ref()),
//RS             Expr::CallValue { callee, .. } => Some(callee.as_ref()),
//RS             Expr::Binary(_, lhs, _, _) => Some(lhs.as_ref()),
//RS             Expr::CompareChain { operands, .. } => operands.first(),
//RS             Expr::Range { start, .. } => Some(start.as_ref()),
//RS             Expr::Deref(inner, _) | Expr::Try(inner, ..) => Some(inner.as_ref()),
//RS             Expr::OrFallback { value, .. } => Some(value.as_ref()),
//RS             Expr::PatternTest { subject, .. } => Some(subject.as_ref()),
//RS             _ => None,
//RS         };
//RS         leftmost.map_or(own, |child| own.min(Self::expr_start(child)))
//RS     }
