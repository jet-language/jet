//RS     /// Preserve `head -> statement` when the author chose that shape and the
//RS     /// rendered arm still fits the width limit. Braced and multiline bodies
//RS     /// keep their explicit scope. Add concise braces when the next leading-dot
//RS     /// arm would otherwise parse as a chain on an expression body; direct
//RS     /// returns already provide an unambiguous arm boundary.
//RS     fn fmt_arm_body(&mut self, body: &[Stmt], force_braces: bool) {
//RS         if body.is_empty() {
//RS             self.write(" {}");
//RS             return;
//RS         }
//RS         let was_braceless = self.arm_body_was_braceless(body);
//RS         // A direct return is already a complete arm boundary. Keeping it
