//RS     /// S68 (D-SG2): render an `if`/`while` condition without wrapping the
//RS     /// outermost expression in redundant parens. Precedence-required parens on
//RS     /// nested sub-expressions are preserved by the normal `fmt_expr` rules.
//RS     pub(super) fn fmt_cond(&mut self, cond: &Expr) {
//RS         // A condition is its own statement slot, so it imposes no binding
//RS         // requirement: render at the lowest precedence so the outermost
//RS         // operator never gains redundant parens (precedence-required parens on
//RS         // nested sub-expressions are still added by `fmt_expr`).
//RS         self.fmt_expr(cond, Prec::OrFallback);
//RS     }
//RS 
