// Pretty-printer for Jet source: a 1:1 port of the Rust formatter driver. One
// true style: 4-space indent, same-line `{`, spaces around binary operators,
// line-boundary statement terminators. Comments are preserved from the source
// and re-attached by span. Rust `impl Fmt` methods are free `jfmt_<name>(f:
// &JetFmt, …)` functions; Expressions.jet, Statements.jet and Items.jet hold
// the other Rust modules.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        AppliedRuleApplication,
        BinOp,
        Diagnostic,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        Expr,
        FencedStatement,
        Func,
        ImportDecl,
        Item,
        MARKER_HTML,
        MARKER_NO_PRELUDE,
        MARKER_TARGET,
        Marker,
        PolicyDeclaration,
        Program,
        RuleSite,
        Span,
        Stmt,
        SwitchArm,
        TextEdit,
        Type,
        expr_span,
        name_start,
        type_name,
    ]
    jet_lexer.[
        TOKEN_BLOCK_COMMENT,
        TOKEN_COMMA,
        TOKEN_EOF,
        TOKEN_GT,
        TOKEN_IDENT,
        TOKEN_KW_PRIV,
        TOKEN_LBRACE,
        TOKEN_LBRACKET,
        TOKEN_LINE_COMMENT,
        TOKEN_LPAREN,
        TOKEN_LT,
        TOKEN_MINUS,
        TOKEN_RBRACE,
        TOKEN_RBRACKET,
        TOKEN_RPAREN,
        TOKEN_SEMI,
        TOKEN_SHR,
        TOKEN_UNIFIED_ARROW,
        Token,
        lex,
        lex_generated,
    ]
}

JFMT_INDENT: 4
// The width floor (gate d) for keeping a body on one line.
JFMT_MAX_WIDTH: 100
// Rust `usize::MAX`: no trailing-comment limit.
JFMT_NO_LIMIT: 9223372036854775807

// Rust `Prec`, ordered loosest to tightest.
JFMT_PREC_OR_FALLBACK: 0
JFMT_PREC_RANGE: 1
JFMT_PREC_OR: 2
JFMT_PREC_AND: 3
JFMT_PREC_CMP: 4
JFMT_PREC_BIT_OR: 5
JFMT_PREC_BIT_AND: 7
JFMT_PREC_SHIFT: 8
JFMT_PREC_ADD: 9
JFMT_PREC_MUL: 10
JFMT_PREC_UNARY: 11
JFMT_PREC_POSTFIX: 13
JFMT_PREC_PRIMARY: 14

// Rust `SourceDelimiter`.
JFMT_DELIM_PAREN: 0
JFMT_DELIM_BRACKET: 1
JFMT_DELIM_BRACE: 2
JFMT_DELIM_ANGLE: 3

JetFmtComment: struct {
    text: String
    span: Span
}

JetFmt: struct {
    src: String
    src_bytes: [U8]
    // Byte offsets of every `\n` in `src`, for Rust `line_of`.
    newlines: [Int]
    source_toks: [Token]
    comments: [JetFmtComment]
    comment_i: Int
    out: [U8]
    col: Int
    at_line_start: Bool
    indent: Int
    pending_blank: Bool
    // Exclusive source boundary for trailing comments while formatting a
    // nested construct, so an inner statement never claims a comment that
    // trails its enclosing expression on the same line.
    trailing_comment_limit: Int
    items: [Item]
    policy_declarations: [PolicyDeclaration]
    // This rule authored forms corresponding to expanded AST statements.
    fenced_statements: [FencedStatement]
    simplify: Bool
    // The return type supplies the expected type for a direct returned
    // literal; `--simplify` may then drop a redundant named `Type.` head.
    expected_return_type: Type?
    // Keep a marked statement's control body scoped.
    force_control_braces: Bool
    // `#Allow(…)` and unregistered markers that prefix one statement, and an
    // unregistered marker written as a value: the parser keeps them only as
    // Statement- and Expression-site rule rows.
    inline_rules: [AppliedRuleApplication]{[AppliedRuleApplication]{}}
    // The names a pipe's first step reads in place (its head's name), which
    // that step writes as `<>` while it prints.
    pipe_names: [String]{[String]{}}
    // How many interpolation holes (`"…{value}…"`) the writer is inside; a
    // hole's value never breaks across lines.
    interp_depth: Int{0}
    // Census mode (`jet_format_redundant_grouping`): author grouping parens
    // the printed precedence does not need are left out, their spans kept.
    drop_grouping: Bool{false}
    dropped_grouping: [Span]{[Span]{}}
    // The source edits that spell each `place = place op value` the
    // formatter printed as `place op= value` the same way
    // (jfmt_fmt_expanded_compound), for the check that a format keeps
    // meaning.
    compound_rewrites: [TextEdit]{[TextEdit]{}}
    // The index of the `}` token that closes each `{` token of
    // `source_toks`, -1 for any other token (jfmt_brace_closes).
    brace_closes: [Int]{[Int]{}}
    // How many one-line trials are in progress, and where the outermost
    // began in `out` (jfmt_one_line_trial_begin).
    one_line_trials: Int{0}
    one_line_trial_start: Int{0}
    // Where the last line of a callable body with a value starts, else -1
    // (jfmt_value_tail_begin).
    value_tail_at: Int{-1}
    // True while printing an `if` condition, where a `{` opens the body,
    // so a named payload keeps `.Value(value: x)` (jfmt_fmt_cond).
    in_condition: Bool{false}
    // Where in `out` the expression statement being written starts, else -1
    // (jfmt_expr_stmt_begin). A line that opens with `.Name{` or
    // `.Name(…) {` is a scope member, so a named payload there keeps its
    // parens.
    stmt_head_at: Int{-1}
}

// Rust `Option<(Span, usize)>` from `source_list_span_after`.
JetFmtSourceList: struct {
    span: Span
    close_start: Int
}

// Rust `Option<(usize, usize)>` from `single_stmt_braces`/`value_block_braces`.
JetFmtBraces: struct {
    open: Int
    close: Int
}

// The saved writer state every Rust rollback restores.
JetFmtMark: struct {
    out_len: Int
    col: Int
    at_line_start: Bool
    pending_blank: Bool
    comment_i: Int
}

// Rust `Result<String, Vec<Diagnostic>>` from `format_source_with_options`.
// `structure_change` says why a formatted text was refused because it would
// not mean what the source means (Structure.jet); that is a formatter defect,
// never a problem in the source, so it carries no diagnostic.
JetFormatResult: struct {
    ok: Bool
    text: String
    diagnostics: [Diagnostic]
    structure_change: String?{None}
}

// ---- Prec ----

jfmt_prec_of_bin: fn(op: BinOp) -> Int Never! {
    if op == {
        .Or -> JFMT_PREC_OR
        .And -> JFMT_PREC_AND
        .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare -> JFMT_PREC_CMP
        .BitOr -> JFMT_PREC_BIT_OR
        // Exclusive-or and power print as method calls (jfmt_bin_op_method).
        .BitXor | .Pow -> JFMT_PREC_POSTFIX
        .BitAnd -> JFMT_PREC_BIT_AND
        .Shl | .Shr -> JFMT_PREC_SHIFT
        .Add | .Sub -> JFMT_PREC_ADD
        .Mul | .Div | .FloorDiv | .Mod | .Rem -> JFMT_PREC_MUL
    }
}

jfmt_prec_add_rhs: fn(prec: Int) -> Int Never! {
    if {
        prec == JFMT_PREC_OR_FALLBACK -> JFMT_PREC_OR_FALLBACK
        prec >= JFMT_PREC_PRIMARY -> JFMT_PREC_PRIMARY
        else -> prec + 1
    }
}

// Rust `BinOp::spell`. Power and exclusive-or have no infix spelling: they
// are the `pow` and `bit_xor` methods (jfmt_bin_op_method).
jfmt_bin_op_spell: fn(op: BinOp) -> String Never! {
    if op == {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .FloorDiv -> "/%"
        .Mod -> "%"
        .Rem -> "%%"
        .Pow -> "pow"
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "bit_xor"
        .Shl -> "<<"
        .Shr -> ">>"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Gt -> ">"
        .Le -> "<="
        .Ge -> ">="
        .Compare -> "<=>"
        .And -> "&&"
        .Or -> "||"
    }
}

// The method that spells an operator with no infix form.
jfmt_bin_op_method: fn(op: BinOp) -> String? Never! {
    if op == {
        .Pow -> Val("pow")
        .BitXor -> Val("bit_xor")
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .BitAnd | .BitOr | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> None
    }
}

jfmt_compound_spell: fn(op: BinOp) -> String Never! {
    if op == {
        .Add -> "+="
        .Sub -> "-="
        .Mul -> "*="
        .Div -> "/="
        .FloorDiv -> "/%="
        .Mod -> "%="
        .Rem -> "%%="
        .BitAnd -> "&="
        .BitOr -> "|="
        .Shl -> "<<="
        .Shr -> ">>="
        .Pow | .BitXor | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> ""
    }
}

// ---- byte/text helpers ----

jfmt_bytes_text: fn(bytes: [U8], start: Int, end: Int) -> String Never! {
    if start < 0 || end > bytes.len() || start > end -> return ""
    String.from_bytes(bytes[start..<end]) ?? ""
}

// Rust `self.src.get(start..end)`: the source text of a byte span, "" when
// the span is out of range.
jfmt_src_text: fn(f: JetFmt, start: Int, end: Int) -> String Never! {
    jfmt_bytes_text(f.src_bytes, start, end)
}

// Rust `src.get(start..end).is_some()`.
jfmt_src_valid: fn(f: JetFmt, start: Int, end: Int) -> Bool Never! {
    start >= 0 && start <= end && end <= f.src_bytes.len()
}

jfmt_bytes_starts_at: fn(bytes: [U8], at: Int, needle: String) -> Bool Never! {
    pattern: needle.bytes()
    if at < 0 || at + pattern.len() > bytes.len() -> return false
    loop index in 0..<pattern.len() {
        if bytes[at + index] != pattern[index] -> return false
    }
    true
}

// Rust `bytes[..end].rfind(needle)`: the last start offset, -1 when absent.
jfmt_bytes_rfind: fn(bytes: [U8], end: Int, needle: String) -> Int Never! {
    width: needle.bytes().len()
    limit: if end > bytes.len() -> bytes.len() else -> end
    at := limit - width
    loop at >= 0 {
        if jfmt_bytes_starts_at(bytes, at, needle) -> return at
        at -= 1
    }
    -1
}

// Rust `bytes[start..].find(needle)` as an absolute offset, -1 when absent.
jfmt_bytes_find: fn(bytes: [U8], start: Int, needle: String) -> Int Never! {
    width: needle.bytes().len()
    at := if start < 0 -> 0 else -> start
    loop at + width <= bytes.len() {
        if jfmt_bytes_starts_at(bytes, at, needle) -> return at
        at += 1
    }
    -1
}

jfmt_bytes_have_newline: fn(bytes: [U8], start: Int, end: Int) -> Bool Never! {
    if start < 0 || end > bytes.len() -> return false
    loop index in start..<end {
        if bytes[index] == 10 -> return true
    }
    false
}

// Rust `char::is_whitespace` over a source range. Non-ASCII whitespace
// (NBSP, U+2028, …) is checked by its UTF-8 lead bytes.
jfmt_src_all_whitespace: fn(f: JetFmt, start: Int, end: Int) -> Bool Never! {
    text: jfmt_src_text(f, start, end)
    text.trim().len() == 0
}

// The number of chars in `text` (Rust `s.chars().count()`).
jfmt_char_count: fn(text: String) -> Int Never! {
    count := 0
    loop byte in text.bytes() {
        if byte < 128 || byte >= 192 -> count += 1
    }
    count
}

// A compiler-private name: a NUL byte followed by `suffix`.
jfmt_internal_name: fn(suffix: String) -> String Never! {
    bytes := [U8]{U8{0}}
    loop byte in suffix.bytes() -> bytes.push(byte)
    String.from_bytes(bytes) ?? suffix
}

// Rust `line_of`: the zero-based line holding byte `pos`.
jfmt_line_of: fn(f: JetFmt, pos: Int) -> Int Never! {
    low := 0
    high := f.newlines.len()
    loop low < high {
        middle: (low + high) /% 2
        if f.newlines[middle] < pos {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low
}

// Rust `partition_point(|token| token.span.start < start)`.
jfmt_first_token_at: fn(f: JetFmt, start: Int) -> Int Never! {
    low := 0
    high := f.source_toks.len()
    loop low < high {
        middle: (low + high) /% 2
        if f.source_toks[middle].span.start < start {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low
}

jfmt_is_comment_kind: fn(kind: Int) -> Bool Never! {
    kind == TOKEN_LINE_COMMENT || kind == TOKEN_BLOCK_COMMENT
}

// The privacy word the author wrote directly before a member name: `priv `
// (`priv step: fn…`), `priv(package) ` (`priv(package) width: fn…`), else
// nothing.
jfmt_source_privacy_before: fn(f: JetFmt, name_start: Int) -> String Never! {
    code := [Token]{}
    index := jfmt_first_token_at(f, name_start) - 1
    loop index >= 0 && code.len() < 4 {
        token: f.source_toks[index]
        if !jfmt_is_comment_kind(token.kind) -> code.push(token.copy())
        index -= 1
    }
    if code.len() > 0 && code[0].kind == TOKEN_KW_PRIV -> return "priv "
    if code.len() < 4 || code[0].kind != TOKEN_RPAREN || code[1].kind != TOKEN_IDENT || code[2].kind != TOKEN_LPAREN || code[3].kind != TOKEN_KW_PRIV -> return ""
    if jfmt_src_text(f, code[1].span.start, code[1].span.end) == "package" -> "priv(package) " else -> ""
}

jfmt_is_generated_label: fn(name: String) -> Bool Never! {
    name.starts_with("__jet_")
}

// ---- inline eligibility ----

// May this statement render inline inside a one-line brace body? Only
// non-block statements qualify.
jfmt_is_simple_stmt: fn(stmt: Stmt) -> Bool Never! {
    if stmt == {
        // Bare `return` stays multiline: `{ return }` is not a recoverable parse.
        .Return(value, _) -> value != None
        .Expr(expr) -> jfmt_is_simple_expr(expr)
        .Val(binding) -> jfmt_is_simple_expr(binding.init)
        .Assign(_, _, _, _) -> true
        .Break(_) -> true
        .Continue(_) -> true
        .BreakLabel(_, _) -> true
        .ContinueLabel(_, _) -> true
        .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .BreakValue(_, _) | .BreakLabelValue(_, _, _, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> false
    }
}

jfmt_is_simple_expr: fn(expr: Expr) -> Bool Never! {
    if expr == .CallValue(callee, _, _, _) {
        if callee == .Lambda(lambda, _) {
            return !(lambda.meta.collecting_loop || lambda.meta.result_loop)
        }
    }
    true
}

// ---- spans of statements and items ----

jfmt_stmt_start: fn(stmt: Stmt) -> Int Never! {
    if stmt == {
        .Expr(expr) -> expr_span(expr).start
        .DeferClose(_, span) -> span.start
        .Val(binding) -> binding.name_span.start
        .Assign(target, _, _, _) -> {
            if target == {
                .Local(_, name_span) -> name_span.start
                .Index(_, _, span, _) -> span.start
                .Field(base, _, _) -> expr_span(base).start
            }
        }
        .Return(_, span) -> span.start
        .Yield(_, span) -> span.start
        .While(_, _, span, _, _) -> span.start
        .For(_, _, _, _, _, span, _, _, _) -> span.start
        .Switch(_, _, _, span) -> span.start
        .Break(span) -> span.start
        .Continue(span) -> span.start
        .BreakLabel(_, span) -> span.start
        .ContinueLabel(_, span) -> span.start
        .BreakValue(_, span) -> span.start
        .BreakLabelValue(_, _, _, span) -> span.start
        .Loop(_, span, _, _) -> span.start
        .CountedLoop(_, _, _, _, span, _, _) -> span.start
        .Unsafe(_, _, _, span) -> span.start
        .Impure(_, _, _, span) -> span.start
        .Reactive(_, span) -> span.start
        .Shield(_, span) -> span.start
        .Switched(_, _, span) -> span.start
        .Region(_, _, _, span) -> span.start
        .Policy(_, _, span) -> span.start
        .TaskGroup(_, _, _, _, span) -> span.start
        .Layout(_, _, _, span) -> span.start
        .AuthorityScope(_, _, _, _, span) -> span.start
        .ComptimeBlock(_, _, span) -> span.start
        .ComptimeIf(_, _, _, _, span, _) -> span.start
        .ComptimeSwitch(_, _, _, span) -> span.start
        .ContextBlock(_, _, span) -> span.start
        .Live(_, span) -> span.start
        .ScopeMember(_, _, _, _, _, _, _, span) -> span.start
        .AssumeDet(_, _, _, span) -> span.start
        .Transact(_, _, _, _, span) -> span.start
    }
}

jfmt_body_end: fn(body: [Stmt], fallback: Int) -> Int Never! {
    if body.len() == 0 -> return fallback
    jfmt_stmt_end(body[body.len() - 1])
}

jfmt_stmt_end: fn(stmt: Stmt) -> Int Never! {
    if stmt == {
        .Expr(expr) -> expr_span(expr).end
        .DeferClose(_, span) -> span.end
        .Val(binding) -> expr_span(binding.init).end
        .Assign(_, _, _, value) -> expr_span(value).end
        .Return(value, span) -> {
            if value == .Val(inner) -> return expr_span(inner).end
            span.end
        }
        .Yield(value, _) -> expr_span(value).end
        .While(_, body, _, _, _) -> jfmt_body_end(body, 0)
        .For(_, _, _, _, body, _, _, _, _) -> jfmt_body_end(body, 0)
        .Switch(_, arms, else_body, _) -> {
            if else_body == .Val(body) {
                if body.len() > 0 -> return jfmt_stmt_end(body[body.len() - 1])
            }
            if arms.len() == 0 -> return 0
            last: arms[arms.len() - 1]
            jfmt_body_end(last.body, last.span.end)
        }
        .Break(span) -> span.end
        .Continue(span) -> span.end
        .BreakLabel(_, span) -> span.end
        .ContinueLabel(_, span) -> span.end
        .BreakValue(value, _) -> expr_span(value).end
        .BreakLabelValue(_, _, value, _) -> expr_span(value).end
        .CountedLoop(_, _, _, body, span, _, _) -> jfmt_body_end(body, span.end)
        .Loop(body, span, _, _) -> jfmt_body_end(body, span.end)
        .Unsafe(_, _, body, span) -> jfmt_body_end(body, span.end)
        .Impure(_, _, body, span) -> jfmt_body_end(body, span.end)
        .Reactive(body, span) -> jfmt_body_end(body, span.end)
        .Shield(body, span) -> jfmt_body_end(body, span.end)
        .Switched(_, body, span) -> jfmt_body_end(body, span.end)
        .Region(_, _, body, span) -> jfmt_body_end(body, span.end)
        .Policy(_, body, span) -> jfmt_body_end(body, span.end)
        .TaskGroup(_, _, _, body, span) -> jfmt_body_end(body, span.end)
        .Layout(_, _, body, span) -> jfmt_body_end(body, span.end)
        .AuthorityScope(_, _, _, body, span) -> jfmt_body_end(body, span.end)
        .ComptimeBlock(body, _, span) -> jfmt_body_end(body, span.end)
        .ComptimeIf(_, _, then_body, else_body, span, _) -> {
            if else_body == .Val(body) {
                if body.len() > 0 -> return jfmt_stmt_end(body[body.len() - 1])
            }
            jfmt_body_end(then_body, span.end)
        }
        .ComptimeSwitch(_, _, _, span) -> span.end
        .ContextBlock(_, body, span) -> jfmt_body_end(body, span.end)
        .Live(body, span) -> jfmt_body_end(body, span.end)
        .ScopeMember(_, _, _, _, body, _, _, span) -> jfmt_body_end(body, span.end)
        .AssumeDet(_, _, body, span) -> jfmt_body_end(body, span.end)
        .Transact(_, _, body, _, span) -> jfmt_body_end(body, span.end)
    }
}

jfmt_rfind_or: fn(f: JetFmt, end: Int, needle: String, fallback: Int) -> Int Never! {
    found: jfmt_bytes_rfind(f.src_bytes, end, needle)
    if found < 0 -> fallback else -> found
}

// Where `keyword` starts when only blanks separate it from `at`, else `at`:
// `impl Shape {` starts at `impl`, the method sugar `Shape.area: fn` at
// its name.
jfmt_keyword_before: fn(f: JetFmt, at: Int, keyword: String) -> Int Never! {
    end := if at > f.src_bytes.len() -> f.src_bytes.len() else -> at
    loop end > 0 {
        byte: Int.from_u8(f.src_bytes[end - 1])
        if byte != 32 && byte != 9 && byte != 10 && byte != 13 -> break
        end -= 1
    }
    width: keyword.bytes().len()
    if end >= width && jfmt_bytes_starts_at(f.src_bytes, end - width, keyword) -> end - width else -> at
}

jfmt_item_span_start: fn(f: JetFmt, item: Item) -> Int Never! {
    if item == {
        // A declaration starts at its name (`area: fn`, `Point: struct`): the
        // kind word follows the name.
        .Func(function) -> function.name_span.start
        .Struct(definition) -> definition.name_span.start
        .Enum(definition) -> definition.name_span.start
        .Impl(definition) -> jfmt_keyword_before(f, definition.type_span.start, "impl")
        .Const(constant) -> {
            if constant.is_persist -> return jfmt_rfind_or(f, constant.name_span.start, "#Persist", constant.name_span.start)
            if constant.attrs.len() > 0 {
                // Only a storage marker can sit in front of a
                // constant's name.
                found: jfmt_bytes_rfind(f.src_bytes, constant.name_span.start, "#Static")
                if found >= 0 -> return found
                return jfmt_rfind_or(f, constant.name_span.start, "#Inline", constant.name_span.start)
            }
            constant.name_span.start
        }
        .Test(test) -> jfmt_rfind_or(f, test.name_span.start, "#Test", test.name_span.start)
        .ExternRust(block) -> jfmt_rfind_or(f, block.crate_span.start, "extern", block.span.start)
        .Trait(definition) -> definition.name_span.start
        .Tag(definition) -> definition.span.start
        .EffectDecl(declaration) -> declaration.span.start
        .MarkerDecl(declaration) -> declaration.span.start
        .FactDecl(declaration) -> declaration.span.start
        .Module(decl) -> decl.name_span.start
        .CModule(decl) -> decl.span.start
        .CodeModule(decl) -> decl.name_span.start
        .Distinct(definition) -> definition.span.start
        .TypeAlias(definition) -> definition.span.start
        .UnitFamily(definition) -> definition.span.start
        .ErrorConv(definition) -> jfmt_rfind_or(f, definition.from_span.start, "impl", definition.from_span.start)
        .Migration(declaration) -> declaration.span.start
        .ProtocolDecl(declaration) -> declaration.span.start
        .TemplateLoop(looped) -> looped.span.start
        .GenericModule(decl) -> decl.span.start
        .ModuleAlias(decl) -> decl.span.start
    }
}

jfmt_methods_end: fn(methods: [Func]) -> Int? Never! {
    if methods.len() == 0 -> return None
    last: methods[methods.len() - 1]
    Val(jfmt_body_end(last.body, last.name_span.end))
}

jfmt_item_span_end: fn(item: Item) -> Int Never! {
    if item == {
        .Func(function) -> jfmt_body_end(function.body, function.name_span.end)
        .Struct(definition) -> {
            if jfmt_methods_end(definition.methods) == .Val(end) -> return end
            if definition.fields.len() > 0 -> return definition.fields[definition.fields.len() - 1].ty_span.end
            definition.name_span.end
        }
        .Enum(definition) -> {
            if jfmt_methods_end(definition.methods) == .Val(end) -> return end
            if definition.variants.len() > 0 -> return definition.variants[definition.variants.len() - 1].name_span.end
            definition.name_span.end
        }
        .Impl(definition) -> jfmt_methods_end(definition.methods) ?? definition.type_span.end
        .Const(constant) -> expr_span(constant.value).end
        .Test(test) -> jfmt_body_end(test.body, test.name_span.end)
        .ExternRust(block) -> block.span.end
        .Trait(definition) -> {
            if definition.methods.len() > 0 -> return definition.methods[definition.methods.len() - 1].span.end
            definition.name_span.end
        }
        .Tag(definition) -> definition.span.end
        .EffectDecl(declaration) -> declaration.span.end
        .MarkerDecl(declaration) -> declaration.span.end
        .FactDecl(declaration) -> declaration.span.end
        .Module(decl) -> decl.span.end
        .CModule(decl) -> decl.span.end
        .CodeModule(decl) -> decl.span.end
        .Distinct(definition) -> definition.span.end
        .TypeAlias(definition) -> definition.span.end
        .UnitFamily(definition) -> definition.span.end
        // Body_span.end is after the closing `}`.
        .ErrorConv(definition) -> definition.body_span.end
        .Migration(declaration) -> declaration.span.end
        .ProtocolDecl(declaration) -> declaration.span.end
        .TemplateLoop(looped) -> looped.span.end
        .GenericModule(decl) -> decl.span.end
        .ModuleAlias(decl) -> decl.span.end
    }
}

// ---- literal spellings ----

jfmt_digit_value: fn(byte: U8) -> Int Never! {
    value: Int.from_u8(byte)
    if {
        value >= 48 && value <= 57 -> value - 48
        value >= 97 && value <= 122 -> value - 87
        value >= 65 && value <= 90 -> value - 55
        else -> 99
    }
}

// Rust `i64::from_str_radix` / `str::parse::<i64>` on `digits[start..]`.
jfmt_parse_radix: fn(digits: [U8], start: Int, radix: Int, allow_sign: Bool) -> Int? Never! {
    index := start
    negative := false
    if allow_sign && index < digits.len() && (digits[index] == 43 || digits[index] == 45) {
        negative = digits[index] == 45
        index += 1
    }
    if index >= digits.len() -> return None
    value := 0
    loop index < digits.len() {
        digit: jfmt_digit_value(digits[index])
        if digit >= radix -> return None
        if negative {
            if value < (-9223372036854775807 - 1 + digit) /% radix -> return None
            value = value * radix - digit
        } else {
            if value > (9223372036854775807 - digit) /% radix -> return None
            value = value * radix + digit
        }
        index += 1
    }
    Val(value)
}

// S34/S67: re-emit an integer literal exactly as the author spelled it
// (radix prefix, digit separators, hex case). Falls back to plain decimal
// when the source slice doesn't round-trip to the same value.
jfmt_int_literal_spelling: fn(f: JetFmt, span: Span, value: Int, raw: String?) -> String Never! {
    if raw == .Val(text) -> return text
    if !jfmt_src_valid(f, span.start, span.end) -> return "{value}"
    slice: jfmt_src_text(f, span.start, span.end)
    cleaned := [U8]{}
    loop byte in slice.bytes() {
        if byte != 95 -> cleaned.push(byte)
    }
    parsed := Int?{None}
    prefixed: cleaned.len() >= 2 && cleaned[0] == 48
    if {
        prefixed && (cleaned[1] == 120 || cleaned[1] == 88) -> parsed = jfmt_parse_radix(cleaned, 2, 16, false)
        prefixed && (cleaned[1] == 111 || cleaned[1] == 79) -> parsed = jfmt_parse_radix(cleaned, 2, 8, false)
        prefixed && (cleaned[1] == 98 || cleaned[1] == 66) -> parsed = jfmt_parse_radix(cleaned, 2, 2, false)
        else -> parsed = jfmt_parse_radix(cleaned, 0, 10, true)
    }
    if parsed == .Val(number) {
        if number == value -> return slice
    }
    "{value}"
}

// S34/S67: a source float keeps its raw spelling; sema-created floats use the
// canonical numeric formatter.
jfmt_float_literal_spelling: fn(value: Float, raw: String?) -> String Never! {
    if raw == .Val(text) -> return text
    jfmt_fmt_float(value)
}

// Rust `fmt_float`: `{:.1}` for a finite integral value, else `{}`.
jfmt_fmt_float: fn(value: Float) -> String Never! {
    text: "{value}"
    if value == value && value - value == 0.0 && !text.contains(".") && !text.contains("e") && !text.contains("E") -> return "{text}.0"
    text
}

jfmt_fmt_char: fn(value: String) -> String Never! {
    if value.bytes().len() == 1 && value.bytes()[0] == 13 -> return "'\\r'"
    if value == {
        "'" -> "'\\''"
        "\\" -> "'\\\\'"
        "\n" -> "'\\n'"
        "\t" -> "'\\t'"
        else -> "'{value}'"
    }
}

// Escape one content line of a triple-quoted string (S70): only `\` and the
// interpolation braces need escaping.
jfmt_escape_str_multiline: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if {
            byte == 92 -> {
                out.push(byte)
                out.push(byte)
            }
            byte == 123 || byte == 125 -> {
                out.push(byte)
                out.push(byte)
            }
            else -> out.push(byte)
        }
    }
    String.from_bytes(out) ?? text
}

jfmt_escape_str_lit: fn(text: String) -> String Never! {
    out := [U8]{}
    loop byte in text.bytes() {
        if {
            byte == 92 -> {
                out.push(U8{92})
                out.push(U8{92})
            }
            byte == 10 -> {
                out.push(U8{92})
                out.push(U8{110})
            }
            byte == 9 -> {
                out.push(U8{92})
                out.push(U8{116})
            }
            byte == 13 -> {
                out.push(U8{92})
                out.push(U8{114})
            }
            byte == 34 -> {
                out.push(U8{92})
                out.push(U8{34})
            }
            byte == 123 || byte == 125 -> {
                out.push(byte)
                out.push(byte)
            }
            else -> out.push(byte)
        }
    }
    String.from_bytes(out) ?? text
}

// ---- writer ----

jfmt_write: fn(f: &JetFmt, text: String) Never! {
    if f.at_line_start && text.len() > 0 -> jfmt_write_indent(f)
    f.col += jfmt_char_count(text)
    f.at_line_start = false
    loop byte in text.bytes() -> f.out.push(byte)
    f.pending_blank = false
}

// Where in `out` the next write starts: a line's indent is written with its
// first text.
jfmt_write_at: fn(f: JetFmt) -> Int Never! {
    if f.at_line_start -> f.out.len() + f.indent * JFMT_INDENT else -> f.out.len()
}

// Marks the start of the expression statement about to be written
// (stmt_head_at) and returns the enclosing mark, which the caller restores
// once the statement is written.
jfmt_expr_stmt_begin: fn(f: &JetFmt) -> Int Never! {
    saved: f.stmt_head_at
    f.stmt_head_at = jfmt_write_at(f)
    saved
}

jfmt_write_indent: fn(f: &JetFmt) Never! {
    loop _ in 0..<f.indent {
        loop _ in 0..<JFMT_INDENT -> f.out.push(U8{32})
    }
    f.col = f.indent * JFMT_INDENT
    f.at_line_start = false
}

jfmt_newline: fn(f: &JetFmt) Never! {
    f.out.push(U8{10})
    f.col = 0
    f.at_line_start = true
}

jfmt_end_block: fn(f: &JetFmt) Never! {
    jfmt_newline(f)
    jfmt_write(f, "}}")
}

jfmt_mark: fn(f: JetFmt) -> JetFmtMark Never! {
    JetFmtMark{out_len: f.out.len(), col: f.col, at_line_start: f.at_line_start, pending_blank: f.pending_blank, comment_i: f.comment_i}
}

jfmt_truncate: fn(f: &JetFmt, length: Int) Never! {
    loop f.out.len() > length -> _ := f.out.pop()
}

jfmt_rollback: fn(f: &JetFmt, mark: JetFmtMark) Never! {
    jfmt_truncate(f, mark.out_len)
    f.col = mark.col
    f.at_line_start = mark.at_line_start
    f.pending_blank = mark.pending_blank
    f.comment_i = mark.comment_i
}

// Rust `self.out[out_len..].contains('\n')`.
jfmt_out_since_has_newline: fn(f: JetFmt, out_len: Int) -> Bool Never! {
    jfmt_bytes_have_newline(f.out, out_len, f.out.len())
}

jfmt_out_ends_with: fn(f: JetFmt, text: String) -> Bool Never! {
    pattern: text.bytes()
    if pattern.len() > f.out.len() -> return false
    jfmt_bytes_starts_at(f.out, f.out.len() - pattern.len(), text)
}

jfmt_out_text: fn(f: JetFmt) -> String Never! {
    String.from_bytes(f.out) ?? ""
}

// ---- comments and separators ----

jfmt_write_loop_continuation_indent: fn(f: &JetFmt) Never! {
    f.indent += 1
    jfmt_write_indent(f)
    f.indent -= 1
}

jfmt_loop_clause_separator: fn(f: &JetFmt, next_start: Int, wrap: Bool) Never! {
    jfmt_write(f, ",")
    jfmt_loop_separator_tail(f, next_start, wrap)
}

jfmt_loop_source_separator: fn(f: &JetFmt, next_start: Int, wrap: Bool) Never! {
    jfmt_write(f, " in")
    jfmt_loop_separator_tail(f, next_start, wrap)
}

jfmt_loop_separator_tail: fn(f: &JetFmt, next_start: Int, wrap: Bool) Never! {
    broke := false
    loop f.comment_i < f.comments.len() && f.comments[f.comment_i].span.start < next_start {
        text: f.comments[f.comment_i].text.copy()
        jfmt_write(f, "  ")
        jfmt_write(f, text)
        f.comment_i += 1
        if text.starts_with("//") {
            jfmt_newline(f)
            jfmt_write_loop_continuation_indent(f)
            broke = true
        }
    }
    if wrap && !broke {
        jfmt_newline(f)
        jfmt_write_loop_continuation_indent(f)
    } else if !broke {
        jfmt_write(f, " ")
    }
}

// The bindingless loop subject has no comma before it; only the line break
// survives from `loop_clause_separator`.
jfmt_maybe_wrap_loop_clause: fn(f: &JetFmt, wrap: Bool) Never! {
    if wrap {
        jfmt_newline(f)
        jfmt_write_loop_continuation_indent(f)
    }
}

jfmt_blank_line_between_items: fn(f: &JetFmt) Never! {
    if !f.pending_blank {
        jfmt_newline(f)
        f.pending_blank = true
    }
}

// Top-level definitions are separated by exactly one blank line.
jfmt_blank_separator_before_item: fn(f: &JetFmt) Never! {
    if f.out.len() == 0 -> return
    if !f.at_line_start -> jfmt_newline(f)
    if !jfmt_out_ends_with(f, "\n\n") -> f.out.push(U8{10})
    f.pending_blank = true
}

jfmt_emit_remaining_comments: fn(f: &JetFmt) Never! {
    loop f.comment_i < f.comments.len() {
        text: f.comments[f.comment_i].text.copy()
        jfmt_emit_comment_line(f, text)
        f.comment_i += 1
    }
}

jfmt_emit_leading: fn(f: &JetFmt, pos: Int) Never! {
    loop f.comment_i < f.comments.len() {
        // copy: the pending comment (owner: f.comments) is emitted through `&f`; a view into
        // f.comments would be live across that exclusive borrow (E0212). A comment is a span and a
        // refcounted text.
        comment: f.comments[f.comment_i].copy()
        if comment.span.start >= pos -> break
        if jfmt_is_trailing_comment_at(f, comment.span) -> break
        jfmt_emit_comment_line(f, comment.text)
        f.comment_i += 1
        f.pending_blank = false
    }
}

// A declaration's leading comments. A blank line written between a standalone
// comment and what follows it stays, so a banner comment above a declaration
// never becomes that declaration's doc comment.
jfmt_emit_leading_declaration: fn(f: &JetFmt, pos: Int) Never! {
    loop f.comment_i < f.comments.len() {
        // copy: the pending comment (owner: f.comments) is emitted through `&f`, as in jfmt_emit_leading.
        comment: f.comments[f.comment_i].copy()
        if comment.span.start >= pos -> break
        if jfmt_is_trailing_comment_at(f, comment.span) -> break
        jfmt_emit_comment_line(f, comment.text)
        f.comment_i += 1
        following: if f.comment_i < f.comments.len() && f.comments[f.comment_i].span.start < pos -> f.comments[f.comment_i].span.start else -> pos
        if jfmt_src_range_valid(f, comment.span.end, following) && jfmt_source_has_blank_line(f.src_bytes, comment.span.end, following) {
            jfmt_newline(f)
            f.pending_blank = true
        }
    }
}

// Imports print before the items that precede them in source, so only the
// pending top-level comments may lead the imports. A comment inside an earlier
// item leaves the queue while the imports print (jfmt_return_item_comments
// puts it back for that item's own body).
jfmt_hold_item_comments: fn(f: &JetFmt, items: [Item], imports: [ImportDecl]) -> [JetFmtComment] Never! {
    limit := 0
    loop import in imports {
        if import.span.end > limit -> limit = import.span.end
    }
    kept := [JetFmtComment]{}
    held := [JetFmtComment]{}
    loop index in f.comment_i..<f.comments.len() {
        comment: f.comments[index]
        inside: if comment.span.start >= limit -> false else -> (loop item in items {
            if jfmt_item_span_start(f, item) <= comment.span.start && comment.span.start < jfmt_item_span_end(item) -> break true
        } ?? false)
        if inside -> held.push(comment.copy()) else -> kept.push(comment.copy())
    }
    if held.len() > 0 {
        loop f.comments.len() > f.comment_i -> _ := f.comments.pop()
        loop comment in kept -> f.comments.push(comment.copy())
    }
    held
}

// The held item comments rejoin the queue ahead of every comment the imports
// left: they sit before the last import in source.
jfmt_return_item_comments: fn(f: &JetFmt, held: [JetFmtComment]) Never! {
    if held.len() == 0 -> return
    rest := [JetFmtComment]{}
    loop index in f.comment_i..<f.comments.len() -> rest.push(f.comments[index].copy())
    loop f.comments.len() > f.comment_i -> _ := f.comments.pop()
    loop comment in held -> f.comments.push(comment.copy())
    loop comment in rest -> f.comments.push(comment.copy())
}

jfmt_emit_trailing: fn(f: &JetFmt, end: Int) Never! {
    loop f.comment_i < f.comments.len() {
        // copy: the pending comment (owner: f.comments) is written through `&f`; a view into
        // f.comments would be live across that exclusive borrow (E0212). A comment is a span and a
        // refcounted text.
        comment: f.comments[f.comment_i].copy()
        if comment.span.start >= f.trailing_comment_limit -> break
        if comment.span.start >= end && jfmt_line_of(f, comment.span.start) == jfmt_line_of(f, end) {
            jfmt_write(f, "  ")
            jfmt_emit_comment_inline(f, comment.text)
            f.comment_i += 1
        } else {
            break
        }
    }
}

// Verbatim items copy their source slice; skip the comments inside it so the
// next `emit_leading` does not print them twice.
jfmt_skip_verbatim_comments: fn(f: &JetFmt, end: Int) Never! {
    loop f.comment_i < f.comments.len() && f.comments[f.comment_i].span.start < end -> f.comment_i += 1
}

jfmt_is_trailing_comment_at: fn(f: JetFmt, span: Span) -> Bool Never! {
    if f.out.len() == 0 -> return false
    last_nl := 0
    index := f.out.len() - 1
    loop index >= 0 {
        if f.out[index] == 10 {
            last_nl = index + 1
            break
        }
        index -= 1
    }
    bounded: if last_nl < f.src_bytes.len() -> last_nl else -> f.src_bytes.len()
    jfmt_line_of(f, span.start) == jfmt_line_of(f, bounded) && !f.at_line_start
}

jfmt_emit_comment_line: fn(f: &JetFmt, text: String) Never! {
    if f.out.len() > 0 && !f.at_line_start -> jfmt_newline(f)
    jfmt_write_indent(f)
    jfmt_write(f, text)
    jfmt_newline(f)
    f.pending_blank = false
}

jfmt_emit_comment_inline: fn(f: &JetFmt, text: String) Never! {
    jfmt_write(f, text)
    f.pending_blank = false
}

// True if any tracked comment falls inside `open..close` (gate c). The
// comments are in source order, so the first at or after `open` decides.
jfmt_span_has_comment: fn(f: JetFmt, open: Int, close: Int) -> Bool Never! {
    low := 0
    high := f.comments.len()
    loop low < high {
        middle: (low + high) /% 2
        if {
            f.comments[middle].span.start < open -> low = middle + 1
            else -> high = middle
        }
    }
    low < f.comments.len() && f.comments[low].span.start < close
}

// ---- source scans ----

// The AST stores only the name span for calls; comment attachment walks the
// lexer tokens to the first top-level terminator.
jfmt_statement_source_end: fn(f: JetFmt, stmt: Stmt) -> Int Never! {
    scanned: if stmt == {
        .Expr(_) | .DeferClose(_, _) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Yield(_, _) -> true
        .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .ScopeMember(_, _, _, _, _, _, _, _) -> false
    }
    if !scanned -> return jfmt_stmt_end(stmt)
    start: jfmt_stmt_start(stmt)
    parens := 0
    brackets := 0
    braces := 0
    last_end := jfmt_stmt_end(stmt)
    loop index in jfmt_first_token_at(f, start)..<f.source_toks.len() {
        token: f.source_toks[index]
        kind: token.kind
        if jfmt_is_comment_kind(kind) -> next
        if {
            kind == TOKEN_SEMI && parens == 0 && brackets == 0 && braces == 0 -> return last_end
            kind == TOKEN_EOF -> return last_end
            kind == TOKEN_LPAREN -> parens += 1
            kind == TOKEN_RPAREN && parens == 0 -> return last_end
            kind == TOKEN_RPAREN -> parens -= 1
            kind == TOKEN_LBRACKET -> brackets += 1
            kind == TOKEN_RBRACKET && brackets == 0 -> return last_end
            kind == TOKEN_RBRACKET -> brackets -= 1
            kind == TOKEN_LBRACE -> braces += 1
            kind == TOKEN_RBRACE && braces == 0 -> return last_end
            kind == TOKEN_RBRACE -> braces -= 1
            else -> {}
        }
        last_end = token.span.end
    }
    last_end
}

// Where the gap after a statement starts. A block statement's source end is
// its last inner statement's (jfmt_stmt_end), or its head's when the block
// is empty, so when the last token before `next_start` (past comments and
// line breaks) is a `}` after `end`, the gap starts past it: a blank line
// inside the block stays inside it.
jfmt_statement_gap_start: fn(f: JetFmt, end: Int, next_start: Int) -> Int Never! {
    index := jfmt_first_token_at(f, next_start) - 1
    loop index >= 0 {
        token: f.source_toks[index]
        if !jfmt_is_comment_kind(token.kind) && token.kind != TOKEN_SEMI {
            if token.kind == TOKEN_RBRACE && token.span.end > end -> return token.span.end
            return end
        }
        index -= 1
    }
    end
}

// The source arms of a table written one arm per line, read in order so
// their comments stay with them: `at` is the token the next arm starts at or
// after, `close` the table's closing `}` (-1: no arms are read), and
// `previous_end` where the arm before ends (-1: none yet).
JetFmtTableArms: struct {
    at: Int
    close: Int
    previous_end: Int{-1}
}

// The arms of the table written at `start`: its `{` is the first one outside
// parentheses and brackets, as jfmt_cmp_op_before_brace reads it.
jfmt_table_arms: fn(f: JetFmt, start: Int, compact: Bool) -> JetFmtTableArms Never! {
    none: JetFmtTableArms{at: 0, close: -1}
    if compact -> return none
    depth := 0
    loop index in jfmt_first_token_at(f, start)..<f.source_toks.len() {
        kind: f.source_toks[index].kind
        if {
            kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET -> depth += 1
            kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET -> depth -= 1
            kind == TOKEN_LBRACE && depth == 0 -> {
                if index >= f.brace_closes.len() || f.brace_closes[index] < 0 -> return none
                return JetFmtTableArms{at: index + 1, close: f.brace_closes[index]}
            }
            kind == TOKEN_EOF -> return none
            else -> {}
        }
    }
    none
}

// The arm read from the table's `else ->` written at `start`.
jfmt_table_else_arm: fn(f: JetFmt, start: Int) -> JetFmtTableArms Never! {
    JetFmtTableArms{at: jfmt_first_token_at(f, start), close: f.source_toks.len()}
}

// The next source arm: its tokens up to the line break, `,` or closing
// token that ends it. Moves `arms` past it.
jfmt_table_arm_source: fn(f: JetFmt, arms: &JetFmtTableArms) -> Span? Never! {
    if arms.close < 0 -> return None
    start := -1
    end := -1
    depth := 0
    loop arms.at < arms.close && arms.at < f.source_toks.len() {
        token: f.source_toks[arms.at]
        kind: token.kind
        closer: kind == TOKEN_RPAREN || kind == TOKEN_RBRACKET || kind == TOKEN_RBRACE
        if kind == TOKEN_EOF || (closer && depth == 0) -> break
        if !jfmt_is_comment_kind(kind) {
            if depth == 0 && (kind == TOKEN_SEMI || kind == TOKEN_COMMA) {
                if start >= 0 -> break
            } else {
                if {
                    kind == TOKEN_LPAREN || kind == TOKEN_LBRACKET || kind == TOKEN_LBRACE -> depth += 1
                    closer -> depth -= 1
                    else -> {}
                }
                if start < 0 -> start = token.span.start
                end = token.span.end
            }
        }
        arms.at += 1
    }
    if start < 0 -> return None
    Val(Span{start: start, end: end})
}

// Before an arm of a table written one arm per line: the comments that lead
// it, with a blank line written between an earlier arm and a comment kept.
// Returns where the arm ends in the source, for its trailing comment
// (jfmt_table_arm_end), or -1 when the source has no arm left.
jfmt_table_arm_lead: fn(f: &JetFmt, arms: &JetFmtTableArms) -> Int {
    span: jfmt_table_arm_source(f, arms) ?? return -1
    if arms.previous_end >= 0 -> jfmt_emit_leading_statement_gap(f, arms.previous_end, span.start) else -> jfmt_emit_leading(f, span.start)
    arms.previous_end = span.end
    span.end
}

// After an arm: the comment written on its last line.
jfmt_table_arm_end: fn(f: &JetFmt, end: Int) {
    if end >= 0 -> jfmt_emit_trailing(f, end)
}

// Before a table's closing `}`: the comments on their own lines after its
// last arm.
jfmt_table_arms_close: fn(f: &JetFmt, arms: JetFmtTableArms) {
    if arms.close >= 0 && arms.close < f.source_toks.len() -> jfmt_emit_leading(f, f.source_toks[arms.close].span.start)
}

// S69 did the author break the line before this chain step's `.`?
jfmt_chain_break_between: fn(f: JetFmt, from: Int, to: Int) -> Bool Never! {
    from <= to && jfmt_src_valid(f, from, to) && jfmt_bytes_have_newline(f.src_bytes, from, to)
}

jfmt_saturating_sub: fn(value: Int, amount: Int) -> Int Never! {
    if value > amount -> value - amount else -> 0
}

// The exact type spelling through its next top-level terminator: the AST
// canonicalizes union members, so this slice is the only retained order fact.
jfmt_source_type_spelling: fn(f: JetFmt, start: Int) -> String? Never! {
    parens := 0
    brackets := 0
    angles := 0
    end := start
    loop index in jfmt_first_token_at(f, start)..<f.source_toks.len() {
        token: f.source_toks[index]
        kind: token.kind
        top_level: parens == 0 && brackets == 0 && angles == 0
        if top_level && (kind == TOKEN_COMMA || kind == TOKEN_SEMI || kind == TOKEN_UNIFIED_ARROW || kind == TOKEN_RPAREN || kind == TOKEN_RBRACE || kind == TOKEN_EOF) -> break
        if {
            kind == TOKEN_LPAREN -> parens += 1
            kind == TOKEN_RPAREN -> parens = jfmt_saturating_sub(parens, 1)
            kind == TOKEN_LBRACKET -> brackets += 1
            kind == TOKEN_RBRACKET -> brackets = jfmt_saturating_sub(brackets, 1)
            kind == TOKEN_LT -> angles += 1
            kind == TOKEN_GT -> angles = jfmt_saturating_sub(angles, 1)
            kind == TOKEN_SHR -> angles = jfmt_saturating_sub(angles, 2)
            else -> {}
        }
        end = token.span.end
    }
    if end > start -> Val(jfmt_src_text(f, start, end)) else -> None
}

jfmt_delimiter_opens: fn(delimiter: Int, kind: Int) -> Bool Never! {
    if {
        delimiter == JFMT_DELIM_PAREN -> kind == TOKEN_LPAREN
        delimiter == JFMT_DELIM_BRACKET -> kind == TOKEN_LBRACKET
        delimiter == JFMT_DELIM_BRACE -> kind == TOKEN_LBRACE
        else -> kind == TOKEN_LT
    }
}

jfmt_delimiter_closes: fn(delimiter: Int, kind: Int) -> Bool Never! {
    if {
        delimiter == JFMT_DELIM_PAREN -> kind == TOKEN_RPAREN
        delimiter == JFMT_DELIM_BRACKET -> kind == TOKEN_RBRACKET
        delimiter == JFMT_DELIM_BRACE -> kind == TOKEN_RBRACE
        else -> kind == TOKEN_GT || kind == TOKEN_SHR
    }
}

// The first `delimiter` group at or after `start`: its whole span and the
// offset of its closing token. A `start` inside a source token (an
// interpolation in a string) has no group of its own among the source tokens.
jfmt_source_list_span_after: fn(f: JetFmt, start: Int, delimiter: Int) -> JetFmtSourceList? Never! {
    depth := 0
    open_start := Int?{None}
    first: jfmt_first_token_at(f, start)
    if first > 0 && f.source_toks[first - 1].span.end > start -> return None
    loop index in first..<f.source_toks.len() {
        token: f.source_toks[index]
        is_open: jfmt_delimiter_opens(delimiter, token.kind)
        is_close: jfmt_delimiter_closes(delimiter, token.kind)
        if depth == 0 {
            if is_open {
                depth = 1
                open_start = Val(token.span.start)
            }
            next
        }
        if is_open {
            depth += 1
        } else if is_close {
            consumed: if delimiter == JFMT_DELIM_ANGLE && token.kind == TOKEN_SHR -> 2 else -> 1
            depth = jfmt_saturating_sub(depth, consumed)
            if depth == 0 {
                opened: open_start ?? return None
                return Val(JetFmtSourceList{span: Span{start: opened, end: token.span.end}, close_start: token.span.start})
            }
        }
    }
    None
}

jfmt_source_effect_row_span_after: fn(f: JetFmt, start: Int) -> JetFmtSourceList? Never! {
    first: jfmt_first_token_at(f, start)
    limit: jfmt_saturating_sub(f.source_toks.len(), 1)
    loop index in first..<limit {
        if f.source_toks[index].kind != TOKEN_MINUS -> next
        following: f.source_toks[index + 1]
        if following.kind == TOKEN_LBRACKET -> return jfmt_source_list_span_after(f, following.span.start, JFMT_DELIM_BRACKET)
    }
    None
}

jfmt_source_marker_group_span: fn(f: JetFmt, start: Int) -> JetFmtSourceList? Never! {
    index := jfmt_first_token_at(f, start) - 1
    loop index >= 0 {
        if f.source_toks[index].kind == TOKEN_LBRACKET -> return jfmt_source_list_span_after(f, f.source_toks[index].span.start, JFMT_DELIM_BRACKET)
        index -= 1
    }
    None
}

jfmt_source_span_multiline: fn(f: JetFmt, span: Span) -> Bool Never! {
    (jfmt_src_valid(f, span.start, span.end) && jfmt_bytes_have_newline(f.src_bytes, span.start, span.end)) || jfmt_span_has_comment(f, span.start, span.end)
}

// Rust `fmt_comma_items`, split at its closure boundaries: begin, then per
// item before/render/after, then end. A multiline list puts each item on its
// own line one level in, and its closer back at the list's own indent.
jfmt_comma_begin: fn(f: &JetFmt, count: Int, source: JetFmtSourceList?) -> Bool Never! {
    multiline := false
    if source == .Val(list) -> multiline = jfmt_source_span_multiline(f, list.span)
    if !multiline -> return false
    if count > 0 -> jfmt_newline(f)
    f.indent += 1
    true
}

jfmt_comma_before: fn(f: &JetFmt, index: Int, multiline: Bool, item_start: Int) Never! {
    if index > 0 {
        if multiline {
            jfmt_newline(f)
        } else {
            jfmt_write(f, ", ")
        }
    }
    if multiline -> jfmt_emit_leading(f, item_start)
}

jfmt_comma_after: fn(f: &JetFmt, multiline: Bool, item_end: Int) Never! {
    if multiline {
        jfmt_write(f, ",")
        jfmt_emit_trailing(f, item_end)
    }
}

jfmt_comma_end: fn(f: &JetFmt, multiline: Bool, source: JetFmtSourceList?) Never! {
    if !multiline -> return
    if source == .Val(list) -> jfmt_emit_leading(f, list.close_start)
    f.indent -= 1
    if !f.at_line_start -> jfmt_newline(f)
}

// The top-level comma-separated item spans inside a source list.
jfmt_source_list_item_spans: fn(f: JetFmt, source: JetFmtSourceList) -> [Span] Never! {
    first: jfmt_first_token_at(f, source.span.start)
    opening: if first < f.source_toks.len() -> f.source_toks[first].kind else -> TOKEN_EOF
    parens := if opening == TOKEN_LPAREN -> 1 else -> 0
    brackets := if opening == TOKEN_LBRACKET -> 1 else -> 0
    braces := if opening == TOKEN_LBRACE -> 1 else -> 0
    angles := if opening == TOKEN_LT -> 1 else -> 0
    item_start := Int?{None}
    item_end := Int?{None}
    items := [Span]{}
    loop index in first..<f.source_toks.len() {
        token: f.source_toks[index]
        if token.span.start >= source.close_start -> break
        if token.span.start == source.span.start -> next
        kind: token.kind
        if jfmt_is_comment_kind(kind) -> next
        top_level: parens == 0 && brackets == 0 && braces == 0 && angles == 0
        if top_level && kind == TOKEN_COMMA {
            if item_start == .Val(item_from) {
                if item_end == .Val(item_to) -> items.push(Span{start: item_from, end: item_to})
            }
            item_start = None
            item_end = None
            next
        }
        if item_start == None -> item_start = Val(token.span.start)
        item_end = Val(token.span.end)
        if {
            kind == TOKEN_LPAREN -> parens += 1
            kind == TOKEN_RPAREN -> parens = jfmt_saturating_sub(parens, 1)
            kind == TOKEN_LBRACKET -> brackets += 1
            kind == TOKEN_RBRACKET -> brackets = jfmt_saturating_sub(brackets, 1)
            kind == TOKEN_LBRACE -> braces += 1
            kind == TOKEN_RBRACE -> braces = jfmt_saturating_sub(braces, 1)
            kind == TOKEN_LT -> angles += 1
            kind == TOKEN_GT -> angles = jfmt_saturating_sub(angles, 1)
            kind == TOKEN_SHR -> angles = jfmt_saturating_sub(angles, 2)
            else -> {}
        }
    }
    if item_start == .Val(item_from) {
        if item_end == .Val(item_to) -> items.push(Span{start: item_from, end: item_to})
    }
    items
}

// `spans[index]` from `source_list_item_spans`, else `fallback`.
jfmt_item_span_or: fn(spans: [Span]?, index: Int, fallback: Span) -> Span Never! {
    if spans == .Val(list) {
        if index < list.len() -> return list[index]
    }
    fallback.copy()
}

jfmt_list_item_spans: fn(f: JetFmt, source: JetFmtSourceList?) -> [Span]? Never! {
    if source == .Val(list) -> return Val(jfmt_source_list_item_spans(f, list))
    None
}

// ---- brace bodies ----

jfmt_fmt_body: fn(f: &JetFmt, body: [Stmt]) {
    jfmt_fmt_control_body(f, body)
}

// The parser reads the last line of a callable body with a value as the
// body's value when it is an `if` in a value form
// (parser_parse_callable_body), so a braced `if` statement there keeps its
// braces (jfmt_fmt_classic_switch). `body` is that body, or no lines for a
// body without a value. Returns the enclosing body's mark, which the caller
// restores once the body is written.
jfmt_value_tail_begin: fn(f: &JetFmt, body: [Stmt]) -> Int {
    saved: f.value_tail_at
    f.value_tail_at = if body.len() > 0 -> jfmt_stmt_start(body[body.len() - 1]) else -> -1
    saved
}

// The expanded brace-body shape; the caller has already emitted ` {`.
jfmt_fmt_body_expanded: fn(f: &JetFmt, body: [Stmt]) {
    jfmt_newline(f)
    f.indent += 1
    jfmt_fmt_block_stmts(f, body)
    f.indent -= 1
    jfmt_end_block(f)
}

// Locate the `{ … }` around a lone body statement. An expression statement
// starts at its leftmost operand (jfmt_expr_start): a method call's own span
// starts after its receiver.
jfmt_single_stmt_braces: fn(f: JetFmt, stmt: Stmt) -> JetFmtBraces? Never! {
    start: if stmt == .Expr(expr) -> jfmt_expr_start(expr) else -> jfmt_stmt_start(stmt)
    if start < 0 || start > f.src_bytes.len() -> return None
    brace: jfmt_bytes_rfind(f.src_bytes, start, "{{")
    if brace < 0 -> return None
    open: brace + 1
    if !jfmt_source_gap_is_trivia(f, open, start) -> return None
    depth := 1
    loop token in f.source_toks {
        if token.span.start < open -> next
        if {
            token.kind == TOKEN_LBRACE -> depth += 1
            token.kind == TOKEN_RBRACE && depth == 1 -> return Val(JetFmtBraces{open: open, close: token.span.start})
            token.kind == TOKEN_RBRACE -> depth -= 1
            else -> {}
        }
    }
    None
}

jfmt_source_gap_is_trivia: fn(f: JetFmt, start: Int, end: Int) -> Bool Never! {
    cursor := start
    loop comment in f.comments {
        if comment.span.start < cursor -> next
        if comment.span.start >= end -> break
        if !jfmt_src_all_whitespace(f, cursor, comment.span.start) -> return false
        cursor = if comment.span.end < end -> comment.span.end else -> end
    }
    jfmt_src_all_whitespace(f, cursor, end)
}

// Locate the `{ … }` around an if-expression branch whose only content is
// `value`.
jfmt_value_block_braces: fn(f: JetFmt, value: Expr) -> JetFmtBraces? Never! {
    span: expr_span(value)
    if span.start < 0 || span.start > f.src_bytes.len() || span.end > f.src_bytes.len() -> return None
    brace: jfmt_bytes_rfind(f.src_bytes, span.start, "{{")
    if brace < 0 -> return None
    close: jfmt_bytes_find(f.src_bytes, span.end, "}}")
    if close < 0 -> return None
    open: brace + 1
    if open <= close -> Val(JetFmtBraces{open: open, close: close}) else -> None
}

// Attempt the inline branch `{ value }`; rolls back on overflow. The
// caller has already emitted the opening `{`.
jfmt_try_inline_value_block: fn(f: &JetFmt, stmts: [Stmt], value: Expr) -> Bool {
    if !jfmt_value_block_inlineable(f, stmts, value) -> return false
    saved_out: f.out.len()
    saved_col: f.col
    saved_line_start: f.at_line_start
    jfmt_write(f, " ")
    saved_head: jfmt_expr_stmt_begin(f)
    jfmt_fmt_expr(f, value, JFMT_PREC_OR_FALLBACK)
    f.stmt_head_at = saved_head
    jfmt_write(f, " }}")
    if f.col <= JFMT_MAX_WIDTH -> return true
    jfmt_truncate(f, saved_out)
    f.col = saved_col
    f.at_line_start = saved_line_start
    false
}

jfmt_fmt_control_body: fn(f: &JetFmt, body: [Stmt]) {
    if body.len() == 1 {
        statement: body[0]
        comment_free := true
        if jfmt_single_stmt_braces(f, statement) == .Val(braces) -> comment_free = !jfmt_span_has_comment(f, braces.open, braces.close)
        if jfmt_is_simple_stmt(statement) && comment_free && !jfmt_is_table_value_stmt(f, statement) {
            mark: jfmt_one_line_trial_begin(f)
            jfmt_write(f, " ")
            jfmt_fmt_stmt_inline(f, statement)
            jfmt_write(f, " }}")
            // A statement can render multi-line even on the inline path; never
            // keep a collapsed body whose content spans lines.
            if jfmt_one_line_trial_end(f, mark) -> return
        }
    }
    jfmt_fmt_body_expanded(f, body)
}

// A table is a control form: a lone table value keeps its body expanded, as a
// table statement does, even when the table itself fits on one line.
jfmt_is_table_value_stmt: fn(f: JetFmt, stmt: Stmt) -> Bool Never! {
    if stmt == .Expr(expr) -> return jfmt_is_guard_expr(f, expr)
    false
}

// ---- redundant `Val(x)` returns ----

// `Val(x)` returned from a function declared `-> T?` drops its `Val` when the
// payload's type never comes from the optional context: a name, a field
// path, or a `Bool`/`Char` literal.
jfmt_self_typed: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) | .Bool(_, _, _) | .Char(_, _, _) -> true
        .Field(base, _, _, _) -> jfmt_self_typed(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

jfmt_unwrap_redundant_optional_value: fn(value: Expr) -> Expr Never! {
    if value == .EnumLit(type_name, variant, _, args, _, _, _) {
        // copy: a read-parameter rewriter returns a value that is not a redundant `Val(..)`
        // unchanged as a new tree (owner: the result) while the caller keeps the input (owner: the
        // read parameter, a payload view of the caller's tree); taking the input would need a
        // consuming match of every rebuilt variant (children arrive as payload views).
        if type_name.len() > 0 || variant != "Val" || args.len() != 1 -> return value.copy()
        if args[0] == .Positional(inner) {
            if jfmt_self_typed(inner) -> return inner
        }
    }
    // copy: a read-parameter rewriter returns a value that is not a redundant `Val(..)` unchanged
    // as a new tree (owner: the result) while the caller keeps the input (owner: the read
    // parameter, a payload view of the caller's tree); taking the input would need a consuming
    // match of every rebuilt variant (children arrive as payload views).
    value.copy()
}

jfmt_strip_optional_returns_in_if: fn(expr: Expr) -> Expr Never! {
    if expr == .If(cond, then_body, then_value, else_body, else_value, span, _) {
        return Expr.If{cond: cond, then_body: jfmt_strip_optional_returns_in_body(then_body), then_value: then_value, else_body: jfmt_strip_optional_returns_in_body(else_body), else_value: jfmt_strip_optional_returns_in_if(else_value), span: span, id: AST_NODE_GENERATED}
    }
    // copy: a read-parameter rewriter returns an expression that is not an `if` unchanged as a new
    // tree (owner: the result) while the caller keeps the input (owner: the read parameter, a
    // payload view of the caller's tree); taking the input would need a consuming match of every
    // rebuilt variant (children arrive as payload views).
    expr.copy()
}

jfmt_strip_optional_returns_in_body: fn(body: [Stmt]) -> [Stmt] Never! {
    out := [Stmt]{}
    loop stmt in body {
        if stmt == {
            .Return(value, span) -> {
                if value == .Val(inner) {
                    out.push(Stmt.Return{value: Val(jfmt_unwrap_redundant_optional_value(inner)), span: span})
                } else {
                    out.push(stmt.copy())
                }
            }
            .Expr(expr) -> out.push(Stmt.Expr{expr: jfmt_strip_optional_returns_in_if(expr)})
            .While(cond, inner, span, arrow_body, label) -> out.push(Stmt.While{cond: cond, body: jfmt_strip_optional_returns_in_body(inner), span: span, arrow_body: arrow_body, label: label})
            .For(var, var_span, var2, kind, inner, span, arrow_body, label, facts) -> out.push(Stmt.For{var: var, var_span: var_span, var2: var2, kind: kind, body: jfmt_strip_optional_returns_in_body(inner), span: span, arrow_body: arrow_body, label: label, auto_vectorization: facts})
            .Loop(inner, span, arrow_body, label) -> out.push(Stmt.Loop{body: jfmt_strip_optional_returns_in_body(inner), span: span, arrow_body: arrow_body, label: label})
            .CountedLoop(init, cond, step, inner, span, arrow_body, label) -> out.push(Stmt.CountedLoop{init: init, cond: cond, step: step, body: jfmt_strip_optional_returns_in_body(inner), span: span, arrow_body: arrow_body, label: label})
            .Switch(subject, arms, else_body, span) -> {
                stripped_arms := [SwitchArm]{}
                loop arm in arms -> stripped_arms.push(SwitchArm{cond: arm.cond, body: jfmt_strip_optional_returns_in_body(arm.body), span: arm.span, through: arm.through})
                stripped_else := [Stmt]?{None}
                if else_body == .Val(inner) -> stripped_else = Val(jfmt_strip_optional_returns_in_body(inner))
                out.push(Stmt.Switch{subject: subject, arms: stripped_arms.move(), else_body: stripped_else.move(), span: span})
            }
            .Val(_) | .Assign(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> out.push(stmt.copy())
        }
    }
    out
}

jfmt_strip_optional_func: fn(function: Func) -> Func Never! {
    if function.return_type == .Val(declared) {
        if declared == .Option(_) {
            updated := function
            body := jfmt_strip_optional_returns_in_body(function.body)
            if body.len() > 0 {
                if body[body.len() - 1] == .Expr(tail) -> body[body.len() - 1] = Stmt.Expr{expr: jfmt_unwrap_redundant_optional_value(tail)}
            }
            updated.body = body
            return updated
        }
    }
    // copy: a read-parameter rewriter returns a function with nothing to strip unchanged as a new
    // tree (owner: the result) while the caller keeps the input (owner: the read parameter, a
    // payload view of the caller's tree); taking the input would need a consuming match of every
    // rebuilt variant (children arrive as payload views).
    function.copy()
}

jfmt_strip_optional_funcs: fn(functions: [Func]) -> [Func] Never! {
    out := [Func]{}
    loop function in functions -> out.push(jfmt_strip_optional_func(function))
    out
}

// Visit every callable body the simplify catalog rewrites: free functions,
// type and impl methods, and functions nested in code modules.
jfmt_strip_redundant_optional_returns: fn(items: [Item]) -> [Item] Never! {
    out := [Item]{}
    loop item in items {
        if item == {
            .Func(function) -> out.push(Item.Func{value: jfmt_strip_optional_func(function)})
            .Struct(definition) -> {
                updated := definition
                updated.methods = jfmt_strip_optional_funcs(definition.methods)
                loop index in 0..<updated.trait_impls.len() {
                    updated.trait_impls[index].methods = jfmt_strip_optional_funcs(updated.trait_impls[index].methods)
                }
                out.push(Item.Struct{value: updated})
            }
            .Enum(definition) -> {
                updated := definition
                updated.methods = jfmt_strip_optional_funcs(definition.methods)
                loop index in 0..<updated.trait_impls.len() {
                    updated.trait_impls[index].methods = jfmt_strip_optional_funcs(updated.trait_impls[index].methods)
                }
                out.push(Item.Enum{value: updated})
            }
            .Impl(definition) -> {
                updated := definition
                updated.methods = jfmt_strip_optional_funcs(definition.methods)
                out.push(Item.Impl{value: updated})
            }
            .CodeModule(decl) -> {
                updated := decl
                if decl.body == .Val(body) -> updated.body = Val(jfmt_strip_redundant_optional_returns(body))
                out.push(Item.CodeModule{value: updated})
            }
            .GenericModule(decl) -> {
                updated := decl
                updated.body = jfmt_strip_redundant_optional_returns(decl.body)
                out.push(Item.GenericModule{value: updated})
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> out.push(item.copy())
        }
    }
    out
}

// ---- source edits ----

// Whether a source comment lies within [start, end).
jfmt_comment_between: fn(f: JetFmt, start: Int, end: Int) -> Bool Never! {
    loop comment in f.comments {
        if comment.span.start >= start && comment.span.start < end -> return true
    }
    false
}

// Records the source edit that writes `place = place op right` as
// `place op= right`: the operator through the left operand becomes `op= `.
// Grouping around the whole value keeps its parentheses, opened again before
// the right operand (`n = (n + 1)` reads as `n += (1)`, the same program). A
// layout tried and rolled back prints the same assignment again, so each is
// recorded once.
jfmt_note_compound_rewrite: fn(f: &JetFmt, op_start: Int, right_start: Int, grouping: Int, spelled: String) Never! {
    loop edit in f.compound_rewrites {
        if edit.span.start == op_start -> return
    }
    text := "{spelled} "
    loop _ in 0..<grouping -> text = "{text}("
    f.compound_rewrites.push(TextEdit{span: Span{start: op_start, end: right_start}, new_text: text})
}

jfmt_apply_source_edits: fn(src: String, edits: [TextEdit]) -> String? Never! {
    source: src.bytes()
    ordered := edits
    // Rust sorts by descending start; apply from the end of the source.
    ordered = loop fresh_item in ordered -> fresh_item
    ordered.sort_by(fn(left: TextEdit, right: TextEdit) { right.span.start <=> left.span.start })
    replaced_start := JFMT_NO_LIMIT
    loop edit in ordered {
        if edit.span.end > source.len() || edit.span.start > edit.span.end || edit.span.end > replaced_start -> return None
        // A continuation byte cannot begin or end an edit of UTF-8 source.
        if edit.span.start < source.len() && source[edit.span.start] >= 0x80 && source[edit.span.start] <= 0xBF -> return None
        if edit.span.end < source.len() && source[edit.span.end] >= 0x80 && source[edit.span.end] <= 0xBF -> return None
        replaced_start = edit.span.start
    }
    out := [U8]{}
    cursor := 0
    position := ordered.len() - 1
    loop position >= 0 {
        edit: ordered[position]
        loop cursor < edit.span.start {
            out.push(source[cursor])
            cursor += 1
        }
        loop byte in edit.new_text.bytes() -> out.push(byte)
        cursor = edit.span.end
        position -= 1
    }
    loop cursor < source.len() {
        out.push(source[cursor])
        cursor += 1
    }
    Val(String.from_bytes(out) ?? src)
}

// ---- parse acceptance (Rust parse_for_check_with_source / parse_for_fmt) ----

// Live current-rule diagnostics that recover in the AST; fmt may rewrite to canon.
jfmt_is_teaching_parse_diag: fn(code: String) -> Bool Never! {
    if code == {
        "E0080" | "E0082" | "E0154" | "E0986" | "E0992" | "E0994" | "E0366" | "E0367" | "E0372" | "E0373" | "E0379" | "E0386" | "E0999" | "E0414" | "E0415" | "E0417" -> true
        else -> false
    }
}

// Rust `parse_for_check_with_source` succeeds: every diagnostic is a lint, a
// teaching diagnostic, or E0081.
jfmt_check_parse_accepts: fn(diagnostics: [Diagnostic]) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_LINT || jfmt_is_teaching_parse_diag(diagnostic.code) || diagnostic.code == "E0081" -> next
        return false
    }
    true
}

// Rust `parse_for_fmt` succeeds: no errors, or every error is a teaching
// diagnostic.
jfmt_fmt_parse_accepts: fn(diagnostics: [Diagnostic]) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if jfmt_is_teaching_parse_diag(diagnostic.code) -> next
        return false
    }
    true
}

// ---- driver ----

jfmt_is_module_policy: fn(declaration: PolicyDeclaration) -> Bool Never! {
    if declaration.scope == {
        .Module -> true
        .Organization | .Package | .Function | .Block -> false
    }
}

jfmt_newline_offsets: fn(source: [U8]) -> [Int] Never! {
    offsets := [Int]{}
    loop (index, byte) in source {
        if byte == 10 -> offsets.push(index)
    }
    offsets
}

jfmt_new: fn(prog: Program, src: String, source_toks: [Token], simplify: Bool) -> JetFmt Never! {
    bytes: src.bytes()
    comments := [JetFmtComment]{}
    loop token in source_toks {
        if jfmt_is_comment_kind(token.kind) -> comments.push(JetFmtComment{text: jfmt_bytes_text(bytes, token.span.start, token.span.end), span: token.span})
    }
    closes: jfmt_brace_closes(source_toks)
    JetFmt{
        src: src,
        src_bytes: bytes,
        newlines: jfmt_newline_offsets(bytes),
        source_toks: source_toks,
        comments: comments,
        comment_i: 0,
        out: [U8]{},
        col: 0,
        at_line_start: true,
        indent: 0,
        pending_blank: false,
        trailing_comment_limit: JFMT_NO_LIMIT,
        items: prog.items,
        policy_declarations: prog.policy_declarations,
        fenced_statements: prog.fenced_statements,
        simplify: simplify,
        expected_return_type: None,
        force_control_braces: false,
        inline_rules: jfmt_inline_rules(prog.applied_rules),
        brace_closes: closes,
    }
}

// The index of the `}` token that closes each `{` token, -1 for any other
// token, so a table finds its end without scanning its body.
jfmt_brace_closes: fn(tokens: [Token]) -> [Int] Never! {
    closes := [Int]{}
    opens := [Int]{}
    loop (index, token) in tokens {
        closes.push(-1)
        if token.kind == TOKEN_LBRACE -> opens.push(index)
        if token.kind == TOKEN_RBRACE && opens.len() > 0 {
            open: opens.pop() ?? -1
            closes[open] = index
        }
    }
    closes
}

// A one-line trial: a table or body the author wrote on one line is
// rendered on one line and kept only if it fits with no line break, else
// rolled back for the expanded form. Inside a trial, a line break or a
// column past JFMT_MAX_WIDTH means the outermost trial fails, since only a
// rollback to before it removes either; a nested table then renders nothing
// (jfmt_one_line_trial_lost). Without that, each level of a deep
// `else -> if { … }` chain rendered its whole tail twice, once per form:
// exponential in the chain's depth.
jfmt_one_line_trial_begin: fn(f: &JetFmt) -> JetFmtMark Never! {
    mark: jfmt_mark(f)
    if f.one_line_trials == 0 -> f.one_line_trial_start = mark.out_len
    f.one_line_trials += 1
    mark
}

// Ends the trial begun at `mark`: true when its one-line form stays, false
// when it was rolled back.
jfmt_one_line_trial_end: fn(f: &JetFmt, mark: JetFmtMark) -> Bool Never! {
    f.one_line_trials -= 1
    if f.col <= JFMT_MAX_WIDTH && !jfmt_out_since_has_newline(f, mark.out_len) -> return true
    jfmt_rollback(f, mark)
    false
}

// The outermost one-line trial in progress already failed: what a nested
// table would render is rolled back unread.
jfmt_one_line_trial_lost: fn(f: JetFmt) -> Bool Never! {
    f.one_line_trials > 0 && (f.col > JFMT_MAX_WIDTH || jfmt_out_since_has_newline(f, f.one_line_trial_start))
}

jfmt_inline_rules: fn(applications: [AppliedRuleApplication]) -> [AppliedRuleApplication] Never! {
    rules := [AppliedRuleApplication]{}
    loop application in applications {
        if application.target == None -> next
        if jfmt_rule_at(application, RuleSite.Statement) || jfmt_rule_at(application, RuleSite.Expression) || jfmt_rule_at(application, RuleSite.Parameter) || jfmt_rule_at(application, RuleSite.Method) || jfmt_rule_at(application, RuleSite.Declaration) -> rules.push(application.copy())
    }
    rules
}

// Writes `#Name ` for each kept rule of `site` that prefixes the construct
// starting at `start`. A statement or declaration row targets the construct;
// a parameter or trait-member row targets its own marker, which the
// construct follows.
jfmt_fmt_rules_before: fn(f: &JetFmt, site: RuleSite, start: Int) {
    loop application in f.inline_rules {
        if !jfmt_rule_anchored(f, application, site, start) -> next
        jfmt_write(f, "#")
        jfmt_fmt_marker(f, application.marker)
        jfmt_write(f, " ")
    }
}

// Whether `application` is a `site` rule row of the item that starts at
// `start`.
jfmt_rule_anchored: fn(f: JetFmt, application: AppliedRuleApplication, site: RuleSite, start: Int) -> Bool Never! {
    if !jfmt_rule_at(application, site) -> return false
    target: application.target ?? return false
    anchor: if site == RuleSite.Parameter || site == RuleSite.Method -> jfmt_trim_start_bytes(f.src_bytes, target.end) else -> target.start
    anchor == start
}

// Whether any inline rule row belongs to the `site` item at `start`.
jfmt_rules_anchored_at: fn(f: JetFmt, site: RuleSite, start: Int) -> Bool Never! {
    loop application in f.inline_rules {
        if jfmt_rule_anchored(f, application, site, start) -> return true
    }
    false
}

jfmt_rule_at: fn(application: AppliedRuleApplication, site: RuleSite) -> Bool Never! {
    if application.site == .Val(actual) -> return actual == site
    false
}

// The unregistered marker a value position held (the parser keeps a `()` in
// its place); false when `span` is an ordinary `()`.
jfmt_fmt_expression_rule: fn(f: &JetFmt, span: Span) -> Bool {
    loop application in f.inline_rules {
        if application.target == .Val(target) {
            if target.start == span.start && target.end == span.end && jfmt_rule_at(application, RuleSite.Expression) {
                jfmt_write(f, "#")
                jfmt_fmt_marker(f, application.marker)
                return true
            }
        }
    }
    false
}

// The `#!/…` launch line at byte 0 is no token (the lexer reads it there
// only); it prints byte for byte, and a blank line written after it stays.
jfmt_fmt_launch_line: fn(f: &JetFmt) Never! {
    bytes: f.src_bytes
    if bytes.len() < 3 || bytes[0] != (U8{35}) || bytes[1] != (U8{33}) || bytes[2] != (U8{47}) -> return
    end := 0
    loop end < bytes.len() && bytes[end] != (U8{10}) -> end += 1
    jfmt_write(f, jfmt_bytes_text(bytes, 0, end))
    jfmt_newline(f)
    next_start: if f.source_toks.len() > 0 -> f.source_toks[0].span.start else -> bytes.len()
    if next_start > end && jfmt_source_has_blank_line(bytes, end, next_start) -> jfmt_newline(f)
}

// Rust `format_program_with_tokens`; comments come from the source tokens.
jfmt_format_program_with_tokens: fn(prog: Program, src: String, source_toks: [Token], simplify: Bool) -> String {
    f := jfmt_new(prog, src, source_toks, simplify)
    jfmt_format_program_with(f, prog)
}

jfmt_format_program_with: fn(f: &JetFmt, prog: Program) -> String {
    jfmt_fmt_launch_line(f)
    first := true
    ordered_file_rules := [Marker]{}
    loop application in prog.applied_rules {
        if application.target == None -> ordered_file_rules.push(application.marker)
    }
    has_ordered_file_rules: ordered_file_rules.len() > 0
    ordered_file_rules_precede_imports := false
    loop marker in ordered_file_rules {
        if marker.name == MARKER_NO_PRELUDE -> ordered_file_rules_precede_imports = true
    }
    // The file rules (`#NoPrelude`, `#Target(…)`, `#HTML(…)`) head the file,
    // above its imports, in the order and spelling the author wrote them, as
    // one `#[…]` list when there are two or more. Below an import a
    // `#Target(JS)` would mark the next function, and `#Target(Web)` above a
    // module is E0003.
    file_rules := [Marker]{}
    if !has_ordered_file_rules {
        loop application in prog.rule_facts {
            if application.target != None || !jfmt_rule_at(application, RuleSite.File) -> next
            name: application.marker.name
            if name == MARKER_NO_PRELUDE || name == MARKER_TARGET || name == MARKER_HTML -> file_rules.push(application.marker)
        }
    }
    if has_ordered_file_rules && ordered_file_rules_precede_imports {
        jfmt_fmt_marker_group(f, ordered_file_rules, "#", true)
        first = false
    } else if file_rules.len() > 0 {
        jfmt_fmt_marker_group(f, file_rules, "#", true)
        first = false
    }
    // A file-head `#FX(…)` cap stays on the line above the imports it heads;
    // the empty, pure cap is the bare marker.
    if prog.file_cap == .Val(cap) {
        if !first -> jfmt_newline(f)
        first = false
        entries: (loop entry in cap.entries -> entry.name)
        if entries.len() == 0 -> jfmt_write(f, "#FX") else -> jfmt_write(f, "#FX({entries.join(", ")})")
        jfmt_newline(f)
    }
    if prog.imports.len() > 0 {
        if !first && prog.file_cap == None -> jfmt_blank_line_between_items(f)
        first = false
        held: jfmt_hold_item_comments(f, prog.items, prog.imports)
        jfmt_fmt_import_groups(f, prog.imports)
        jfmt_return_item_comments(f, held)
    }
    if has_ordered_file_rules && !ordered_file_rules_precede_imports {
        if !first -> jfmt_blank_line_between_items(f)
        first = false
        jfmt_fmt_marker_group(f, ordered_file_rules, "#", true)
    }
    // Module-scoped `#Policy(...)` at a fixed position.
    module_policies := [PolicyDeclaration]{}
    loop declaration in prog.policy_declarations {
        if jfmt_is_module_policy(declaration) -> module_policies.push(declaration.copy())
    }
    if module_policies.len() > 0 {
        policy_span: module_policies[0].span
        if !first -> jfmt_blank_line_between_items(f)
        first = false
        jfmt_emit_leading(f, policy_span.start)
        jfmt_fmt_policy_declarations(f, module_policies)
        jfmt_newline(f)
        jfmt_emit_trailing(f, policy_span.end)
    }
    // Loose statements and user settings interleave with items by position.
    item_i := 0
    stmt_i := 0
    policy_i := 0
    previous_was_script := false
    loop item_i < prog.items.len() || stmt_i < prog.script_body.len() || policy_i < prog.user_policy_declarations.len() {
        item_start: if item_i < prog.items.len() -> jfmt_item_span_start(f, prog.items[item_i]) else -> -1
        stmt_start: if stmt_i < prog.script_body.len() -> jfmt_stmt_span(prog.script_body[stmt_i]).start else -> -1
        if policy_i < prog.user_policy_declarations.len() {
            declaration: prog.user_policy_declarations[policy_i]
            if (item_start < 0 || declaration.span.start < item_start) && (stmt_start < 0 || declaration.span.start < stmt_start) {
                if !first -> jfmt_blank_line_between_items(f)
                first = false
                jfmt_emit_leading(f, declaration.span.start)
                jfmt_fmt_user_policy_decl(f, declaration)
                jfmt_emit_trailing(f, declaration.span.end)
                policy_i += 1
                previous_was_script = false
                next
            }
        }
        emit_stmt: if {
            stmt_start < 0 -> false
            item_start < 0 -> true
            else -> stmt_start < item_start
        }
        // A marker or an effect name prints inside the type that declares it.
        if !emit_stmt && jfmt_item_prints_inside_type(prog.items, item_i) {
            item_i += 1
            next
        }
        if !first {
            if emit_stmt && previous_was_script {
                if !f.at_line_start -> jfmt_newline(f)
            } else {
                jfmt_blank_separator_before_item(f)
            }
        }
        first = false
        if emit_stmt {
            stmt: prog.script_body[stmt_i]
            jfmt_emit_leading(f, jfmt_stmt_span(stmt).start)
            jfmt_fmt_stmt(f, stmt)
            stmt_end: jfmt_statement_source_end(f, stmt)
            jfmt_emit_trailing(f, stmt_end)
            if !f.at_line_start -> jfmt_newline(f)
            stmt_i += 1
            previous_was_script = true
        } else {
            item: prog.items[item_i]
            leading_at: jfmt_item_span_start(f, item)
            jfmt_emit_leading_declaration(f, leading_at)
            jfmt_fmt_item(f, item)
            jfmt_emit_trailing(f, jfmt_item_span_end(item))
            item_i += 1
            previous_was_script = false
        }
    }
    jfmt_fmt_trailing_file_markers(f, prog, ordered_file_rules, first)
    jfmt_emit_remaining_comments(f)
    if !jfmt_out_ends_with(f, "\n") -> f.out.push(U8{10})
    jfmt_out_text(f)
}

// A marker after the last declaration attaches to nothing; the parser keeps it
// as a File-site fact for sema to reject, and it stays where it was written.
jfmt_fmt_trailing_file_markers: fn(f: &JetFmt, prog: Program, ordered_file_rules: [Marker], first: Bool) {
    written := !first
    loop application in prog.rule_facts {
        if application.target != None || !jfmt_rule_at(application, RuleSite.File) -> next
        marker: application.marker
        if marker.name == MARKER_NO_PRELUDE || marker.name == MARKER_TARGET || marker.name == MARKER_HTML -> next
        if jfmt_trailing_marker_followed(f, prog, ordered_file_rules, marker.span.start) -> next
        if written -> jfmt_blank_line_between_items(f)
        written = true
        jfmt_emit_leading(f, marker.span.start)
        jfmt_write(f, "#")
        jfmt_fmt_marker(f, marker)
        jfmt_newline(f)
    }
}

// The marker at `start` is a printed file rule, or code follows it.
jfmt_trailing_marker_followed: fn(f: JetFmt, prog: Program, ordered_file_rules: [Marker], start: Int) -> Bool Never! {
    loop ordered in ordered_file_rules {
        if ordered.span.start == start -> return true
    }
    loop item in prog.items {
        if jfmt_item_span_start(f, item) > start -> return true
    }
    loop stmt in prog.script_body {
        if jfmt_stmt_span(stmt).start > start -> return true
    }
    false
}

// Lex, parse, then format. Parse errors propagate; sema is not required.
jet_format_source: fn(src: String, simplify_requested: Bool) -> JetFormatResult {
    jfmt_format_source_in(src, simplify_requested, false)
}

// jet_format_source for a Core library or compiler prelude source. Those
// spell the reserved `__name` namespace, so they lex and parse as the loader
// reads embedded Core (parse_generated_source); a user file never formats
// this way.
jet_format_library_source: fn(src: String, simplify_requested: Bool) -> JetFormatResult {
    jfmt_format_source_in(src, simplify_requested, true)
}

jfmt_format_source_in: fn(src: String, simplify_requested: Bool, library: Bool) -> JetFormatResult {
    source: src.bytes()
    lexed: if library -> lex_generated(source) else -> lex(source)
    if lexed.diagnostics.len() > 0 -> return JetFormatResult{ok: false, text: "", diagnostics: lexed.diagnostics}
    simplify := simplify_requested
    parsed: if library -> parse_generated_source(source) else -> parse_source(source)
    if jfmt_check_parse_accepts(parsed.diagnostics) {
        // A recovered control-body diagnostic leaves only a recovery
        // scaffold; simplify must remain a no-op there.
        loop diagnostic in parsed.diagnostics {
            if diagnostic.severity != DIAGNOSTIC_LINT && diagnostic.code != "E0080" -> simplify = false
        }
    } else {
        simplify = false
        if !jfmt_fmt_parse_accepts(parsed.diagnostics) -> return JetFormatResult{ok: false, text: "", diagnostics: parsed.diagnostics}
    }
    prog := parsed.program
    // Dropping a redundant `Val(x)` rewrites the program itself.
    if simplify -> prog.items = jfmt_strip_redundant_optional_returns(prog.items)
    f := jfmt_new(prog, src, lexed.tokens, simplify)
    text: jfmt_format_program_with(f, prog)
    // Without simplify, a format changes layout only: the text must parse to
    // the same program. A source the parser had to recover is repaired on
    // purpose, so only a clean parse is compared.
    if !simplify_requested && text != src && jfmt_structure_clean(parsed.diagnostics) {
        // The source with its expanded assignments written as the compound
        // assignments the format printed.
        compared: jfmt_apply_source_edits(src, f.compound_rewrites) ?? src
        source_program: if library -> parse_generated_source(compared.bytes()).program else -> parse_source(compared.bytes()).program
        reparsed: if library -> parse_generated_source(text.bytes()) else -> parse_source(text.bytes())
        if jfmt_structure_change(source_program, reparsed.program, reparsed.diagnostics) == .Val(change) {
            return JetFormatResult{ok: false, text: "", diagnostics: [Diagnostic]{}, structure_change: Val(change)}
        }
    }
    JetFormatResult{ok: true, text: text, diagnostics: [Diagnostic]{}}
}

// The source spans of author grouping parentheses that the printed
// precedence does not need, in source order: `(a * b) + c` reports
// `(a * b)`, `(a + b) * c` reports nothing. Parens that span lines stay.
// None when the source does not lex or parse.
jet_format_redundant_grouping: fn(src: String) -> [Span]? {
    source: src.bytes()
    lexed: lex(source)
    if lexed.diagnostics.len() > 0 -> return None
    parsed: parse_source(source)
    if !jfmt_fmt_parse_accepts(parsed.diagnostics) -> return None
    f := jfmt_new(parsed.program, src, lexed.tokens, false)
    f.drop_grouping = true
    _ := jfmt_format_program_with(f, parsed.program)
    // A layout tried and rolled back visits the same parens again.
    spans := [Span]{}
    loop span in f.dropped_grouping {
        at := 0
        loop at < spans.len() && spans[at].start < span.start -> at += 1
        if at < spans.len() && spans[at].start == span.start -> next
        spans.insert(at, span.copy())
    }
    Val(spans)
}

jfmt_lines: fn(text: String) -> [String] Never! {
    lines := text.split("\n").to_list()
    // Rust `str::lines`: no final empty line after a trailing newline, and a
    // trailing `\r` is part of the line break.
    if lines.len() > 0 && lines[lines.len() - 1] == "" -> _ := lines.pop()
    loop index in 0..<lines.len() {
        bytes: lines[index].bytes()
        if bytes.len() > 0 && bytes[bytes.len() - 1] == 13 -> lines[index] = jfmt_bytes_text(bytes, 0, bytes.len() - 1)
    }
    lines
}

// The unified diff `jet fmt --check --diff` prints, without context lines.
// Its hunks are the runs of lines between those of a longest common
// subsequence, so a moved or unchanged line never prints as deleted and
// re-added. An empty side starts at the line it follows, as `diff -U0` writes.
jet_format_unified_diff: fn(path: String, old: String, new: String) -> String Never! {
    old_lines: jfmt_lines(old)
    new_lines: jfmt_lines(new)
    // Lines compare as numbers: equal text, equal number.
    numbers := [String:Int]{}
    a: loop line in old_lines -> jfmt_diff_line_number(numbers, line)
    b: loop line in new_lines -> jfmt_diff_line_number(numbers, line)
    old_kept := [Bool]{}
    new_kept := [Bool]{}
    loop _ in 0..<a.len() -> old_kept.push(false)
    loop _ in 0..<b.len() -> new_kept.push(false)
    jfmt_diff_mark(a, b, 0, a.len(), 0, b.len(), old_kept, new_kept)
    parts := [String]{"--- {path}\n+++ {path}\n"}
    i := 0
    j := 0
    loop i < a.len() || j < b.len() {
        // Kept lines pair up in order, so two kept lines are one common line.
        if i < a.len() && j < b.len() && old_kept[i] && new_kept[j] {
            i += 1
            j += 1
            next
        }
        start_i: i
        start_j: j
        loop i < a.len() && !old_kept[i] -> i += 1
        loop j < b.len() && !new_kept[j] -> j += 1
        parts.push("@@ -{jfmt_diff_hunk_start(start_i, i - start_i)},{i - start_i} +{jfmt_diff_hunk_start(start_j, j - start_j)},{j - start_j} @@\n")
        loop k in start_i..<i -> parts.push("-{old_lines[k]}\n")
        loop k in start_j..<j -> parts.push("+{new_lines[k]}\n")
    }
    parts.join("")
}

jfmt_diff_line_number: fn(numbers: &[String:Int], line: String) -> Int Never! {
    numbers.get(line) ?? {
        numbers[line.copy()] = numbers.len()
        numbers.len() - 1
    }
}

// A hunk side's 1-based first line; an empty side names the line it follows.
jfmt_diff_hunk_start: fn(start: Int, count: Int) -> Int Never! {
    if count == 0 -> start else -> start + 1
}

// Marks the lines of one longest common subsequence of `a[a_start..<a_end]`
// and `b[b_start..<b_end]`: the common ends, then each side of a middle
// point on a shortest edit path.
jfmt_diff_mark: fn(a: [Int], b: [Int], a_start: Int, a_end: Int, b_start: Int, b_end: Int, old_kept: &[Bool], new_kept: &[Bool]) Never! {
    a0 := a_start
    b0 := b_start
    a1 := a_end
    b1 := b_end
    loop a0 < a1 && b0 < b1 && a[a0] == b[b0] {
        old_kept[a0] = true
        new_kept[b0] = true
        a0 += 1
        b0 += 1
    }
    loop a0 < a1 && b0 < b1 && a[a1 - 1] == b[b1 - 1] {
        a1 -= 1
        b1 -= 1
        old_kept[a1] = true
        new_kept[b1] = true
    }
    if a0 == a1 || b0 == b1 -> return
    middle: jfmt_diff_middle(a, b, a0, a1, b0, b1) ?? return
    jfmt_diff_mark(a, b, a0, middle.old, b0, middle.new, old_kept, new_kept)
    jfmt_diff_mark(a, b, middle.old, a1, middle.new, b1, old_kept, new_kept)
}

// Myers' middle snake: a point on one shortest edit path through
// `a[a0..<a1]` and `b[b0..<b1]`, searched from both ends at once in linear
// space, or None when the ranges share no line. Each search keeps, per
// diagonal `k = x - y`, the furthest `x` its paths with `d` edits reach.
jfmt_diff_middle: fn(a: [Int], b: [Int], a0: Int, a1: Int, b0: Int, b1: Int) -> (old: Int, new: Int)? Never! {
    n: a1 - a0
    m: b1 - b0
    max_d: (n + m + 1) /% 2
    offset: max_d
    // Diagonals run from `-max_d` to `max_d`, and each step reads the slot
    // one past its own.
    size: 2 * max_d + 2
    forward := [Int]{}
    backward := [Int]{}
    loop _ in 0..<size {
        forward.push(-1)
        backward.push(-1)
    }
    forward[offset + 1] = 0
    backward[offset + 1] = 0
    delta: n - m
    // With an odd delta the forward search meets the backward paths first.
    front: delta % 2 != 0
    // Diagonals whose paths left the grid are not extended again.
    k1_start := 0
    k1_end := 0
    k2_start := 0
    k2_end := 0
    loop d in 0..<max_d {
        k1 := k1_start - d
        loop k1 <= d - k1_end {
            k1_at: offset + k1
            x1 := if k1 == -d || (k1 != d && forward[k1_at - 1] < forward[k1_at + 1]) -> forward[k1_at + 1] else -> forward[k1_at - 1] + 1
            y1 := x1 - k1
            loop x1 < n && y1 < m && a[a0 + x1] == b[b0 + y1] {
                x1 += 1
                y1 += 1
            }
            forward[k1_at] = x1
            if {
                x1 > n -> k1_end += 2
                y1 > m -> k1_start += 2
                front && jfmt_diff_reached(backward, offset + delta - k1, n - x1) -> return Val((old: a0 + x1, new: b0 + y1))
            }
            k1 += 2
        }
        k2 := k2_start - d
        loop k2 <= d - k2_end {
            k2_at: offset + k2
            x2 := if k2 == -d || (k2 != d && backward[k2_at - 1] < backward[k2_at + 1]) -> backward[k2_at + 1] else -> backward[k2_at - 1] + 1
            y2 := x2 - k2
            loop x2 < n && y2 < m && a[a1 - x2 - 1] == b[b1 - y2 - 1] {
                x2 += 1
                y2 += 1
            }
            backward[k2_at] = x2
            if {
                x2 > n -> k2_end += 2
                y2 > m -> k2_start += 2
                !front && jfmt_diff_reached(forward, offset + delta - k2, n - x2) -> {
                    x1: forward[offset + delta - k2]
                    return Val((old: a0 + x1, new: b0 + x1 - delta + k2))
                }
            }
            k2 += 2
        }
    }
    None
}

// Whether the other search's path on diagonal slot `at` has come at least
// `x` lines from its end, so the two searches overlap there.
jfmt_diff_reached: fn(furthest: [Int], at: Int, x: Int) -> Bool Never! {
    at >= 0 && at < furthest.len() && furthest[at] >= x
}
