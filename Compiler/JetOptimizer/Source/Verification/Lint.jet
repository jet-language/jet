// MIR Lint: the independent typed checker over canonical MIR. The rule list
// is the compiler contract in Docs/spec/mir-lint.md. The lint shares no code
// with the semantic checker or the legality verifier: it re-derives every
// operand and result type from the operation, every call from the callee row
// named by ID, every enum and struct shape from its declaration, ownership
// from one forward dataflow over sparse bit sets, and effect rows from the
// callee's solved row. The optimizer pipeline runs it once after the last
// pass, and after every pass when full verification is on; a failure is an
// internal compiler error that names the pass and the rule.
use jet_foundation.[
    MIRAccess,
    MIRBasicBlock,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBlockID,
    MIRCallArg,
    MIRCallee,
    MIRConstant,
    MIRConversion,
    MIREnumArg,
    MIRField,
    MIRFieldID,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIROperation,
    MIRValueConsumption,
    MIRParam,
    MIRCaptureParam,
    MIRPlace,
    MIRProjection,
    MIRPlaceID,
    MIRProgram,
    MIRSemanticOp,
    MIRType,
    MIRTypeDef,
    MIRTypeID,
    MIRValueID,
    MIRVariant,
    MIRViewCopyKind,
    MIRViewProvenanceEntry,
    Span,
    mir_call_metadata_is_variadic,
    mir_operation_value_uses,
    mir_operation_call_args,
    mir_value_consumption_requires_owner,
    mir_remainder_drop_results,
    mir_runtime_owned_ownership,
    mir_terminator_targets,
    mir_terminator_value_uses,
    mir_type_display_name,
    mir_type_has_valid_layout,
    mir_type_is_integer,
    mir_type_is_numeric,
    mir_type_is_unit,
    mir_view_copy_kind,
    mir_view_copy_target_matches,
]

// One rule family of Docs/spec/mir-lint.md; its name is part of the ICE text.
enum MIRLintRule {
    ValueTyped
    TypeWellFormed
    OperationTyping
    SemanticTyping
    CallSignature
    EnumVariant
    StructField
    TerminatorTyping
    OwnershipMove
    EffectRow
    AliasExclusive
    ViewValid
    SendBoundary
}

struct MIRLintError {
    rule: MIRLintRule
    function: MIRFunctionID
    function_key: String
    span: Span
    detail: String
}

fn mir_lint_rule_name(rule: MIRLintRule) -> String Never! {
    if rule == {
        .ValueTyped -> "value.typed"
        .TypeWellFormed -> "type.well-formed"
        .OperationTyping -> "operation.typing"
        .SemanticTyping -> "semantic.typing"
        .CallSignature -> "call.signature"
        .EnumVariant -> "enum.variant"
        .StructField -> "struct.field"
        .TerminatorTyping -> "terminator.typing"
        .OwnershipMove -> "ownership.move"
        .EffectRow -> "effect.row"
        .AliasExclusive -> "alias.exclusive"
        .ViewValid -> "view.valid"
        .SendBoundary -> "send.boundary"
    }
}

fn mir_lint_error_text(error: MIRLintError) -> String Never! {
    "rule {mir_lint_rule_name(error.rule)} in function `{error.function_key}`: {error.detail}"
}

// Check every function of `program` against the MIR Lint rules.
// Rust: none (Jet-only pass)
fn mir_lint_program(program: MIRProgram) -> MIRLintError? Never! {
    failures :: mir_lint_program_scan(program, false)
    if failures.len() == 0 -> return None
    Val(failures[0])
}

// Lint failures in program order, one per rejected function; without `all`
// the first failure ends the scan. `all` serves the keep-going driver, which
// traps every rejected function before one rerun. The program is read in
// place, so each function is copied into the context it is checked in; the
// optimizer's own final lint moves functions instead (mir_lint_owned_part).
fn mir_lint_program_scan(program: MIRProgram, all: Bool) -> [MIRLintError] Never! {
    failures := [MIRLintError]{}
    if program.functions.len() == 0 -> return failures
    // copy: the lint context owns the function it checks (owner: ctx.function, rewritten by
    // mir_lint_enter) while the read program keeps its own (owner: the caller); the owned-part lint
    // moves functions instead.
    ctx := mir_lint_context(mir_lint_index(program), program.functions[0].copy())
    loop position in 0..<program.functions.len() {
        if position > 0 {
            // copy: the lint context owns the function it checks (owner: ctx.function) while the
            // read program keeps its own (owner: the caller); the owned-part lint moves functions
            // instead.
            ctx.function = program.functions[position].copy()
            mir_lint_enter(&ctx)
        }
        failure :: mir_lint_function(ctx) ?? next
        &failures.push(failure)
        if !all -> return failures
    }
    failures
}

// Lint one part of a program whose functions are owned by the caller,
// last-first (the optimizer wave law, Pipeline mir_pass_wave): each function
// moves into the context, is checked, and moves back (a field move refilled
// in the same block, LastUse.jet), so the part again holds its functions
// last-first. Failures are in program order; without `all` the part stops at
// its first failure, leaving the unchecked functions in place.
fn mir_lint_owned_part(index: ^MIRLintIndex, functions: &[MIRFunction], all: Bool) -> [MIRLintError] Never! {
    failures := [MIRLintError]{}
    first := &functions.pop() ?? return failures
    ctx := mir_lint_context(^index, ^first)
    checked := [MIRFunction]{}
    loop {
        if mir_lint_function(ctx) == .Val(failure) {
            &failures.push(failure)
            if !all -> break
        }
        next_function := &functions.pop() ?? break
        previous := ^ctx.function
        ctx.function = ^next_function
        &checked.push(^previous)
        mir_lint_enter(&ctx)
    }
    current := ^ctx.function
    &functions.push(^current)
    loop {
        function := &checked.pop() ?? break
        &functions.push(^function)
    }
    failures
}

// A broken rule before the function and span are attached.
struct MIRLintProblem {
    rule: MIRLintRule
    detail: String
}

fn mir_lint_problem(rule: MIRLintRule, detail: String) -> MIRLintProblem? Never! {
    Val(MIRLintProblem{rule: rule, detail: detail})
}

// The representation class used by the compatibility relation.
enum MIRLintClass { Wild Unit Integer Float Bool String Char List Map Option Result Callable Nominal Tuple }

fn mir_lint_class_name(class: MIRLintClass) -> String Never! {
    if class == {
        .Wild -> "any"
        .Unit -> "Unit"
        .Integer -> "an integer"
        .Float -> "a float"
        .Bool -> "Bool"
        .String -> "String"
        .Char -> "Char"
        .List -> "a list"
        .Map -> "a map"
        .Option -> "an Optional"
        .Result -> "a Result"
        .Callable -> "a callable"
        .Nominal -> "a nominal type"
        .Tuple -> "a tuple"
    }
}

// The callee row a call is checked against, copied out of the program once.
struct MIRLintSignature {
    key: String
    params: [MIRParam]
    return_type: MIRType
    solved_effects: [String]
    capture_count: Int
    captures: [MIRCaptureParam]
    return_view_provenance: [MIRViewProvenanceEntry]?
}

// The declaration shape a literal, variant, or payload read is checked
// against: a struct's fields or an enum's variants.
struct MIRLintTypeRow {
    name: String
    fields: [MIRField]?
    variants: [MIRVariant]?
    target: MIRType?
}

struct MIRLintIndex {
    // Function ID -> row in `signatures`.
    functions: [U64:Int]
    signatures: [MIRLintSignature]
    // Type ID -> row in `type_rows`.
    types: [U64:Int]
    type_rows: [MIRLintTypeRow]
    fields: [U64:MIRField]
    // Generic parameter and associated-type names declared anywhere.
    type_vars: [String:Bool]
    // Names of `Alias`, `Distinct`, and unit-family declarations.
    transparent: [String:Bool]
    // Prelude route IDs of the boundary operations the safety families
    // recognise: `para_*` worker adapters, channel sends, and task joins.
    // Every route table is keyed by the route's ID word.
    parallel_routes: [U64:Bool]
    channel_sends: [U64:Bool]
    task_joins: [U64:Bool]
    borrow_masks: [U64:[Bool]]
}

// Rust: none (Jet-only pass)
fn mir_lint_index(program: MIRProgram) -> MIRLintIndex Never! {
    functions := [U64:Int]{}
    signatures := [MIRLintSignature]{}
    types := [U64:Int]{}
    type_rows := [MIRLintTypeRow]{}
    fields := [U64:MIRField]{}
    type_vars := [String:Bool]{}
    transparent := [String:Bool]{}
    _ := &type_vars.add("Self", true)
    loop position in 0..<program.functions.len() {
        _ := &functions.add(program.functions[position].id.value, position)
        // copy: each signature part (owner: the read `program` parameter, the caller's MIR) is
        // copied into the lint index (owner: the index, which outlives this read and is shared by
        // every lint worker); the program cannot give up its rows here.
        &signatures.push(MIRLintSignature{key: program.functions[position].key.copy(), params: program.functions[position].params.copy(), return_type: program.functions[position].return_type.copy(), solved_effects: program.functions[position].effects.solved.copy(), capture_count: program.functions[position].capture_params.len(), captures: program.functions[position].capture_params.copy(), return_view_provenance: program.functions[position].return_view_provenance.copy()})
        loop param in program.functions[position].generic_params -> _ := &type_vars.add(param.name.copy(), true)
    }
    loop position in 0..<program.types.len() {
        _ := &types.add(program.types[position].id.value, position)
        loop param in program.types[position].generic_params -> _ := &type_vars.add(param.name.copy(), true)
        row := MIRLintTypeRow{name: program.types[position].name.copy(), fields: None, variants: None, target: None}
        if program.types[position].kind == {
            .Alias(target) | .Distinct(target, _) -> {
                // copy: the alias target type (owner: the read `program` parameter, the caller's
                // MIR) is copied into the lint index (owner: the index, which outlives this read
                // and is shared by every lint worker); the program cannot give up its rows here.
                row.target = Val(target.copy())
                _ := &transparent.add(program.types[position].name.copy(), true)
                _ := &transparent.add(program.types[position].key.copy(), true)
                _ := &transparent.add(mir_lint_leaf(program.types[position].name), true)
            }
            .Struct(declared, _) -> {
                // copy: the struct field row (owner: the read `program` parameter, the caller's
                // MIR) is copied into the lint index (owner: the index, which outlives this read
                // and is shared by every lint worker); the program cannot give up its rows here.
                loop field in declared -> _ := &fields.add(field.id.value, field.copy())
                row.fields = Val(declared.copy())
            }
            .Enum(variants, _) -> row.variants = Val(variants.copy())
            else -> {
                _ := &transparent.add(program.types[position].name.copy(), true)
                _ := &transparent.add(program.types[position].key.copy(), true)
                _ := &transparent.add(mir_lint_leaf(program.types[position].name), true)
            }
        }
        &type_rows.push(row)
    }
    // copy: the program field row (owner: the read `program` parameter, the caller's MIR) is copied
    // into the lint index (owner: the index, which outlives this read and is shared by every lint
    // worker); the program cannot give up its rows here.
    loop row in program.fields -> _ := &fields.add(row.id.value, row.field.copy())
    loop row in program.traits {
        loop declaration in row.associated_types -> _ := &type_vars.add(declaration.name.copy(), true)
    }
    parallel_routes := [U64:Bool]{}
    channel_sends := [U64:Bool]{}
    task_joins := [U64:Bool]{}
    borrow_masks := [U64:[Bool]]{}
    loop call in program.prelude_calls {
        key :: call.id.value
        _ := &borrow_masks.add(key, call.signature.borrow_mask.copy())
        if call.member.starts_with("para_") -> _ := &parallel_routes.add(key, true)
        if call.module_name == "core.channels" && call.member == "sender.send" -> _ := &channel_sends.add(key, true)
        if call.module_name == "core.tasks" && call.member == "join" -> _ := &task_joins.add(key, true)
    }
    MIRLintIndex{functions: functions, signatures: signatures, types: types, type_rows: type_rows, fields: fields, type_vars: type_vars, transparent: transparent, parallel_routes: parallel_routes, channel_sends: channel_sends, task_joins: task_joins, borrow_masks: borrow_masks}
}

// Table key of a stable MIR ID (a U64 word), as its decimal text.
fn mir_lint_key(id: U64) -> String Never! {
    "{id}"
}

// The byte offset of the leaf: just after the last `.` or `:`, 0 when the
// name has neither (both separators are ASCII, so the cut is a character
// boundary).
fn mir_lint_leaf_start(name: String) -> Int Never! {
    start := 0
    loop (at, byte) in name.bytes() {
        if byte == (U8{46}) || byte == (U8{58}) -> start = at + 1
    }
    start
}

// The text after the last `.`, then after the last `:` in that: the bytes
// are scanned once, with no split lists.
fn mir_lint_leaf(name: String) -> String Never! {
    start :: mir_lint_leaf_start(name)
    if start == 0 -> return name.copy()
    bytes :: name.bytes()
    String.from_bytes(bytes.slice(start, bytes.len())) ?? name.copy()
}

// Whether the leaf of `name` (mir_lint_leaf) is `word`, compared in place
// without cutting the leaf out.
fn mir_lint_leaf_is(name: String, word: String) -> Bool Never! {
    bytes :: name.bytes()
    expected :: word.bytes()
    start :: mir_lint_leaf_start(name)
    if bytes.len() - start != expected.len() -> return false
    loop (at, byte) in expected {
        if bytes[start + at] != byte -> return false
    }
    true
}

// The text before the first `.`, or None when `name` has none.
fn mir_lint_dotted_head(name: String) -> String? Never! {
    bytes :: name.bytes()
    loop (at, byte) in bytes {
        if byte == (U8{46}) -> return Val(String.from_bytes(bytes.slice(0, at)) ?? "")
    }
    None
}

// Peel the carriers that share their inner representation.
fn mir_lint_reduce(ty: MIRType) -> MIRType Never! {
    if ty.kind == {
        .Tagged(_, inner) -> mir_lint_reduce(inner)
        .InlineRange(base, _, _) -> mir_lint_reduce(base)
        .Quantity(base, _) -> mir_lint_reduce(base)
        .Shared(inner) -> mir_lint_reduce(inner)
        else -> ty
    }
}

fn mir_lint_is_wild(index: MIRLintIndex, ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Measure(_) | .TraitObject(_) | .Union(_) -> true
        .Apply(name, args) -> {
            if args.len() == 0 {
                if name.name == "Never" || index.type_vars.get(name.name) != None -> return true
                if mir_lint_dotted_head(name.name) == .Val(head) {
                    if index.type_vars.get(head) != None -> return true
                }
            }
            if index.transparent.get(name.name) != None -> return true
            if index.transparent.len() == 0 -> return false
            // A name without a separator is its own leaf, just looked up.
            if mir_lint_leaf_start(name.name) == 0 -> return false
            index.transparent.get(mir_lint_leaf(name.name)) != None
        }
        else -> false
    }
}

// The class of `ty` after the carriers mir_lint_reduce peels, read through
// them in place rather than through a reduced copy.
fn mir_lint_class(index: MIRLintIndex, ty: MIRType) -> MIRLintClass Never! {
    if ty.kind == {
        .Tagged(_, inner) -> mir_lint_class(index, inner)
        .InlineRange(base, _, _) -> mir_lint_class(index, base)
        .Quantity(base, _) -> mir_lint_class(index, base)
        .Shared(inner) -> mir_lint_class(index, inner)
        else -> mir_lint_class_reduced(index, ty)
    }
}

// mir_lint_class of a type that is not a peeled carrier.
fn mir_lint_class_reduced(index: MIRLintIndex, reduced: MIRType) -> MIRLintClass Never! {
    if mir_lint_is_wild(index, reduced) -> return MIRLintClass.Wild
    if mir_type_is_unit(reduced) -> return MIRLintClass.Unit
    if reduced.kind == {
        .Int | .IntN(_, _) -> MIRLintClass.Integer
        .Float | .Float32 -> MIRLintClass.Float
        .Bool -> MIRLintClass.Bool
        .String -> MIRLintClass.String
        .Char -> MIRLintClass.Char
        .List(_) | .FixedList(_, _) -> MIRLintClass.List
        .Map(_, _) -> MIRLintClass.Map
        .Option(_) -> MIRLintClass.Option
        .Result(_, _) -> MIRLintClass.Result
        .Fn(_) | .SendFn(_, _, _) -> MIRLintClass.Callable
        .Tuple(fields) -> if fields.len() == 0 -> MIRLintClass.Unit else -> MIRLintClass.Tuple
        // A string view (`View<str>`) is a String: a string-view local reads
        // as String and a view fills a String slot as the same text handle
        // (MIRRust string_view_argument, JetBackend lower_string_view).
        .Apply(_, _) -> if mir_view_copy_kind(reduced) == (Val(MIRViewCopyKind.String)) -> MIRLintClass.String else -> MIRLintClass.Nominal
        else -> MIRLintClass.Wild
    }
}

fn mir_lint_element(ty: MIRType) -> MIRType? Never! {
    reduced :: mir_lint_reduce(ty)
    if reduced.kind == {
        .List(inner) -> Val(inner)
        .FixedList(elem, _) -> Val(elem)
        else -> None
    }
}

fn mir_lint_option_inner(ty: MIRType) -> MIRType? Never! {
    reduced :: mir_lint_reduce(ty)
    if reduced.kind == {
        .Option(inner) -> Val(inner)
        else -> None
    }
}

fn mir_lint_result_part(ty: MIRType, ok: Bool) -> MIRType? Never! {
    reduced :: mir_lint_reduce(ty)
    if reduced.kind == {
        .Result(success, failure) -> if ok -> Val(success) else -> Val(failure)
        else -> None
    }
}

// The one compatibility relation of the spec: representation classes agree,
// and structural children are compatible. Both sides are read through the
// carriers mir_lint_reduce peels, in place, so no check copies a type.
fn mir_lint_compatible(index: MIRLintIndex, expected: MIRType, actual: MIRType) -> Bool Never! {
    if expected.kind == {
        .Tagged(_, inner) -> mir_lint_compatible(index, inner, actual)
        .InlineRange(base, _, _) -> mir_lint_compatible(index, base, actual)
        .Quantity(base, _) -> mir_lint_compatible(index, base, actual)
        .Shared(inner) -> mir_lint_compatible(index, inner, actual)
        else -> mir_lint_compatible_with(index, expected, actual)
    }
}

// mir_lint_compatible once `left` is not a peeled carrier.
fn mir_lint_compatible_with(index: MIRLintIndex, left: MIRType, actual: MIRType) -> Bool Never! {
    if actual.kind == {
        .Tagged(_, inner) -> mir_lint_compatible_with(index, left, inner)
        .InlineRange(base, _, _) -> mir_lint_compatible_with(index, left, base)
        .Quantity(base, _) -> mir_lint_compatible_with(index, left, base)
        .Shared(inner) -> mir_lint_compatible_with(index, left, inner)
        else -> mir_lint_compatible_reduced(index, left, actual)
    }
}

// mir_lint_compatible of two types that are not peeled carriers.
fn mir_lint_compatible_reduced(index: MIRLintIndex, left: MIRType, right: MIRType) -> Bool Never! {
    left_class :: mir_lint_class_reduced(index, left)
    right_class :: mir_lint_class_reduced(index, right)
    if left_class == .Wild || right_class == .Wild -> return true
    if left_class != right_class -> return false
    if left.kind == {
        .List(left_element) -> mir_lint_compatible_element(index, left_element, right)
        .FixedList(left_element, _) -> mir_lint_compatible_element(index, left_element, right)
        .Option(left_inner) -> {
            if right.kind == .Option(right_inner) -> return mir_lint_compatible(index, left_inner, right_inner)
            true
        }
        .Map(left_key, left_value) -> {
            if right.kind == .Map(right_key, right_value) -> return mir_lint_compatible(index, left_key, right_key) && mir_lint_compatible(index, left_value, right_value)
            true
        }
        .Result(left_ok, left_err) -> {
            if right.kind == .Result(right_ok, right_err) -> return mir_lint_compatible(index, left_ok, right_ok) && mir_lint_compatible(index, left_err, right_err)
            true
        }
        .Apply(left_name, left_args) -> {
            if right.kind == .Apply(right_name, right_args) {
                same :: left_name.id == right_name.id || left_name.name == right_name.name || mir_lint_leaf(left_name.name) == mir_lint_leaf(right_name.name)
                if !same -> return false
                if left_args.len() != right_args.len() -> return true
                loop (position, arg) in left_args {
                    if !mir_lint_compatible(index, arg, right_args[position]) -> return false
                }
            }
            true
        }
        .Tuple(left_fields) -> {
            if right.kind == .Tuple(right_fields) {
                if left_fields.len() != right_fields.len() -> return false
                loop (position, field) in left_fields {
                    if !mir_lint_compatible(index, field.ty, right_fields[position].ty) -> return false
                }
            }
            true
        }
        else -> true
    }
}

// A list element of `left` against the element of `right`, a list of the
// same class (List or FixedList).
fn mir_lint_compatible_element(index: MIRLintIndex, left_element: MIRType, right: MIRType) -> Bool Never! {
    if right.kind == {
        .List(right_element) -> mir_lint_compatible(index, left_element, right_element)
        .FixedList(right_element, _) -> mir_lint_compatible(index, left_element, right_element)
        else -> true
    }
}

fn mir_lint_kind_callable(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Fn(_) | .SendFn(_, _, _) -> true
        else -> false
    }
}

// The 23 type-kind rules; the reason the type is malformed, if it is.
fn mir_lint_type_problem(ty: MIRType) -> String? Never! {
    if !mir_type_has_valid_layout(ty) -> return Val("stored layout does not match the type kind")
    mir_lint_kind_problem(ty)
}

fn mir_lint_kinds_problem(types: [MIRType]) -> String? Never! {
    loop ty in types {
        problem :: mir_lint_kind_problem(ty)
        if problem != None -> return problem
    }
    None
}

fn mir_lint_kind_problem(ty: MIRType) -> String? Never! {
    if ty.kind == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .Measure(_) -> None
        .List(inner) | .Shared(inner) | .Option(inner) -> mir_lint_kind_problem(inner)
        .FixedList(elem, _) -> mir_lint_kind_problem(elem)
        .Map(key, value) -> {
            if mir_lint_kind_callable(key) -> return Val("map key is callable")
            mir_lint_kinds_problem([MIRType]{key, value})
        }
        // copy: `ok` and `err` are payloads of read parameter `ty`, which keeps the originals; the list literal owns `ok` and `err`
        .Result(ok, err) -> mir_lint_kinds_problem([MIRType]{ok.copy(), err.copy()})
        .Fn(signature) -> {
            arity :: signature.params.len()
            if signature.call_metadata == .Val(metadata) {
                if (metadata.names.len() != 0 && metadata.names.len() != arity) || (metadata.defaults.len() != 0 && metadata.defaults.len() != arity) || (metadata.variadic.len() != 0 && metadata.variadic.len() != arity) {
                    return Val("callable metadata does not have one row per parameter")
                }
            }
            if signature.param_contract == .Val(rows) {
                if rows.len() != arity -> return Val("callable parameter contract does not have one row per parameter")
            }
            problem :: mir_lint_kinds_problem(signature.params)
            if problem != None -> return problem
            ret :: signature.ret ?? return None
            mir_lint_kind_problem(ret)
        }
        .SendFn(params, ret, conventions) -> {
            if conventions.len() != 0 && conventions.len() != params.len() -> return Val("send callable does not have one convention per parameter")
            problem :: mir_lint_kinds_problem(params)
            if problem != None -> return problem
            result :: ret ?? return None
            mir_lint_kind_problem(result)
        }
        .Apply(name, args) -> {
            if name.name == "" -> return Val("nominal type has no name")
            mir_lint_kinds_problem(args)
        }
        .TraitObject(bounds) -> if bounds.len() == 0 -> Val("trait object has no bound") else -> None
        .Tuple(fields) -> {
            loop (position, field) in fields {
                if field.name != "" {
                    loop earlier in 0..<position {
                        if fields[earlier].name == field.name -> return Val("tuple repeats field name `{field.name}`")
                    }
                }
                problem :: mir_lint_kind_problem(field.ty)
                if problem != None -> return problem
            }
            None
        }
        .IntN(_, bits) -> if bits < 1 || bits > 64 -> Val("fixed-width integer is not 1 to 64 bits") else -> None
        .InlineRange(base, lo, hi) -> {
            if lo > hi -> return Val("inline range bounds are inverted")
            if !mir_type_is_integer(base) && !mir_lint_is_char(base) -> return Val("inline range base is not an integer")
            mir_lint_kind_problem(base)
        }
        .Tagged(marker, inner) -> {
            if marker == .User(name) {
                if name == "" -> return Val("user tag has no name")
            }
            mir_lint_kind_problem(inner)
        }
        .Union(members) -> {
            if members.len() < 2 -> return Val("union has fewer than two members")
            mir_lint_kinds_problem(members)
        }
        .Quantity(base, _) -> {
            if !mir_type_is_numeric(base) -> return Val("quantity base is not numeric")
            mir_lint_kind_problem(base)
        }
    }
}

fn mir_lint_is_char(ty: MIRType) -> Bool Never! {
    if mir_lint_reduce(ty).kind == {
        .Char -> true
        else -> false
    }
}

fn mir_lint_is_bool(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Bool -> true
        else -> false
    }
}

// The program index and the lookup rows of the function being checked. The
// context owns that function; mir_lint_enter builds its lookup rows. Every
// table is keyed by the raw U64 ID.
struct MIRLintContext {
    index: MIRLintIndex
    function: MIRFunction
    // Value ID -> row in `function.values`.
    values: [U64:Int]
    // Place ID -> row in `function.places`.
    places: [U64:Int]
    // Block ID -> position in `function.blocks`.
    blocks: [U64:Int]
    // Block position -> predecessor block IDs.
    predecessors: [[MIRBlockID]]
}

fn mir_lint_context(index: ^MIRLintIndex, function: ^MIRFunction) -> MIRLintContext Never! {
    ctx := MIRLintContext{index: ^index, function: ^function, values: [U64:Int]{}, places: [U64:Int]{}, blocks: [U64:Int]{}, predecessors: [[MIRBlockID]]{}}
    mir_lint_enter(&ctx)
    ctx
}

// Build the lookup rows of the function the context now holds.
fn mir_lint_enter(ctx: &MIRLintContext) Never! {
    values := [U64:Int]{}
    loop (row, fact) in ctx.function.values -> _ := &values.add(fact.id.value, row)
    places := [U64:Int]{}
    loop (row, place) in ctx.function.places -> _ := &places.add(place.id.value, row)
    blocks := [U64:Int]{}
    predecessors := [[MIRBlockID]]{}
    loop (position, block) in ctx.function.blocks {
        _ := &blocks.add(block.id.value, position)
        &predecessors.push([MIRBlockID]{})
    }
    loop block in ctx.function.blocks {
        loop target in mir_terminator_targets(block.terminator) {
            position :: blocks.get(target.value) ?? next
            &predecessors[position].push(block.id)
        }
    }
    ctx.values = values
    ctx.places = places
    ctx.blocks = blocks
    ctx.predecessors = predecessors
}

fn mir_lint_fail(ctx: MIRLintContext, rule: MIRLintRule, span: Span, detail: String) -> MIRLintError? Never! {
    Val(MIRLintError{rule: rule, function: ctx.function.id, function_key: ctx.function.key, span: span, detail: detail})
}

fn mir_lint_type_of(ctx: MIRLintContext, value: MIRValueID) -> MIRType? Never! {
    row :: ctx.values.get(value.value) ?? return None
    Val(ctx.function.values[row].ty)
}

fn mir_lint_place(ctx: MIRLintContext, place: MIRPlaceID) -> MIRPlace? Never! {
    row :: ctx.places.get(place.value) ?? return None
    Val(ctx.function.places[row])
}

// `type.well-formed` failed for `ty` with `reason`; `what` names the row.
// Callers build `what` only once a type is known to be malformed, so a
// well-formed row costs no text.
fn mir_lint_malformed(ctx: MIRLintContext, ty: MIRType, span: Span, what: String, reason: String) -> MIRLintError? Never! {
    mir_lint_fail(ctx, .TypeWellFormed, span, "{what} type {mir_type_display_name(ty)}: {reason}")
}

fn mir_lint_function(ctx: MIRLintContext) -> MIRLintError? Never! {
    function :: ctx.function
    loop param in function.params {
        reason :: mir_lint_type_problem(param.ty) ?? next
        return mir_lint_malformed(ctx, param.ty, param.span, "parameter `{param.name}`", reason)
    }
    loop local in function.locals {
        reason :: mir_lint_type_problem(local.ty) ?? next
        return mir_lint_malformed(ctx, local.ty, local.span, "local `{local.name}`", reason)
    }
    loop place in function.places {
        reason :: mir_lint_type_problem(place.ty) ?? next
        return mir_lint_malformed(ctx, place.ty, place.span, "place {place.id.value}", reason)
    }
    loop fact in function.values {
        reason :: mir_lint_type_problem(fact.ty) ?? next
        return mir_lint_malformed(ctx, fact.ty, fact.span, "value {fact.id.value}", reason)
    }
    loop (position, block) in function.blocks {
        loop instruction in block.instructions {
            row_problem :: mir_lint_result_row(ctx, instruction)
            if row_problem == .Val(problem) -> return mir_lint_fail(ctx, problem.rule, instruction.span, problem.detail)
            loop value in mir_operation_value_uses(instruction.operation) {
                if ctx.values.get(value.value) == None -> return mir_lint_fail(ctx, .ValueTyped, instruction.span, "operand {value.value} has no typed definition")
            }
            operation_problem :: mir_lint_operation(ctx, position, instruction)
            if operation_problem == .Val(problem) -> return mir_lint_fail(ctx, problem.rule, instruction.span, problem.detail)
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            if ctx.values.get(value.value) == None -> return mir_lint_fail(ctx, .ValueTyped, block.span, "terminator operand {value.value} has no typed definition")
        }
        terminator_problem :: mir_lint_terminator(ctx, block)
        if terminator_problem == .Val(problem) -> return mir_lint_fail(ctx, problem.rule, block.span, problem.detail)
    }
    defs :: mir_lint_defs(function)
    static_failure :: mir_lint_safety_static(ctx, defs)
    if static_failure != None -> return static_failure
    mir_lint_ownership(ctx, ^defs)
}

// `value.typed`: a result and its type travel together, and the result's
// value row agrees with the instruction type.
fn mir_lint_result_row(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    if instruction.result == .Val(result) {
        ty :: instruction.ty ?? return mir_lint_problem(.ValueTyped, "result {result.value} has no type")
        row :: ctx.values.get(result.value) ?? return mir_lint_problem(.ValueTyped, "result {result.value} has no value row")
        return mir_lint_expect(ctx, .ValueTyped, "result value row", ty, ctx.function.values[row].ty)
    }
    if instruction.ty != None -> return mir_lint_problem(.ValueTyped, "an instruction without a result carries a type")
    None
}

// `actual` (an operand or result) must be compatible with `expected`.
fn mir_lint_expect(ctx: MIRLintContext, rule: MIRLintRule, what: String, expected: MIRType, actual: MIRType) -> MIRLintProblem? Never! {
    if mir_lint_compatible(ctx.index, expected, actual) -> return None
    mir_lint_problem(rule, "{what} has type {mir_type_display_name(actual)} where {mir_type_display_name(expected)} is required")
}

fn mir_lint_expect_class(ctx: MIRLintContext, rule: MIRLintRule, what: String, ty: MIRType, classes: [MIRLintClass]) -> MIRLintProblem? Never! {
    class :: mir_lint_class(ctx.index, ty)
    if class == .Wild || classes.contains(class) -> return None
    names := [String]{}
    loop expected in classes -> &names.push(mir_lint_class_name(expected))
    joined :: names.join(" or ")
    mir_lint_problem(rule, "{what} has type {mir_type_display_name(ty)}, expected {joined}")
}

fn mir_lint_expect_value(ctx: MIRLintContext, rule: MIRLintRule, what: String, expected: MIRType, value: MIRValueID) -> MIRLintProblem? Never! {
    row :: ctx.values.get(value.value) ?? return None
    mir_lint_expect(ctx, rule, what, expected, ctx.function.values[row].ty)
}

fn mir_lint_expect_value_class(ctx: MIRLintContext, rule: MIRLintRule, what: String, value: MIRValueID, classes: [MIRLintClass]) -> MIRLintProblem? Never! {
    row :: ctx.values.get(value.value) ?? return None
    mir_lint_expect_class(ctx, rule, what, ctx.function.values[row].ty, classes)
}

fn mir_lint_bool() -> [MIRLintClass] Never! { [MIRLintClass]{MIRLintClass.Bool} }

fn mir_lint_integer() -> [MIRLintClass] Never! { [MIRLintClass]{MIRLintClass.Integer} }

fn mir_lint_numeric() -> [MIRLintClass] Never! { [MIRLintClass]{MIRLintClass.Integer, MIRLintClass.Float} }

fn mir_lint_callable() -> [MIRLintClass] Never! { [MIRLintClass]{MIRLintClass.Callable, MIRLintClass.Nominal} }

fn mir_lint_no_result(rule: MIRLintRule) -> MIRLintProblem? Never! {
    mir_lint_problem(rule, "the operation must produce a result")
}

fn mir_lint_without_result(instruction: MIRInstruction, what: String) -> MIRLintProblem? Never! {
    if instruction.ty != None -> return mir_lint_problem(.OperationTyping, "{what} produces a result")
    None
}

// `operation.typing`, with `struct.field`, `enum.variant`, `call.signature`,
// and `effect.row` for the operations that name declarations. The match is
// split across `mir_lint_operation_*` helpers (each takes the operations the
// previous one does not) so no single lowered body grows with every arm.
fn mir_lint_operation(ctx: MIRLintContext, position: Int, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .Parameter(slot, _) -> {
            if slot < 0 || slot >= ctx.function.params.len() -> return mir_lint_problem(op, "parameter {slot} does not exist")
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect(ctx, op, "parameter", ctx.function.params[slot].ty, ty)
        }
        .Capture(slot) -> {
            if slot < 0 || slot >= ctx.function.capture_params.len() -> return mir_lint_problem(op, "capture slot {slot} does not exist")
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect(ctx, op, "capture", ctx.function.capture_params[slot].ty, ty)
        }
        .Global(name) -> {
            if name == "" -> return mir_lint_problem(op, "global has no name")
            if result == None -> return mir_lint_no_result(op)
            None
        }
        .Phi(incoming) -> {
            ty :: result ?? return mir_lint_no_result(op)
            if incoming.len() == 0 -> return mir_lint_problem(op, "phi has no incoming edge")
            loop edge in incoming {
                if !ctx.predecessors[position].contains(edge.block) -> return mir_lint_problem(op, "phi edge from block {edge.block.value} is not a predecessor")
                problem :: mir_lint_expect_value(ctx, op, "phi input", ty, edge.value)
                if problem != None -> return problem
            }
            None
        }
        .ReadPlace(place) | .MovePlace(place) -> {
            row :: mir_lint_place(ctx, place) ?? return mir_lint_problem(op, "place {place.value} does not exist")
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect(ctx, op, "place read", row.ty, ty)
        }
        .WritePlace(place, value) | .ReplacePlace(place, value) -> {
            row :: mir_lint_place(ctx, place) ?? return mir_lint_problem(op, "place {place.value} does not exist")
            if result != None -> return mir_lint_problem(op, "place write produces a result")
            mir_lint_expect_value(ctx, op, "written value", row.ty, value)
        }
        .InitializeUninit(place) -> {
            if mir_lint_place(ctx, place) == None -> return mir_lint_problem(op, "place {place.value} does not exist")
            mir_lint_without_result(instruction, "initialization")
        }
        .Copy(value, fact) -> {
            ty :: result ?? return mir_lint_no_result(op)
            operand :: mir_lint_type_of(ctx, value) ?? return None
            // A view materialization (`view.copy()`) reads a View and produces the
            // owning collection its copy kernel builds (View<str> -> String,
            // View<T> -> [T]); every other copy keeps the operand's type.
            if fact == .ViewMaterialize && mir_lint_view_materializes(operand, ty) -> return None
            mir_lint_expect(ctx, op, "result", operand, ty)
        }
        .Move(value) | .AttachTag(value, _) -> {
            ty :: result ?? return mir_lint_no_result(op)
            operand :: mir_lint_type_of(ctx, value) ?? return None
            mir_lint_expect(ctx, op, "result", operand, ty)
        }
        .TraitBox(_, _) | .PatternCapture(_, _) -> if result == None -> mir_lint_no_result(op) else -> None
        else -> mir_lint_operation_values(ctx, instruction)
    }
}

// `Copy{v, view_materialize}`: the result owns what the view's copy kernel
// builds from `v`.
// Rust: none (Jet-only pass)
fn mir_lint_view_materializes(source: MIRType, result: MIRType) -> Bool Never! {
    kind :: mir_view_copy_kind(source) ?? return false
    mir_view_copy_target_matches(kind, result)
}

// `mir_lint_operation` for constants, unary and binary operators and strings.
fn mir_lint_operation_values(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .Constant(constant) -> {
            ty :: result ?? return mir_lint_no_result(op)
            class :: mir_lint_class(ctx.index, ty)
            if class == .Wild || class == .Nominal -> return None
            expected :: if constant == {
                .Int(_, _, _) | .BigInt(_) -> Val(MIRLintClass.Integer)
                .Float(_, _, _) -> Val(MIRLintClass.Float)
                .Bool(_) -> Val(MIRLintClass.Bool)
                .Char(_) -> Val(MIRLintClass.Char)
                .String(_) -> Val(MIRLintClass.String)
                .Unit -> Val(MIRLintClass.Unit)
                else -> None
            }
            if expected == .Val(wanted) {
                if wanted != class -> return mir_lint_problem(op, "constant has type {mir_type_display_name(ty)}, expected {mir_lint_class_name(wanted)}")
            }
            None
        }
        .Unary(unary, value) -> {
            ty :: result ?? return mir_lint_no_result(op)
            operand :: mir_lint_type_of(ctx, value) ?? return None
            classes :: if unary == {
                .Neg -> mir_lint_numeric()
                .Not -> [MIRLintClass]{MIRLintClass.Bool, MIRLintClass.Integer}
            }
            problem :: mir_lint_expect_class(ctx, op, "unary operand", operand, classes)
            if problem != None -> return problem
            mir_lint_expect(ctx, op, "result", operand, ty)
        }
        .Binary(binary, dispatch, _, left, right) -> {
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_binary(ctx, binary, mir_lint_is_primitive(dispatch), left, right, ty)
        }
        .BuildString(_) -> {
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect_class(ctx, op, "string result", ty, [MIRLintClass]{MIRLintClass.String, MIRLintClass.Nominal})
        }
        else -> mir_lint_operation_collections(ctx, instruction)
    }
}

// `mir_lint_operation` for list and map literals and enum and carrier tests.
fn mir_lint_operation_collections(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .BuildList(values, trait_coercion) -> {
            ty :: result ?? return mir_lint_no_result(op)
            problem :: mir_lint_expect_class(ctx, op, "list result", ty, [MIRLintClass]{MIRLintClass.List, MIRLintClass.Nominal})
            if problem != None -> return problem
            if trait_coercion != None -> return None
            element :: mir_lint_element(ty) ?? return None
            loop value in values {
                element_problem :: mir_lint_expect_value(ctx, op, "list element", element, value)
                if element_problem != None -> return element_problem
            }
            None
        }
        .BuildMap(entries) -> {
            ty :: result ?? return mir_lint_no_result(op)
            problem :: mir_lint_expect_class(ctx, op, "map result", ty, [MIRLintClass]{MIRLintClass.Map, MIRLintClass.Nominal})
            if problem != None -> return problem
            if mir_lint_reduce(ty).kind == .Map(key, value) {
                loop entry in entries {
                    key_problem :: mir_lint_expect_value(ctx, op, "map key", key, entry.key)
                    if key_problem != None -> return key_problem
                    value_problem :: mir_lint_expect_value(ctx, op, "map value", value, entry.value)
                    if value_problem != None -> return value_problem
                }
            }
            None
        }
        .MapLookup(map, key, cache) -> {
            ty :: result ?? return mir_lint_no_result(op)
            map_place :: mir_lint_place(ctx, map) ?? return mir_lint_no_result(op)
            if mir_lint_reduce(map_place.ty).kind == .Map(key_ty, _) -> return mir_lint_expect_value(ctx, op, "map lookup key", key_ty, key)
            mir_lint_problem(op, "map lookup requires a map read window")
        }
        .EnumIs(_, owner, variant) -> {
            ty :: result ?? return mir_lint_no_result(op)
            problem :: mir_lint_expect_class(ctx, op, "variant test", ty, mir_lint_bool())
            if problem != None -> return problem
            lookup :: mir_lint_variant(ctx, owner, variant)
            lookup.problem
        }
        .EnumPayload(_, owner, variant, slot) -> {
            ty :: result ?? return mir_lint_no_result(op)
            lookup :: mir_lint_variant(ctx, owner, variant)
            if lookup.problem != None -> return lookup.problem
            row :: lookup.variant ?? return None
            payload :: if row.payload == {
                .Single(value) -> if slot == 0 -> Val(value) else -> None
                .Named(fields) -> if slot >= 0 && slot < fields.len() -> Val(fields[slot].ty) else -> None
                .Unit -> None
            }
            declared :: payload ?? return mir_lint_problem(.EnumVariant, "variant {variant} has no payload slot {slot}")
            mir_lint_expect(ctx, .EnumVariant, "payload", declared, ty)
        }
        .OptionIsSome(subject) -> mir_lint_carrier_test(ctx, instruction, subject, MIRLintClass.Option)
        .ResultIsOk(subject) -> mir_lint_carrier_test(ctx, instruction, subject, MIRLintClass.Result)
        else -> mir_lint_operation_payloads(ctx, instruction)
    }
}

// `mir_lint_operation` for carrier payloads, pattern tests and projections.
fn mir_lint_operation_payloads(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .OptionValue(subject) -> {
            ty :: result ?? return mir_lint_no_result(op)
            carrier :: mir_lint_type_of(ctx, subject) ?? return None
            problem :: mir_lint_expect_class(ctx, op, "subject", carrier, [MIRLintClass]{MIRLintClass.Option})
            if problem != None -> return problem
            inner :: mir_lint_option_inner(carrier) ?? return None
            mir_lint_expect(ctx, op, "Optional payload", inner, ty)
        }
        .ResultValue(subject, ok) -> {
            ty :: result ?? return mir_lint_no_result(op)
            carrier :: mir_lint_type_of(ctx, subject) ?? return None
            problem :: mir_lint_expect_class(ctx, op, "subject", carrier, [MIRLintClass]{MIRLintClass.Result})
            if problem != None -> return problem
            part :: mir_lint_result_part(carrier, ok) ?? return None
            mir_lint_expect(ctx, op, "Result payload", part, ty)
        }
        .PatternMatched(_) -> {
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect_class(ctx, op, "pattern test", ty, mir_lint_bool())
        }
        .ProjectMembers(_, members) -> {
            if members.len() == 0 -> return mir_lint_problem(op, "member projection is empty")
            loop (member_position, member) in members {
                if ctx.index.fields.get(member.value) == None -> return mir_lint_problem(.StructField, "field {member.value} is not declared")
                loop earlier in 0..<member_position {
                    if members[earlier] == member -> return mir_lint_problem(.StructField, "member projection repeats field {member.value}")
                }
            }
            None
        }
        else -> mir_lint_operation_access(ctx, instruction)
    }
}

// `mir_lint_operation` for indexing, slices, ranges and field reads.
fn mir_lint_operation_access(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .Index(_, base, key, kind, access, _, _) -> {
            base_type :: mir_lint_type_of(ctx, base) ?? return None
            key_type :: mir_lint_type_of(ctx, key) ?? return None
            if kind == {
                .List | .FixedListProof | .Lane -> {
                    problem :: mir_lint_expect_class(ctx, op, "index", key_type, mir_lint_integer())
                    if problem != None -> return problem
                    if access != .Read -> return None
                    ty :: result ?? return None
                    element :: mir_lint_element(base_type) ?? return None
                    mir_lint_expect(ctx, op, "element", element, ty)
                }
                .Map -> {
                    if mir_lint_reduce(base_type).kind == .Map(map_key, map_value) {
                        problem :: mir_lint_expect(ctx, op, "map key", map_key, key_type)
                        if problem != None -> return problem
                        if access != .Read -> return None
                        ty :: result ?? return None
                        if mir_lint_compatible(ctx.index, map_value, ty) -> return None
                        inner :: mir_lint_option_inner(ty) ?? return mir_lint_problem(op, "map read has type {mir_type_display_name(ty)} for values of {mir_type_display_name(map_value)}")
                        if !mir_lint_compatible(ctx.index, map_value, inner) -> return mir_lint_problem(op, "map read has type {mir_type_display_name(ty)} for values of {mir_type_display_name(map_value)}")
                    }
                    None
                }
                .Pool -> None
            }
        }
        .Slice(_, _, start, end, _, _) -> {
            problem :: mir_lint_expect_value_class(ctx, op, "slice start", start, mir_lint_integer())
            if problem != None -> return problem
            mir_lint_expect_value_class(ctx, op, "slice end", end, mir_lint_integer())
        }
        .Range(start, end, _) | .LoopRangeInit(_, start, end, _, _) -> {
            start_type :: mir_lint_type_of(ctx, start) ?? return None
            mir_lint_expect_value(ctx, op, "range end", start_type, end)
        }
        .Field(_, field) -> {
            declared :: ctx.index.fields.get(field.value) ?? return mir_lint_problem(.StructField, "field {field.value} is not declared")
            ty :: result ?? return mir_lint_no_result(op)
            if mir_lint_compatible(ctx.index, declared.ty, ty) -> return None
            mir_lint_expect(ctx, .StructField, "field `{declared.name}`", declared.ty, ty)
        }
        else -> mir_lint_operation_construction(ctx, instruction)
    }
}

// `mir_lint_operation` for struct, enum, tuple and carrier construction and
// conversions.
fn mir_lint_operation_construction(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .Struct(type_id, fields) -> {
            if result == None -> return mir_lint_no_result(op)
            mir_lint_struct_fields(ctx, type_id, fields, [MIRFieldID]{}, true)
        }
        .Enum(type_id, variant, args) -> {
            if result == None -> return mir_lint_no_result(op)
            mir_lint_enum_construction(ctx, type_id, variant, args)
        }
        .Tuple(_, fields) -> {
            ty :: result ?? return mir_lint_no_result(op)
            if mir_lint_reduce(ty).kind == .Tuple(slots) {
                if slots.len() != fields.len() -> return mir_lint_problem(op, "tuple of {fields.len()} fields has type {mir_type_display_name(ty)}")
                return None
            }
            mir_lint_expect_class(ctx, op, "tuple result", ty, [MIRLintClass]{MIRLintClass.Tuple, MIRLintClass.Unit, MIRLintClass.Nominal})
        }
        .Present(value) -> {
            ty :: result ?? return mir_lint_no_result(op)
            problem :: mir_lint_expect_class(ctx, op, "present result", ty, [MIRLintClass]{MIRLintClass.Option})
            if problem != None -> return problem
            inner :: mir_lint_option_inner(ty) ?? return None
            mir_lint_expect_value(ctx, op, "present value", inner, value)
        }
        .Absent -> {
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect_class(ctx, op, "absent result", ty, [MIRLintClass]{MIRLintClass.Option})
        }
        .ResultOk(value) -> mir_lint_result_carrier(ctx, instruction, value, true)
        .ResultErr(value) -> mir_lint_result_carrier(ctx, instruction, value, false)
        .Convert(value, _, _, conversion) -> {
            ty :: result ?? return mir_lint_no_result(op)
            if mir_lint_is_numeric_cast(conversion) {
                problem :: mir_lint_expect_value_class(ctx, op, "cast source", value, mir_lint_numeric())
                if problem != None -> return problem
                return mir_lint_expect_class(ctx, op, "cast target", ty, mir_lint_numeric())
            }
            None
        }
        else -> mir_lint_operation_calls(ctx, instruction)
    }
}

// `mir_lint_operation` for calls, closures, addresses, loop tests, scopes and
// semantic operations.
fn mir_lint_operation_calls(ctx: MIRLintContext, instruction: MIRInstruction) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    result :: instruction.ty
    if instruction.operation == {
        .Call(callee, args, _) -> mir_lint_call(ctx, instruction, callee, args)
        .IndirectCall(callee, args, _) -> {
            callee_type :: mir_lint_type_of(ctx, callee) ?? return None
            problem :: mir_lint_expect_class(ctx, .CallSignature, "indirect callee", callee_type, mir_lint_callable())
            if problem != None -> return problem
            arity :: if mir_lint_reduce(callee_type).kind == {
                .Fn(signature) -> {
                    variadic :: if signature.call_metadata == .Val(metadata) -> mir_call_metadata_is_variadic(metadata) else -> false
                    if variadic -> -1 else -> signature.params.len()
                }
                .SendFn(params, _, _) -> params.len()
                else -> -1
            }
            if arity < 0 || mir_lint_has_spread(args) -> return None
            if args.len() > arity -> return mir_lint_problem(.CallSignature, "indirect call passes {args.len()} arguments to {arity} parameters")
            None
        }
        .Closure(target, captures, _) -> {
            target_position :: ctx.index.functions.get(target.value) ?? return mir_lint_problem(op, "closure function {target.value} does not exist")
            signature :: ctx.index.signatures[target_position]
            if signature.capture_count != captures.len() -> return mir_lint_problem(op, "closure passes {captures.len()} captures to {signature.capture_count} capture slots")
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect_class(ctx, op, "closure", ty, mir_lint_callable())
        }
        .PtrFromAddr(address, _) -> mir_lint_expect_value_class(ctx, op, "address", address, mir_lint_integer())
        .RawAddressOf(place) | .AddressOf(place, _) -> {
            if mir_lint_place(ctx, place) == None -> return mir_lint_problem(op, "place {place.value} does not exist")
            None
        }
        .LoopRangeHasNext(_, _) | .LoopIterHasNext(_, _) -> {
            ty :: result ?? return mir_lint_no_result(op)
            mir_lint_expect_class(ctx, op, "loop test", ty, mir_lint_bool())
        }
        .ScopeEnter(scope, _) | .ScopeExit(scope) -> {
            loop row in ctx.function.scopes {
                if row.id == scope -> return None
            }
            mir_lint_problem(op, "scope {scope.value} does not exist")
        }
        .Semantic(semantic) -> mir_lint_semantic(ctx, instruction, semantic)
        else -> None
    }
}

fn mir_lint_is_primitive(dispatch: MIRBinaryDispatch) -> Bool Never! {
    if dispatch == {
        .Primitive -> true
        else -> false
    }
}

fn mir_lint_is_numeric_cast(conversion: MIRConversion) -> Bool Never! {
    if conversion == {
        .NumericCast -> true
        else -> false
    }
}

fn mir_lint_binary(ctx: MIRLintContext, binary: MIRBinaryOp, primitive: Bool, left: MIRValueID, right: MIRValueID, ty: MIRType) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    if binary == .Eq || binary == .Ne || binary == .Lt || binary == .Gt || binary == .Le || binary == .Ge -> return mir_lint_expect_class(ctx, op, "comparison result", ty, mir_lint_bool())
    if !primitive || binary == .Compare -> return None
    left_type :: mir_lint_type_of(ctx, left) ?? return None
    right_type :: mir_lint_type_of(ctx, right) ?? return None
    if binary == .And || binary == .Or {
        problem := mir_lint_expect_class(ctx, op, "logical operand", left_type, mir_lint_bool())
        if problem != None -> return problem
        problem = mir_lint_expect_class(ctx, op, "logical operand", right_type, mir_lint_bool())
        if problem != None -> return problem
        return mir_lint_expect_class(ctx, op, "logical result", ty, mir_lint_bool())
    }
    if binary == .Shl || binary == .Shr {
        problem := mir_lint_expect_class(ctx, op, "shifted operand", left_type, mir_lint_integer())
        if problem != None -> return problem
        problem = mir_lint_expect_class(ctx, op, "shift amount", right_type, mir_lint_integer())
        if problem != None -> return problem
        return mir_lint_expect(ctx, op, "shift result", left_type, ty)
    }
    if binary == .Pow -> return mir_lint_expect(ctx, op, "power result", left_type, ty)
    problem :: mir_lint_expect(ctx, op, "right operand", left_type, right_type)
    if problem != None || binary == .Div -> return problem
    mir_lint_expect(ctx, op, "arithmetic result", left_type, ty)
}

fn mir_lint_carrier_test(ctx: MIRLintContext, instruction: MIRInstruction, subject: MIRValueID, class: MIRLintClass) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    ty :: instruction.ty ?? return mir_lint_no_result(op)
    problem :: mir_lint_expect_value_class(ctx, op, "subject", subject, [MIRLintClass]{class})
    if problem != None -> return problem
    mir_lint_expect_class(ctx, op, "carrier test", ty, mir_lint_bool())
}

fn mir_lint_result_carrier(ctx: MIRLintContext, instruction: MIRInstruction, value: MIRValueID, ok: Bool) -> MIRLintProblem? Never! {
    op :: MIRLintRule.OperationTyping
    ty :: instruction.ty ?? return mir_lint_no_result(op)
    problem :: mir_lint_expect_class(ctx, op, "Result carrier", ty, [MIRLintClass]{MIRLintClass.Result})
    if problem != None -> return problem
    part :: mir_lint_result_part(ty, ok) ?? return None
    mir_lint_expect_value(ctx, op, "carried value", part, value)
}

fn mir_lint_has_spread(args: [MIRCallArg]) -> Bool Never! {
    loop arg in args {
        if arg.spread -> return true
    }
    false
}

// `struct.field`: every supplied field is declared once on the struct, with a
// compatible value, and every field without a default is present. Declared
// and supplied fields are keyed once per literal, so the check is linear in
// the fields.
fn mir_lint_struct_fields(ctx: MIRLintContext, type_id: MIRTypeID, fields: [MIRFieldValue], boxed: [MIRFieldID], complete: Bool) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.StructField
    position :: ctx.index.types.get(type_id.value) ?? return None
    definition :: ctx.index.type_rows[position]
    declared :: definition.fields ?? return mir_lint_problem(rule, "type {definition.name} is not a struct")
    // The last declaration of each field ID, as the scan it replaces found.
    declared_rows := [U64:Int]{}
    loop (declared_position, declaration) in declared -> declared_rows[declaration.id.value] = declared_position
    supplied_rows := [U64:Bool]{}
    loop supplied in fields {
        row_position :: declared_rows.get(supplied.field.value) ?? return mir_lint_problem(rule, "field {supplied.field.value} is not declared on {definition.name}")
        row :: declared[row_position]
        if supplied_rows.get(supplied.field.value) != None -> return mir_lint_problem(rule, "field `{row.name}` is supplied twice")
        _ := &supplied_rows.add(supplied.field.value, true)
        if !boxed.contains(supplied.field) {
            value_row :: ctx.values.get(supplied.value.value) ?? next
            if mir_lint_compatible(ctx.index, row.ty, ctx.function.values[value_row].ty) -> next
            return mir_lint_expect_value(ctx, rule, "field `{row.name}`", row.ty, supplied.value)
        }
    }
    if !complete -> return None
    loop row in declared {
        if row.has_default || row.computed -> next
        if supplied_rows.get(row.id.value) == None -> return mir_lint_problem(rule, "field `{row.name}` of {definition.name} is missing")
    }
    None
}

struct MIRLintVariantLookup {
    variant: MIRVariant?
    problem: MIRLintProblem?
}

// `enum.variant`: the variant is declared on the owner enum. An owner the
// program does not declare (a Core or builtin enum) is not checked here.
fn mir_lint_variant(ctx: MIRLintContext, owner: MIRTypeID, variant: String) -> MIRLintVariantLookup Never! {
    position :: ctx.index.types.get(owner.value) ?? return MIRLintVariantLookup{variant: None, problem: None}
    definition :: ctx.index.type_rows[position]
    variants :: definition.variants ?? return MIRLintVariantLookup{variant: None, problem: mir_lint_problem(.EnumVariant, "type {definition.name} is not an enum")}
    loop row in variants {
        // copy: the variant row stays in the index (owner: ctx.index, read parameter) and the
        // lookup result owns its copy (owner: the returned lookup), used after the index read ends.
        if row.name == variant -> return MIRLintVariantLookup{variant: Val(row.copy()), problem: None}
    }
    MIRLintVariantLookup{variant: None, problem: mir_lint_problem(.EnumVariant, "{definition.name} declares no variant {variant}")}
}

fn mir_lint_enum_construction(ctx: MIRLintContext, owner: MIRTypeID, variant: String, args: [MIREnumArg]) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.EnumVariant
    lookup :: mir_lint_variant(ctx, owner, variant)
    if lookup.problem != None -> return lookup.problem
    row :: lookup.variant ?? return None
    arity :: if row.payload == {
        .Unit -> 0
        .Single(_) -> 1
        .Named(fields) -> fields.len()
    }
    if args.len() != arity -> return mir_lint_problem(rule, "variant {variant} takes {arity} payload values, got {args.len()}")
    loop (position, arg) in args {
        declared := MIRType?{None}
        if row.payload == {
            .Single(value) -> {
                if arg.field != None -> return mir_lint_problem(rule, "variant {variant} payload slot {position} names a field")
                declared = Val(value)
            }
            .Named(fields) -> {
                if arg.field == {
                    .Val(field) -> {
                        loop declaration in fields {
                            if declaration.id == field -> declared = Val(declaration.ty)
                        }
                        if declared == None -> return mir_lint_problem(rule, "variant {variant} declares no field {field.value}")
                    }
                    else -> declared = Val(fields[position].ty)
                }
            }
            .Unit -> {}
        }
        if !arg.boxed {
            if declared == .Val(expected) {
                problem :: mir_lint_expect_value(ctx, rule, "payload value", expected, arg.value)
                if problem != None -> return problem
            }
        }
    }
    None
}

fn mir_lint_arg_is_plain(arg: MIRCallArg) -> Bool Never! {
    arg.fn_coercion == None && !arg.widen_fixed_to_list && arg.widen_to_union == None && arg.box_as_trait == None && !arg.spread
}

// An effect is inside a row that names it or one of its parent effects.
fn mir_lint_effect_covered(row: [String], performed: String) -> Bool Never! {
    loop granted in row {
        if mir_lint_text_under(granted, performed, U8{46}) -> return true
    }
    false
}

// Rust `effect_is_deny_only` (Sema/Effects.rs): `Mem`, `Panic` and the exact
// `Time.Wait` leaf are deny-only. No positive effect row admits or omits
// them (`effects_uncovered` drops them), so a call performing one is never
// outside the caller's row.
fn mir_lint_effect_deny_only(performed: String) -> Bool Never! {
    performed == "Mem" || performed.starts_with("Mem.") || performed == "Panic" || performed.starts_with("Panic.") || performed == "Time.Wait"
}

// `call.signature` against the callee row named by ID, then `effect.row`.
fn mir_lint_call(ctx: MIRLintContext, instruction: MIRInstruction, callee: MIRCallee, args: [MIRCallArg]) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.CallSignature
    target_option :: if callee == {
        .User(function) | .Associated(function, _) | .Method(function, _) -> Val(function)
        else -> None
    }
    target_id :: target_option ?? return None
    target_position :: ctx.index.functions.get(target_id.value) ?? return mir_lint_problem(rule, "callee {target_id.value} is not a function of the program")
    target :: ctx.index.signatures[target_position]
    variadic := false
    required := 0
    loop param in target.params {
        if param.variadic -> variadic = true
        if !param.default_present -> required += 1
    }
    if !variadic && !mir_lint_has_spread(args) {
        if args.len() < required || args.len() > target.params.len() -> return mir_lint_problem(rule, "call passes {args.len()} arguments to `{target.key}`, which takes {target.params.len()}")
        loop (position, arg) in args {
            if mir_lint_arg_is_plain(arg) {
                param :: target.params[position]
                value_row :: ctx.values.get(arg.value.value) ?? next
                if mir_lint_compatible(ctx.index, param.ty, ctx.function.values[value_row].ty) -> next
                return mir_lint_expect_value(ctx, rule, "argument `{param.name}` of `{target.key}`", param.ty, arg.value)
            }
        }
    }
    if instruction.ty == .Val(ty) {
        if !mir_lint_compatible(ctx.index, target.return_type, ty) -> return mir_lint_expect(ctx, rule, "result of `{target.key}`", target.return_type, ty)
    }
    caller :: ctx.function.effects
    if caller.maximal -> return None
    loop performed in target.solved_effects {
        if !mir_lint_effect_deny_only(performed) && !mir_lint_effect_covered(caller.solved, performed) -> return mir_lint_problem(.EffectRow, "call to `{target.key}` performs {performed}, outside the caller's effect row")
    }
    None
}

fn mir_lint_declared_fields(ctx: MIRLintContext, fields: [MIRFieldID]) -> MIRLintProblem? Never! {
    loop field in fields {
        if ctx.index.fields.get(field.value) == None -> return mir_lint_problem(.StructField, "field {field.value} is not declared")
    }
    None
}

// `semantic.typing`.
fn mir_lint_semantic(ctx: MIRLintContext, instruction: MIRInstruction, semantic: MIRSemanticOp) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.SemanticTyping
    if semantic == {
        .LayoutCompare(_, _, _, _) -> {
            ty :: instruction.ty ?? return mir_lint_no_result(rule)
            mir_lint_expect_class(ctx, rule, "layout comparison", ty, mir_lint_bool())
        }
        .RequireStop(_, _, condition, _, _, _, _) -> {
            value :: condition ?? return None
            mir_lint_expect_value_class(ctx, rule, "condition", value, mir_lint_bool())
        }
        .StructLiteral(type_id, fields, extra, boxed_fields) -> mir_lint_struct_fields(ctx, type_id, fields, boxed_fields, extra == None)
        .ColumnarRead(_, index, column, _, _) -> {
            problem :: mir_lint_expect_value_class(ctx, rule, "row index", index, mir_lint_integer())
            if problem != None -> return problem
            mir_lint_declared_fields(ctx, [MIRFieldID]{column})
        }
        .CellGuardProject(_, _, _, paths, _, _) -> {
            loop path in paths {
                problem :: mir_lint_declared_fields(ctx, path)
                if problem != None -> return problem
            }
            None
        }
        .SharedGuardMap(_, _, path, _) -> mir_lint_declared_fields(ctx, path)
        .SharedGuardSplit(_, _, _, first, second, _) -> {
            problem :: mir_lint_declared_fields(ctx, first)
            if problem != None -> return problem
            mir_lint_declared_fields(ctx, second)
        }
        .CarrierFact(_, _, field, _) -> mir_lint_declared_fields(ctx, [MIRFieldID]{field})
        .BuiltinMethod(_, _, _, _, aggregate_fields) -> {
            fields :: aggregate_fields ?? return None
            mir_lint_declared_fields(ctx, fields)
        }
        .OptionLift2(_, function, _, _) -> mir_lint_expect_value_class(ctx, rule, "lifted function", function, mir_lint_callable())
        // `checked_*` yields an Option of the operand; wrapping, saturating,
        // trapping (`checked_policy`) and rotate routes yield the operand's
        // integer type (Rust tir_to_mir_expr `OverflowOpt` types the op with the
        // checked expression's type).
        .OverflowOption(_, _, _, _) -> {
            ty :: instruction.ty ?? return mir_lint_no_result(rule)
            mir_lint_expect_class(ctx, rule, "overflow arithmetic", ty, [MIRLintClass]{MIRLintClass.Option, MIRLintClass.Integer})
        }
        .NumericMethod(_, receiver) | .NumericBinaryMethod(_, receiver, _) -> mir_lint_expect_value_class(ctx, rule, "numeric receiver", receiver, mir_lint_numeric())
        .HostBorrowCallback(value, _) | .CCallback(_, _, value) | .HTTPRouterRegister(_, _, _, value, _, _, _, _) -> mir_lint_expect_value_class(ctx, rule, "callable operand", value, mir_lint_callable())
        .CoreClosureCall(_, _, _, closure, _, _) -> {
            value :: closure ?? return None
            mir_lint_expect_value_class(ctx, rule, "callable operand", value, mir_lint_callable())
        }
        .GCEdit(_, _, _, _, index, _, _) -> {
            value :: index ?? return None
            mir_lint_expect_value_class(ctx, rule, "edit index", value, mir_lint_integer())
        }
        .TypedTextInterp(_, _, literals, holes, trusted_html) -> {
            if literals.len() != holes.len() + 1 -> return mir_lint_problem(rule, "typed text has {literals.len()} literals for {holes.len()} holes")
            if trusted_html.len() != holes.len() -> return mir_lint_problem(rule, "typed text has {trusted_html.len()} HTML proofs for {holes.len()} holes")
            None
        }
        .PluginInvoke(_, _, _, signature, args) -> {
            if signature.params.len() != args.len() -> return mir_lint_problem(rule, "plugin call passes {args.len()} arguments to {signature.params.len()} parameters")
            None
        }
        .AmbientInput(_, prompt) -> {
            value :: prompt ?? return None
            mir_lint_expect_value_class(ctx, rule, "prompt", value, [MIRLintClass]{MIRLintClass.String})
        }
        .CursorTakePattern(_, receiver_place, _) | .ReaderTakePattern(_, receiver_place, _) -> {
            if mir_lint_place(ctx, receiver_place) == None -> return mir_lint_problem(rule, "receiver place {receiver_place.value} does not exist")
            None
        }
        else -> None
    }
}

fn mir_lint_target(ctx: MIRLintContext, target: MIRBlockID) -> MIRLintProblem? Never! {
    if ctx.blocks.get(target.value) == None -> return mir_lint_problem(.TerminatorTyping, "target block {target.value} does not exist")
    None
}

// `terminator.typing`.
fn mir_lint_terminator(ctx: MIRLintContext, block: MIRBasicBlock) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.TerminatorTyping
    function :: ctx.function
    if block.terminator == {
        .Jump(target) | .Continue(target) | .Break(target, _) -> mir_lint_target(ctx, target)
        .Branch(condition, then_target, else_target) -> {
            problem := mir_lint_expect_value_class(ctx, rule, "branch condition", condition, mir_lint_bool())
            if problem != None -> return problem
            problem = mir_lint_target(ctx, then_target)
            if problem != None -> return problem
            mir_lint_target(ctx, else_target)
        }
        .Switch(_, arms, otherwise) -> {
            loop arm in arms {
                problem := mir_lint_expect_value_class(ctx, rule, "switch arm condition", arm.condition, mir_lint_bool())
                if problem != None -> return problem
                problem = mir_lint_target(ctx, arm.target)
                if problem != None -> return problem
            }
            mir_lint_target(ctx, otherwise)
        }
        .Return(value) -> {
            if value == .Val(returned) -> return mir_lint_expect_value(ctx, rule, "returned value", function.return_type, returned)
            if function.generator != None -> return None
            // A fallible unit function's bare return is its implicit success
            // (`Ok(())`), as the Rust backend's default return emits it.
            if function.failure == .Result(success, _) {
                if mir_lint_class(ctx.index, success) == .Unit -> return None
            }
            mir_lint_expect_class(ctx, rule, "bare return of a function returning", function.return_type, [MIRLintClass]{MIRLintClass.Unit})
        }
        .Yield(value, resume) -> {
            generator :: function.generator ?? return mir_lint_problem(rule, "yield outside a generator")
            problem :: mir_lint_expect_value(ctx, rule, "yielded value", generator.item, value)
            if problem != None -> return problem
            mir_lint_target(ctx, resume)
        }
        .Unreachable(_) -> None
        .Poll(_, resume, stop) -> {
            problem :: mir_lint_target(ctx, resume)
            if problem != None -> return problem
            mir_lint_target(ctx, stop)
        }
        .Stopped -> None
    }
}



// This only resolves checked route metadata; Foundation owns consumption.
fn mir_lint_consumption_borrow_mask(ctx: MIRLintContext, operation: MIROperation) -> [Bool] Never! {
    if mir_operation_consumption_route(operation) == Val(call) -> return ctx.index.borrow_masks.get(call.value) ?? [Bool]{}
    [Bool]{}
}

fn mir_lint_consumption_tracked(ctx: MIRLintContext, value: MIRValueID, consumption: MIRValueConsumption) -> Bool Never! {
    if !mir_value_consumption_transfers(consumption) -> return false
    row :: ctx.values.get(value.value) ?? return false
    mir_runtime_owned_ownership(ctx.function.values[row].ownership) || mir_value_consumption_requires_owner(consumption)
}

enum MIRLintPlaceUse { Read Borrow Move Reinitialize }

struct MIRLintPlaceUseRow {
    place: MIRPlaceID
    usage: MIRLintPlaceUse
}

// A consuming call's place is provenance: a defining MovePlace has already
// moved that storage. Do not count it a second time at the call.
fn mir_lint_place_uses(ctx: MIRLintContext, defs: MIRLintDefs, operation: MIROperation) -> [MIRLintPlaceUseRow] Never! {
    rows := [MIRLintPlaceUseRow]{}
    if operation == {
        .ReadPlace(place) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Read})
        .MovePlace(place) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Move})
        .InitializeUninit(place) | .WritePlace(place, _) | .ReplacePlace(place, _) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Reinitialize})
        .RawAddressOf(place) | .AddressOf(place, _) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Borrow})
        .MapLookup(map, _, cache) -> {
            &rows.push(MIRLintPlaceUseRow{place: map, usage: MIRLintPlaceUse.Borrow})
            &rows.push(MIRLintPlaceUseRow{place: cache, usage: MIRLintPlaceUse.Reinitialize})
        }
        .Closure(_, captures, _) -> {
            loop capture in captures {
                if capture == .Place(place) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Borrow})
            }
        }
        .Semantic(semantic) -> {
            if semantic == .BuiltinMethod(_, _, receiver_place, _, _) {
                if receiver_place == .Val(place) -> &rows.push(MIRLintPlaceUseRow{place: place, usage: MIRLintPlaceUse.Borrow})
            }
        }
        else -> {}
    }
    loop arg in mir_operation_call_args(operation) {
        if arg.place == .Val(place) {
            if mir_call_arg_consumes(arg) {
                definition :: mir_lint_def_at(defs, arg.value)
                if definition >= 0 {
                    if ctx.function.blocks[defs.blocks[definition]].instructions[defs.positions[definition]].operation == .MovePlace(moved) {
                        if moved == place -> next
                    }
                }
            }
            usage :: if {
                mir_call_arg_consumes(arg) -> MIRLintPlaceUse.Move
                arg.access == .Write -> MIRLintPlaceUse.Borrow
                else -> MIRLintPlaceUse.Read
            }
            &rows.push(MIRLintPlaceUseRow{place: place, usage: usage})
        }
    }
    rows
}

// The storage root of a place: its local, parameter, capture, temporary, or
// static.
fn mir_lint_place_root(place: MIRPlace) -> String Never! {
    if place.base == {
        .Local(local) -> "l{local.value}"
        .Parameter(value) -> "p{value.value}"
        .Capture(value) -> "c{value.value}"
        .Temporary(value) -> "t{value.value}"
        .Static(name) -> "s{name}"
    }
}

// The storage path of a place: its root and projections. A path that is a
// prefix of another overlaps it.
fn mir_lint_path_key(place: MIRPlace) -> String Never! {
    key := mir_lint_place_root(place)
    loop projection in place.projections {
        step :: if projection == {
            .Field(field, _) -> "f{field.value}"
            .Index(_, index, _, _, _, _, _) -> "i{index.value}"
            .Deref(_) -> "d"
            .Payload(kind, _) -> if kind == {
                .Option -> "o"
                .Result(ok) -> if ok -> "r1" else -> "r0"
                .Enum(owner, variant, slot) -> "e{owner.value}.{variant}.{slot}"
            }
            .Range(range, _, _) -> "g{range.value}"
            .MapLookup(lookup, optional, _) -> "m{lookup.value}:{optional}"
        }
        key = "{key}/{step}"
    }
    key
}

// `text` is `prefix` or lies under it: `prefix`, then the ASCII
// `separator`, then more. Compared in place, so no `"{prefix}."` text is
// built per check.
fn mir_lint_text_under(prefix: String, text: String, separator: U8) -> Bool Never! {
    if !text.starts_with(prefix) -> return false
    whole :: text.bytes()
    cut :: prefix.bytes().len()
    whole.len() == cut || whole[cut] == separator
}

// `path` is `prefix` or lies under it (`prefix/...`).
fn mir_lint_path_prefix(prefix: String, path: String) -> Bool Never! {
    mir_lint_text_under(prefix, path, U8{47})
}

// How the place path `key` relates to the moved path `moved_key` (bit
// `bit`): overlapping (prefix either way), a strict ancestor of the place,
// or reinitialized by a write of the place.
fn mir_lint_path_relate(key: String, bit: Int, moved_key: String, overlap: &[Int], ancestor: &[Int], reinit: &[Int]) Never! {
    moved_is_prefix :: mir_lint_path_prefix(moved_key, key)
    place_is_prefix :: mir_lint_path_prefix(key, moved_key)
    if moved_is_prefix || place_is_prefix -> &overlap.push(bit)
    if moved_is_prefix && moved_key != key -> &ancestor.push(bit)
    if place_is_prefix -> &reinit.push(bit)
}

// Bit identities for sparse ownership states: consumed values, moved paths,
// then known-true and known-false guards and edge-crossing values.
struct MIRLintOwnership {
    value_bits: [U64:Int]
    value_count: Int
    path_count: Int
    // Per place row: moved-path bits overlapping the place (a read, borrow,
    // or move is invalid while one is set), strict-prefix bits (a write is
    // invalid while one is set), bits the place's write reinitializes, and
    // the bit its move sets (-1 when the place is never moved).
    overlapping: [[Int]]
    ancestors: [[Int]]
    reinitialized: [[Int]]
    moved: [Int]
    // The MovePlace results that are an owner's remainder drop (its
    // scope-end cleanup: every user a releasing Drop, Foundation
    // mir_remainder_drop_results). Such a move releases only the fields still
    // in place, so it is invalid only while the owner itself or a prefix of
    // it is moved, never while one of its fields is.
    remainder: [U64:Bool]
    // Per place row: the Bool guard slot of an unborrowed whole local, or -1.
    slots: [Int]
    slot_count: Int
    crossing: [U64:Int]
    crossing_count: Int
    // The safety families' bits start at `safety_base`.
    safety: MIRLintSafety
    safety_base: Int
    defs: MIRLintDefs
}

fn mir_lint_slot_bit(layout: MIRLintOwnership, slot: Int, truth: Bool) -> Int Never! {
    offset :: if truth -> 0 else -> layout.slot_count
    layout.value_count + layout.path_count + slot + offset
}

fn mir_lint_crossing_bit(layout: MIRLintOwnership, crossing: Int, truth: Bool) -> Int Never! {
    offset :: if truth -> 0 else -> layout.crossing_count
    layout.value_count + layout.path_count + 2 * layout.slot_count + crossing + offset
}

// The bit layout, or None when nothing is ever consumed or moved and the
// function has no view, writing closure, or task-group loan.
// Rust: none (Jet-only pass)
fn mir_lint_ownership_layout(ctx: MIRLintContext, defs: ^MIRLintDefs) -> MIRLintOwnership? Never! {
    function :: ctx.function
    value_bits := [U64:Int]{}
    value_count := 0
    path_bits := [String:Int]{}
    path_keys := [String]{}
    // The moved-path bits of each non-static root, ascending: a path relates
    // (prefix either way) only to paths under its own root, because a root
    // key (`l3`, `p7`, ...) holds no `/`. Static roots (`s{name}`) may, so a
    // static place still compares against every moved path.
    path_roots := [String:Int]{}
    root_paths := [[Int]]{}
    borrowed := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            mask :: mir_lint_consumption_borrow_mask(ctx, instruction.operation)
            loop value in mir_operation_value_uses(instruction.operation) {
                consumption :: mir_operation_value_consumption(instruction.operation, value, mask)
                if !mir_lint_consumption_tracked(ctx, value, consumption) -> next
                if value_bits.get(value.value) == None {
                    _ := &value_bits.add(value.value, value_count)
                    value_count += 1
                }
            }
            loop row in mir_lint_place_uses(ctx, defs, instruction.operation) {
                place :: mir_lint_place(ctx, row.place) ?? next
                if row.usage == .Move {
                    key :: mir_lint_path_key(place)
                    if path_bits.get(key) == None {
                        bit :: path_keys.len()
                        _ := &path_bits.add(key, bit)
                        &path_keys.push(key)
                        if place.base == .Static(_) {} else {
                            root :: mir_lint_place_root(place)
                            bucket :: path_roots.get(root) ?? -1
                            if bucket >= 0 {
                                &root_paths[bucket].push(bit)
                            } else {
                                _ := &path_roots.add(root, root_paths.len())
                                &root_paths.push([Int]{bit})
                            }
                        }
                    }
                }
                if row.usage == .Borrow {
                    if place.base == .Local(local) -> _ := &borrowed.add(local.value, true)
                }
            }
        }
        loop value in mir_terminator_value_uses(block.terminator) {
            consumption :: mir_terminator_value_consumption(block.terminator, value)
            if !mir_lint_consumption_tracked(ctx, value, consumption) -> next
            if value_bits.get(value.value) == None {
                _ := &value_bits.add(value.value, value_count)
                value_count += 1
            }
        }
    }
    safety :: mir_lint_safety_layout(ctx, defs)
    if value_count == 0 && path_keys.len() == 0 && !safety.active -> return None
    overlapping := [[Int]]{}
    ancestors := [[Int]]{}
    reinitialized := [[Int]]{}
    moved := [Int]{}
    slots := [Int]{}
    slot_of_local := [U64:Int]{}
    slot_count := 0
    loop place in function.places {
        overlap := [Int]{}
        ancestor := [Int]{}
        reinit := [Int]{}
        moved_bit := -1
        if path_keys.len() > 0 {
            key :: mir_lint_path_key(place)
            if place.base == .Static(_) {
                loop (bit, moved_key) in path_keys -> mir_lint_path_relate(key, bit, moved_key, &overlap, &ancestor, &reinit)
            } else {
                bucket :: path_roots.get(mir_lint_place_root(place)) ?? -1
                if bucket >= 0 {
                    loop bit in root_paths[bucket] -> mir_lint_path_relate(key, bit, path_keys[bit], &overlap, &ancestor, &reinit)
                }
            }
            moved_bit = path_bits.get(key) ?? -1
        }
        &overlapping.push(overlap)
        &ancestors.push(ancestor)
        &reinitialized.push(reinit)
        &moved.push(moved_bit)
        slot := -1
        if place.base == .Local(local) {
            if mir_lint_is_bool(place.ty) && place.projections.len() == 0 && borrowed.get(local.value) == None {
                if slot_of_local.get(local.value) == {
                    .Val(existing) -> slot = existing
                    else -> {
                        slot = slot_count
                        _ := &slot_of_local.add(local.value, slot_count)
                        slot_count += 1
                    }
                }
            }
        }
        &slots.push(slot)
    }
    // Guard facts cross edges only for Bool values read outside their block.
    crossing := [U64:Int]{}
    crossing_count := 0
    if slot_count > 0 {
        defined_in := [U64:Int]{}
        loop (position, block) in function.blocks {
            loop instruction in block.instructions {
                if instruction.result == .Val(result) -> _ := &defined_in.add(result.value, position)
            }
        }
        loop (position, block) in function.blocks {
            used := mir_terminator_value_uses(block.terminator)
            loop instruction in block.instructions {
                loop value in mir_operation_value_uses(instruction.operation) -> &used.push(value)
            }
            loop value in used {
                home :: defined_in.get(value.value) ?? next
                if home == position || crossing.get(value.value) != None -> next
                ty :: mir_lint_type_of(ctx, value) ?? next
                if mir_lint_is_bool(ty) {
                    _ := &crossing.add(value.value, crossing_count)
                    crossing_count += 1
                }
            }
        }
    }
    Val(MIRLintOwnership{
        value_bits: value_bits,
        value_count: value_count,
        path_count: path_keys.len(),
        overlapping: overlapping,
        ancestors: ancestors,
        reinitialized: reinitialized,
        moved: moved,
        remainder: mir_lint_remainder_drops(ctx),
        slots: slots,
        slot_count: slot_count,
        crossing: crossing,
        crossing_count: crossing_count,
        safety: safety,
        safety_base: value_count + path_keys.len() + 2 * slot_count + 2 * crossing_count,
        defs: ^defs,
    })
}

// The remainder drops of the function: the results of whole-owner
// MovePlaces (a root with no projection) that only feed a releasing Drop.
fn mir_lint_remainder_drops(ctx: MIRLintContext) -> [U64:Bool] Never! {
    candidates := [U64]{}
    loop block in ctx.function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .MovePlace(place_id) {
                result :: instruction.result ?? next
                place :: mir_lint_place(ctx, place_id) ?? next
                if place.projections.len() == 0 -> &candidates.push(result.value)
            }
        }
    }
    mir_remainder_drop_results(ctx.function.blocks, candidates)
}

// One block's effect on the state, and the successors its known guards allow.
struct MIRLintStep {
    successors: [MIRBlockID]
    failure: MIRLintError?
}

// Only set bits are stored. Positions make clearing a bit a swap-and-pop;
// cleared entries retain -1, never a live position, in the lookup map.
struct MIRLintState {
    bits: [Int]
    positions: [Int:Int]
}

// Rust: none (Jet-only pass)
fn mir_lint_state_has(state: MIRLintState, bit: Int) -> Bool Never! {
    (state.positions.get(bit) ?? -1) >= 0
}

// Rust: none (Jet-only pass)
fn mir_lint_state_set(state: &MIRLintState, bit: Int, present: Bool) Never! {
    position :: state.positions.get(bit) ?? -1
    if present {
        if position < 0 {
            _ := &state.positions.add(bit, state.bits.len())
            &state.bits.push(bit)
        }
    } else if position >= 0 {
        last :: state.bits[state.bits.len() - 1].copy()
        state.bits[position] = last
        _ := &state.positions.add(last, position)
        _ := &state.bits.pop()
        _ := &state.positions.add(bit, -1)
    }
}

// Copy only live bits, not cleared lookup entries or the entire bit universe.
// Rust: none (Jet-only pass)
fn mir_lint_state_copy(state: MIRLintState) -> MIRLintState Never! {
    result := MIRLintState{bits: [Int]{}, positions: [Int:Int]{}}
    loop bit in state.bits -> mir_lint_state_set(&result, bit, true)
    result
}

// Rust: none (Jet-only pass)
fn mir_lint_state_meet(state: &MIRLintState, incoming: MIRLintState, safety_base: Int) -> Bool Never! {
    changed := false
    position := 0
    loop position < state.bits.len() {
        bit :: state.bits[position].copy()
        if bit >= safety_base || mir_lint_state_has(incoming, bit) {
            position += 1
        } else {
            mir_lint_state_set(&state, bit, false)
            changed = true
        }
    }
    // Safety is a separate may-flow: any predecessor can keep an origin
    // stale, a holder active, or a child loan outstanding.
    loop bit in incoming.bits {
        if bit >= safety_base && !mir_lint_state_has(state, bit) {
            mir_lint_state_set(&state, bit, true)
            changed = true
        }
    }
    changed
}

// Move/guard facts below safety_base use intersection. Safety facts above
// that boundary use union and never disappear merely on another branch.
// Rust: none (Jet-only pass)
fn mir_lint_ownership(ctx: MIRLintContext, defs: ^MIRLintDefs) -> MIRLintError? Never! {
    layout :: mir_lint_ownership_layout(ctx, ^defs) ?? return None
    function :: ctx.function
    count :: function.blocks.len()
    states := [MIRLintState]{}
    reached := [Bool]{}
    queued := [Bool]{}
    loop _ in 0..<count {
        &states.push(MIRLintState{bits: [Int]{}, positions: [Int:Int]{}})
        &reached.push(false)
        &queued.push(false)
    }
    work := [Int]{}
    roots := [MIRBlockID]{function.entry}
    loop drop in function.drops {
        if drop.edge == {
            .Failure(target) | .Unwind(target) -> &roots.push(target)
            else -> {}
        }
    }
    loop root in roots {
        position :: ctx.blocks.get(root.value) ?? next
        if !reached[position] {
            reached[position] = true
            queued[position] = true
            &work.push(position)
        }
    }
    head := 0
    loop head < work.len() {
        position :: work[head].copy()
        head += 1
        queued[position] = false
        current := mir_lint_state_copy(states[position])
        step :: mir_lint_transfer(ctx, layout, function.blocks[position], &current, false)
        loop target in step.successors {
            target_position :: ctx.blocks.get(target.value) ?? next
            edge := mir_lint_state_copy(current)
            mir_lint_phi_safety(ctx, layout, function.blocks[position].id, function.blocks[target_position], &edge)
            changed := false
            if {
                reached[target_position] -> changed = mir_lint_state_meet(&states[target_position], edge, layout.safety_base)
                else -> {
                    reached[target_position] = true
                    states[target_position] = ^edge
                    changed = true
                }
            }
            if changed && !queued[target_position] {
                queued[target_position] = true
                &work.push(target_position)
            }
        }
    }
    // Preserve physical block order and each transfer's first-error order.
    loop position in 0..<count {
        if !reached[position] -> next
        current := mir_lint_state_copy(states[position])
        step :: mir_lint_transfer(ctx, layout, function.blocks[position], &current, true)
        if step.failure != None -> return step.failure
        loop target in step.successors {
            target_position :: ctx.blocks.get(target.value) ?? next
            edge := mir_lint_state_copy(current)
            failure :: mir_lint_phi_transfer(ctx, layout, function.blocks[position].id, function.blocks[target_position], &edge, true)
            if failure != None -> return failure
        }
    }
    None
}

// The known truth of a Bool value: a fact from this block, else a crossing
// bit. 1 is true, 2 is false, 0 is unknown.
// Rust: none (Jet-only pass)
fn mir_lint_known(layout: MIRLintOwnership, state: MIRLintState, facts: [U64:Int], value: MIRValueID) -> Int Never! {
    local :: facts.get(value.value) ?? -1
    if local >= 0 -> return local
    crossing :: layout.crossing.get(value.value) ?? return 0
    if mir_lint_state_has(state, mir_lint_crossing_bit(layout, crossing, true)) -> return 1
    if mir_lint_state_has(state, mir_lint_crossing_bit(layout, crossing, false)) -> return 2
    0
}

// Rust: none (Jet-only pass)
fn mir_lint_moved_failure(ctx: MIRLintContext, layout: MIRLintOwnership, state: MIRLintState, values: [MIRValueID], span: Span) -> MIRLintError? Never! {
    loop value in values {
        bit :: layout.value_bits.get(value.value) ?? next
        if mir_lint_state_has(state, bit) -> return mir_lint_fail(ctx, .OwnershipMove, span, "value {value.value} is used after it was moved")
    }
    None
}

// Whether any of the moved-path `bits` is set in `state`.
fn mir_lint_any_moved(layout: MIRLintOwnership, state: MIRLintState, bits: [Int]) -> Bool Never! {
    loop bit in bits {
        if mir_lint_state_has(state, layout.value_count + bit) -> return true
    }
    false
}

fn mir_lint_is_phi(operation: MIROperation) -> Bool Never! {
    if operation == {
        .Phi(_) -> true
        else -> false
    }
}

// The known truth of a constant: 1 is true, 2 is false, 0 is not a Bool.
fn mir_lint_bool_constant(constant: MIRConstant) -> Int Never! {
    if constant == {
        .Bool(truth) -> if truth -> 1 else -> 2
        else -> 0
    }
}

fn mir_lint_consume_value(ctx: MIRLintContext, layout: MIRLintOwnership, state: &MIRLintState, value: MIRValueID, consumption: MIRValueConsumption, span: Span, check: Bool) -> MIRLintError? Never! {
    if !mir_value_consumption_transfers(consumption) -> return None
    row :: ctx.values.get(value.value) ?? return None
    if !mir_runtime_owned_ownership(ctx.function.values[row].ownership) {
        if check && mir_value_consumption_requires_owner(consumption) -> return mir_lint_fail(ctx, .OwnershipMove, span, "value {value.value} is consumed but not owned")
        return None
    }
    bit :: layout.value_bits.get(value.value) ?? return None
    if check && mir_lint_state_has(state, bit) -> return mir_lint_fail(ctx, .OwnershipMove, span, "value {value.value} is consumed twice")
    mir_lint_state_set(&state, bit, true)
    None
}

// A phi consumes only the input selected by this predecessor. Never consume
// every incoming row in the destination block, or charge a Break twice.
fn mir_lint_phi_transfer(ctx: MIRLintContext, layout: MIRLintOwnership, from: MIRBlockID, target: MIRBasicBlock, state: &MIRLintState, check: Bool) -> MIRLintError? Never! {
    loop instruction in target.instructions {
        if instruction.operation == .Phi(incoming) {
            loop edge in incoming {
                if edge.block != from -> next
                if check {
                    failure :: mir_lint_moved_failure(ctx, layout, state, [MIRValueID]{edge.value}, instruction.span)
                    if failure != None -> return failure
                    loop origin in (layout.safety.origins.get(edge.value.value) ?? [Int]{}) {
                        if mir_lint_state_has(state, mir_lint_origin_active_bit(layout, origin)) && mir_lint_state_has(state, layout.safety_base + origin) -> return mir_lint_stale_failure(ctx, layout.safety, origin, instruction.span, "phi input {edge.value.value}")
                    }
                }
                consumption :: mir_operation_value_consumption(instruction.operation, edge.value, [Bool]{})
                failure :: mir_lint_consume_value(ctx, layout, &state, edge.value, consumption, instruction.span, check)
                if failure != None -> return failure
                if instruction.result == .Val(result) {
                    selected :: layout.safety.origins.get(edge.value.value) ?? [Int]{}
                    loop origin in (layout.safety.origins.get(result.value) ?? [Int]{}) {
                        active := false
                        stale := false
                        loop source in selected {
                            if layout.safety.origin_roots[source] != layout.safety.origin_roots[origin] -> next
                            if !mir_lint_state_has(state, mir_lint_origin_active_bit(layout, source)) -> next
                            active = true
                            if mir_lint_state_has(state, layout.safety_base + source) -> stale = true
                        }
                        mir_lint_state_set(&state, mir_lint_origin_active_bit(layout, origin), active)
                        mir_lint_state_set(&state, layout.safety_base + origin, stale)
                    }
                }
            }
        }
    }
    None
}

// Apply one block to `state`; with `check`, report the first violation.
// Rust: none (Jet-only pass)
fn mir_lint_transfer(ctx: MIRLintContext, layout: MIRLintOwnership, block: MIRBasicBlock, state: &MIRLintState, check: Bool) -> MIRLintStep Never! {
    rule :: MIRLintRule.OwnershipMove
    facts := [U64:Int]{}
    guards :: layout.slot_count > 0
    loop instruction in block.instructions {
        span :: instruction.span
        operation :: instruction.operation
        if check && !mir_lint_is_phi(operation) {
            uses := mir_operation_value_uses(operation)
            if operation == .ScopeEnter(scope, _) {
                loop row in ctx.function.scopes {
                    if row.id == scope {
                        if row.deadline == .Val(deadline) -> &uses.push(deadline)
                    }
                }
            }
            failure :: mir_lint_moved_failure(ctx, layout, state, uses, span)
            if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
        }
        place_rows :: mir_lint_place_uses(ctx, layout.defs, operation)
        if check {
            // An owner's remainder drop (layout.remainder) is blocked only by
            // a move of the owner itself or of a prefix: the fields moved out
            // of it are exactly what it does not release.
            remainder_drop :: if instruction.result == .Val(result) -> layout.remainder.get(result.value) != None else -> false
            loop row in place_rows {
                position :: ctx.places.get(row.place.value) ?? next
                blocked := false
                if row.usage == .Move && remainder_drop {
                    own :: layout.moved[position]
                    blocked = mir_lint_any_moved(layout, state, layout.ancestors[position]) || (own >= 0 && mir_lint_state_has(state, layout.value_count + own))
                } else {
                    blocked = mir_lint_any_moved(layout, state, if row.usage == .Reinitialize -> layout.ancestors[position] else -> layout.overlapping[position])
                }
                if blocked -> return MIRLintStep{successors: [MIRBlockID]{}, failure: mir_lint_fail(ctx, rule, span, "place {row.place.value} is used after it was moved")}
            }
        }
        // A definition starts the value's life, even on a loop's next turn.
        if instruction.result == .Val(defined) {
            if layout.value_bits.get(defined.value) == .Val(bit) -> mir_lint_state_set(&state, bit, false)
        }
        if !mir_lint_is_phi(operation) {
            mask :: mir_lint_consumption_borrow_mask(ctx, operation)
            loop value in mir_operation_value_uses(operation) {
                consumption :: mir_operation_value_consumption(operation, value, mask)
                failure :: mir_lint_consume_value(ctx, layout, &state, value, consumption, span, check)
                if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
            }
        }
        loop row in place_rows {
            position :: ctx.places.get(row.place.value) ?? next
            if row.usage == .Move {
                bit :: layout.moved[position]
                if bit >= 0 -> mir_lint_state_set(&state, layout.value_count + bit, true)
            }
            if row.usage == .Reinitialize {
                loop bit in layout.reinitialized[position] -> mir_lint_state_set(&state, layout.value_count + bit, false)
            }
        }
        if layout.safety.active {
            failure :: mir_lint_safety_step(ctx, layout, instruction, &state, check)
            if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
        }
        if !guards -> next
        known :: if operation == {
            .Constant(constant) -> mir_lint_bool_constant(constant)
            .ReadPlace(place) -> {
                truth := 0
                position :: ctx.places.get(place.value) ?? -1
                if position >= 0 && layout.slots[position] >= 0 {
                    slot :: layout.slots[position]
                    if mir_lint_state_has(state, mir_lint_slot_bit(layout, slot, true)) -> truth = 1
                    if mir_lint_state_has(state, mir_lint_slot_bit(layout, slot, false)) -> truth = 2
                }
                truth
            }
            .Copy(value, _) | .Move(value) -> mir_lint_known(layout, state, facts, value)
            .Unary(unary, value) -> {
                inner :: if unary == .Not -> mir_lint_known(layout, state, facts, value) else -> 0
                if inner == 0 -> 0 else -> 3 - inner
            }
            else -> 0
        }
        if instruction.result == .Val(result) {
            _ := &facts.add(result.value, known)
            if layout.crossing.get(result.value) == .Val(crossing) {
                mir_lint_state_set(&state, mir_lint_crossing_bit(layout, crossing, true), known == 1)
                mir_lint_state_set(&state, mir_lint_crossing_bit(layout, crossing, false), known == 2)
            }
        }
        written_place := MIRPlaceID?{None}
        written := 0
        if operation == {
            .WritePlace(place, value) | .ReplacePlace(place, value) -> {
                written_place = Val(place)
                written = mir_lint_known(layout, state, facts, value)
            }
            .MovePlace(place) | .InitializeUninit(place) -> written_place = Val(place)
            else -> {}
        }
        if written_place == .Val(place) {
            position :: ctx.places.get(place.value) ?? next
            slot :: layout.slots[position]
            if slot >= 0 {
                mir_lint_state_set(&state, mir_lint_slot_bit(layout, slot, true), written == 1)
                mir_lint_state_set(&state, mir_lint_slot_bit(layout, slot, false), written == 2)
            }
        }
    }
    if check && layout.safety.active {
        failure :: mir_lint_returned_view(ctx, layout, state, block)
        if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
    }
    if check {
        failure :: mir_lint_moved_failure(ctx, layout, state, mir_terminator_value_uses(block.terminator), block.span)
        if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
    }
    loop value in mir_terminator_value_uses(block.terminator) {
        consumption :: mir_terminator_value_consumption(block.terminator, value)
        failure :: mir_lint_consume_value(ctx, layout, &state, value, consumption, block.span, check)
        if failure != None -> return MIRLintStep{successors: [MIRBlockID]{}, failure: failure}
    }
    if guards {
        if block.terminator == .Branch(condition, then_target, else_target) {
            truth :: mir_lint_known(layout, state, facts, condition)
            if truth == 1 -> return MIRLintStep{successors: [MIRBlockID]{then_target}, failure: None}
            if truth == 2 -> return MIRLintStep{successors: [MIRBlockID]{else_target}, failure: None}
        }
    }
    MIRLintStep{successors: mir_terminator_targets(block.terminator), failure: None}
}

// ---------------------------------------------------------------------------
// The safety families: alias.exclusive, view.valid, and send.boundary. They
// prove from MIR facts alone what rustc's borrow checker and `Send` checks
// proved for the generated Rust. A written place has no other live access,
// and no view survives a change to its owner or outlives it. Only owned,
// copied, joined, or Shared data crosses a task, channel, or parallel boundary.

// The instruction that defines each value, and each Int constant, keyed by
// the value's ID word. Index projections that name two distinct constants
// are disjoint.
struct MIRLintDefs {
    rows: [U64:Int]
    blocks: [Int]
    positions: [Int]
    constants: [U64:Int]
}

// Rust: none (Jet-only pass)
fn mir_lint_defs(function: MIRFunction) -> MIRLintDefs Never! {
    rows := [U64:Int]{}
    blocks := [Int]{}
    positions := [Int]{}
    constants := [U64:Int]{}
    loop (block_position, block) in function.blocks {
        loop (position, instruction) in block.instructions {
            result :: instruction.result ?? next
            _ := &rows.add(result.value, blocks.len())
            &blocks.push(block_position)
            &positions.push(position)
            if instruction.operation == .Constant(constant) {
                if constant == .Int(number, _, _) -> _ := &constants.add(result.value, number)
            }
        }
    }
    MIRLintDefs{rows: rows, blocks: blocks, positions: positions, constants: constants}
}

// The definition row of `value`, or -1 for a value no instruction defines.
fn mir_lint_def_at(defs: MIRLintDefs, value: MIRValueID) -> Int Never! {
    defs.rows.get(value.value) ?? -1
}

// The place `value` was read or borrowed from, when that is its definition.
fn mir_lint_read_from(ctx: MIRLintContext, defs: MIRLintDefs, value: MIRValueID) -> MIRPlaceID? Never! {
    row :: mir_lint_def_at(defs, value)
    if row < 0 -> return None
    if ctx.function.blocks[defs.blocks[row]].instructions[defs.positions[row]].operation == {
        .ReadPlace(place) | .AddressOf(place, _) -> Val(place)
        else -> None
    }
}

// The place a task handle was taken from (`MovePlace`) or read from.
fn mir_lint_handle_from(ctx: MIRLintContext, defs: MIRLintDefs, value: MIRValueID) -> MIRPlaceID? Never! {
    row :: mir_lint_def_at(defs, value)
    if row < 0 -> return None
    if ctx.function.blocks[defs.blocks[row]].instructions[defs.positions[row]].operation == {
        .ReadPlace(place) | .MovePlace(place) -> Val(place)
        else -> None
    }
}

// A non-Copy value read straight out of a place shares that place's storage.
fn mir_lint_shared_read(ctx: MIRLintContext, defs: MIRLintDefs, value: MIRValueID) -> MIRPlaceID? Never! {
    row :: ctx.values.get(value.value) ?? return None
    if ctx.function.values[row].ownership.mode == .Copy -> return None
    if ctx.function.values[row].ty.layout.abi == .Scalar(_) -> return None
    mir_lint_read_from(ctx, defs, value)
}

// The index of the parameter a `Parameter` value names, or -1.
fn mir_lint_parameter_index(ctx: MIRLintContext, defs: MIRLintDefs, value: MIRValueID) -> Int Never! {
    row :: mir_lint_def_at(defs, value)
    if row < 0 -> return -1
    if ctx.function.blocks[defs.blocks[row]].instructions[defs.positions[row]].operation == {
        .Parameter(index, _) -> index
        else -> -1
    }
}

// The key of the local at the root of `place` ("" for any other root). With
// `whole`, only a place without projections counts.
fn mir_lint_root_local(ctx: MIRLintContext, place: MIRPlaceID, whole: Bool) -> String Never! {
    row :: ctx.places.get(place.value) ?? return ""
    if whole && ctx.function.places[row].projections.len() > 0 -> return ""
    if ctx.function.places[row].base == .Local(local) -> return mir_lint_key(local.value)
    ""
}

// Two projections at the same depth reach the same storage unless they name
// different fields or two distinct constant indexes.
fn mir_lint_projections_overlap(defs: MIRLintDefs, left: MIRProjection, right: MIRProjection) -> Bool Never! {
    if left == .Field(field, _) {
        if right == .Field(other, _) -> return field == other
        return true
    }
    if left == .Index(_, index, _, _, _, _, _) {
        if right == .Index(_, other, _, _, _, _, _) {
            known :: defs.constants.get(index.value) ?? return true
            other_known :: defs.constants.get(other.value) ?? return true
            return known == other_known
        }
    }
    true
}

// Two places overlap when they share a root and neither path leaves the
// other at a disjoint projection.
fn mir_lint_places_overlap(ctx: MIRLintContext, defs: MIRLintDefs, left: MIRPlaceID, right: MIRPlaceID) -> Bool Never! {
    left_row :: ctx.places.get(left.value) ?? return false
    right_row :: ctx.places.get(right.value) ?? return false
    if mir_lint_place_root(ctx.function.places[left_row]) != mir_lint_place_root(ctx.function.places[right_row]) -> return false
    count := ctx.function.places[left_row].projections.len()
    if ctx.function.places[right_row].projections.len() < count -> count = ctx.function.places[right_row].projections.len()
    loop position in 0..<count {
        if !mir_lint_projections_overlap(defs, ctx.function.places[left_row].projections[position], ctx.function.places[right_row].projections[position]) -> return false
    }
    true
}

// `ancestor` is `place` or a path that contains it, by exact projections.
fn mir_lint_place_contains(ctx: MIRLintContext, ancestor: MIRPlaceID, place: MIRPlaceID) -> Bool Never! {
    ancestor_row :: ctx.places.get(ancestor.value) ?? return false
    place_row :: ctx.places.get(place.value) ?? return false
    mir_lint_path_prefix(mir_lint_path_key(ctx.function.places[ancestor_row]), mir_lint_path_key(ctx.function.places[place_row]))
}

fn mir_lint_is_send_fn(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .SendFn(_, _, _) -> true
        else -> false
    }
}

fn mir_lint_is_view_name(leaf: String) -> Bool Never! {
    leaf == "View" || leaf == "ViewMut" || leaf == "ComputeViewMut"
}

// A borrowed window type: `View<T>`, `ViewMut<T>`, or `ComputeViewMut<T>`,
// read through the peeled carriers and compared at the leaf in place.
fn mir_lint_is_view_type(ty: MIRType) -> Bool Never! {
    if ty.kind == {
        .Tagged(_, inner) -> mir_lint_is_view_type(inner)
        .InlineRange(base, _, _) -> mir_lint_is_view_type(base)
        .Quantity(base, _) -> mir_lint_is_view_type(base)
        .Shared(inner) -> mir_lint_is_view_type(inner)
        .Apply(name, _) -> mir_lint_leaf_is(name.name, "View") || mir_lint_leaf_is(name.name, "ViewMut") || mir_lint_leaf_is(name.name, "ComputeViewMut")
        else -> false
    }
}

// Why a value of type `ty` cannot cross a task, channel, or parallel
// boundary: it holds a `Cell`, a view, or a function that is not sendable.
// Shared data and sendable functions cross.
fn mir_lint_unsendable(index: MIRLintIndex, ty: MIRType, seen: &[U64:Bool]) -> String? Never! {
    if ty.kind == {
        .Shared(_) | .SendFn(_, _, _) -> None
        .Fn(_) -> Val("a function that is not sendable")
        .Tagged(_, inner) | .List(inner) | .Option(inner) -> mir_lint_unsendable(index, inner, &seen)
        .InlineRange(base, _, _) | .Quantity(base, _) -> mir_lint_unsendable(index, base, &seen)
        .FixedList(element, _) -> mir_lint_unsendable(index, element, &seen)
        .Map(key, value) -> mir_lint_unsendable_pair(index, key, value, &seen)
        .Result(ok, err) -> mir_lint_unsendable_pair(index, ok, err, &seen)
        .Tuple(fields) -> {
            loop field in fields {
                reason :: mir_lint_unsendable(index, field.ty, &seen)
                if reason != None -> return reason
            }
            None
        }
        .Union(members) -> {
            loop member in members {
                reason :: mir_lint_unsendable(index, member, &seen)
                if reason != None -> return reason
            }
            None
        }
        .Apply(name, args) -> {
            leaf :: mir_lint_leaf(name.name)
            if leaf == "Cell" || mir_lint_is_view_name(leaf) -> return Val("a `{leaf}`")
            loop arg in args {
                reason :: mir_lint_unsendable(index, arg, &seen)
                if reason != None -> return reason
            }
            mir_lint_unsendable_declaration(index, name.id, leaf, &seen)
        }
        else -> None
    }
}

fn mir_lint_unsendable_pair(index: MIRLintIndex, first: MIRType, second: MIRType, seen: &[U64:Bool]) -> String? Never! {
    reason :: mir_lint_unsendable(index, first, &seen)
    if reason != None -> return reason
    mir_lint_unsendable(index, second, &seen)
}

// The declared fields and variant payloads of a nominal type, each once.
fn mir_lint_unsendable_declaration(index: MIRLintIndex, id: MIRTypeID, leaf: String, seen: &[U64:Bool]) -> String? Never! {
    if seen.get(id.value) != None -> return None
    _ := &seen.add(id.value, true)
    position :: index.types.get(id.value) ?? return None
    if index.type_rows[position].target == .Val(target) -> return mir_lint_unsendable(index, target, &seen)
    if index.type_rows[position].fields == .Val(fields) {
        loop field in fields {
            reason :: mir_lint_unsendable(index, field.ty, &seen) ?? next
            return Val("{reason} in field `{leaf}.{field.name}`")
        }
    }
    if index.type_rows[position].variants == .Val(variants) {
        loop variant in variants {
            if variant.payload == {
                .Single(payload) -> {
                    reason :: mir_lint_unsendable(index, payload, &seen) ?? next
                    return Val("{reason} in variant `{leaf}.{variant.name}`")
                }
                .Named(fields) -> {
                    loop field in fields {
                        reason :: mir_lint_unsendable(index, field.ty, &seen) ?? next
                        return Val("{reason} in variant `{leaf}.{variant.name}`")
                    }
                }
                else -> {}
            }
        }
    }
    None
}

// The places a closure value writes through its captured places.
fn mir_lint_closure_writes(ctx: MIRLintContext, defs: MIRLintDefs, value: MIRValueID) -> [MIRPlaceID] Never! {
    places := [MIRPlaceID]{}
    row :: mir_lint_def_at(defs, value)
    if row < 0 -> return places
    if ctx.function.blocks[defs.blocks[row]].instructions[defs.positions[row]].operation == .Closure(function, captures, _) {
        position :: ctx.index.functions.get(function.value) ?? return places
        loop (slot, capture) in captures {
            if slot >= ctx.index.signatures[position].captures.len() -> break
            if ctx.index.signatures[position].captures[slot].access != .Write -> next
            place :: if capture == {
                .Place(captured) -> Val(captured)
                .Value(captured) -> mir_lint_shared_read(ctx, defs, captured)
            }
            if place == .Val(captured) -> mir_lint_push_owner(&places, captured)
        }
    }
    places
}

// Places an operation writes, moves, resizes, or opens a write window into.
fn mir_lint_changed_places(operation: MIROperation) -> [MIRPlaceID] Never! {
    places := [MIRPlaceID]{}
    if operation == {
        .WritePlace(place, _) | .ReplacePlace(place, _) -> &places.push(place)
        .MovePlace(place) | .InitializeUninit(place) -> &places.push(place)
        .AddressOf(place, access) -> {
            if access == .Write -> &places.push(place)
        }
        .Semantic(semantic) -> {
            if semantic == {
                .BuiltinMethod(_, _, receiver_place, _, _) -> {
                    if receiver_place == .Val(place) -> &places.push(place)
                }
                .CursorTakePattern(_, place, _) | .ReaderTakePattern(_, place, _) -> &places.push(place)
                else -> {}
            }
        }
        else -> {}
    }
    loop arg in mir_operation_call_args(operation) {
        if arg.place == .Val(place) {
            if arg.access == .Write || arg.access == .Move -> &places.push(place)
        }
    }
    places
}

// Places an operation reads or borrows for reading.
fn mir_lint_read_places(operation: MIROperation) -> [MIRPlaceID] Never! {
    places := [MIRPlaceID]{}
    if operation == {
        .ReadPlace(place) | .RawAddressOf(place) -> &places.push(place)
        .AddressOf(place, access) -> {
            if access != .Write -> &places.push(place)
        }
        .Closure(_, captures, _) -> {
            loop capture in captures {
                if capture == .Place(place) -> &places.push(place)
            }
        }
        else -> {}
    }
    loop arg in mir_operation_call_args(operation) {
        if arg.place == .Val(place) {
            if arg.access == .Read -> &places.push(place)
        }
    }
    places
}

// The stateless checks: `alias.exclusive` within one operation and
// `send.boundary` at every sendable closure and channel send.
// Rust: none (Jet-only pass)
fn mir_lint_safety_static(ctx: MIRLintContext, defs: MIRLintDefs) -> MIRLintError? Never! {
    consumers :: mir_lint_closure_consumers(ctx)
    loop block in ctx.function.blocks {
        loop instruction in block.instructions {
            exclusive :: mir_lint_call_exclusive(ctx, defs, instruction.operation)
            if exclusive == .Val(problem) -> return mir_lint_fail(ctx, problem.rule, instruction.span, problem.detail)
            crossing :: mir_lint_crossing(ctx, defs, consumers, instruction)
            if crossing == .Val(problem) -> return mir_lint_fail(ctx, problem.rule, instruction.span, problem.detail)
        }
    }
    None
}

// How each sendable closure value crosses: 1 as a task-group child (joined
// when the group's scope exits), 2 as a task outside a group, 3 as a
// parallel worker (joined inside the call).
fn mir_lint_closure_consumers(ctx: MIRLintContext) -> [U64:Int] Never! {
    consumers := [U64:Int]{}
    loop block in ctx.function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Semantic(semantic) {
                if semantic == .CoreClosureCall(_, kind, values, closure, _, _) {
                    if kind == .Spawn {
                        if closure == .Val(value) -> _ := &consumers.add(value.value, if values.len() == 3 -> 1 else -> 2)
                    }
                }
                if semantic == .ClosureMethod(_, args, call) {
                    if ctx.index.parallel_routes.get(call.value) != None {
                        loop arg in args -> _ := &consumers.add(arg.value.value, 3)
                    }
                }
            }
        }
    }
    consumers
}

// `alias.exclusive` within one operation: a place an argument writes,
// directly or through a closure argument's captures, overlaps no other
// argument, receiver, or captured place of the same operation.
fn mir_lint_call_exclusive(ctx: MIRLintContext, defs: MIRLintDefs, operation: MIROperation) -> MIRLintProblem? Never! {
    places := [MIRPlaceID]{}
    writes := [Bool]{}
    any_write := false
    loop arg in mir_operation_call_args(operation) {
        if arg.place == .Val(place) {
            &places.push(place)
            &writes.push(arg.access == .Write)
            if arg.access == .Write -> any_write = true
            next
        }
        shared :: mir_lint_shared_read(ctx, defs, arg.value)
        if shared == .Val(place) {
            &places.push(place)
            &writes.push(false)
        }
        loop place in mir_lint_closure_writes(ctx, defs, arg.value) {
            &places.push(place)
            &writes.push(true)
            any_write = true
        }
    }
    if operation == .Semantic(semantic) {
        if semantic == .BuiltinMethod(_, _, receiver_place, args, _) {
            if receiver_place == .Val(place) {
                &places.push(place)
                &writes.push(true)
                any_write = true
            }
            loop value in args {
                shared :: mir_lint_shared_read(ctx, defs, value)
                if shared == .Val(place) {
                    &places.push(place)
                    &writes.push(false)
                }
                loop place in mir_lint_closure_writes(ctx, defs, value) {
                    &places.push(place)
                    &writes.push(true)
                    any_write = true
                }
            }
        }
        if semantic == .ClosureMethod(receiver, _, _) {
            shared :: mir_lint_shared_read(ctx, defs, receiver)
            if shared == .Val(place) {
                &places.push(place)
                &writes.push(false)
            }
        }
    }
    if !any_write -> return None
    loop written in 0..<places.len() {
        if !writes[written] -> next
        loop other in 0..<places.len() {
            if other == written -> next
            if mir_lint_places_overlap(ctx, defs, places[written], places[other]) -> return mir_lint_problem(.AliasExclusive, "place {places[written].value} is written while place {places[other].value} reaches the same storage in the same operation")
        }
    }
    None
}

// `send.boundary` at one instruction. A sendable closure captures only
// sendable values. It borrows places only as a task-group child, or for reading
// as a parallel worker. It writes or shares a captured place's storage only
// as a task-group child. A channel send carries only sendable values.
fn mir_lint_crossing(ctx: MIRLintContext, defs: MIRLintDefs, consumers: [U64:Int], instruction: MIRInstruction) -> MIRLintProblem? Never! {
    rule :: MIRLintRule.SendBoundary
    if instruction.operation == .Semantic(semantic) {
        if semantic == .HandleMethod(call, _, args, _, _) {
            if ctx.index.channel_sends.get(call.value) == None -> return None
            loop value in args {
                ty :: mir_lint_type_of(ctx, value) ?? next
                seen := [U64:Bool]{}
                reason :: mir_lint_unsendable(ctx.index, ty, &seen) ?? next
                return mir_lint_problem(rule, "value {value.value} sent on a channel holds {reason}")
            }
        }
        return None
    }
    closure_type :: instruction.ty ?? return None
    if !mir_lint_is_send_fn(closure_type) -> return None
    if instruction.operation == .Closure(function, captures, _) {
        result :: instruction.result ?? return None
        consumer :: consumers.get(result.value) ?? 0
        boundary :: if {
            consumer == 1 -> "task-group child"
            consumer == 2 -> "task"
            consumer == 3 -> "parallel worker"
            else -> "sendable closure"
        }
        position :: ctx.index.functions.get(function.value) ?? return None
        loop (slot, capture) in captures {
            access :: if slot < ctx.index.signatures[position].captures.len() -> ctx.index.signatures[position].captures[slot].access else -> MIRAccess.Read
            if capture == {
                .Place(place) -> {
                    row :: ctx.places.get(place.value) ?? next
                    seen := [U64:Bool]{}
                    reason :: mir_lint_unsendable(ctx.index, ctx.function.places[row].ty, &seen)
                    if reason == .Val(why) -> return mir_lint_problem(rule, "capture {slot} borrows place {place.value}, which holds {why}, across the {boundary} boundary")
                    if consumer == 1 || (consumer == 3 && access == .Read) -> next
                    return mir_lint_problem(rule, "capture {slot} borrows place {place.value} across the {boundary} boundary, which is not joined before the owner continues")
                }
                .Value(value) -> {
                    ty :: mir_lint_type_of(ctx, value) ?? next
                    seen := [U64:Bool]{}
                    reason :: mir_lint_unsendable(ctx.index, ty, &seen)
                    if reason == .Val(why) -> return mir_lint_problem(rule, "capture {slot} carries value {value.value}, which holds {why}, across the {boundary} boundary")
                    if consumer == 1 -> next
                    if access == .Write -> return mir_lint_problem(rule, "capture {slot} writes the owner's state across the {boundary} boundary")
                    shared :: mir_lint_shared_read(ctx, defs, value)
                    if shared == .Val(place) -> return mir_lint_problem(rule, "capture {slot} shares the storage of place {place.value} across the {boundary} boundary")
                }
            }
        }
    }
    None
}

// The flow facts of the safety families. An origin is a value that keeps
// access to places. A view origin goes stale once a path containing its
// owner is changed. An exclusive origin is a closure that writes captured
// places, and it goes stale once any overlapping access bypasses it. A holder
// is a local that stores an origin. A loan is a place lent to a task-group
// child until the group's scope exits or the child's handle is joined.
struct MIRLintSafety {
    active: Bool
    // Value -> SSA-generation/root association rows, propagated to a fixed
    // point over Move/Phi and borrowed carriers. No move-depth cutoff.
    // Value-keyed rows are keyed by the value's ID word.
    origins: [U64:[Int]]
    origin_values: [U64]
    origin_roots: [Int]
    root_values: [U64]
    origin_places: [[MIRPlaceID]]
    origin_exclusive: [Bool]
    owner_origins: [String:[Int]]
    // Local key -> holder rows; a holder pairs a local with an origin.
    holders: [String:[Int]]
    holder_origins: [Int]
    origin_holders: [[Int]]
    // Spawn result value -> loan rows, and local key -> the loan rows of
    // the task handles it stores. A loan's scope is None when its group's
    // scope is unresolved.
    loans: [U64:[Int]]
    loan_places: [MIRPlaceID]
    loan_writes: [Bool]
    loan_scopes: [U64?]
    loan_tasks: [U64]
    task_holders: [String:[Int]]
    task_holder_loans: [Int]
}


// Whether the result of `operation` is a fresh view of an operand's place,
// rather than one carried over (a move, join, or read) or materialized (a copy).
// A view read out of a value that stores it (an Optional/Result/enum payload,
// a list element, a struct field) is that stored view, carried from the
// value, not a new view of the value's place: the generated Rust copies the
// inner `&[T]` with its own lifetime when it matches an `Option<&[T]>` or
// indexes a `Vec<&[T]>`, so rewriting the holder never invalidates it.
fn mir_lint_makes_view(operation: MIROperation) -> Bool Never! {
    if operation == {
        .Move(_) | .Phi(_) | .ReadPlace(_) | .MovePlace(_) | .Copy(_, _) | .Parameter(_, _) | .Capture(_) -> false
        .OptionValue(_) | .ResultValue(_, _) | .EnumPayload(_, _, _, _) | .Field(_, _) | .Index(_, _, _, _, _, _, _) -> false
        else -> true
    }
}

// Resolve every declared `from` source, not merely the first operand. The
// owner's whole place is conservative when the contract narrows a projection.
fn mir_lint_view_owners(ctx: MIRLintContext, defs: MIRLintDefs, operation: MIROperation) -> [MIRPlaceID] Never! {
    owners := [MIRPlaceID]{}
    args :: mir_operation_call_args(operation)
    provenance := [MIRViewProvenanceEntry]?{None}
    receiver := -1
    if operation == .Call(callee, _, _) {
        target :: if callee == {
            .User(function) | .Associated(function, _) | .Method(function, _) -> Val(function)
            else -> None
        }
        if target == .Val(function) {
            position :: ctx.index.functions.get(function.value) ?? -1
            if position >= 0 {
                // copy: the callee's return-view provenance stays in the index (owner: ctx.index,
                // read parameter) while this call check owns its copy (owner: `provenance`,
                // assigned on either call shape).
                provenance = ctx.index.signatures[position].return_view_provenance.copy()
                loop (slot, param) in ctx.index.signatures[position].params {
                    if param.name == "self" -> receiver = slot
                }
            }
        }
    }
    if operation == .IndirectCall(callee, _, _) {
        ty :: mir_lint_type_of(ctx, callee)
        if ty == .Val(callable) {
            // copy: the callable type's return-view provenance stays with the operand type (owner:
            // `ty`, a lookup result view) while this call check owns its copy (owner:
            // `provenance`).
            if callable.kind == .Fn(signature) -> provenance = signature.return_view_provenance.copy()
        }
    }
    if provenance == .Val(entries) {
        loop entry in entries {
            loop source in entry.provenance.sources {
                slot := -1
                if source.source == {
                    .Parameter(index) -> slot = index
                    .Receiver -> slot = receiver
                    .Static(module_path, name) -> {
                        loop place in ctx.function.places {
                            if place.base == .Static(path) {
                                if path == name || path == ("{module_path}.{name}") -> mir_lint_push_owner(&owners, place.id)
                            }
                        }
                    }
                }
                if slot >= 0 && slot < args.len() {
                    owner := args[slot].place
                    if owner == None -> owner = mir_lint_read_from(ctx, defs, args[slot].value)
                    if owner == .Val(place) -> mir_lint_push_owner(&owners, place)
                }
            }
        }
        return owners
    }
    // Builtins and other operations without a callee contract derive their
    // owner set from all operand places. Never discard a second owner.
    loop arg in args {
        if arg.place == .Val(place) -> mir_lint_push_owner(&owners, place)
    }
    loop value in mir_operation_value_uses(operation) {
        owner :: mir_lint_read_from(ctx, defs, value) ?? next
        mir_lint_push_owner(&owners, owner)
    }
    owners
}

fn mir_lint_push_owner(owners: &[MIRPlaceID], owner: MIRPlaceID) Never! {
    if !owners.contains(owner) -> &owners.push(owner)
}

// Phi generations receive only the selected predecessor's associations.
// A union at the destination then preserves every possibly active/stale one.
fn mir_lint_phi_safety(ctx: MIRLintContext, layout: MIRLintOwnership, from: MIRBlockID, target: MIRBasicBlock, state: &MIRLintState) Never! {
    loop instruction in target.instructions {
        if instruction.operation == .Phi(incoming) {
            result :: instruction.result ?? next
            loop edge in incoming {
                if edge.block != from -> next
                selected :: layout.safety.origins.get(edge.value.value) ?? [Int]{}
                loop origin in (layout.safety.origins.get(result.value) ?? [Int]{}) {
                    active := false
                    stale := false
                    loop source in selected {
                        if layout.safety.origin_roots[source] != layout.safety.origin_roots[origin] -> next
                        if !mir_lint_state_has(state, mir_lint_origin_active_bit(layout, source)) -> next
                        active = true
                        if mir_lint_state_has(state, layout.safety_base + source) -> stale = true
                    }
                    mir_lint_state_set(&state, mir_lint_origin_active_bit(layout, origin), active)
                    mir_lint_state_set(&state, layout.safety_base + origin, stale)
                }
            }
        }
    }
}

fn mir_lint_borrow_carrier(ctx: MIRLintContext, instruction: MIRInstruction) -> Bool Never! {
    result :: instruction.result ?? return false
    target :: ctx.values.get(result.value) ?? return false
    fact :: ctx.function.values[target]
    if fact.ownership.mode == .ReadBorrow || fact.ownership.mode == .WriteBorrow || mir_lint_is_view_type(fact.ty) -> return true
    if instruction.operation == {
        .Move(_) | .Phi(_) | .AttachTag(_, _) | .Closure(_, _, _) -> true
        .Convert(_, _, _, conversion) -> conversion == .Transparent || conversion == .SendFn
        else -> false
    }
}

// Reused from 158609fe2: each (SSA value, primary origin) propagates once.
// Keep this def-use fixed point separate from the CFG may-safety flow.
fn mir_lint_propagate_borrow_origins(ctx: MIRLintContext, defs: MIRLintDefs, origins: &[U64:[Int]], primary: [U64]) Never! {
    if primary.len() == 0 -> return
    edges := [[Int]]{}
    carried := [[Int]]{}
    cursors := [Int]{}
    queued := [Bool]{}
    loop _ in ctx.function.values {
        &edges.push([Int]{})
        &carried.push([Int]{})
        &cursors.push(0)
        &queued.push(false)
    }
    stored := [String:[Int]]{}
    loop block in ctx.function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .WritePlace(place, value) | .ReplacePlace(place, value) -> {
                    local :: mir_lint_root_local(ctx, place, true)
                    if local == "" -> next
                    source :: ctx.values.get(value.value) ?? next
                    rows := stored.get(local) ?? [Int]{}
                    &rows.push(source)
                    _ := &stored.add(local, rows)
                }
                else -> {}
            }
        }
    }
    loop block in ctx.function.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            target :: ctx.values.get(result.value) ?? next
            if !mir_lint_borrow_carrier(ctx, instruction) -> next
            seen := [Int:Bool]{}
            loop operand in mir_operation_value_uses(instruction.operation) {
                source :: ctx.values.get(operand.value) ?? next
                if seen.get(source) != None -> next
                _ := &seen.add(source, true)
                &edges[source].push(target)
            }
            loop place in mir_operation_place_uses(instruction.operation) {
                local :: mir_lint_root_local(ctx, place, false)
                if local == "" -> next
                loop source in (stored.get(local) ?? [Int]{}) -> &edges[source].push(target)
            }
        }
    }
    members := [Int:Bool]{}
    work := [Int]{}
    loop key in primary {
        definition :: defs.rows.get(key) ?? next
        value :: ctx.function.blocks[defs.blocks[definition]].instructions[defs.positions[definition]].result ?? next
        row :: ctx.values.get(value.value) ?? next
        loop origin in (origins.get(key) ?? [Int]{}) {
            _ := &members.add(row * primary.len() + origin, true)
            &carried[row].push(origin)
        }
        if !queued[row] {
            queued[row] = true
            &work.push(row)
        }
    }
    head := 0
    loop head < work.len() {
        row :: work[head].copy()
        head += 1
        queued[row] = false
        loop cursors[row] < carried[row].len() {
            origin :: carried[row][cursors[row]].copy()
            cursors[row] = cursors[row] + 1
            loop target in edges[row] {
                key :: target * primary.len() + origin
                if members.get(key) != None -> next
                _ := &members.add(key, true)
                &carried[target].push(origin)
                if !queued[target] {
                    queued[target] = true
                    &work.push(target)
                }
            }
        }
    }
    loop (row, fact) in ctx.function.values {
        if carried[row].len() > 0 -> _ := &origins.add(fact.id.value, carried[row])
    }
}

fn mir_lint_stale_origins_for_access(ctx: MIRLintContext, layout: MIRLintOwnership, state: &MIRLintState, place: MIRPlaceID, writing: Bool, own: U64?) Never! {
    position :: ctx.places.get(place.value) ?? return
    safety :: layout.safety
    root :: mir_lint_place_root(ctx.function.places[position])
    loop origin in (safety.owner_origins.get(root) ?? [Int]{}) {
        root_row :: safety.origin_roots[origin]
        if !writing && !safety.origin_exclusive[root_row] -> next
        overlaps := false
        loop owner in safety.origin_places[root_row] {
            if mir_lint_places_overlap(ctx, layout.defs, place, owner) {
                overlaps = true
                break
            }
        }
        if !overlaps -> next
        if Val(safety.origin_values[origin]) != own && mir_lint_state_has(state, mir_lint_origin_active_bit(layout, origin)) -> mir_lint_state_set(&state, layout.safety_base + origin, true)
        // A holder owns its generation's stale bit: refreshing its source
        // in a loop must not refresh an older stored window.
        loop holder in safety.origin_holders[origin] {
            if mir_lint_state_has(state, mir_lint_holder_bit(layout, holder)) -> mir_lint_state_set(&state, mir_lint_holder_stale_bit(layout, holder), true)
        }
    }
}

// Scope names are lowered from the group's checked local; choose the
// innermost matching scope enclosing that local. An unresolved owner stays
// outstanding rather than being cleared by some unrelated group's exit.
fn mir_lint_loan_scope(ctx: MIRLintContext, defs: MIRLintDefs, group: MIRValueID) -> U64? Never! {
    place :: mir_lint_handle_from(ctx, defs, group) ?? return None
    row :: ctx.places.get(place.value) ?? return None
    if ctx.function.places[row].base == .Local(local) {
        loop owner in ctx.function.locals {
            if owner.id != local -> next
            selected := U64?{None}
            width := -1
            loop scope in ctx.function.scopes {
                if scope.kind != .TaskGroup || scope.name != Val(owner.name) -> next
                if scope.span.start > owner.span.start || scope.span.end < owner.span.end -> next
                size :: scope.span.end - scope.span.start
                if width < 0 || size < width {
                    selected = Val(scope.id.value)
                    width = size
                }
            }
            return selected
        }
    }
    None
}

// Rust: none (Jet-only pass)
fn mir_lint_safety_layout(ctx: MIRLintContext, defs: MIRLintDefs) -> MIRLintSafety Never! {
    function :: ctx.function
    origins := [U64:[Int]]{}
    origin_values := [U64]{}
    origin_places := [[MIRPlaceID]]{}
    origin_exclusive := [Bool]{}
    loans := [U64:[Int]]{}
    loan_places := [MIRPlaceID]{}
    loan_writes := [Bool]{}
    loan_scopes := [U64?]{}
    loan_tasks := [U64]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            result :: instruction.result ?? next
            ty :: instruction.ty ?? next
            key :: result.value
            if instruction.operation == .Closure(_, _, _) {
                if mir_lint_is_send_fn(ty) -> next
                writes :: mir_lint_closure_writes(ctx, defs, result)
                if writes.len() == 0 -> next
                _ := &origins.add(key, [Int]{origin_places.len()})
                &origin_values.push(key)
                &origin_places.push(writes)
                &origin_exclusive.push(true)
                next
            }
            if instruction.operation == .ReadPlace(place) {
                row :: ctx.values.get(result.value) ?? -1
                if row >= 0 && function.values[row].ownership.mode == .ReadBorrow {
                    _ := &origins.add(key, [Int]{origin_places.len()})
                    &origin_values.push(key)
                    &origin_places.push([MIRPlaceID]{place})
                    &origin_exclusive.push(false)
                    next
                }
            }
            if mir_lint_is_view_type(ty) && mir_lint_makes_view(instruction.operation) {
                owners :: mir_lint_view_owners(ctx, defs, instruction.operation)
                if owners.len() > 0 {
                    _ := &origins.add(key, [Int]{origin_places.len()})
                    &origin_values.push(key)
                    &origin_places.push(owners)
                    &origin_exclusive.push(false)
                }
                next
            }
            if instruction.operation == .Semantic(semantic) {
                if semantic == .CoreClosureCall(_, kind, values, closure, _, _) {
                    if kind != .Spawn || values.len() != 3 -> next
                    group_scope :: mir_lint_loan_scope(ctx, defs, values[0])
                    closure_value :: closure ?? next
                    row :: mir_lint_def_at(defs, closure_value)
                    if row < 0 -> next
                    rows := [Int]{}
                    if function.blocks[defs.blocks[row]].instructions[defs.positions[row]].operation == .Closure(callee, captures, _) {
                        position :: ctx.index.functions.get(callee.value) ?? next
                        loop (slot, capture) in captures {
                            write :: slot < ctx.index.signatures[position].captures.len() && ctx.index.signatures[position].captures[slot].access == .Write
                            lent :: if capture == {
                                .Place(place) -> Val(place)
                                .Value(value) -> mir_lint_shared_read(ctx, defs, value)
                            }
                            if lent == .Val(place) {
                                &rows.push(loan_places.len())
                                &loan_places.push(place)
                                &loan_writes.push(write)
                                &loan_scopes.push(group_scope)
                                &loan_tasks.push(key)
                            }
                        }
                    }
                    if rows.len() > 0 -> _ := &loans.add(key, rows)
                }
            }
        }
    }
    mir_lint_propagate_borrow_origins(ctx, defs, &origins, origin_values)
    root_values :: ^origin_values
    origin_values = [U64]{}
    origin_roots := [Int]{}
    associations := [U64:[Int]]{}
    loop value in function.values {
        key :: value.id.value
        rows := [Int]{}
        loop root in (origins.get(key) ?? [Int]{}) {
            &rows.push(origin_roots.len())
            &origin_roots.push(root)
            &origin_values.push(key)
        }
        if rows.len() > 0 -> _ := &associations.add(key, rows)
    }
    origins = associations
    // Resolve primary owner roots once, rather than once for every SSA alias.
    owner_keys := [[String]]{}
    seen_owner := [String:Int]{}
    loop (root_row, places) in origin_places {
        keys := [String]{}
        loop place in places {
            position :: ctx.places.get(place.value) ?? next
            root :: mir_lint_place_root(function.places[position])
            if (seen_owner.get(root) ?? -1) == root_row -> next
            _ := &seen_owner.add(root, root_row)
            &keys.push(root)
        }
        &owner_keys.push(keys)
    }
    owner_origins := [String:[Int]]{}
    loop (origin, root_row) in origin_roots {
        loop root in owner_keys[root_row] {
            rows := owner_origins.get(root) ?? [Int]{}
            &rows.push(origin)
            _ := &owner_origins.add(root, rows)
        }
    }
    // Holders: whole locals written with an origin or with a task handle.
    holders := [String:[Int]]{}
    holder_origins := [Int]{}
    task_holders := [String:[Int]]{}
    task_holder_loans := [Int]{}
    if origin_places.len() > 0 || loan_places.len() > 0 {
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .WritePlace(place, value) | .ReplacePlace(place, value) -> {
                        local :: mir_lint_root_local(ctx, place, true)
                        if local == "" -> next
                        loop origin in (origins.get(value.value) ?? [Int]{}) {
                            rows := holders.get(local) ?? [Int]{}
                            known := false
                            loop holder in rows {
                                if holder_origins[holder] == origin -> known = true
                            }
                            if !known {
                                &rows.push(holder_origins.len())
                                &holder_origins.push(origin)
                                _ := &holders.add(local, rows)
                            }
                        }
                        spawned :: loans.get(value.value) ?? next
                        lent := task_holders.get(local) ?? [Int]{}
                        loop loan in spawned {
                            known := false
                            loop holder in lent {
                                if task_holder_loans[holder] == loan -> known = true
                            }
                            if !known {
                                &lent.push(task_holder_loans.len())
                                &task_holder_loans.push(loan)
                            }
                        }
                        _ := &task_holders.add(local, lent)
                    }
                    else -> {}
                }
            }
        }
    }
    origin_holders := [[Int]]{}
    loop _ in origin_roots -> &origin_holders.push([Int]{})
    loop (holder, origin) in holder_origins -> &origin_holders[origin].push(holder)
    MIRLintSafety{
        active: origin_places.len() > 0 || loan_places.len() > 0,
        origins: origins,
        origin_values: origin_values,
        origin_roots: origin_roots,
        root_values: root_values,
        origin_places: origin_places,
        origin_exclusive: origin_exclusive,
        owner_origins: owner_origins,
        holders: holders,
        holder_origins: holder_origins,
        origin_holders: origin_holders,
        loans: loans,
        loan_places: loan_places,
        loan_writes: loan_writes,
        loan_scopes: loan_scopes,
        loan_tasks: loan_tasks,
        task_holders: task_holders,
        task_holder_loans: task_holder_loans,
    }
}

fn mir_lint_origin_active_bit(layout: MIRLintOwnership, origin: Int) -> Int Never! {
    layout.safety_base + layout.safety.origin_roots.len() + origin
}

fn mir_lint_holder_bit(layout: MIRLintOwnership, holder: Int) -> Int Never! {
    layout.safety_base + 2 * layout.safety.origin_roots.len() + holder
}

fn mir_lint_holder_stale_bit(layout: MIRLintOwnership, holder: Int) -> Int Never! {
    layout.safety_base + 2 * layout.safety.origin_roots.len() + layout.safety.holder_origins.len() + holder
}

fn mir_lint_loan_bit(layout: MIRLintOwnership, loan: Int) -> Int Never! {
    layout.safety_base + 2 * layout.safety.origin_roots.len() + 2 * layout.safety.holder_origins.len() + loan
}

fn mir_lint_task_holder_bit(layout: MIRLintOwnership, holder: Int) -> Int Never! {
    mir_lint_loan_bit(layout, layout.safety.loan_places.len()) + holder
}

// Clear only a uniquely identified joined task. A holder has current CFG
// state, not the union of every task ever written to that local. Ambiguous
// handles remain outstanding until their owning group's scope exits.
fn mir_lint_joined_task(ctx: MIRLintContext, layout: MIRLintOwnership, state: &MIRLintState, receiver: MIRValueID) Never! {
    safety :: layout.safety
    candidates := [Int]{}
    source :: mir_lint_handle_from(ctx, layout.defs, receiver)
    if source == .Val(place) {
        local :: mir_lint_root_local(ctx, place, true)
        loop holder in (safety.task_holders.get(local) ?? [Int]{}) {
            if mir_lint_state_has(state, mir_lint_task_holder_bit(layout, holder)) -> &candidates.push(safety.task_holder_loans[holder])
        }
    } else {
        candidates = safety.loans.get(receiver.value) ?? [Int]{}
    }
    joined := U64?{None}
    loop loan in candidates {
        if joined == None -> joined = Val(safety.loan_tasks[loan])
        if joined != Val(safety.loan_tasks[loan]) -> return
    }
    if joined == None -> return
    loop loan in 0..<safety.loan_places.len() {
        if Val(safety.loan_tasks[loan]) == joined -> mir_lint_state_set(&state, mir_lint_loan_bit(layout, loan), false)
    }
}

// The failure for a use of a stale origin: a view whose owner changed is
// `view.valid`; a writing closure whose places were accessed around it is
// `alias.exclusive`.
fn mir_lint_stale_failure(ctx: MIRLintContext, safety: MIRLintSafety, origin: Int, span: Span, what: String) -> MIRLintError? Never! {
    root :: safety.origin_roots[origin]
    place :: safety.origin_places[root][0]
    if safety.origin_exclusive[root] -> return mir_lint_fail(ctx, .AliasExclusive, span, "{what} is a closure that writes place {place.value}, used after another access reached that place while the closure was live")
    mir_lint_fail(ctx, .ViewValid, span, "{what} is a view into place {place.value}, used after that owner was moved, written, or resized")
}

struct MIRLintBorrowState { active: Bool, stale: Bool }

fn mir_lint_carried_origin(ctx: MIRLintContext, layout: MIRLintOwnership, state: MIRLintState, root: Int, uses: [MIRValueID], places: [MIRPlaceID]) -> MIRLintBorrowState Never! {
    active := false
    stale := false
    safety :: layout.safety
    loop value in uses {
        loop source in (safety.origins.get(value.value) ?? [Int]{}) {
            if safety.origin_roots[source] != root || !mir_lint_state_has(state, mir_lint_origin_active_bit(layout, source)) -> next
            active = true
            if mir_lint_state_has(state, layout.safety_base + source) -> stale = true
        }
    }
    loop place in places {
        local :: mir_lint_root_local(ctx, place, false)
        if local == "" -> next
        loop holder in (safety.holders.get(local) ?? [Int]{}) {
            source :: safety.holder_origins[holder]
            if safety.origin_roots[source] != root || !mir_lint_state_has(state, mir_lint_holder_bit(layout, holder)) -> next
            active = true
            if mir_lint_state_has(state, mir_lint_holder_stale_bit(layout, holder)) -> stale = true
        }
    }
    MIRLintBorrowState{active: active, stale: stale}
}

// One instruction's effect on the safety bits; with `check`, the first
// violation. Runs inside `mir_lint_transfer`, after the ownership bits.
// Rust: none (Jet-only pass)
fn mir_lint_safety_step(ctx: MIRLintContext, layout: MIRLintOwnership, instruction: MIRInstruction, state: &MIRLintState, check: Bool) -> MIRLintError? Never! {
    safety :: layout.safety
    defs :: layout.defs
    span :: instruction.span
    changed :: mir_lint_changed_places(instruction.operation)
    read :: mir_lint_read_places(instruction.operation)
    uses :: mir_operation_value_uses(instruction.operation)
    carrier_places :: mir_operation_place_uses(instruction.operation)
    if check {
        if !mir_lint_is_phi(instruction.operation) {
            loop value in uses {
                loop origin in (safety.origins.get(value.value) ?? [Int]{}) {
                    if mir_lint_state_has(state, mir_lint_origin_active_bit(layout, origin)) && mir_lint_state_has(state, layout.safety_base + origin) -> return mir_lint_stale_failure(ctx, safety, origin, span, "value {value.value}")
                }
            }
        }
        if instruction.operation == .ReadPlace(place) {
            local :: mir_lint_root_local(ctx, place, false)
            if local != "" {
                loop holder in (safety.holders.get(local) ?? [Int]{}) {
                    origin :: safety.holder_origins[holder]
                    if mir_lint_state_has(state, mir_lint_holder_bit(layout, holder)) && mir_lint_state_has(state, mir_lint_holder_stale_bit(layout, holder)) -> return mir_lint_stale_failure(ctx, safety, origin, span, "the local read through place {place.value}")
                }
            }
        }
        loop loan in 0..<safety.loan_places.len() {
            if !mir_lint_state_has(state, mir_lint_loan_bit(layout, loan)) -> next
            lent :: safety.loan_places[loan]
            loop place in changed {
                if mir_lint_places_overlap(ctx, defs, place, lent) -> return mir_lint_fail(ctx, .ViewValid, span, "place {place.value} changes while place {lent.value} is lent to a task-group child that has not joined")
            }
            if safety.loan_writes[loan] {
                loop place in read {
                    if mir_lint_places_overlap(ctx, defs, place, lent) -> return mir_lint_fail(ctx, .AliasExclusive, span, "place {place.value} is read while a task-group child that has not joined writes place {lent.value}")
                }
            }
        }
    }
    // An access that bypasses an origin makes it stale.
    own := U64?{None}
    if instruction.result == .Val(result) -> own = Val(result.value)
    loop place in changed -> mir_lint_stale_origins_for_access(ctx, layout, &state, place, true, own)
    loop place in read -> mir_lint_stale_origins_for_access(ctx, layout, &state, place, false, own)
    // Only this SSA generation starts here. Phi is assigned on its selected
    // predecessor edge, and holders retain their own older generations.
    if own == .Val(own_value) {
        if !mir_lint_is_phi(instruction.operation) {
            loop origin in (safety.origins.get(own_value) ?? [Int]{}) {
                root :: safety.origin_roots[origin]
                carried :: mir_lint_carried_origin(ctx, layout, state, root, uses, carrier_places)
                fresh :: safety.root_values[root] == own_value
                mir_lint_state_set(&state, mir_lint_origin_active_bit(layout, origin), fresh || carried.active)
                mir_lint_state_set(&state, layout.safety_base + origin, !fresh && carried.stale)
            }
        }
    }
    if instruction.operation == {
        .WritePlace(place, value) | .ReplacePlace(place, value) -> {
            local :: mir_lint_root_local(ctx, place, true)
            if local != "" {
                current :: safety.origins.get(value.value) ?? [Int]{}
                loop holder in (safety.holders.get(local) ?? [Int]{}) {
                    origin :: safety.holder_origins[holder]
                    active :: current.contains(origin) && mir_lint_state_has(state, mir_lint_origin_active_bit(layout, origin))
                    stale :: active && mir_lint_state_has(state, layout.safety_base + origin)
                    mir_lint_state_set(&state, mir_lint_holder_bit(layout, holder), active)
                    mir_lint_state_set(&state, mir_lint_holder_stale_bit(layout, holder), stale)
                }
                spawned :: safety.loans.get(value.value) ?? [Int]{}
                loop holder in (safety.task_holders.get(local) ?? [Int]{}) {
                    mir_lint_state_set(&state, mir_lint_task_holder_bit(layout, holder), spawned.contains(safety.task_holder_loans[holder]))
                }
            }
        }
        .ScopeExit(scope) -> {
            loop loan in 0..<safety.loan_places.len() {
                if safety.loan_scopes[loan] == Val(scope.value) -> mir_lint_state_set(&state, mir_lint_loan_bit(layout, loan), false)
            }
        }
        .Semantic(semantic) -> {
            if semantic == .HandleMethod(call, receiver, _, _, _) {
                if ctx.index.task_joins.get(call.value) != None {
                    mir_lint_joined_task(ctx, layout, &state, receiver)
                }
            }
        }
        else -> {}
    }
    // A task-group spawn lends its captured places.
    if own == .Val(own_value) {
        loop loan in (safety.loans.get(own_value) ?? [Int]{}) {
            if check {
                loop other in 0..<safety.loan_places.len() {
                    if !mir_lint_state_has(state, mir_lint_loan_bit(layout, other)) -> next
                    if !safety.loan_writes[loan] && !safety.loan_writes[other] -> next
                    if mir_lint_places_overlap(ctx, defs, safety.loan_places[loan], safety.loan_places[other]) -> return mir_lint_fail(ctx, .AliasExclusive, span, "place {safety.loan_places[loan].value} is lent to a task-group child while another child that has not joined holds place {safety.loan_places[other].value}, and one of them writes")
                }
            }
            mir_lint_state_set(&state, mir_lint_loan_bit(layout, loan), true)
        }
    }
    None
}

// `view.valid` at a `Return`: a returned view points only into storage the
// caller keeps, inside the declared `from` sources when there are any.
// Rust: none (Jet-only pass)
fn mir_lint_returned_view(ctx: MIRLintContext, layout: MIRLintOwnership, state: MIRLintState, block: MIRBasicBlock) -> MIRLintError? Never! {
    if block.terminator == .Return(value) {
        returned :: value ?? return None
        safety :: layout.safety
        origins := [Int]{}
        loop origin in (safety.origins.get(returned.value) ?? [Int]{}) {
            if !mir_lint_state_has(state, mir_lint_origin_active_bit(layout, origin)) -> next
            if mir_lint_state_has(state, layout.safety_base + origin) -> return mir_lint_stale_failure(ctx, safety, origin, block.span, "returned value {returned.value}")
            &origins.push(origin)
        }
        source :: mir_lint_read_from(ctx, layout.defs, returned)
        if source == .Val(place) {
            local :: mir_lint_root_local(ctx, place, true)
            loop holder in (safety.holders.get(local) ?? [Int]{}) {
                if !mir_lint_state_has(state, mir_lint_holder_bit(layout, holder)) -> next
                origin :: safety.holder_origins[holder]
                if mir_lint_state_has(state, mir_lint_holder_stale_bit(layout, holder)) -> return mir_lint_stale_failure(ctx, safety, origin, block.span, "returned local through place {place.value}")
                &origins.push(origin)
            }
        }
        loop found in origins {
            root :: safety.origin_roots[found]
            if safety.origin_exclusive[root] -> next
            loop owner in safety.origin_places[root] {
                problem :: mir_lint_view_escape(ctx, layout.defs, owner) ?? next
                return mir_lint_fail(ctx, .ViewValid, block.span, problem)
            }
        }
    }
    None
}

// Why a view into `owner` cannot be returned: the owner is a local, an owned
// parameter, or a temporary the function owns, or a parameter outside the
// declared `from` sources.
fn mir_lint_view_escape(ctx: MIRLintContext, defs: MIRLintDefs, owner: MIRPlaceID) -> String? Never! {
    row :: ctx.places.get(owner.value) ?? return None
    if ctx.function.places[row].base == {
        .Local(local) -> {
            loop candidate in ctx.function.locals {
                if candidate.id != local -> next
                if candidate.ownership.mode == .ReadBorrow || candidate.ownership.mode == .WriteBorrow || mir_lint_is_view_type(candidate.ty) -> return None
                return Val("the returned view points into local `{candidate.name}`, which this function owns")
            }
            None
        }
        .Parameter(value) -> {
            index :: mir_lint_parameter_index(ctx, defs, value)
            if index < 0 || index >= ctx.function.params.len() -> return None
            name :: ctx.function.params[index].name
            mode :: ctx.function.params[index].ownership.mode
            if mode == .Owned || mode == .Move -> return Val("the returned view points into parameter `{name}`, which this function owns")
            entries :: ctx.function.return_view_provenance ?? return None
            if entries.len() == 0 -> return None
            loop entry in entries {
                loop source in entry.provenance.sources {
                    if source.source == {
                        .Parameter(allowed) -> {
                            if allowed == index -> return None
                        }
                        .Receiver -> {
                            if name == "self" -> return None
                        }
                        else -> {}
                    }
                }
            }
            Val("the returned view points into parameter `{name}`, outside its declared `from` sources")
        }
        .Temporary(_) -> {
            loop projection in ctx.function.places[row].projections {
                if projection == .Deref(_) -> return None
            }
            Val("the returned view points into a temporary that is dropped when this function returns")
        }
        else -> None
    }
}
