// Effect-preserving scalar simplification, constant folding, and CFG transforms.
use jet_foundation.[
    MIRBasicBlock,
    MIRBlockID,
    MIRBinaryOp,
    MIRConstant,
    MIRFunction,
    MIRIntegerWidth,
    MIROperation,
    MIRPhiIncoming,
    MIRProgram,
    MIRTerminator,
    MIRType,
    MIRUnaryOp,
    MIRValueFact,
    MIRValueID,
    mir_operation_value_uses,
    mir_terminator_targets,
    mir_terminator_value_uses,
]

fn mir_pass_eliminate_unreachable(program: &MIRProgram) Never! {
    loop function_index in 0..<program.functions.len() {
        function_window := &program.functions[function_index]
        mir_pass_eliminate_unreachable_function(&function_window)
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs::eliminate_unreachable_blocks
fn mir_pass_eliminate_unreachable_function(function: &MIRFunction) Never! {
    reachable :: mir_pass_reachable(function)
    reachable_rows := [U64:Bool]{}
    loop id in reachable -> &reachable_rows.add(id.value, true).drop("a block id may repeat")
    kept_blocks := [MIRBasicBlock]{}
    loop block in function.blocks {
        if reachable_rows.get(block.id.value) != None -> &kept_blocks.push(block)
    }
    function.blocks = kept_blocks
    // Live values and predecessors are keyed once per function instead of
    // rescanned per value and per block.
    live_values := [U64:Bool]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) -> &live_values.add(result.value, true).drop("a value id may repeat")
        }
    }
    place_rows :: mir_pass_place_rows(function)
    loop place in function.places {
        loop value in mir_pass_place_value_uses(function.places, place_rows, place.id) -> &live_values.add(value.value, true).drop("a value id may repeat")
    }
    loop scope in function.scopes {
        value :: scope.deadline ?? next
        &live_values.add(value.value, true).drop("a value id may repeat")
    }
    kept_values := [MIRValueFact]{}
    loop value in function.values {
        if live_values.get(value.id.value) != None -> &kept_values.push(value)
    }
    function.values = kept_values
    // Only phi operands change below, so the predecessor map stays exact.
    predecessors :: mir_pass_predecessor_map(function)
    block_index := 0
    loop block_index < function.blocks.len() {
        expected :: predecessors.get(function.blocks[block_index].id.value) ?? [MIRBlockID]{}
        expected_rows := [U64:Bool]{}
        loop predecessor in expected -> &expected_rows.add(predecessor.value, true).drop("a predecessor may repeat")
        instructions := function.blocks[block_index].instructions
        instruction_index := 0
        loop instruction_index < instructions.len() {
            instruction := instructions[instruction_index]
            if instruction.operation == {
                .Phi(incoming) -> {
                    filtered :: loop row in incoming if expected_rows.get(row.block.value) != None -> row
                    instructions[instruction_index].operation = MIROperation.Phi{incoming: filtered}
                }
                else -> {}
            }
            instruction_index += 1
        }
        function.blocks[block_index].instructions = instructions
        block_index += 1
    }
}

fn mir_pass_simplify_cfg(program: &MIRProgram) Never! {
    loop function_index in 0..<program.functions.len() {
        function_window := &program.functions[function_index]
        mir_pass_simplify_cfg_function(&function_window)
    }
    mir_pass_eliminate_unreachable(&program)
}

fn mir_pass_simplify_cfg_function(function: &MIRFunction) Never! {
    constants :: mir_pass_collect_scalar_constants(function)
    loop block_index in 0..<function.blocks.len() {
        replacement :: mir_pass_simplified_terminator(function.blocks[block_index].terminator, constants)
        if replacement == .Val(terminator) -> function.blocks[block_index].terminator = terminator
    }
    mir_pass_forward_phi_joins(&function)
}

fn mir_pass_count_use(uses: &[String:Int], value: MIRValueID) Never! {
    key :: "{value.value}"
    &uses.add(key, (uses.get(key) ?? 0) + 1).drop("the count replaces the prior count")
}

// MIROptimization forward_phi_joins: a block that holds only a phi, is
// entered only by plain jumps, and jumps to a block whose phi is the single
// use of its value (the join of an inner arm of an if-expression or match
// chain) is bypassed: its predecessors jump to the outer join and feed that
// phi directly, so an N-arm chain merges once instead of through N nested
// joins. Nothing executes in a bypassed block (a function with `Normal` drop
// actions runs them on every jump, so it is left alone), and
// mir_pass_eliminate_unreachable removes the bypassed blocks and their phi
// values. Linear in the function.
// Rust: crates/jet-foundation/src/MIROptimization.rs::forward_phi_joins
fn mir_pass_forward_phi_joins(function: &MIRFunction) Never! {
    drop_targets := [String:Bool]{}
    loop action in function.drops {
        if action.edge == {
            .Normal -> return
            .Return -> {}
            .Failure(target) | .Unwind(target) -> &drop_targets.add("{target.value}", true).drop("a target may repeat")
        }
    }
    uses := [String:Int]{}
    place_rows :: mir_pass_place_rows(function)
    loop place in function.places {
        loop used in mir_pass_place_value_uses(function.places, place_rows, place.id) -> mir_pass_count_use(&uses, used)
    }
    loop scope in function.scopes {
        if scope.deadline == .Val(deadline) -> mir_pass_count_use(&uses, deadline)
    }
    positions := [String:Int]{}
    edges := [String:Int]{}
    // Scalar linked rows avoid copying a growing bucket for each source.
    phi_heads := [U64:Int]{}
    phi_next := [Int]{}
    phi_blocks := [Int]{}
    phi_instructions := [Int]{}
    phi_values := [MIRValueID]{}
    loop (position, block) in function.blocks {
        &positions.add("{block.id.value}", position).drop("block ids are unique")
        loop (instruction_index, instruction) in block.instructions {
            if instruction.operation == {
                .Phi(incoming) -> {
                    loop row in incoming {
                        &phi_next.push(phi_heads.get(row.block.value) ?? -1)
                        &phi_blocks.push(position)
                        &phi_instructions.push(instruction_index)
                        &phi_values.push(row.value)
                        &phi_heads.add(row.block.value, phi_next.len() - 1).drop("the new row replaces the head")
                    }
                }
                else -> {}
            }
            loop used in mir_operation_value_uses(instruction.operation) -> mir_pass_count_use(&uses, used)
            loop place in mir_pass_operation_place_refs(instruction.operation) {
                loop used in mir_pass_place_value_uses(function.places, place_rows, place) -> mir_pass_count_use(&uses, used)
            }
        }
        loop used in mir_terminator_value_uses(block.terminator) -> mir_pass_count_use(&uses, used)
        loop target in mir_terminator_targets(block.terminator) {
            key :: "{target.value}"
            &edges.add(key, (edges.get(key) ?? 0) + 1).drop("the count replaces the prior count")
        }
    }
    // Bypassed block -> its phi value and the block it jumps to.
    forward_values := [String:MIRValueID]{}
    forward_targets := [String:MIRBlockID]{}
    loop block in function.blocks {
        key :: "{block.id.value}"
        if block.id == function.entry || drop_targets.get(key) != None || block.instructions.len() != 1 -> next
        instruction :: block.instructions[0]
        value :: instruction.result ?? next
        incoming :: mir_pass_phi_rows(instruction.operation) ?? next
        target :: mir_pass_jump_target(block.terminator) ?? next
        if target == block.id || (uses.get("{value.value}") ?? 0) != 1 -> next
        target_position :: positions.get("{target.value}") ?? next
        mentions := 0
        feeds := 0
        row_position := phi_heads.get(block.id.value) ?? -1
        named_instruction := -1
        fed_instruction := -1
        loop row_position >= 0 {
            if phi_blocks[row_position] == target_position {
                outer_index :: phi_instructions[row_position]
                // Rows for each outer instruction are contiguous in this
                // source chain, including duplicate incoming source blocks.
                if named_instruction != outer_index {
                    mentions += 1
                    named_instruction = outer_index
                }
                if phi_values[row_position] == value && fed_instruction != outer_index {
                    if function.blocks[target_position].instructions[outer_index].ty == instruction.ty {
                        feeds += 1
                        fed_instruction = outer_index
                    }
                }
            }
            row_position = phi_next[row_position]
        }
        if mentions != 1 || feeds != 1 -> next
        // Every predecessor reaches the block through its own plain jump, once,
        // and the phi names each predecessor once.
        if incoming.len() == 0 || (edges.get(key) ?? 0) != incoming.len() -> next
        entering := [String:Bool]{}
        plain := true
        loop row in incoming {
            source_key :: "{row.block.value}"
            source :: positions.get(source_key) ?? -1
            if source < 0 || entering.get(source_key) != None {
                plain = false
                break
            }
            &entering.add(source_key, true).drop("checked absent above")
            if mir_pass_jump_target(function.blocks[source].terminator) != Val(block.id) -> plain = false
        }
        if !plain -> next
        &forward_values.add(key, value).drop("block ids are unique")
        &forward_targets.add(key, target).drop("block ids are unique")
    }
    if forward_values.len() == 0 -> return
    // The outermost join each bypassed block reaches, each chain walked once.
    // A jump cycle of phi-only blocks leaves the function alone.
    finals := [String:MIRBlockID]{}
    loop block in function.blocks {
        start_key :: "{block.id.value}"
        if forward_targets.get(start_key) == None -> next
        path := [String]{}
        on_path := [String:Bool]{}
        at := block.id
        end := block.id
        loop {
            at_key :: "{at.value}"
            if finals.get(at_key) != None {
                end = finals.get(at_key) ?? at
                break
            }
            if forward_targets.get(at_key) == None {
                end = at
                break
            }
            if on_path.get(at_key) != None -> return
            &on_path.add(at_key, true).drop("checked absent above")
            &path.push(at_key)
            at = forward_targets.get(at_key) ?? at
        }
        loop step in path -> &finals.add(step, end).drop("each block is resolved once")
    }
    inner := [String:[MIRPhiIncoming]]{}
    loop block_index in 0..<function.blocks.len() {
        key :: "{function.blocks[block_index].id.value}"
        if forward_values.get(key) != None {
            rows :: mir_pass_phi_rows(function.blocks[block_index].instructions[0].operation) ?? next
            &inner.add(key, rows).drop("block ids are unique")
            next
        }
        jump :: mir_pass_jump_target(function.blocks[block_index].terminator) ?? next
        end :: finals.get("{jump.value}") ?? next
        function.blocks[block_index].terminator = MIRTerminator.Jump{target: end}
    }
    loop block_index in 0..<function.blocks.len() {
        if forward_values.get("{function.blocks[block_index].id.value}") != None -> next
        loop instruction_index in 0..<function.blocks[block_index].instructions.len() {
            incoming :: mir_pass_phi_rows(function.blocks[block_index].instructions[instruction_index].operation) ?? next
            bypassed := false
            loop row in incoming {
                phi :: forward_values.get("{row.block.value}") ?? next
                if phi == row.value -> bypassed = true
            }
            if !bypassed -> next
            expanded := [MIRPhiIncoming]{}
            lists := [[MIRPhiIncoming]]{incoming}
            cursors := [Int]{0}
            loop lists.len() > 0 {
                top :: lists.len() - 1
                if cursors[top] >= lists[top].len() {
                    _ := &lists.pop()
                    _ := &cursors.pop()
                    next
                }
                row_block :: lists[top][cursors[top]].block
                row_value :: lists[top][cursors[top]].value
                cursors[top] = cursors[top] + 1
                row_key :: "{row_block.value}"
                bypassed_row := false
                if forward_values.get(row_key) == .Val(row_phi) -> bypassed_row = row_phi == row_value
                if bypassed_row && inner.get(row_key) != None {
                    &lists.push(inner.get(row_key) ?? [MIRPhiIncoming]{})
                    &cursors.push(0)
                    next
                }
                &expanded.push(MIRPhiIncoming{block: row_block, value: row_value})
            }
            function.blocks[block_index].instructions[instruction_index].operation = MIROperation.Phi{incoming: expanded}
        }
    }
}

fn mir_pass_phi_rows(operation: MIROperation) -> [MIRPhiIncoming]? Never! {
    if operation == {
        .Phi(rows) -> Val(rows)
        else -> None
    }
}

fn mir_pass_jump_target(terminator: MIRTerminator) -> MIRBlockID? Never! {
    if terminator == {
        .Jump(target) -> Val(target)
        else -> None
    }
}

fn mir_pass_simplified_terminator(terminator: MIRTerminator, constants: [U64:MIRConstant]) -> MIRTerminator? {
    if terminator == {
        .Branch(condition, then_target, else_target) -> {
            if then_target == else_target -> return Val(MIRTerminator.Jump{target: then_target})
            constant :: mir_pass_constant_for(constants, condition) ?? return None
            if constant == {
                .Bool(flag) -> if flag -> Val(MIRTerminator.Jump{target: then_target}) else -> Val(MIRTerminator.Jump{target: else_target})
                else -> None
            }
        }
        else -> None
    }
}

fn mir_pass_fold_exact_constants(program: &MIRProgram) -> Int Never! {
    folded := 0
    loop function_index in 0..<program.functions.len() {
        function_window := &program.functions[function_index]
        folded += mir_pass_fold_function_constants(&function_window)
    }
    mir_pass_simplify_cfg(&program)
    folded
}

// Rust: crates/jet-foundation/src/MIROptimization.rs::fold_exact_constants
fn mir_pass_fold_function_constants(function: &MIRFunction) -> Int Never! {
    constants := mir_pass_collect_scalar_constants(function)
    blocks := [Int]{}
    instructions := [Int]{}
    pending := [Int]{}
    dependent_heads := [U64:Int]{}
    dependent_next := [Int]{}
    dependent_instructions := [Int]{}
    ready := [Int]{}
    // Each unknown operand contributes one pending edge. Even a wide phi
    // is attempted only once, after all of its operands become constant.
    loop block_index in 0..<function.blocks.len() {
        loop instruction_index in 0..<function.blocks[block_index].instructions.len() {
            operation :: function.blocks[block_index].instructions[instruction_index].operation
            foldable :: if operation == {
                .Phi(_) | .Unary(_, _) -> true
                .Binary(_, dispatch, _, _, _) -> dispatch == .Primitive
                else -> false
            }
            if !foldable -> next
            position :: blocks.len()
            &blocks.push(block_index)
            &instructions.push(instruction_index)
            missing := 0
            loop operand in mir_operation_value_uses(operation) {
                if constants.get(operand.value) != None -> next
                missing += 1
                &dependent_next.push(dependent_heads.get(operand.value) ?? -1)
                &dependent_instructions.push(position)
                &dependent_heads.add(operand.value, dependent_next.len() - 1).drop("the new edge replaces the head")
            }
            &pending.push(missing)
            if missing == 0 -> &ready.push(position)
        }
    }
    folded := 0
    cursor := 0
    loop cursor < ready.len() {
        position :: ready[cursor]
        cursor += 1
        block_index :: blocks[position]
        instruction_index :: instructions[position]
        instruction := function.blocks[block_index].instructions[instruction_index]
        constant :: mir_pass_fold_operation(instruction.operation, constants, instruction.ty) ?? next
        function.blocks[block_index].instructions[instruction_index].operation = MIROperation.Constant{value: constant}
        folded += 1
        result :: instruction.result ?? next
        scalar :: mir_pass_scalar_constant(constant) ?? next
        mir_pass_constant_put(&constants, result, scalar)
        edge := dependent_heads.get(result.value) ?? -1
        loop edge >= 0 {
            dependent :: dependent_instructions[edge]
            pending[dependent] = pending[dependent] - 1
            if pending[dependent] == 0 -> &ready.push(dependent)
            edge = dependent_next[edge]
        }
    }
    folded
}

fn mir_pass_fold_operation(operation: MIROperation, constants: [U64:MIRConstant], ty: MIRType?) -> MIRConstant? {
    if operation == {
        .Phi(incoming) -> mir_pass_fold_phi(incoming, constants)
        .Unary(op, value) -> {
            value_constant :: mir_pass_constant_for(constants, value) ?? return None
            target :: ty ?? return None
            mir_pass_fold_unary(op, value_constant, target)
        }
        .Binary(op, dispatch, _, left, right) -> {
            if dispatch != .Primitive -> return None
            left_constant :: mir_pass_constant_for(constants, left) ?? return None
            right_constant :: mir_pass_constant_for(constants, right) ?? return None
            target :: ty ?? return None
            mir_pass_fold_binary(op, left_constant, right_constant, target)
        }
        else -> None
    }
}

fn mir_pass_collect_scalar_constants(function: MIRFunction) -> [U64:MIRConstant] Never! {
    constants := [U64:MIRConstant]{}
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == .Val(result) {
                if instruction.operation == {
                    .Constant(constant) -> {
                        scalar :: mir_pass_scalar_constant(constant)
                        if scalar == .Val(value) -> mir_pass_constant_put(&constants, result, value)
                    }
                    .Phi(incoming) -> {
                        folded :: mir_pass_fold_phi(incoming, constants)
                        if folded == .Val(value) -> mir_pass_constant_put(&constants, result, value)
                    }
                    else -> {}
                }
            }
        }
    }
    constants
}

fn mir_pass_constant_for(constants: [U64:MIRConstant], value: MIRValueID) -> MIRConstant? {
    constants.get(value.value)
}

fn mir_pass_constant_put(constants: &[U64:MIRConstant], value: MIRValueID, constant: MIRConstant) Never! {
    &constants.add(value.value, constant).drop("a later fact for the value replaces the prior one")
}

fn mir_pass_scalar_constant(constant: MIRConstant) -> MIRConstant? {
    if constant == {
        .Int(value, width, _) -> Val(MIRConstant.Int{value: value, width: width, spelling: None})
        .Bool(value) -> Val(MIRConstant.Bool{value: value})
        .Char(value) -> Val(MIRConstant.Char{value: value})
        else -> None
    }
}

fn mir_pass_same_scalar(left: MIRConstant, right: MIRConstant) -> Bool Never! {
    if left == {
        .Int(left_value, left_width, _) -> {
            if right == {
                .Int(right_value, right_width, _) -> left_value == right_value && left_width == right_width
                else -> false
            }
        }
        .Bool(left_value) -> {
            if right == {
                .Bool(right_value) -> left_value == right_value
                else -> false
            }
        }
        .Char(left_value) -> {
            if right == {
                .Char(right_value) -> left_value == right_value
                else -> false
            }
        }
        else -> false
    }
}

fn mir_pass_fold_phi(incoming: [MIRPhiIncoming], constants: [U64:MIRConstant]) -> MIRConstant? {
    if incoming.len() == 0 -> return None
    first :: mir_pass_constant_for(constants, incoming[0].value) ?? return None
    loop index in 1..<incoming.len() {
        candidate :: mir_pass_constant_for(constants, incoming[index].value) ?? return None
        if !mir_pass_same_scalar(first, candidate) -> return None
    }
    Val(first)
}

fn mir_pass_fold_unary(op: MIRUnaryOp, value: MIRConstant, ty: MIRType) -> MIRConstant? {
    if op == {
        .Not -> {
            if value == {
                .Bool(flag) -> Val(MIRConstant.Bool{value: !flag})
                else -> None
            }
        }
        .Neg -> {
            if value == {
                .Int(number, width, _) -> {
                    result :: mir_pass_checked_sub(0, number) ?? return None
                    output_width :: mir_pass_integer_width(ty, width)
                    if mir_pass_fits_integer(result, output_width) -> Val(MIRConstant.Int{value: result, width: output_width, spelling: None}) else -> None
                }
                else -> None
            }
        }
        else -> None
    }
}

fn mir_pass_fold_binary(op: MIRBinaryOp, left: MIRConstant, right: MIRConstant, ty: MIRType) -> MIRConstant? {
    if left == {
        .Bool(left_value) -> {
            if right == {
                .Bool(right_value) -> {
                    if op == {
                        .And -> Val(MIRConstant.Bool{value: left_value && right_value})
                        .Or -> Val(MIRConstant.Bool{value: left_value || right_value})
                        .Eq -> Val(MIRConstant.Bool{value: left_value == right_value})
                        .Ne -> Val(MIRConstant.Bool{value: left_value != right_value})
                        else -> None
                    }
                }
                else -> None
            }
        }
        .Char(left_value) -> {
            if right == {
                .Char(right_value) -> {
                    if op == {
                        .Eq -> Val(MIRConstant.Bool{value: left_value == right_value})
                        .Ne -> Val(MIRConstant.Bool{value: left_value != right_value})
                        .Lt -> Val(MIRConstant.Bool{value: left_value < right_value})
                        .Gt -> Val(MIRConstant.Bool{value: left_value > right_value})
                        .Le -> Val(MIRConstant.Bool{value: left_value <= right_value})
                        .Ge -> Val(MIRConstant.Bool{value: left_value >= right_value})
                        else -> None
                    }
                }
                else -> None
            }
        }
        .Int(left_value, left_width, _) -> {
            if right == {
                .Int(right_value, _, _) -> {
                    if op == {
                        .Eq -> Val(MIRConstant.Bool{value: left_value == right_value})
                        .Ne -> Val(MIRConstant.Bool{value: left_value != right_value})
                        .Lt -> Val(MIRConstant.Bool{value: left_value < right_value})
                        .Gt -> Val(MIRConstant.Bool{value: left_value > right_value})
                        .Le -> Val(MIRConstant.Bool{value: left_value <= right_value})
                        .Ge -> Val(MIRConstant.Bool{value: left_value >= right_value})
                        else -> {
                            result :: mir_pass_integer_result(op, left_value, right_value) ?? return None
                            width :: mir_pass_integer_width(ty, left_width)
                            if mir_pass_fits_integer(result, width) -> Val(MIRConstant.Int{value: result, width: width, spelling: None}) else -> None
                        }
                    }
                }
                else -> None
            }
        }
        else -> None
    }
}

fn mir_pass_integer_result(op: MIRBinaryOp, left: Int, right: Int) -> Int? {
    if op == {
        .Add -> mir_pass_checked_add(left, right)
        .Sub -> mir_pass_checked_sub(left, right)
        .Mul -> mir_pass_checked_mul(left, right)
        .Div -> {
            if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
            return Val(mir_pass_trunc_div(left, right))
        }
        .FloorDiv -> mir_pass_floor_div(left, right)
        .Mod -> mir_pass_floor_mod(left, right)
        .Rem -> if right == 0 -> None else -> Val(left %% right)
        .BitAnd -> Val(left & right)
        .BitOr -> Val(left | right)
        .BitXor -> Val(left ~| right)
        .Shl -> if right < 0 || right >= 63 -> None else -> mir_pass_checked_mul(left, 1 << right)
        .Shr -> {
            if right < 0 || right >= 63 -> return None
            return Val(left /% (1 << right))
        }
        .Pow -> {
            if right < 0 || right > 63 -> return None
            result := 1
            exponent := right
            base := left
            loop exponent > 0 {
                if exponent % 2 == 1 -> result = mir_pass_checked_mul(result, base) ?? return None
                exponent = exponent /% 2
                if exponent > 0 -> base = mir_pass_checked_mul(base, base) ?? return None
            }
            Val(result)
        }
        else -> None
    }
}

fn mir_pass_int_min() -> Int Never! { 0 - 9223372036854775807 - 1 }

// Rust's truncating `i64 /`: Jet `/` on whole numbers is exact, `/%` floors,
// and `%%` keeps the dividend's sign, so removing the remainder first makes
// the floor division exact. Callers exclude a zero divisor and MIN / -1.
fn mir_pass_trunc_div(left: Int, right: Int) -> Int Never! { (left - left %% right) /% right }

fn mir_pass_checked_add(left: Int, right: Int) -> Int? {
    if {
        right > 0 && left > 9223372036854775807 - right -> None
        right < 0 && left < mir_pass_int_min() - right -> None
        else -> Val(left + right)
    }
}

fn mir_pass_checked_sub(left: Int, right: Int) -> Int? {
    if {
        right > 0 && left < mir_pass_int_min() + right -> None
        right < 0 && left > 9223372036854775807 + right -> None
        else -> Val(left - right)
    }
}

fn mir_pass_checked_mul(left: Int, right: Int) -> Int? {
    if left == 0 || right == 0 -> return Val(0)
    if left == -1 && right == mir_pass_int_min() -> return None
    if right == -1 && left == mir_pass_int_min() -> return None
    if {
        left > 0 -> {
            if right > 0 && left > mir_pass_trunc_div(9223372036854775807, right) -> return None
            if right < 0 && right < mir_pass_trunc_div(mir_pass_int_min(), left) -> return None
        }
        else -> {
            if right > 0 && left < mir_pass_trunc_div(mir_pass_int_min(), right) -> return None
            if right < 0 && left < mir_pass_trunc_div(9223372036854775807, right) -> return None
        }
    }
    Val(left * right)
}

fn mir_pass_floor_div(left: Int, right: Int) -> Int? {
    if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
    Val(left /% right)
}

fn mir_pass_floor_mod(left: Int, right: Int) -> Int? {
    if right == 0 || (left == mir_pass_int_min() && right == -1) -> return None
    Val(left % right)
}

fn mir_pass_integer_width(ty: MIRType, fallback: MIRIntegerWidth?) -> MIRIntegerWidth? {
    if ty.kind == {
        .IntN(signed, bits) -> if bits > 0 && bits <= 64 -> Val(MIRIntegerWidth{signed: signed, bits: bits}) else -> None
        .InlineRange(base, _, _) -> mir_pass_integer_width(base, fallback)
        .Tagged(_, inner) -> mir_pass_integer_width(inner, fallback)
        .Quantity(base, _) -> mir_pass_integer_width(base, fallback)
        else -> fallback
    }
}

fn mir_pass_fits_integer(value: Int, width: MIRIntegerWidth?) -> Bool Never! {
    row :: width ?? return true
    bits :: row.bits
    if {
        bits <= 0 || bits > 64 -> false
        bits == 64 -> row.signed || value >= 0
        row.signed -> {
            limit :: 1 << (bits - 1)
            value >= 0 - limit && value <= limit - 1
        }
        else -> {
            unsigned_limit :: 1 << bits
            value >= 0 && value <= unsigned_limit - 1
        }
    }
}

