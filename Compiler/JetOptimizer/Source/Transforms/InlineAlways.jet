// Checked #Inline(Always) MIR CFG expansion with stable, collision-free IDs.
use jet_foundation.[
    MIRBasicBlock,
    MIRBlockID,
    MIRCallArg,
    MIRCallee,
    MIRFunction,
    MIRFunctionID,
    MIRInstruction,
    MIROpID,
    MIROperation,
    MIRPlace,
    MIRPlaceID,
    MIRProgram,
    MIRTerminator,
    MIRType,
    MIRValueID,
    Span,
]

struct MIRInlineExpansionResult { pub expanded: Int, pub blocks_removed: Int, pub error: MIROptimizationError? }

struct MIRInlineOneCallResult { pub blocks_removed: Int, pub error: MIROptimizationError? }

struct MIRInlineCallSite {
    pub caller: MIRFunctionID
    pub block: MIRBlockID
    pub instruction: MIROpID
    pub callee: MIRFunctionID
    pub args: [MIRCallArg]
    pub type_args: [MIRType]
}

struct MIRInlineCallPosition { pub block: Int, pub instruction: Int }

// Function rows never move during expansion. Candidate positions are rebuilt
// only for changed bodies, keeping discovery in function/block/instruction order.
struct MIRInlineIndex {
    pub functions: [U64:Int]
    pub eligible: [U64:Bool]
}

fn mir_pass_expand_inline_always(program: &MIRProgram) -> MIRInlineExpansionResult Never! {
    functions := [U64:Int]{}
    eligible := [U64:Bool]{}
    loop (index, function) in program.functions {
        if functions.get(function.id.value) == None {
            &functions.add(function.id.value, index).drop("the first function row owns this id")
            if function.is_inline_always || function.optimization.inline_always -> &eligible.add(function.id.value, true).drop("function ids are unique")
        }
    }
    if eligible.len() == 0 -> return MIRInlineExpansionResult{expanded: 0, blocks_removed: 0, error: None}
    index :: MIRInlineIndex{functions: functions, eligible: eligible}
    pending := [[MIRInlineCallPosition]]{}
    loop function in program.functions -> &pending.push(mir_pass_inline_candidates(function, index))
    // Only callers with an initial candidate can gain cloned candidates.
    callers := [Int]{}
    loop (row, candidates) in pending {
        if candidates.len() != 0 -> &callers.push(row)
    }
    expanded := 0
    blocks_removed := 0
    loop {
        // Recheck blocked candidates after CFG changes, never ordinary calls.
        site :: mir_pass_inline_next_call(program, index, pending, callers) ?? break
        caller_index :: index.functions.get(site.caller.value) ?? -1
        caller_option :: mir_pass_inline_find_function(program.functions, index, site.caller)
        callee_option :: mir_pass_inline_find_function(program.functions, index, site.callee)
        if caller_index < 0 || caller_option == None || callee_option == None -> return MIRInlineExpansionResult{expanded: expanded, blocks_removed: blocks_removed, error: Val(mir_pass_error(.LegalityVerification, .InvalidSchema, Val(site.caller), Span{start: 0, end: 0}, "#Inline(Always) call target is missing from MIR"))}
        caller :: caller_option ?? return MIRInlineExpansionResult{expanded: expanded, blocks_removed: blocks_removed, error: Val(mir_pass_error(.LegalityVerification, .InvalidSchema, Val(site.caller), Span{start: 0, end: 0}, "#Inline(Always) caller is missing from MIR"))}
        callee :: callee_option ?? return MIRInlineExpansionResult{expanded: expanded, blocks_removed: blocks_removed, error: Val(mir_pass_error(.LegalityVerification, .InvalidSchema, Val(site.caller), caller.span, "#Inline(Always) callee is missing from MIR"))}
        result :: mir_pass_inline_one_call(&program, caller_index, site, caller, callee)
        if result.error != None -> return MIRInlineExpansionResult{expanded: expanded, blocks_removed: blocks_removed + result.blocks_removed, error: result.error}
        expanded += 1
        blocks_removed += result.blocks_removed
        if result.blocks_removed > 0 {
            // Non-returning expansion can prune blocks in any function.
            loop (row, function) in program.functions -> pending[row] = mir_pass_inline_candidates(function, index)
        } else {
            pending[caller_index] = mir_pass_inline_candidates(program.functions[caller_index], index)
        }
    }
    MIRInlineExpansionResult{expanded: expanded, blocks_removed: blocks_removed, error: None}
}

fn mir_pass_inline_candidates(caller: MIRFunction, index: MIRInlineIndex) -> [MIRInlineCallPosition] Never! {
    pending := [MIRInlineCallPosition]{}
    loop (block_index, block) in caller.blocks {
        loop (instruction_index, instruction) in block.instructions {
            if instruction.operation == {
                .Call(callee, _, _) -> {
                    id :: mir_pass_inline_callee_id(callee) ?? next
                    if index.eligible.get(id.value) != None -> &pending.push(MIRInlineCallPosition{block: block_index, instruction: instruction_index})
                }
                else -> {}
            }
        }
    }
    pending
}

fn mir_pass_inline_next_call(program: MIRProgram, index: MIRInlineIndex, pending: [[MIRInlineCallPosition]], callers: [Int]) -> MIRInlineCallSite? {
    loop caller_index in callers {
        candidates :: pending[caller_index]
        if candidates.len() == 0 -> next
        caller :: program.functions[caller_index]
        loop position in candidates {
            block :: caller.blocks[position.block]
            instruction :: block.instructions[position.instruction]
            if instruction.operation == {
                .Call(callee, args, type_args) -> {
                    callee_id :: mir_pass_inline_callee_id(callee) ?? next
                    function :: mir_pass_inline_find_function(program.functions, index, callee_id) ?? next
                    if caller.id != callee_id
                        && !mir_pass_inline_reaches_caller(program, index, function.id, caller.id)
                        && !mir_pass_inline_callee_is_recursive(program, index, function)
                        && function.capture_params.len() == 0
                        && !(caller.generator == None && function.generator != None)
                        && mir_pass_inline_call_site_can_expand(caller, function, instruction, args, type_args) {
                        return Val(MIRInlineCallSite{caller: caller.id, block: block.id, instruction: instruction.id, callee: callee_id, args: args, type_args: type_args})
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn mir_pass_inline_callee_id(callee: MIRCallee) -> MIRFunctionID? {
    if callee == {
        .User(id) | .Associated(id, _) | .Method(id, _) -> Val(id)
        else -> None
    }
}

fn mir_pass_inline_find_function(rows: [MIRFunction], index: MIRInlineIndex, id: MIRFunctionID) -> MIRFunction? {
    position :: index.functions.get(id.value) ?? return None
    Val(rows[position])
}

fn mir_pass_inline_reaches_caller(program: MIRProgram, index: MIRInlineIndex, start: MIRFunctionID, caller: MIRFunctionID) -> Bool Never! {
    if start == caller -> return true
    pending := [MIRFunctionID]{start}
    visited := [U64:Bool]{}
    cursor := 0
    loop cursor < pending.len() {
        current := pending[cursor]
        cursor += 1
        if visited.get(current.value) != None -> next
        &visited.add(current.value, true).drop("checked absent above")
        function :: mir_pass_inline_find_function(program.functions, index, current) ?? next
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Call(callee, _, _) -> {
                        target :: mir_pass_inline_callee_id(callee) ?? next
                        if index.eligible.get(target.value) != None {
                            if target == caller -> return true
                            if visited.get(target.value) == None -> &pending.push(target)
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    false
}

fn mir_pass_inline_callee_is_recursive(program: MIRProgram, index: MIRInlineIndex, callee: MIRFunction) -> Bool Never! {
    loop block in callee.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .Call(target, _, _) -> {
                    target_id :: mir_pass_inline_callee_id(target) ?? next
                    if index.eligible.get(target_id.value) == None -> next
                    if mir_pass_inline_reaches_caller(program, index, target_id, callee.id) -> return true
                }
                else -> {}
            }
        }
    }
    false
}

fn mir_pass_inline_one_call(
    program: &MIRProgram,
    caller_index: Int,
    site: MIRInlineCallSite,
    caller: MIRFunction,
    callee: MIRFunction,
) -> MIRInlineOneCallResult Never! {
    block_index :: mir_pass_inline_block_index(caller.blocks, site.block)
    if block_index < 0 -> return MIRInlineOneCallResult{blocks_removed: 0, error: Val(mir_pass_error(.LegalityVerification, .InvalidCFG, Val(caller.id), caller.span, "#Inline(Always) call block is missing"))}
    instruction_index :: mir_pass_inline_instruction_index(caller.blocks[block_index].instructions, site.instruction)
    if instruction_index < 0 -> return MIRInlineOneCallResult{blocks_removed: 0, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), caller.blocks[block_index].span, "#Inline(Always) call instruction is missing"))}
    call_instruction := caller.blocks[block_index].instructions[instruction_index]
    plan_result :: mir_pass_inline_plan(caller, callee, call_instruction, site.args, site.type_args)
    if plan_result.error != None -> return MIRInlineOneCallResult{blocks_removed: 0, error: plan_result.error}
    plan :: plan_result.plan ?? return MIRInlineOneCallResult{blocks_removed: 0, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), call_instruction.span, "#Inline(Always) body contains an operation that cannot be remapped safely"))}

    original := program.functions[caller_index].blocks[block_index]
    prefix := original.instructions[0..<instruction_index]
    loop adapter in plan.adapter_instructions -> &prefix.push(adapter)
    suffix :: if plan.returns -> original.instructions[instruction_index + 1..<original.instructions.len()] else -> [MIRInstruction]{}
    continuation_instructions := [MIRInstruction]{}
    if plan.returns {
        if call_instruction.result != None {
            if plan.return_incoming.len() == 0 -> return MIRInlineOneCallResult{blocks_removed: 0, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), call_instruction.span, "#Inline(Always) return value has no returning predecessor"))}
            &continuation_instructions.push(MIRInstruction{
                id: call_instruction.id,
                span: call_instruction.span,
                source_line: call_instruction.source_line,
                result: call_instruction.result,
                ty: call_instruction.ty,
                operation: MIROperation.Phi{incoming: plan.return_incoming},
            })
        }
        loop instruction in suffix -> &continuation_instructions.push(instruction)
    }
    continuation_terminator :: if plan.returns -> original.terminator else -> MIRTerminator.Unreachable{reason: "inlined callee does not return"}
    program.functions[caller_index].blocks[block_index] = MIRBasicBlock{id: original.id, span: original.span, instructions: prefix, terminator: MIRTerminator.Jump{target: plan.entry}}
    &program.functions[caller_index].blocks.push(MIRBasicBlock{id: plan.continuation, span: original.span, instructions: continuation_instructions, terminator: continuation_terminator})
    loop block in plan.blocks -> &program.functions[caller_index].blocks.push(block)
    loop row in plan.locals -> &program.functions[caller_index].locals.push(row)
    loop row in plan.values -> &program.functions[caller_index].values.push(row)
    loop row in plan.places -> &program.functions[caller_index].places.push(row)
    loop row in plan.scopes -> &program.functions[caller_index].scopes.push(row)
    loop row in plan.drops -> &program.functions[caller_index].drops.push(row)
    blocks_removed :: if {
        plan.returns -> 0
        else -> {
            before_blocks :: mir_pass_block_count(&program)
            mir_pass_eliminate_unreachable(&program)
            removed :: before_blocks - mir_pass_block_count(&program)
            caller_window := &program.functions[caller_index]
            mir_pass_inline_prune_dead_places(&caller_window)
            mir_pass_inline_clear_dead_scope_deadlines(&caller_window)
            mir_pass_eliminate_unreachable(&program)
            removed
        }
    }
    MIRInlineOneCallResult{blocks_removed: blocks_removed, error: None}
}

fn mir_pass_inline_prune_dead_places(function: &MIRFunction) Never! {
    reachable :: mir_pass_reachable(function)
    used_places := [MIRPlaceID]{}
    loop block in function.blocks {
        if !mir_pass_block_id_seen(reachable, block.id) -> next
        loop instruction in block.instructions {
            loop place in mir_pass_operation_place_refs(instruction.operation) {
                if !mir_pass_place_id_seen(used_places, place) -> &used_places.push(place)
            }
        }
    }
    loop local in function.locals {
        if !mir_pass_place_id_seen(used_places, local.place) -> &used_places.push(local.place)
    }
    loop drop in function.drops {
        if !mir_pass_place_id_seen(used_places, drop.place) -> &used_places.push(drop.place)
    }
    kept_places := [MIRPlace]{}
    loop place in function.places {
        if mir_pass_place_id_seen(used_places, place.id) -> &kept_places.push(place)
    }
    function.places = kept_places
}

fn mir_pass_inline_clear_dead_scope_deadlines(function: &MIRFunction) Never! {
    loop scope_index in 0..<function.scopes.len() {
        value :: function.scopes[scope_index].deadline ?? next
        if !mir_pass_inline_value_defined(function.blocks, value) -> function.scopes[scope_index].deadline = None
    }
}

fn mir_pass_inline_block_index(rows: [MIRBasicBlock], id: MIRBlockID) -> Int Never! {
    loop (index, row) in rows { if row.id == id -> return index }
    -1
}

fn mir_pass_inline_instruction_index(rows: [MIRInstruction], id: MIROpID) -> Int Never! {
    loop (index, row) in rows { if row.id == id -> return index }
    -1
}

fn mir_pass_inline_value_defined(blocks: [MIRBasicBlock], value: MIRValueID) -> Bool Never! {
    loop block in blocks {
        loop instruction in block.instructions { if Val(value) == instruction.result -> return true }
    }
    false
}
