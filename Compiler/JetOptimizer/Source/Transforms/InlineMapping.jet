// Identity maps and payload rewriting for checked, target-neutral inline CFG expansion.
use jet_foundation.[
    AccessConvention,
    CallContractRow,
    CallablePolicy,
    CallablePolicyChain,
    Dimension,
    DimensionAxis,
    FunctionCallMetadata,
    FunctionDefaultRef,
    InternalTag,
    MIRBasicBlock,
    MIRBlockID,
    MIRCallArg,
    MIRCallContractRow,
    MIRCallFallibility,
    MIRCallMetadata,
    MIRCallee,
    MIRCaptureOperand,
    MIRConstant,
    MIRCopyFact,
    MIRConversion,
    MIRDataPlan,
    MIRDataPlanCallable,
    MIRDataPlanColumn,
    MIRDataPlanNode,
    MIRDimension,
    MIRDropAction,
    MIRDropEdge,
    MIREnumArg,
    MIRFailureCarrier,
    MIRFieldValue,
    MIRFnCoercion,
    MIRFunction,
    MIRFunctionSignature,
    MIRHardwareOp,
    MIRInstruction,
    MIRLocal,
    MIRLocalID,
    MIRMapEntry,
    MIRMeasure,
    MIROpID,
    MIROperation,
    MIRPanicContext,
    MIRPanicLocal,
    MIRPhiIncoming,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeTypeArg,
    MIRProjection,
    MIRReflectField,
    MIRScope,
    MIRScopeID,
    MIRSemanticOp,
    MIRStringPart,
    MIRStringPartKind,
    MIRSwitchArm,
    MIRTagMarker,
    MIRTerminator,
    MIRTestScopeMember,
    MIRTupleField,
    MIRType,
    MIRTypeKind,
    MIRValueFact,
    MIRValueID,
    Measure,
    MeasureRule,
    TagMarker,
    Type,
    TypeTupleField,
    mir_call_metadata_is_variadic,
    mir_copy_ownership,
    mir_copy_fact_for_ownership,
    mir_type_from_kind,
    mir_type_id,
    mir_type_is_unit,
    mir_type_same_checked_type,
    mir_type_with_identity,
    stable_id,
    type_identity_key,
]

struct MIRInlineIDMap { pub source: U64, pub target: U64 }

struct MIRInlineValueMap { pub source: MIRValueID, pub target: MIRValueID, pub parameter: Bool }

struct MIRInlinePlaceMap { pub source: MIRPlaceID, pub target: MIRPlaceID, pub materialize: Bool }

struct MIRInlineTypeSubstitution { pub name: String, pub ty: MIRType }

struct MIRInlineMaps {
    pub values: [MIRInlineValueMap]
    pub blocks: [MIRInlineIDMap]
    pub places: [MIRInlinePlaceMap]
    pub locals: [MIRInlineIDMap]
    pub scopes: [MIRInlineIDMap]
    pub operations: [MIRInlineIDMap]
}

struct MIRInlinePlan {
    pub entry: MIRBlockID
    pub continuation: MIRBlockID
    pub blocks: [MIRBasicBlock]
    pub adapter_instructions: [MIRInstruction]
    pub values: [MIRValueFact]
    pub locals: [MIRLocal]
    pub places: [MIRPlace]
    pub scopes: [MIRScope]
    pub drops: [MIRDropAction]
    pub return_incoming: [MIRPhiIncoming]
    pub returns: Bool
}

struct MIRInlinePlanResult { pub plan: MIRInlinePlan?, pub error: MIROptimizationError? }

fn mir_pass_inline_plan(
    caller: MIRFunction,
    callee: MIRFunction,
    call_instruction: MIRInstruction,
    args: [MIRCallArg],
    type_args: [MIRType],
) -> MIRInlinePlanResult Never! {
    if args.len() != callee.params.len() || callee.generic_params.len() != type_args.len() -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), call_instruction.span, "#Inline(Always) call arguments do not match the checked function signature"))}
    if mir_pass_inline_has_return_drop(callee) -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), call_instruction.span, "#Inline(Always) cannot relocate callee-scoped Return cleanup into the caller"))}
    substitutions := [MIRInlineTypeSubstitution]{}
    loop (index, parameter) in callee.generic_params {
        &substitutions.push(MIRInlineTypeSubstitution{name: parameter.name, ty: type_args[index]})
    }
    identity :: "caller={caller.id.value}:call={call_instruction.id.value}:callee={callee.id.value}"
    maps := MIRInlineMaps{values: [MIRInlineValueMap]{}, blocks: [MIRInlineIDMap]{}, places: [MIRInlinePlaceMap]{}, locals: [MIRInlineIDMap]{}, scopes: [MIRInlineIDMap]{}, operations: [MIRInlineIDMap]{}}
    used_values := [U64]{}
    used_blocks := [U64]{}
    used_places := [U64]{}
    used_locals := [U64]{}
    used_scopes := [U64]{}
    used_operations := [U64]{}
    loop value in caller.values -> &used_values.push(value.id.value)
    loop block in caller.blocks {
        &used_blocks.push(block.id.value)
        loop instruction in block.instructions {
            &used_operations.push(instruction.id.value)
            if instruction.result == .Val(result) -> &used_values.push(result.value)
        }
    }
    loop place in caller.places -> &used_places.push(place.id.value)
    loop local in caller.locals -> &used_locals.push(local.id.value)
    loop scope in caller.scopes -> &used_scopes.push(scope.id.value)

    parameter_values := [MIRValueID]{}
    loop _ in callee.params -> &parameter_values.push(MIRValueID{value: 0})
    loop block in callee.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .Parameter(parameter_index, _) -> {
                    if instruction.result == None || parameter_index < 0 || parameter_index >= parameter_values.len() || parameter_values[parameter_index].value != 0 -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), instruction.span, "#Inline(Always) parameter definitions are not canonical"))}
                    parameter_values[parameter_index] = instruction.result ?? MIRValueID{value: 0}
                }
                .Capture(_) -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), instruction.span, "captured values cannot be remapped in an inline body"))}
                else -> {}
            }
        }
    }
    adapters := [MIRInstruction]{}
    adapter_values := [MIRValueFact]{}
    loop (index, argument) in args {
        if parameter_values[index].value == 0 -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), call_instruction.span, "#Inline(Always) parameter definition is missing"))}
        argument_fact :: mir_pass_find_value(caller.values, argument.value) ?? return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), argument.span, "#Inline(Always) argument value metadata is missing"))}
        adapted :: if {
            argument.implicit_clone || argument.shared_auto_clone -> {
                cloned :: MIRValueID{value: mir_pass_inline_fresh_id(&used_values, "mir-inline-value", "{identity}:clone:{argument.value.value}:{index}")}
                operation_id :: MIROpID{value: mir_pass_inline_fresh_id(&used_operations, "mir-inline-op", "{identity}:clone-op:{argument.value.value}:{index}")}
                ownership := argument_fact.ownership
                ownership.moved = false
                ownership.last_use = false
                &adapter_values.push(MIRValueFact{id: cloned, ty: argument_fact.ty, span: argument_fact.span, ownership: ownership})
                fact :: mir_copy_fact_for_ownership(if argument.shared_auto_clone -> MIRCopyFact.Share else -> MIRCopyFact.Materialize, argument_fact.ownership.mode)
                &adapters.push(MIRInstruction{id: operation_id, span: argument_fact.span, source_line: None, result: Val(cloned), ty: Val(argument_fact.ty), operation: MIROperation.Copy{value: argument.value, fact: fact}})
                cloned
            }
            mir_pass_inline_call_arg_consumes(argument) -> {
                moved :: MIRValueID{value: mir_pass_inline_fresh_id(&used_values, "mir-inline-value", "{identity}:move:{argument.value.value}:{index}")}
                operation_id :: MIROpID{value: mir_pass_inline_fresh_id(&used_operations, "mir-inline-op", "{identity}:move-op:{argument.value.value}:{index}")}
                ownership := argument_fact.ownership
                ownership.moved = false
                ownership.last_use = false
                &adapter_values.push(MIRValueFact{id: moved, ty: argument_fact.ty, span: argument_fact.span, ownership: ownership})
                &adapters.push(MIRInstruction{id: operation_id, span: argument_fact.span, source_line: None, result: Val(moved), ty: Val(argument_fact.ty), operation: MIROperation.Move{value: argument.value}})
                moved
            }
            else -> argument.value
        }
        &maps.values.push(MIRInlineValueMap{source: parameter_values[index], target: adapted, parameter: true})
    }

    loop value in callee.values {
        if mir_pass_inline_value_map_exists(maps.values, value.id) -> next
        mapped :: MIRValueID{value: mir_pass_inline_fresh_id(&used_values, "mir-inline-value", "{identity}:value:{value.id.value}")}
        &maps.values.push(MIRInlineValueMap{source: value.id, target: mapped, parameter: false})
    }
    loop block in callee.blocks {
        mapped :: MIRBlockID{value: mir_pass_inline_fresh_id(&used_blocks, "mir-inline-block", "{identity}:block:{block.id.value}")}
        &maps.blocks.push(MIRInlineIDMap{source: block.id.value, target: mapped.value})
    }
    loop local in callee.locals {
        mapped :: MIRLocalID{value: mir_pass_inline_fresh_id(&used_locals, "mir-inline-local", "{identity}:local:{local.id.value}")}
        &maps.locals.push(MIRInlineIDMap{source: local.id.value, target: mapped.value})
    }
    loop scope in callee.scopes {
        mapped :: MIRScopeID{value: mir_pass_inline_fresh_id(&used_scopes, "mir-inline-scope", "{identity}:scope:{scope.id.value}")}
        &maps.scopes.push(MIRInlineIDMap{source: scope.id.value, target: mapped.value})
    }
    loop place in callee.places {
        argument_place := mir_pass_inline_parameter_place(place, parameter_values, args)
        if {
            argument_place != None && place.projections.len() == 0 -> {
                &maps.places.push(MIRInlinePlaceMap{source: place.id, target: (argument_place ?? MIRPlaceID{value: 0}), materialize: false})
            }
            else -> {
                mapped :: MIRPlaceID{value: mir_pass_inline_fresh_id(&used_places, "mir-inline-place", "{identity}:place:{place.id.value}")}
                &maps.places.push(MIRInlinePlaceMap{source: place.id, target: mapped, materialize: true})
            }
        }

    }
    loop block in callee.blocks {
        loop instruction in block.instructions {
            is_parameter :: if instruction.operation == { .Parameter(_, _) -> true else -> false }
            if is_parameter -> next
            operation_id :: MIROpID{value: mir_pass_inline_fresh_id(&used_operations, "mir-inline-op", "{identity}:op:{instruction.id.value}")}
            &maps.operations.push(MIRInlineIDMap{source: instruction.id.value, target: operation_id.value})
        }
    }
    continuation :: MIRBlockID{value: mir_pass_inline_fresh_id(&used_blocks, "mir-inline-block", "{identity}:continuation")}
    plan := MIRInlinePlan{
        entry: mir_pass_inline_block(maps, callee.entry),
        continuation: continuation,
        blocks: [MIRBasicBlock]{},
        adapter_instructions: adapters,
        values: adapter_values,
        locals: [MIRLocal]{},
        places: [MIRPlace]{},
        scopes: [MIRScope]{},
        drops: [MIRDropAction]{},
        return_incoming: [MIRPhiIncoming]{},
        returns: false,
    }
    loop place in callee.places {
        map :: mir_pass_inline_place_map(maps, place.id) ?? MIRInlinePlaceMap{source: place.id, target: place.id, materialize: false}
        if !map.materialize -> next
        parameter_source :: mir_pass_inline_parameter_place_source(place, parameter_values, args)
        base := mir_pass_inline_place_base(place.base, maps)
        projections := [MIRProjection]{}
        if parameter_source == .Val(source_id) {
            source_place :: mir_pass_find_place(caller.places, source_id) ?? next
            base = source_place.base
            loop projection in source_place.projections -> &projections.push(projection)
        }
        loop projection in place.projections -> &projections.push(mir_pass_inline_projection(projection, maps))
        &plan.places.push(MIRPlace{id: map.target, span: place.span, ty: mir_pass_inline_type(place.ty, substitutions), base: base, projections: projections, access: place.access, persist_key: place.persist_key})
    }
    loop local in callee.locals {
        &plan.locals.push(MIRLocal{
            id: mir_pass_inline_local(maps, local.id),
            name: local.name,
            span: local.span,
            ty: mir_pass_inline_type(local.ty, substitutions),
            place: mir_pass_inline_place(maps, local.place),
            mutable: local.mutable,
            ownership: local.ownership,
            is_comptime: local.is_comptime,
            uninit: local.uninit,
            arena_view: local.arena_view,
            string_view: local.string_view,
            gc_root: local.gc_root,
        })
    }
    loop value in callee.values {
        map :: mir_pass_inline_value_map(maps.values, value.id) ?? MIRInlineValueMap{source: value.id, target: value.id, parameter: true}
        if !map.parameter -> &plan.values.push(MIRValueFact{id: map.target, ty: mir_pass_inline_type(value.ty, substitutions), span: value.span, ownership: value.ownership})
    }
    loop scope in callee.scopes {
        &plan.scopes.push(MIRScope{id: mir_pass_inline_scope(maps, scope.id), kind: scope.kind, span: scope.span, name: scope.name, deadline: mir_pass_inline_optional_value(maps, scope.deadline), facts: scope.facts})
    }
    loop drop in callee.drops {
        edge :: mir_pass_inline_drop_edge(drop.edge, maps)
        &plan.drops.push(MIRDropAction{place: mir_pass_inline_place(maps, drop.place), edge: edge, span: drop.span})
    }
    loop block in callee.blocks {
        instructions := [MIRInstruction]{}
        loop instruction in block.instructions {
            is_parameter :: if instruction.operation == { .Parameter(_, _) -> true else -> false }
            if is_parameter -> next
            mapped_operation :: mir_pass_inline_operation(instruction.operation, maps, substitutions) ?? return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), instruction.span, "#Inline(Always) operation payload contains an unremappable identity"))}
            mapped_result :: mir_pass_inline_optional_value(maps, instruction.result)
            operation_id :: MIROpID{value: mir_pass_inline_id_target(maps.operations, instruction.id.value)}
            &instructions.push(MIRInstruction{id: operation_id, span: instruction.span, source_line: instruction.source_line, result: mapped_result, ty: mir_pass_inline_optional_type(instruction.ty, substitutions), operation: mapped_operation})
        }
        terminator :: if block.terminator == {
            .Return(value) -> {
                // A propagated Result/Option is the call's value, not a return from the caller.
                plan.returns = true
                mapped_value := mir_pass_inline_optional_value(maps, value)
                if mapped_value == None && call_instruction.result != None {
                    return_type :: mir_pass_inline_type(callee.return_type, substitutions)
                    if !mir_type_is_unit(return_type) -> return MIRInlinePlanResult{plan: None, error: Val(mir_pass_error(.LegalityVerification, .InvalidDefUse, Val(caller.id), block.span, "#Inline(Always) non-Unit return has no SSA value"))}
                    unit_value :: MIRValueID{value: mir_pass_inline_fresh_id(&used_values, "mir-inline-value", "{identity}:unit-return:{block.id.value}")}
                    unit_operation :: MIROpID{value: mir_pass_inline_fresh_id(&used_operations, "mir-inline-op", "{identity}:unit-return-op:{block.id.value}")}
                    &plan.values.push(MIRValueFact{id: unit_value, ty: return_type, span: block.span, ownership: mir_copy_ownership()})
                    &instructions.push(MIRInstruction{id: unit_operation, span: block.span, source_line: None, result: Val(unit_value), ty: Val(return_type), operation: MIROperation.Constant{value: MIRConstant.Unit}})
                    mapped_value = Val(unit_value)
                }
                if mapped_value == .Val(returned) -> &plan.return_incoming.push(MIRPhiIncoming{block: mir_pass_inline_block(maps, block.id), value: returned})
                MIRTerminator.Jump{target: continuation}
            }
            else -> mir_pass_inline_terminator(block.terminator, maps)
        }
        &plan.blocks.push(MIRBasicBlock{id: mir_pass_inline_block(maps, block.id), span: block.span, instructions: instructions, terminator: terminator})
    }
    MIRInlinePlanResult{plan: Val(plan), error: None}
}

fn mir_pass_inline_call_site_can_expand(
    caller: MIRFunction,
    callee: MIRFunction,
    call_instruction: MIRInstruction,
    args: [MIRCallArg],
    type_args: [MIRType],
) -> Bool Never! {
    if mir_pass_inline_has_return_drop(callee) -> return false
    if args.len() != callee.params.len() || callee.generic_params.len() != type_args.len() -> return false
    substitutions := [MIRInlineTypeSubstitution]{}
    loop (index, parameter) in callee.generic_params {
        &substitutions.push(MIRInlineTypeSubstitution{name: parameter.name, ty: type_args[index]})
    }
    if call_instruction.result != None && call_instruction.ty == None -> return false
    return_type :: mir_pass_inline_type(callee.return_type, substitutions)
    if call_instruction.ty == .Val(call_type) {
        if !mir_type_same_checked_type(call_type, return_type) -> return false
    }
    loop (index, argument) in args {
        argument_fact :: mir_pass_find_value(caller.values, argument.value) ?? return false
        parameter_type :: mir_pass_inline_type(callee.params[index].ty, substitutions)
        if !mir_type_same_checked_type(argument_fact.ty, parameter_type) -> return false
        if argument.fn_coercion != None || argument.widen_fixed_to_list || argument.widen_to_union != None || argument.box_as_trait != None || argument.authority_boundary -> return false
    }
    reachable :: mir_pass_reachable(callee)
    reachable_returns := 0
    loop block in callee.blocks {
        if !mir_pass_block_id_seen(reachable, block.id) -> next
        if block.terminator == {
            .Return(value) -> {
                reachable_returns += 1
                if call_instruction.result != None && value == None && !mir_type_is_unit(return_type) -> return false
            }
            else -> {}
        }
    }
    if reachable_returns == 0 && call_instruction.result != None -> return false
    true
}

fn mir_pass_inline_has_return_drop(callee: MIRFunction) -> Bool Never! {
    loop drop in callee.drops {
        has_return_drop :: if drop.edge == { .Return -> true else -> false }
        if has_return_drop -> return true
    }
    false
}

fn mir_pass_inline_call_arg_consumes(argument: MIRCallArg) -> Bool Never! {
    if argument.implicit_clone || argument.shared_auto_clone || argument.widen_fixed_to_list -> false else -> argument.access == .Move || argument.owned_last_use
}

fn mir_pass_inline_fresh_id(used: &[U64], namespace: String, identity: String) -> U64 Never! {
    salt := 0
    loop {
        candidate :: stable_id(namespace, "{identity}:salt={salt}")
        if !mir_pass_inline_int_seen(used, candidate) {
            &used.push(candidate)
            return candidate
        }
        salt += 1
    }
    U64{0}
}

fn mir_pass_inline_int_seen(rows: [U64], value: U64) -> Bool Never! {
    loop row in rows { if row == value -> return true }
    false
}

fn mir_pass_inline_value_map(rows: [MIRInlineValueMap], value: MIRValueID) -> MIRInlineValueMap? {
    loop row in rows { if row.source == value -> return Val(row) }
    None
}

fn mir_pass_inline_value_map_exists(rows: [MIRInlineValueMap], value: MIRValueID) -> Bool Never! {
    mir_pass_inline_value_map(rows, value) != None
}

fn mir_pass_inline_value(maps: MIRInlineMaps, value: MIRValueID) -> MIRValueID Never! {
    row :: mir_pass_inline_value_map(maps.values, value) ?? return value
    row.target
}

fn mir_pass_inline_optional_value(maps: MIRInlineMaps, value: MIRValueID?) -> MIRValueID? {
    present :: value ?? return None
    Val(mir_pass_inline_value(maps, present))
}

fn mir_pass_inline_id_target(rows: [MIRInlineIDMap], source: U64) -> U64 Never! {
    loop row in rows { if row.source == source -> return row.target }
    source
}

fn mir_pass_inline_block(maps: MIRInlineMaps, block: MIRBlockID) -> MIRBlockID Never! {
    MIRBlockID{value: mir_pass_inline_id_target(maps.blocks, block.value)}
}

fn mir_pass_inline_local(maps: MIRInlineMaps, local: MIRLocalID) -> MIRLocalID Never! {
    MIRLocalID{value: mir_pass_inline_id_target(maps.locals, local.value)}
}

fn mir_pass_inline_scope(maps: MIRInlineMaps, scope: MIRScopeID) -> MIRScopeID Never! {
    MIRScopeID{value: mir_pass_inline_id_target(maps.scopes, scope.value)}
}

fn mir_pass_inline_place_map(maps: MIRInlineMaps, place: MIRPlaceID) -> MIRInlinePlaceMap? {
    loop row in maps.places { if row.source == place -> return Val(row) }
    None
}

fn mir_pass_inline_place(maps: MIRInlineMaps, place: MIRPlaceID) -> MIRPlaceID Never! {
    row :: mir_pass_inline_place_map(maps, place) ?? return place
    row.target
}

// The optional mappings below replace `.map(value -> …maps…)` callbacks,
// which would capture (copy) every map of the inlined body per operand.
fn mir_pass_inline_optional_place(maps: MIRInlineMaps, place: MIRPlaceID?) -> MIRPlaceID? {
    present :: place ?? return None
    Val(mir_pass_inline_place(maps, present))
}

fn mir_pass_inline_operation_target(rows: [MIRInlineIDMap], operation: MIROpID) -> MIROpID Never! {
    MIROpID{value: mir_pass_inline_id_target(rows, operation.value)}
}

fn mir_pass_inline_parameter_place(place: MIRPlace, parameters: [MIRValueID], args: [MIRCallArg]) -> MIRPlaceID? {
    if place.base == {
        .Parameter(value) -> {
            loop (index, parameter) in parameters {
                if parameter == value && index < args.len() -> return args[index].place
            }
        }
        else -> {}
    }
    None
}

fn mir_pass_inline_parameter_place_source(place: MIRPlace, parameters: [MIRValueID], args: [MIRCallArg]) -> MIRPlaceID? {
    mir_pass_inline_parameter_place(place, parameters, args)
}

fn mir_pass_inline_place_base(base: MIRPlaceBase, maps: MIRInlineMaps) -> MIRPlaceBase Never! {
    if base == {
        .Local(local) -> MIRPlaceBase.Local{local: mir_pass_inline_local(maps, local)}
        .Parameter(value) -> MIRPlaceBase.Parameter{value: mir_pass_inline_value(maps, value)}
        .Capture(value) -> MIRPlaceBase.Capture{value: mir_pass_inline_value(maps, value)}
        .Temporary(value) -> MIRPlaceBase.Temporary{value: mir_pass_inline_value(maps, value)}
        .Static(name) -> MIRPlaceBase.Static{name: name}
    }
}

fn mir_pass_inline_projection(projection: MIRProjection, maps: MIRInlineMaps) -> MIRProjection Never! {
    if projection == {
        .Field(field, span) -> MIRProjection.Field{field: field, span: span}
        .Index(kind, index, call, write_call, location, context, span) -> MIRProjection.Index{kind: kind, index: mir_pass_inline_value(maps, index), call: call, write_call: write_call, location: location, context: mir_pass_inline_optional_panic_context(context, maps), span: span}
        .Deref(span) -> MIRProjection.Deref{span: span}
        .Payload(kind, span) -> MIRProjection.Payload{kind: kind, span: span}
        .Range(range, location, span) -> MIRProjection.Range{range: mir_pass_inline_value(maps, range), location: location, span: span}
    }
}

fn mir_pass_inline_drop_edge(edge: MIRDropEdge, maps: MIRInlineMaps) -> MIRDropEdge Never! {
    if edge == {
        .Normal -> MIRDropEdge.Normal
        .Return -> MIRDropEdge.Return
        .Failure(target) -> MIRDropEdge.Failure{target: mir_pass_inline_block(maps, target)}
        .Unwind(target) -> MIRDropEdge.Unwind{target: mir_pass_inline_block(maps, target)}
    }
}

fn mir_pass_inline_terminator(terminator: MIRTerminator, maps: MIRInlineMaps) -> MIRTerminator Never! {
    if terminator == {
        .Jump(target) -> MIRTerminator.Jump{target: mir_pass_inline_block(maps, target)}
        .Branch(condition, then_target, else_target) -> MIRTerminator.Branch{condition: mir_pass_inline_value(maps, condition), then_target: mir_pass_inline_block(maps, then_target), else_target: mir_pass_inline_block(maps, else_target)}
        .Switch(subject, arms, otherwise) -> {
            mapped_arms :: loop arm in arms -> MIRSwitchArm{condition: mir_pass_inline_value(maps, arm.condition), target: mir_pass_inline_block(maps, arm.target), span: arm.span}
            MIRTerminator.Switch{subject: mir_pass_inline_value(maps, subject), arms: mapped_arms, otherwise: mir_pass_inline_block(maps, otherwise)}
        }
        .Return(value) -> MIRTerminator.Return{value: mir_pass_inline_optional_value(maps, value)}
        .Yield(value, resume) -> MIRTerminator.Yield{value: mir_pass_inline_value(maps, value), resume: mir_pass_inline_block(maps, resume)}
        .Break(target, value) -> MIRTerminator.Break{target: mir_pass_inline_block(maps, target), value: mir_pass_inline_optional_value(maps, value)}
        .Continue(target) -> MIRTerminator.Continue{target: mir_pass_inline_block(maps, target)}
        .Unreachable(reason) -> MIRTerminator.Unreachable{reason: reason}
    }
}

fn mir_pass_inline_optional_type(ty: MIRType?, substitutions: [MIRInlineTypeSubstitution]) -> MIRType? {
    present :: ty ?? return None
    Val(mir_pass_inline_type(present, substitutions))
}

fn mir_pass_inline_type(ty: MIRType, substitutions: [MIRInlineTypeSubstitution]) -> MIRType Never! {
    kind :: if ty.kind == {
        .List(inner) -> MIRTypeKind.List{inner: mir_pass_inline_type(inner, substitutions)}
        .Map(key, value) -> MIRTypeKind.Map{key: mir_pass_inline_type(key, substitutions), value: mir_pass_inline_type(value, substitutions)}
        .Shared(inner) -> MIRTypeKind.Shared{inner: mir_pass_inline_type(inner, substitutions)}
        .Option(inner) -> MIRTypeKind.Option{inner: mir_pass_inline_type(inner, substitutions)}
        .Result(ok, error) -> MIRTypeKind.Result{ok: mir_pass_inline_type(ok, substitutions), err: mir_pass_inline_type(error, substitutions)}
        .Fn(signature) -> MIRTypeKind.Fn{signature: mir_pass_inline_signature(signature, substitutions)}
        .SendFn(params, result, conventions) -> {
            mapped :: loop parameter in params -> mir_pass_inline_type(parameter, substitutions)
            MIRTypeKind.SendFn{params: mapped, ret: mir_pass_inline_optional_type(result, substitutions), conventions: conventions}
        }
        .Apply(name, args) -> {
            if args.len() == 0 {
                loop substitution in substitutions {
                    if name.name == substitution.name -> return substitution.ty
                }
            }
            mapped :: loop argument in args -> mir_pass_inline_type(argument, substitutions)
            MIRTypeKind.Apply{name: name, args: mapped}
        }
        .Tuple(fields) -> {
            mapped :: loop field in fields -> MIRTupleField{name: field.name, ty: mir_pass_inline_type(field.ty, substitutions)}
            MIRTypeKind.Tuple{fields: mapped}
        }
        .FixedList(element, length) -> MIRTypeKind.FixedList{elem: mir_pass_inline_type(element, substitutions), len: length}
        .InlineRange(base, low, high) -> MIRTypeKind.InlineRange{base: mir_pass_inline_type(base, substitutions), lo: low, hi: high}
        .Tagged(marker, inner) -> MIRTypeKind.Tagged{marker: marker, inner: mir_pass_inline_type(inner, substitutions)}
        .Union(members) -> {
            mapped :: loop member in members -> mir_pass_inline_type(member, substitutions)
            MIRTypeKind.Union{members: mapped}
        }
        .Quantity(base, dimension) -> MIRTypeKind.Quantity{base: mir_pass_inline_type(base, substitutions), dimension: dimension}
        else -> ty.kind
    }
    mapped :: mir_type_from_kind(kind)
    if kind == ty.kind -> return MIRType{kind: kind, identity: ty.identity, layout: mapped.layout}
    source_type :: mir_pass_inline_source_type(mapped)
    mir_type_with_identity(mapped, mir_type_id(type_identity_key(source_type)))
}

// Rebuild Source's checked type identity domain; MIR canonical keys are display
// spellings and differ for containers and knowledge-bearing types.
fn mir_pass_inline_source_type(ty: MIRType) -> Type Never! {
    if ty.kind == {
        .Int -> Type.Int
        .Float -> Type.Float
        .Bool -> Type.Bool
        .String -> Type.String
        .Char -> Type.Char
        .List(inner) -> Type.List{element: mir_pass_inline_source_type(inner)}
        .Map(key, value) -> Type.Map{key: mir_pass_inline_source_type(key), key_span: None, value: mir_pass_inline_source_type(value)}
        .Shared(inner) -> Type.Shared{inner: mir_pass_inline_source_type(inner)}
        .Option(inner) -> Type.Option{inner: mir_pass_inline_source_type(inner)}
        .Result(ok, error) -> Type.Result{ok: mir_pass_inline_source_type(ok), err: mir_pass_inline_source_type(error)}
        .Fn(signature) -> mir_pass_inline_source_function(signature)
        .SendFn(params, result, _) -> {
            mapped :: loop parameter in params -> mir_pass_inline_source_type(parameter)
            Type.Fn{params: mapped, ret: result.map(value -> mir_pass_inline_source_type(value)), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        }
        .Apply(name, args) -> {
            if args.len() == 0 -> return Type.Named{name: name.name}
            mapped :: loop argument in args -> mir_pass_inline_source_type(argument)
            Type.Apply{name: name.name, args: mapped}
        }
        .TraitObject(bounds) -> {
            names :: loop bound in bounds -> bound.name
            Type.TraitObject{bounds: names}
        }
        .Tuple(fields) -> {
            mapped :: loop field in fields -> TypeTupleField{name: field.name, ty: mir_pass_inline_source_type(field.ty)}
            Type.Tuple{fields: mapped}
        }
        .FixedList(element, length) -> Type.FixedList{elem: mir_pass_inline_source_type(element), len: mir_pass_inline_source_measure(length)}
        .IntN(signed, bits) -> Type.IntN{signed: signed, bits: bits}
        .InlineRange(base, low, high) -> Type.InlineRange{base: mir_pass_inline_source_type(base), lo: low, hi: high}
        .Float32 -> Type.Float32
        .Tagged(marker, inner) -> Type.Tagged{marker: mir_pass_inline_source_tag(marker), inner: mir_pass_inline_source_type(inner)}
        .Union(members) -> {
            mapped :: loop member in members -> mir_pass_inline_source_type(member)
            Type.Union{members: mapped}
        }
        .Quantity(base, dimension) -> Type.Quantity{base: mir_pass_inline_source_type(base), dimension: mir_pass_inline_source_dimension(dimension)}
        .Measure(value) -> Type.Measure{measure: mir_pass_inline_source_measure(value)}
    }
}

fn mir_pass_inline_source_function(signature: MIRFunctionSignature) -> Type Never! {
    params :: loop parameter in signature.params -> mir_pass_inline_source_type(parameter)
    contracts :: mir_pass_inline_source_contracts(signature.param_contract)
    call_metadata :: mir_pass_inline_source_call_metadata(signature.call_metadata)
    Type.Fn{params: params, ret: signature.ret.map(value -> mir_pass_inline_source_type(value)), effect_bound: None, param_contract: contracts, call_metadata: call_metadata, return_view_provenance: None}
}

fn mir_pass_inline_source_contracts(contract: [MIRCallContractRow]?) -> [CallContractRow]? {
    contract_rows :: contract ?? return None
    rows :: loop row in contract_rows -> CallContractRow{label: row.label, zone: row.zone}
    Val(rows)
}

fn mir_pass_inline_source_call_metadata(call_metadata: MIRCallMetadata?) -> FunctionCallMetadata? {
    metadata :: call_metadata ?? return None
    if !mir_call_metadata_is_variadic(metadata) -> return None
    Val(FunctionCallMetadata{names: [String]{}, defaults: [FunctionDefaultRef?]{}, variadic: metadata.variadic, conventions: [AccessConvention]{}, policies: CallablePolicyChain{policies: [CallablePolicy]{}}})
}

fn mir_pass_inline_source_measure(value: MIRMeasure) -> Measure Never! {
    if value == {
        .Literal(kind, amount) -> Measure.Literal{kind: kind, value: amount}
        .SignedLiteral(kind, amount) -> Measure.SignedLiteral{kind: kind, value: amount}
        .Symbol(kind, name) -> Measure.Symbol{kind: kind, name: name}
        .Combined(kind, rule, left, right) -> {
            mapped_rule :: if rule == {
                .Add -> MeasureRule.Add
                .Mul -> MeasureRule.Mul
                .Match -> MeasureRule.Match
            }
            Measure.Combined{kind: kind, rule: mapped_rule, left: mir_pass_inline_source_measure(left), right: mir_pass_inline_source_measure(right)}
        }
    }
}

fn mir_pass_inline_source_dimension(value: MIRDimension) -> Dimension Never! {
    axes :: loop axis in value.axes -> DimensionAxis{name: axis.name, exponent: mir_pass_inline_source_measure(axis.exponent)}
    Dimension{axes: axes}
}

fn mir_pass_inline_source_tag(marker: MIRTagMarker) -> TagMarker Never! {
    if marker == {
        .User(name) -> TagMarker.User{name: name}
        .Internal(internal_tag) -> TagMarker.Internal{internal_tag: if internal_tag == {
            .CoreCryptoNominal -> InternalTag.CoreCryptoNominal
            .DeterministicClock -> InternalTag.DeterministicClock
            .SystemClock -> InternalTag.SystemClock
            .ExpiringSecretLoan -> InternalTag.ExpiringSecretLoan
            .SharedGuardRead -> InternalTag.SharedGuardRead
            .SharedGuardEdit -> InternalTag.SharedGuardEdit
            .TerminalFactSet -> InternalTag.TerminalFactSet
            .CppCallbackABI -> InternalTag.CppCallbackABI
            .AllocatorView -> InternalTag.AllocatorView
        }}
    }
}

fn mir_pass_inline_signature(signature: MIRFunctionSignature, substitutions: [MIRInlineTypeSubstitution]) -> MIRFunctionSignature Never! {
    params :: loop parameter in signature.params -> mir_pass_inline_type(parameter, substitutions)
    MIRFunctionSignature{
        params: params,
        ret: mir_pass_inline_optional_type(signature.ret, substitutions),
        effect_bound: signature.effect_bound,
        param_contract: signature.param_contract,
        call_metadata: signature.call_metadata,
        return_view_provenance: signature.return_view_provenance,
    }
}

fn mir_pass_inline_failure_carrier(carrier: MIRFailureCarrier, substitutions: [MIRInlineTypeSubstitution]) -> MIRFailureCarrier Never! {
    if carrier == {
        .Infallible -> MIRFailureCarrier.Infallible
        .Result(success, error) -> MIRFailureCarrier.Result{success: mir_pass_inline_type(success, substitutions), error: mir_pass_inline_type(error, substitutions)}
        .Optional(value) -> MIRFailureCarrier.Optional{value: mir_pass_inline_type(value, substitutions)}
        .Diverges(value) -> MIRFailureCarrier.Diverges{value: mir_pass_inline_type(value, substitutions)}
    }
}

fn mir_pass_inline_fallibility(fallibility: MIRCallFallibility, substitutions: [MIRInlineTypeSubstitution]) -> MIRCallFallibility Never! {
    if fallibility == {
        .Infallible -> MIRCallFallibility.Infallible
        .Failure(failure) -> MIRCallFallibility.Failure{failure: mir_pass_inline_failure_carrier(failure, substitutions)}
    }
}

fn mir_pass_inline_conversion(conversion: MIRConversion, substitutions: [MIRInlineTypeSubstitution]) -> MIRConversion Never! {
    if conversion == {
        .Transparent -> MIRConversion.Transparent
        .NumericCast -> MIRConversion.NumericCast
        .SendFn -> MIRConversion.SendFn
        .Prelude(call, location, fallibility) -> MIRConversion.Prelude{call: call, location: location, fallibility: mir_pass_inline_fallibility(fallibility, substitutions)}
    }
}

fn mir_pass_inline_callee(callee: MIRCallee, maps: MIRInlineMaps, substitutions: [MIRInlineTypeSubstitution]) -> MIRCallee Never! {
    if callee == {
        .User(function) -> MIRCallee.User{function: function}
        .Associated(function, owner) -> MIRCallee.Associated{function: function, owner: mir_pass_inline_type(owner, substitutions)}
        .TraitMethod(method, trait_ref, receiver) -> MIRCallee.TraitMethod{method: method, trait_ref: trait_ref, receiver: mir_pass_inline_type(receiver, substitutions)}
        .Method(function, owner) -> MIRCallee.Method{function: function, owner: mir_pass_inline_type(owner, substitutions)}
        .Core(call) -> MIRCallee.Core{call: call}
        .Prelude(call) -> MIRCallee.Prelude{call: call}
        .Foreign(id) -> MIRCallee.Foreign{id: id}
        .Indirect(value) -> MIRCallee.Indirect{value: mir_pass_inline_value(maps, value)}
    }
}

fn mir_pass_inline_call_arg(argument: MIRCallArg, maps: MIRInlineMaps, substitutions: [MIRInlineTypeSubstitution]) -> MIRCallArg Never! {
    MIRCallArg{
        value: mir_pass_inline_value(maps, argument.value),
        place: mir_pass_inline_optional_place(maps, argument.place),
        access: argument.access,
        span: argument.span,
        label: argument.label,
        source_index: argument.source_index,
        binder_slot: argument.binder_slot,
        spread: argument.spread,
        implicit_clone: argument.implicit_clone,
        shared_auto_clone: argument.shared_auto_clone,
        owned_last_use: argument.owned_last_use,
        authority_boundary: argument.authority_boundary,
        fn_coercion: argument.fn_coercion.map(value -> MIRFnCoercion{ty: mir_pass_inline_type(value.ty, substitutions), already_boxed: value.already_boxed}),
        widen_fixed_to_list: argument.widen_fixed_to_list,
        widen_to_union: argument.widen_to_union,
        box_as_trait: argument.box_as_trait,
    }
}

fn mir_pass_inline_prelude_type_arg(argument: MIRPreludeTypeArg, substitutions: [MIRInlineTypeSubstitution]) -> MIRPreludeTypeArg Never! {
    if argument == {
        .Type(ty) -> MIRPreludeTypeArg.Type{ty: mir_pass_inline_type(ty, substitutions)}
        .HostUsize -> MIRPreludeTypeArg.HostUsize
    }
}

fn mir_pass_inline_panic_context(context: MIRPanicContext, maps: MIRInlineMaps) -> MIRPanicContext Never! {
    locals :: loop local in context.locals -> MIRPanicLocal{name: local.name, local: mir_pass_inline_local(maps, local.local)}
    MIRPanicContext{function: context.function, source_line: context.source_line, caret: context.caret, locals: locals}
}

fn mir_pass_inline_optional_panic_context(context: MIRPanicContext?, maps: MIRInlineMaps) -> MIRPanicContext? {
    present :: context ?? return None
    Val(mir_pass_inline_panic_context(present, maps))
}

fn mir_pass_inline_data_plan(plan: MIRDataPlan?, substitutions: [MIRInlineTypeSubstitution]) -> MIRDataPlan? {
    source :: plan ?? return None
    logical :: loop node in source.logical -> {
        columns :: loop column in node.columns -> MIRDataPlanColumn{name: column.name, ty: mir_pass_inline_type(column.ty, substitutions), nullable: column.nullable}
        callable :: node.callable.map(value -> MIRDataPlanCallable{label: value.label, parameter: mir_pass_inline_type(value.parameter, substitutions), result: mir_pass_inline_type(value.result, substitutions), span: value.span})
        MIRDataPlanNode{id: node.id, operation: node.operation, inputs: node.inputs, source: node.source, row_type: mir_pass_inline_type(node.row_type, substitutions), columns: columns, callable: callable, stream: node.stream, span: node.span}
    }
    physical :: loop node in source.physical -> node
    Val(MIRDataPlan{schema_version: source.schema_version, source: source.source, logical: logical, physical: physical, output: source.output, source_span: source.source_span})
}

fn mir_pass_inline_operation(operation: MIROperation, maps: MIRInlineMaps, substitutions: [MIRInlineTypeSubstitution]) -> MIROperation? {
    return if operation == {
        .Parameter(_, _) | .Capture(_) -> None
        .Global(name) -> Val(MIROperation.Global{name: name})
        .Phi(incoming) -> {
            rows :: loop row in incoming -> MIRPhiIncoming{block: mir_pass_inline_block(maps, row.block), value: mir_pass_inline_value(maps, row.value)}
            Val(MIROperation.Phi{incoming: rows})
        }
        .ReadPlace(place) -> Val(MIROperation.ReadPlace{place: mir_pass_inline_place(maps, place)})
        .MovePlace(place) -> Val(MIROperation.MovePlace{place: mir_pass_inline_place(maps, place)})
        .WritePlace(place, value) -> Val(MIROperation.WritePlace{place: mir_pass_inline_place(maps, place), value: mir_pass_inline_value(maps, value)})
        .ReplacePlace(place, value) -> Val(MIROperation.ReplacePlace{place: mir_pass_inline_place(maps, place), value: mir_pass_inline_value(maps, value)})
        .InitializeUninit(place) -> Val(MIROperation.InitializeUninit{place: mir_pass_inline_place(maps, place)})
        .Copy(value, fact) -> Val(MIROperation.Copy{value: mir_pass_inline_value(maps, value), fact: fact})
        .Move(value) -> Val(MIROperation.Move{value: mir_pass_inline_value(maps, value)})
        .Constant(value) -> Val(MIROperation.Constant{value: value})
        .Unary(op, value) -> Val(MIROperation.Unary{op: op, value: mir_pass_inline_value(maps, value)})
        .Binary(op, dispatch, overflow, left, right) -> Val(MIROperation.Binary{op: op, dispatch: dispatch, overflow: overflow, left: mir_pass_inline_value(maps, left), right: mir_pass_inline_value(maps, right)})
        .BuildString(parts) -> {
            mapped :: loop part in parts -> MIRStringPart{kind: mir_pass_inline_string_part(part.kind, maps)}
            Val(MIROperation.BuildString{parts: mapped})
        }
        .BuildList(values, coercion) -> {
            mapped :: loop value in values -> mir_pass_inline_value(maps, value)
            Val(MIROperation.BuildList{values: mapped, trait_coercion: coercion})
        }
        .BuildMap(entries) -> {
            mapped :: loop entry in entries -> MIRMapEntry{key: mir_pass_inline_value(maps, entry.key), value: mir_pass_inline_value(maps, entry.value)}
            Val(MIROperation.BuildMap{entries: mapped})
        }
        .EnumIs(subject, owner, variant) -> Val(MIROperation.EnumIs{subject: mir_pass_inline_value(maps, subject), owner: owner, variant: variant})
        .EnumPayload(subject, owner, variant, index) -> Val(MIROperation.EnumPayload{subject: mir_pass_inline_value(maps, subject), owner: owner, variant: variant, index: index})
        .OptionIsSome(subject) -> Val(MIROperation.OptionIsSome{subject: mir_pass_inline_value(maps, subject)})
        .OptionValue(subject) -> Val(MIROperation.OptionValue{subject: mir_pass_inline_value(maps, subject)})
        .ResultIsOk(subject) -> Val(MIROperation.ResultIsOk{subject: mir_pass_inline_value(maps, subject)})
        .ResultValue(subject, ok) -> Val(MIROperation.ResultValue{subject: mir_pass_inline_value(maps, subject), ok: ok})
        .PatternCapture(matched, index) -> Val(MIROperation.PatternCapture{matched: mir_pass_inline_value(maps, matched), index: index})
        .PatternMatched(matched) -> Val(MIROperation.PatternMatched{matched: mir_pass_inline_value(maps, matched)})
        .ProjectMembers(base, members) -> Val(MIROperation.ProjectMembers{base: mir_pass_inline_value(maps, base), members: members})
        .Index(call, base, index, kind, access, location, context) -> Val(MIROperation.Index{call: call, base: mir_pass_inline_value(maps, base), index: mir_pass_inline_value(maps, index), kind: kind, access: access, location: location, context: mir_pass_inline_panic_context(context, maps)})
        .Slice(call, base, start, end, range, location) -> Val(MIROperation.Slice{call: call, base: mir_pass_inline_value(maps, base), start: mir_pass_inline_value(maps, start), end: mir_pass_inline_value(maps, end), range: mir_pass_inline_optional_value(maps, range), location: location})
        .Range(start, end, exclusive) -> Val(MIROperation.Range{start: mir_pass_inline_value(maps, start), end: mir_pass_inline_value(maps, end), exclusive: exclusive})
        .Field(base, field) -> Val(MIROperation.Field{base: mir_pass_inline_value(maps, base), field: field})
        .Struct(type_id, fields) -> Val(MIROperation.Struct{type_id: type_id, fields: mir_pass_inline_field_values(fields, maps)})
        .Enum(type_id, variant, args) -> {
            mapped :: loop argument in args -> MIREnumArg{field: argument.field, value: mir_pass_inline_value(maps, argument.value), boxed: argument.boxed}
            Val(MIROperation.Enum{type_id: type_id, variant: variant, args: mapped})
        }
        .Tuple(type_id, fields) -> Val(MIROperation.Tuple{type_id: type_id, fields: mir_pass_inline_field_values(fields, maps)})
        .Present(value) -> Val(MIROperation.Present{value: mir_pass_inline_value(maps, value)})
        .Convert(value, parameters, target, conversion) -> {
            mapped :: loop parameter in parameters -> mir_pass_inline_value(maps, parameter)
            Val(MIROperation.Convert{value: mir_pass_inline_value(maps, value), parameters: mapped, target: mir_pass_inline_type(target, substitutions), conversion: mir_pass_inline_conversion(conversion, substitutions)})
        }
        .TraitBox(value, target) -> Val(MIROperation.TraitBox{value: mir_pass_inline_value(maps, value), target: target})
        .Absent -> Val(MIROperation.Absent)
        .ResultOk(value) -> Val(MIROperation.ResultOk{value: mir_pass_inline_value(maps, value)})
        .ResultErr(value) -> Val(MIROperation.ResultErr{value: mir_pass_inline_value(maps, value)})
        .Call(callee, args, type_args) -> {
            mapped_args :: loop argument in args -> mir_pass_inline_call_arg(argument, maps, substitutions)
            mapped_types :: loop ty in type_args -> mir_pass_inline_type(ty, substitutions)
            Val(MIROperation.Call{callee: mir_pass_inline_callee(callee, maps, substitutions), args: mapped_args, type_args: mapped_types})
        }
        .IndirectCall(callee, args, type_args) -> {
            mapped_args :: loop argument in args -> mir_pass_inline_call_arg(argument, maps, substitutions)
            mapped_types :: loop ty in type_args -> mir_pass_inline_type(ty, substitutions)
            Val(MIROperation.IndirectCall{callee: mir_pass_inline_value(maps, callee), args: mapped_args, type_args: mapped_types})
        }
        .Closure(function, captures, facts) -> {
            mapped :: loop capture in captures -> mir_pass_inline_capture(capture, maps)
            Val(MIROperation.Closure{function: function, captures: mapped, facts: facts})
        }
        .PtrFromAddr(address, element) -> Val(MIROperation.PtrFromAddr{address: mir_pass_inline_value(maps, address), element: mir_pass_inline_type(element, substitutions)})
        .Deref(value) -> Val(MIROperation.Deref{value: mir_pass_inline_value(maps, value)})
        .AddressOf(place, access) -> Val(MIROperation.AddressOf{place: mir_pass_inline_place(maps, place), access: access})
        .RawAddressOf(place) -> Val(MIROperation.RawAddressOf{place: mir_pass_inline_place(maps, place)})
        .CoreCall(call, route, args, type_args, fallibility, plan) -> {
            mapped_args :: loop argument in args -> mir_pass_inline_call_arg(argument, maps, substitutions)
            mapped_types :: loop ty in type_args -> mir_pass_inline_type(ty, substitutions)
            Val(MIROperation.CoreCall{call: call, route: route, args: mapped_args, type_args: mapped_types, fallibility: mir_pass_inline_fallibility(fallibility, substitutions), data_plan: mir_pass_inline_data_plan(plan, substitutions)})
        }
        .AttachTag(value, tag_name) -> Val(MIROperation.AttachTag{value: mir_pass_inline_value(maps, value), tag: tag_name})
        .Todo(call, location, expected_type) -> Val(MIROperation.Todo{call: call, location: location, expected_type: mir_pass_inline_optional_type(expected_type, substitutions)})
        .Never(reason) -> Val(MIROperation.Never{reason: reason})
        .Semantic(semantic) -> Val(MIROperation.Semantic{operation: mir_pass_inline_semantic(semantic, maps, substitutions)})
        .LoopRangeInit(call, start, end, step, exclusive) -> Val(MIROperation.LoopRangeInit{call: call, start: mir_pass_inline_value(maps, start), end: mir_pass_inline_value(maps, end), step: mir_pass_inline_optional_value(maps, step), exclusive: exclusive})
        .LoopRangeHasNext(call, cursor) -> Val(MIROperation.LoopRangeHasNext{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .LoopRangeValue(call, cursor) -> Val(MIROperation.LoopRangeValue{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .LoopRangeAdvance(call, cursor) -> Val(MIROperation.LoopRangeAdvance{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .LoopIterInit(call, collection, step, by_value, source_kind) -> Val(MIROperation.LoopIterInit{call: call, collection: mir_pass_inline_value(maps, collection), step: mir_pass_inline_optional_value(maps, step), by_value: by_value, source_kind: source_kind})
        .LoopIterHasNext(call, cursor) -> Val(MIROperation.LoopIterHasNext{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .LoopIterValue(call, cursor) -> Val(MIROperation.LoopIterValue{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .LoopIterAdvance(call, cursor) -> Val(MIROperation.LoopIterAdvance{call: call, cursor: mir_pass_inline_value(maps, cursor)})
        .ScopeEnter(scope, member) -> Val(MIROperation.ScopeEnter{scope: mir_pass_inline_scope(maps, scope), test_member: mir_pass_inline_optional_test_scope_member(member, maps)})
        .ScopeExit(scope) -> Val(MIROperation.ScopeExit{scope: mir_pass_inline_scope(maps, scope)})
        .Drop(value, kind) -> Val(MIROperation.Drop{value: mir_pass_inline_value(maps, value), kind: kind})
    }
}

fn mir_pass_inline_string_part(part: MIRStringPartKind, maps: MIRInlineMaps) -> MIRStringPartKind Never! {
    if part == {
        .Literal(text) -> MIRStringPartKind.Literal{text: text}
        .Interpolation(value, format) -> MIRStringPartKind.Interpolation{value: mir_pass_inline_value(maps, value), format: format}
    }
}

fn mir_pass_inline_field_values(fields: [MIRFieldValue], maps: MIRInlineMaps) -> [MIRFieldValue] Never! {
    output :: loop field in fields -> MIRFieldValue{field: field.field, value: mir_pass_inline_value(maps, field.value)}
    output
}

fn mir_pass_inline_capture(capture: MIRCaptureOperand, maps: MIRInlineMaps) -> MIRCaptureOperand Never! {
    if capture == {
        .Value(value) -> MIRCaptureOperand.Value{value: mir_pass_inline_value(maps, value)}
        .Place(place) -> MIRCaptureOperand.Place{place: mir_pass_inline_place(maps, place)}
    }
}

fn mir_pass_inline_test_scope_member(member: MIRTestScopeMember, maps: MIRInlineMaps) -> MIRTestScopeMember Never! {
    if member == {
        .ExpectFail(code) -> MIRTestScopeMember.ExpectFail{expected_code: code}
        .Timeout(duration) -> MIRTestScopeMember.Timeout{duration: mir_pass_inline_value(maps, duration)}
        .Skip(whole_test) -> MIRTestScopeMember.Skip{whole_test: whole_test}
        .Measure -> MIRTestScopeMember.Measure
    }
}

fn mir_pass_inline_optional_test_scope_member(member: MIRTestScopeMember?, maps: MIRInlineMaps) -> MIRTestScopeMember? {
    present :: member ?? return None
    Val(mir_pass_inline_test_scope_member(present, maps))
}

fn mir_pass_inline_semantic(operation: MIRSemanticOp, maps: MIRInlineMaps, substitutions: [MIRInlineTypeSubstitution]) -> MIRSemanticOp Never! {
    if operation == {
        .DataEntriesToMap(call, local) -> MIRSemanticOp.DataEntriesToMap{call: call, local: mir_pass_inline_local(maps, local)}
        .MathBuiltin(type_id, call, args) -> MIRSemanticOp.MathBuiltin{type_id: type_id, call: call, args: mir_pass_inline_values(args, maps)}
        .PreciseBuiltin(type_id, call, args) -> MIRSemanticOp.PreciseBuiltin{type_id: type_id, call: call, args: mir_pass_inline_values(args, maps)}
        .Print(call, value) -> MIRSemanticOp.Print{call: call, value: mir_pass_inline_value(maps, value)}
        .AmbientInput(call, prompt) -> MIRSemanticOp.AmbientInput{call: call, prompt: mir_pass_inline_optional_value(maps, prompt)}
        .RequireStop(call, kind, condition, location, context, values, always_stops) -> MIRSemanticOp.RequireStop{call: call, kind: kind, condition: mir_pass_inline_optional_value(maps, condition), location: location, context: mir_pass_inline_panic_context(context, maps), values: mir_pass_inline_values(values, maps), always_stops: always_stops}
        .LayoutCompare(call, op, left, right) -> MIRSemanticOp.LayoutCompare{call: call, op: op, left: mir_pass_inline_value(maps, left), right: mir_pass_inline_value(maps, right)}
        .ReflectOf(type_name, path, display, fields) -> {
            mapped :: loop field in fields -> MIRReflectField{name: field.name, type_name: field.type_name, path: field.path, value: mir_pass_inline_value(maps, field.value)}
            MIRSemanticOp.ReflectOf{type_name: type_name, path: path, display: mir_pass_inline_value(maps, display), fields: mapped}
        }
        .LayoutLiteral(inner) -> MIRSemanticOp.LayoutLiteral{inner: mir_pass_inline_value(maps, inner)}
        .StructLiteral(type_id, fields, extra, trait_coercion, boxed_fields) -> MIRSemanticOp.StructLiteral{type_id: type_id, fields: mir_pass_inline_field_values(fields, maps), extra: extra, trait_coercion: trait_coercion, boxed_fields: boxed_fields}
        .CellGuardProject(map_call, split_call, guard, paths, editable, disjoint) -> MIRSemanticOp.CellGuardProject{map_call: map_call, split_call: split_call, guard: mir_pass_inline_value(maps, guard), paths: paths, editable: editable, edit_paths_disjoint: disjoint}
        .SharedGuardMap(call, guard, path, editable) -> MIRSemanticOp.SharedGuardMap{call: call, guard: mir_pass_inline_value(maps, guard), path: path, editable: editable}
        .SharedGuardSplit(call, map_call, guard, first, second, editable) -> MIRSemanticOp.SharedGuardSplit{call: call, map_call: map_call, guard: mir_pass_inline_value(maps, guard), first: first, second: second, editable: editable}
        .SharedGuardWait(call, guard, condition, predicate) -> MIRSemanticOp.SharedGuardWait{call: call, guard: mir_pass_inline_value(maps, guard), condition: mir_pass_inline_value(maps, condition), predicate: mir_pass_inline_value(maps, predicate)}
        .ConditionNotify(call, condition, all) -> MIRSemanticOp.ConditionNotify{call: call, condition: mir_pass_inline_value(maps, condition), all: all}
        .AllocNew(call, kind, inline_size, args) -> MIRSemanticOp.AllocNew{call: call, kind: kind, inline_size: inline_size, args: mir_pass_inline_call_args(args, maps, substitutions)}
        .ColumnarRead(base, index, column, column_index, accessor) -> MIRSemanticOp.ColumnarRead{base: mir_pass_inline_value(maps, base), index: mir_pass_inline_value(maps, index), column: column, column_index: column_index, accessor: accessor}
        .StaticPreludeCall(call, args, owner_type_args, type_args) -> {
            owner_args :: loop argument in owner_type_args -> mir_pass_inline_prelude_type_arg(argument, substitutions)
            mapped_types :: loop ty in type_args -> mir_pass_inline_type(ty, substitutions)
            MIRSemanticOp.StaticPreludeCall{call: call, args: mir_pass_inline_call_args(args, maps, substitutions), owner_type_args: owner_args, type_args: mapped_types}
        }
        .DecodeUnder(call, segment, inner) -> MIRSemanticOp.DecodeUnder{call: call, segment: mir_pass_inline_value(maps, segment), inner: mir_pass_inline_value(maps, inner)}
        .HardwareCall(call, op, receiver, args) -> MIRSemanticOp.HardwareCall{call: call, op: mir_pass_inline_hardware_op(op, substitutions), receiver: mir_pass_inline_optional_value(maps, receiver), args: mir_pass_inline_call_args(args, maps, substitutions)}
        .BuiltinMethod(call, receiver, receiver_place, args, aggregate_fields) -> MIRSemanticOp.BuiltinMethod{call: call, receiver: mir_pass_inline_value(maps, receiver), receiver_place: mir_pass_inline_optional_place(maps, receiver_place), args: mir_pass_inline_values(args, maps), aggregate_fields: aggregate_fields}
        .OptionLift2(call, function, left, right) -> MIRSemanticOp.OptionLift2{call: call, function: mir_pass_inline_value(maps, function), left: mir_pass_inline_value(maps, left), right: mir_pass_inline_value(maps, right)}
        .ClosureMethod(receiver, args, call) -> MIRSemanticOp.ClosureMethod{receiver: mir_pass_inline_value(maps, receiver), args: mir_pass_inline_call_args(args, maps, substitutions), call: call}
        .HostBorrowCallback(callable, params) -> {
            mapped :: loop ty in params -> mir_pass_inline_type(ty, substitutions)
            MIRSemanticOp.HostBorrowCallback{callable: mir_pass_inline_value(maps, callable), params: mapped}
        }
        .TextPatternMatch(call, subject, parts) -> MIRSemanticOp.TextPatternMatch{call: call, subject: mir_pass_inline_value(maps, subject), parts: parts}
        .BinaryPatternMatch(call, subject, parts) -> MIRSemanticOp.BinaryPatternMatch{call: call, subject: mir_pass_inline_value(maps, subject), parts: parts}
        .CursorTakePattern(receiver, place, parts) -> MIRSemanticOp.CursorTakePattern{receiver: mir_pass_inline_value(maps, receiver), receiver_place: mir_pass_inline_place(maps, place), parts: parts}
        .ReaderTakePattern(receiver, place, parts) -> MIRSemanticOp.ReaderTakePattern{receiver: mir_pass_inline_value(maps, receiver), receiver_place: mir_pass_inline_place(maps, place), parts: parts}
        .NumericMethod(call, receiver) -> MIRSemanticOp.NumericMethod{call: call, receiver: mir_pass_inline_value(maps, receiver)}
        .NumericBinaryMethod(call, receiver, argument) -> MIRSemanticOp.NumericBinaryMethod{call: call, receiver: mir_pass_inline_value(maps, receiver), argument: mir_pass_inline_value(maps, argument)}
        .OverflowOption(call, left, right, location) -> MIRSemanticOp.OverflowOption{call: call, left: mir_pass_inline_value(maps, left), right: mir_pass_inline_value(maps, right), location: location}
        .HandleMethod(call, receiver, args, schedule, derivation) -> MIRSemanticOp.HandleMethod{call: call, receiver: mir_pass_inline_value(maps, receiver), args: mir_pass_inline_values(args, maps), frame_schedule: schedule, frame_schedule_derivation: derivation}
        .PluginInvoke(call, handle, export_name, signature, args) -> MIRSemanticOp.PluginInvoke{call: call, handle: mir_pass_inline_value(maps, handle), export_name: export_name, signature: signature, args: mir_pass_inline_values(args, maps)}
        .HTTPRouterRegister(call, receiver, path, handler, method, names, contract, location) -> MIRSemanticOp.HTTPRouterRegister{call: call, receiver: mir_pass_inline_value(maps, receiver), path: mir_pass_inline_value(maps, path), handler: mir_pass_inline_value(maps, handler), method: method, handler_param_names: names, contract_json: contract, location: location}
        .CoreClosureCall(call, kind, values, closure, site, label) -> MIRSemanticOp.CoreClosureCall{call: call, kind: kind, values: mir_pass_inline_values(values, maps), closure: mir_pass_inline_optional_value(maps, closure), site: site, label: label}
        .TaskGroup(call, kind, tasks) -> MIRSemanticOp.TaskGroup{call: call, kind: kind, tasks: mir_pass_inline_values(tasks, maps)}
        .Select(call, kind, values) -> MIRSemanticOp.Select{call: call, kind: kind, values: mir_pass_inline_values(values, maps)}
        .PolicyFunction(policy, values) -> MIRSemanticOp.PolicyFunction{policy: mir_pass_inline_value(maps, policy), values: mir_pass_inline_values(values, maps)}
        .InterruptFunction(interrupt, values) -> MIRSemanticOp.InterruptFunction{interrupt: mir_pass_inline_value(maps, interrupt), values: mir_pass_inline_values(values, maps)}
        .CarrierFact(call, receiver, field, notes) -> MIRSemanticOp.CarrierFact{call: call, receiver: mir_pass_inline_value(maps, receiver), field: field, notes: notes}
        .GCEdit(call, root, edges, edit, index, kind, site) -> MIRSemanticOp.GCEdit{call: call, root: mir_pass_inline_value(maps, root), edges: mir_pass_inline_values(edges, maps), edit: mir_pass_inline_value(maps, edit), index: mir_pass_inline_optional_value(maps, index), kind: kind, site: site}
        .TypedTextInterp(call, kind, literals, holes, trusted_html) -> MIRSemanticOp.TypedTextInterp{call: call, kind: kind, literals: literals, holes: mir_pass_inline_values(holes, maps), trusted_html: trusted_html}
        .CCallback(call, callback, lambda) -> MIRSemanticOp.CCallback{call: call, callback: callback, lambda: mir_pass_inline_value(maps, lambda)}
        .HostCall(call, args) -> MIRSemanticOp.HostCall{call: call, args: mir_pass_inline_call_args(args, maps, substitutions)}
    }
}

fn mir_pass_inline_values(values: [MIRValueID], maps: MIRInlineMaps) -> [MIRValueID] Never! {
    output :: loop value in values -> mir_pass_inline_value(maps, value)
    output
}

fn mir_pass_inline_call_args(args: [MIRCallArg], maps: MIRInlineMaps, substitutions: [MIRInlineTypeSubstitution]) -> [MIRCallArg] Never! {
    output :: loop argument in args -> mir_pass_inline_call_arg(argument, maps, substitutions)
    output
}

fn mir_pass_inline_hardware_op(operation: MIRHardwareOp, substitutions: [MIRInlineTypeSubstitution]) -> MIRHardwareOp Never! {
    if operation == {
        .RegisterRead(profile, block, register, width) -> MIRHardwareOp.RegisterRead{profile_id: profile, block: block, register: register, width: width}
        .RegisterWrite(profile, block, register, width) -> MIRHardwareOp.RegisterWrite{profile_id: profile, block: block, register: register, width: width}
        .DMAStart(profile, channel, buffer_ty) -> MIRHardwareOp.DMAStart{profile_id: profile, channel: channel, buffer_ty: mir_pass_inline_type(buffer_ty, substitutions)}
        .DMAWait(profile, channel, buffer_ty) -> MIRHardwareOp.DMAWait{profile_id: profile, channel: channel, buffer_ty: mir_pass_inline_type(buffer_ty, substitutions)}
    }
}
