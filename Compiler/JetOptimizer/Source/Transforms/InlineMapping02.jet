    loop block in callee.blocks -> ids.blocks[block.id] = MIRBlockID{value: inline_fresh_id(&used_blocks, "mir-inline-block", identity("block", block.id.value, 0))}
    loop local in callee.locals -> ids.locals[local.id] = MIRLocalID{value: inline_fresh_id(&used_locals, "mir-inline-local", identity("local", local.id.value, 0))}
    loop scope in callee.scopes -> ids.scopes[scope.id] = MIRScopeID{value: inline_fresh_id(&used_scopes, "mir-inline-scope", identity("scope", scope.id.value, 0))}
    parameter_indexes := [MIRValueID:Int]{}
    loop (index, value) in parameter_values -> parameter_indexes[value] = index
    caller_places := [MIRPlaceID:@MIRPlace]{}
