// Rust: crates/jet-foundation/src/MIROptimization.rs:4715
pub fn optimize_mir_program(program: ^MIRProgram, policy: MirOptimizationPolicy) -> MIRProgram MIROptimizationError! {
    _ :: policy
    before_payload :: if canonical_pass_enabled() -> Val(mir_canonical_payload(program)) else -> None
    before_identity :: if canonical_pass_enabled() -> Val(mir_canonical_identity(program)) else -> None
    if verify_mir_legality(program) == .Err(error) -> return Err(MIROptimizationError.Legality{pass: .LegalityVerification, error: error})
    record_canonical_check("mir.legality-verification", "crates/jet-foundation/src/MIROptimization.rs", program)
    complete := true
    loop function in program.functions {
        if function.optimization.pass_ids != MIR_OPTIMIZATION_PASS_ORDER || function.optimization.derived_from_digest == None { complete = false; break }
    }
    if complete -> complete = optimized_pass_order_complete(program, mir_program_digest(program))
    optimized := ^program
    if complete {
        run_canonical_pass("mir.fixed-reduction-normalization", "crates/jet-foundation/src/MIROptimization.rs", &optimized, normalize_fixed_reduction_loops)
        run_canonical_pass("mir.acceleration-facts", "crates/jet-foundation/src/MIROptimization.rs", &optimized, refresh_acceleration_facts)
        validate_after(optimized, .CanonicalLoopFacts)
        seal_derived_facts(&optimized)
        record_canonical_transition("mir.optimize-pipeline", "crates/jet-foundation/src/MIROptimization.rs", before_payload, before_identity, optimized)
        return ^optimized
    }
    previous_loop_facts :: loop function in optimized.functions -> function.optimization.loop_facts
    clear_derived_facts(&optimized)
    run_canonical_pass("mir.inline-always", "crates/jet-foundation/src/MIROptimization.rs", &optimized, expand_inline_always)
    mark_pass(&optimized, .LegalityVerification)
    validate_after(optimized, .LegalityVerification)
    run_canonical_pass("mir.unreachable-block-elimination", "crates/jet-foundation/src/MIROptimization.rs", &optimized, eliminate_unreachable_blocks)
    mark_pass(&optimized, .UnreachableBlockElimination)
    validate_after(optimized, .UnreachableBlockElimination)
    run_canonical_pass("mir.cfg-simplification", "crates/jet-foundation/src/MIROptimization.rs", &optimized, simplify_cfg)
    mark_pass(&optimized, .CFGSimplification)
    validate_after(optimized, .CFGSimplification)
    run_canonical_pass("mir.exact-constant-folding", "crates/jet-foundation/src/MIROptimization.rs", &optimized, fold_exact_constants)
    mark_pass(&optimized, .ExactConstantFolding)
    validate_after(optimized, .ExactConstantFolding)
    run_canonical_pass("mir.bounds-check-elimination", "crates/jet-foundation/src/MIROptimization.rs", &optimized, derive_bounds_facts)
    mark_pass(&optimized, .BoundsCheckElimination)
    validate_after(optimized, .BoundsCheckElimination)
    run_canonical_pass("mir.dead-pure-value-elimination", "crates/jet-foundation/src/MIROptimization.rs", &optimized, eliminate_dead_pure_values)
    mark_pass(&optimized, .DeadPureValueElimination)
    validate_after(optimized, .DeadPureValueElimination)
    run_canonical_pass("mir.canonical-loop-facts", "crates/jet-foundation/src/MIROptimization.rs", &optimized, program -> derive_loop_and_vector_facts(&program, previous_loop_facts))
    run_canonical_pass("mir.fixed-reduction-normalization", "crates/jet-foundation/src/MIROptimization.rs", &optimized, normalize_fixed_reduction_loops)
    normalize_fixed_reduction_loops(&optimized)
    post_reduction_loop_facts :: loop function in optimized.functions -> function.optimization.loop_facts
    derive_loop_and_vector_facts(&optimized, post_reduction_loop_facts)
    normalize_fixed_reduction_loops(&optimized)
    mark_pass(&optimized, .CanonicalLoopFacts)
    validate_after(optimized, .CanonicalLoopFacts)
    run_canonical_pass("mir.acceleration-facts", "crates/jet-foundation/src/MIROptimization.rs", &optimized, refresh_acceleration_facts)
    validate_after(optimized, .CanonicalLoopFacts)
    run_canonical_pass("mir.canonical-program-order", "crates/jet-foundation/src/MIROptimization.rs", &optimized, canonicalize_program_order)
    validate_after(optimized, .CanonicalLoopFacts)
    seal_derived_facts(&optimized)
    record_canonical_transition("mir.optimize-pipeline", "crates/jet-foundation/src/MIROptimization.rs", before_payload, before_identity, optimized)
    ^optimized
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:4884
pub fn decision_ledger_rows(program: MIRProgram) -> [MIRDecisionRow] Never! {
    rows := [MIRDecisionRow]{}
    loop function in program.functions {
        loop row in function.optimization.decision_rows -> &rows.push(row)
        if function.is_inline || function.is_inline_always {
            rule :: if function.is_inline_always -> "#Inline(Always)" else -> "#Inline"
            &rows.push(MIRDecisionRow.new(.Inline, .Selected, Val(function.id), function.key, function.span, rule, "the checked function carries this inline contract", "mir.inline", "checked-function-metadata"))
        }
        if function.kernel_proof == .Val(kernel) {
            proven :: kernel.bounds && kernel.alias_free && kernel.captures && kernel.race_free && kernel.barriers_uniform && kernel.control_flow
            disposition :: if proven -> MIRDecisionDisposition.Accepted else -> MIRDecisionDisposition.Rejected
            reason :: if proven -> "the checked kernel satisfies the parallel safety proof" else -> "the checked kernel does not satisfy every parallel safety obligation"
            &rows.push(MIRDecisionRow.new(.Parallel, disposition, Val(function.id), function.key, function.span, "kernel-parallel", reason, "sema.kernel-proof", "static-legality-proof"))
        }
        loop fact in function.optimization.loop_facts {
            disposition :: if fact.copy_cost == { .NoCopy -> MIRDecisionDisposition.NotAttempted; .PerIteration(_) -> MIRDecisionDisposition.Selected; .Unknown -> MIRDecisionDisposition.Unavailable }
            reason :: if fact.copy_cost == { .NoCopy -> "no loop copy was required by the checked ownership fact"; .PerIteration(count) -> if count == 1 -> "the compiler inserted one copy per iteration" else -> "the compiler inserted copies per iteration"; .Unknown -> "the compiler has no bounded copy-cost fact" }
            &rows.push(MIRDecisionRow.new(.Copy, disposition, Val(function.id), function.key, fact.span, "loop-copy-cost", reason, "mir.loop-facts", "static-cost-fact"))
        }
        loop bounds in function.optimization.bounds_facts {
            disposition :: if bounds.proven && bounds.elided -> MIRDecisionDisposition.Accepted else if bounds.proven -> MIRDecisionDisposition.Rejected else -> MIRDecisionDisposition.NotAttempted
            reason :: if bounds.proven && bounds.elided -> "the checked bounds proof permits elision" else if bounds.proven -> "the bounds proof is present but the failure check is retained" else -> "no checked bounds proof is available for this access"
            &rows.push(MIRDecisionRow.new(.Bounds, disposition, Val(function.id), function.key, bounds.span, "bounds-check-elimination", reason, "mir.bounds", "static-legality-proof"))
        }
        loop vector in function.optimization.vector_facts {
            disposition :: if vector.decision == .Eligible -> MIRDecisionDisposition.Accepted else -> MIRDecisionDisposition.Rejected
            reason :: if vector.decision == { .Eligible -> "the {vector.rule.as_str()} vector proof was accepted"; .Rejected(rejection) -> if vector.rule == .Reduction && vector.fixed_reduction == None -> "strict-order reduction proof was not accepted" else -> "vector proof rejected: {rejection.as_str()}" }
            &rows.push(MIRDecisionRow.new(.Vectorize, disposition, Val(function.id), function.key, vector.span, vector.rule.as_str(), reason, "mir.vector-proof", "static-legality-proof"))
        }
    }
    loop unreachable in program.unreachable {
        reason :: if unreachable.reason == { .CompileTimeOnly -> "compiletimeonly"; .Disabled -> "disabled"; .ExpandedBeforeLowering -> "expandedbeforelowering"; .SemanticIndexOnly -> "semanticindexonly" }
        &rows.push(MIRDecisionRow.new(.Unreachable, .Selected, None, "", unreachable.span, unreachable.construct, reason, "tir.erasure", "static-control-flow-fact"))
    }
    &rows.sort_by((left, right) -> {
        if left.span.start != right.span.start -> return left.span.start.compare(right.span.start)
        if left.span.end != right.span.end -> return left.span.end.compare(right.span.end)
        if left.kind != right.kind -> return left.kind.compare(right.kind)
        if left.function_name != right.function_name -> return left.function_name.compare(right.function_name)
        left.id.compare(right.id)
    })
    ^rows
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5059
pub fn decision_ledger(program: MIRProgram, artifact: MIRArtifactID?, profile: String, run: String, additional_rows: ^[MIRDecisionRow]) -> MIRDecisionLedger Never! {
    identity :: MIRDecisionIdentity.from_program(program, artifact, profile, run)
    rows := decision_ledger_rows(program)
    loop row in ^additional_rows -> &rows.push(^row)
    MIRDecisionLedger.from_rows(identity, ^rows)
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5077
fn expand_inline_always(program: &MIRProgram) Never! {
    function_indices := [MIRFunctionID:Int]{}
    eligible := [MIRFunctionID:Bool]{}
    loop (index, function) in program.functions {
        if !function_indices.contains_key(function.id) {
            function_indices[function.id] = index
            if function.is_inline_always -> eligible[function.id] = true
        }
    }
    if eligible.len() == 0 -> return
    pending := loop function in program.functions -> inline_candidates(function, eligible)
    callers := [Int]{}
    loop (index, candidates) in pending { if candidates.len() > 0 -> &callers.push(index) }
    loop {
        changed := false
        loop caller_index in callers {
            caller_id :: program.functions[caller_index].id
            site := None
            loop position in pending[caller_index] {
                instruction :: program.functions[caller_index].blocks[position.block].instructions[position.instruction]
                target_id :: inline_target_id(instruction.operation) ?? continue
                callee_index :: function_indices.get(target_id) ?? continue
                callee :: program.functions[callee_index]
                if callee.id == caller_id -> continue
                seen := [MIRFunctionID:Bool]{}
                if inline_path(program, function_indices, eligible, callee.id, caller_id, &seen) -> continue
                &seen.clear()
                if inline_path(program, function_indices, eligible, callee.id, callee.id, &seen) -> continue
                if inline_has_return_drop(callee) -> continue
                site = Val((block: position.block, instruction: position.instruction, call: instruction, callee: callee_index))
                break
            }
            position :: site ?? continue
            callee :: program.functions[position.callee]
            if inline_call(&program.functions[caller_index], callee, position.block, position.instruction, position.call) {
                caller := &program.functions[caller_index]
                &caller.optimization.decision_rows.push(MIRDecisionRow.new(.Inline, .Accepted, Val(caller.id), caller.key, position.call.span, "#Inline(Always)", "expanded checked callee `{callee.key}` into this call site", "mir.inline", "canonical-cfg-transform"))
                pending[caller_index] = inline_candidates(caller, eligible)
                changed = true
                break
            }
        }
        if !changed -> break
    }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5166
fn inline_candidates(caller: MIRFunction, eligible: [MIRFunctionID:Bool]) -> [(block: Int, instruction: Int)] Never! {
    pending := [(block: Int, instruction: Int)]{}
    loop (block_index, block) in caller.blocks {
        loop (instruction_index, instruction) in block.instructions {
            if inline_target_id(instruction.operation) == .Val(id) {
                if eligible.contains_key(id) -> &pending.push((block: block_index, instruction: instruction_index))
            }
        }
    }
    ^pending
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5181
fn inline_has_return_drop(callee: MIRFunction) -> Bool Never! {
    loop drop in callee.drops { if drop.edge == .Return -> return true }
    false
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5188
fn inline_target_id(operation: MIROperation) -> MIRFunctionID? Never! {
    if operation == .Call(callee, _, _) {
        if callee == { .User(id) | .Associated(id, _) | .Method(id, _) -> return Val(id); else -> {} }
    }
    None
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5200
fn inline_path(program: MIRProgram, function_indices: [MIRFunctionID:Int], eligible: [MIRFunctionID:Bool], current: MIRFunctionID, wanted: MIRFunctionID, seen: &[MIRFunctionID:Bool]) -> Bool Never! {
    if seen.contains_key(current) -> return false
    seen[current] = true
    index :: function_indices.get(current) ?? return false
    loop block in program.functions[index].blocks {
        loop instruction in block.instructions {
            target :: inline_target_id(instruction.operation) ?? continue
            if !eligible.contains_key(target) -> continue
            if target == wanted || inline_path(program, function_indices, eligible, target, wanted, &seen) -> return true
        }
    }
    false
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5232
// GATE #4499: MIR identity newtypes retain exact composite-key equality/hash.
struct InlineIdMaps {
    values: [MIRValueID:MIRValueID]
    blocks: [MIRBlockID:MIRBlockID]
    locals: [MIRLocalID:MIRLocalID]
    places: [MIRPlaceID:MIRPlaceID]
    scopes: [MIRScopeID:MIRScopeID]
}
impl InlineIdMaps {
    fn default() -> InlineIdMaps Never! { InlineIdMaps{values: [:], blocks: [:], locals: [:], places: [:], scopes: [:]} }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5240
fn inline_call(caller: &MIRFunction, callee: MIRFunction, block_index: Int, instruction_index: Int, call_instruction: MIRInstruction) -> Bool Never! {
    call :: if call_instruction.operation == .Call(call_callee, args, type_args) -> (callee: call_callee, args: args, types: type_args) else -> return false
    args :: call.args
    if inline_target_id(call_instruction.operation) != Val(callee.id) || inline_has_return_drop(callee) || callee.capture_params.len() != 0 || (caller.generator == None && callee.generator != None) || block_index >= caller.blocks.len() || instruction_index >= caller.blocks[block_index].instructions.len() -> return false
    substitutions := [String:MIRType]{}
    if callee.generic_params.len() > 0 {
        if callee.generic_params.len() != call.types.len() -> return false
        loop (index, parameter) in callee.generic_params -> substitutions[parameter.name] = call.types[index]
    }
    if args.len() != callee.params.len() -> return false
    return_type :: inline_type(callee.return_type, substitutions)
    if call_instruction.ty == .Val(ty) { if !mir_type_same_checked_type(ty, return_type) -> return false }
    caller_values := [MIRValueID:@MIRValueFact]{}
    loop fact in caller.values -> caller_values[fact.id] = @fact
    loop (index, argument) in args {
        fact :: caller_values.get(argument.value) ?? return false
        if !mir_type_same_checked_type(fact.ty, inline_type(callee.params[index].ty, substitutions)) -> return false
        if argument.fn_coercion != None || argument.widen_fixed_to_list || argument.widen_to_union != None || argument.box_as_trait != None || argument.authority_boundary -> return false
    }
    reachable :: reachable_blocks(callee)
    reachable_returns := 0
    loop block in callee.blocks {
        if reachable.contains_key(block.id) && block.terminator == .Return(_) -> reachable_returns += 1
    }
    if reachable_returns == 0 && call_instruction.result != None -> return false
    used_values := [U64:Bool]{}
    used_operations := [U64:Bool]{}
    used_blocks := [U64:Bool]{}
    used_locals := [U64:Bool]{}
    used_places := [U64:Bool]{}
    used_scopes := [U64:Bool]{}
    loop value in caller.values -> used_values[value.id.value] = true
    loop block in caller.blocks {
        used_blocks[block.id.value] = true
        loop instruction in block.instructions -> used_operations[instruction.id.value] = true
    }
    loop local in caller.locals -> used_locals[local.id.value] = true
    loop place in caller.places -> used_places[place.id.value] = true
    loop scope in caller.scopes -> used_scopes[scope.id.value] = true
    identity :: (kind: String, source: U64, ordinal: Int) -> "caller={caller.id.value}:call={call_instruction.id.value}:callee={callee.id.value}:kind={kind}:source={source}:ordinal={ordinal}"
    original_block :: caller.blocks[block_index]
    adapted_values := [MIRValueFact]{}
    adapted_arguments := [MIRValueID]{}
    adapters := [MIRInstruction]{}
    loop (ordinal, argument) in args {
        fact :: caller_values.get(argument.value) ?? return false
        adapted := argument.value
        if argument.implicit_clone || argument.shared_auto_clone || call_arg_consumes(argument) {
            clone :: argument.implicit_clone || argument.shared_auto_clone
            value :: MIRValueID{value: inline_fresh_id(&used_values, "mir-inline-value", identity(if clone -> "clone" else -> "move", argument.value.value, ordinal))}
            op :: MIROpID{value: inline_fresh_id(&used_operations, "mir-inline-op", identity(if clone -> "clone-op" else -> "move-op", argument.value.value, ordinal))}
            ownership := fact.ownership
            ownership.moved = false
            ownership.last_use = false
            &adapted_values.push(MIRValueFact{id: value, ty: fact.ty, span: fact.span, ownership: ownership})
            operation :: if clone -> MIROperation.Copy{value: argument.value, fact: mir_copy_fact_for_ownership(if argument.shared_auto_clone -> MIRCopyFact.Share else -> MIRCopyFact.Materialize, fact.ownership.mode)} else -> MIROperation.Move{value: argument.value}
            &adapters.push(MIRInstruction{id: op, span: fact.span, source_line: None, result: Val(value), ty: Val(fact.ty), operation: operation})
            adapted = value
        }
        &adapted_arguments.push(adapted)
    }
    prefix := original_block.instructions[0..<instruction_index]
    loop adapter in ^adapters -> &prefix.push(^adapter)
    suffix :: original_block.instructions[instruction_index + 1..<original_block.instructions.len()]
    ids := InlineIdMaps.default()
    parameter_values := [Int:MIRValueID]{}
    loop block in callee.blocks {
        loop instruction in block.instructions {
            if instruction.operation == .Parameter(index, _) {
                value :: instruction.result ?? return false
                if parameter_values.contains_key(index) -> return false
                parameter_values[index] = value
            }
        }
    }
    if parameter_values.len() != callee.params.len() -> return false
    loop (index, adapted) in adapted_arguments {
