}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5796
fn inline_fresh_id(used: &[U64:Bool], namespace: String, identity: String) -> U64 Never! {
    salt := U64{0}
    loop {
        id :: stable_id(namespace, "{identity}:salt={salt}")
        if !used.contains_key(id) { used[id] = true; return id }
        salt = salt.saturating_add(U64{1})
    }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5808
fn inline_value(ids: InlineIdMaps, value: MIRValueID) -> MIRValueID Never! { ids.values.get(value) ?? value }
// Rust: crates/jet-foundation/src/MIROptimization.rs:5812
fn inline_block(ids: InlineIdMaps, block: MIRBlockID) -> MIRBlockID Never! { ids.blocks.get(block) ?? block }
// Rust: crates/jet-foundation/src/MIROptimization.rs:5816
fn inline_local(ids: InlineIdMaps, local: MIRLocalID) -> MIRLocalID Never! { ids.locals.get(local) ?? local }
// Rust: crates/jet-foundation/src/MIROptimization.rs:5820
fn inline_place(ids: InlineIdMaps, place: MIRPlaceID) -> MIRPlaceID Never! { ids.places.get(place) ?? place }
// Rust: crates/jet-foundation/src/MIROptimization.rs:5824
fn inline_scope(ids: InlineIdMaps, scope: MIRScopeID) -> MIRScopeID Never! { ids.scopes.get(scope) ?? scope }
// Rust: crates/jet-foundation/src/MIROptimization.rs:5828
fn inline_context(ids: InlineIdMaps, context: MIRPanicContext) -> MIRPanicContext Never! {
    locals :: loop local in context.locals -> MIRPanicLocal{name: local.name, local: inline_local(ids, local.local)}
    MIRPanicContext{function: context.function, source_line: context.source_line, caret: context.caret, locals: locals}
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5841
fn inline_projection(projection: MIRProjection, ids: InlineIdMaps) -> MIRProjection Never! {
    if projection == {
        .Field(field, span) -> MIRProjection.Field{field: field, span: span}
        .Index(kind, index, call, write_call, location, context, span) -> MIRProjection.Index{kind: kind, index: inline_value(ids, index), call: call, write_call: write_call, location: location, context: context.map(value -> inline_context(ids, value)), span: span}
        .Deref(span) -> MIRProjection.Deref{span: span}
        .Payload(kind, span) -> MIRProjection.Payload{kind: kind, span: span}
        .Range(range, location, span) -> MIRProjection.Range{range: inline_value(ids, range), location: location, span: span}
    }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5881
fn inline_call_arg(argument: MIRCallArg, ids: InlineIdMaps, substitutions: [String:MIRType]) -> MIRCallArg Never! {
    MIRCallArg{value: inline_value(ids, argument.value), place: argument.place.map(place -> inline_place(ids, place)), access: argument.access, span: argument.span, label: argument.label, source_index: argument.source_index, binder_slot: argument.binder_slot, spread: argument.spread, implicit_clone: argument.implicit_clone, shared_auto_clone: argument.shared_auto_clone, owned_last_use: argument.owned_last_use, authority_boundary: argument.authority_boundary, fn_coercion: argument.fn_coercion.map(coercion -> MIRFnCoercion{ty: inline_type(coercion.ty, substitutions), already_boxed: coercion.already_boxed}), widen_fixed_to_list: argument.widen_fixed_to_list, widen_to_union: argument.widen_to_union, box_as_trait: argument.box_as_trait}
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5909
fn inline_callee(callee: MIRCallee, ids: InlineIdMaps, substitutions: [String:MIRType]) -> MIRCallee Never! {
    if callee == {
        .User(function) -> MIRCallee.User{function: function}
        .Associated(function, owner) -> MIRCallee.Associated{function: function, owner: inline_type(owner, substitutions)}
        .Method(function, owner) -> MIRCallee.Method{function: function, owner: inline_type(owner, substitutions)}
        .TraitMethod(method, trait_ref, receiver) -> MIRCallee.TraitMethod{method: method, trait_ref: trait_ref, receiver: inline_type(receiver, substitutions)}
        .Core(call) -> MIRCallee.Core{call: call}
        .Prelude(call) -> MIRCallee.Prelude{call: call}
        .Foreign(id) -> MIRCallee.Foreign{id: id}
        .Indirect(value) -> MIRCallee.Indirect{value: inline_value(ids, value)}
    }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5940
fn inline_failure_carrier(carrier: MIRFailureCarrier, substitutions: [String:MIRType]) -> MIRFailureCarrier Never! {
    if carrier == { .Infallible -> MIRFailureCarrier.Infallible; .Result(success, error) -> MIRFailureCarrier.Result{success: inline_type(success, substitutions), error: inline_type(error, substitutions)}; .Optional(value) -> MIRFailureCarrier.Optional{value: inline_type(value, substitutions)}; .Diverges(value) -> MIRFailureCarrier.Diverges{value: inline_type(value, substitutions)} }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5959
fn inline_fallibility(fallibility: MIRCallFallibility, substitutions: [String:MIRType]) -> MIRCallFallibility Never! {
    if fallibility == { .Infallible -> MIRCallFallibility.Infallible; .Failure(carrier) -> MIRCallFallibility.Failure{failure: inline_failure_carrier(carrier, substitutions)} }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5971
fn inline_conversion(conversion: MIRConversion, substitutions: [String:MIRType]) -> MIRConversion Never! {
    if conversion == { .Transparent -> MIRConversion.Transparent; .NumericCast -> MIRConversion.NumericCast; .SendFn -> MIRConversion.SendFn; .Prelude(call, location, fallibility) -> MIRConversion.Prelude{call: call, location: location, fallibility: inline_fallibility(fallibility, substitutions)} }
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:5991
fn inline_operation(operation: MIROperation, ids: InlineIdMaps, substitutions: [String:MIRType]) -> MIROperation Never! {
    if operation == {
        .Parameter(index, name) -> MIROperation.Parameter{index: index, name: name}
        .Capture(slot) -> MIROperation.Capture{slot: slot}
        .Global(name) -> MIROperation.Global{name: name}
        .Phi(incoming) -> MIROperation.Phi{incoming: loop row in incoming -> MIRPhiIncoming{block: inline_block(ids, row.block), value: inline_value(ids, row.value)}}
        .ReadPlace(place) -> MIROperation.ReadPlace{place: inline_place(ids, place)}
        .MovePlace(place) -> MIROperation.MovePlace{place: inline_place(ids, place)}
        .WritePlace(place, value) -> MIROperation.WritePlace{place: inline_place(ids, place), value: inline_value(ids, value)}
        .ReplacePlace(place, value) -> MIROperation.ReplacePlace{place: inline_place(ids, place), value: inline_value(ids, value)}
        .InitializeUninit(place) -> MIROperation.InitializeUninit{place: inline_place(ids, place)}
        .Copy(value, fact) -> MIROperation.Copy{value: inline_value(ids, value), fact: fact}
        .Move(value) -> MIROperation.Move{value: inline_value(ids, value)}
        .TraitBox(value, target) -> MIROperation.TraitBox{value: inline_value(ids, value), target: target}
        .Constant(value) -> MIROperation.Constant{value: value}
        .Unary(op, value) -> MIROperation.Unary{op: op, value: inline_value(ids, value)}
        .Binary(op, dispatch, overflow, left, right) -> MIROperation.Binary{op: op, dispatch: dispatch, overflow: overflow, left: inline_value(ids, left), right: inline_value(ids, right)}
        .BuildString(parts) -> MIROperation.BuildString{parts: loop part in parts -> if part == { .Literal(text) -> MIRStringPart.Literal{text: text}; .Value(value) -> MIRStringPart.Value{value: inline_value(ids, value)} }}
        .BuildList(values, trait_coercion) -> MIROperation.BuildList{values: loop value in values -> inline_value(ids, value), trait_coercion: trait_coercion}
        .BuildMap(entries) -> MIROperation.BuildMap{entries: loop entry in entries -> MIRMapEntry{key: inline_value(ids, entry.key), value: inline_value(ids, entry.value)}}
        .EnumIs(subject, owner, variant) -> MIROperation.EnumIs{subject: inline_value(ids, subject), owner: owner, variant: variant}
        .EnumPayload(subject, owner, variant, index) -> MIROperation.EnumPayload{subject: inline_value(ids, subject), owner: owner, variant: variant, index: index}
        .OptionIsSome(subject) -> MIROperation.OptionIsSome{subject: inline_value(ids, subject)}
        .OptionValue(subject) -> MIROperation.OptionValue{subject: inline_value(ids, subject)}
        .ResultIsOk(subject) -> MIROperation.ResultIsOk{subject: inline_value(ids, subject)}
        .ResultValue(subject, ok) -> MIROperation.ResultValue{subject: inline_value(ids, subject), ok: ok}
        .PatternCapture(matched, index) -> MIROperation.PatternCapture{matched: inline_value(ids, matched), index: index}
        .PatternMatched(matched) -> MIROperation.PatternMatched{matched: inline_value(ids, matched)}
        .ProjectMembers(base, members) -> MIROperation.ProjectMembers{base: inline_value(ids, base), members: members}
        .Index(call, base, index, kind, access, location, context) -> MIROperation.Index{call: call, base: inline_value(ids, base), index: inline_value(ids, index), kind: kind, access: access, location: location, context: inline_context(ids, context)}
        .Slice(call, base, start, end, range, location) -> MIROperation.Slice{call: call, base: inline_value(ids, base), start: inline_value(ids, start), end: inline_value(ids, end), range: range.map(value -> inline_value(ids, value)), location: location}
        .Range(start, end, exclusive) -> MIROperation.Range{start: inline_value(ids, start), end: inline_value(ids, end), exclusive: exclusive}
        .Field(base, field) -> MIROperation.Field{base: inline_value(ids, base), field: field}
        .Struct(type_id, fields) -> MIROperation.Struct{type_id: type_id, fields: loop field in fields -> MIRFieldValue{field: field.field, value: inline_value(ids, field.value)}}
        .Enum(type_id, variant, args) -> MIROperation.Enum{type_id: type_id, variant: variant, args: loop arg in args -> MIREnumArg{field: arg.field, value: inline_value(ids, arg.value), boxed: arg.boxed}}
        .Tuple(type_id, fields) -> MIROperation.Tuple{type_id: type_id, fields: loop field in fields -> MIRFieldValue{field: field.field, value: inline_value(ids, field.value)}}
        .Present(value) -> MIROperation.Present{value: inline_value(ids, value)}
        .Convert(value, parameters, target, conversion) -> MIROperation.Convert{value: inline_value(ids, value), parameters: loop parameter in parameters -> inline_value(ids, parameter), target: inline_type(target, substitutions), conversion: inline_conversion(conversion, substitutions)}
        .Absent -> MIROperation.Absent
        .ResultOk(value) -> MIROperation.ResultOk{value: inline_value(ids, value)}
        .ResultErr(value) -> MIROperation.ResultErr{value: inline_value(ids, value)}
        .Call(callee, args, type_args) -> MIROperation.Call{callee: inline_callee(callee, ids, substitutions), args: loop arg in args -> inline_call_arg(arg, ids, substitutions), type_args: loop ty in type_args -> inline_type(ty, substitutions)}
        .IndirectCall(callee, args, type_args) -> MIROperation.IndirectCall{callee: inline_value(ids, callee), args: loop arg in args -> inline_call_arg(arg, ids, substitutions), type_args: loop ty in type_args -> inline_type(ty, substitutions)}
        .Closure(function, captures, facts) -> MIROperation.Closure{function: function, captures: loop capture in captures -> if capture == { .Value(value) -> MIRCaptureOperand.Value{value: inline_value(ids, value)}; .Place(place) -> MIRCaptureOperand.Place{place: inline_place(ids, place)} }, facts: facts}
        .PtrFromAddr(address, element) -> MIROperation.PtrFromAddr{address: inline_value(ids, address), element: inline_type(element, substitutions)}
        .Deref(value) -> MIROperation.Deref{value: inline_value(ids, value)}
        .AddressOf(place, access) -> MIROperation.AddressOf{place: inline_place(ids, place), access: access}
        .RawAddressOf(place) -> MIROperation.RawAddressOf{place: inline_place(ids, place)}
        .CoreCall(call, route, args, type_args, fallibility, data_plan) -> MIROperation.CoreCall{call: call, route: route, args: loop arg in args -> inline_call_arg(arg, ids, substitutions), type_args: loop ty in type_args -> inline_type(ty, substitutions), fallibility: inline_fallibility(fallibility, substitutions), data_plan: data_plan}
        .AttachTag(value, tag) -> MIROperation.AttachTag{value: inline_value(ids, value), tag: tag}
        .Todo(call, location, expected_type) -> MIROperation.Todo{call: call, location: location, expected_type: expected_type.map(ty -> inline_type(ty, substitutions))}
        .Never(reason) -> MIROperation.Never{reason: reason}
        .Semantic(semantic) -> MIROperation.Semantic{operation: inline_semantic(semantic, ids, substitutions)}
        .LoopRangeInit(call, start, end, step, exclusive) -> MIROperation.LoopRangeInit{call: call, start: inline_value(ids, start), end: inline_value(ids, end), step: step.map(value -> inline_value(ids, value)), exclusive: exclusive}
        .LoopRangeHasNext(call, cursor) -> MIROperation.LoopRangeHasNext{call: call, cursor: inline_value(ids, cursor)}
        .LoopRangeValue(call, cursor) -> MIROperation.LoopRangeValue{call: call, cursor: inline_value(ids, cursor)}
        .LoopRangeAdvance(call, cursor) -> MIROperation.LoopRangeAdvance{call: call, cursor: inline_value(ids, cursor)}
        .LoopIterInit(call, collection, step, by_value, source_kind) -> MIROperation.LoopIterInit{call: call, collection: inline_value(ids, collection), step: step.map(value -> inline_value(ids, value)), by_value: by_value, source_kind: source_kind}
        .LoopIterHasNext(call, cursor) -> MIROperation.LoopIterHasNext{call: call, cursor: inline_value(ids, cursor)}
        .LoopIterValue(call, cursor) -> MIROperation.LoopIterValue{call: call, cursor: inline_value(ids, cursor)}
        .LoopIterAdvance(call, cursor) -> MIROperation.LoopIterAdvance{call: call, cursor: inline_value(ids, cursor)}
        .ScopeEnter(scope, member) -> MIROperation.ScopeEnter{scope: inline_scope(ids, scope), test_member: member.map(value -> if value == { .ExpectFail(expected_code) -> MIRTestScopeMember.ExpectFail{expected_code: expected_code}; .Timeout(duration) -> MIRTestScopeMember.Timeout{duration: inline_value(ids, duration)}; .Skip(whole_test) -> MIRTestScopeMember.Skip{whole_test: whole_test}; .Measure -> MIRTestScopeMember.Measure })}
        .ScopeExit(scope) -> MIROperation.ScopeExit{scope: inline_scope(ids, scope)}
        .Drop(value, kind) -> MIROperation.Drop{value: inline_value(ids, value), kind: kind}
    }
}
