                mapped_base = MIRPlaceBase.Parameter{value: inline_value(ids, value)}
            }
            .Local(local) -> mapped_base = MIRPlaceBase.Local{local: inline_local(ids, local)}
            .Capture(value) -> mapped_base = MIRPlaceBase.Capture{value: inline_value(ids, value)}
            .Temporary(value) -> mapped_base = MIRPlaceBase.Temporary{value: inline_value(ids, value)}
            .Static(_) -> {}
        }
        mapped_id :: MIRPlaceID{value: inline_fresh_id(&used_places, "mir-inline-place", identity("place", place.id.value, 0))}
        ids.places[place.id] = mapped_id
        projections :: loop projection in place.projections -> inline_projection(projection, ids)
        &cloned_places.push(MIRPlace{id: mapped_id, span: place.span, ty: inline_type(place.ty, substitutions), base: mapped_base, projections: projections, access: place.access, persist_key: place.persist_key})
    }
    cloned_locals :: loop local in callee.locals -> MIRLocal{id: ids.locals[local.id], name: local.name, span: local.span, ty: inline_type(local.ty, substitutions), place: ids.places[local.place], mutable: local.mutable, ownership: local.ownership, is_comptime: local.is_comptime, uninit: local.uninit, arena_view: local.arena_view, string_view: local.string_view, gc_root: local.gc_root}
    cloned_scopes :: loop scope in callee.scopes -> MIRScope{id: ids.scopes[scope.id], kind: scope.kind, span: scope.span, name: scope.name, deadline: scope.deadline.map(value -> inline_value(ids, value)), facts: scope.facts}
    cloned_values := [MIRValueFact]{}
    callee_values := [MIRValueID:@MIRValueFact]{}
    loop fact in callee.values {
        callee_values[fact.id] = @fact
        if parameter_indexes.contains_key(fact.id) -> continue
        &cloned_values.push(MIRValueFact{id: ids.values[fact.id], ty: inline_type(fact.ty, substitutions), span: fact.span, ownership: fact.ownership})
    }
    continuation :: if reachable_returns > 0 -> Val(MIRBlockID{value: inline_fresh_id(&used_blocks, "mir-inline-block", identity("continuation", call_instruction.id.value, 0))}) else -> None
    cloned_blocks := [MIRBasicBlock]{}
    return_sites := [(block: MIRBlockID, value: MIRValueID?)]{}
    loop block in callee.blocks {
        mapped_id :: ids.blocks[block.id]
        instructions := [MIRInstruction]{}
        loop instruction in block.instructions {
            if instruction.operation == .Parameter(_, _) -> continue
            operation :: inline_operation(instruction.operation, ids, substitutions)
            &instructions.push(MIRInstruction{id: MIROpID{value: inline_fresh_id(&used_operations, "mir-inline-op", identity("instruction", instruction.id.value, 0))}, span: instruction.span, source_line: instruction.source_line, result: instruction.result.map(value -> inline_value(ids, value)), ty: instruction.ty.map(ty -> inline_type(ty, substitutions)), operation: operation})
