// Scalar and canonical-loop continuation of MIROptimization. Reviewed exact
// scalar/bounds helpers retain their existing owners; changed behavior is here.
use jet_foundation.[MIRProgram, MIRFunction, MIRConstant, MIRValueID, MIRBlockID, MIRPlaceID, MIROpID, MIRInstruction, MIRType, MIRTypeDef, MIRIntegerWidth, MIRUnaryOp, MIRBinaryOp, MIRBinaryDispatch, MIROperation, MIRTerminator, MIRPlaceBase, MIROwnership, MIRPreludeCall, MIRPreludeCallID, MIRConversion, MIRSemanticOp, MIRLoopForm, MIRLoopFact, MIRVectorFact, MIRVectorRule, MIRVectorLayout, MIRVectorAccessRoot, MIRFusionFact, MIROptimizationDecision, MIROptimizationRejection, MIRAccelerationFact, MIRFixedReductionFact, mir_operation_value_uses, mir_terminator_value_uses, mir_terminator_targets, mir_type_same_checked_type, stable_id]
use jet_foundation.MIROptimization.Acceleration.[AccelerationProof, AccelerationWorkloadFacts, AccelerationTransform, D_FRED1_FIXED_ORDER]
use jet_optimizer.[block_positions, cyclic_block_positions, collect_loop_region, find_value_instruction, place_value_uses, operation_place_refs, loop_trip_count, loop_trip_count_for_cursor, loop_copy_cost, vector_accesses, vector_fact, fixed_reduction_plan, scalar_loop_condition, scalar_loop_advance, scalar_int_constant, is_default_int_type, value_type, places_overlap, value_depends_on_place, scalar_cursor_references_are_clean, scalar_loop_cursor_value]

// Rust: crates/jet-foundation/src/MIROptimization.rs:8184
fn fold_exact_constants(program: &MIRProgram) Never! {
    loop function_index in 0..<program.functions.len() {
        function := &program.functions[function_index]
        limit := 1
        loop block in function.blocks -> limit += block.instructions.len()
        loop _ in 0..<limit {
            constants := mir_pass_collect_scalar_constants(function)
            changed := false
            loop block_index in 0..<function.blocks.len() {
                loop instruction_index in 0..<function.blocks[block_index].instructions.len() {
                    instruction := &function.blocks[block_index].instructions[instruction_index]
                    replacement :: if instruction.operation == {
                        .Phi(incoming) -> mir_pass_fold_phi(incoming, constants)
                        .Unary(op, value) -> {
                            if constants.get(value.value) == {
                                Val(constant) -> if instruction.ty == { Val(ty) -> fold_unary(op, constant, ty) None -> None }
                                None -> None
                            }
                        }
                        .Binary(op, dispatch, _, left, right) -> {
                            if dispatch == .Primitive && instruction.ty != None {
                                if constants.get(left.value) == {
                                    Val(l) -> if constants.get(right.value) == {
                                        Val(r) -> fold_binary(op, l, r, instruction.ty ?? unreachable())
                                        None -> None
                                    }
                                    None -> None
                                }
                            } else -> None
                        }
                        else -> None
                    }
                    if replacement == {
                        Val(constant) -> {
                            instruction.operation = .Constant(constant)
                            if instruction.result == Val(result) -> constants[result.value] = constant
                            changed = true
                        }
                        None -> {
                            if instruction.result == Val(result) {
                                if instruction.operation == .Constant(constant) {
                                    if mir_pass_scalar_constant(constant) == Val(scalar) -> constants[result.value] = scalar
                                }
                            }
                        }
                    }
                }
            }
            if !changed -> break
        }
    }
    mir_pass_simplify_cfg(&program)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:8228
// collect_scalar_constants -> ScalarAndCfg.jet::mir_pass_collect_scalar_constants, keyed by value.value.
// Rust: crates/jet-foundation/src/MIROptimization.rs:8249
// fold_phi -> ScalarAndCfg.jet::mir_pass_fold_phi, requiring every incoming value to be equal.
// Rust: crates/jet-foundation/src/MIROptimization.rs:8262
// scalar_constant -> ScalarAndCfg.jet::mir_pass_scalar_constant, discarding integer spelling.
// Rust: crates/jet-foundation/src/MIROptimization.rs:8277
// same_scalar -> ScalarAndCfg.jet::mir_pass_same_scalar, comparing integer width as well as value.

// Rust: crates/jet-foundation/src/MIROptimization.rs:8286
fn fold_unary(op: MIRUnaryOp, value: MIRConstant, ty: MIRType) -> MIRConstant? Never! {
    if op == .Not && value == .Bool(flag) -> return Val(MIRConstant.Bool(!flag))
    if op == .Neg && value == .Int(number, width, _) {
        result :: mir_pass_checked_sub(0, number) ?? return None
        return make_integer_constant(result, ty, width)
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:8297
fn fold_binary(op: MIRBinaryOp, left: MIRConstant, right: MIRConstant, ty: MIRType) -> MIRConstant? Never! {
    if left == .Bool(l) && right == .Bool(r) {
        return if op == {
            .And -> Val(MIRConstant.Bool(l && r))
            .Or -> Val(MIRConstant.Bool(l || r))
            .Eq -> Val(MIRConstant.Bool(l == r))
            .Ne -> Val(MIRConstant.Bool(l != r))
            else -> None
        }
    }
    if left == .Char(l) && right == .Char(r) {
        return if op == {
            .Eq -> Val(MIRConstant.Bool(l == r))
            .Ne -> Val(MIRConstant.Bool(l != r))
            .Lt -> Val(MIRConstant.Bool(l < r))
            .Gt -> Val(MIRConstant.Bool(l > r))
            .Le -> Val(MIRConstant.Bool(l <= r))
            .Ge -> Val(MIRConstant.Bool(l >= r))
            else -> None
        }
    }
    if left != .Int(l, width, _) -> return None
    if right != .Int(r, _, _) -> return None
    result :: if op == {
        .Add -> mir_pass_checked_add(l, r) ?? return None
        .Sub -> mir_pass_checked_sub(l, r) ?? return None
        .Mul -> mir_pass_checked_mul(l, r) ?? return None
        .Div -> {
            if r == 0 || (l == mir_pass_int_min() && r == -1) -> return None
            mir_pass_trunc_div(l, r)
        }
        .FloorDiv -> mir_pass_floor_div(l, r) ?? return None
        .Mod -> mir_pass_floor_mod(l, r) ?? return None
        .Rem -> { if r == 0 -> return None; l %% r }
        .Pow -> {
            if r < 0 || r > 4294967295 -> return None
            power := 1
            exponent := r
            base := l
            loop exponent > 0 {
                if exponent % 2 == 1 -> power = mir_pass_checked_mul(power, base) ?? return None
                exponent = exponent /% 2
                if exponent > 0 -> base = mir_pass_checked_mul(base, base) ?? return None
            }
            power
        }
        .BitAnd -> l & r
        .BitOr -> l | r
        .BitXor -> l ~| r
        .Shl -> {
            if r < 0 || r >= 64 -> return None
            // i64::checked_shl checks the shift count, not arithmetic overflow.
            low :: (l << r) & 18446744073709551615
            if low > 9223372036854775807 -> low - 18446744073709551616 else -> low
        }
        .Shr -> { if r < 0 || r >= 64 -> return None; l >> r }
        .Eq -> return Val(MIRConstant.Bool(l == r))
        .Ne -> return Val(MIRConstant.Bool(l != r))
        .Lt -> return Val(MIRConstant.Bool(l < r))
        .Gt -> return Val(MIRConstant.Bool(l > r))
        .Le -> return Val(MIRConstant.Bool(l <= r))
        .Ge -> return Val(MIRConstant.Bool(l >= r))
        .And | .Or | .Compare -> return None
    }
    make_integer_constant(result, ty, width)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:8373
// floor_div -> ScalarAndCfg.jet::mir_pass_floor_div, including zero and MIN/-1 exclusions.
// Rust: crates/jet-foundation/src/MIROptimization.rs:8384
// floor_mod -> ScalarAndCfg.jet::mir_pass_floor_mod, including zero and MIN/-1 exclusions.

// Rust: crates/jet-foundation/src/MIROptimization.rs:8394
fn make_integer_constant(value: Int, ty: MIRType, fallback: MIRIntegerWidth?) -> MIRConstant? Never! {
    width := ty.fixed_int()
    if width == None -> width = fallback
    if width == Val(row) && !fits_integer(value, row.signed, row.bits) -> return None
    Val(MIRConstant.Int{value: value, width: width, spelling: None})
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:8404
fn fits_integer(value: Int, signed: Bool, bits: Int) -> Bool Never! {
    if bits <= 0 || bits > 64 -> return false
    if signed {
        min :: 0 - (1 << (bits - 1))
        max :: (1 << (bits - 1)) - 1
        value >= min && value <= max
    } else -> value >= 0 && (bits == 64 || value <= (1 << bits) - 1)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:8415
// derive_bounds_facts -> Bounds.jet::mir_pass_derive_bounds / mir_pass_function_bounds_facts,
