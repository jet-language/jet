// Derive adapter-facing acceleration evidence and stable decision rows.
use jet_foundation.[
    MIRAccelerationFact,
    MIRAccelerationProof,
    MIRAccelerationWorkloadFacts,
    MIRDecisionDisposition,
    MIRDecisionKind,
    MIRDecisionRow,
    MIRFunction,
    MIRFunctionID,
    MIRIndexKind,
    MIROptimizationDecision,
    MIRProgram,
    MIRVectorFact,
    MIRVectorRule,
    Span,
    stable_id,
]

fn mir_pass_refresh_acceleration_facts(program: &MIRProgram) -> Int Never! {
    count := 0
    loop function_index in 0..<program.functions.len() {
        facts :: mir_pass_function_acceleration_facts(program.functions[function_index])
        count += facts.len()
        program.functions[function_index].optimization.acceleration_facts = facts
    }
    count
}

fn mir_pass_function_acceleration_facts(function: MIRFunction) -> [MIRAccelerationFact] Never! {
    facts := [MIRAccelerationFact]{}
    loop vector in function.optimization.vector_facts {
        ownership_safe :: mir_pass_loop_ownership_safe(function, vector)
        if vector.decision == .Eligible && vector.rule != .Reduction && ownership_safe && vector.effect_free_body && vector.no_early_exit && vector.no_cross_iteration_dependencies {
            &facts.push(MIRAccelerationFact{
                loop_header: vector.loop_header,
                transform: .PooledParallelChunks,
                workload: MIRAccelerationWorkloadFacts{nested_reuse: false, single_pass: true},
                proof: MIRAccelerationProof{
                    source_proven: true,
                    independent_iterations: vector.no_cross_iteration_dependencies,
                    no_aliasing: vector.no_aliasing,
                    no_cross_iteration_dependencies: vector.no_cross_iteration_dependencies,
                    no_early_exit: vector.no_early_exit,
                    effect_free_body: vector.effect_free_body,
                    ownership_safe: ownership_safe,
                    failure_order_preserved: vector.effect_free_body && vector.no_early_exit,
                },
                span: vector.span,
            })
        }
    }
    facts
}

fn mir_pass_loop_ownership_safe(function: MIRFunction, vector: MIRVectorFact) -> Bool Never! {
    if !vector.no_aliasing -> return false
    loop access in vector.accesses {
        if access.root == {
            .Place(id) -> {
                place :: mir_pass_find_place(function.places, id) ?? return false
                if place.base == { .Local(_) -> {} else -> if place.access != .Read -> return false }
            }
            .Value(_) -> return false
        }
    }
    true
}

fn mir_pass_decision_kind_name(kind: MIRDecisionKind) -> String Never! {
    if kind == {
        .Tier -> "tier"
        .Inline -> "inline"
        .Vectorize -> "vectorize"
        .Parallel -> "parallel"
        .Copy -> "copy"
        .Bounds -> "bounds"
        .Deopt -> "deopt"
        .Unreachable -> "unreachable"
        .LoopInvariant -> "loop-invariant"
    }
}

fn mir_pass_decision_disposition_name(disposition: MIRDecisionDisposition) -> String Never! {
    if disposition == {
        .Accepted -> "accepted"
        .Rejected -> "rejected"
        .Selected -> "selected"
        .NotAttempted -> "not-attempted"
        .Unavailable -> "unavailable"
    }
}

fn mir_pass_decision_row(
    kind: MIRDecisionKind,
    disposition: MIRDecisionDisposition,
    function: MIRFunctionID?,
    function_name: String,
    span: Span,
    rule: String,
    reason: String,
    producer: String,
    evidence: String,
) -> MIRDecisionRow Never! {
    function_id :: function.map(value -> value.value) ?? 0
    identity :: "{mir_pass_decision_kind_name(kind)}|{mir_pass_decision_disposition_name(disposition)}|{function_id}|{span.start}|{span.end}|{rule}|{reason}"
    MIRDecisionRow{
        id: stable_id("mir-decision", identity),
        kind: kind,
        disposition: disposition,
        function: function,
        function_name: function_name,
        span: span,
        rule: rule,
        reason: reason,
        producer: producer,
        evidence: evidence,
        edit: None,
        derivation: None,
        identity: None,
        evidence_method: None,
        derivation_disposition: None,
    }
}

// Rust: none (Jet-only pass)
fn mir_pass_decision_insert(rows: &[MIRDecisionRow], seen: &[U64:Bool], fact: MIRDecisionRow) Never! {
    if seen.get(fact.id) != None -> return
    &seen.add(fact.id, true).drop("checked absent above")
    &rows.push(fact)
}

fn mir_pass_rejection_reason(decision: MIROptimizationDecision) -> String Never! {
    if decision == {
        .Eligible -> "source proof accepts the transformation"
        .Rejected(reason) -> {
            if reason == {
                .MissingProof -> "required source proof is unavailable"
                .MayTrap -> "transformation may change trap behavior"
                .HasEffects -> "loop body has observable effects"
                .HasEarlyExit -> "loop has an early exit"
                .MayAlias -> "independent memory roots are not proven"
                .CrossIterationDependency -> "iterations have a carried dependency"
                .DynamicTripCount -> "trip count is not statically bounded"
                .UnknownCopyCost -> "copy cost is unknown"
                .ScalarBoundary -> "scalar boundary cannot be packed"
                .ObservableLayout -> "layout conversion is observable"
                .OwnershipObligation -> "ownership obligations prevent the transform"
                .UnsupportedOperation -> "loop operation is unsupported by this transform"
            }
        }
    }
}

fn mir_pass_decision_disposition(decision: MIROptimizationDecision) -> MIRDecisionDisposition Never! {
    if decision == {
        .Eligible -> MIRDecisionDisposition.Accepted
        .Rejected(_) -> MIRDecisionDisposition.Rejected
    }
}

fn mir_pass_derive_decision_rows(program: &MIRProgram) -> Int Never! {
    count := 0
    // One walk of every call site, instead of one per inline-always function.
    call_counts :: mir_pass_count_calls_by_function(program)
    loop function_index in 0..<program.functions.len() {
        rows :: mir_pass_function_decision_rows(program, program.functions[function_index], function_index == 0, call_counts)
        program.functions[function_index].optimization.decision_rows = rows
        count += rows.len()
    }
    count
}

// Rust: crates/jet-foundation/src/MIROptimization.rs::decision_ledger_rows
fn mir_pass_function_decision_rows(program: MIRProgram, function: MIRFunction, first_function: Bool, call_counts: [U64:Int]) -> [MIRDecisionRow] Never! {
    rows := [MIRDecisionRow]{}
    seen := [U64:Bool]{}
    function_name :: "{function.module_name}::{function.name}"
    if function.is_inline_always || function.optimization.inline_always {
        remaining :: call_counts.get(function.id.value) ?? 0
        disposition :: if remaining == 0 -> MIRDecisionDisposition.Accepted else -> MIRDecisionDisposition.Rejected
        reason :: if remaining == 0 -> "all statically resolved calls were expanded" else -> "statically resolved calls remain in canonical MIR"
        row :: mir_pass_decision_row(.Inline, disposition, Val(function.id), function_name, function.span, "inline-always", reason, "source-mir-optimizer", "remaining-calls={remaining}")
        mir_pass_decision_insert(&rows, &seen, row)
    }
    if first_function {
        loop unreachable in program.unreachable {
            reason :: if unreachable.reason == {
                .CompileTimeOnly -> "compiletimeonly"
                .Disabled -> "disabled"
                .ExpandedBeforeLowering -> "expandedbeforelowering"
                .SemanticIndexOnly -> "semanticindexonly"
            }
            row :: mir_pass_decision_row(.Unreachable, MIRDecisionDisposition.Selected, None, "", unreachable.span, unreachable.construct, reason, "tir.erasure", "static-control-flow-fact")
            mir_pass_decision_insert(&rows, &seen, row)
        }
    }
    loop loop_fact in function.optimization.loop_facts {
        copy_disposition :: if loop_fact.copy_cost == {
            .NoCopy -> MIRDecisionDisposition.NotAttempted
            .PerIteration(_) -> MIRDecisionDisposition.Selected
            .Unknown -> MIRDecisionDisposition.Unavailable
        }
        copy_reason :: if loop_fact.copy_cost == {
            .NoCopy -> "no loop copy was required by the checked ownership fact"
            .PerIteration(copy_count) -> if copy_count == 1 -> "the compiler inserted one copy per iteration" else -> "the compiler inserted copies per iteration"
            .Unknown -> "the compiler has no bounded copy-cost fact"
        }
        copy_row :: mir_pass_decision_row(.Copy, copy_disposition, Val(function.id), function_name, loop_fact.span, "loop-copy-cost", copy_reason, "mir.loop-facts", "static-cost-fact")
        mir_pass_decision_insert(&rows, &seen, copy_row)

        disposition :: mir_pass_decision_disposition(loop_fact.decision)
        trip_count :: loop_fact.trip_count.map(value -> "{value}") ?? "unknown"
        evidence :: "header={loop_fact.header.value};trip-count={trip_count}"
        row :: mir_pass_decision_row(.Parallel, disposition, Val(function.id), function_name, loop_fact.span, "canonical-loop", mir_pass_rejection_reason(loop_fact.decision), "source-mir-optimizer", evidence)
        mir_pass_decision_insert(&rows, &seen, row)
    }
    loop vector in function.optimization.vector_facts {
        disposition :: mir_pass_decision_disposition(vector.decision)
        evidence :: "accesses={vector.accesses.len()};alias-free={vector.no_aliasing};no-early-exit={vector.no_early_exit};effect-free={vector.effect_free_body}"
        row :: mir_pass_decision_row(.Vectorize, disposition, Val(function.id), function_name, vector.span, mir_pass_vector_rule_name(vector.rule), mir_pass_rejection_reason(vector.decision), "source-mir-optimizer", evidence)
        mir_pass_decision_insert(&rows, &seen, row)
    }
    loop bounds in function.optimization.bounds_facts {
        disposition :: if bounds.proven -> MIRDecisionDisposition.Accepted else -> MIRDecisionDisposition.Rejected
        reason :: if bounds.proven -> "bounds proof preserves the checked access failure edge" else -> "bounds cannot be proven for this access"
        evidence :: "operation={bounds.operation.value};kind={mir_pass_index_kind_name(bounds.kind)}"
        row :: mir_pass_decision_row(.Bounds, disposition, Val(function.id), function_name, bounds.span, "bounds-check", reason, "source-mir-optimizer", evidence)
        mir_pass_decision_insert(&rows, &seen, row)
    }
    rows
}

fn mir_pass_vector_rule_name(rule: MIRVectorRule) -> String Never! {
    if rule == {
        .Elementwise -> "elementwise"
        .FieldAccess -> "field-access"
        .ConditionalAccumulate -> "conditional-accumulate"
        .EarlyExitSearch -> "early-exit-search"
        .Reduction -> "fixed-reduction"
    }
}

fn mir_pass_index_kind_name(kind: MIRIndexKind) -> String Never! {
    if kind == {
        .List -> "list"
        .FixedListProof -> "fixed-list"
        .Map -> "map"
        .Lane -> "lane"
        .Pool -> "pool"
    }
}

// Statically resolved calls per callee function id (MIRFunctionID.value).
fn mir_pass_count_calls_by_function(program: MIRProgram) -> [U64:Int] Never! {
    counts := [U64:Int]{}
    loop function in program.functions {
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == {
                    .Call(callee, _, _) -> {
                        if callee == {
                            .User(id) | .Associated(id, _) | .Method(id, _) -> {
                                _ := &counts.add(id.value, (counts.get(id.value) ?? 0) + 1)
                            }
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    counts
}

fn mir_pass_sort_decision_rows_for_program(program: &MIRProgram) Never! {
    loop index in 0..<program.functions.len() {
        rows_window := &program.functions[index].optimization.decision_rows
        mir_pass_sort_decision_rows(&rows_window)
    }
}

// Rust: none (Jet-only pass)
fn mir_pass_sort_decision_rows(rows: &[MIRDecisionRow]) Never! {
    ids := [U64]{}
    loop index in 0..<rows.len() -> &ids.push(rows[index].id)
    sorted := [MIRDecisionRow]{}
    loop position in mir_pass_id_order(ids) -> &sorted.push(rows[position])
    loop index in 0..<sorted.len() -> rows[index] = sorted[index]
}
