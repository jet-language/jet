// Canonical loop shape, trip-count, vector-legality, and reduction proofs.
use jet_foundation.[
    MIRBasicBlock,
    MIRBlockID,
    MIRConstant,
    MIRCopyCost,
    MIRFieldID,
    MIRFixedReductionFact,
    MIRFixedReductionOrder,
    MIRFunction,
    MIRInstruction,
    MIRLoopFact,
    MIRLoopForm,
    MIROpID,
    MIROperation,
    MIROptimizationDecision,
    MIRPlace,
    MIRPlaceID,
    MIRPreludeCall,
    MIRPreludeCallID,
    MIRType,
    MIRValueID,
    MIRVectorAccess,
    MIRVectorAccessRoot,
    MIRVectorFact,
    MIRVectorRule,
    Span,
    mir_terminator_targets,
]

struct MIRPassLoopShape {
    pub header: MIRBlockID
    pub body: MIRBlockID?
    pub exit: MIRBlockID?
    pub form: MIRLoopForm
    pub cursor: MIRValueID?
    pub induction: MIRValueID?
    pub advance_block: MIRBlockID?
    pub body_blocks: [MIRBlockID]
    pub trip_count: Int?
    pub canonical: Bool
    pub early_exit: Bool
    pub span: Span
}

struct MIRPassLoopInduction {
    pub values: [MIRValueID]
    pub places: [MIRPlaceID]
    pub supported: Bool
}

struct MIRLoopVectorCounts { pub loops: Int, pub vectors: Int }

struct MIRPassLoopReduction {
    pub accumulator: MIRPlaceID
    pub addend: MIRValueID
    pub seed: MIRValueID
    pub condition: MIRValueID?
    pub source_operations: [MIROpID]
}

// Function-wide facts that every loop of one function reads: block and place
// rows by id, predecessor rows, each value's defining instruction, scalar
// constants and dominators. Built once per function with a loop test instead
// of once (or several times) per loop.
struct MIRPassLoopAnalysis {
    pub positions: [U64:Int]
    pub predecessors: [[Int]]
    pub places: [U64:Int]
    pub definitions: [U64:MIRInstruction]
    pub constants: [U64:MIRConstant]
    pub dominators: MIRPassDominance
}

fn mir_pass_loop_analysis(function: MIRFunction) -> MIRPassLoopAnalysis Never! {
    positions := [U64:Int]{}
    definitions := [U64:MIRInstruction]{}
    predecessors := [[Int]]{}
    loop (position, block) in function.blocks {
        if positions.get(block.id.value) == None -> &positions.add(block.id.value, position).drop("checked absent above")
        &predecessors.push([Int]{})
        loop instruction in block.instructions {
            defined :: instruction.result ?? next
            if definitions.get(defined.value) == None -> &definitions.add(defined.value, instruction).drop("checked absent above")
        }
    }
    loop (position, block) in function.blocks {
        loop target in mir_terminator_targets(block.terminator) {
            target_at :: positions.get(target.value) ?? next
            &predecessors[target_at].push(position)
        }
    }
    MIRPassLoopAnalysis{
        positions: positions,
        predecessors: predecessors,
        places: mir_pass_place_rows(function),
        definitions: definitions,
        constants: mir_pass_collect_scalar_constants(function),
        dominators: mir_pass_dominators(function),
    }
}

fn mir_pass_function_has_loop_test(function: MIRFunction) -> Bool Never! {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.operation == {
                .LoopRangeHasNext(_, _) | .LoopIterHasNext(_, _) -> return true
                else -> {}
            }
        }
    }
    false
}

fn mir_pass_loop_block(function: MIRFunction, analysis: MIRPassLoopAnalysis, id: MIRBlockID) -> MIRBasicBlock? {
    position :: analysis.positions.get(id.value) ?? return None
    Val(function.blocks[position])
}

fn mir_pass_loop_place(function: MIRFunction, analysis: MIRPassLoopAnalysis, id: MIRPlaceID) -> MIRPlace? {
    position :: analysis.places.get(id.value) ?? return None
    Val(function.places[position])
}

// One function's canonical loop and vector facts.
fn mir_pass_function_loop_and_vector_facts(function: &MIRFunction, prelude_calls: [MIRPreludeCall]) -> MIRLoopVectorCounts Never! {
    counts := MIRLoopVectorCounts{loops: 0, vectors: 0}
    previous_vectors :: function.optimization.vector_facts
    loops := [MIRLoopFact]{}
    vectors := [MIRVectorFact]{}
    // A function without a loop test has no loop shape; skip its analysis.
    if mir_pass_function_has_loop_test(function) {
        analysis :: mir_pass_loop_analysis(function)
        loop shape in mir_pass_loop_shapes(function, analysis) {
            reduction :: mir_pass_loop_reduction(function, analysis, shape)
            copy_cost :: mir_pass_loop_copy_cost(function, analysis, shape)
            loop_decision :: if {
                shape.trip_count == None && shape.form != .Unconditional -> MIROptimizationDecision.Rejected{reason: .DynamicTripCount}
                shape.canonical -> MIROptimizationDecision.Eligible
                else -> MIROptimizationDecision.Rejected{reason: .MissingProof}
            }
            &loops.push(MIRLoopFact{
                header: shape.header,
                body: shape.body,
                exit: shape.exit,
                form: shape.form,
                trip_count: shape.trip_count,
                copy_cost: copy_cost,
                canonical: shape.canonical,
                span: shape.span,
                decision: loop_decision,
            })
            vector :: mir_pass_loop_vector_fact(function, analysis, shape, reduction, copy_cost, prelude_calls)
            &vectors.push(vector)
        }
    }
    loop vector in previous_vectors {
        if vector.fixed_reduction != None && !mir_pass_vector_header_seen(vectors, vector.loop_header) && mir_pass_fixed_reduction_fact_current(function, vector, prelude_calls) -> &vectors.push(vector)
    }
    function.optimization.loop_facts = loops
    function.optimization.vector_facts = vectors
    function.optimization.checked_vector_facts = mir_pass_checked_vectors(vectors)
    function.optimization.auto_vectorizable = false
    function.optimization.no_aliasing = vectors.len() > 0
    function.optimization.no_early_exit = vectors.len() > 0
    function.optimization.no_cross_iteration_dependencies = vectors.len() > 0
    loop vector in vectors {
        counts.vectors += 1
        function.optimization.auto_vectorizable = function.optimization.auto_vectorizable || vector.decision == .Eligible
        function.optimization.no_aliasing = function.optimization.no_aliasing && vector.no_aliasing
        function.optimization.no_early_exit = function.optimization.no_early_exit && vector.no_early_exit
        function.optimization.no_cross_iteration_dependencies = function.optimization.no_cross_iteration_dependencies && vector.no_cross_iteration_dependencies
    }
    counts.loops += loops.len()
    counts
}

fn mir_pass_vector_header_seen(rows: [MIRVectorFact], header: MIRBlockID) -> Bool Never! {
    loop row in rows { if row.loop_header == header -> return true }
    false
}

fn mir_pass_loop_shapes(function: MIRFunction, analysis: MIRPassLoopAnalysis) -> [MIRPassLoopShape] Never! {
    shapes := [MIRPassLoopShape]{}
    loop block in function.blocks {
        if block.terminator == {
            .Branch(condition, then_target, else_target) -> {
                definition :: analysis.definitions.get(condition.value) ?? next
                if definition.operation == {
                    .LoopRangeHasNext(_, cursor) -> {
                        shape :: mir_pass_make_loop_shape(function, analysis, block, then_target, else_target, cursor, .Counted)
                        if !mir_pass_loop_header_seen(shapes, block.id) -> &shapes.push(shape)
                    }
                    .LoopIterHasNext(_, cursor) -> {
                        shape :: mir_pass_make_loop_shape(function, analysis, block, then_target, else_target, cursor, .Iterator)
                        if !mir_pass_loop_header_seen(shapes, block.id) -> &shapes.push(shape)
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    mir_pass_sort_loop_shapes(&shapes)
    shapes
}

fn mir_pass_make_loop_shape(
    function: MIRFunction,
    analysis: MIRPassLoopAnalysis,
    header: MIRBasicBlock,
    first: MIRBlockID,
    second: MIRBlockID,
    cursor: MIRValueID,
    form: MIRLoopForm,
) -> MIRPassLoopShape Never! {
    first_returns :: mir_pass_reaches_block(function, analysis.positions, first, header.id)
    second_returns :: mir_pass_reaches_block(function, analysis.positions, second, header.id)
    body :: if {
        first_returns && !second_returns -> Val(first)
        second_returns && !first_returns -> Val(second)
        else -> MIRBlockID?{None}
    }
    exit :: if {
        first_returns && !second_returns -> Val(second)
        second_returns && !first_returns -> Val(first)
        else -> MIRBlockID?{None}
    }
    body_blocks :: if body == .Val(body_id) -> mir_pass_loop_body_blocks(function, analysis, body_id, header.id) else -> [MIRBlockID]{}
    init :: mir_pass_loop_init(analysis, cursor, form)
    induction :: mir_pass_loop_induction_value(function, analysis, body_blocks, cursor, form)
    trip :: mir_pass_loop_trip_count(analysis, init)
    advance :: mir_pass_loop_advance_block(function, analysis, body_blocks, cursor, form)
    early_exit :: body == None || mir_pass_loop_has_early_exit(function, analysis, body_blocks, header.id)
    MIRPassLoopShape{
        header: header.id,
        body: body,
        exit: exit,
        form: form,
        cursor: Val(cursor),
        induction: induction,
        advance_block: advance,
        body_blocks: body_blocks,
        trip_count: trip,
        canonical: body != None && exit != None && init != None && advance != None,
        early_exit: early_exit,
        span: header.span,
    }
}

fn mir_pass_loop_header_seen(rows: [MIRPassLoopShape], header: MIRBlockID) -> Bool Never! {
    loop row in rows { if row.header == header -> return true }
    false
}

fn mir_pass_sort_loop_shapes(rows: &[MIRPassLoopShape]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && current.header.value < rows[cursor - 1].header.value {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_loop_init(analysis: MIRPassLoopAnalysis, cursor: MIRValueID, form: MIRLoopForm) -> MIRInstruction? {
    instruction :: analysis.definitions.get(cursor.value) ?? return None
    if instruction.operation == {
        .LoopRangeInit(_, _, _, _, _) && form == .Counted -> Val(instruction)
        .LoopIterInit(_, _, _, _, _) && form == .Iterator -> Val(instruction)
        else -> None
    }
}

fn mir_pass_loop_induction_value(function: MIRFunction, analysis: MIRPassLoopAnalysis, body: [MIRBlockID], cursor: MIRValueID, form: MIRLoopForm) -> MIRValueID? {
    wanted :: if form == .Counted -> MIROperation.LoopRangeValue{call: MIRPreludeCallID{value: 0}, cursor: cursor} else -> MIROperation.LoopIterValue{call: MIRPreludeCallID{value: 0}, cursor: cursor}
    loop block_id in body {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? next
        loop instruction in block.instructions {
            if instruction.operation == wanted && instruction.result != None -> return instruction.result
            if instruction.operation == {
                .LoopRangeValue(_, value) && form == .Counted && value == cursor -> return instruction.result
                .LoopIterValue(_, value) && form == .Iterator && value == cursor -> return instruction.result
                else -> {}
            }
        }
    }
    None
}

// One write of the induction value into a place inside the loop body.
struct MIRPassLoopWriteSite {
    pub place: MIRPlaceID
    pub block: MIRBlockID
    pub index: Int
}

fn mir_pass_loop_induction_model(function: MIRFunction, analysis: MIRPassLoopAnalysis, shape: MIRPassLoopShape) -> MIRPassLoopInduction Never! {
    induction :: shape.induction ?? return MIRPassLoopInduction{values: [MIRValueID]{}, places: [MIRPlaceID]{}, supported: false}
    values := [MIRValueID]{induction}
    places := [MIRPlaceID]{}
    // The induction writes, collected once instead of rescanned per read.
    writes := [MIRPassLoopWriteSite]{}
    supported := true
    loop block_id in shape.body_blocks {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? return MIRPassLoopInduction{values: values, places: places, supported: false}
        loop (instruction_index, instruction) in block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> if value == induction {
                    place :: mir_pass_loop_place(function, analysis, place_id) ?? return MIRPassLoopInduction{values: values, places: places, supported: false}
                    if place.base == {
                        .Local(_) -> {
                            if place.projections.len() != 0 -> supported = false
                        }
                        else -> supported = false
                    }
                    if !mir_pass_place_id_seen(places, place_id) -> &places.push(place_id)
                    &writes.push(MIRPassLoopWriteSite{place: place_id, block: block_id, index: instruction_index})
                }
                else -> {}
            }
        }
    }
    if places.len() > 1 -> supported = false
    if supported {
        loop block_id in shape.body_blocks {
            block :: mir_pass_loop_block(function, analysis, block_id) ?? return MIRPassLoopInduction{values: values, places: places, supported: false}
            loop (instruction_index, instruction) in block.instructions {
                if instruction.operation == {
                    .WritePlace(place_id, value) -> if mir_pass_place_id_seen(places, place_id) && value != induction -> supported = false
                    .ReadPlace(place_id) -> if mir_pass_place_id_seen(places, place_id) {
                        value :: instruction.result ?? return MIRPassLoopInduction{values: values, places: places, supported: false}
                        if {
                            !mir_pass_loop_induction_write_dominates(writes, place_id, block_id, instruction_index, analysis.dominators) -> supported = false
                            !mir_pass_value_id_seen(values, value) -> &values.push(value)
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    MIRPassLoopInduction{values: values, places: places, supported: supported}
}

fn mir_pass_loop_induction_write_dominates(
    writes: [MIRPassLoopWriteSite],
    place_id: MIRPlaceID,
    read_block: MIRBlockID,
    read_index: Int,
    dominators: MIRPassDominance,
) -> Bool Never! {
    loop write in writes {
        if write.place != place_id -> next
        if {
            write.block == read_block -> {
                if write.index < read_index -> return true
            }
            mir_pass_dominates(dominators, write.block, read_block) -> return true
            else -> {}
        }
    }
    false
}

fn mir_pass_loop_induction_place_seen(induction: MIRPassLoopInduction, place: MIRPlaceID) -> Bool Never! {
    mir_pass_place_id_seen(induction.places, place)
}

fn mir_pass_loop_trip_count(analysis: MIRPassLoopAnalysis, init: MIRInstruction?) -> Int? {
    instruction :: init ?? return None
    if instruction.operation == {
        .LoopRangeInit(_, start, end, step, exclusive) -> {
            start_constant :: mir_pass_constant_for(analysis.constants, start) ?? return None
            end_constant :: mir_pass_constant_for(analysis.constants, end) ?? return None
            first :: if start_constant == {
                .Int(value, _, _) -> value
                else -> { return None }
            }
            last :: if end_constant == {
                .Int(value, _, _) -> value
                else -> { return None }
            }
            step_value :: if step == {
                .Val(step_id) -> {
                    step_constant :: mir_pass_constant_for(analysis.constants, step_id) ?? return None
                    if step_constant == {
                        .Int(value, _, _) -> value
                        else -> { return None }
                    }
                }
                else -> 1
            }
            mir_pass_range_trip_count(first, last, step_value, exclusive)
        }
        else -> None
    }
}

fn mir_pass_range_trip_count(start: Int, end: Int, step: Int, exclusive: Bool) -> Int? {
    if step == 0 -> return None
    count := 0
    magnitude := 0
    if {
        step > 0 -> {
            if start > end || (start == end && exclusive) -> return Val(0)
            distance :: mir_pass_checked_sub(end, start) ?? return None
            count = if exclusive -> distance else -> mir_pass_checked_add(distance, 1) ?? return None
            magnitude = step
        }
        else -> {
            if start < end || (start == end && exclusive) -> return Val(0)
            distance :: mir_pass_checked_sub(start, end) ?? return None
            count = if exclusive -> distance else -> mir_pass_checked_add(distance, 1) ?? return None
            magnitude = mir_pass_checked_sub(0, step) ?? return None
        }
    }
    adjusted :: mir_pass_checked_add(count, magnitude - 1) ?? return None
    trip :: adjusted /% magnitude
    if trip < 0 -> return None
    Val(trip)
}

fn mir_pass_reaches_block(function: MIRFunction, positions: [U64:Int], start: MIRBlockID, target: MIRBlockID) -> Bool Never! {
    seen := [Bool]{}
    loop _ in function.blocks -> &seen.push(false)
    pending := [MIRBlockID]{start}
    cursor := 0
    loop cursor < pending.len() {
        block_id := pending[cursor]
        cursor += 1
        if block_id == target -> return true
        at :: positions.get(block_id.value) ?? next
        if seen[at] -> next
        seen[at] = true
        loop successor in mir_terminator_targets(function.blocks[at].terminator) {
            successor_at :: positions.get(successor.value) ?? -1
            if successor_at < 0 || !seen[successor_at] -> &pending.push(successor)
        }
    }
    false
}

// The loop body: blocks reachable from `body` without passing `header` that
// have a path back to `header`, in breadth-first order. One backward walk
// from `header` marks the blocks that reach it, instead of a forward walk
// per candidate block.
fn mir_pass_loop_body_blocks(function: MIRFunction, analysis: MIRPassLoopAnalysis, body: MIRBlockID, header: MIRBlockID) -> [MIRBlockID] Never! {
    reaches := [Bool]{}
    seen := [Bool]{}
    loop _ in function.blocks {
        &reaches.push(false)
        &seen.push(false)
    }
    header_at :: analysis.positions.get(header.value) ?? return [MIRBlockID]{}
    backward := [Int]{header_at}
    back_cursor := 0
    loop back_cursor < backward.len() {
        current := backward[back_cursor]
        back_cursor += 1
        loop predecessor in analysis.predecessors[current] {
            if reaches[predecessor] -> next
            reaches[predecessor] = true
            &backward.push(predecessor)
        }
    }
    pending := [MIRBlockID]{body}
    visited := [MIRBlockID]{}
    cursor := 0
    loop cursor < pending.len() {
        block_id := pending[cursor]
        cursor += 1
        if block_id == header -> next
        at :: analysis.positions.get(block_id.value) ?? next
        if seen[at] || !reaches[at] -> next
        seen[at] = true
        &visited.push(block_id)
        loop successor in mir_terminator_targets(function.blocks[at].terminator) {
            if successor == header -> next
            successor_at :: analysis.positions.get(successor.value) ?? -1
            if successor_at < 0 || !seen[successor_at] -> &pending.push(successor)
        }
    }
    visited
}

fn mir_pass_loop_advance_block(function: MIRFunction, analysis: MIRPassLoopAnalysis, body: [MIRBlockID], cursor: MIRValueID, form: MIRLoopForm) -> MIRBlockID? {
    loop block_id in body {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? next
        loop instruction in block.instructions {
            matched :: if instruction.operation == {
                .LoopRangeAdvance(_, value) -> form == .Counted && value == cursor
                .LoopIterAdvance(_, value) -> form == .Iterator && value == cursor
                else -> false
            }
            if matched -> return Val(block_id)
        }
    }
    None
}

fn mir_pass_loop_has_early_exit(function: MIRFunction, analysis: MIRPassLoopAnalysis, body: [MIRBlockID], header: MIRBlockID) -> Bool Never! {
    members := [U64:Bool]{}
    loop block_id in body -> &members.add(block_id.value, true).drop("a block id may repeat")
    loop block_id in body {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? return true
        if block.terminator == {
            .Return(_) | .Yield(_, _) | .Break(_, _) | .Unreachable(_) -> return true
            else -> {}
        }
        loop successor in mir_terminator_targets(block.terminator) {
            if successor != header && members.get(successor.value) == None -> return true
        }
    }
    false
}

fn mir_pass_loop_copy_cost(function: MIRFunction, analysis: MIRPassLoopAnalysis, shape: MIRPassLoopShape) -> MIRCopyCost Never! {
    count := 0
    loop block_id in shape.body_blocks {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? next
        loop instruction in block.instructions {
            if instruction.operation == {
                .Copy(_, _) -> count += 1
                .Semantic(semantic) -> {
                    if semantic == {
                        .BuiltinMethod(_, _, _, _, _) -> count += 1
                        else -> {}
                    }
                }
                else -> {}
            }
        }
    }
    if count == 0 -> MIRCopyCost.NoCopy else -> MIRCopyCost.PerIteration{count: count}
}

fn mir_pass_loop_reduction(function: MIRFunction, analysis: MIRPassLoopAnalysis, shape: MIRPassLoopShape) -> MIRPassLoopReduction? {
    loop block_id in shape.body_blocks {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? next
        loop instruction in block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> {
                    place :: mir_pass_loop_place(function, analysis, place_id) ?? next
                    if place.projections.len() > 0 -> next
                    definition :: analysis.definitions.get(value.value) ?? next
                    if definition.operation == {
                        .Binary(op, dispatch, _, left, right) && op == .Add && dispatch == .Primitive -> {
                            if left == right -> next
                            read_left :: analysis.definitions.get(left.value) ?? next
                            read_right :: analysis.definitions.get(right.value) ?? next
                            if mir_pass_operation_reads_place(read_left.operation, place_id) {
                                return Val(MIRPassLoopReduction{accumulator: place_id, addend: right, seed: left, condition: None, source_operations: [MIROpID]{instruction.id, definition.id}})
                            }
                            if mir_pass_operation_reads_place(read_right.operation, place_id) {
                                return Val(MIRPassLoopReduction{accumulator: place_id, addend: left, seed: right, condition: None, source_operations: [MIROpID]{instruction.id, definition.id}})
                            }
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn mir_pass_operation_reads_place(operation: MIROperation, place: MIRPlaceID) -> Bool Never! {
    if operation == {
        .ReadPlace(value) | .MovePlace(value) -> value == place
        else -> false
    }
}

fn mir_pass_loop_vector_fact(
    function: MIRFunction,
    analysis: MIRPassLoopAnalysis,
    shape: MIRPassLoopShape,
    reduction: MIRPassLoopReduction?,
    copy_cost: MIRCopyCost,
    prelude_calls: [MIRPreludeCall],
) -> MIRVectorFact Never! {
    index :: shape.induction
    induction :: mir_pass_loop_induction_model(function, analysis, shape)
    accesses := [MIRVectorAccess]{}
    element_type := MIRType?{None}
    written_roots := [MIRPlaceID]{}
    roots := [MIRPlaceID]{}
    effect_free := shape.canonical && induction.supported
    conditional := false
    field_access := false
    loop block_id in shape.body_blocks {
        block :: mir_pass_loop_block(function, analysis, block_id) ?? next
        if block.terminator == {
            .Branch(_, _, _) | .Switch(_, _, _) -> conditional = true
            else -> {}
        }
        loop instruction in block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> {
                    place :: mir_pass_loop_place(function, analysis, place_id) ?? next
                    if {
                        mir_pass_loop_induction_place_seen(induction, place_id) -> {
                            if !mir_pass_value_id_seen(induction.values, value) -> effect_free = false
                        }
                        mir_pass_place_uses_index(place, induction.values) -> {
                            if !mir_pass_place_id_seen(written_roots, place_id) -> &written_roots.push(place_id)
                            if !mir_pass_place_id_seen(roots, place_id) -> &roots.push(place_id)
                            mir_pass_vector_access_put(&accesses, place)
                        }
                        reduction == .Val(reduction_row) && reduction_row.accumulator == place_id -> {
                            if !mir_pass_place_id_seen(written_roots, place_id) -> &written_roots.push(place_id)
                        }
                        else -> effect_free = false
                    }
                }
                .ReadPlace(place_id) -> {
                    place :: mir_pass_loop_place(function, analysis, place_id) ?? {
                        effect_free = false
                        next
                    }
                    if {
                        mir_pass_loop_induction_place_seen(induction, place_id) -> {
                            if {
                                instruction.result == .Val(result) -> {
                                    if !mir_pass_value_id_seen(induction.values, result) -> effect_free = false
                                }
                                else -> effect_free = false
                            }
                        }
                        mir_pass_place_uses_index(place, induction.values) -> {
                            if !mir_pass_place_id_seen(roots, place_id) -> &roots.push(place_id)
                            mir_pass_vector_access_put(&accesses, place)
                            if place.projections.len() > 0 {
                                if place.projections[place.projections.len() - 1] == {
                                    .Field(_, _) -> { field_access = true }
                                    else -> {}
                                }
                            }
                            element_type = Val(place.ty)
                        }
                        else -> {}
                    }
                }
                .Binary(op, dispatch, _, _, _) -> {
                    if dispatch != .Primitive || !(op == .Add || op == .Sub || op == .Mul || op == .Div || op == .Eq || op == .Lt || op == .Le || op == .Gt || op == .Ge) -> effect_free = false
                }
                .Unary(_, _) | .Constant(_) | .Phi(_) | .Copy(_, _) | .Move(_) | .LoopRangeHasNext(_, _) | .LoopRangeValue(_, _) | .LoopRangeAdvance(_, _) | .LoopIterHasNext(_, _) | .LoopIterValue(_, _) | .LoopIterAdvance(_, _) -> {}
                .Index(_, _, _, kind, _, _, _) -> {
                    if kind != .FixedListProof -> effect_free = false
                }
                .Convert(_, _, _, _) -> { effect_free = false }
                else -> { effect_free = false }
            }
            loop place_id in mir_pass_operation_place_refs(instruction.operation) {
                place :: mir_pass_loop_place(function, analysis, place_id) ?? next
                loop projection in place.projections {
                    if projection == {
                        .Index(_, _, call, _, _, _, _) -> {
                            if !mir_pass_prelude_is_pure(prelude_calls, call) -> effect_free = false
                        }
                        // A range window checks its bounds and may stop.
                        .Range(_, _, _) -> { effect_free = false }
                        else -> {}
                    }
                }
            }
        }
    }
    no_aliasing :: if reduction == .Val(row) -> mir_pass_loop_reduction_no_alias(function, analysis, roots, row) else -> mir_pass_loop_accesses_do_not_alias(function, analysis, roots, written_roots)
    no_cross_iteration := roots.len() > 0 && written_roots.len() > 0 && no_aliasing && reduction == None && effect_free
    if reduction == None && written_roots.len() > 0 {
        loop root_id in written_roots {
            place :: mir_pass_loop_place(function, analysis, root_id) ?? {
                no_cross_iteration = false
                next
            }
            if !mir_pass_place_uses_index(place, induction.values) -> no_cross_iteration = false
        }
    }
    no_early_exit :: !shape.early_exit
    fixed_reduction :: if reduction == .Val(row) -> mir_pass_fixed_reduction_candidate(function, analysis, shape, row) else -> MIRFixedReductionFact?{None}
    if reduction != None -> no_cross_iteration = fixed_reduction != None && effect_free && no_aliasing && no_early_exit
    packed :: shape.trip_count != None && accesses.len() > 0 && no_aliasing && no_cross_iteration && no_early_exit && effect_free
    rule :: if {
        shape.early_exit -> MIRVectorRule.EarlyExitSearch
        reduction != None -> MIRVectorRule.Reduction
        field_access -> MIRVectorRule.FieldAccess
        conditional -> MIRVectorRule.ConditionalAccumulate
        else -> MIRVectorRule.Elementwise
    }
    decision :: if {
        !shape.canonical -> MIROptimizationDecision.Rejected{reason: .MissingProof}
        shape.trip_count == None -> MIROptimizationDecision.Rejected{reason: .DynamicTripCount}
        shape.early_exit -> MIROptimizationDecision.Rejected{reason: .HasEarlyExit}
        !effect_free -> MIROptimizationDecision.Rejected{reason: .HasEffects}
        !no_aliasing -> MIROptimizationDecision.Rejected{reason: .MayAlias}
        reduction != None && fixed_reduction == None -> MIROptimizationDecision.Rejected{reason: .CrossIterationDependency}
        !no_cross_iteration -> MIROptimizationDecision.Rejected{reason: .CrossIterationDependency}
        accesses.len() == 0 -> MIROptimizationDecision.Rejected{reason: .MissingProof}
        else -> MIROptimizationDecision.Eligible
    }
    MIRVectorFact{
        loop_header: shape.header,
        cursor: index,
        body_blocks: shape.body_blocks,
        advance_block: shape.advance_block,
        rule: rule,
        accesses: accesses,
        layout: .Flat,
        element_type: element_type,
        packed: packed,
        lane_width: None,
        no_aliasing: no_aliasing,
        no_early_exit: no_early_exit,
        effect_free_body: effect_free,
        no_cross_iteration_dependencies: no_cross_iteration,
        fixed_reduction: fixed_reduction,
        span: shape.span,
        decision: decision,
    }
}

fn mir_pass_place_uses_index(place: MIRPlace, indices: [MIRValueID]) -> Bool Never! {
    loop projection in place.projections {
        if projection == {
            .Index(_, value, _, _, _, _, _) -> {
                if mir_pass_value_id_seen(indices, value) -> return true
            }
            else -> {}
        }
    }
    false
}

fn mir_pass_vector_access_put(rows: &[MIRVectorAccess], place: MIRPlace) Never! {
    field := MIRFieldID?{None}
    loop projection in place.projections {
        if projection == {
            .Field(id, _) -> field = Val(id)
            else -> {}
        }
    }
    root :: MIRVectorAccessRoot.Place{id: place.id}
    loop row in rows {
        if row.root == root && row.field == field -> return
    }
    &rows.push(MIRVectorAccess{root: root, field: field, layout: .Flat, column_index: None})
}

fn mir_pass_loop_accesses_do_not_alias(function: MIRFunction, analysis: MIRPassLoopAnalysis, roots: [MIRPlaceID], writes: [MIRPlaceID]) -> Bool Never! {
    if writes.len() == 0 || roots.len() == 0 -> return false
    loop write_id in writes {
        write :: mir_pass_loop_place(function, analysis, write_id) ?? return false
        if write.base == { .Local(_) -> {} else -> return false }
        if write.projections.len() == 0 -> return false
    }
    params := [MIRValueID]{}
    loop root_id in roots {
        place :: mir_pass_loop_place(function, analysis, root_id) ?? return false
        if place.base == {
            .Parameter(value) -> if !mir_pass_value_id_seen(params, value) -> &params.push(value)
            .Capture(_) | .Temporary(_) | .Static(_) -> return false
            .Local(_) -> {}
        }
    }
    params.len() <= 1
}

fn mir_pass_loop_reduction_no_alias(function: MIRFunction, analysis: MIRPassLoopAnalysis, roots: [MIRPlaceID], reduction: MIRPassLoopReduction) -> Bool Never! {
    accumulator :: mir_pass_loop_place(function, analysis, reduction.accumulator) ?? return false
    if accumulator.base == { .Local(_) -> {} else -> return false }
    params := [MIRValueID]{}
    loop root_id in roots {
        place :: mir_pass_loop_place(function, analysis, root_id) ?? return false
        if place.base == {
            .Parameter(value) -> if !mir_pass_value_id_seen(params, value) -> &params.push(value)
            .Capture(_) | .Temporary(_) | .Static(_) -> return false
            .Local(_) -> {}
        }
    }
    params.len() <= 1
}

fn mir_pass_checked_vectors(rows: [MIRVectorFact]) -> [MIRVectorFact] Never! {
    output :: loop row in rows if row.decision == .Eligible -> row
    output
}

struct MIRPassLoopReductionSeed { pub value: MIRValueID, pub operation: MIROpID }

fn mir_pass_fixed_reduction_candidate(function: MIRFunction, analysis: MIRPassLoopAnalysis, shape: MIRPassLoopShape, reduction: MIRPassLoopReduction) -> MIRFixedReductionFact? {
    lanes :: shape.trip_count ?? return None
    if shape.form != .Counted || !shape.canonical || shape.early_exit || lanes < 2 || lanes > 16 -> return None
    exit :: shape.exit ?? return None
    seed :: mir_pass_loop_reduction_seed(function, analysis, shape, reduction.accumulator) ?? return None
    source_operations := reduction.source_operations
    if !mir_pass_operation_id_seen(source_operations, seed.operation) -> &source_operations.push(seed.operation)
    Val(MIRFixedReductionFact{
        accumulator: reduction.accumulator,
        addend: reduction.addend,
        seed: seed.value,
        condition: reduction.condition,
        source_operations: source_operations,
        exit: exit,
        order: MIRFixedReductionOrder{lanes: lanes, seed_lane: 0, tree: .AdjacentPairsThenRoot},
    })
}

fn mir_pass_loop_reduction_seed(function: MIRFunction, analysis: MIRPassLoopAnalysis, shape: MIRPassLoopShape, accumulator: MIRPlaceID) -> MIRPassLoopReductionSeed? {
    header :: mir_pass_loop_block(function, analysis, shape.header) ?? return None
    if header.terminator == {
        .Branch(_, _, _) -> {}
        else -> return None
    }
    best_rank := -1
    best := MIRPassLoopReductionSeed?{None}
    loop block in function.blocks {
        if block.id == shape.header || mir_pass_block_id_seen(shape.body_blocks, block.id) || !mir_pass_dominates(analysis.dominators, block.id, shape.header) -> next
        index := 0
        loop instruction in block.instructions {
 
            if instruction.operation == {
                .WritePlace(place, value) -> if place == accumulator {
                    row :: mir_pass_dominator_row(analysis.dominators, block.id) ?? MIRPassDominatorRow{block: block.id, dominators: [MIRBlockID]{}}
                    rank :: row.dominators.len() * 100000 + index
                    if rank > best_rank {
                        best_rank = rank
                        best = Val(MIRPassLoopReductionSeed{value: value, operation: instruction.id})
                    }
                }
                else -> {}
            }
            index += 1
        }
    }
    best
}

