// Canonical loop shape, trip-count, vector-legality, and reduction proofs.
struct MirPassLoopShape {
    pub header: MirBlockId
    pub body: ?MirBlockId
    pub exit: ?MirBlockId
    pub form: MirLoopForm
    pub cursor: ?MirValueId
    pub induction: ?MirValueId
    pub advance_block: ?MirBlockId
    pub body_blocks: [MirBlockId]
    pub trip_count: ?Int
    pub canonical: Bool
    pub early_exit: Bool
    pub span: Span
}

struct MirPassLoopInduction {
    pub values: [MirValueId]
    pub places: [MirPlaceId]
    pub supported: Bool
}

struct MirLoopVectorCounts { pub loops: Int, pub vectors: Int }

struct MirPassLoopReduction {
    pub accumulator: MirPlaceId
    pub addend: MirValueId
    pub seed: MirValueId
    pub condition: ?MirValueId
    pub source_operations: [MirOpId]
}

fn mir_pass_derive_loop_and_vector_facts(program: &MirProgram) -> MirLoopVectorCounts {
    counts := MirLoopVectorCounts{loops: 0, vectors: 0}
    function_index := 0
    loop function_index < program.functions.len() {
        function := program.functions[function_index]
        previous_vectors :: function.optimization.vector_facts
        shapes :: mir_pass_loop_shapes(function)
        loops := [MirLoopFact]{}
        vectors := [MirVectorFact]{}
        loop shape in shapes {
            reduction :: mir_pass_loop_reduction(function, shape)
            copy_cost :: mir_pass_loop_copy_cost(function, shape)
            loop_decision :: if {
                shape.trip_count == None && shape.form != .Unconditional -> .Rejected(.DynamicTripCount)
                shape.canonical -> .Eligible
                else -> .Rejected(.MissingProof)
            }
            loops.push(MirLoopFact{
                header: shape.header,
                body: shape.body,
                exit: shape.exit,
                form: shape.form,
                trip_count: shape.trip_count,
                copy_cost: copy_cost,
                canonical: shape.canonical,
                span: shape.span,
                decision: loop_decision,
            })
            vector :: mir_pass_loop_vector_fact(function, shape, reduction, copy_cost, program.prelude_calls)
            vectors.push(vector)
        }
        loop vector in previous_vectors {
            if vector.fixed_reduction != None && !mir_pass_vector_header_seen(vectors, vector.loop_header) && mir_pass_fixed_reduction_fact_current(function, vector, program.prelude_calls) -> vectors.push(vector)
        }
        program.functions[function_index].optimization.loop_facts = loops
        program.functions[function_index].optimization.vector_facts = vectors
        program.functions[function_index].optimization.checked_vector_facts = mir_pass_checked_vectors(vectors)
        program.functions[function_index].optimization.auto_vectorizable = false
        program.functions[function_index].optimization.no_aliasing = vectors.len() > 0
        program.functions[function_index].optimization.no_early_exit = vectors.len() > 0
        program.functions[function_index].optimization.no_cross_iteration_dependencies = vectors.len() > 0
        loop vector in vectors {
            counts.vectors += 1
            program.functions[function_index].optimization.auto_vectorizable = program.functions[function_index].optimization.auto_vectorizable || vector.decision == .Eligible
            program.functions[function_index].optimization.no_aliasing = program.functions[function_index].optimization.no_aliasing && vector.no_aliasing
            program.functions[function_index].optimization.no_early_exit = program.functions[function_index].optimization.no_early_exit && vector.no_early_exit
            program.functions[function_index].optimization.no_cross_iteration_dependencies = program.functions[function_index].optimization.no_cross_iteration_dependencies && vector.no_cross_iteration_dependencies
        }
        counts.loops += loops.len()
        function_index += 1
    }
    counts
}

fn mir_pass_vector_header_seen(rows: [MirVectorFact], header: MirBlockId) -> Bool {
    loop row in rows { if row.loop_header == header -> return true }
    false
}

fn mir_pass_loop_shapes(function: MirFunction) -> [MirPassLoopShape] {
    shapes := [MirPassLoopShape]{}
    loop block in &function.blocks {
        if block.terminator == {
            .Branch(condition, then_target, else_target) -> {
                instruction :: mir_pass_instruction_for_value(function, condition) ?? next
                if instruction.operation == {
                    .LoopRangeHasNext(_, cursor) -> {
                        shape :: mir_pass_make_loop_shape(function, block, then_target, else_target, cursor, .Counted)
                        if !mir_pass_loop_header_seen(shapes, block.id) -> shapes.push(shape)
                    }
                    .LoopIterHasNext(_, cursor) -> {
                        shape :: mir_pass_make_loop_shape(function, block, then_target, else_target, cursor, .Iterator)
                        if !mir_pass_loop_header_seen(shapes, block.id) -> shapes.push(shape)
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    mir_pass_sort_loop_shapes(&shapes)
    shapes
}

fn mir_pass_make_loop_shape(
    function: MirFunction,
    header: MirBasicBlock,
    first: MirBlockId,
    second: MirBlockId,
    cursor: MirValueId,
    form: MirLoopForm,
) -> MirPassLoopShape {
    first_returns :: mir_pass_reaches_block(function, first, header.id)
    second_returns :: mir_pass_reaches_block(function, second, header.id)
    body :: if {
        first_returns && !second_returns -> Val(first)
        second_returns && !first_returns -> Val(second)
        else -> None
    }
    exit :: if {
        first_returns && !second_returns -> Val(second)
        second_returns && !first_returns -> Val(first)
        else -> None
    }
    body_blocks :: if body == .Val(body_id) -> mir_pass_loop_body_blocks(function, body_id, header.id) else -> [MirBlockId]{}
    init :: mir_pass_loop_init(function, cursor, form)
    induction :: mir_pass_loop_induction_value(function, body_blocks, cursor, form)
    trip :: mir_pass_loop_trip_count(function, init)
    advance :: mir_pass_loop_advance_block(function, body_blocks, cursor, form)
    early_exit :: body == None || mir_pass_loop_has_early_exit(function, body_blocks, header.id)
    MirPassLoopShape{
        header: header.id,
        body: body,
        exit: exit,
        form: form,
        cursor: Val(cursor),
        induction: induction,
        advance_block: advance,
        body_blocks: body_blocks,
        trip_count: trip,
        canonical: body != None && exit != None && init != None && advance != None,
        early_exit: early_exit,
        span: header.span,
    }
}

fn mir_pass_loop_header_seen(rows: [MirPassLoopShape], header: MirBlockId) -> Bool {
    loop row in rows { if row.header == header -> return true }
    false
}

fn mir_pass_sort_loop_shapes(rows: &[MirPassLoopShape]) {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && current.header.value < rows[cursor - 1].header.value {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_instruction_for_value(function: MirFunction, value: MirValueId) -> ?MirInstruction {
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            if instruction.result == Val(value) -> return Val(instruction)
        }
    }
    None
}

fn mir_pass_loop_init(function: MirFunction, cursor: MirValueId, form: MirLoopForm) -> ?MirInstruction {
    loop block in &function.blocks {
        loop instruction in &block.instructions {
            if instruction.result != Val(cursor) -> next
            if instruction.operation == {
                .LoopRangeInit(_, _, _, _, _) -> if form == .Counted -> return Val(instruction)
                .LoopIterInit(_, _, _, _, _) -> if form == .Iterator -> return Val(instruction)
                else -> {}
            }
        }
    }
    None
}

fn mir_pass_loop_induction_value(function: MirFunction, body: [MirBlockId], cursor: MirValueId, form: MirLoopForm) -> ?MirValueId {
    wanted :: if form == .Counted -> MirOperation.LoopRangeValue(MirPreludeCallId{value: 0}, cursor) else -> MirOperation.LoopIterValue(MirPreludeCallId{value: 0}, cursor)
    loop block_id in body {
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop instruction in &block.instructions {
            if instruction.operation == wanted && instruction.result != None -> return instruction.result
            if instruction.operation == {
                .LoopRangeValue(_, value) -> if form == .Counted && value == cursor -> return instruction.result
                .LoopIterValue(_, value) -> if form == .Iterator && value == cursor -> return instruction.result
                else -> {}
            }
        }
    }
    None
}

fn mir_pass_loop_induction_model(function: MirFunction, shape: MirPassLoopShape) -> MirPassLoopInduction {
    induction :: shape.induction ?? return MirPassLoopInduction{values: [MirValueId]{}, places: [MirPlaceId]{}, supported: false}
    values := [MirValueId]{induction}
    places := [MirPlaceId]{}
    supported := true
    loop block_id in shape.body_blocks {
        block :: mir_pass_find_block(function.blocks, block_id) ?? return MirPassLoopInduction{values: values, places: places, supported: false}
        loop instruction in block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> if value == induction {
                    place :: mir_pass_find_place(function.places, place_id) ?? return MirPassLoopInduction{values: values, places: places, supported: false}
                    if place.base == {
                        .Local(_) -> if place.projections.len() != 0 -> supported = false
                        else -> supported = false
                    }
                    if !mir_pass_place_id_seen(places, place_id) -> places.push(place_id)
                }
                else -> {}
            }
        }
    }
    if places.len() > 1 -> supported = false
    if supported {
        dominators :: mir_pass_dominators(function)
        loop block_id in shape.body_blocks {
            block :: mir_pass_find_block(function.blocks, block_id) ?? return MirPassLoopInduction{values: values, places: places, supported: false}
            loop (instruction_index, instruction) in block.instructions {
                if instruction.operation == {
                    .WritePlace(place_id, value) -> if mir_pass_place_id_seen(places, place_id) && value != induction -> supported = false
                    .ReadPlace(place_id) -> if mir_pass_place_id_seen(places, place_id) {
                        value :: instruction.result ?? return MirPassLoopInduction{values: values, places: places, supported: false}
                        if {
                            !mir_pass_loop_induction_write_dominates(function, shape, place_id, block_id, instruction_index, dominators) -> supported = false
                            !mir_pass_value_id_seen(values, value) -> values.push(value)
                            else -> {}
                        }
                    }
                    else -> {}
                }
            }
        }
    }
    MirPassLoopInduction{values: values, places: places, supported: supported}
}

fn mir_pass_loop_induction_write_dominates(
    function: MirFunction,
    shape: MirPassLoopShape,
    place_id: MirPlaceId,
    read_block: MirBlockId,
    read_index: Int,
    dominators: [MirPassDominatorRow],
) -> Bool {
    induction :: shape.induction ?? return false
    loop block_id in shape.body_blocks {
        block :: mir_pass_find_block(function.blocks, block_id) ?? return false
        loop (instruction_index, instruction) in block.instructions {
            if instruction.operation == {
                .WritePlace(write_place, value) -> if write_place == place_id && value == induction {
                    if {
                        block_id == read_block -> {
                            if instruction_index < read_index -> return true
                        }
                        mir_pass_dominates(dominators, block_id, read_block) -> return true
                        else -> {}
                    }
                }
                else -> {}
            }
        }
    }
    false
}

fn mir_pass_loop_induction_place_seen(induction: MirPassLoopInduction, place: MirPlaceId) -> Bool {
    mir_pass_place_id_seen(induction.places, place)
}

fn mir_pass_loop_trip_count(function: MirFunction, init: ?MirInstruction) -> ?Int {
    instruction :: init ?? return None
    if instruction.operation == {
        .LoopRangeInit(_, start, end, step, exclusive) -> {
            constants :: mir_pass_collect_scalar_constants(function)
            start_constant :: mir_pass_constant_for(constants, start) ?? return None
            end_constant :: mir_pass_constant_for(constants, end) ?? return None
            first :: if start_constant == {
                .Int(value, _, _) -> value
                else -> return None
            }
            last :: if end_constant == {
                .Int(value, _, _) -> value
                else -> return None
            }
            step_value :: if step == {
                .Val(step_id) -> {
                    step_constant :: mir_pass_constant_for(constants, step_id) ?? return None
                    if step_constant == {
                        .Int(value, _, _) -> value
                        else -> return None
                    }
                }
                else -> 1
            }
            mir_pass_range_trip_count(first, last, step_value, exclusive)
        }
        else -> None
    }
}

fn mir_pass_range_trip_count(start: Int, end: Int, step: Int, exclusive: Bool) -> ?Int {
    if step == 0 -> return None
    count := 0
    magnitude := 0
    if step > 0 {
        if start > end || start == end && exclusive -> return Val(0)
        distance :: mir_pass_checked_sub(end, start) ?? return None
        count = if exclusive -> distance else -> mir_pass_checked_add(distance, 1) ?? return None
        magnitude = step
    } else {
        if start < end || start == end && exclusive -> return Val(0)
        distance :: mir_pass_checked_sub(start, end) ?? return None
        count = if exclusive -> distance else -> mir_pass_checked_add(distance, 1) ?? return None
        magnitude :: mir_pass_checked_sub(0, step) ?? return None
    }
    adjusted :: mir_pass_checked_add(count, magnitude - 1) ?? return None
    trip :: adjusted / magnitude
    if trip < 0 -> return None
    Val(trip)
}

fn mir_pass_reaches_block(function: MirFunction, start: MirBlockId, target: MirBlockId) -> Bool {
    pending := [MirBlockId]{start}
    visited := [MirBlockId]{}
    cursor := 0
    loop cursor < pending.len() {
        block_id := pending[cursor]
        cursor += 1
        if block_id == target -> return true
        if mir_pass_block_id_seen(visited, block_id) -> next
        visited.push(block_id)
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop successor in mir_terminator_targets(block.terminator) {
            if !mir_pass_block_id_seen(visited, successor) -> pending.push(successor)
        }
    }
    false
}

fn mir_pass_loop_body_blocks(function: MirFunction, body: MirBlockId, header: MirBlockId) -> [MirBlockId] {
    pending := [MirBlockId]{body}
    visited := [MirBlockId]{}
    cursor := 0
    loop cursor < pending.len() {
        block_id := pending[cursor]
        cursor += 1
        if block_id == header || mir_pass_block_id_seen(visited, block_id) -> next
        if !mir_pass_reaches_block(function, block_id, header) -> next
        visited.push(block_id)
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop successor in mir_terminator_targets(block.terminator) {
            if successor != header && !mir_pass_block_id_seen(visited, successor) -> pending.push(successor)
        }
    }
    visited
}

fn mir_pass_loop_advance_block(function: MirFunction, body: [MirBlockId], cursor: MirValueId, form: MirLoopForm) -> ?MirBlockId {
    loop block_id in body {
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop instruction in &block.instructions {
            matched :: if instruction.operation == {
                .LoopRangeAdvance(_, value) -> form == .Counted && value == cursor
                .LoopIterAdvance(_, value) -> form == .Iterator && value == cursor
                else -> false
            }
            if matched -> return Val(block_id)
        }
    }
    None
}

fn mir_pass_loop_has_early_exit(function: MirFunction, body: [MirBlockId], header: MirBlockId) -> Bool {
    loop block_id in body {
        block :: mir_pass_find_block(function.blocks, block_id) ?? return true
        if block.terminator == {
            .Return(_) | .Yield(_, _) | .Break(_, _) | .Unreachable(_) -> return true
            else -> {}
        }
        loop successor in mir_terminator_targets(block.terminator) {
            if successor != header && !mir_pass_block_id_seen(body, successor) -> return true
        }
    }
    false
}

fn mir_pass_loop_copy_cost(function: MirFunction, shape: MirPassLoopShape) -> MirCopyCost {
    count := 0
    loop block_id in shape.body_blocks {
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop instruction in &block.instructions {
            if instruction.operation == {
                .Copy(_, _) -> count += 1
                .Semantic(semantic) -> {
                    if semantic == {
                        .BuiltinMethod(_, _, _, _, _) -> count += 1
                        else -> {}
                    }
                }
                else -> {}
            }
        }
    }
    if count == 0 -> MirCopyCost.NoCopy else -> MirCopyCost.PerIteration(count)
}

fn mir_pass_loop_reduction(function: MirFunction, shape: MirPassLoopShape) -> ?MirPassLoopReduction {
    loop block_id in shape.body_blocks {
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        loop instruction in &block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> {
                    place :: mir_pass_find_place(function.places, place_id) ?? next
                    if place.projections.len() > 0 -> next
                    definition :: mir_pass_instruction_for_value(function, value) ?? next
                    if definition.operation == {
                        .Binary(.Add, .Primitive, _, left, right) -> {
                            if left == right -> next
                            read_left :: mir_pass_instruction_for_value(function, left) ?? next
                            read_right :: mir_pass_instruction_for_value(function, right) ?? next
                            if mir_pass_operation_reads_place(read_left.operation, place_id) {
                                return Val(MirPassLoopReduction{accumulator: place_id, addend: right, seed: left, condition: None, source_operations: [MirOpId]{instruction.id, definition.id}})
                            }
                            if mir_pass_operation_reads_place(read_right.operation, place_id) {
                                return Val(MirPassLoopReduction{accumulator: place_id, addend: left, seed: right, condition: None, source_operations: [MirOpId]{instruction.id, definition.id}})
                            }
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
        }
    }
    None
}

fn mir_pass_operation_reads_place(operation: MirOperation, place: MirPlaceId) -> Bool {
    if operation == {
        .ReadPlace(value) | .MovePlace(value) -> value == place
        else -> false
    }
}

fn mir_pass_loop_vector_fact(
    function: MirFunction,
    shape: MirPassLoopShape,
    reduction: ?MirPassLoopReduction,
    copy_cost: MirCopyCost,
    prelude_calls: [MirPreludeCall],
) -> MirVectorFact {
    index :: shape.induction
    induction :: mir_pass_loop_induction_model(function, shape)
    accesses := [MirVectorAccess]{}
    element_type := None
    written_roots := [MirPlaceId]{}
    roots := [MirPlaceId]{}
    effect_free := shape.canonical && induction.supported
    conditional := false
    field_access := false
    loop block_id in shape.body_blocks {
        block :: mir_pass_find_block(function.blocks, block_id) ?? next
        if block.terminator == {
            .Branch(_, _, _) | .Switch(_, _, _) -> conditional = true
            else -> {}
        }
        loop instruction in &block.instructions {
            if instruction.operation == {
                .WritePlace(place_id, value) -> {
                    place :: mir_pass_find_place(function.places, place_id) ?? next
                    if {
                        mir_pass_loop_induction_place_seen(induction, place_id) -> {
                            if !mir_pass_value_id_seen(induction.values, value) -> effect_free = false
                        }
                        mir_pass_place_uses_index(place, induction.values) -> {
                            if !mir_pass_place_id_seen(written_roots, place_id) -> written_roots.push(place_id)
                            if !mir_pass_place_id_seen(roots, place_id) -> roots.push(place_id)
                            mir_pass_vector_access_put(&accesses, place)
                        }
                        reduction.map(value -> value.accumulator == place_id) ?? false -> {
                            if !mir_pass_place_id_seen(written_roots, place_id) -> written_roots.push(place_id)
                        }
                        else -> effect_free = false
                    }
                }
                .ReadPlace(place_id) -> {
                    place :: mir_pass_find_place(function.places, place_id) ?? {
                        effect_free = false
                        next
                    }
                    if {
                        mir_pass_loop_induction_place_seen(induction, place_id) -> {
                            if instruction.result == .Val(result) {
                                if !mir_pass_value_id_seen(induction.values, result) -> effect_free = false
                            } else {
                                effect_free = false
                            }
                        }
                        mir_pass_place_uses_index(place, induction.values) -> {
                            if !mir_pass_place_id_seen(roots, place_id) -> roots.push(place_id)
                            mir_pass_vector_access_put(&accesses, place)
                            if place.projections.len() > 0 {
                                if place.projections[place.projections.len() - 1] == { .Field(_, _) -> field_access else -> {} }
                            }
                            element_type = Val(place.ty)
                        }
                        else -> {}
                    }
                }
                .Binary(op, dispatch, _, _, _) -> {
                    if dispatch != .Primitive || !(op == .Add || op == .Sub || op == .Mul || op == .Div || op == .Eq || op == .Lt || op == .Le || op == .Gt || op == .Ge) -> effect_free = false
                }
                .Unary(_, _) | .Constant(_) | .Phi(_) | .Copy(_, _) | .Move(_) | .LoopRangeHasNext(_, _) | .LoopRangeValue(_, _) | .LoopRangeAdvance(_, _) | .LoopIterHasNext(_, _) | .LoopIterValue(_, _) | .LoopIterAdvance(_, _) -> {}
                .Index(_, _, _, kind, _, _, _) -> if kind != .FixedListProof -> effect_free = false
                .Convert(_, _, _, _) -> effect_free = false
                else -> effect_free = false
            }
            loop place_id in mir_pass_operation_place_refs(instruction.operation) {
                place :: mir_pass_find_place(function.places, place_id) ?? next
                loop projection in place.projections {
                    if projection == { .Index(_, _, call, _, _, _, _) -> if !mir_pass_prelude_is_pure(prelude_calls, call) -> effect_free = false else -> {} }
                }
            }
        }
    }
    no_aliasing :: if reduction == .Val(row) -> mir_pass_loop_reduction_no_alias(function, roots, row) else -> mir_pass_loop_accesses_do_not_alias(function, roots, written_roots)
    no_cross_iteration := roots.len() > 0 && written_roots.len() > 0 && no_aliasing && reduction == None && effect_free
    if reduction == None && written_roots.len() > 0 {
        loop root_id in written_roots {
            place :: mir_pass_find_place(function.places, root_id) ?? {
                no_cross_iteration = false
                next
            }
            if !mir_pass_place_uses_index(place, induction.values) -> no_cross_iteration = false
        }
    }
    no_early_exit :: !shape.early_exit
    fixed_reduction :: if reduction == .Val(row) -> mir_pass_fixed_reduction_candidate(function, shape, row) else -> None
    if reduction != None -> no_cross_iteration = fixed_reduction != None && effect_free && no_aliasing && no_early_exit
    packed :: shape.trip_count != None && accesses.len() > 0 && no_aliasing && no_cross_iteration && no_early_exit && effect_free
    rule :: if {
        shape.early_exit -> MirVectorRule.EarlyExitSearch
        reduction != None -> MirVectorRule.Reduction
        field_access -> MirVectorRule.FieldAccess
        conditional -> MirVectorRule.ConditionalAccumulate
        else -> MirVectorRule.Elementwise
    }
    decision :: if {
        !shape.canonical -> .Rejected(.MissingProof)
        shape.trip_count == None -> .Rejected(.DynamicTripCount)
        shape.early_exit -> .Rejected(.HasEarlyExit)
        !effect_free -> .Rejected(.HasEffects)
        !no_aliasing -> .Rejected(.MayAlias)
        reduction != None && fixed_reduction == None -> .Rejected(.CrossIterationDependency)
        !no_cross_iteration -> .Rejected(.CrossIterationDependency)
        accesses.len() == 0 -> .Rejected(.MissingProof)
        else -> .Eligible
    }
    MirVectorFact{
        loop_header: shape.header,
        cursor: index,
        body_blocks: shape.body_blocks,
        advance_block: shape.advance_block,
        rule: rule,
        accesses: accesses,
        layout: .Flat,
        element_type: element_type,
        packed: packed,
        lane_width: None,
        no_aliasing: no_aliasing,
        no_early_exit: no_early_exit,
        effect_free_body: effect_free,
        no_cross_iteration_dependencies: no_cross_iteration,
        fixed_reduction: fixed_reduction,
        span: shape.span,
        decision: decision,
    }
}

fn mir_pass_place_uses_index(place: MirPlace, indices: [MirValueId]) -> Bool {
    loop projection in place.projections {
        if projection == { .Index(_, value, _, _, _, _, _) -> if mir_pass_value_id_seen(indices, value) -> return true else -> {} }
    }
    false
}

fn mir_pass_vector_access_put(rows: &[MirVectorAccess], place: MirPlace) {
    field := None
    loop projection in place.projections {
        if projection == {
            .Field(id, _) -> field = Val(id)
            else -> {}
        }
    }
    root :: MirVectorAccessRoot.Place(place.id)
    loop row in rows {
        if row.root == root && row.field == field -> return
    }
    rows.push(MirVectorAccess{root: root, field: field, layout: .Flat, column_index: None})
}

fn mir_pass_loop_accesses_do_not_alias(function: MirFunction, roots: [MirPlaceId], writes: [MirPlaceId]) -> Bool {
    if writes.len() == 0 || roots.len() == 0 -> return false
    loop write_id in writes {
        write :: mir_pass_find_place(function.places, write_id) ?? return false
        if write.base == { .Local(_) -> {} else -> return false }
        if write.projections.len() == 0 -> return false
    }
    params := [MirValueId]{}
    loop root_id in roots {
        place :: mir_pass_find_place(function.places, root_id) ?? return false
        if place.base == {
            .Parameter(value) -> if !mir_pass_value_id_seen(params, value) -> params.push(value)
            .Capture(_) | .Temporary(_) | .Static(_) -> return false
            .Local(_) -> {}
        }
    }
    params.len() <= 1
}

fn mir_pass_loop_reduction_no_alias(function: MirFunction, roots: [MirPlaceId], reduction: MirPassLoopReduction) -> Bool {
    accumulator :: mir_pass_find_place(function.places, reduction.accumulator) ?? return false
    if accumulator.base == { .Local(_) -> {} else -> return false }
    params := [MirValueId]{}
    loop root_id in roots {
        place :: mir_pass_find_place(function.places, root_id) ?? return false
        if place.base == {
            .Parameter(value) -> if !mir_pass_value_id_seen(params, value) -> params.push(value)
            .Capture(_) | .Temporary(_) | .Static(_) -> return false
            .Local(_) -> {}
        }
    }
    params.len() <= 1
}

fn mir_pass_checked_vectors(rows: [MirVectorFact]) -> [MirVectorFact] {
    output :: loop row in rows if row.decision == .Eligible -> row
    output
}

struct MirPassLoopReductionSeed { pub value: MirValueId, pub operation: MirOpId }

fn mir_pass_fixed_reduction_candidate(function: MirFunction, shape: MirPassLoopShape, reduction: MirPassLoopReduction) -> ?MirFixedReductionFact {
    lanes :: shape.trip_count ?? return None
    if shape.form != .Counted || !shape.canonical || shape.early_exit || lanes < 2 || lanes > 16 -> return None
    exit :: shape.exit ?? return None
    seed :: mir_pass_loop_reduction_seed(function, shape, reduction.accumulator) ?? return None
    source_operations := reduction.source_operations
    if !mir_pass_operation_id_seen(source_operations, seed.operation) -> source_operations.push(seed.operation)
    Val(MirFixedReductionFact{
        accumulator: reduction.accumulator,
        addend: reduction.addend,
        seed: seed.value,
        condition: reduction.condition,
        source_operations: source_operations,
        exit: exit,
        order: MirFixedReductionOrder{lanes: lanes, seed_lane: 0, tree: .AdjacentPairsThenRoot},
    })
}

fn mir_pass_loop_reduction_seed(function: MirFunction, shape: MirPassLoopShape, accumulator: MirPlaceId) -> ?MirPassLoopReductionSeed {
    header :: mir_pass_find_block(function.blocks, shape.header) ?? return None
    if header.terminator == {
        .Branch(_, _, _) -> {}
        else -> return None
    }
    dominators :: mir_pass_dominators(function)
    best_rank := -1
    best := None
    loop block in &function.blocks {
        if block.id == shape.header || mir_pass_block_id_seen(shape.body_blocks, block.id) || !mir_pass_dominates(dominators, block.id, shape.header) -> next
        index := 0
        loop instruction in &block.instructions {
 
            if instruction.operation == {
                .WritePlace(place, value) -> if place == accumulator {
                    row :: mir_pass_dominator_row(dominators, block.id) ?? MirPassDominatorRow{block: block.id, dominators: [MirBlockId]{}}
                    rank :: row.dominators.len() * 100000 + index
                    if rank > best_rank {
                        best_rank = rank
                        best = Val(MirPassLoopReductionSeed{value: value, operation: instruction.id})
                    }
                }
                else -> {}
            }
            index += 1
        }
    }
    best
}

