use jet_foundation.[MIRFunction, MIRBasicBlock, MIRBlockID, MIRValueID, MIRPlaceID, MIROpID, MIRInstruction, MIRConstant, MIRCopyCost, MIRLoopFact, MIRPreludeCallID, MIRPreludeCall, MIRCallArg, MIRBinaryOp, MIRPlaceBase, MIRStructLayout, MIRTypeDef, MIRType, MIRPlace, MIRFieldID, MIRVectorFact, MIRVectorAccess, MIRVectorAccessRoot, MIRVectorLayout, MIRVectorRule, MIRFixedReductionFact, MIROptimizationDecision, mir_operation_value_uses, mir_terminator_targets]
use jet_optimizer.[CanonicalLoopShape, CanonicalLoopRange, canonical_range_for_cursor, fixed_reduction_plan, mir_pass_collect_scalar_constants, operation_place_refs, mir_place_path, mir_place_paths_overlap, vector_operation_has_effect, vector_memory_facts, is_packable_type, is_packable_for_rule, lane_width, place_root]
use jet_foundation.MIROptimization.Acceleration.[D_FRED1_FIXED_ORDER]
// Private helpers extend Facts/LoopVector; canonical shapes/ranges and shared pass helpers live there.
// Composite ID map/set keys retain exact equality/hash semantics: GATE #4499.

// Rust: crates/jet-foundation/src/MIROptimization.rs:10016
fn scalar_loop_condition(function: MIRFunction, condition: MIRValueID) -> (MIRValueID, MIRPlaceID, MIRValueID, Bool)? {
    instruction :: find_value_instruction(function, condition) ?? return None
    if instruction.operation == {
        .Binary(op, .Primitive, _, left, right) -> {
            exclusive :: if { op == .Lt -> true; op == .Le -> false; else -> return None }
            cursor_place :: direct_read_place(function, left) ?? return None
            Val((left, cursor_place, right, exclusive))
        }
        else -> None
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10039
fn scalar_loop_advance(function: MIRFunction, block: MIRBasicBlock, header: MIRBlockID, cursor_place: MIRPlaceID) -> (MIROpID, MIRValueID)? {
    if block.terminator != .Jump(header) -> return None
    write := MIRInstruction?{None}
    loop instruction in block.instructions {
        if instruction.operation == .WritePlace(place, _) && place == cursor_place {
            if write != None -> return None
            write = Val(instruction)
        }
    }
    write_row :: write ?? return None
    value :: if write_row.operation == .WritePlace(_, value) -> value else -> return None
    update :: find_value_instruction(function, value) ?? return None
    step :: if update.operation == .Binary(.Add, .Primitive, _, left, right) {
        if {
            direct_read_place(function, left) == Val(cursor_place) -> right
            direct_read_place(function, right) == Val(cursor_place) -> left
            else -> return None
        }
    } else -> return None
    reads := 0
    loop instruction in block.instructions {
        if instruction.operation == {
            .Constant(_) -> {}
            .ReadPlace(place) -> { if place != cursor_place -> return None; reads += 1 }
            .Binary(_, _, _, _, _) -> if instruction.id != update.id -> return None
            .WritePlace(place, _) -> if place != cursor_place || instruction.id != write_row.id -> return None
            else -> return None
        }
    }
    if reads != 1 -> return None
    seen := [MIRValueID:Bool]{}
    if value_depends_on_place(function, step, cursor_place, &seen) -> None else -> Val((write_row.id, step))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10111
fn direct_read_place(function: MIRFunction, value: MIRValueID) -> MIRPlaceID? {
    instruction :: find_value_instruction(function, value) ?? return None
    if instruction.operation == .ReadPlace(place) -> Val(place) else -> None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10118
fn cursor_value_matches(function: MIRFunction, value: MIRValueID, cursor: MIRValueID, cursor_place: MIRPlaceID?) -> Bool {
    seen := [MIRValueID:Bool]{}
    cursor_value_matches_inner(function, value, cursor, cursor_place, &seen)
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:10124
fn cursor_value_matches_inner(function: MIRFunction, value: MIRValueID, cursor: MIRValueID, cursor_place: MIRPlaceID?, seen: &[MIRValueID:Bool]) -> Bool {
    if value == cursor -> return true
    if seen.get(value) != None -> return false
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return false
    if instruction.operation == {
        .ReadPlace(place) -> cursor_place == Val(place)
        .LoopRangeValue(_, source) | .LoopIterValue(_, source) -> source == cursor
        .Copy(source, _) | .Move(source) | .TraitBox(source, _) | .AttachTag(source, _) | .Convert(source, _, _, _) -> cursor_value_matches_inner(function, source, cursor, cursor_place, seen)
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10163
fn scalar_int_constant(constants: [U64:MIRConstant], value: MIRValueID) -> I64? {
    constant :: constants.get(value.value) ?? return None
    if constant == .Int(value, _, _) -> Val(value) else -> None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10173
fn value_depends_on_place(function: MIRFunction, value: MIRValueID, place: MIRPlaceID, seen: &[MIRValueID:Bool]) -> Bool {
    if seen.get(value) != None -> return true
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return true
    loop candidate in operation_place_refs(instruction.operation) {
        if places_overlap(function, candidate, place) -> return true
    }
    loop operand in mir_operation_value_uses(instruction.operation) {
        if value_depends_on_place(function, operand, place, seen) -> return true
    }
    false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10198
fn places_overlap(function: MIRFunction, left: MIRPlaceID, right: MIRPlaceID) -> Bool {
    left_row :: function.places.find(fn(place) { place.id == left }) ?? return true
    right_row :: function.places.find(fn(place) { place.id == right }) ?? return true
    mir_place_paths_overlap(mir_place_path(left_row), mir_place_path(right_row))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10208
fn scalar_cursor_references_are_clean(function: MIRFunction, header: MIRBlockID, condition: MIRValueID, blocks: [MIRBlockID], advance: MIRBlockID, advance_write: MIROpID, cursor_place: MIRPlaceID) -> Bool {
    header_block :: function.blocks.find(fn(block) { block.id == header }) ?? return false
    header_ref := MIRInstruction?{None}
    loop instruction in header_block.instructions {
        references := false
        loop place in operation_place_refs(instruction.operation) { if places_overlap(function, place, cursor_place) -> references = true }
        if references {
            if header_ref != None -> return false
            header_ref = Val(instruction)
        }
    }
    reference :: header_ref ?? return false
    if reference.operation != .ReadPlace(cursor_place) || reference.result != Val(condition) -> return false
    loop block_id in blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? return false
        loop instruction in block.instructions {
            references := false
            loop place in operation_place_refs(instruction.operation) { if places_overlap(function, place, cursor_place) -> references = true }
            if !references -> next
            if block_id == advance {
                allowed :: (instruction.id == advance_write && if instruction.operation == .WritePlace(place, _) -> place == cursor_place else -> false) || instruction.operation == .ReadPlace(cursor_place)
                if !allowed -> return false
            } else if instruction.operation != .ReadPlace(cursor_place) -> return false
        }
    }
    true
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10273
fn scalar_loop_cursor_value(function: MIRFunction, blocks: [MIRBlockID], advance: MIRBlockID, cursor_place: MIRPlaceID) -> MIRValueID? {
    reads := [MIRValueID]{}
    loop block_id in blocks {
        if block_id == advance -> next
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? return None
        loop instruction in block.instructions {
            if instruction.operation == .ReadPlace(place) && place == cursor_place {
                if instruction.result == .Val(result) -> &reads.push(result)
            }
        }
    }
    loop value in reads { if loop_value_is_indexed(function, blocks, advance, value) -> return Val(value) }
    reads.get(0)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10302
fn loop_value_is_indexed(function: MIRFunction, blocks: [MIRBlockID], advance: MIRBlockID, value: MIRValueID) -> Bool {
    loop block_id in blocks {
        if block_id == advance -> next
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        loop instruction in block.instructions {
            if instruction.operation == .Index(_, _, index, _, _, _, _) && index == value -> return true
            loop place_id in operation_place_refs(instruction.operation) {
                place :: function.places.find(fn(place) { place.id == place_id }) ?? next
                loop projection in place.projections {
                    if projection == .Index(_, index, _, _, _, _, _) && index == value -> return true
                }
            }
        }
    }
    false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10334
// First duplicate block ID wins, matching linear find.
fn block_positions(function: MIRFunction) -> [MIRBlockID:Int] {
    positions := [MIRBlockID:Int]{}
    loop (position, block) in function.blocks {
        if positions.get(block.id) == None -> &positions.add(block.id, position).drop("first position")
    }
    positions
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10345
// Iterative Tarjan: linear in blocks plus edges.
fn cyclic_block_positions(function: MIRFunction, positions: [MIRBlockID:Int]) -> [Bool] {
    count :: function.blocks.len()
    successors := [[Int]]{}
    loop block in function.blocks {
        row := [Int]{}
        loop target in mir_terminator_targets(block.terminator) {
            if positions.get(target) == .Val(position) -> &row.push(position)
        }
        &successors.push(^row)
    }
    order := [Int].filled(count, -1)
    low := [Int].filled(count, 0)
    on_stack := [Bool].filled(count, false)
    stack := [Int]{}
    cyclic := [Bool].filled(count, false)
    next_order := 0
    frames := [(Int, Int)]{}
    loop root in 0..<count {
        if order[root] != -1 -> next
        order[root] = next_order
        low[root] = next_order
        next_order += 1
        &stack.push(root)
        on_stack[root] = true
        &frames.push((root, 0))
        loop !frames.is_empty() {
            last :: frames.len() - 1
            node :: frames[last].0
            if successors[node].get(frames[last].1) == .Val(target) {
                frames[last].1 += 1
                if order[target] == -1 {
                    order[target] = next_order
                    low[target] = next_order
                    next_order += 1
                    &stack.push(target)
                    on_stack[target] = true
                    &frames.push((target, 0))
                } else if on_stack[target] -> low[node] = low[node].min(order[target])
                next
            }
            _ :: &frames.pop()
            if frames.last() == .Val(parent) -> low[parent.0] = low[parent.0].min(low[node])
            if low[node] == order[node] {
                start :: stack.rposition(fn(member) { member == node }).expect("a component root is on the Tarjan stack")
                on_cycle :: stack.len() - start > 1 || successors[node].contains(node)
                loop stack.len() > start {
                    member :: &stack.pop().expect("component member")
                    on_stack[member] = false
                    cyclic[member] = on_cycle
                }
            }
        }
    }
    cyclic
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10418
fn collect_loop_region(function: MIRFunction, positions: [MIRBlockID:Int], header: MIRBlockID, body: MIRBlockID, exit: MIRBlockID?) -> [MIRBlockID] {
    pending := [body]
    seen := [MIRBlockID:Bool]{}
    region := [MIRBlockID]{}
    loop pending.pop() == .Val(block_id) {
        if block_id == header || exit == Val(block_id) || seen.get(block_id) != None -> next
        &seen.add(block_id, true).drop("absent block")
        position :: positions.get(block_id) ?? next
        block :: function.blocks[position]
        &region.push(block_id)
        loop target in mir_terminator_targets(block.terminator) {
            if target != header && exit != Val(target) -> &pending.push(target)
        }
    }
    &region.sort()
    region
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10447
fn loop_trip_count_for_cursor(function: MIRFunction, cursor: MIRValueID) -> U64? {
    range := canonical_range_for_cursor(function, cursor)
    if range == None {
        ranges := [CanonicalLoopRange]{}
        loop block in function.blocks {
            loop instruction in block.instructions {
                if instruction.operation == .LoopRangeInit(_, start, end, step, exclusive) -> &ranges.push(CanonicalLoopRange{start: start, end: end, step: step, exclusive: exclusive})
            }
        }
        if ranges.len() == 1 -> range = Val(ranges[0])
    }
    selected :: range ?? return None
    loop_trip_count(function, selected)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10477
fn loop_trip_count(function: MIRFunction, range: CanonicalLoopRange) -> U64? {
    constants :: mir_pass_collect_scalar_constants(function)
    start :: scalar_int_constant(constants, range.start) ?? return None
    end :: scalar_int_constant(constants, range.end) ?? return None
    step := I64{1}
    if range.step == .Val(value) -> step = scalar_int_constant(constants, value) ?? 1
    if step == 0 -> return None
    if step > 0 {
        if start > end || (start == end && range.exclusive) -> return Val(0)
        distance :: end.checked_sub(start) ?? return None
        count :: if range.exclusive -> distance else -> distance.checked_add(1) ?? return None
        adjustment :: step.checked_sub(1) ?? return None
        numerator :: count.checked_add(adjustment) ?? return None
        U64.try_from(numerator / step).ok()
    } else {
        if start < end || (start == end && range.exclusive) -> return Val(0)
        distance :: start.checked_sub(end) ?? return None
        magnitude :: step.checked_neg() ?? return None
        count :: if range.exclusive -> distance else -> distance.checked_add(1) ?? return None
        adjustment :: magnitude.checked_sub(1) ?? return None
        numerator :: count.checked_add(adjustment) ?? return None
        U64.try_from(numerator / magnitude).ok()
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10523
fn loop_copy_cost(function: MIRFunction, blocks: [MIRBlockID]) -> MIRCopyCost {
    copies := U32{0}
    loop block_id in blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? return .Unknown
        loop instruction in block.instructions {
            if instruction.operation == {
                .Copy(_, _) -> copies = copies.saturating_add(1)
                .TraitBox(_, _) | .BuildList(_, _) | .BuildMap(_) -> return .Unknown
                .Call(_, args, _) | .CoreCall(_, _, args, _, _, _) | .IndirectCall(_, args, _) -> {
                    count := U32{0}
                    loop arg in args { if arg.implicit_clone || arg.shared_auto_clone || arg.widen_fixed_to_list -> count += 1 }
                    copies = copies.saturating_add(count)
                }
                .Semantic(operation) -> if operation == {
                    .StaticPreludeCall(_, args, _, _) | .ClosureMethod(_, args, _) | .HostCall(_, args) -> {
                        count := U32{0}
                        loop arg in args { if arg.implicit_clone || arg.shared_auto_clone || arg.widen_fixed_to_list -> count += 1 }
                        copies = copies.saturating_add(count)
                    }
                    else -> {}
                }
                else -> {}
            }
        }
    }
    if copies == 0 -> .None else -> .PerIteration(copies)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10574
fn vector_fact(function: MIRFunction, row: MIRLoopFact, shape: CanonicalLoopShape, prelude_calls: [MIRPreludeCallID:MIRPreludeCall], type_defs: [MIRTypeDef]) -> MIRVectorFact {
    body_blocks := [MIRBlockID]{}
    instructions := [MIRInstruction]{}
    loop block_id in shape.blocks {
        if Val(block_id) == shape.advance -> next
        &body_blocks.push(block_id)
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        loop instruction in block.instructions -> &instructions.push(instruction)
    }
    cursor :: shape.cursor
    cursor_place :: shape.cursor_place
    accesses := vector_accesses(function, body_blocks, cursor, cursor_place, type_defs)
    layouts := [MIRVectorLayout:Bool]{}
    layout := MIRVectorLayout.Flat
    loop access in accesses {
        if access.field != None || access.layout != .Flat {
            if layouts.get(access.layout) == None -> &layouts.add(access.layout, true).drop("distinct layout")
            layout = access.layout
        }
    }
    if layouts.len() != 1 -> layout = .Flat
    uniform_layout :: layouts.len() <= 1
    columnar_write := false
    loop instruction in instructions {
        if instruction.operation == .WritePlace(place_id, _) {
            place :: function.places.find(fn(place) { place.id == place_id }) ?? next
            field := MIRFieldID?{None}
            loop projection in place.projections.rev() {
                if projection == .Field(candidate, _) { field = Val(candidate); break }
            }
            if field != None && vector_place_layout(function, place, field, type_defs).0 == .ColumnarDirect -> columnar_write = true
        }
    }
    element_type :: vector_element_type(function, instructions, cursor_place)
    lane :: lane_width(element_type)
    proven_indexing :: vector_indexing_is_proven(function, instructions, cursor, cursor_place, shape.range, prelude_calls)
    indexed_input := if cursor == .Val(value) -> vector_has_indexed_input(function, instructions, value, cursor_place) else -> false
    loop access in accesses {
        if access.field != None && access.layout != .Flat -> indexed_input = true
    }
    has_early_exit := false
    has_branch := false
    loop block_id in body_blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        if block.terminator == .Branch(_, _, _) -> has_branch = true
        if row.exit == .Val(exit) {
            if block.terminator == {
                .Break(target, _) | .Jump(target) -> if target == exit -> has_early_exit = true
                .Branch(_, then_target, else_target) -> if then_target == exit || else_target == exit -> has_early_exit = true
                .Return(_) -> has_early_exit = true
                else -> {}
            }
        }
    }
    no_early_exit :: !has_early_exit
    rmw :: vector_rmw(instructions)
    rmw_places :: vector_rmw_places(instructions)
    rmw_accumulator_type :: vector_rmw_accumulator_type(function, instructions)
    has_comparison := false
    has_field := false
    loop instruction in instructions {
        if instruction.operation == .Binary(op, _, _, _, _) && op.is_comparison() -> has_comparison = true
    }
    loop access in accesses { if access.field != None -> has_field = true }
    rule :: if {
        has_early_exit && has_comparison -> MIRVectorRule.EarlyExitSearch
        has_branch && rmw != None -> MIRVectorRule.ConditionalAccumulate
        rmw != None && indexed_input -> MIRVectorRule.Reduction
        has_field -> MIRVectorRule.FieldAccess
        else -> MIRVectorRule.Elementwise
    }
    effect_free_body := function.effects.direct.is_empty() && function.effects.call_edges.is_empty()
    loop instruction in instructions {
        if vector_operation_has_effect(function, instruction.operation, prelude_calls) -> effect_free_body = false
    }
    (no_aliasing, no_cross_iteration_dependencies) :: vector_memory_facts(function, body_blocks, cursor, cursor_place, rule, rmw_places)
    conditional_plan :: if rule == .ConditionalAccumulate -> conditional_accumulate_plan(function, body_blocks, row.exit, instructions) else -> None
    early_exit_proven :: if rule == .EarlyExitSearch -> vector_early_exit_proven(function, body_blocks, row.exit, cursor, cursor_place) else -> false
    packable :: if element_type == .Val(ty) -> is_packable_for_rule(rule, ty) else -> false
    reduction_element :: if element_type == .Val(ty) -> is_reduction_type(ty) else -> false
    reduction_accumulator :: if rmw_accumulator_type == .Val(ty) -> is_reduction_type(ty) else -> false
    packed :: packable && lane != None && !accesses.is_empty() && uniform_layout && !columnar_write && proven_indexing && no_aliasing && effect_free_body && no_cross_iteration_dependencies && (no_early_exit || (rule == .EarlyExitSearch && early_exit_proven))
    decision :: if {
        shape.form != .Counted -> MIROptimizationDecision.Rejected(.DynamicTripCount)
        cursor == None || accesses.is_empty() || element_type == None -> MIROptimizationDecision.Rejected(.UnsupportedOperation)
        !proven_indexing -> MIROptimizationDecision.Rejected(.ScalarBoundary)
        !packable -> MIROptimizationDecision.Rejected(.UnsupportedOperation)
        !effect_free_body -> MIROptimizationDecision.Rejected(.HasEffects)
        !uniform_layout || columnar_write -> MIROptimizationDecision.Rejected(.ObservableLayout)
        !no_aliasing -> MIROptimizationDecision.Rejected(.MayAlias)
        !no_cross_iteration_dependencies -> MIROptimizationDecision.Rejected(.CrossIterationDependency)
        rule == .ConditionalAccumulate && (conditional_plan == None || rmw != Val(.Add) || !indexed_input || !reduction_element || !reduction_accumulator) -> MIROptimizationDecision.Rejected(.UnsupportedOperation)
        rule == .EarlyExitSearch && !early_exit_proven -> MIROptimizationDecision.Rejected(.UnsupportedOperation)
        rule == .Reduction && (rmw != Val(.Add) || !indexed_input || !reduction_element || !reduction_accumulator) -> MIROptimizationDecision.Rejected(.UnsupportedOperation)
        !no_early_exit && rule != .EarlyExitSearch -> MIROptimizationDecision.Rejected(.HasEarlyExit)
        lane == None -> MIROptimizationDecision.Rejected(.ScalarBoundary)
        else -> MIROptimizationDecision.Eligible
    }
    fixed_reduction := MIRFixedReductionFact?{None}
    if conditional_plan == .Val((accumulator, addend, seed, condition)) {
        source_operations := [MIROpID]{}
        loop instruction in instructions -> &source_operations.push(instruction.id)
        fixed_reduction = Val(MIRFixedReductionFact{
            accumulator: accumulator, addend: addend, seed: seed, condition: Val(condition),
            source_operations: ^source_operations, exit: row.exit ?? shape.advance ?? row.header,
            order: D_FRED1_FIXED_ORDER,
        })
    }
    &accesses.sort()
    MIRVectorFact{
        loop_header: row.header, cursor: cursor, body_blocks: ^body_blocks, advance_block: shape.advance,
        rule: rule, accesses: ^accesses, layout: layout, element_type: element_type, packed: packed,
        lane_width: lane, no_aliasing: no_aliasing, no_early_exit: no_early_exit,
        effect_free_body: effect_free_body, no_cross_iteration_dependencies: no_cross_iteration_dependencies,
        fixed_reduction: fixed_reduction, span: row.span, decision: decision,
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10799
fn vector_element_type(function: MIRFunction, instructions: [MIRInstruction], cursor_place: MIRPlaceID?) -> MIRType? {
    type_for :: fn(instruction: MIRInstruction) -> MIRType? {
        ty :: if instruction.operation == {
            .ReadPlace(place_id) | .MovePlace(place_id) | .WritePlace(place_id, _) -> {
                place :: function.places.find(fn(place) { place.id == place_id }) ?? return None
                Val(place.ty)
            }
            .Index(_, _, _, _, _, _, _) | .Semantic(.ColumnarRead(_, _, _, _, _)) | .Field(_, _) | .Binary(_, _, _, _, _) -> instruction.ty
            else -> None
        } ?? return None
        if is_packable_type(ty) -> Val(ty) else -> None
    }
    loop instruction in instructions {
        preferred :: if instruction.operation == {
            .Index(_, _, _, _, _, _, _) | .Semantic(.ColumnarRead(_, _, _, _, _)) | .Field(_, _) | .Binary(_, _, _, _, _) -> true
            .WritePlace(place_id, _) -> {
                place :: function.places.find(fn(place) { place.id == place_id }) ?? next
                !place.projections.is_empty()
            }
            else -> false
        }
        if preferred { if type_for(instruction) == .Val(ty) -> return Val(ty) }
    }
    loop instruction in instructions {
        if instruction.operation == {
            .ReadPlace(place) | .MovePlace(place) && cursor_place == Val(place) -> next
            else -> {}
        }
        if type_for(instruction) == .Val(ty) -> return Val(ty)
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10856
fn vector_indexing_is_proven(function: MIRFunction, instructions: [MIRInstruction], cursor: MIRValueID?, cursor_place: MIRPlaceID?, range: CanonicalLoopRange?, prelude_calls: [MIRPreludeCallID:MIRPreludeCall]) -> Bool {
    cursor_value :: cursor ?? return false
    loop_range :: range ?? return false
    if !loop_range.exclusive -> return false
    constants :: mir_pass_collect_scalar_constants(function)
    if scalar_int_constant(constants, loop_range.start) != Val(0) -> return false
    if loop_range.step == .Val(step) { if scalar_int_constant(constants, step) != Val(1) -> return false }
    range_end := U64?{None}
    if scalar_int_constant(constants, loop_range.end) == .Val(end) -> range_end = U64.try_from(end).ok()
    required_len :: fn(index: MIRValueID, cursor_index: Bool) -> U64? {
        if cursor_index -> return range_end
        signed :: scalar_int_constant(constants, index) ?? return None
        unsigned :: U64.try_from(signed).ok() ?? return None
        unsigned.checked_add(1)
    }
    index_is_proven :: fn(base: MIRValueID?, base_ty: MIRType?, index: MIRValueID, cursor_index: Bool) -> Bool {
        if required_len(index, cursor_index) == .Val(end) {
            if base_ty == .Val(ty) { if vector_fixed_bound_covers(ty, end) -> return true }
            if base == .Val(base_value) {
                loop row in function.values { if row.id == base_value && vector_fixed_bound_covers(row.ty, end) -> return true }
            }
        }
        if cursor_index && range_end == None {
            if base == .Val(base_value) -> return vector_list_length_matches(function, loop_range.end, base_value, prelude_calls)
        }
        false
    }
    indexed := false
    loop instruction in instructions {
        if instruction.operation == .Index(_, base, index, kind, _, _, _) {
            cursor_index :: cursor_value_matches(function, index, cursor_value, cursor_place)
            indexed = indexed || cursor_index
            if kind != .FixedListProof && (kind != .List || !index_is_proven(Val(base), None, index, cursor_index)) -> return false
        }
        if instruction.operation == .Semantic(.ColumnarRead(base, index, _, _, _)) {
            // The fused checked list[index].field form retains cursor and extent proofs.
            cursor_index :: cursor_value_matches(function, index, cursor_value, cursor_place)
            if !cursor_index || !index_is_proven(Val(base), None, index, cursor_index) -> return false
            indexed = true
        }
        loop place_id in operation_place_refs(instruction.operation) {
            place :: function.places.find(fn(place) { place.id == place_id }) ?? return false
            loop (position, projection) in place.projections {
                if projection == .Index(kind, index, _, _, _, _, _) {
                    cursor_index :: cursor_value_matches(function, index, cursor_value, cursor_place)
                    indexed = indexed || cursor_index
                    if kind == .FixedListProof -> next
                    base :: place_base_value(place)
                    base_ty :: place_base_type(function, place.base)
                    if kind != .List || position != 0 || !index_is_proven(base, base_ty, index, cursor_index) -> return false
                }
            }
        }
    }
    indexed
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10967
fn place_base_value(place: MIRPlace) -> MIRValueID? {
    if place.base == {
        .Parameter(value) | .Capture(value) | .Temporary(value) -> Val(value)
        .Local(_) | .Static(_) -> None
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:10976
fn vector_list_length_matches(function: MIRFunction, length: MIRValueID, base: MIRValueID, prelude_calls: [MIRPreludeCallID:MIRPreludeCall]) -> Bool {
    seen := [MIRValueID:Bool]{}
    vector_list_length_matches_inner(function, length, base, prelude_calls, &seen)
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:10982
fn vector_list_length_matches_inner(function: MIRFunction, length: MIRValueID, base: MIRValueID, prelude_calls: [MIRPreludeCallID:MIRPreludeCall], seen: &[MIRValueID:Bool]) -> Bool {
    if seen.get(length) != None -> return false
    &seen.add(length, true).drop("absent length")
    instruction :: find_value_instruction(function, length) ?? return false
    if instruction.operation == {
        .Copy(value, _) | .Move(value) | .TraitBox(value, _) | .AttachTag(value, _) | .Convert(value, _, _, _) -> vector_list_length_matches_inner(function, value, base, prelude_calls, seen)
        .CoreCall(_, route, args, _, _, _) | .Call(.Prelude(route), args, _) -> vector_length_route_matches(function, route, args, base, prelude_calls)
        .Semantic(.BuiltinMethod(call, receiver, _, args, _)) -> {
            route :: prelude_calls.get(call) ?? return false
            route.member == "len" && args.is_empty() && vector_same_collection_value(function, receiver, base)
        }
        .Semantic(.StaticPreludeCall(call, args, _, _)) -> vector_length_route_matches(function, call, args, base, prelude_calls)
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11036
fn vector_length_route_matches(function: MIRFunction, call: MIRPreludeCallID, args: [MIRCallArg], base: MIRValueID, prelude_calls: [MIRPreludeCallID:MIRPreludeCall]) -> Bool {
    route :: prelude_calls.get(call) ?? return false
    route.member == "len" && args.len() == 1 && vector_same_collection_value(function, args[0].value, base)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11050
fn vector_same_collection_value(function: MIRFunction, left: MIRValueID, right: MIRValueID) -> Bool {
    if left == right -> return true
    left_seen := [MIRValueID:Bool]{}
    right_seen := [MIRValueID:Bool]{}
    left_place :: vector_same_collection_direct_place(function, left, &left_seen) ?? return false
    right_place :: vector_same_collection_direct_place(function, right, &right_seen) ?? return false
    left_place == right_place
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:11055
fn vector_same_collection_direct_place(function: MIRFunction, value: MIRValueID, seen: &[MIRValueID:Bool]) -> MIRPlaceID? {
    if seen.get(value) != None -> return None
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return None
    if instruction.operation == {
        .Copy(source, _) | .Move(source) | .TraitBox(source, _) | .AttachTag(source, _) | .Convert(source, _, _, _) -> vector_same_collection_direct_place(function, source, seen)
        // Rust has no terminal ReadPlace arm in this helper.
        else -> None
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11086
fn vector_fixed_bound_covers(ty: MIRType, required_len: U64) -> Bool {
    if ty.kind == {
        .FixedList(_, .Literal(_, value)) -> required_len <= value
        .Tagged(_, inner) -> vector_fixed_bound_covers(inner, required_len)
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11097
fn conditional_accumulate_plan(function: MIRFunction, body_blocks: [MIRBlockID], exit: MIRBlockID?, instructions: [MIRInstruction]) -> (MIRPlaceID, MIRValueID, MIRValueID, MIRValueID)? {
    (accumulator, addend, seed) :: fixed_reduction_plan(function, instructions) ?? return None
    writes := 0
    loop instruction in instructions {
        if instruction.operation == .WritePlace(place, _) {
            writes += 1
            if place != accumulator -> return None
        }
    }
    if writes != 1 -> return None
    write_block := MIRBlockID?{None}
    loop block_id in body_blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        loop instruction in block.instructions {
            if instruction.operation == .WritePlace(place, _) && place == accumulator { write_block = Val(block_id); break }
        }
        if write_block != None -> break
    }
    target :: write_block ?? return None
    allowed := [MIRBlockID:Bool]{}
    loop block_id in body_blocks {
        if allowed.get(block_id) == None -> &allowed.add(block_id, true).drop("allowed block")
    }
    loop block_id in body_blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        if block.terminator == .Branch(condition, then_target, else_target) {
            if exit == .Val(exit_id) { if then_target == exit_id || else_target == exit_id -> next }
            then_reaches :: block_reaches(function, then_target, target, allowed)
            else_reaches :: block_reaches(function, else_target, target, allowed)
            if then_reaches == else_reaches -> next
            if !vector_condition_is_comparison(function, condition) -> next
            return Val((accumulator, addend, seed, condition))
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11157
fn block_reaches(function: MIRFunction, start: MIRBlockID, target: MIRBlockID, allowed: [MIRBlockID:Bool]) -> Bool {
    pending := [start]
    seen := [MIRBlockID:Bool]{}
    loop pending.pop() == .Val(block_id) {
        if block_id == target -> return true
        if allowed.get(block_id) == None || seen.get(block_id) != None -> next
        &seen.add(block_id, true).drop("absent block")
        if function.blocks.find(fn(block) { block.id == block_id }) == .Val(block) {
            loop successor in mir_terminator_targets(block.terminator) -> &pending.push(successor)
        }
    }
    false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11179
fn vector_condition_is_comparison(function: MIRFunction, value: MIRValueID) -> Bool {
    instruction :: find_value_instruction(function, value) ?? return false
    if instruction.operation == .Binary(op, _, _, _, _) -> op.is_comparison() else -> false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11188
fn vector_early_exit_proven(function: MIRFunction, body_blocks: [MIRBlockID], exit: MIRBlockID?, cursor: MIRValueID?, cursor_place: MIRPlaceID?) -> Bool {
    exit_id :: exit ?? return false
    cursor_value :: cursor ?? return false
    candidates := [(MIRBlockID, MIRBlockID)]{}
    loop block_id in body_blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        if block.terminator == .Branch(condition, then_target, else_target) {
            loop (target, other) in [(then_target, else_target), (else_target, then_target)] {
                if target == other || other == exit_id -> next
                target_block :: function.blocks.find(fn(block) { block.id == target }) ?? next
                // Packed search accepts only a function return carrying the cursor,
                // not a loop BreakValue lacking a checked packed result carrier.
                value :: if target_block.terminator == .Return(.Val(value)) -> value else -> next
                condition_seen := [MIRValueID:Bool]{}
                value_seen := [MIRValueID:Bool]{}
                if vector_condition_is_comparison(function, condition) && value_depends_on_cursor(function, condition, cursor_value, cursor_place, &condition_seen) && value_depends_on_cursor(function, value, cursor_value, cursor_place, &value_seen) -> &candidates.push((block.id, target))
            }
        }
    }
    if candidates.len() != 1 -> return false
    early_target :: candidates[0].1
    loop block_id in body_blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? return false
        if block.terminator == {
            .Break(target, _) && target == exit_id -> return false
            .Return(_) -> if block_id != early_target -> return false
            else -> {}
        }
    }
    true
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11272
fn value_depends_on_cursor(function: MIRFunction, value: MIRValueID, cursor: MIRValueID, cursor_place: MIRPlaceID?, seen: &[MIRValueID:Bool]) -> Bool {
    is_cursor :: cursor_value_matches(function, value, cursor, cursor_place)
    if is_cursor || seen.get(value) != None -> return is_cursor
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return false
    if instruction.operation == {
        .LoopRangeValue(_, source) | .LoopIterValue(_, source) -> source == cursor
        .Copy(source, _) | .Move(source) | .TraitBox(source, _) | .AttachTag(source, _) | .Unary(_, source) | .Convert(source, _, _, _) -> value_depends_on_cursor(function, source, cursor, cursor_place, seen)
        .Binary(_, _, _, left, right) -> value_depends_on_cursor(function, left, cursor, cursor_place, seen) || value_depends_on_cursor(function, right, cursor, cursor_place, seen)
        .Phi(incoming) -> {
            loop row in incoming { if value_depends_on_cursor(function, row.value, cursor, cursor_place, seen) -> return true }
            false
        }
        .Index(_, base, index, _, _, _, _) | .Semantic(.ColumnarRead(base, index, _, _, _)) -> cursor_value_matches(function, index, cursor, cursor_place) || value_depends_on_cursor(function, base, cursor, cursor_place, seen)
        .Field(base, _) -> value_depends_on_cursor(function, base, cursor, cursor_place, seen)
        .ReadPlace(place) -> place_has_cursor_index(function, place, cursor, cursor_place)
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11326
fn is_reduction_type(ty: MIRType) -> Bool { ty.kind == .Float || ty.kind == .Float32 }

// Rust: crates/jet-foundation/src/MIROptimization.rs:11330
fn vector_rmw(instructions: [MIRInstruction]) -> MIRBinaryOp? {
    loop instruction in instructions {
        if instruction.operation == .WritePlace(place, value) {
            defining :: instructions.find(fn(candidate) { candidate.result == Val(value) }) ?? next
            if defining.operation == .Binary(op, _, _, left, right) {
                loop operand in [left, right] {
                    seen := [MIRValueID:Bool]{}
                    if value_reads_place(instructions, operand, place, &seen) -> return Val(op)
                }
            }
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11348
fn vector_rmw_places(instructions: [MIRInstruction]) -> [MIRPlaceID] {
    places := [MIRPlaceID]{}
    loop instruction in instructions {
        if instruction.operation == .WritePlace(place, value) {
            defining :: instructions.find(fn(candidate) { candidate.result == Val(value) }) ?? next
            if defining.operation == .Binary(_, _, _, left, right) {
                reads := false
                loop operand in [left, right] {
                    seen := [MIRValueID:Bool]{}
                    if value_reads_place(instructions, operand, place, &seen) { reads = true; break }
                }
                if reads && !places.contains(place) -> &places.push(place)
            }
        }
    }
    places
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11372
fn vector_rmw_accumulator_type(function: MIRFunction, instructions: [MIRInstruction]) -> MIRType? {
    loop instruction in instructions {
        if instruction.operation == .WritePlace(place, value) {
            defining :: instructions.find(fn(candidate) { candidate.result == Val(value) }) ?? next
            if defining.operation == .Binary(_, _, _, left, right) {
                reads := false
                loop operand in [left, right] {
                    seen := [MIRValueID:Bool]{}
                    if value_reads_place(instructions, operand, place, &seen) { reads = true; break }
                }
                if reads {
                    if function.places.find(fn(candidate) { candidate.id == place }) == .Val(candidate) -> return Val(candidate.ty)
                }
            }
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11397
fn value_reads_place(instructions: [MIRInstruction], value: MIRValueID, place: MIRPlaceID, seen: &[MIRValueID:Bool]) -> Bool {
    if seen.get(value) != None -> return false
    &seen.add(value, true).drop("absent value")
    instruction :: instructions.find(fn(candidate) { candidate.result == Val(value) }) ?? return false
    if instruction.operation == {
        .ReadPlace(read) | .MovePlace(read) -> read == place
        .Copy(source, _) | .Move(source) | .TraitBox(source, _) | .AttachTag(source, _) | .Unary(_, source) | .Convert(source, _, _, _) -> value_reads_place(instructions, source, place, seen)
        .Binary(_, _, _, left, right) -> value_reads_place(instructions, left, place, seen) || value_reads_place(instructions, right, place, seen)
        .Phi(incoming) -> {
            loop row in incoming { if value_reads_place(instructions, row.value, place, seen) -> return true }
            false
        }
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11434
fn vector_has_indexed_input(function: MIRFunction, instructions: [MIRInstruction], cursor: MIRValueID, cursor_place: MIRPlaceID?) -> Bool {
    loop instruction in instructions {
        indexed :: if instruction.operation == {
            .ReadPlace(place) | .MovePlace(place) -> place_has_cursor_index(function, place, cursor, cursor_place)
            .Index(_, _, index, _, _, _, _) | .Semantic(.ColumnarRead(_, index, _, _, _)) -> cursor_value_matches(function, index, cursor, cursor_place)
            .Field(base, _) -> {
                seen := [MIRValueID:Bool]{}
                value_has_cursor_index(function, base, cursor, cursor_place, &seen)
            }
            else -> false
        }
        if indexed -> return true
    }
    false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11457
fn value_has_cursor_index(function: MIRFunction, value: MIRValueID, cursor: MIRValueID, cursor_place: MIRPlaceID?, seen: &[MIRValueID:Bool]) -> Bool {
    if seen.get(value) != None -> return false
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return false
    if instruction.operation == {
        .Index(_, _, index, _, _, _, _) -> cursor_value_matches(function, index, cursor, cursor_place)
        .ReadPlace(place) | .MovePlace(place) -> place_has_cursor_index(function, place, cursor, cursor_place)
        .Field(base, _) | .Copy(base, _) | .Move(base) | .TraitBox(base, _) | .AttachTag(base, _) -> value_has_cursor_index(function, base, cursor, cursor_place, seen)
        else -> false
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11488
fn find_value_instruction(function: MIRFunction, value: MIRValueID) -> MIRInstruction? {
    loop block in function.blocks {
        loop instruction in block.instructions {
            if instruction.result == Val(value) -> return Val(instruction)
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11499
fn place_has_cursor_index(function: MIRFunction, place_id: MIRPlaceID, cursor: MIRValueID, cursor_place: MIRPlaceID?) -> Bool {
    place :: function.places.find(fn(place) { place.id == place_id }) ?? return false
    loop projection in place.projections {
        if projection == .Index(_, index, _, _, _, _, _) && cursor_value_matches(function, index, cursor, cursor_place) -> return true
    }
    false
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11520
fn vector_accesses(function: MIRFunction, blocks: [MIRBlockID], cursor: MIRValueID?, cursor_place: MIRPlaceID?, type_defs: [MIRTypeDef]) -> [MIRVectorAccess] {
    accesses := [MIRVectorAccess]{}
    loop block_id in blocks {
        block :: function.blocks.find(fn(block) { block.id == block_id }) ?? next
        loop instruction in block.instructions {
            loop place_id in operation_place_refs(instruction.operation) {
                place :: function.places.find(fn(place) { place.id == place_id }) ?? next
                field := MIRFieldID?{None}
                loop projection in place.projections.rev() {
                    if projection == .Field(candidate, _) { field = Val(candidate); break }
                }
                (layout, column_index) :: vector_place_layout(function, place, field, type_defs)
                &accesses.push(MIRVectorAccess{root: .Place(place_id), field: field, layout: layout, column_index: column_index})
            }
            if instruction.operation == {
                .Index(_, base, index, _, _, _, _) -> {
                    if cursor == .Val(cursor_value) {
                        if cursor_value_matches(function, index, cursor_value, cursor_place) -> &accesses.push(MIRVectorAccess{root: value_access_root(function, base), field: None, layout: .Flat, column_index: None})
                    }
                }
                .Semantic(.ColumnarRead(base, _, column, column_index, _)) -> &accesses.push(MIRVectorAccess{root: .Value(base), field: Val(column), layout: .ColumnarDirect, column_index: Val(column_index)})
                .Field(base, field) -> {
                    if vector_indexed_field_access(function, base, field, cursor, cursor_place, type_defs) == .Val((root, layout, column_index)) -> &accesses.push(MIRVectorAccess{root: root, field: Val(field), layout: layout, column_index: column_index})
                }
                else -> {}
            }
        }
    }
    &accesses.sort()
    &accesses.dedup()
    accesses
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11603
fn vector_place_layout(function: MIRFunction, place: MIRPlace, field: MIRFieldID?, type_defs: [MIRTypeDef]) -> (MIRVectorLayout, Int?) {
    field_id :: field ?? return (.Flat, None)
    base_type :: place_base_type(function, place.base) ?? return (.AosStrided, None)
    element :: list_element_type(base_type) ?? return (.AosStrided, None)
    if struct_layout(element, type_defs) == Val(.Columnar) -> (.ColumnarDirect, field_column_index(element, field_id, type_defs)) else -> (.AosStrided, None)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11628
fn vector_indexed_field_access(function: MIRFunction, base: MIRValueID, field: MIRFieldID, cursor: MIRValueID?, cursor_place: MIRPlaceID?, type_defs: [MIRTypeDef]) -> (MIRVectorAccessRoot, MIRVectorLayout, Int?)? {
    instruction :: find_value_instruction(function, base) ?? return None
    (root, index, collection_type) :: if instruction.operation == {
        .Index(_, collection, index, kind, _, _, _) && (kind == .List || kind == .FixedListProof) -> {
            ty :: value_type(function, collection) ?? return None
            (value_access_root(function, collection), index, ty)
        }
        .ReadPlace(place_id) -> {
            place :: function.places.find(fn(place) { place.id == place_id }) ?? return None
            index := MIRValueID?{None}
            loop projection in place.projections.rev() {
                if projection == .Index(_, value, _, _, _, _, _) { index = Val(value); break }
            }
            index_value :: index ?? return None
            root :: if place.base == {
                .Parameter(value) | .Capture(value) | .Temporary(value) -> value_access_root(function, value)
                .Local(_) -> MIRVectorAccessRoot.Place(place_id)
                .Static(_) -> return None
            }
            ty :: place_base_type(function, place.base) ?? return None
            (root, index_value, ty)
        }
        else -> return None
    }
    cursor_value :: cursor ?? return None
    if !cursor_value_matches(function, index, cursor_value, cursor_place) -> return None
    element :: list_element_type(collection_type) ?? return None
    layout :: if struct_layout(element, type_defs) == Val(.Columnar) -> MIRVectorLayout.ColumnarDirect else -> MIRVectorLayout.AosStrided
    column_index :: if layout == .ColumnarDirect -> field_column_index(element, field, type_defs) else -> None
    Val((root, layout, column_index))
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11685
fn place_base_type(function: MIRFunction, base: MIRPlaceBase) -> MIRType? {
    if base == {
        .Local(local_id) -> {
            local :: function.locals.find(fn(candidate) { candidate.id == local_id }) ?? return None
            Val(local.ty)
        }
        .Parameter(value) | .Capture(value) | .Temporary(value) -> value_type(function, value)
        .Static(_) -> None
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11699
fn value_type(function: MIRFunction, value: MIRValueID) -> MIRType? {
    row :: function.values.find(fn(candidate) { candidate.id == value }) ?? return None
    Val(row.ty)
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11707
fn value_access_root(function: MIRFunction, value: MIRValueID) -> MIRVectorAccessRoot {
    seen := [MIRValueID:Bool]{}
    value_access_root_inner(function, value, &seen)
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:11708
fn value_access_root_inner(function: MIRFunction, value: MIRValueID, seen: &[MIRValueID:Bool]) -> MIRVectorAccessRoot {
    if seen.get(value) != None -> return .Value(value)
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return .Value(value)
    if instruction.operation == {
        .ReadPlace(place) | .MovePlace(place) -> .Place(place)
        .Copy(source, _) | .Move(source) | .AttachTag(source, _) | .Field(source, _) | .Index(_, source, _, _, _, _, _) | .Semantic(.ColumnarRead(source, _, _, _, _)) -> value_access_root_inner(function, source, seen)
        else -> .Value(value)
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11737
fn list_element_type(ty: MIRType) -> MIRType? {
    if ty.kind == {
        .List(inner) | .FixedList(inner, _) -> Val(inner)
        .Tagged(_, inner) -> list_element_type(inner)
        else -> None
    }
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11745
fn struct_layout(ty: MIRType, type_defs: [MIRTypeDef]) -> MIRStructLayout? {
    id :: ty.identity ?? (if ty.kind == .Apply(name, _) -> Val(name.id) else -> None) ?? return None
    definition :: type_defs.find(fn(definition) { definition.id == id }) ?? return None
    definition.layout
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11753
fn field_column_index(element: MIRType, field: MIRFieldID, type_defs: [MIRTypeDef]) -> Int? {
    id :: element.identity ?? (if element.kind == .Apply(name, _) -> Val(name.id) else -> None) ?? return None
    definition :: type_defs.find(fn(definition) { definition.id == id }) ?? return None
    if definition.kind == .Struct(fields, _) {
        position := 0
        loop candidate in fields {
            if candidate.computed -> next
            if candidate.id == field -> return Val(position)
            position += 1
        }
    }
    None
}

// Rust: crates/jet-foundation/src/MIROptimization.rs:11772
fn value_root_key(function: MIRFunction, value: MIRValueID) -> String {
    seen := [MIRValueID:Bool]{}
    value_root_key_inner(function, value, &seen)
}
// Rust: crates/jet-foundation/src/MIROptimization.rs:11773
fn value_root_key_inner(function: MIRFunction, value: MIRValueID, seen: &[MIRValueID:Bool]) -> String {
    if seen.get(value) != None -> return "value:{value.value}"
    &seen.add(value, true).drop("absent value")
    instruction :: find_value_instruction(function, value) ?? return "value:{value.value}"
    if instruction.operation == {
        .ReadPlace(place) | .MovePlace(place) -> {
            candidate :: function.places.find(fn(candidate) { candidate.id == place }) ?? return "value:{value.value}"
            place_root(candidate)
        }
        .Parameter(index, _) -> "parameter:{index}"
        .Capture(slot) -> "capture:{slot}"
        .Copy(source, _) | .Move(source) | .AttachTag(source, _) | .Field(source, _) | .Index(_, source, _, _, _, _, _) | .Semantic(.ColumnarRead(source, _, _, _, _)) -> value_root_key_inner(function, source, seen)
        .Phi(incoming) -> {
            first :: incoming.get(0) ?? return "value:{value.value}"
            value_root_key_inner(function, first.value, seen)
        }
        else -> "value:{value.value}"
    }
}

