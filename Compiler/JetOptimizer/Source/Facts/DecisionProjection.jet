// Rust MIROptimization::decision_ledger and MIR::MirDecisionLedger. Projections
// consume checked MIR facts; absent runtime observations remain absent.
use jet_foundation.[MIRProgram, MIRArtifactID, MIRArtifactPlan, MIRArtifactTarget, MIRArtifactBuildMode, MIRRuntimePartID, MIRDecisionIdentity, MIRDecisionRow, MIRDecisionKind, MIRDecisionDisposition, MIRDerivationMethod, MIRDerivationDisposition, MIRDecisionEdit, MIRFunctionID, MIRVectorRule, MIROptimizationRejection, Span, DerivationRecord, DerivationIdentity, derivation_identity, derivation_record, derivation_record_reference, mir_sha256_hex, mir_sha256_hex_bytes, mir_sha256_bytes, foundation_json_quote, foundation_parse_protocol_json]

struct MIRDecisionLedger {
    identity: MIRDecisionIdentity
    rows: [MIRDecisionRow]
    derivations: [DerivationRecord]
}
#Error struct MIRDecisionPayloadError { message: String }
fn mir_decision_frame(out: &[U8], text: String) Never! {
    length :: U64.from_int(text.bytes().len()) ?? panic("decision frame length")
    loop index in 0..<8 -> &out.push(U8.from_u64((length >> (8 * index)).bit_and(U64{255})) ?? U8{0})
    &out.extend(text.bytes())
}
fn mir_decision_runtime_name(part: MIRRuntimePartID) -> String Never! {
    if part == {
        .GC -> "gc"
        .Event -> "event"
        .Realtime -> "realtime"
        .EmbeddedHardware -> "embedded-hardware"
        .UI -> "ui"
        .Devtools -> "devtools"
        .Gtk -> "gtk"
        .Apps -> "apps"
        .Email -> "email"
        .Game -> "game"
        .Files -> "files"
        .Interrupt -> "interrupt"
        .FSRuntime -> "fs-runtime"
        .Process -> "process"
        .Crypto -> "crypto"
        .Math -> "math"
        .Encoding -> "encoding"
        .Data -> "data"
        .Fmt -> "fmt"
        .DataFmt -> "data-fmt"
        .Compute -> "compute"
        .HTTP -> "http"
        .WebSocket -> "websocket"
        .Browser -> "browser"
        .Args -> "args"
        .Reflect -> "reflect"
        .AuthSession -> "auth-session"
        .Sync -> "sync"
        .Services -> "services"
        .Mod -> "mod"
    }
}
fn mir_decision_target_name(target: MIRArtifactTarget) -> String Never! {
    if target == {
        .RustAOT -> "rust-aot"
        .Interpreter -> "interpreter"
        .Web -> "web"
    }
}
fn mir_decision_mode_name(mode: MIRArtifactBuildMode) -> String Never! {
    if mode == {
        .Dev -> "dev"
        .Release -> "release"
        .Test -> "test"
        .Fuzz -> "fuzz"
        .Coverage -> "coverage"
    }
}
fn mir_decision_identity(program: MIRProgram, artifact: MIRArtifactID?, profile: String, run: String) -> MIRDecisionIdentity Never! {
    plan := MIRArtifactPlan?{None}
    loop candidate in program.artifacts {
        if artifact == (Val(candidate.id)) {
            plan = Val(candidate)
            break
        }
    }
    if plan == None && program.artifacts.len() > 0 -> plan = Val(program.artifacts[0])
    files := program.source_files
    files = loop fresh_item in files -> fresh_item
    &files.sort_by((a, b) -> (a.path <=> b.path).then(a.id.value <=> b.id.value))
    source_material := [U8]{}
    loop file in files {
        mir_decision_frame(&source_material, file.path)
        mir_decision_frame(&source_material, mir_sha256_hex(file.source))
    }
    if source_material.len() == 0 -> mir_decision_frame(&source_material, program.package_identity)
    runtime := program.facts.runtime_parts.map(part -> mir_decision_runtime_name(part))
    &runtime.sort()
    facts :: program.facts
    dossier :: facts.target_dossier
    machine_triple :: if dossier.machine == .Val(machine) -> machine.triple else -> "hosted-default"
    machine_name :: if dossier.machine == .Val(machine) -> machine.name else -> "hosted-default"
    selected_profile :: if profile != "" -> profile else -> if plan == .Val(value) -> mir_decision_mode_name(value.mode) else -> "unknown"
    target :: if plan == .Val(value) -> mir_decision_target_name(value.target) else -> "unknown"
    provider :: if plan == .Val(value) -> value.provider_identity else -> dossier.provider_identity
    closure :: if plan == .Val(value) -> value.closure_identity else -> dossier.closure_identity
    artifact_identity :: if plan == .Val(value) -> if value.artifact_identity != "" -> value.artifact_identity else -> "artifact:{value.id.value}" else -> if artifact == .Val(id) -> "artifact:{id.value}" else -> "unavailable"
    MIRDecisionIdentity{
        source: mir_sha256_hex_bytes(mir_sha256_bytes(source_material[0..<source_material.len()])),
        configuration: "package={program.package_identity};edition={facts.edition};os={facts.active_os};layer={facts.inferred_layer};allocator={facts.allocator};runtime={runtime.join(",")};arrow={if facts.uses_arrow -> "true" else -> "false"};hardware={facts.hardware_profile_id}",
        profile: selected_profile,
        target: "triple={machine_triple};artifact={target};machine={machine_name}",
        implementation: "compiler={dossier.compiler_identity};provider={provider};closure={closure};linker={dossier.linker_identity};tier={dossier.tier_identity};environment={dossier.environment_identity};dependencies={dossier.dependency_identity}",
        artifact: artifact_identity, run: if run == "" -> "not-observed" else -> run,
    }
}
fn mir_decision_derivation_identity(identity: MIRDecisionIdentity) -> DerivationIdentity Never! {
    build := [U8]{}
    loop value in [identity.configuration, identity.profile, identity.implementation, identity.artifact] -> mir_decision_frame(&build, value)
    derivation_identity(identity.source, mir_sha256_hex_bytes(mir_sha256_bytes(build[0..<build.len()])), identity.run, identity.target)
}
fn mir_decision_ledger_from_rows(identity: MIRDecisionIdentity, rows: [MIRDecisionRow]) -> MIRDecisionLedger Never! {
    canonical := [MIRDecisionRow]{}
    positions := [U64:Int]{}
    loop row in rows {
        if positions.get(row.id) == .Val(index) {
            if canonical[index].edit == None -> canonical[index].edit = row.edit
            if canonical[index].evidence == "" -> canonical[index].evidence = row.evidence
        } else {
            positions[row.id] = canonical.len()
            &canonical.push(row)
        }
    }
    derivations := [DerivationRecord]{}
    derivation_identity :: mir_decision_derivation_identity(identity)
    loop index in 0..<canonical.len() {
        row := canonical[index]
        method :: row.evidence_method ?? if row.evidence.contains("proof") || row.evidence.contains("static-flow") -> MIRDerivationMethod.FormalProof else -> MIRDerivationMethod.StaticDerivation
        disposition :: if row.disposition == {
            .Unavailable -> MIRDerivationDisposition.Unavailable
            .NotAttempted -> MIRDerivationDisposition.Unknown
            else -> MIRDerivationDisposition.Current
        }
        kind :: mir_pass_decision_kind_name(row.kind)
        derivation := derivation_record("{kind}:{row.function_name}:{row.span.start}-{row.span.end}", "{kind}:{mir_pass_decision_disposition_name(row.disposition)}:{row.rule}", row.producer, method, row.rule, [row.reason, row.evidence, "row-id={row.id}"], derivation_identity)
        derivation.disposition = disposition
        row.derivation = Val(derivation_record_reference(derivation))
        row.identity = Val(identity)
        row.evidence_method = Val(method)
        row.derivation_disposition = Val(disposition)
        canonical[index] = row
        &derivations.push(derivation)
    }
    MIRDecisionLedger{identity: identity, rows: canonical, derivations: derivations}
}
fn mir_decision_vector_rule(rule: MIRVectorRule) -> String Never! {
    if rule == {
        .Elementwise -> "elementwise"
        .FieldAccess -> "field-access"
        .ConditionalAccumulate -> "conditional-accumulate"
        .EarlyExitSearch -> "early-exit-search"
        .Reduction -> "reduction"
    }
}
fn mir_decision_rejection(reason: MIROptimizationRejection) -> String Never! {
    if reason == {
        .MissingProof -> "missing-proof"
        .MayTrap -> "may-trap"
        .HasEffects -> "has-effects"
        .HasEarlyExit -> "has-early-exit"
        .MayAlias -> "may-alias"
        .CrossIterationDependency -> "cross-iteration-dependency"
        .DynamicTripCount -> "dynamic-trip-count"
        .UnknownCopyCost -> "unknown-copy-cost"
        .ScalarBoundary -> "scalar-boundary"
        .ObservableLayout -> "observable-layout"
        .OwnershipObligation -> "ownership-obligation"
        .UnsupportedOperation -> "unsupported-operation"
    }
}
fn mir_decision_ledger_rows(program: MIRProgram) -> [MIRDecisionRow] Never! {
    rows := [MIRDecisionRow]{}
    loop function in program.functions {
        &rows.extend(function.optimization.decision_rows)
        if function.is_inline || function.is_inline_always -> &rows.push(mir_pass_decision_row(.Inline, .Selected, Val(function.id), function.key, function.span, if function.is_inline_always -> "#Inline(Always)" else -> "#Inline", "the checked function carries this inline contract", "mir.inline", "checked-function-metadata"))
        if function.kernel_proof == .Val(kernel) {
            proven :: kernel.bounds && kernel.alias_free && kernel.captures && kernel.race_free && kernel.barriers_uniform && kernel.control_flow
            &rows.push(mir_pass_decision_row(.Parallel, if proven -> .Accepted else -> .Rejected, Val(function.id), function.key, function.span, "kernel-parallel", if proven -> "the checked kernel satisfies the parallel safety proof" else -> "the checked kernel does not satisfy every parallel safety obligation", "sema.kernel-proof", "static-legality-proof"))
        }
        loop fact in function.optimization.loop_facts {
            disposition :: if fact.copy_cost == {
                .NoCopy -> MIRDecisionDisposition.NotAttempted
                .PerIteration(_) -> MIRDecisionDisposition.Selected
                .Unknown -> MIRDecisionDisposition.Unavailable
            }
            reason :: if fact.copy_cost == {
                .NoCopy -> "no loop copy was required by the checked ownership fact"
                .PerIteration(count) -> if count == 1 -> "the compiler inserted one copy per iteration" else -> "the compiler inserted copies per iteration"
                .Unknown -> "the compiler has no bounded copy-cost fact"
            }
            &rows.push(mir_pass_decision_row(.Copy, disposition, Val(function.id), function.key, fact.span, "loop-copy-cost", reason, "mir.loop-facts", "static-cost-fact"))
        }
        loop fact in function.optimization.bounds_facts {
            disposition :: if !fact.proven -> MIRDecisionDisposition.NotAttempted else -> if fact.elided -> MIRDecisionDisposition.Accepted else -> MIRDecisionDisposition.Rejected
            reason :: if !fact.proven -> "no checked bounds proof is available for this access" else -> if fact.elided -> "the checked bounds proof permits elision" else -> "the bounds proof is present but the failure check is retained"
            &rows.push(mir_pass_decision_row(.Bounds, disposition, Val(function.id), function.key, fact.span, "bounds-check-elimination", reason, "mir.bounds", "static-legality-proof"))
        }
        loop vector in function.optimization.vector_facts {
            rule :: mir_decision_vector_rule(vector.rule)
            reason :: if vector.decision == {
                .Eligible -> "the {rule} vector proof was accepted"
                .Rejected(rejection) -> if vector.rule == .Reduction && vector.fixed_reduction == None -> "strict-order reduction proof was not accepted" else -> "vector proof rejected: {mir_decision_rejection(rejection)}"
            }
            &rows.push(mir_pass_decision_row(.Vectorize, mir_pass_decision_disposition(vector.decision), Val(function.id), function.key, vector.span, rule, reason, "mir.vector-proof", "static-legality-proof"))
        }
    }
    loop unreachable in program.unreachable {
        reason :: if unreachable.reason == {
            .CompileTimeOnly -> "compiletimeonly"
            .Disabled -> "disabled"
            .ExpandedBeforeLowering -> "expandedbeforelowering"
            .SemanticIndexOnly -> "semanticindexonly"
        }
        &rows.push(mir_pass_decision_row(.Unreachable, .Selected, None, "", unreachable.span, unreachable.construct, reason, "tir.erasure", "static-control-flow-fact"))
    }
    &rows.sort_by((a, b) -> (a.span.start <=> b.span.start).then(a.span.end <=> b.span.end).then(mir_decision_kind_order(a.kind) <=> mir_decision_kind_order(b.kind)).then(a.function_name <=> b.function_name).then(a.id <=> b.id))
    rows
}
fn mir_decision_kind_order(kind: MIRDecisionKind) -> Int Never! {
    if kind == {
        .Tier -> 0
        .Inline -> 1
        .Vectorize -> 2
        .Parallel -> 3
        .Copy -> 4
        .Bounds -> 5
        .Deopt -> 6
        .Unreachable -> 7
        .LoopInvariant -> 8
    }
}
fn mir_decision_ledger(program: MIRProgram, artifact: MIRArtifactID?, profile: String, run: String, additional: [MIRDecisionRow]) -> MIRDecisionLedger Never! {
    rows := mir_decision_ledger_rows(program)
    &rows.extend(additional)
    mir_decision_ledger_from_rows(mir_decision_identity(program, artifact, profile, run), rows)
}
fn mir_decision_identity_json(identity: MIRDecisionIdentity) -> String Never! {
    "{{\"artifact\":{foundation_json_quote(identity.artifact)},\"configuration\":{foundation_json_quote(identity.configuration)},\"implementation\":{foundation_json_quote(identity.implementation)},\"profile\":{foundation_json_quote(identity.profile)},\"run\":{foundation_json_quote(identity.run)},\"source\":{foundation_json_quote(identity.source)},\"target\":{foundation_json_quote(identity.target)}}}"
}
fn mir_decision_span_json(span: Span) -> String Never! { "{{\"end\":{span.end},\"start\":{span.start}}}" }
fn mir_decision_method_json(method: MIRDerivationMethod) -> String Never! {
    foundation_json_quote(if method == {
        .StaticDerivation -> "static_derivation"
        .FormalProof -> "formal_proof"
        .RecordedExecution -> "recorded_execution"
        .SampledAgreement -> "sampled_agreement"
        .ExternalAssumption -> "external_assumption"
    })
}
fn mir_decision_derivation_disposition_json(disposition: MIRDerivationDisposition) -> String Never! {
    foundation_json_quote(if disposition == {
        .Current -> "current"
        .Stale -> "stale"
        .Expired -> "expired"
        .Redacted -> "redacted"
        .Unavailable -> "unavailable"
        .Unsupported -> "unsupported"
        .BudgetExhausted -> "budget_exhausted"
        .Unknown -> "unknown"
    })
}
fn mir_decision_row_json(row: MIRDecisionRow) -> String Never! {
    function :: if row.function != None -> foundation_json_quote(row.function_name) else -> "null"
    function_id :: if row.function == .Val(id) -> foundation_json_quote("{id.value}") else -> "null"
    method :: if row.evidence_method == .Val(value) -> mir_decision_method_json(value) else -> "null"
    disposition :: if row.derivation_disposition == .Val(value) -> mir_decision_derivation_disposition_json(value) else -> "null"
    reference :: if row.derivation == .Val(value) -> "{{\"id\":{foundation_json_quote(value.id)}}}" else -> "null"
    identity :: if row.identity == .Val(value) -> mir_decision_identity_json(value) else -> "null"
    edit :: if row.edit == .Val(value) -> "{{\"replacement\":{foundation_json_quote(value.replacement)},\"span\":{mir_decision_span_json(value.span)}}}" else -> "null"
    "{{\"derivation_disposition\":{disposition},\"derivation_ref\":{reference},\"disposition\":{foundation_json_quote(mir_pass_decision_disposition_name(row.disposition))},\"edit\":{edit},\"evidence\":{foundation_json_quote(row.evidence)},\"evidence_method\":{method},\"function\":{function},\"function_id\":{function_id},\"function_name\":{foundation_json_quote(row.function_name)},\"id\":{foundation_json_quote("{row.id}")},\"identity\":{identity},\"kind\":{foundation_json_quote(mir_pass_decision_kind_name(row.kind))},\"producer\":{foundation_json_quote(row.producer)},\"reason\":{foundation_json_quote(row.reason)},\"rule\":{foundation_json_quote(row.rule)},\"span\":{mir_decision_span_json(row.span)}}}"
}
fn mir_decision_ledger_json(ledger: MIRDecisionLedger) -> String Never! {
    rows :: ledger.rows.map(row -> mir_decision_row_json(row))
    "{{\"identity\":{mir_decision_identity_json(ledger.identity)},\"rows\":[{rows.join(",")}],\"schema\":\"jet.mir.decisions.v1\"}}"
}

fn mir_decision_payload_error(message: String) -> MIRDecisionPayloadError Never! {
    MIRDecisionPayloadError{message: message}
}
fn mir_decision_object(value: Dyn, keys: [String], label: String) -> [String:Dyn] MIRDecisionPayloadError! {
    rows :: if value == .Object(entries) -> entries else -> { return Err(mir_decision_payload_error("{label} must be an object")) }
    fields := [String:Dyn]{}
    loop row in rows -> fields[row.key] = row.value
    if fields.len() != keys.len() -> return Err(mir_decision_payload_error("{label} has missing or unsafe fields"))
    loop key in keys {
        if fields.get(key) == .Val(_) -> next
        return Err(mir_decision_payload_error("{label} has missing or unsafe fields"))
    }
    Ok(fields)
}
fn mir_decision_text(fields: [String:Dyn], key: String) -> String MIRDecisionPayloadError! {
    value :: fields.get(key) ?? return Err(mir_decision_payload_error("decision field `{key}` is missing"))
    if value == .Text(text) -> Ok(text) else -> Err(mir_decision_payload_error("decision field `{key}` must be text"))
}
fn mir_decision_number(value: Dyn, label: String) -> U64 MIRDecisionPayloadError! {
    if value == .Text(text) {
        number := U64{0}
        if text.len() == 0 -> return Err(mir_decision_payload_error("{label} is out of range"))
        loop byte in text.bytes() {
            if byte < (U8{48}) || byte > (U8{57}) -> return Err(mir_decision_payload_error("{label} is out of range"))
            digit :: U64.from_u8(byte - U8{48})
            if number > (U64{18446744073709551615} - digit) / (U64{10}) -> return Err(mir_decision_payload_error("{label} is out of range"))
            number = number * U64{10} + digit
        }
        return Ok(number)
    }
    if value == .Int(number) -> return Ok(U64.from_int(number) ?? return Err(mir_decision_payload_error("{label} is out of range")))
    Err(mir_decision_payload_error("{label} must be an integer"))
}
fn mir_decision_parse_identity(value: Dyn) -> MIRDecisionIdentity MIRDecisionPayloadError! {
    fields :: mir_decision_object(value, ["artifact", "configuration", "implementation", "profile", "run", "source", "target"], "decision identity")
    Ok(MIRDecisionIdentity{artifact: mir_decision_text(fields, "artifact"), configuration: mir_decision_text(fields, "configuration"), implementation: mir_decision_text(fields, "implementation"), profile: mir_decision_text(fields, "profile"), run: mir_decision_text(fields, "run"), source: mir_decision_text(fields, "source"), target: mir_decision_text(fields, "target")})
}
fn mir_decision_parse_span(value: Dyn) -> Span MIRDecisionPayloadError! {
    fields :: mir_decision_object(value, ["start", "end"], "decision span")
    raw_start :: mir_decision_number(fields["start"], "span start")
    raw_end :: mir_decision_number(fields["end"], "span end")
    if raw_start > (U64{9223372036854775807}) || raw_end > (U64{9223372036854775807}) -> return Err(mir_decision_payload_error("decision span is out of range"))
    start :: Int.from_u64(raw_start)
    end :: Int.from_u64(raw_end)
    Ok(Span{start: start, end: end})
}
fn mir_decision_parse_kind(text: String) -> MIRDecisionKind MIRDecisionPayloadError! {
    loop kind in [MIRDecisionKind.Tier, MIRDecisionKind.Inline, MIRDecisionKind.Vectorize, MIRDecisionKind.Parallel, MIRDecisionKind.Copy, MIRDecisionKind.Bounds, MIRDecisionKind.Deopt, MIRDecisionKind.Unreachable, MIRDecisionKind.LoopInvariant] {
        if mir_pass_decision_kind_name(kind) == text -> return Ok(kind)
    }
    Err(mir_decision_payload_error("decision row has unsupported kind `{text}`"))
}
fn mir_decision_parse_disposition(text: String) -> MIRDecisionDisposition MIRDecisionPayloadError! {
    loop value in [MIRDecisionDisposition.Accepted, MIRDecisionDisposition.Rejected, MIRDecisionDisposition.Selected, MIRDecisionDisposition.NotAttempted, MIRDecisionDisposition.Unavailable] {
        if mir_pass_decision_disposition_name(value) == text -> return Ok(value)
    }
    Err(mir_decision_payload_error("decision row has unsupported disposition `{text}`"))
}
fn mir_decision_parse_method(value: Dyn) -> MIRDerivationMethod? MIRDecisionPayloadError! {
    if value == .Null -> return Ok(None)
    text :: if value == .Text(text) -> text else -> { return Err(mir_decision_payload_error("decision row has invalid `evidence_method`")) }
    loop method in [MIRDerivationMethod.StaticDerivation, MIRDerivationMethod.FormalProof, MIRDerivationMethod.RecordedExecution, MIRDerivationMethod.SampledAgreement, MIRDerivationMethod.ExternalAssumption] {
        if mir_decision_method_json(method) == foundation_json_quote(text) -> return Ok(Val(method))
    }
    Err(mir_decision_payload_error("decision row has unsupported `evidence_method`"))
}
fn mir_decision_parse_row(value: Dyn) -> MIRDecisionRow MIRDecisionPayloadError! {
    fields :: mir_decision_object(value, ["derivation_disposition", "derivation_ref", "disposition", "edit", "evidence", "evidence_method", "function", "function_id", "function_name", "id", "identity", "kind", "producer", "reason", "rule", "span"], "decision row")
    function := MIRFunctionID?{None}
    if fields["function_id"] == {
        .Null -> {}
        else -> function = Val(MIRFunctionID{value: mir_decision_number(fields["function_id"], "function id")})
    }
    row := mir_pass_decision_row(mir_decision_parse_kind(mir_decision_text(fields, "kind")), mir_decision_parse_disposition(mir_decision_text(fields, "disposition")), function, mir_decision_text(fields, "function_name"), mir_decision_parse_span(fields["span"]), mir_decision_text(fields, "rule"), mir_decision_text(fields, "reason"), mir_decision_text(fields, "producer"), mir_decision_text(fields, "evidence"))
    id :: mir_decision_number(fields["id"], "row id")
    if row.id != id -> return Err(mir_decision_payload_error("decision row id {id} does not match its canonical fields"))
    if fields["edit"] == .Null {
    } else {
        edit :: mir_decision_object(fields["edit"], ["replacement", "span"], "decision edit")
        row.edit = Val(MIRDecisionEdit{replacement: mir_decision_text(edit, "replacement"), span: mir_decision_parse_span(edit["span"])})
    }
    row.evidence_method = mir_decision_parse_method(fields["evidence_method"])
    // The canonical byte comparison below validates every transported identity,
    // reference, disposition and function projection against rematerialization.
    Ok(row)
}
fn mir_decision_ledger_read(payload: String) -> MIRDecisionLedger MIRDecisionPayloadError! {
    root :: foundation_parse_protocol_json(payload) ?? return Err(mir_decision_payload_error("decision ledger payload is not valid JSON"))
    fields :: mir_decision_object(root, ["identity", "rows", "schema"], "decision ledger payload")
    if mir_decision_text(fields, "schema") != "jet.mir.decisions.v1" -> return Err(mir_decision_payload_error("decision ledger payload has an unsupported schema"))
    identity :: mir_decision_parse_identity(fields["identity"])
    values :: if fields["rows"] == .Array(rows) -> rows else -> { return Err(mir_decision_payload_error("decision ledger payload rows must be an array")) }
    if values.len() > 4096 -> return Err(mir_decision_payload_error("decision ledger payload has too many rows"))
    rows := [MIRDecisionRow]{}
    loop value in values -> &rows.push(mir_decision_parse_row(value))
    ledger :: mir_decision_ledger_from_rows(identity, rows)
    if mir_decision_ledger_json(ledger) != payload -> return Err(mir_decision_payload_error("decision ledger payload is not canonical JSON or has an untrusted derivation relation"))
    Ok(ledger)
}

#Test("decision object projection retains canonical entry keys") {
    value :: foundation_parse_protocol_json("{{\"first\":1,\"second\":2}}") ?? panic("decision object fixture is invalid")
    fields :: mir_decision_object(value, ["first", "second"], "fixture") ?? panic("decision object fixture lost its keys")
    assert_eq(fields.len(), 2)
    rejected :: if mir_decision_object(value, ["first", "other"], "fixture") == {
        .Err(_) -> true
        .Ok(_) -> false
    }
    assert(rejected)
}
