fn mir_pass_drop_before(left: MirDropAction, right: MirDropAction) -> Bool Never! {
    if {
        left.place.value != right.place.value -> left.place.value < right.place.value
        left.span.start != right.span.start -> left.span.start < right.span.start
        else -> left.span.end < right.span.end
    }
}
