    primary := [U64]{}
    text := [String]{}
    loop index in 0..<rows.len() {
        &primary.push(rows[index].id.value)
        &text.push(rows[index].key)
    }
    compiler_apply_order<MIRTypeDef>(&rows, mir_pass_canonical_order(primary, [U64]{}, text))
}

fn mir_pass_sort_traits(rows: &[MIRTraitDef]) Never! {
    primary := [U64]{}
