fn mir_pass_sort_constants(rows: &[MIRConstantDef]) Never! {
    primary := [U64]{}
    text := [String]{}
    loop index in 0..<rows.len() {
        &primary.push(rows[index].id.value)
        &text.push(rows[index].key)
    }
    compiler_apply_order<MIRConstantDef>(&rows, mir_pass_canonical_order(primary, [U64]{}, text))
}

// Instances without an identity sort first (0); the canonical key breaks
// ties and is built once per row rather than once per comparison. Apply the
// stable index permutation by transferring rows, never copying their payloads.
fn mir_pass_sort_type_instances(rows: &[MIRType]) Never! {
    primary := [U64]{}
    secondary := [U64]{}
    text := [String]{}
    loop index in 0..<rows.len() {
        &primary.push(if rows[index].identity == None -> U64{0} else -> U64{1})
        &secondary.push(rows[index].identity.map(value -> value.value) ?? U64{0})
        &text.push(mir_type_canonical_key(rows[index]))
    }
    compiler_apply_order<MIRType>(&rows, mir_pass_canonical_order(primary, secondary, text))
}

fn mir_pass_sort_fields(rows: &[MIRFieldRow]) Never! {
    primary := [U64]{}
    secondary := [U64]{}
    loop index in 0..<rows.len() {
        &primary.push(rows[index].id.value)
        &secondary.push(rows[index].owner.value)
    }
    compiler_apply_order<MIRFieldRow>(&rows, mir_pass_canonical_order(primary, secondary, [String]{}))
}

fn mir_pass_sort_source_files(rows: &[MIRSourceFile]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: MIRSourceFile, right: MIRSourceFile) -> if {
        left.id.value != right.id.value -> left.id.value <=> right.id.value
        left.path != right.path -> left.path <=> right.path
        else -> left.source <=> right.source
    })
}

fn mir_pass_sort_core_calls(rows: &[MIRCoreCall]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: MIRCoreCall, right: MIRCoreCall) -> if left.id.value != right.id.value -> left.id.value <=> right.id.value else -> left.key <=> right.key)
}

fn mir_pass_sort_prelude_calls(rows: &[MIRPreludeCall]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: MIRPreludeCall, right: MIRPreludeCall) -> if {
        left.id.value != right.id.value -> left.id.value <=> right.id.value
        left.module_name != right.module_name -> left.module_name <=> right.module_name
        else -> left.member <=> right.member
    })
}

fn mir_pass_sort_foreign(rows: &[MIRForeign]) Never! {
