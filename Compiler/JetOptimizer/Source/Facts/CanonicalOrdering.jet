// Stable row order by id alone (mir_pass_canonical_order).
fn mir_pass_id_order(ids: [Int]) -> [Int] Never! {
    secondary := [Int]{}
    text := [String]{}
    loop _ in ids {
        &secondary.push(0)
        &text.push("")
    }
    mir_pass_canonical_order(ids, secondary, text)
}

fn mir_pass_sort_blocks(rows: &[MIRBasicBlock]) Never! {
    ids := [Int]{}
    loop index in 0..<rows.len() -> &ids.push(rows[index].id.value)
    sorted := [MIRBasicBlock]{}
    loop position in mir_pass_id_order(ids) -> &sorted.push(rows[position])
    loop index in 0..<sorted.len() -> rows[index] = sorted[index]
}

fn mir_pass_sort_captures(rows: &[MIRCaptureParam]) Never! {
