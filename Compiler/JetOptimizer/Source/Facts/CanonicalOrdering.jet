}

fn mir_pass_capture_before(left: MIRCaptureParam, right: MIRCaptureParam) -> Bool Never! {
    if left.slot != right.slot -> left.slot < right.slot else -> left.name < right.name
}

fn mir_pass_sort_values(rows: &[MIRValueFact]) Never! {
    ids := [Int]{}
    loop index in 0..<rows.len() -> &ids.push(rows[index].id.value)
    sorted := [MIRValueFact]{}
    loop position in mir_pass_id_order(ids) -> &sorted.push(rows[position])
