fn mir_pass_sort_type_instances(rows: &[MirType]) {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_type_instance_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_type_instance_before(left: MirType, right: MirType) -> Bool {
    left_id :: left.identity.map(value -> value.value) ?? -1
    right_id :: right.identity.map(value -> value.value) ?? -1
    if left_id != right_id -> left_id < right_id else -> mir_type_canonical_key(left) < mir_type_canonical_key(right)
}

