// Stable ordering for optimizer-produced canonical MIR.
fn mir_pass_canonicalize_program_order(program: &MirProgram) Never! {
    modules_window := &program.modules
    mir_pass_sort_modules(&modules_window)
    imports_window := &program.imports
    mir_pass_sort_imports(&imports_window)
    functions_window := &program.functions
    mir_pass_sort_functions(&functions_window)
    types_window := &program.types
    mir_pass_sort_type_defs(&types_window)
    traits_window := &program.traits
    mir_pass_sort_traits(&traits_window)
    impls_window := &program.impls
    mir_pass_sort_impls(&impls_window)
    constants_window := &program.constants
    mir_pass_sort_constants(&constants_window)
    type_instances_window := &program.type_instances
    mir_pass_sort_type_instances(&type_instances_window)
    fields_window := &program.fields
    mir_pass_sort_fields(&fields_window)
    source_files_window := &program.source_files
    mir_pass_sort_source_files(&source_files_window)
    core_calls_window := &program.core_calls
    mir_pass_sort_core_calls(&core_calls_window)
    prelude_calls_window := &program.prelude_calls
    mir_pass_sort_prelude_calls(&prelude_calls_window)
    foreign_window := &program.foreign
    mir_pass_sort_foreign(&foreign_window)
    links_window := &program.links
    mir_pass_sort_links(&links_window)
    callbacks_window := &program.callbacks
    mir_pass_sort_callbacks(&callbacks_window)
    handles_window := &program.handles
    mir_pass_sort_handles(&handles_window)
    jobs_window := &program.jobs
    mir_pass_sort_jobs(&jobs_window)
    tests_window := &program.tests
    mir_pass_sort_tests(&tests_window)
    harnesses_window := &program.harnesses
    mir_pass_sort_harnesses(&harnesses_window)
    artifacts_window := &program.artifacts
    mir_pass_sort_artifacts(&artifacts_window)
    unreachable_window := &program.unreachable
    mir_pass_sort_unreachable(&unreachable_window)
    loop index in 0..<program.imports.len() {
        if program.imports[index].kind == {
            .Unqualified(module_id, items) -> {
                sorted_items := items
                mir_pass_sort_import_items(&sorted_items)
                program.imports[index].kind = MirImportKind.Unqualified{module_id: module_id, items: sorted_items}
            }
            else -> {}
        }
    }
    loop index in 0..<program.traits.len() {
        methods_window := &program.traits[index].methods
        mir_pass_sort_trait_methods(&methods_window)
    }
    loop index in 0..<program.impls.len() {
        associated_types_window := &program.impls[index].associated_types
        mir_pass_sort_associated_types(&associated_types_window)
        methods_window := &program.impls[index].methods
        mir_pass_sort_function_ids(&methods_window)
    }
    loop index in 0..<program.links.len() {
        link_closure_window := &program.links[index].link_closure
        mir_pass_sort_link_ids(&link_closure_window)
    }
    loop index in 0..<program.functions.len() {
        blocks_window := &program.functions[index].blocks
        mir_pass_sort_blocks(&blocks_window)
        captures_window := &program.functions[index].capture_params
        mir_pass_sort_captures(&captures_window)
        values_window := &program.functions[index].values
        mir_pass_sort_values(&values_window)
        locals_window := &program.functions[index].locals
        mir_pass_sort_locals(&locals_window)
        places_window := &program.functions[index].places
        mir_pass_sort_places(&places_window)
        scopes_window := &program.functions[index].scopes
        mir_pass_sort_scopes(&scopes_window)
        drops_window := &program.functions[index].drops
        mir_pass_sort_drops(&drops_window)
    }
}

fn mir_pass_sort_modules(rows: &[MirModule]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_module_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_module_before(left: MirModule, right: MirModule) -> Bool Never! {
    if left.id.value != right.id.value -> left.id.value < right.id.value else -> left.key < right.key
}

fn mir_pass_sort_imports(rows: &[MirImport]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_import_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_import_before(left: MirImport, right: MirImport) -> Bool Never! {
    if left.id.value != right.id.value -> left.id.value < right.id.value else -> left.module_id.value < right.module_id.value
}

