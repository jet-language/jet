fn mir_pass_sort_blocks(rows: &[MIRBasicBlock]) Never! {
    primary := [U64]{}
    loop index in 0..<rows.len() -> &primary.push(rows[index].id.value)
    compiler_apply_order<MIRBasicBlock>(&rows, mir_pass_canonical_order(primary, [U64]{}, [String]{}))
}

