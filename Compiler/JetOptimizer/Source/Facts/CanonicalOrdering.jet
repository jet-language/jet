fn mir_pass_sort_unreachable(rows: &[MIRUnreachable]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: MIRUnreachable, right: MIRUnreachable) -> if {
        left.span.start != right.span.start -> left.span.start <=> right.span.start
        left.span.end != right.span.end -> left.span.end <=> right.span.end
        else -> left.construct <=> right.construct
    })
}

