// Instances without an identity sort first (-1); the canonical key breaks
// ties and is built once per row rather than once per comparison.
fn mir_pass_sort_type_instances(rows: &[MIRType]) Never! {
    primary := [Int]{}
    secondary := [Int]{}
    text := [String]{}
    loop index in 0..<rows.len() {
        &primary.push(rows[index].identity.map(value -> value.value) ?? -1)
        &secondary.push(0)
        &text.push(mir_type_canonical_key(rows[index]))
    }
    sorted := [MIRType]{}
    loop position in mir_pass_canonical_order(primary, secondary, text) -> &sorted.push(rows[position])
    loop index in 0..<sorted.len() -> rows[index] = sorted[index]
}

fn mir_pass_sort_fields(rows: &[MIRFieldRow]) Never! {
    primary := [Int]{}
    secondary := [Int]{}
    text := [String]{}
    loop index in 0..<rows.len() {
        &primary.push(rows[index].id.value)
        &secondary.push(rows[index].owner.value)
        &text.push("")
    }
    sorted := [MIRFieldRow]{}
    loop position in mir_pass_canonical_order(primary, secondary, text) -> &sorted.push(rows[position])
    loop index in 0..<sorted.len() -> rows[index] = sorted[index]
}

fn mir_pass_sort_source_files(rows: &[MIRSourceFile]) Never! {
    loop index in 1..<rows.len() {
        current := rows[index]
        cursor := index
        loop cursor > 0 && mir_pass_source_file_before(current, rows[cursor - 1]) {
            rows[cursor] = rows[cursor - 1]
            cursor -= 1
        }
        rows[cursor] = current
    }
}

fn mir_pass_source_file_before(left: MIRSourceFile, right: MIRSourceFile) -> Bool Never! {
    if {
        left.id.value != right.id.value -> left.id.value < right.id.value
        left.path != right.path -> left.path < right.path
        else -> left.source < right.source
    }
}

