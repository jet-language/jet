// Assembled with the exact production sort helpers by run-lint-fixtures.mjs
// --canonical-order; the MIR builders are shared with the lowering fixtures.
fn order_function(id: U64, key: String, name: String) -> MIRFunction Never! {
    builder := fx_builder()
    _ := fx_local(&builder, name, fx_string(), mir_owned_ownership())
    _ := fx_int_const(&builder, 42)
    fx_block(&builder, 0, MIRTerminator.Return{value: None})
    function := fx_function(name, builder, fx_unit())
    function.id = MIRFunctionID{value: id}
    function.key = key
    function
}

fn order_expect_functions(rows: [MIRFunction]) -> Bool Never! {
    rows.len() == 4 && rows[0].name == "first" && rows[1].name == "equal-a" && rows[2].name == "equal-b" && rows[3].name == "last"
}

fn order_expect_payload(rows: [MIRFunction]) -> Bool Never! {
    loop row in rows {
        if row.blocks.len() != 1 || row.blocks[0].instructions.len() != 1 || row.values.len() != 1 || row.locals.len() != 1 || row.locals[0].name != row.name -> return false
    }
    true
}

fn run() {
    optimizer_rows := [MIRFunction]{order_function(9, "a", "last"), order_function(2, "b", "equal-a"), order_function(2, "a", "first"), order_function(2, "b", "equal-b")}
    mir_pass_sort_functions(&optimizer_rows)
    if !order_expect_functions(optimizer_rows) -> panic("optimizer changed canonical keys or equal-key stability")
    mir_pass_sort_functions(&optimizer_rows)
    if !order_expect_functions(optimizer_rows) -> panic("optimizer canonical order is not idempotent")

    codegen_rows := [MIRFunction]{order_function(9, "a", "last"), order_function(2, "b", "equal-a"), order_function(2, "a", "first"), order_function(2, "b", "equal-b")}
    jet_codegen_sort_functions(&codegen_rows)
    if !order_expect_functions(codegen_rows) -> panic("codegen changed canonical keys or equal-key stability")

    if !order_expect_payload(optimizer_rows) || !order_expect_payload(codegen_rows) -> panic("canonical sorting lost deep MIR payloads")

    cycle := [MIRFunction]{order_function(2, "same", "two"), order_function(3, "same", "three"), order_function(1, "same", "one")}
    mir_pass_sort_functions(&cycle)
    if cycle.len() != 3 || cycle[0].name != "one" || cycle[1].name != "two" || cycle[2].name != "three" || !order_expect_payload(cycle) -> panic("three-cycle permutation lost or duplicated a row")
    equal := [MIRFunction]{order_function(1, "same", "a"), order_function(1, "same", "b"), order_function(1, "same", "c")}
    mir_pass_sort_functions(&equal)
    jet_codegen_sort_functions(&equal)
    if equal[0].name != "a" || equal[1].name != "b" || equal[2].name != "c" || !order_expect_payload(equal) -> panic("all-equal row order changed")

    large := [MIRFunction]{}
    loop index in 0..<2048 {
        id :: U64.from_int(2048 - index) ?? panic("fixture identity does not fit U64")
        &large.push(order_function(id, "large", "{index}"))
    }
    jet_codegen_sort_functions(&large)
    loop index in 0..<large.len() {
        expected :: U64.from_int(index + 1) ?? panic("fixture identity does not fit U64")
        if large[index].id.value != expected || large[index].name != "{2047 - index}" -> panic("large canonical permutation changed keys or payload order")
    }
    if large.len() != 2048 || !order_expect_payload(large) -> panic("large canonical permutation lost deep MIR payloads")
    empty := [MIRFunction]{}
    mir_pass_sort_functions(&empty)
    jet_codegen_sort_functions(&empty)
    if empty.len() != 0 -> panic("sorting inserted a function")
    single := [MIRFunction]{order_function(3, "one", "single")}
    mir_pass_sort_functions(&single)
    jet_codegen_sort_functions(&single)
    if single.len() != 1 || single[0].name != "single" -> panic("sorting changed a singleton")
    instances := [MIRType]{mir_type_with_identity(fx_string(), MIRTypeID{value: 0}), fx_bool(), fx_int()}
    mir_pass_sort_type_instances(&instances)
    if instances[0].kind != MIRTypeKind.Bool || instances[0].identity != None || instances[1].kind != MIRTypeKind.Int || instances[1].identity != None || instances[2].identity != Val(MIRTypeID{value: 0}) -> panic("type-instance slot permutation changed identity/key order")
    mir_pass_sort_type_instances(&instances)
    if instances[0].kind != MIRTypeKind.Bool || instances[1].kind != MIRTypeKind.Int || instances[2].kind != MIRTypeKind.String -> panic("type-instance permutation is not idempotent")
    empty_instances := [MIRType]{}
    mir_pass_sort_type_instances(&empty_instances)
    if empty_instances.len() != 0 -> panic("type-instance sorting inserted a row")

    from := [MIRFunction]{order_function(4, "a", "source-a"), order_function(5, "b", "source-b")}
    to := [MIRFunction]{order_function(1, "prefix", "prefix")}
    compiler_transfer_rows<MIRFunction>(&to, &from)
    if from.len() != 0 || to.len() != 3 || to[0].name != "prefix" || to[1].name != "source-a" || to[2].name != "source-b" || !order_expect_payload(to) -> panic("owning row transfer lost prefix, order, or deep payload")
    compiler_transfer_rows<MIRFunction>(&to, &from)
    if to.len() != 3 -> panic("empty owning transfer changed destination")
    optional_program := Val(fx_program(to, [MIRTypeDef]{}))
    program := ^optional_program ?? panic("owning MIR optional transfer lost the program")
    if program.functions.len() != 3 || !order_expect_payload(program.functions) || program.functions[1].name != "source-a" -> panic("owning MIR optional handoff lost identity or deep payload")
    print("PASS canonical owned-row permutation: stable keys, deep payloads, three-cycle, all-equal, large, idempotence, empty, singleton")
}
