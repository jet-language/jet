// The optimizer's one MIR checker over hand-built MIR: per function, its
// identity, then the legality rules (Verification/Legality.jet), then, when
// those hold, the MIR Lint rules (Verification/Lint.jet); one failure per
// rejected function in program order, every function moved back in order.
// Pipeline mir_pass_check_owned_part is the part every check wave runs and
// mir_optimizer_function_failures the keep-going scan. Assembled with the
// production checker sources by run-lint-fixtures.mjs --check; the MIR
// builders are the lowering fixtures'. Never listed in
// Compiler/Bootstrap/sources.list.

// Legality asks for non-zero block identities; the fixture blocks are 1.
fn cf_function(id: U64, name: String, b: FxBuilder) -> MIRFunction Never! {
    function := fx_function(name, b, fx_unit())
    function.id = MIRFunctionID{value: id}
    function.key = "check::{name}"
    function.entry = MIRBlockID{value: 1}
    function
}

// Legal and lint-clean: one constant, then return.
fn cf_clean(id: U64, name: String) -> MIRFunction Never! {
    b := fx_builder()
    _ := fx_int_const(&b, 1)
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    cf_function(id, name, b)
}

// Legal, but `operation.typing` rejects it: a comparison that produces an Int.
fn cf_lint_bug(id: U64, name: String) -> MIRFunction Never! {
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    _ := fx_copy(&b, fx_int(), MIROperation.Binary{op: MIRBinaryOp.Lt, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: one, right: two})
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    cf_function(id, name, b)
}

// Illegal (and lint-rejected too): a copy of a value nothing defines. The
// legality rule reports it; the lint rules never run on it.
fn cf_legality_bug(id: U64, name: String) -> MIRFunction Never! {
    b := fx_builder()
    _ := fx_copy(&b, fx_int(), MIROperation.Copy{value: MIRValueID{value: 999}, fact: MIRCopyFact.Materialize})
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    cf_function(id, name, b)
}

fn cf_program(functions: [MIRFunction]) -> MIRProgram Never! {
    fx_program(functions, [MIRTypeDef]{})
}

// The checker over a copy of `program`'s functions, as a wave part holds
// them (last-first); the part must hold them in the same order afterwards.
fn cf_check(program: MIRProgram, all: Bool) -> [MIROptimizationError] {
    rows :: mir_pass_validate_program_rows(program, MIROptimizationPassID.CanonicalLoopFacts)
    if rows == .Val(error) -> return [MIROptimizationError]{error}
    index := mir_lint_index(program)
    functions := [MIRFunction]{}
    position := program.functions.len()
    loop position > 0 {
        position -= 1
        &functions.push(program.functions[position].copy())
    }
    failures :: mir_pass_check_owned_part(^index, mir_pass_check_inputs(program, MIROptimizationPassID.CanonicalLoopFacts), 0, &functions, all)
    if functions.len() != program.functions.len() -> panic("the check lost or added a function")
    loop offset in 0..<functions.len() {
        if functions[functions.len() - 1 - offset].id != program.functions[offset].id -> panic("the check changed the part's function order")
    }
    failures
}

fn cf_expect(name: String, ok: Bool, detail: String) -> Bool {
    print(if ok -> "PASS {name}" else -> "FAIL {name}: {detail}")
    ok
}

fn cf_rows(failures: [MIROptimizationError]) -> String {
    rows := [String]{}
    loop failure in failures {
        function :: if failure.function == .Val(id) -> "{id.value}" else -> "-"
        &rows.push("{function}: {failure.message}")
    }
    rows.join(" | ")
}

fn cf_is_lint(failure: MIROptimizationError, function: U64) -> Bool {
    failure.kind == .Lint && failure.function == Val(MIRFunctionID{value: function}) && failure.message.starts_with("MIR lint failed after pass canonical-loop-facts: rule operation.typing in function `check::")
}

fn cf_is_legality(failure: MIROptimizationError, function: U64) -> Bool {
    failure.kind == .InvalidDefUse && failure.function == Val(MIRFunctionID{value: function}) && failure.message == "MIR operation reads an undefined SSA value"
}

fn run() {
    passed := 0
    failed := 0

    clean :: cf_check(cf_program([MIRFunction]{cf_clean(1, "first"), cf_clean(2, "second")}), true)
    mixed_program :: cf_program([MIRFunction]{cf_clean(1, "clean"), cf_lint_bug(2, "lint"), cf_legality_bug(3, "legality"), cf_clean(4, "tail")})
    mixed :: cf_check(mixed_program, true)
    first :: cf_check(mixed_program, false)
    duplicate :: cf_check(cf_program([MIRFunction]{cf_clean(5, "one"), cf_clean(5, "two")}), true)
    zero :: cf_check(cf_program([MIRFunction]{cf_clean(0, "zero")}), true)
    keep_going :: mir_optimizer_function_failures(mixed_program, mixed[0])
    schema_program := cf_program([MIRFunction]{cf_lint_bug(2, "lint")})
    schema_program.schema_version = schema_program.schema_version + 1
    schema :: cf_check(schema_program, true)
    schema_keep_going :: mir_optimizer_function_failures(schema_program, mixed[0])

    results :: [Bool]{
        cf_expect("clean program", clean.len() == 0, cf_rows(clean)),
        cf_expect("every failing function, in program order", mixed.len() == 2 && cf_is_lint(mixed[0], 2) && cf_is_legality(mixed[1], 3), cf_rows(mixed)),
        cf_expect("first failure ends the part", first.len() == 1 && cf_is_lint(first[0], 2), cf_rows(first)),
        cf_expect("duplicate function identity", duplicate.len() == 1 && duplicate[0].kind == .InvalidSchema && duplicate[0].message == "MIR function identity is duplicated", cf_rows(duplicate)),
        cf_expect("zero function identity", zero.len() == 1 && zero[0].kind == .InvalidSchema && zero[0].message == "MIR function has a zero stable identity", cf_rows(zero)),
        cf_expect("keep-going scan names both rule sets' rejects", keep_going.len() == 2 && cf_is_lint(keep_going[0], 2) && cf_is_legality(keep_going[1], 3), cf_rows(keep_going)),
        cf_expect("keep-going lists a program-level failure after the error and stops", schema_keep_going.len() == 2 && cf_is_lint(schema_keep_going[0], 2) && schema_keep_going[1].function == None, cf_rows(schema_keep_going)),
        cf_expect("program-level legality failure ends the check", schema.len() == 1 && schema[0].function == None && schema[0].message == "MIR schema version does not match the canonical schema", cf_rows(schema)),
    }
    loop ok in results {
        if {
            ok -> passed += 1
            else -> failed += 1
        }
    }
    print("{passed} passed, {failed} failed")
    print(if failed == 0 -> "all check fixtures passed" else -> "CHECK FIXTURE FAILURES")
}
