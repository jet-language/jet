// MIR Lint fixtures: one clean program and one planted bug per rule family of
// Docs/spec/mir-lint.md, plus the four hand-built MIR programs of the
// lowering fixtures as programs that must lint clean. The fixture reuses the
// builders of Compiler/JetBackend/Tests/Fragments.fixture/LowerFixtures.jet and is assembled
// into a test unit by Compiler/JetOptimizer/Tests/run-lint-fixtures.mjs.
use jet_foundation.[
    MIRAccess,
    MIRBinaryDispatch,
    MIRBinaryOp,
    MIRBinaryOverflow,
    MIRBlockID,
    MIRCallArg,
    MIRCallee,
    MIRCaptureFacts,
    MIRCaptureOperand,
    MIRCaptureParam,
    MIRConstant,
    MIRCopyFact,
    MIRCoreClosureKind,
    MIRDropKind,
    MIREnumArg,
    MIRField,
    MIRFieldValue,
    MIRFunction,
    MIRFunctionID,
    MIRFunctionSignature,
    MIRIndexKind,
    MIRLoopSourceKind,
    MIROperation,
    MIRPanicLoc,
    MIRPhiIncoming,
    MIRPreludeTypeArg,
    MIRPlace,
    MIRPlaceBase,
    MIRPlaceID,
    MIRPreludeABI,
    MIRPreludeFamily,
    MIRProgram,
    MIRProjection,
    MIRScope,
    MIRScopeFact,
    MIRScopeID,
    MIRScopeKind,
    MIRSemanticOp,
    MIRSiteID,
    MIRTerminator,
    MIRType,
    MIRTypeDef,
    MIRTypeDefKind,
    MIRTypeKind,
    MIRValueID,
    MIRVariant,
    MIRVariantPayload,
    MIRViewProvenance,
    MIRViewProvenanceEntry,
    MIRViewProjection,
    MIRViewSource,
    MIRViewSourcePath,
    mir_copy_ownership,
    mir_copy_value_ownership,
    mir_field_id,
    mir_function_id,
    mir_nominal_ref,
    mir_owned_ownership,
    mir_ownership_from_access,
    mir_type_from_kind,
    mir_type_id,
    mir_type_with_identity,
]
use jet_optimizer.[MIRLintRule, mir_lint_error_text, mir_lint_program, mir_lint_rule_name]

fn lf_expect(name: String, program: MIRProgram, rule: MIRLintRule?) -> Bool {
    failure :: mir_lint_program(program)
    if failure == .Val(error) {
        if rule == .Val(expected) {
            if error.rule == expected {
                print("PASS {name}: {mir_lint_error_text(error)}")
                return true
            }
        }
        print("FAIL {name}: unexpected {mir_lint_error_text(error)}")
        return false
    }
    if rule == .Val(expected) {
        print("FAIL {name}: the planted {mir_lint_rule_name(expected)} bug was not reported")
        return false
    }
    print("PASS {name}: clean")
    true
}

fn lf_single(b: FxBuilder) -> MIRProgram Never! {
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, [MIRTypeDef]{})
}

// value.typed: a copy of a value with no defining row.
fn lf_value_typed(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    source :: if planted -> MIRValueID{value: 999} else -> one
    _ := fx_copy(&b, fx_int(), MIROperation.Copy{value: source, fact: MIRCopyFact.Materialize})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// type.well-formed: a zero-width fixed-width integer.
fn lf_type_well_formed(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    bits :: if planted -> 0 else -> 32
    _ := fx_owned(&b, mir_type_from_kind(MIRTypeKind.Option{inner: mir_type_from_kind(MIRTypeKind.IntN{signed: true, bits: bits})}), MIROperation.Absent)
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// operation.typing: a comparison that produces an Int.
fn lf_operation_typing(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    result_type :: if planted -> fx_int() else -> fx_bool()
    _ := fx_copy(&b, result_type, MIROperation.Binary{op: MIRBinaryOp.Lt, dispatch: MIRBinaryDispatch.Primitive, overflow: MIRBinaryOverflow.Unchecked, left: one, right: two})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// semantic.typing: overflow arithmetic cannot yield a Bool. Integer results
// are legal for the wrapping, saturating, trapping and rotate routes.
fn lf_semantic_typing(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    one :: fx_int_const(&b, 1)
    two :: fx_int_const(&b, 2)
    result_type :: if planted -> fx_bool() else -> mir_type_from_kind(MIRTypeKind.Option{inner: fx_int()})
    _ := fx_owned(&b, result_type, MIROperation.Semantic{operation: MIRSemanticOp.OverflowOption{call: fx_prelude_id("core.numeric", "checked_add"), left: one, right: two, location: None}})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// call.signature: an argument of the wrong type, checked against the callee
// row named by ID.
fn lf_call_signature(planted: Bool) -> MIRProgram Never! {
    c := fx_builder()
    n :: fx_param(&c, "n", fx_int(), mir_copy_ownership())
    fx_block(&c, 0, MIRTerminator.Return{value: Val(n)})
    r := fx_builder()
    argument :: if planted -> fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "seven"}}) else -> fx_int_const(&r, 7)
    _ := fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("identity")}, args: [MIRCallArg]{fx_arg(argument, MIRAccess.Read)}, type_args: [MIRType]{}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("identity", c, fx_int()), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// call.signature: a callee ID that names no function of the program.
fn lf_missing_callee() -> MIRProgram Never! {
    r := fx_builder()
    _ := fx_copy(&r, fx_int(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("absent")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    lf_single(r)
}

fn lf_types() -> [MIRTypeDef] Never! {
    [MIRTypeDef]{
        fx_type_def("Point", MIRTypeDefKind.Struct{fields: [MIRField]{fx_field("Point", "x", fx_int()), fx_field("Point", "y", fx_int())}, methods: [MIRFunctionID]{}}),
        fx_type_def("Shape", MIRTypeDefKind.Enum{variants: [MIRVariant]{fx_variant("Dot", MIRVariantPayload.Unit), fx_variant("Circle", MIRVariantPayload.Named{fields: [MIRField]{fx_field("Shape.Circle", "r", fx_int())}})}, methods: [MIRFunctionID]{}}),
    }
}

// enum.variant: a variant the declaration does not have, or the wrong payload arity.
fn lf_enum_variant(variant: String, with_payload: Bool) -> MIRProgram Never! {
    b := fx_builder()
    two :: fx_int_const(&b, 2)
    args :: if with_payload -> [MIREnumArg]{MIREnumArg{field: Val(mir_field_id("Shape.Circle.r")), value: two, boxed: false}} else -> [MIREnumArg]{}
    shape :: fx_owned(&b, fx_named("Shape"), MIROperation.Enum{type_id: mir_type_id("Shape"), variant: variant, args: args})
    fx_do(&b, MIROperation.Drop{value: shape, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, lf_types())
}

// struct.field: a literal that leaves out a field without a default.
fn lf_struct_field(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    x :: fx_int_const(&b, 3)
    y :: fx_int_const(&b, 4)
    fields := [MIRFieldValue]{MIRFieldValue{field: mir_field_id("Point.x"), value: x}}
    if !planted -> &fields.push(MIRFieldValue{field: mir_field_id("Point.y"), value: y})
    point :: fx_owned(&b, fx_named("Point"), MIROperation.Struct{type_id: mir_type_id("Point"), fields: fields})
    fx_do(&b, MIROperation.Drop{value: point, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("run", b, fx_unit())}, lf_types())
}

// terminator.typing: a branch on an Int.
fn lf_terminator_typing(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    condition :: if planted -> fx_int_const(&b, 1) else -> fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: true}})
    fx_block(&b, 0, MIRTerminator.Branch{condition: condition, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 1}})
    fx_block(&b, 1, MIRTerminator.Return{value: None})
    lf_single(b)
}

// ownership.move: an owned value used after it was moved.
fn lf_use_after_move(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    text :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "owned"}})
    moved :: fx_owned(&b, fx_string(), MIROperation.Move{value: text})
    dropped :: if planted -> text else -> moved
    fx_do(&b, MIROperation.Drop{value: dropped, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// Copy is a semantic property, not permission to leak a BigInt carrier.
fn lf_copy_value_consumed(twice: Bool) -> MIRProgram Never! {
    b := fx_builder()
    integer :: fx_value(&b, fx_int(), mir_copy_value_ownership(), MIROperation.Constant{value: MIRConstant.BigInt{decimal: "4611686018427387904"}})
    fx_do(&b, MIROperation.Drop{value: integer, kind: MIRDropKind.Value})
    if twice -> fx_do(&b, MIROperation.Drop{value: integer, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// memory/last_use_moves ownership shape: owned parent snapshot -> owned
// OptionValue -> selected Phi -> destination; dropping the parent snapshots
// must not consume the independent destination. Dropping the transferred Phi
// again is an ownership violation, not a second alias of the stored owner.
fn lf_owned_payload_phi_place(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    list_type :: lf_list()
    option_type :: mir_type_from_kind(MIRTypeKind.Option{inner: list_type})
    parent :: fx_local(&b, "parent", option_type, mir_owned_ownership())
    destination :: fx_local(&b, "destination", list_type, mir_owned_ownership())
    integer :: fx_int_const(&b, 4611686018427387904)
    list :: fx_owned(&b, list_type, MIROperation.BuildList{values: [MIRValueID]{integer}, trait_coercion: None})
    option :: fx_owned(&b, option_type, MIROperation.Present{value: list})
    fx_do(&b, MIROperation.WritePlace{place: parent, value: option})
    snapshot :: fx_owned(&b, option_type, MIROperation.ReadPlace{place: parent})
    some :: fx_copy(&b, fx_bool(), MIROperation.OptionIsSome{subject: snapshot})
    fx_block(&b, 0, MIRTerminator.Branch{condition: some, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    payload :: fx_owned(&b, list_type, MIROperation.OptionValue{subject: snapshot})
    fx_block(&b, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    empty :: fx_owned(&b, list_type, MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
    fx_block(&b, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    joined :: fx_owned(&b, list_type, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 1}, value: payload}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: empty}}})
    fx_do(&b, MIROperation.WritePlace{place: destination, value: joined})
    if planted -> fx_do(&b, MIROperation.Drop{value: joined, kind: MIRDropKind.Value})
    fx_do(&b, MIROperation.Drop{value: snapshot, kind: MIRDropKind.Value})
    parent_owner :: fx_value(&b, option_type, mir_ownership_from_access(MIRAccess.Move), MIROperation.MovePlace{place: parent})
    fx_do(&b, MIROperation.Drop{value: parent_owner, kind: MIRDropKind.Value})
    held :: fx_value(&b, list_type, mir_ownership_from_access(MIRAccess.Read), MIROperation.ReadPlace{place: destination})
    lf_borrowed_len(&b, held)
    final_owner :: fx_value(&b, list_type, mir_ownership_from_access(MIRAccess.Move), MIROperation.MovePlace{place: destination})
    fx_do(&b, MIROperation.Drop{value: final_owner, kind: MIRDropKind.Value})
    fx_block(&b, 3, MIRTerminator.Return{value: None})
    lf_single(b)
}

// math/fraction fallback ownership shape, without an OptionValue projection.
fn lf_owned_read_phi_place(planted: Bool) -> MIRProgram Never! {
    b := fx_builder()
    list_type :: lf_list()
    parent :: fx_local(&b, "parent", list_type, mir_owned_ownership())
    destination :: fx_local(&b, "destination", list_type, mir_owned_ownership())
    lf_fill(&b, parent)
    choice :: fx_param(&b, "choice", fx_bool(), mir_copy_ownership())
    fx_block(&b, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    snapshot :: fx_owned(&b, list_type, MIROperation.ReadPlace{place: parent})
    fx_block(&b, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    empty :: fx_owned(&b, list_type, MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
    fx_block(&b, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    joined :: fx_owned(&b, list_type, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 1}, value: snapshot}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: empty}}})
    fx_do(&b, MIROperation.WritePlace{place: destination, value: joined})
    if planted -> fx_do(&b, MIROperation.Drop{value: joined, kind: MIRDropKind.Value})
    parent_owner :: fx_value(&b, list_type, mir_ownership_from_access(MIRAccess.Move), MIROperation.MovePlace{place: parent})
    fx_do(&b, MIROperation.Drop{value: parent_owner, kind: MIRDropKind.Value})
    held :: fx_value(&b, list_type, mir_ownership_from_access(MIRAccess.Read), MIROperation.ReadPlace{place: destination})
    lf_borrowed_len(&b, held)
    final_owner :: fx_value(&b, list_type, mir_ownership_from_access(MIRAccess.Move), MIROperation.MovePlace{place: destination})
    fx_do(&b, MIROperation.Drop{value: final_owner, kind: MIRDropKind.Value})
    fx_block(&b, 3, MIRTerminator.Return{value: None})
    lf_single(b)
}

// A second place over the same local storage as `root`.
fn lf_alias_place(b: &FxBuilder, root: MIRPlaceID) -> MIRPlaceID Never! {
    alias :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    loop row in b.places {
        if row.id == root {
            &b.places.push(MIRPlace{id: alias, span: fx_span(), ty: row.ty, base: row.base, projections: [MIRProjection]{}, access: MIRAccess.Move, persist_key: None})
        }
    }
    alias
}

// ownership.move through the guard dataflow: an owner moved in the entry
// block and moved again by a cleanup block guarded by a Bool local. When the
// local is provably false on every path the cleanup edge is dead.
fn lf_guarded_cleanup(live: Bool) -> MIRProgram Never! {
    b := fx_builder()
    flag :: fx_local(&b, "flag", fx_bool(), mir_copy_ownership())
    owner :: fx_local(&b, "owner", fx_string(), mir_owned_ownership())
    again :: lf_alias_place(&b, owner)
    truth :: fx_copy(&b, fx_bool(), MIROperation.Constant{value: MIRConstant.Bool{value: live}})
    fx_do(&b, MIROperation.WritePlace{place: flag, value: truth})
    text :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "owned"}})
    fx_do(&b, MIROperation.WritePlace{place: owner, value: text})
    first :: fx_owned(&b, fx_string(), MIROperation.MovePlace{place: owner})
    fx_do(&b, MIROperation.Drop{value: first, kind: MIRDropKind.Value})
    fx_block(&b, 0, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    guard :: fx_copy(&b, fx_bool(), MIROperation.ReadPlace{place: flag})
    fx_block(&b, 1, MIRTerminator.Branch{condition: guard, then_target: MIRBlockID{value: 2}, else_target: MIRBlockID{value: 3}})
    second :: fx_owned(&b, fx_string(), MIROperation.MovePlace{place: again})
    fx_do(&b, MIROperation.Drop{value: second, kind: MIRDropKind.Value})
    fx_block(&b, 2, MIRTerminator.Return{value: None})
    fx_block(&b, 3, MIRTerminator.Return{value: None})
    lf_single(b)
}

// ownership.move: a move on only one branch is not a move on every path.
fn lf_one_branch_move() -> MIRProgram Never! {
    b := fx_builder()
    choice :: fx_param(&b, "choice", fx_bool(), mir_copy_ownership())
    owner :: fx_local(&b, "owner", fx_string(), mir_owned_ownership())
    again :: lf_alias_place(&b, owner)
    text :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "owned"}})
    fx_do(&b, MIROperation.WritePlace{place: owner, value: text})
    fx_block(&b, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    first :: fx_owned(&b, fx_string(), MIROperation.MovePlace{place: owner})
    fx_do(&b, MIROperation.Drop{value: first, kind: MIRDropKind.Value})
    refill :: fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "again"}})
    fx_do(&b, MIROperation.ReplacePlace{place: owner, value: refill})
    fx_block(&b, 1, MIRTerminator.Jump{target: MIRBlockID{value: 2}})
    last :: fx_owned(&b, fx_string(), MIROperation.MovePlace{place: again})
    fx_do(&b, MIROperation.Drop{value: last, kind: MIRDropKind.Value})
    fx_block(&b, 2, MIRTerminator.Return{value: None})
    lf_single(b)
}

// operation.typing: a string view (`View<str>`) is in the String class, so a
// string-view local reads as String and a view is an `Option<String>`
// payload; a `View<Int>` is neither.
fn lf_string_view(planted: Bool, present: Bool) -> MIRProgram Never! {
    b := fx_builder()
    window :: if planted -> fx_int() else -> mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("str"), args: [MIRType]{}})
    view_ty :: mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref("View"), args: [MIRType]{window}})
    text :: fx_param(&b, "text", view_ty, mir_copy_ownership())
    if present {
        _ := fx_copy(&b, mir_type_from_kind(MIRTypeKind.Option{inner: fx_string()}), MIROperation.Present{value: text})
    } else {
        right :: fx_local(&b, "right", view_ty, mir_copy_ownership())
        fx_do(&b, MIROperation.WritePlace{place: right, value: text})
        _ := fx_copy(&b, fx_string(), MIROperation.ReadPlace{place: right})
    }
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lf_single(b)
}

// effect.row: the callee's solved effects must be inside the caller's row.
fn lf_effect_row(caller_has_effect: Bool) -> MIRProgram Never! {
    c := fx_builder()
    fx_block(&c, 0, MIRTerminator.Return{value: None})
    callee := fx_function("write_file", c, fx_unit())
    callee.effects.solved = [String]{"FS.Write"}
    r := fx_builder()
    _ := fx_copy(&r, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("write_file")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    caller := fx_function("run", r, fx_unit())
    if caller_has_effect -> caller.effects.solved = [String]{"FS"}
    fx_program([MIRFunction]{callee, caller}, [MIRTypeDef]{})
}

// effect.row: a deny-only callee effect (`Mem.Alloc`, `Time.Wait`) is never
// outside the caller's row, as in Rust `effects_uncovered`.
fn lf_effect_row_deny_only() -> MIRProgram Never! {
    c := fx_builder()
    fx_block(&c, 0, MIRTerminator.Return{value: None})
    callee := fx_function("format_size", c, fx_unit())
    callee.effects.solved = [String]{"Mem", "Mem.Alloc", "Time.Wait"}
    r := fx_builder()
    _ := fx_copy(&r, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("format_size")}, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    caller := fx_function("run", r, fx_unit())
    fx_program([MIRFunction]{callee, caller}, [MIRTypeDef]{})
}

fn lf_list() -> MIRType Never! { mir_type_from_kind(MIRTypeKind.List{inner: fx_int()}) }

// A one-argument nominal type such as `View<Int>` or `Cell<Int>`.
fn lf_generic(name: String, inner: MIRType) -> MIRType Never! {
    mir_type_with_identity(mir_type_from_kind(MIRTypeKind.Apply{name: mir_nominal_ref(name), args: [MIRType]{inner}}), mir_type_id(name))
}

fn lf_send_fn() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.SendFn{params: [MIRType]{}, ret: Val(fx_unit()), conventions: [MIRAccess]{}})
}

fn lf_fn() -> MIRType Never! {
    mir_type_from_kind(MIRTypeKind.Fn{signature: MIRFunctionSignature{params: [MIRType]{}, ret: Val(fx_unit()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}})
}

// A closure body whose capture slot 0 has `access`.
fn lf_lambda(name: String, ty: MIRType, access: MIRAccess) -> MIRFunction Never! {
    b := fx_builder()
    fx_block(&b, 0, MIRTerminator.Return{value: None})
    lambda := fx_function(name, b, fx_unit())
    lambda.capture_params = [MIRCaptureParam]{MIRCaptureParam{slot: 0, name: "captured", span: fx_span(), ty: ty, access: access, ownership: mir_owned_ownership(), place_only: false}}
    lambda
}

fn lf_closure(b: &FxBuilder, ty: MIRType, lambda: String, capture: MIRCaptureOperand) -> MIRValueID Never! {
    facts :: MIRCaptureFacts{escapes: false, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}}
    fx_owned(&b, ty, MIROperation.Closure{function: mir_function_id(lambda), captures: [MIRCaptureOperand]{capture}, facts: facts})
}

// `task { … }`, or a task-group child when `group` is present.
fn lf_spawn(b: &FxBuilder, closure: MIRValueID, group: MIRValueID?) -> MIRValueID Never! {
    values := [MIRValueID]{}
    if group == .Val(value) -> &values.push(value)
    &values.push(fx_int_const(&b, 0))
    &values.push(fx_owned(&b, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: ""}}))
    fx_owned(&b, fx_named("Task"), MIROperation.Semantic{operation: MIRSemanticOp.CoreClosureCall{call: fx_prelude_id("core.tasks", "spawn"), kind: MIRCoreClosureKind.Spawn, values: values, closure: Val(closure), site: MIRSiteID{value: U64{1}}, label: ""}})
}

fn lf_fill(b: &FxBuilder, place: MIRPlaceID) Never! {
    list :: fx_owned(&b, lf_list(), MIROperation.BuildList{values: [MIRValueID]{}, trait_coercion: None})
    fx_do(&b, MIROperation.WritePlace{place: place, value: list})
}

fn lf_len(b: &FxBuilder, place: MIRPlaceID, ty: MIRType) Never! {
    source :: fx_owned(&b, ty, MIROperation.ReadPlace{place: place})
    _ := fx_copy(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_len"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
}

// `&place.push(4)`: a write window as the receiver of a resizing builtin.
fn lf_push(b: &FxBuilder, place: MIRPlaceID) Never! {
    pointer :: fx_value(&b, lf_list(), mir_ownership_from_access(MIRAccess.Write), MIROperation.AddressOf{place: place, access: MIRAccess.Write})
    four :: fx_int_const(&b, 4)
    fx_do(&b, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_push"), receiver: pointer, receiver_place: Val(place), args: [MIRValueID]{four}, aggregate_fields: None}})
}

fn lf_borrowed_len(b: &FxBuilder, value: MIRValueID) Never! {
    _ := fx_copy(&b, fx_int(), MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_len"), receiver: value, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
}

// The element `root[index]`.
fn lf_index_place(b: &FxBuilder, root: MIRPlaceID, index: MIRValueID, ty: MIRType) -> MIRPlaceID Never! {
    base := MIRPlaceBase.Static{name: ""}
    loop row in b.places {
        if row.id == root -> base = row.base
    }
    place :: MIRPlaceID{value: fx_word(U64{500}, b.places.len())}
    projection :: MIRProjection.Index{kind: MIRIndexKind.FixedListProof, index: index, call: fx_prelude_id("core.list", "index"), write_call: None, location: MIRPanicLoc{file: fx_source_file(), line: 1, column: 0}, context: None, span: fx_span()}
    &b.places.push(MIRPlace{id: place, span: fx_span(), ty: ty, base: base, projections: [MIRProjection]{projection}, access: MIRAccess.Write, persist_key: None})
    place
}

// `consume(^place)`: the argument moves the place.
fn lf_consume(b: &FxBuilder, place: MIRPlaceID, ty: MIRType) Never! {
    moved :: fx_owned(&b, ty, MIROperation.MovePlace{place: place})
    arg := fx_arg(moved, MIRAccess.Move)
    arg.place = Val(place)
    arg.owned_last_use = true
    _ := fx_copy(&b, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("consume")}, args: [MIRCallArg]{arg}, type_args: [MIRType]{}})
}

fn lf_consumer(ty: MIRType) -> MIRFunction Never! {
    c := fx_builder()
    _ := fx_param(&c, "taken", ty, mir_owned_ownership())
    fx_block(&c, 0, MIRTerminator.Return{value: None})
    fx_function("consume", c, fx_unit())
}

// alias.exclusive (E0204, tests/ui/projected_write_window_overlap.jet):
// `merge(&node, node)` writes a place another argument reads.
fn lf_call_alias(planted: Bool) -> MIRProgram Never! {
    c := fx_builder()
    _ := fx_param(&c, "a", lf_list(), mir_ownership_from_access(MIRAccess.Write))
    _ := fx_param(&c, "b", lf_list(), mir_ownership_from_access(MIRAccess.Read))
    fx_block(&c, 0, MIRTerminator.Return{value: None})
    r := fx_builder()
    node :: fx_local(&r, "node", lf_list(), mir_owned_ownership())
    other :: fx_local(&r, "other", lf_list(), mir_owned_ownership())
    lf_fill(&r, node)
    lf_fill(&r, other)
    second :: if planted -> node else -> other
    write_arg := fx_arg(fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: node}), MIRAccess.Write)
    write_arg.place = Val(node)
    read_arg := fx_arg(fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: second}), MIRAccess.Read)
    read_arg.place = Val(second)
    _ := fx_copy(&r, fx_unit(), MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("merge")}, args: [MIRCallArg]{write_arg, read_arg}, type_args: [MIRType]{}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{fx_function("merge", c, fx_unit()), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// alias.exclusive (#4621, memcorpus case 36): `add :: () -> { &v.push(2) }`
// keeps a write of `v` live; reading `v` before `add()` bypasses it.
fn lf_closure_alias(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    v :: fx_local(&r, "v", lf_list(), mir_owned_ownership())
    add :: fx_local(&r, "add", lf_fn(), mir_owned_ownership())
    lf_fill(&r, v)
    closure :: lf_closure(&r, lf_fn(), "add_body", MIRCaptureOperand.Place{place: v})
    fx_do(&r, MIROperation.WritePlace{place: add, value: closure})
    if planted -> lf_len(&r, v, lf_list())
    callee :: fx_owned(&r, lf_fn(), MIROperation.ReadPlace{place: add})
    _ := fx_copy(&r, fx_unit(), MIROperation.IndirectCall{callee: callee, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    lf_len(&r, v, lf_list())
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{lf_lambda("add_body", lf_list(), MIRAccess.Write), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// alias.exclusive (#4621, memcorpus case 62): `loop x in v { grow(x) }`
// where `grow` pushes into `v`; the clean program iterates another list.
fn lf_closure_loop(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    v :: fx_local(&r, "v", lf_list(), mir_owned_ownership())
    other :: fx_local(&r, "other", lf_list(), mir_owned_ownership())
    grow :: fx_local(&r, "grow", lf_fn(), mir_owned_ownership())
    lf_fill(&r, v)
    lf_fill(&r, other)
    closure :: lf_closure(&r, lf_fn(), "grow_body", MIRCaptureOperand.Place{place: v})
    fx_do(&r, MIROperation.WritePlace{place: grow, value: closure})
    source :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: if planted -> v else -> other})
    cursor :: fx_owned(&r, fx_named("Iter"), MIROperation.LoopIterInit{call: fx_prelude_id("core.loop", "loop_iter_init"), collection: source, step: None, by_value: false, source_kind: MIRLoopSourceKind.Plain})
    fx_block(&r, 0, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    more :: fx_copy(&r, fx_bool(), MIROperation.LoopIterHasNext{call: fx_prelude_id("core.loop", "loop_iter_has_next"), cursor: cursor})
    fx_block(&r, 1, MIRTerminator.Branch{condition: more, then_target: MIRBlockID{value: 2}, else_target: MIRBlockID{value: 3}})
    callee :: fx_owned(&r, lf_fn(), MIROperation.ReadPlace{place: grow})
    _ := fx_copy(&r, fx_unit(), MIROperation.IndirectCall{callee: callee, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_do(&r, MIROperation.LoopIterAdvance{call: fx_prelude_id("core.loop", "loop_iter_advance"), cursor: cursor})
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 1}})
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{lf_lambda("grow_body", lf_list(), MIRAccess.Write), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

fn lf_group_scope() -> MIRScopeID Never! { MIRScopeID{value: U64{7}} }

// A task group whose children each lend `particles[index]` for writing
// (`-1` spawns no child). `owner_move` 1 moves the owner inside the group,
// 2 after it joins. alias.exclusive and view.valid (E1101,
// tests/ui/taskgroup_overlapping_write_borrows.jet and
// taskgroup_lent_owner_moved.jet; Examples/features/concurrency/scoped_borrow_bands.jet).
fn lf_group_lend(first: Int, second: Int, owner_move: Int) -> MIRProgram Never! {
    r := fx_builder()
    particles :: fx_local(&r, "particles", lf_list(), mir_owned_ownership())
    group :: fx_local(&r, "g", fx_named("Group"), mir_owned_ownership())
    lf_fill(&r, particles)
    fx_do(&r, MIROperation.ScopeEnter{scope: lf_group_scope(), test_member: None})
    made :: fx_owned(&r, fx_named("Group"), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.tasks", "group"), args: [MIRCallArg]{}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_do(&r, MIROperation.WritePlace{place: group, value: made})
    indices :: [Int]{first, second}
    loop index in indices {
        if index < 0 -> next
        at :: fx_int_const(&r, index)
        element :: lf_index_place(&r, particles, at, fx_named("Particle"))
        handle :: fx_owned(&r, fx_named("Particle"), MIROperation.ReadPlace{place: element})
        closure :: lf_closure(&r, lf_send_fn(), "child_body", MIRCaptureOperand.Value{value: handle})
        owner :: fx_owned(&r, fx_named("Group"), MIROperation.ReadPlace{place: group})
        _ := lf_spawn(&r, closure, Val(owner))
    }
    if owner_move == 1 -> lf_consume(&r, particles, lf_list())
    fx_do(&r, MIROperation.ScopeExit{scope: lf_group_scope()})
    if owner_move == 2 -> lf_consume(&r, particles, lf_list())
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    run := fx_function("run", r, fx_unit())
    run.scopes = [MIRScope]{MIRScope{id: lf_group_scope(), kind: MIRScopeKind.TaskGroup, span: fx_span(), name: Val("g"), deadline: None, facts: [MIRScopeFact]{}}}
    fx_program([MIRFunction]{lf_lambda("child_body", fx_named("Particle"), MIRAccess.Write), lf_consumer(lf_list()), run}, [MIRTypeDef]{})
}

// view.valid (E0212, tests/ui/view_owner_changed.jet): `window ::
// values[0..1]`, then `&values.push(4)`, then `window.len()`.
fn lf_view_owner_changed(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    view_type :: lf_generic("View", fx_int())
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    window :: fx_local(&r, "window", view_type, mir_owned_ownership())
    lf_fill(&r, values)
    source :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: values})
    view :: fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    fx_do(&r, MIROperation.WritePlace{place: window, value: view})
    if planted -> lf_push(&r, values)
    lf_len(&r, window, view_type)
    if !planted -> lf_push(&r, values)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    lf_single(r)
}

// view.valid: `held := Val(values[..])`, `if held == { .Val(record) ->
// { held = None; record.len() } }`. The payload is the stored view of
// `values`, copied out like Rust's `Option<&[T]>` match, so rewriting `held`
// leaves it valid (the self-host cli_schema_fat_mach_sections shape; before,
// the payload was taken for a fresh view of `held` and flagged).
fn lf_view_payload_copy() -> MIRProgram Never! {
    r := fx_builder()
    view_type :: lf_generic("View", fx_int())
    option_type :: mir_type_from_kind(MIRTypeKind.Option{inner: view_type})
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    held :: fx_local(&r, "held", option_type, mir_owned_ownership())
    record :: fx_local(&r, "record", view_type, mir_owned_ownership())
    lf_fill(&r, values)
    source :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: values})
    view :: fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    stored :: fx_owned(&r, option_type, MIROperation.Present{value: view})
    fx_do(&r, MIROperation.WritePlace{place: held, value: stored})
    subject :: fx_owned(&r, option_type, MIROperation.ReadPlace{place: held})
    payload :: fx_owned(&r, view_type, MIROperation.OptionValue{subject: subject})
    fx_do(&r, MIROperation.WritePlace{place: record, value: payload})
    absent :: fx_owned(&r, option_type, MIROperation.Absent)
    fx_do(&r, MIROperation.WritePlace{place: held, value: absent})
    lf_len(&r, record, view_type)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    lf_single(r)
}

// view.valid (E2305, tests/ui/view_outlives_owner.jet): `return
// incidents[0..2]` from a local list; the clean program views a parameter.
fn lf_view_escape(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    view_type :: lf_generic("View", fx_int())
    owner := MIRPlaceID{value: U64{0}}
    if planted {
        owner = fx_local(&r, "incidents", lf_list(), mir_owned_ownership())
        lf_fill(&r, owner)
    } else {
        parameter :: fx_param(&r, "values", lf_list(), mir_ownership_from_access(MIRAccess.Read))
        owner = MIRPlaceID{value: fx_word(U64{500}, r.places.len())}
        &r.places.push(MIRPlace{id: owner, span: fx_span(), ty: lf_list(), base: MIRPlaceBase.Parameter{value: parameter}, projections: [MIRProjection]{}, access: MIRAccess.Read, persist_key: None})
    }
    source :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: owner})
    view :: fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    fx_block(&r, 0, MIRTerminator.Return{value: Val(view)})
    fx_program([MIRFunction]{fx_function("make", r, view_type)}, [MIRTypeDef]{})
}

// send.boundary (E1101, tests/ui/task_capture.jet): `task { count += 1 }`
// borrows `count` for writing into a task nothing joins before the owner
// continues; the clean program copies `count` into the task.
fn lf_task_capture(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    count :: fx_local(&r, "count", fx_int(), mir_copy_ownership())
    zero :: fx_int_const(&r, 0)
    fx_do(&r, MIROperation.WritePlace{place: count, value: zero})
    capture := MIRCaptureOperand.Place{place: count}
    if !planted {
        read :: fx_copy(&r, fx_int(), MIROperation.ReadPlace{place: count})
        capture = MIRCaptureOperand.Value{value: fx_owned(&r, fx_int(), MIROperation.Copy{value: read, fact: MIRCopyFact.Materialize})}
    }
    closure :: lf_closure(&r, lf_send_fn(), "task_body", capture)
    _ := lf_spawn(&r, closure, None)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    access :: if planted -> MIRAccess.Write else -> MIRAccess.Read
    fx_program([MIRFunction]{lf_lambda("task_body", fx_int(), access), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// send.boundary (E1102, tests/ui/local_cell_crossing.jet and
// string_view_task_capture.jet): a task captures a value of type `ty`.
fn lf_crossing(ty: MIRType) -> MIRProgram Never! {
    r := fx_builder()
    value :: fx_param(&r, "value", ty, mir_ownership_from_access(MIRAccess.Read))
    copied :: fx_owned(&r, ty, MIROperation.Copy{value: value, fact: MIRCopyFact.Materialize})
    closure :: lf_closure(&r, lf_send_fn(), "worker_body", MIRCaptureOperand.Value{value: copied})
    _ := lf_spawn(&r, closure, None)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{lf_lambda("worker_body", ty, MIRAccess.Read), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// send.boundary (E1102, tests/ui/unsendable_send.jet): `sender.send(value)`.
// The route row carries the checked codegen borrow mask (HandleMethods.jet
// SenderSend: receiver borrowed, value consumed). `receiver_borrowed: false`
// routes the same send through a receiver-consuming row, so the borrowed
// Sender parameter is consumed without an owner (ownership.move).
fn lf_channel_send(ty: MIRType, receiver_borrowed: Bool) -> MIRProgram Never! {
    r := fx_builder()
    sender :: fx_param(&r, "sender", lf_generic("Sender", ty), mir_ownership_from_access(MIRAccess.Read))
    value :: fx_param(&r, "value", ty, mir_ownership_from_access(MIRAccess.Read))
    fx_do(&r, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: fx_prelude_id("core.channels", "sender.send"), receiver: sender, args: [MIRValueID]{value}, frame_schedule: None, frame_schedule_derivation: None}})
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    program := lf_single(r)
    route := fx_prelude(MIRPreludeFamily.HandleMethod, "core.channels", "sender.send", "jet_channel_send", 2, MIRPreludeABI.Effect)
    route.signature.borrow_mask = [Bool]{receiver_borrowed, false}
    &program.prelude_calls.push(route)
    program
}

// ownership.move (E0121, tests/ui/ownership_call_consume_provenance.jet):
// `consume(^value)` then `print(value)`.
fn lf_consume_reuse(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    value :: fx_local(&r, "value", fx_string(), mir_owned_ownership())
    text :: fx_owned(&r, fx_string(), MIROperation.Constant{value: MIRConstant.String{value: "owned"}})
    fx_do(&r, MIROperation.WritePlace{place: value, value: text})
    lf_consume(&r, value, fx_string())
    if planted {
        reused :: fx_owned(&r, fx_string(), MIROperation.ReadPlace{place: value})
        fx_print(&r, reused)
    }
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{lf_consumer(fx_string()), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// A stale view on only one predecessor must survive the join. The Phi form
// also checks every borrowed SSA association; long Move chains have no cap.
fn lf_view_join(planted: Bool, phi: Bool, moves: Int) -> MIRProgram Never! {
    r := fx_builder()
    choice :: fx_param(&r, "choice", fx_bool(), mir_copy_ownership())
    view_type :: lf_generic("View", fx_int())
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    window :: fx_local(&r, "window", view_type, mir_owned_ownership())
    lf_fill(&r, values)
    source :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: values})
    view := fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    loop _ in 0..<moves -> view = fx_owned(&r, view_type, MIROperation.Move{value: view})
    if !phi -> fx_do(&r, MIROperation.WritePlace{place: window, value: view})
    fx_block(&r, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    if planted -> lf_push(&r, values)
    fx_block(&r, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    if phi {
        selected :: fx_owned(&r, view_type, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 1}, value: view}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: view}}})
        fx_do(&r, MIROperation.WritePlace{place: window, value: selected})
    }
    lf_len(&r, window, view_type)
    if !planted -> lf_push(&r, values)
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    lf_single(r)
}

// Each edge selects the still-valid window, even though both owners are
// changed on some path. Phi must not conflate the unselected generation.
fn lf_phi_selected_owner() -> MIRProgram Never! {
    r := fx_builder()
    choice :: fx_param(&r, "choice", fx_bool(), mir_copy_ownership())
    view_type :: lf_generic("View", fx_int())
    left :: fx_local(&r, "left", lf_list(), mir_owned_ownership())
    right :: fx_local(&r, "right", lf_list(), mir_owned_ownership())
    window :: fx_local(&r, "window", view_type, mir_owned_ownership())
    lf_fill(&r, left)
    lf_fill(&r, right)
    a :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: left})
    av :: fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: a, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    b :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: right})
    bv :: fx_owned(&r, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: b, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    fx_block(&r, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    lf_push(&r, left)
    fx_block(&r, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    lf_push(&r, right)
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    selected :: fx_owned(&r, view_type, MIROperation.Phi{incoming: [MIRPhiIncoming]{MIRPhiIncoming{block: MIRBlockID{value: 1}, value: bv}, MIRPhiIncoming{block: MIRBlockID{value: 2}, value: av}}})
    fx_do(&r, MIROperation.WritePlace{place: window, value: selected})
    lf_len(&r, window, view_type)
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    lf_single(r)
}

// A call's view contract admits both parameter owners. Mutation of the
// SECOND owner invalidates the result; the first-operand-only WIP missed it.
fn lf_multiple_owners(planted: Bool) -> MIRProgram Never! {
    view_type :: lf_generic("View", fx_int())
    c := fx_builder()
    parameter :: fx_param(&c, "a", lf_list(), mir_ownership_from_access(MIRAccess.Read))
    _ := fx_param(&c, "b", lf_list(), mir_ownership_from_access(MIRAccess.Read))
    owner :: MIRPlaceID{value: fx_word(U64{500}, c.places.len())}
    &c.places.push(MIRPlace{id: owner, span: fx_span(), ty: lf_list(), base: MIRPlaceBase.Parameter{value: parameter}, projections: [MIRProjection]{}, access: MIRAccess.Read, persist_key: None})
    source :: fx_owned(&c, lf_list(), MIROperation.ReadPlace{place: owner})
    view :: fx_owned(&c, view_type, MIROperation.Semantic{operation: MIRSemanticOp.BuiltinMethod{call: fx_prelude_id("core.builtin", "list_view"), receiver: source, receiver_place: None, args: [MIRValueID]{}, aggregate_fields: None}})
    fx_block(&c, 0, MIRTerminator.Return{value: Val(view)})
    make := fx_function("make", c, view_type)
    make.return_view_provenance = Val([MIRViewProvenanceEntry]{MIRViewProvenanceEntry{slot: [String]{}, provenance: MIRViewProvenance{sources: [MIRViewSourcePath]{MIRViewSourcePath{source: MIRViewSource.Parameter{index: 0}, projections: [MIRViewProjection]{}}, MIRViewSourcePath{source: MIRViewSource.Parameter{index: 1}, projections: [MIRViewProjection]{}}}, mutable: false}}})
    r := fx_builder()
    left :: fx_local(&r, "left", lf_list(), mir_owned_ownership())
    right :: fx_local(&r, "right", lf_list(), mir_owned_ownership())
    window :: fx_local(&r, "window", view_type, mir_owned_ownership())
    lf_fill(&r, left)
    lf_fill(&r, right)
    a := fx_arg(fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: left}), MIRAccess.Read)
    a.place = Val(left)
    b := fx_arg(fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: right}), MIRAccess.Read)
    b.place = Val(right)
    result :: fx_owned(&r, view_type, MIROperation.Call{callee: MIRCallee.User{function: mir_function_id("make")}, args: [MIRCallArg]{a, b}, type_args: [MIRType]{}})
    fx_do(&r, MIROperation.WritePlace{place: window, value: result})
    if planted -> lf_push(&r, right)
    lf_len(&r, window, view_type)
    if !planted -> lf_push(&r, right)
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{make, fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

fn lf_union_crossing(planted: Bool) -> MIRProgram Never! {
    member :: if planted -> lf_generic("Cell", fx_int()) else -> fx_string()
    lf_crossing(mir_type_from_kind(MIRTypeKind.Union{members: [MIRType]{fx_int(), member}}))
}

fn lf_alias_crossing(planted: Bool, distinct: Bool) -> MIRProgram Never! {
    target :: if planted -> lf_generic("Cell", fx_int()) else -> fx_int()
    program := lf_crossing(fx_named("Envelope"))
    definition :: if distinct -> MIRTypeDefKind.Distinct{base: target, range: None} else -> MIRTypeDefKind.Alias{target: target}
    &program.types.push(fx_type_def("Envelope", definition))
    program
}

// A bypassing access in one branch must keep the writing closure stale at
// the join, including the holder that stores it.
fn lf_alias_join(planted: Bool) -> MIRProgram Never! {
    r := fx_builder()
    choice :: fx_param(&r, "choice", fx_bool(), mir_copy_ownership())
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    add :: fx_local(&r, "add", lf_fn(), mir_owned_ownership())
    lf_fill(&r, values)
    closure :: lf_closure(&r, lf_fn(), "add_body", MIRCaptureOperand.Place{place: values})
    fx_do(&r, MIROperation.WritePlace{place: add, value: closure})
    fx_block(&r, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    if planted -> lf_len(&r, values, lf_list())
    fx_block(&r, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    callee :: fx_owned(&r, lf_fn(), MIROperation.ReadPlace{place: add})
    _ := fx_copy(&r, fx_unit(), MIROperation.IndirectCall{callee: callee, args: [MIRCallArg]{}, type_args: [MIRType]{}})
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    fx_program([MIRFunction]{lf_lambda("add_body", lf_list(), MIRAccess.Write), fx_function("run", r, fx_unit())}, [MIRTypeDef]{})
}

// Only one branch spawns a borrowed child. The loan still excludes moving
// its owner at the join, and leaving a nested unrelated group cannot join it.
fn lf_loan_join(planted: Bool, nested: Bool) -> MIRProgram Never! {
    r := fx_builder()
    choice :: fx_param(&r, "choice", fx_bool(), mir_copy_ownership())
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    group :: fx_local(&r, "g", fx_named("Group"), mir_owned_ownership())
    lf_fill(&r, values)
    fx_do(&r, MIROperation.ScopeEnter{scope: lf_group_scope(), test_member: None})
    made :: fx_owned(&r, fx_named("Group"), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.tasks", "group"), args: [MIRCallArg]{}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_do(&r, MIROperation.WritePlace{place: group, value: made})
    fx_block(&r, 0, MIRTerminator.Branch{condition: choice, then_target: MIRBlockID{value: 1}, else_target: MIRBlockID{value: 2}})
    capture :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: values})
    closure :: lf_closure(&r, lf_send_fn(), "child_body", MIRCaptureOperand.Value{value: capture})
    owner :: fx_owned(&r, fx_named("Group"), MIROperation.ReadPlace{place: group})
    _ := lf_spawn(&r, closure, Val(owner))
    fx_block(&r, 1, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    fx_block(&r, 2, MIRTerminator.Jump{target: MIRBlockID{value: 3}})
    inner :: MIRScopeID{value: U64{8}}
    if nested {
        fx_do(&r, MIROperation.ScopeEnter{scope: inner, test_member: None})
        fx_do(&r, MIROperation.ScopeExit{scope: inner})
    }
    if planted -> lf_consume(&r, values, lf_list())
    fx_do(&r, MIROperation.ScopeExit{scope: lf_group_scope()})
    if !planted -> lf_consume(&r, values, lf_list())
    fx_block(&r, 3, MIRTerminator.Return{value: None})
    run := fx_function("run", r, fx_unit())
    run.scopes = [MIRScope]{MIRScope{id: lf_group_scope(), kind: MIRScopeKind.TaskGroup, span: fx_span(), name: Val("g"), deadline: None, facts: [MIRScopeFact]{}}}
    if nested -> &run.scopes.push(MIRScope{id: inner, kind: MIRScopeKind.TaskGroup, span: fx_span(), name: Val("other_group"), deadline: None, facts: [MIRScopeFact]{}})
    fx_program([MIRFunction]{lf_lambda("child_body", lf_list(), MIRAccess.Read), lf_consumer(lf_list()), run}, [MIRTypeDef]{})
}

// Joining a replacement handle must not join the earlier child whose handle
// was overwritten. A direct join of the original handle does release its loan.
fn lf_handle_join(planted: Bool, overwrite: Bool) -> MIRProgram Never! {
    r := fx_builder()
    values :: fx_local(&r, "values", lf_list(), mir_owned_ownership())
    other :: fx_local(&r, "other", lf_list(), mir_owned_ownership())
    group :: fx_local(&r, "g", fx_named("Group"), mir_owned_ownership())
    handle :: fx_local(&r, "h", fx_named("Task"), mir_owned_ownership())
    lf_fill(&r, values)
    lf_fill(&r, other)
    fx_do(&r, MIROperation.ScopeEnter{scope: lf_group_scope(), test_member: None})
    made :: fx_owned(&r, fx_named("Group"), MIROperation.Semantic{operation: MIRSemanticOp.StaticPreludeCall{call: fx_prelude_id("core.tasks", "group"), args: [MIRCallArg]{}, owner_type_args: [MIRPreludeTypeArg]{}, type_args: [MIRType]{}}})
    fx_do(&r, MIROperation.WritePlace{place: group, value: made})
    loop owner_place in (if overwrite -> [MIRPlaceID]{values, other} else -> [MIRPlaceID]{values}) {
        capture :: fx_owned(&r, lf_list(), MIROperation.ReadPlace{place: owner_place})
        closure :: lf_closure(&r, lf_send_fn(), "child_body", MIRCaptureOperand.Value{value: capture})
        owner :: fx_owned(&r, fx_named("Group"), MIROperation.ReadPlace{place: group})
        spawned :: lf_spawn(&r, closure, Val(owner))
        fx_do(&r, MIROperation.WritePlace{place: handle, value: spawned})
    }
    taken :: fx_owned(&r, fx_named("Task"), MIROperation.MovePlace{place: handle})
    fx_do(&r, MIROperation.Semantic{operation: MIRSemanticOp.HandleMethod{call: fx_prelude_id("core.tasks", "join"), receiver: taken, args: [MIRValueID]{}, frame_schedule: None, frame_schedule_derivation: None}})
    if planted || !overwrite -> lf_consume(&r, values, lf_list())
    fx_do(&r, MIROperation.ScopeExit{scope: lf_group_scope()})
    if !planted && overwrite -> lf_consume(&r, values, lf_list())
    fx_block(&r, 0, MIRTerminator.Return{value: None})
    run := fx_function("run", r, fx_unit())
    run.scopes = [MIRScope]{MIRScope{id: lf_group_scope(), kind: MIRScopeKind.TaskGroup, span: fx_span(), name: Val("g"), deadline: None, facts: [MIRScopeFact]{}}}
    program := fx_program([MIRFunction]{lf_lambda("child_body", lf_list(), MIRAccess.Read), lf_consumer(lf_list()), run}, [MIRTypeDef]{})
    &program.prelude_calls.push(fx_prelude(MIRPreludeFamily.HandleMethod, "core.tasks", "join", "jet_task_join", 1, MIRPreludeABI.Effect))
    program
}

fn run() {
    passed := 0
    failed := 0
    results :: [Bool]{
        lf_expect("hello", fx_hello(), None),
        lf_expect("arithmetic", fx_arithmetic(), None),
        lf_expect("control-flow", fx_control_flow(), None),
        lf_expect("aggregates", fx_aggregates(), None),
        lf_expect("value.typed clean", lf_value_typed(false), None),
        lf_expect("value.typed planted", lf_value_typed(true), Val(MIRLintRule.ValueTyped)),
        lf_expect("type.well-formed clean", lf_type_well_formed(false), None),
        lf_expect("type.well-formed planted", lf_type_well_formed(true), Val(MIRLintRule.TypeWellFormed)),
        lf_expect("operation.typing clean", lf_operation_typing(false), None),
        lf_expect("operation.typing planted", lf_operation_typing(true), Val(MIRLintRule.OperationTyping)),
        lf_expect("semantic.typing clean", lf_semantic_typing(false), None),
        lf_expect("semantic.typing planted", lf_semantic_typing(true), Val(MIRLintRule.SemanticTyping)),
        lf_expect("call.signature clean", lf_call_signature(false), None),
        lf_expect("call.signature planted argument", lf_call_signature(true), Val(MIRLintRule.CallSignature)),
        lf_expect("call.signature planted callee", lf_missing_callee(), Val(MIRLintRule.CallSignature)),
        lf_expect("enum.variant clean", lf_enum_variant("Circle", true), None),
        lf_expect("enum.variant planted variant", lf_enum_variant("Square", true), Val(MIRLintRule.EnumVariant)),
        lf_expect("enum.variant planted arity", lf_enum_variant("Dot", true), Val(MIRLintRule.EnumVariant)),
        lf_expect("struct.field clean", lf_struct_field(false), None),
        lf_expect("struct.field planted", lf_struct_field(true), Val(MIRLintRule.StructField)),
        lf_expect("terminator.typing clean", lf_terminator_typing(false), None),
        lf_expect("terminator.typing planted", lf_terminator_typing(true), Val(MIRLintRule.TerminatorTyping)),
        lf_expect("ownership.move clean", lf_use_after_move(false), None),
        lf_expect("ownership.move planted", lf_use_after_move(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move Copy+Value consumed once", lf_copy_value_consumed(false), None),
        lf_expect("ownership.move Copy+Value consumed twice", lf_copy_value_consumed(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move owned payload Phi place clean (last_use_moves)", lf_owned_payload_phi_place(false), None),
        lf_expect("ownership.move owned payload Phi place double drop", lf_owned_payload_phi_place(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move owned read Phi place clean (fraction)", lf_owned_read_phi_place(false), None),
        lf_expect("ownership.move owned read Phi place double drop", lf_owned_read_phi_place(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move dead cleanup edge", lf_guarded_cleanup(false), None),
        lf_expect("ownership.move live cleanup edge", lf_guarded_cleanup(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move one-branch move", lf_one_branch_move(), None),
        lf_expect("effect.row clean", lf_effect_row(true), None),
        lf_expect("effect.row planted", lf_effect_row(false), Val(MIRLintRule.EffectRow)),
        lf_expect("effect.row deny-only callee effects", lf_effect_row_deny_only(), None),
        lf_expect("operation.typing string-view read", lf_string_view(false, false), None),
        lf_expect("operation.typing planted view read", lf_string_view(true, false), Val(MIRLintRule.OperationTyping)),
        lf_expect("operation.typing string-view Option payload", lf_string_view(false, true), None),
        lf_expect("operation.typing planted view Option payload", lf_string_view(true, true), Val(MIRLintRule.OperationTyping)),
        // Hand-built mutation controls bypass sema entirely. Their named
        // diagnostics identify the language check each MIR shape backs;
        // they are not receipts from deleting checks in a compiler build.
        lf_expect("alias.exclusive call clean", lf_call_alias(false), None),
        lf_expect("alias.exclusive call planted (E0204 projected_write_window_overlap)", lf_call_alias(true), Val(MIRLintRule.AliasExclusive)),
        lf_expect("alias.exclusive closure clean", lf_closure_alias(false), None),
        lf_expect("alias.exclusive closure planted (#4621 memcorpus case 36)", lf_closure_alias(true), Val(MIRLintRule.AliasExclusive)),
        lf_expect("alias.exclusive closure loop clean", lf_closure_loop(false), None),
        lf_expect("alias.exclusive closure loop planted (#4621 memcorpus case 62)", lf_closure_loop(true), Val(MIRLintRule.AliasExclusive)),
        lf_expect("alias.exclusive task group disjoint lends (scoped_borrow_bands)", lf_group_lend(0, 2, 0), None),
        lf_expect("alias.exclusive task group overlapping lends (E1101 taskgroup_overlapping_write_borrows)", lf_group_lend(0, 0, 0), Val(MIRLintRule.AliasExclusive)),
        lf_expect("view.valid lent owner moved after join", lf_group_lend(0, -1, 2), None),
        lf_expect("view.valid lent owner moved (E1101 taskgroup_lent_owner_moved)", lf_group_lend(0, -1, 1), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid owner changed after last use", lf_view_owner_changed(false), None),
        lf_expect("view.valid owner changed (E0212 view_owner_changed)", lf_view_owner_changed(true), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid Optional payload copy outlives its holder's rewrite", lf_view_payload_copy(), None),
        lf_expect("view.valid return from parameter", lf_view_escape(false), None),
        lf_expect("view.valid return from local (E2305 view_outlives_owner)", lf_view_escape(true), Val(MIRLintRule.ViewValid)),
        lf_expect("send.boundary copied capture", lf_task_capture(false), None),
        lf_expect("send.boundary write capture (E1101 task_capture)", lf_task_capture(true), Val(MIRLintRule.SendBoundary)),
        lf_expect("send.boundary Int crossing", lf_crossing(fx_int()), None),
        lf_expect("send.boundary Cell crossing (E1102 local_cell_crossing)", lf_crossing(lf_generic("Cell", fx_int())), Val(MIRLintRule.SendBoundary)),
        lf_expect("send.boundary view crossing (E1102 string_view_task_capture)", lf_crossing(lf_generic("View", fx_string())), Val(MIRLintRule.SendBoundary)),
        lf_expect("send.boundary channel send clean", lf_channel_send(fx_int(), true), None),
        lf_expect("send.boundary channel send planted (E1102 unsendable_send)", lf_channel_send(lf_fn(), true), Val(MIRLintRule.SendBoundary)),
        lf_expect("ownership.move channel send consumes a borrowed Sender", lf_channel_send(fx_int(), false), Val(MIRLintRule.OwnershipMove)),
        lf_expect("ownership.move consume clean", lf_consume_reuse(false), None),
        lf_expect("ownership.move consume planted (E0121 ownership_call_consume_provenance)", lf_consume_reuse(true), Val(MIRLintRule.OwnershipMove)),
        lf_expect("view.valid branch join clean", lf_view_join(false, false, 0), None),
        lf_expect("view.valid branch join planted", lf_view_join(true, false, 0), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid Phi join clean", lf_view_join(false, true, 0), None),
        lf_expect("view.valid Phi join planted", lf_view_join(true, true, 0), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid twelve Move chain clean", lf_view_join(false, false, 12), None),
        lf_expect("view.valid twelve Move chain planted", lf_view_join(true, false, 12), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid Phi selected owner clean", lf_phi_selected_owner(), None),
        lf_expect("view.valid multiple owners clean", lf_multiple_owners(false), None),
        lf_expect("view.valid multiple owners planted", lf_multiple_owners(true), Val(MIRLintRule.ViewValid)),
        lf_expect("send.boundary Union clean", lf_union_crossing(false), None),
        lf_expect("send.boundary Union planted", lf_union_crossing(true), Val(MIRLintRule.SendBoundary)),
        lf_expect("send.boundary Alias clean", lf_alias_crossing(false, false), None),
        lf_expect("send.boundary Alias planted", lf_alias_crossing(true, false), Val(MIRLintRule.SendBoundary)),
        lf_expect("send.boundary Distinct clean", lf_alias_crossing(false, true), None),
        lf_expect("send.boundary Distinct planted", lf_alias_crossing(true, true), Val(MIRLintRule.SendBoundary)),
        lf_expect("alias.exclusive branch join clean", lf_alias_join(false), None),
        lf_expect("alias.exclusive branch join planted", lf_alias_join(true), Val(MIRLintRule.AliasExclusive)),
        lf_expect("view.valid loan branch join clean", lf_loan_join(false, false), None),
        lf_expect("view.valid loan branch join planted", lf_loan_join(true, false), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid nested group loan clean", lf_loan_join(false, true), None),
        lf_expect("view.valid nested group loan planted", lf_loan_join(true, true), Val(MIRLintRule.ViewValid)),
        lf_expect("view.valid direct task join clean", lf_handle_join(false, false), None),
        lf_expect("view.valid overwritten handle after scope clean", lf_handle_join(false, true), None),
        lf_expect("view.valid overwritten handle before scope planted", lf_handle_join(true, true), Val(MIRLintRule.ViewValid)),
    }
    loop ok in results {
        if {
            ok -> passed += 1
            else -> failed += 1
        }
    }
    print("{passed} passed, {failed} failed")
    print(if failed == 0 -> "all lint fixtures passed" else -> "LINT FIXTURE FAILURES")
}
