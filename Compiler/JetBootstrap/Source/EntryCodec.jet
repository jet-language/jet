// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:261
// GATE #4494: retained in-place borrowed machine capability, not a copied value.
struct BootstrapEntryMachineWriteBorrow { value: &MirRuntimeValue, checked_type: MirType, shape: BootstrapEntryHostTypeShape, shape_node: USize }
impl BootstrapEntryMachineWriteBorrow {
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:269
    fn new(value: &MirRuntimeValue, checked_type: MirType, shape: BootstrapEntryHostTypeShape) -> Self Err! {
        bootstrap_entry_validate_shape(shape)?
        shape_type := bootstrap_entry_shape_node_type(shape, shape.root, 0)?
        if !bootstrap_entry_shape_type_matches(shape_type, checked_type) { fail "borrowed Source machine shape differs from its checked MIR type" }
        bootstrap_entry_validate_shaped_runtime(value, checked_type, shape, shape.root, 0)?
        Self { value, checked_type, shape, shape_node: shape.root }
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:288
    fn value(self) -> MirRuntimeValue { self.value }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:292
    fn value_mut(self: &Self) -> &MirRuntimeValue { self.value }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:296
    fn checked_type(self) -> MirType { self.checked_type }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:300
    fn shape(self) -> BootstrapEntryHostTypeShape { self.shape }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:304
    fn shape_node(self) -> USize { self.shape_node }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:308
    fn field_shape_node(self, name: String) -> USize Err! {
        fields := self.shape.nodes.get(self.shape_node) == { Val(Tuple(fields)) | Val(Struct { fields, .. }) -> fields; _ -> { fail "borrowed Source machine is not a checked record" } }
        fields.iter().find(fn(field) { field.name == name }).map(fn(field) { field.node }) == { Val(node) -> node; None -> { fail "checked Source machine has no field `{name}`" } }
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:320
    fn field_type_path(self, path: [String]) -> MirType Err! {
        mut node := self.shape_node
        for name in path {
            fields := self.shape.nodes.get(node) == { Val(Tuple(fields)) | Val(Struct { fields, .. }) -> fields; _ -> { fail "borrowed Source field path crosses a non-record" } }
            node = fields.iter().find(fn(field) { field.name == name }).map(fn(field) { field.node }) == { Val(node) -> node; None -> { fail "checked Source machine has no field `{name}`" } }
        }
        bootstrap_entry_shape_node_type(self.shape, node, 0)?
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:337
    fn field_mut(self: &Self, name: String) -> &MirRuntimeValue Err! {
        (_, value) := bootstrap_entry_project_runtime_field_mut(self.shape, self.value, self.shape_node, name)?
        value
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:343
    fn projection_mut_fields(self: &Self, path: [String]) -> (USize, &MirRuntimeValue) Err! {
        shape := self.shape
        mut shape_node := self.shape_node
        mut value := self.value
        for name in path { (next_node, next_value) := bootstrap_entry_project_runtime_field_mut(shape, value, shape_node, name)?; shape_node = next_node; value = next_value }
        (shape_node, value)
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:359
    fn projection_mut(self: &Self, path: [BootstrapEntryHostProjection]) -> (USize, &MirRuntimeValue) Err! { bootstrap_entry_project_runtime_mut(self.shape, self.value, self.shape_node, path)? }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:372
fn bootstrap_entry_project_runtime_field_mut(shape: BootstrapEntryHostTypeShape, value: &MirRuntimeValue, shape_node: USize, name: String) -> (USize, &MirRuntimeValue) Err! {
    fields := shape.nodes.get(shape_node) == { Val(Tuple(fields)) | Val(Struct { fields, .. }) -> fields; _ -> { fail "borrowed Source projection is not a checked record" } }
    index := fields.iter().position(fn(field) { field.name == name }) == { Val(index) -> index; None -> { fail "checked Source record has no field `{name}`" } }
    expected_type_name := shape.nodes[shape_node] == { Tuple(_) -> "Tuple"; Struct { type_name, .. } -> type_name; _ -> panic("unreachable") }
    value == {
        Struct { type_name, fields: values } -> {
            if type_name != expected_type_name || values.len() != fields.len() { fail "borrowed Source record shape differs" }
            for (expected, (actual_name, _)) in fields.iter().zip(values.iter()) { if expected.name != actual_name { fail "borrowed Source record field name/order differs" } }
            (fields[index].node, &values[index].1)
        }
        _ -> { fail "borrowed Source value is not a runtime record" }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:409
fn bootstrap_entry_project_runtime_mut(shape: BootstrapEntryHostTypeShape, value: &MirRuntimeValue, shape_node: USize, path: [BootstrapEntryHostProjection]) -> (USize, &MirRuntimeValue) Err! {
    mut current_value := value
    mut current_node := shape_node
    for projection in path {
        node := shape.nodes.get(current_node) == { Val(node) -> node; None -> { fail "borrowed Source projection has an invalid shape node" } }
        (next_node, next_value) := (node, projection, current_value) == {
            (Option(child), Present, Present(value)) | (Result { ok: child, .. }, Present, Present(value)) -> (child, &value)
            (Result { error: child, .. }, Failed, FailedTold(value)) -> (child, &value)
            (List(child), List(index), List(values)) -> (child, values.get_mut(index) == { Val(value) -> value; None -> { fail "borrowed Source list projection index is out of range" } })
            (Map { value: child, .. }, MapValue(index), Map(values)) -> (child, &(values.get_mut(index) == { Val(value) -> value; None -> { fail "borrowed Source map projection index is out of range" } }).1)
            (Map { .. }, MapKey(_), Map(_)) -> { fail "MIR map keys are immutable constants, not borrowed runtime values" }
            (record_node, StructField(name), Struct { type_name, fields: values }) -> {
                shape_fields := record_node == { Tuple(fields) -> fields; Struct { type_name: expected, fields, .. } -> if expected == type_name { fields } else { fail "borrowed Source record type name differs" }; _ -> { fail "borrowed Source projection does not match its checked value shape" } }
                if values.len() != shape_fields.len() { fail "borrowed Source record field count differs" }
                for (expected, (actual, _)) in shape_fields.iter().zip(values.iter()) { if expected.name != actual { fail "borrowed Source record field name/order differs" } }
                index := shape_fields.iter().position(fn(field) { field.name == name }) == { Val(index) -> index; None -> { fail "borrowed Source record has no field `{name}`" } }
                (shape_fields[index].node, &values[index].1)
            }
            (Enum { type_name: expected_type, variants, .. }, EnumArg(index), Enum { type_name, variant, args }) -> {
                if type_name != expected_type { fail "borrowed Source enum type name differs" }
                expected := variants.iter().find(fn(row) { row.name == variant }) == { Val(row) -> row; None -> { fail "borrowed Source enum variant `{type_name}::{variant}` is absent" } }
                (expected_name, child) := expected.args.get(index) == { Val(arg) -> arg; None -> { fail "borrowed Source enum argument is out of range" } }
                if args.len() != expected.args.len() || args[index].0 != expected_name { fail "borrowed Source enum payload name/order differs" }
                (child, &args[index].1)
            }
            (Closure { function, captures, .. }, Capture(index), Closure(closure)) -> {
                if closure.function != function || closure.captures.len() != captures.len() { fail "borrowed Source closure capture layout differs" }
                child := captures.get(index) == { Val(child) -> child; None -> { fail "borrowed Source closure capture is out of range" } }
                capture := closure.captures.get_mut(index) == { Val(capture) -> capture; None -> { fail "borrowed Source closure capture is out of range" } }
                (child, capture)
            }
            _ -> { fail "borrowed Source projection does not match its checked value shape" }
        }
        current_node = next_node
        current_value = next_value
    }
    (current_node, current_value)
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:553
pub fn bootstrap_entry_shape_node_type(shape: BootstrapEntryHostTypeShape, node: USize, depth: USize) -> MirType Err! {
    if depth >= MAX_VALUE_DEPTH { fail "compiler-entry host type shape exceeds checked nesting bound" }
    node_value := shape.nodes.get(node) == { Val(node) -> node; None -> { fail "compiler-entry host type shape has an invalid node reference" } }
    child := fn(node: USize) -> MirType Err! { bootstrap_entry_shape_node_type(shape, node, depth + 1)? }
    node_value == {
        Scalar(ty) | Handle { ty, .. } | Closure { ty, .. } -> ty.clone()
        Option(inner) -> MirType.from_kind(MirTypeKind.Option(child(inner)?))
        Result { ok, error } -> MirType.from_kind(MirTypeKind.Result { ok: child(ok)?, err: child(error)? })
        List(inner) -> MirType.from_kind(MirTypeKind.List(child(inner)?))
        Map { key, value } -> MirType.from_kind(MirTypeKind.Map { key: child(key)?, value: child(value)? })
        Tuple(fields) -> {
            mut output: [(String, MirType)] := [].with_capacity(fields.len())
            for field in fields { output.push((field.name.to_string(), child(field.node)?)) }
            MirType.from_kind(MirTypeKind.Tuple(^output))
        }
        Struct { type_id, type_name, args, .. } | Enum { type_id, type_name, args, .. } -> {
            mut output: [MirType] := [].with_capacity(args.len())
            for node in args { output.push(child(node)?) }
            MirType.from_kind(MirTypeKind.Apply { name: MirNominalRef { id: type_id, name: type_name.to_string() }, args: ^output }).with_identity(type_id)
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:622
pub fn bootstrap_entry_shape_type_matches(shape_type: MirType, checked: MirType) -> Bool {
    (shape_type.kind(), checked.kind()) == { (List(shape_inner), FixedList { elem, .. }) -> shape_inner.same_checked_type(elem); _ -> shape_type.same_checked_type(checked) }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:631
fn bootstrap_entry_validate_shape_references(shape: BootstrapEntryHostTypeShape, node: USize, depth: USize, visited: &Set<USize>) -> Unit Err! {
    if depth >= MAX_VALUE_DEPTH { fail "compiler-entry host type shape exceeds checked nesting bound" }
    if node >= shape.nodes.len() { fail "compiler-entry host type shape has an invalid node reference" }
    if !visited.insert(node) { return }
    mut children: [USize] := []
    shape.nodes[node] == {
        Scalar(_) | Handle { .. } -> {}
        Option(inner) | List(inner) -> children.push(inner)
        Result { ok, error } -> children.extend([ok, error])
        Map { key, value } -> children.extend([key, value])
        Tuple(fields) -> children.extend(fields.iter().map(fn(field) { field.node }))
        Struct { args, fields, .. } -> { children.extend(args.iter()); children.extend(fields.iter().map(fn(field) { field.node })) }
        Enum { args, variants, .. } -> { children.extend(args.iter()); children.extend(variants.iter().flat_map(fn(variant) { variant.args.iter().map(fn(arg) { arg.1 }) })) }
        Closure { captures, .. } -> children.extend(captures.iter())
    }
    for child in children { bootstrap_entry_validate_shape_references(shape, child, depth + 1, visited)? }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:681
pub fn bootstrap_entry_validate_shape(shape: BootstrapEntryHostTypeShape) -> Unit Err! {
    if shape.nodes.is_empty() || shape.root >= shape.nodes.len() { fail "compiler-entry host type shape has no valid root node" }
    mut visited: Set<USize> := Set.new()
    for node in 0..<shape.nodes.len() { bootstrap_entry_validate_shape_references(shape, node, 0, &visited)? }
    _ :: bootstrap_entry_shape_node_type(shape, shape.root, 0)?
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:695
fn bootstrap_entry_validate_shaped_runtime(value: MirRuntimeValue, checked: MirType, shape: BootstrapEntryHostTypeShape, shape_node: USize, depth: USize) -> Unit Err! {
    if depth >= MAX_VALUE_DEPTH { fail "compiler-entry runtime value exceeds checked nesting bound" }
    shape_type := bootstrap_entry_shape_node_type(shape, shape_node, depth)?
    if !bootstrap_entry_shape_type_matches(shape_type, checked) { fail "compiler-entry guest type shape differs from checked MIR type" }
    child_type := fn(node: USize) -> MirType Err! { bootstrap_entry_shape_node_type(shape, node, depth + 1)? }
    shape.nodes[shape_node] == {
        Option(inner) -> value == {
            Absent { element } -> { if !element.same_checked_type(child_type(inner)?) { fail "absent host value changed its exact checked element type" } }
            Present(value) -> bootstrap_entry_validate_shaped_runtime(value, child_type(inner)?, shape, inner, depth + 1)?
            _ -> { fail "checked Option host value has an invalid runtime carrier" }
        }
        Result { ok, error } -> value == {
            Present(value) -> bootstrap_entry_validate_shaped_runtime(value, child_type(ok)?, shape, ok, depth + 1)?
            FailedTold(value) -> bootstrap_entry_validate_shaped_runtime(value, child_type(error)?, shape, error, depth + 1)?
            _ -> { fail "checked Result host value has an invalid runtime carrier" }
        }
        List(inner) -> {
            values := value == { List(values) -> values; _ -> { fail "checked sequence host value has an invalid runtime carrier" } }
            if checked.kind() == FixedList { len, .. } { if len == Literal { value: len_value, .. } { if values.len() as U64 != len_value { fail "checked fixed-list host value has the wrong length" } } }
            ty := child_type(inner)?
            for value in values { bootstrap_entry_validate_shaped_runtime(value, ty, shape, inner, depth + 1)? }
        }
        Map { value: child, .. } -> {
            entries := value == { Map(entries) -> entries; _ -> { fail "checked map host value has an invalid runtime carrier" } }
            ty := child_type(child)?
            for (_, value) in entries { bootstrap_entry_validate_shaped_runtime(value, ty, shape, child, depth + 1)? }
        }
        Tuple(fields) -> {
            (type_name, values) := value == { Struct { type_name, fields: values } -> (type_name, values); _ -> { fail "checked tuple host value has an invalid runtime carrier" } }
            if type_name != "Tuple" || values.len() != fields.len() { fail "checked tuple host value shape differs" }
            for (index, (field, (name, value))) in fields.iter().zip(values.iter()).enumerate() {
                if field.name != name { fail "checked tuple host field {index} differs" }
                bootstrap_entry_validate_shaped_runtime(value, child_type(field.node)?, shape, field.node, depth + 1)?
            }
        }
        Struct { type_name, fields, .. } -> {
            (actual_name, values) := value == { Struct { type_name: actual_name, fields: values } -> (actual_name, values); _ -> { fail "checked record host value has an invalid runtime carrier" } }
            if actual_name != type_name || values.len() != fields.len() { fail "checked record host value shape differs" }
            for (index, (field, (name, value))) in fields.iter().zip(values.iter()).enumerate() {
                if field.name != name { fail "checked record host field {index} differs" }
                bootstrap_entry_validate_shaped_runtime(value, child_type(field.node)?, shape, field.node, depth + 1)?
            }
        }
        Enum { type_name, variants, .. } -> {
            (actual_name, variant, args) := value == { Enum { type_name: actual_name, variant, args } -> (actual_name, variant, args); _ -> { fail "checked enum host value has an invalid runtime carrier" } }
            expected := variants.iter().find(fn(candidate) { candidate.name == variant }) == { Val(expected) -> expected; None -> { fail "checked enum variant `{type_name}::{variant}` is absent" } }
            if actual_name != type_name || args.len() != expected.args.len() { fail "checked enum host value shape differs" }
            for (index, ((expected_name, child), (actual_name, value))) in expected.args.iter().zip(args.iter()).enumerate() {
                if expected_name != actual_name { fail "checked enum host payload {index} differs" }
                bootstrap_entry_validate_shaped_runtime(value, child_type(child)?, shape, child, depth + 1)?
            }
        }
        Scalar(_) | Closure { .. } | Handle { .. } -> {}
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:873
struct BootstrapEntryValue { ty: MirType, value: MirRuntimeValue }
impl BootstrapEntryValue {
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:879
    fn into_value(self: ^Self) -> MirRuntimeValue { ^self.value }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:883
    fn value(self) -> MirRuntimeValue { self.value }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:887
    fn field(self, program: MirProgram, field: MirFieldId) -> MirRuntimeValue? { checked_record_field(program, self.ty, self.value, field).ok().flatten() }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:899
struct BootstrapEntryCodec { program: MirProgram, entry: MirFunctionId, request_type: MirType, result_type: MirType }
impl BootstrapEntryCodec {
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:907
    fn new(program: MirProgram, bindings: BootstrapBindingDescriptor, entry: MirFunctionId) -> Self BootstrapHostCodecError! {
        symbols := BootstrapCodecSymbols.new(bindings, program)?
        callable := bindings.callables.iter().find(fn(row) { row.source_name == "jet_bootstrap_compile" && row.metadata.function == entry }) == { Val(callable) -> callable; None -> { fail BootstrapHostCodecError.MissingEntry("jet_bootstrap_compile") } }
        function := program.functions.iter().find(fn(function) { function.id == entry }) == { Val(function) -> function; None -> { fail BootstrapHostCodecError.InvalidMetadata("jet_bootstrap_compile binding is absent from checked compiler MIR") } }
        if function.kind != MirFunctionKind.Jet || function.name != callable.source_name || function.params.len() != 1 || callable.metadata.parameter_types.len() != 1 || callable.metadata.parameter_access != [function.params[0].access] { fail BootstrapHostCodecError.InvalidMetadata("jet_bootstrap_compile must retain its exact one-parameter checked ABI") }
        request_type := function.params[0].ty.clone()
        result_type := function.return_type.clone()
        request := checked_nominal_definition(program, request_type)?
        result := checked_nominal_definition(program, result_type)?
        if request.name != "JetDriverCompileRequest" || result.name != "JetDriverCompileResult" { fail BootstrapHostCodecError.InvalidMetadata("jet_bootstrap_compile ABI is not JetDriverCompileRequest -> JetDriverCompileResult") }
        try {
            rust_type := entry_rust_type(program, symbols, result_type)?
            if rust_type != callable.metadata.return_type { symbols.record(BootstrapHostCodecError.InvalidMetadata("jet_bootstrap_compile return binding disagrees with its checked MIR return type")) }
        } catch(error) { symbols.record(^error) }
        validate_binding_graph(program, symbols, request_type)
        validate_binding_graph(program, symbols, result_type)
        symbols.finish(Ok(()))?
        Self { program, entry, request_type: ^request_type, result_type: ^result_type }
    }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:968
    fn entry(self) -> MirFunctionId { self.entry }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:972
    fn request_type(self) -> MirType { self.request_type }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:976
    fn result_type(self) -> MirType { self.result_type }
    // Rust: Compiler/Bootstrap/Host/EntryCodec.rs:982
