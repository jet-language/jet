// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1140
fn checked_native_adapter_methods(program: MirProgram, symbols: BootstrapCodecSymbols) -> [MirTraitMethod] BootstrapHostCodecError! {
    rust_methods := symbols.trait_methods("JetEvalHostAdapter")?
    trait_id := rust_methods[0].trait_id
    checked_trait := program.traits.iter().find(fn(row) { row.id == trait_id && row.name == "JetEvalHostAdapter" }) == { Val(row) -> row; None -> { fail BootstrapHostCodecError.MissingEntry("checked JetEvalHostAdapter trait") } }
    if checked_trait.methods.len() != rust_methods.len() { fail BootstrapHostCodecError.InvalidMetadata("JetEvalHostAdapter Rust metadata and checked MIR list different methods") }
    mut methods: [MirTraitMethod] := [].with_capacity(checked_trait.methods.len())
    for method in checked_trait.methods {
        name := method.name
        metadata := rust_methods.iter().find(fn(row) { row.method_id == method.id && row.name == name }) == { Val(row) -> row; None -> { fail BootstrapHostCodecError.MissingEntry("Rust metadata for checked JetEvalHostAdapter.{name}") } }
        arity := method.params.len()
        if metadata.parameter_types.len() != arity || metadata.parameter_access.len() != arity || metadata.return_type.is_empty() || method.self_access != metadata.receiver_access || method.params.iter().zip(metadata.parameter_access.iter()).any(fn(entry) { entry.0.access != entry.1 }) { fail BootstrapHostCodecError.InvalidMetadata("JetEvalHostAdapter.{name} Rust metadata differs from its checked MIR parameters") }
        if method.params.first() == Val(machine) {
            definition := checked_nominal_definition(program, machine.ty)?
            if machine.access != MirAccess.Write || definition.name != "JetEvalMachine" { fail BootstrapHostCodecError.InvalidMetadata("JetEvalHostAdapter.{name} does not use the checked JetEvalMachine WRITE parameter") }
        }
        methods.push(method.clone())
    }
    ^methods
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1194
fn entry_rust_type(program: MirProgram, symbols: BootstrapCodecSymbols, ty: MirType) -> String BootstrapHostCodecError! {
    ty.kind() == {
        Int -> "jet_foundation::Numeric::JetInt"
        IntN { signed, bits } -> "{if signed { 'i' } else { 'u' }}{bits}"
        Float -> "f64"
        Float32 -> "f32"
        Measure(_) -> "f64"
        Bool -> "bool"
        Char -> "char"
        String -> "String"
        List(inner) -> "Vec<{entry_rust_type(program, symbols, inner)?}>"
        Map { key, value } -> "crate::JetMap<{entry_rust_type(program, symbols, key)?}, {entry_rust_type(program, symbols, value)?}>"
        Shared(inner) -> "crate::jet_std::JetShared<{entry_rust_type(program, symbols, inner)?}>"
        Option(inner) -> "crate::JetOutcome<{entry_rust_type(program, symbols, inner)?}, crate::JetAbsent>"
        Result { ok, err } -> "crate::JetOutcome<{entry_rust_type(program, symbols, ok)?}, {entry_rust_type(program, symbols, err)?}>"
        Apply { name, args } -> {
            if args.is_empty() && name.name == Syntax.INTERNAL_UNIT_TYPE { "()" }
            else if args.is_empty() && name.name == Syntax.TYPE_NEVER { "std::convert::Infallible" }
            else if name.name == Syntax.TYPE_PTR {
                if args.len() != 1 { fail BootstrapHostCodecError.InvalidMetadata("checked Ptr type does not have one element argument") }
                "*mut {entry_rust_type(program, symbols, args[0])?}"
            } else {
                definition := checked_definition_by_ref(program, name)?
                if args.len() != definition.generic_params.len() { fail BootstrapHostCodecError.InvalidMetadata("checked type `{definition.name}` has an unexpected generic argument count") }
                symbol := symbols.type_symbol(definition.name)?
                if args.is_empty() { symbol.to_string() } else {
                    mut names: [String] := [].with_capacity(args.len())
                    for arg in args { names.push(entry_rust_type(program, symbols, arg)?) }
                    "{symbol}<{names.join(", ")}>"
                }
            }
        }
        TraitObject(bounds) -> {
            mut traits: [String] := [].with_capacity(bounds.len())
            for bound in bounds { traits.push(symbols.trait_symbol(bound.name)?.to_string()) }
            if traits.is_empty() { fail BootstrapHostCodecError.InvalidMetadata("checked trait-object type has no trait bounds") }
            "Box<dyn {traits.join(" + ")}>"
        }
        Tuple(fields) -> {
            mut names: [String] := [].with_capacity(fields.len())
            for (_, field) in fields { names.push(entry_rust_type(program, symbols, field)?) }
            if names.len() == 0 { "()" } else if names.len() == 1 { "({names[0]},)" } else { "({names.join(", ")})" }
        }
        FixedList { elem, len } -> "[{entry_rust_type(program, symbols, elem)?}; {len.expression()}]"
        InlineRange { base, .. } | Tagged { inner: base, .. } | Quantity { base, .. } -> entry_rust_type(program, symbols, base)?
        Union(_) -> {
            id := ty.identity == { Val(id) -> id; None -> { fail BootstrapHostCodecError.InvalidMetadata("checked entry union has no nominal identity") } }
            definition := checked_definition_by_id(program, id).map_err(fn(_) { BootstrapHostCodecError.MissingType("`{ty.canonical_key()}` (MIR type ID {id.0})") })?
            symbols.type_symbol(definition.name)?.to_string()
        }
        Fn(_) | SendFn { .. } -> { fail BootstrapHostCodecError.InvalidMetadata("JetEvalHostAdapter parameter/result unexpectedly uses callable type `{ty.canonical_key()}`") }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1317
fn emit_entry_native_interface_codecs(out: &String, program: MirProgram, symbols: BootstrapCodecSymbols, methods: [MirTraitMethod]) -> Unit BootstrapHostCodecError! {
    out += ENTRY_NATIVE_INTERFACE_ARGUMENT
    for method in methods {
        machine_parameter := !method.params.is_empty()
        mut argument_types: [String] := [].with_capacity(method.params.len())
        for (index, parameter) in method.params.iter().enumerate() {
            if machine_parameter && index == 0 { continue }
            if parameter.access == MirAccess.Write { fail BootstrapHostCodecError.InvalidMetadata("JetEvalHostAdapter.{method.name} argument {index} is a WRITE borrow; only the machine may be written back") }
            source_type := entry_rust_type(program, symbols, parameter.ty)?
            argument_types.push(source_type.clone())
            checked_key := "{parameter.ty.canonical_key():?}"
            path_error := "checked JetEvalHostAdapter.{method.name} argument {index} has the wrong MIR type"
            expression := from_runtime_expression(program, symbols, parameter.ty, "value", "checked", "program", "path")?
            name := method.name
            out += "\n" + """
#[doc(hidden)]
pub(crate) fn __jet_bootstrap_entry_native_interface_{name}_arg_{index}_from_runtime<P: crate::BootstrapEntryPhysicalBindings>(
    value: ::jet_foundation::MIR::MirRuntimeValue,
    checked: &::jet_foundation::MIR::MirType,
    compiler_program: &::std::sync::Arc<::jet_foundation::MIR::MirProgram>,
    path: &[String],
    physical: &P,
) -> Result<{source_type}, String> {{
    let program = compiler_program.as_ref();
    if checked.canonical_key() != {checked_key} {{
        return Err({path_error:?}.to_string());
    }}
    crate::compiler_bootstrap_entry_codec::validate_runtime_value(program, checked, &value, 0)?;
    Ok({expression})
}}
""" + "\n\n"
        }
        if method.return_type.kind() == { TraitObject(_) -> true; _ -> false } { continue }
        source_type := entry_rust_type(program, symbols, method.return_type)?
        checked_key := "{method.return_type.canonical_key():?}"
        path_error := "checked JetEvalHostAdapter.{method.name} result has the wrong MIR type"
        expression := to_runtime_expression(program, symbols, method.return_type, "source_value", "checked", "compiler_program", "path", "physical")?
        name := method.name
        out += "\n" + """
#[doc(hidden)]
pub(crate) fn __jet_bootstrap_entry_native_interface_{name}_result_to_runtime<P: crate::BootstrapEntryPhysicalBindings>(
    source_value: &{source_type},
    checked: &::jet_foundation::MIR::MirType,
    compiler_program: &::std::sync::Arc<::jet_foundation::MIR::MirProgram>,
    path: &[String],
    physical: &P,
) -> Result<::jet_foundation::MIR::MirRuntimeValue, String> {{
    let program = compiler_program.as_ref();
    if checked.canonical_key() != {checked_key} {{
        return Err({path_error:?}.to_string());
    }}
    let value = {expression};
    crate::compiler_bootstrap_entry_codec::validate_runtime_value(program, checked, &value, 0)?;
    Ok(value)
}}
""" + "\n\n"
        emit_entry_native_interface_shim(out, program, symbols, method, argument_types, source_type)?
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1428
// GATE #4494: generated native transfer-ledger ownership and physical ABI.
ENTRY_NATIVE_INTERFACE_ARGUMENT :: "\n" + """
#[doc(hidden)]
pub(crate) fn __jet_bootstrap_entry_native_interface_argument<P, T>(
    call: &mut ::jet_jit::SourceInterfaces::NativeInterfaceCall,
    index: usize,
    compiler_program: &::std::sync::Arc<::jet_foundation::MIR::MirProgram>,
    physical: &P,
    decode: fn(
        ::jet_foundation::MIR::MirRuntimeValue,
        &::jet_foundation::MIR::MirType,
        &::std::sync::Arc<::jet_foundation::MIR::MirProgram>,
        &[String],
        &P,
    ) -> Result<T, String>,
) -> Result<T, String>
where
    P: crate::BootstrapEntryPhysicalBindings,
{{
    let argument = call
        .argument(index)
        .ok_or_else(|| format!("native interface argument {{index}} is missing"))?;
    let checked = argument.ty.clone();
    let path = vec![format!("argument {{index}}")];
    if argument.access != ::jet_foundation::MIR::MirAccess::Move {{
        let value = argument.value.clone();
        return decode(value, &checked, compiler_program, &path, physical);
    }}
    let transfer = call.take_owned_argument(index).map_err(|error| error.to_string())?;
    let guard = transfer.take_value().map_err(|error| error.to_string())?;
    let payload = guard.with_value(|value| value.clone()).map_err(|error| error.to_string())?;
    let decoded = decode(payload, &checked, compiler_program, &path, physical)?;
    call.consume_owned_argument(transfer, guard, |guard, commit| {{
        guard.commit_and_extract(::jet_foundation::MIR::MirRuntimeValue::Unit, commit)?;
        Ok(())
    }})
    .map_err(|error| error.to_string())?;
    Ok(decoded)
}}
""" + "\n"

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1471
fn emit_entry_native_interface_shim(out: &String, program: MirProgram, symbols: BootstrapCodecSymbols, method: MirTraitMethod, argument_types: [String], result_type: String) -> Unit BootstrapHostCodecError! {
    name := method.name
    arity := method.params.len()
    first_argument := if method.params.is_empty() { 0 } else { 1 }
    argument_names := (first_argument..<arity).map(fn(index) { "__jet_arg_{index}" }).collect()
    mut argument_lets := ""
    for (index, argument) in (first_argument..<arity).zip(argument_names.iter()) {
        argument_lets += "    let {argument} = __jet_bootstrap_entry_native_interface_argument(call, {index}, compiler_program, physical, __jet_bootstrap_entry_native_interface_{name}_arg_{index}_from_runtime::<P>)?;\n"
    }
    arguments := argument_names.join(", ")
    (operation_parameters, invoke) := method.params.first() == {
        Val(machine) -> {
            machine_type := entry_rust_type(program, symbols, machine.ty)?
            mut parameters := ["crate::compiler_bootstrap_entry_codec::BootstrapEntryMachineAccess<'_, {machine_type}>"]
            parameters.extend(argument_types.iter().cloned())
            separator := if arguments.is_empty() { "" } else { ", " }
            invoke := """
    let __jet_machine_type = call.signature().parameters[0].ty.clone();
    let __jet_result = call
        .with_writeback_argument(0, |__jet_machine_value| {{
            let __jet_machine = physical.borrow_interpreter_machine_write(
                __jet_machine_value,
                &__jet_machine_type,
                machine_abi_shape,
            )?;
            operation(crate::compiler_bootstrap_entry_codec::BootstrapEntryMachineAccess::Mir(__jet_machine){separator}{arguments})
        }})
        .map_err(|error| error.to_string())??;
""" + "\n"
            (parameters.join(", "), ^invoke)
        }
        None -> ("", "    let _ = machine_abi_shape;\n    let __jet_result = operation()?;\n")
    }
    arity_error := "native JetEvalHostAdapter.{name} call does not have {arity} checked arguments"
    out += "\n" + """
#[doc(hidden)]
pub(crate) fn __jet_bootstrap_entry_native_interface_{name}<P, F>(
    call: &mut ::jet_jit::SourceInterfaces::NativeInterfaceCall,
    compiler_program: &::std::sync::Arc<::jet_foundation::MIR::MirProgram>,
    machine_abi_shape: &crate::compiler_bootstrap_entry_codec::BootstrapEntryHostTypeShape,
    physical: &P,
    operation: F,
) -> Result<::jet_foundation::MIR::MirRuntimeValue, String>
where
    P: crate::BootstrapEntryPhysicalBindings,
    F: FnOnce({operation_parameters}) -> Result<{result_type}, String>,
{{
    if call.signature().parameters.len() != {arity} || call.arguments().len() != {arity} {{
        return Err({arity_error:?}.to_string());
    }}
    let __jet_result_type = call.signature().return_type.clone();
{argument_lets}{invoke}    let path = vec![{name:?}.to_string()];
    __jet_bootstrap_entry_native_interface_{name}_result_to_runtime(&__jet_result, &__jet_result_type, compiler_program, &path, physical)
}}
""" + "\n\n"
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1553
pub fn append_bootstrap_entry_codec(out: &String, bindings: BootstrapBindingDescriptor, symbols: BootstrapCodecSymbols, program: MirProgram, entry: MirFunctionId) -> Unit BootstrapHostCodecError! {
    function := program.functions.iter().find(fn(function) { function.id == entry }) == { Val(function) -> function; None -> { fail BootstrapHostCodecError.InvalidMetadata("entry codec cannot find the checked compiler factory function") } }
    if function.name != "jet_bootstrap_compile" || function.params.len() != 1 { fail BootstrapHostCodecError.InvalidMetadata("entry codec requires the checked one-request factory function") }
    callable := bindings.callables.iter().find(fn(row) { row.source_name == function.name && row.metadata.function == entry }) == { Val(callable) -> callable; None -> { fail BootstrapHostCodecError.MissingEntry(function.name.to_string()) } }
    if callable.metadata.parameter_types.len() != 1 || callable.metadata.parameter_access != [function.params[0].access] || callable.metadata.return_type.is_empty() { fail BootstrapHostCodecError.InvalidMetadata("entry callable binding differs from the checked one-request ABI") }
    request := checked_nominal_definition(program, function.params[0].ty)?
    result := checked_nominal_definition(program, function.return_type)?
    if request.name != "JetDriverCompileRequest" || result.name != "JetDriverCompileResult" { fail BootstrapHostCodecError.InvalidMetadata("factory signature is not the checked compile request/result contract") }
    validate_binding_graph(program, symbols, function.params[0].ty)
    validate_binding_graph(program, symbols, function.return_type)
    native_methods := checked_native_adapter_methods(program, symbols)?
    mut to_types: [MirTypeDef] := []
    mut from_types: [MirTypeDef] := []
    mut request_seen: Set<MirTypeId> := Set.new()
    mut result_seen: Set<MirTypeId> := Set.new()
    collect_nominal_types(program, function.params[0].ty, &request_seen, &to_types)?
    collect_nominal_types(program, function.return_type, &result_seen, &from_types)?
    mut to_seen: Set<MirTypeId> := to_types.iter().map(fn(definition) { definition.id }).collect()
    mut from_seen: Set<MirTypeId> := from_types.iter().map(fn(definition) { definition.id }).collect()
    for method in native_methods {
        for (index, parameter) in method.params.iter().enumerate() {
            if index == 0 && parameter.access == MirAccess.Write && checked_nominal_definition(program, parameter.ty).is_ok_and(fn(definition) { definition.name == "JetEvalMachine" }) { continue }
            validate_binding_graph(program, symbols, parameter.ty)
            mut graph: [MirTypeDef] := []
            mut seen: Set<MirTypeId> := Set.new()
            collect_nominal_types(program, parameter.ty, &seen, &graph)?
            for nested in ^graph { if from_seen.insert(nested.id) { from_types.push(^nested) } }
        }
        if !(method.return_type.kind() == { TraitObject(_) -> true; _ -> false }) {
            validate_binding_graph(program, symbols, method.return_type)
            mut graph: [MirTypeDef] := []
            mut seen: Set<MirTypeId> := Set.new()
            collect_nominal_types(program, method.return_type, &seen, &graph)?
            for nested in ^graph { if to_seen.insert(nested.id) { to_types.push(^nested) } }
        }
    }
    to_types.sort_by_key(fn(definition) { definition.id })
    from_types.sort_by_key(fn(definition) { definition.id })
    for definition in to_types { emit_to_runtime_converter(out, program, symbols, definition)? }
    for definition in from_types { emit_from_runtime_converter(out, program, symbols, definition)? }
    emit_entry_native_interface_codecs(out, program, symbols, native_methods)?
    emit_entry_machine_access_helpers(out, program, symbols)?
    emit_entry_host_type_shape_from_source(out, symbols)?
    emit_entry_conversion_helpers(out)?
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:1644
fn emit_entry_host_type_shape_from_source(out: &String, symbols: BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    _ :: symbols.type_symbol("JetEvalHostTypeShape")?
    out += "\n" + """
pub(crate) fn __jet_bootstrap_entry_host_type_shape_from_source(
    source: &@t.JetEvalHostTypeShape@,
) -> Result<crate::compiler_bootstrap_entry_codec::BootstrapEntryHostTypeShape, String> {{
    use crate::compiler_bootstrap_entry_codec::{{
        BootstrapEntryHostOwner as Owner,
        BootstrapEntryHostTypeField as Field,
        BootstrapEntryHostTypeNode as Node,
        BootstrapEntryHostTypeShape as Shape,
        BootstrapEntryHostTypeVariant as Variant,
    }};
    let field_shapes = |fields: &[@t.JetEvalHostTypeFieldShape@], label: &str| {{
        fields.iter().map(|field| {{
            Ok(Field {{
                name: field.@f.JetEvalHostTypeFieldShape.name@.clone(),
                node: __jet_bootstrap_source_index(&field.@f.JetEvalHostTypeFieldShape.node@, label)?,
            }})
        }}).collect::<Result<Vec<_>, String>>()
    }};
    let indices = |indices: &[jet_foundation::Numeric::JetInt], label: &str| {{
        indices.iter()
            .map(|index| __jet_bootstrap_source_index(index, label))
            .collect::<Result<Vec<_>, String>>()
    }};
    let root = __jet_bootstrap_source_index(&source.@f.JetEvalHostTypeShape.root@, "host result type root")?;
    let nodes = source.@f.JetEvalHostTypeShape.nodes@.iter().map(|node| {{
        Ok(match node {{
            @p.JetEvalHostTypeNode.Scalar@(ty) => Node::Scalar(__jet_bootstrap_type_to_host(ty)?),
            @p.JetEvalHostTypeNode.Option@(inner) => Node::Option(
                __jet_bootstrap_source_index(inner, "option type node")?,
            ),
            @p.JetEvalHostTypeNode.Result@(ok, error) => Node::Result {{
                ok: __jet_bootstrap_source_index(ok, "result success type node")?,
                error: __jet_bootstrap_source_index(error, "result error type node")?,
            }},
            @p.JetEvalHostTypeNode.List@(inner) => Node::List(
                __jet_bootstrap_source_index(inner, "list element type node")?,
            ),
            @p.JetEvalHostTypeNode.Map@(key, value) => Node::Map {{
                key: __jet_bootstrap_source_index(key, "map key type node")?,
                value: __jet_bootstrap_source_index(value, "map value type node")?,
            }},
            @p.JetEvalHostTypeNode.Tuple@(fields) => Node::Tuple(field_shapes(fields, "tuple field type node")?),
            @p.JetEvalHostTypeNode.Struct@(type_id, type_name, args, fields) => Node::Struct {{
                type_id: ::jet_foundation::MIR::MirTypeId(type_id.@f.MIRTypeID.value@),
                type_name: type_name.clone(),
                args: indices(args, "nominal argument type node")?,
                fields: field_shapes(fields, "record field type node")?,
            }},
            @p.JetEvalHostTypeNode.Enum@(type_id, type_name, args, variants) => Node::Enum {{
                type_id: ::jet_foundation::MIR::MirTypeId(type_id.@f.MIRTypeID.value@),
                type_name: type_name.clone(),
                args: indices(args, "nominal argument type node")?,
                variants: variants.iter().map(|variant| {{
                    Ok(Variant {{
                        name: variant.@f.JetEvalHostTypeVariantShape.name@.clone(),
                        args: variant.@f.JetEvalHostTypeVariantShape.args@.iter().map(|arg| {{
                            Ok((
                                arg.@f.JetEvalHostTypeArgShape.name@.as_ref().ok().cloned(),
                                __jet_bootstrap_source_index(&arg.@f.JetEvalHostTypeArgShape.node@, "enum payload type node")?,
                            ))
                        }}).collect::<Result<Vec<_>, String>>()?,
                    }})
                }}).collect::<Result<Vec<_>, String>>()?,
            }},
            @p.JetEvalHostTypeNode.Closure@(ty, function, captures) => Node::Closure {{
                function: ::jet_foundation::MIR::MirFunctionId(function.@f.MIRFunctionID.value@),
                captures: indices(captures, "closure capture type node")?,
                ty: __jet_bootstrap_type_to_host(ty)?,
            }},
            @p.JetEvalHostTypeNode.Handle@(ty, owner) => Node::Handle {{
                ty: __jet_bootstrap_type_to_host(ty)?,
                owner: match &@deref.JetEvalHostTypeNode.Handle.owner@*owner {{
                    @p.JetEvalHostOwner.Cursor@ => Owner::Cursor,
                    @p.JetEvalHostOwner.Declared@(ty) => Owner::Declared(__jet_bootstrap_type_to_host(ty)?),
                    @p.JetEvalHostOwner.Core@(owner) => Owner::Core {{
                        fact: __jet_bootstrap_mir_MIRCoreOwner_to_host(&owner.@f.JetEvalHostCoreOwner.fact@)?,
                        ty: __jet_bootstrap_type_to_host(&owner.@f.JetEvalHostCoreOwner.ty@)?,
                    }},
                    @p.JetEvalHostOwner.Native@(binding) => match &@deref.JetEvalHostOwner.Native.binding@*binding {{
                        @p.JetEvalNativeBindingIdentity.Callable@(binding) => Owner::NativeCallable {{
                            key: binding.@f.JetEvalNativeCallableBinding.key@.clone(),
                            callable_type: __jet_bootstrap_type_to_host(&binding.@f.JetEvalNativeCallableBinding.callable_type@)?,
                        }},
                        @p.JetEvalNativeBindingIdentity.Interface@(receiver_type) => Owner::NativeInterface {{
                            receiver_type: __jet_bootstrap_type_to_host(receiver_type)?,
                        }},
                    }},
                    @p.JetEvalHostOwner.FixedBackingRoot@(..) => {{
                        return Err("checked host type shape names a fixed-backing root, which has no host owner".to_string());
                    }}
                }},
            }},
        }})
    }}).collect::<Result<Vec<_>, String>>()?;
    let shape = Shape {{ root, nodes }};
    crate::compiler_bootstrap_entry_codec::bootstrap_entry_validate_shape(&shape)?;
    Ok(shape)
}}
""" + "\n"
}
