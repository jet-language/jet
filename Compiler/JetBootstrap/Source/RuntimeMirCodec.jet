    if source_name == {
        "MIRTypeID" -> return "__jet_bootstrap_type_id_from_host(*({expression}))?"
        "MIRMeasure" -> return "__jet_bootstrap_measure_from_host({expression})?"
        "MIRDimension" -> return "__jet_bootstrap_dimension_from_host({expression})?"
        "MIRTagMarker" -> return "__jet_bootstrap_tag_from_host({expression})?"
        "MIRABI" -> return "__jet_bootstrap_abi_from_host({expression})"
        "MIRSize" -> return "__jet_bootstrap_size_from_host({expression})?"
