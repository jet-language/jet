// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:113
// A Source record represents a native tuple, or one native map entry, in field order.
pub struct PairRecord {
    pub symbol: String
    pub fields: [(String, String)]
    // Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:122
    pub fn entry(self) -> ((String, String), (String, String)) BootstrapHostCodecError! {
        if self.fields.len() != 2 { throw BootstrapHostCodecError.InvalidMetadata("Source MIR record `{self.symbol}` stands for a native map entry but has {self.fields.len()} fields") }
        (self.fields[0], self.fields[1])
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:134
pub type PairRecords = [String: PairRecord]
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:136
pub fn pair_records(source: [Definition], symbols: BootstrapCodecSymbols) -> PairRecords BootstrapHostCodecError! {
    pairs := [:]
    loop definition in source {
        fields :: if definition.body == { .Struct(fields) -> fields else -> continue }
        if fields.len() < 2 { continue }
        resolved := []
        loop field in fields { &resolved.push((symbols.field_symbol(definition.name, field.name)!.to_string(), field.ty.clone())) }
        _ :: &pairs.insert(definition.name.clone(), PairRecord{symbol: symbols.type_symbol(definition.name)!.to_string(), fields: ^resolved})
    }
    pairs
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:170
pub fn host_tuple_types(host_type: TypeExpr, record: PairRecord) -> [TypeExpr]? BootstrapHostCodecError! {
    name :: if host_type == { .Named(name) -> name else -> return None }
    inner :: if name.strip_prefix('(').and_then(fn(rest) { rest.strip_suffix(')') }) == { .Some(inner) -> inner .None -> return None }
    parts :: split_top_level(inner, ',').into_iter().filter(fn(part) { trimmed := part.trim(); !trimmed.is_empty() }).collect()
    if parts.len() != record.fields.len() { return None }
    types := []
    loop part in parts { &types.push(parse_type(part) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }) }
    Some(^types)
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:195
pub fn append_runtime_mir_codec(out: &String, symbols: BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    source := parse_definitions(SOURCE_MIR_SCHEMA) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }
    loop (schema, names) in SOURCE_SUPPORT_SCHEMAS {
        support :: parse_definitions(schema) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }
        &source.extend(support.into_iter().filter(fn(definition) { names.contains(definition.name) }))
    }
    host :: parse_definitions(HOST_MIR_SCHEMA) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }
    validate_unique_definitions(source) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }
    validate_unique_definitions(host) catch { error -> throw BootstrapHostCodecError.InvalidMetadata(error) }
    host_by_name := host.into_iter().map(fn(definition) { (respell_acronym_name(definition.name), definition) }).collect()
    insert_external_host_definitions(&host_by_name)
    loop error in insert_support_host_definitions(source, &host_by_name) { symbols.record(error) }
    // Resolve every declaration, including those behind optional/collection fields.
    loop definition in source {
        _ :: symbols.type_symbol(definition.name)!
        if definition.body == {
            .Struct(fields) -> loop field in fields { _ :: symbols.field_symbol(definition.name, field.name)! }
            .Enum(variants) -> loop variant in variants { _ :: symbols.variant_path(definition.name, variant.name)! }
            .Tuple -> {}
        }
    }
    pairs :: pair_records(source, symbols)!
    emit_special_structural_converters(out, symbols)!
    &out.push_str("\n// Typed Source-MIR/native-MIR projection generated from Compiler/JetFoundation/Source/MIR/MIR.jet.\n\n")
    keep :: fn(result: Unit BootstrapHostCodecError!) { result catch { error -> symbols.record(error) } }
    loop definition in source {
        if id_newtype(definition) { keep(emit_id_converter(out, symbols, host_by_name, definition.name)); continue }
        if custom_source_converter(definition.name) || source_only_type(definition.name) || native_type_absent(definition.name, host_by_name) { continue }
        keep(if definition.body == {
            .Struct(fields) -> emit_struct_converter(out, symbols, host_by_name, pairs, definition, fields)
            .Enum(variants) -> emit_enum_converter(out, symbols, host_by_name, pairs, definition, variants)
            .Tuple -> emit_tuple_converter(out, symbols, definition)
        })
    }
    emit_special_host_to_source_converters(out, symbols)!
    emit_string_part_converters(out, symbols)!
    loop definition in source {
        if id_newtype(definition) { keep(emit_id_from_host_converter(out, symbols, host_by_name, definition.name)); continue }
        if custom_source_converter(definition.name) || source_only_type(definition.name) || native_type_absent(definition.name, host_by_name) { continue }
        keep(if definition.body == {
            .Struct(fields) -> emit_struct_from_host_converter(out, symbols, host_by_name, pairs, definition, fields)
            .Enum(variants) -> emit_enum_from_host_converter(out, symbols, host_by_name, pairs, definition, variants)
            .Tuple -> emit_tuple_from_host_converter(definition)
        })
    }
    program :: source.iter().find(fn(definition) { definition.name == "MIRProgram" }).ok_or_else(fn() { BootstrapHostCodecError.MissingType("MIRProgram") })!
    program_source :: symbols.type_symbol("MIRProgram")!
    emit_binary_overflow_derivation(out, symbols)!
    &out.push_str("#[doc(hidden)]\npub(crate) fn __jet_bootstrap_mir_program_to_host(\n    value: &{program_source},\n) -> Result<::jet_foundation::MIR::MirProgram, String> {{\n    __jet_bootstrap_with_trap_routes(__jet_bootstrap_source_trap_routes(value), || __jet_bootstrap_mir_MIRProgram_to_host(value))\n}}\n\n")
    if !(if program.body == { .Struct(_) -> true else -> false }) { throw BootstrapHostCodecError.InvalidMetadata("Source MirProgram must remain a struct") }
    &out.push_str("#[doc(hidden)]\npub(crate) fn __jet_bootstrap_mir_program_from_host(\n    value: &::jet_foundation::MIR::MirProgram,\n) -> Result<{program_source}, String> {{\n    __jet_bootstrap_with_trap_routes(__jet_bootstrap_host_trap_routes(value), || __jet_bootstrap_mir_MIRProgram_from_host(value))\n}}\n\n")
    &out.push_str("#[doc(hidden)]\npub(crate) type __JetBootstrapSourceProgram = {program_source};\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:338
pub fn insert_external_host_definitions(host_by_name: &[String: Definition]) -> {
    loop line in HOST_MIR_SCHEMA.lines() {
        trimmed := line.trim() // #4303
        if trimmed.strip_prefix("mir_id!(").and_then(fn(rest) { rest.strip_suffix(");") }) == .Some(name) {
            _ :: &host_by_name.insert(respell_acronym_name(name), Definition{name: name.to_string(), body: .Tuple})
        }
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:365
pub fn insert_support_host_definitions(source: [Definition], host_by_name: &[String: Definition]) -> [BootstrapHostCodecError] {
    errors := []
    loop definition in source {
        name :: definition.name
        if host_by_name.contains_key(name) || id_newtype(definition) || custom_source_converter(name) || source_only_type(name) { continue }
        path :: host_type_path(name, host_by_name)
        if path == "::jet_foundation::MIR::{name}" { continue }
        found :: host_support_definition(path) catch { error -> { &errors.push(BootstrapHostCodecError.InvalidMetadata("Source MIR `{name}` maps to native `{path}`, whose declaration does not parse: {error}")); continue } }
        if found == {
            .Some(host) -> { _ :: &host_by_name.insert(name.to_string(), host) }
            .None -> &errors.push(BootstrapHostCodecError.InvalidMetadata("Source MIR `{name}` maps to native `{path}`, which its module source does not declare"))
        }
    }
    errors
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:400
pub fn host_support_definition(path: String) -> Definition? Err! {
    (module, name) :: if path.strip_prefix("::jet_foundation::").and_then(fn(rest) { rest.rsplit_once("::") }) == { .Some(parts) -> parts .None -> return None }
    loop (schema_module, schema) in HOST_SUPPORT_SCHEMAS {
        if schema_module != module { continue }
        input :: strip_comments(schema)
        cursor := 0
        while find_next_definition(input, cursor) == .Some((keyword, start)) {
            position := start + keyword.len()
            skip_space(input, &position)
            cursor = position
            if read_identifier(input, &position).ok() == .Some(name) {
                (definition, _) :: parse_definition_body(input, keyword, name.to_string(), position)!
                return Some(definition)
            }
        }
    }
    None
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:426
pub fn emit_special_structural_converters(out: &String, symbols: BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    &out.push_str("fn __jet_bootstrap_mir_collect_unique<C, T>(items: Vec<T>, duplicate: &str) -> Result<C, String>\nwhere\n    C: ::std::iter::FromIterator<T>,\n    for<'a> &'a C: ::std::iter::IntoIterator,\n{{\n    let count = items.len();\n    let output: C = items.into_iter().collect();\n    if (&output).into_iter().count() != count {{\n        return Err(duplicate.to_string());\n    }}\n    Ok(output)\n}}\n")
    trait_ref :: symbols.type_symbol("MIRTraitRef")!
    &out.push_str("fn __jet_bootstrap_mir_trait_bound_to_host(value: &{trait_ref}) -> Result<::jet_foundation::MIR::MirNominalRef, String> {{\n    let bound = __jet_bootstrap_mir_MIRTraitRef_to_host(value)?;\n    Ok(::jet_foundation::MIR::MirNominalRef {{ id: ::jet_foundation::MIR::MirTypeId(bound.id.0), name: bound.name }})\n}}\n\n")
    provenance_source :: symbols.type_symbol("MIRViewProvenanceEntry")!
    provenance_slot :: symbols.field_symbol("MIRViewProvenanceEntry", "slot")!
    provenance_value :: symbols.field_symbol("MIRViewProvenanceEntry", "provenance")!
    &out.push_str("fn __jet_bootstrap_mir_view_provenance_to_host(values: &[{provenance_source}]) -> Result<::std::collections::BTreeMap<Vec<String>, ::jet_foundation::MIR::MirViewProvenance>, String> {{\n    let mut output = ::std::collections::BTreeMap::new();\n    for value in values {{\n        let key = value.{provenance_slot}.iter().cloned().collect::<Vec<_>>();\n        let converted = __jet_bootstrap_mir_MIRViewProvenance_to_host(&value.{provenance_value})?;\n        if output.insert(key, converted).is_some() {{\n            return Err(\"duplicate Source MIR view provenance slot\".to_string());\n        }}\n    }}\n    Ok(output)\n}}\n\n")
    job_limit_source :: symbols.type_symbol("MIRJobLimit")!
    job_limit_name :: symbols.field_symbol("MIRJobLimit", "name")!
    job_limit_value :: symbols.field_symbol("MIRJobLimit", "value")!
    &out.push_str("fn __jet_bootstrap_mir_job_limits_to_host(values: &[{job_limit_source}]) -> Result<::std::collections::BTreeMap<String, String>, String> {{\n    let mut output = ::std::collections::BTreeMap::new();\n    for value in values {{\n        if output.insert(value.{job_limit_name}.clone(), value.{job_limit_value}.clone()).is_some() {{\n            return Err(\"duplicate Source MIR job limit name\".to_string());\n        }}\n    }}\n    Ok(output)\n}}\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:463
pub fn emit_special_host_to_source_converters(out: &String, symbols: BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    trait_ref :: symbols.type_symbol("MIRTraitRef")!
    &out.push_str("fn __jet_bootstrap_mir_trait_bound_from_host(value: &::jet_foundation::MIR::MirNominalRef) -> Result<{trait_ref}, String> {{\n    __jet_bootstrap_mir_MIRTraitRef_from_host(&::jet_foundation::MIR::MirTraitRef {{ id: ::jet_foundation::MIR::MirTraitId(value.id.0), name: value.name.clone() }})\n}}\n\n")
    provenance_source :: symbols.type_symbol("MIRViewProvenanceEntry")!
    provenance_slot :: symbols.field_symbol("MIRViewProvenanceEntry", "slot")!
    provenance_value :: symbols.field_symbol("MIRViewProvenanceEntry", "provenance")!
    &out.push_str("fn __jet_bootstrap_mir_view_provenance_from_host(values: &::std::collections::BTreeMap<Vec<String>, ::jet_foundation::MIR::MirViewProvenance>) -> Result<Vec<{provenance_source}>, String> {{\n    let mut output = Vec::with_capacity(values.len());\n    for (slot, provenance) in values {{\n        output.push({provenance_source} {{\n            {provenance_slot}: slot.iter().cloned().collect(),\n            {provenance_value}: __jet_bootstrap_mir_MIRViewProvenance_from_host(provenance)?,\n        }});\n    }}\n    Ok(output)\n}}\n\n")
    job_limit_source :: symbols.type_symbol("MIRJobLimit")!
    job_limit_name :: symbols.field_symbol("MIRJobLimit", "name")!
    job_limit_value :: symbols.field_symbol("MIRJobLimit", "value")!
    &out.push_str("fn __jet_bootstrap_mir_job_limits_from_host(values: &::std::collections::BTreeMap<String, String>) -> Result<Vec<{job_limit_source}>, String> {{\n    Ok(values.iter().map(|(name, value)| {job_limit_source} {{ {job_limit_name}: name.clone(), {job_limit_value}: value.clone() }}).collect())\n}}\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:493
pub fn emit_id_from_host_converter(out: &String, symbols: BootstrapCodecSymbols, host_by_name: [String: Definition], name: String) -> Unit BootstrapHostCodecError! {
    source :: symbols.type_symbol(name)!
    value_field :: symbols.field_symbol(name, "value")!
    host_path :: host_type_path(name, host_by_name)
    &out.push_str("fn __jet_bootstrap_mir_{name}_from_host(value: &{host_path}) -> Result<{source}, String> {{\n    let raw = value.0;\n    if raw == 0 {{ return Err(\"MIR identity must be non-zero\".to_string()); }}\n    Ok({source} {{ {value_field}: raw }})\n}}\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:509
pub fn emit_tuple_from_host_converter(definition: Definition) -> Unit BootstrapHostCodecError! {
    throw BootstrapHostCodecError.InvalidMetadata("Source MIR tuple carrier `{definition.name}` has no checked native representation")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:518
pub fn emit_struct_from_host_converter(out: &String, symbols: BootstrapCodecSymbols, host_by_name: [String: Definition], pairs: PairRecords, definition: Definition, source_fields: [Field]) -> Unit BootstrapHostCodecError! {
    source :: symbols.type_symbol(definition.name)!
    host_path :: host_type_path(definition.name, host_by_name)
    host_fields :: if host_by_name.get(definition.name) == {
        .Some(host) -> if host.body == {
            .Struct(fields) -> fields
            .Tuple -> throw BootstrapHostCodecError.InvalidMetadata("native MIR type `{definition.name}` is a tuple carrier but Source MIR declares a struct")
            .Enum(_) -> throw BootstrapHostCodecError.InvalidMetadata("native MIR type `{definition.name}` is an enum but Source MIR declares a struct")
        }
        .None -> throw missing_host_definition(definition.name)
    }
    initializers := []
    loop source_field in source_fields {
        source_field_symbol :: symbols.field_symbol(definition.name, source_field.name)!
        if custom_struct_field_from_host(definition.name, source_field.name) == .Some(expression) {
            &initializers.push("        {source_field_symbol}: {expression},")
            continue
        }
        host_field :: host_fields.iter().find(fn(field) { source_field_name(definition.name, field.name) == source_field.name }).ok_or_else(fn() { BootstrapHostCodecError.InvalidMetadata("Source MIR field `{definition.name}.{source_field.name}` has no native MIR source") })!
        expression :: convert_from_host_expression(source_field.ty, host_field.ty, "&value.{host_field.name}", pairs)!
        &initializers.push("        {source_field_symbol}: {into_source_field(source_field.ty, expression)},")
    }
    checks := ""
    loop host_field in host_fields {
        source_name :: source_field_name(definition.name, host_field.name)
        if source_fields.iter().any(fn(field) { field.name == source_name }) { continue }
        if custom_struct_field_to_host(symbols, definition.name, host_field.name)! == .Some(fixed) {
            &checks.push_str("    if !matches!(&value.{host_field.name}, {fixed}) {{ return Err(\"native MIR field `{definition.name}.{host_field.name}` holds a value Source MIR does not carry\".to_string()); }}\n")
        }
    }
    &out.push_str("fn __jet_bootstrap_mir_{definition.name}_from_host(value: &{host_path}) -> Result<{source}, String> {{\n{checks}    Ok({source} {{\n{initializers.join("\n")}\n    }})\n}}\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:609
pub fn emit_enum_from_host_converter(out: &String, symbols: BootstrapCodecSymbols, host_by_name: [String: Definition], pairs: PairRecords, definition: Definition, source_variants: [Variant]) -> Unit BootstrapHostCodecError! {
    source :: symbols.type_symbol(definition.name)!
    host_path :: host_type_path(definition.name, host_by_name)
    host_variants :: if host_by_name.get(definition.name) == {
        .Some(host) -> if host.body == { .Enum(variants) -> variants else -> throw BootstrapHostCodecError.InvalidMetadata("native MIR type `{definition.name}` is not an enum") }
        .None -> throw missing_host_definition(definition.name)
    }
    arms := []
    loop source_variant in source_variants {
        source_path :: symbols.variant_path(definition.name, source_variant.name)!
        host_name :: host_variant_name(definition.name, source_variant.name)
        host_variant :: host_variants.iter().find(fn(variant) { respell_acronym_name(variant.name) == host_name }).ok_or_else(fn() { BootstrapHostCodecError.InvalidMetadata("native MIR enum `{definition.name}` has no variant `{host_name}`") })!
        aligned :: align_variant_fields(definition.name, source_variant, host_variant)!
        bindings :: (0..host_variant.fields.len()).map(fn(index) { "__field_{index}" }).collect()
        pattern :: if host_variant.fields.is_empty() -> "{host_path}::{host_variant.name}"
        else if host_variant.fields.iter().all(fn(field) { field.name.is_some() }) {
            fields :: host_variant.fields.iter().zip(bindings.iter()).map(fn((field, binding)) { "{field.name.unwrap_or_default()}: {binding}" }).collect()
            "{host_path}::{host_variant.name} {{ {fields.join(", ")} }}"
        } else if host_variant.fields.iter().all(fn(field) { field.name.is_none() }) -> "{host_path}::{host_variant.name}({bindings.join(", ")})"
        else -> throw BootstrapHostCodecError.InvalidMetadata("native MIR enum variant `{definition.name}::{host_variant.name}` mixes named and positional fields")
        if unrepresentable_host_field(definition.name, source_variant, host_variant, aligned) == .Some(reason) {
            &arms.push("        {pattern} => Err({reason:?}.to_string()),")
            continue
        }
        values := []
        loop (source_index, source_field) in source_variant.fields.iter().enumerate() {
            value :: if aligned.iter().position(fn(aligned) { aligned == Some(source_index) }) == {
                .Some(host_index) -> convert_from_host_expression(source_field.ty, host_variant.fields[host_index].ty, bindings[host_index], pairs)!
                .None -> derived_field_from_host(symbols, definition.name, source_variant, host_variant, bindings)!
            }
            &values.push(into_source_field(source_field.ty, value))
        }
        constructor :: source_variant_shape(symbols, definition.name, source_variant, source_path, values)!
        &arms.push("        {pattern} => Ok({constructor}),")
    }
    &out.push_str("fn __jet_bootstrap_mir_{definition.name}_from_host(value: &{host_path}) -> Result<{source}, String> {{\n    match value {{\n{arms.join("\n")}\n        _ => Err(\"native MIR enum variant is not representable in Source MIR\".to_string()),\n    }}\n}}\n\n")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:714
pub fn source_variant_shape(symbols: BootstrapCodecSymbols, owner: String, variant: Variant, path: String, parts: [String]) -> String BootstrapHostCodecError! {
    if variant.fields.is_empty() { return path }
    fields := []
    loop (field, part) in variant.fields.iter().zip(parts) {
        name :: field.name.ok_or_else(fn() { BootstrapHostCodecError.InvalidMetadata("Source MIR enum variant `{owner}::{variant.name}` has a positional payload field") })!
