            if pair_record(source_type, pairs) == .Some(pair) {
                if host_tuple_types(host_type, pair)! == .Some(host_types) { return host_tuple_from_source(pair, host_types, expression, pairs)! }
            }
            convert_named_expression(name, host_type, expression)!
        }
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1522
pub fn convert_named_expression(source_name: String, host_type: TypeExpr, expression: String) -> String BootstrapHostCodecError! {
    if source_name == "MIRTraitRef" && host_nominal_ref(host_type) { return "__jet_bootstrap_mir_trait_bound_to_host(&({expression}))?" }
    if source_name == "String" && host_static_str(host_type) { return "(::std::boxed::Box::leak(({expression}).clone().into_boxed_str()) as &'static str)" }
    if source_name == "String" && (if host_type == { .Named(name) -> name == "std::path::PathBuf" || name.ends_with("::PathBuf") else -> false }) { return "::std::path::PathBuf::from(({expression}).clone())" }
    if source_name == "String" || source_name == "Bool" || source_name == "Float" || source_name == "Float32" || source_name == "Char" || source_name.starts_with('U') || source_name.starts_with('I') {
        if source_name == "Int" { return "({expression}).to_string_rep().parse::<_>().map_err(|_| \"MIR integer is outside native range\".to_string())?" }
        return "({expression}).clone()"
    }
    if source_name == "Span" { return "__jet_bootstrap_span_to_host(&({expression}))?" }
    converted := if existing_helper(source_name) == {
        .Some((helper, true)) -> "{helper}(&({expression}))?"
        .Some((helper, false)) -> "{helper}(&({expression}))"
        .None -> "__jet_bootstrap_mir_{source_name}_to_host(&({expression}))?"
    }
    target :: if host_type == { .Optional(inner) -> inner else -> host_type }
    if target == .Named(name) { if name.starts_with("Box<") { converted = "Box::new({converted})" } }
    converted
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1580
pub fn existing_helper(name: String) -> (String, Bool)? {
    if name == {
        "MIRTypeID" -> Some(("__jet_bootstrap_type_id_to_host", true))
        "MIRMeasure" -> Some(("__jet_bootstrap_measure_to_host", true))
        "MIRDimension" -> Some(("__jet_bootstrap_dimension_to_host", true))
        "MIRTagMarker" -> Some(("__jet_bootstrap_tag_to_host", false))
        "MIRABI" -> Some(("__jet_bootstrap_abi_to_host", false))
        "MIRSize" -> Some(("__jet_bootstrap_size_to_host", true))
        "MIRType" -> Some(("__jet_bootstrap_type_to_host", true))
        else -> None
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1596
pub fn host_static_str(host_type: TypeExpr) -> Bool {
    if host_type == { .Named(name) -> name.starts_with('&') && name.ends_with("str") else -> false }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1603
pub fn host_nominal_ref(host_type: TypeExpr) -> Bool {
    if host_type == { .Named(name) -> name == "MirNominalRef" else -> false }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1611
pub fn host_type_path(name: String, host_by_name: [String: Definition]) -> String {
    if name == {
        "MIRSchemaMigrationPlan" | "MIRSchemaMigrationStep" | "MIRSchemaMigrationOp" -> "::jet_foundation::SchemaMigration::{name.trim_start_matches("MIR")}"
        "Span" -> "::jet_foundation::Diagnostics::Span"
        "ParamZone" -> "::jet_foundation::MIR::MirParamZone"
        "MIRShapeFieldNames" -> "::jet_foundation::Shape::ShapeFieldNames"
        "MIROperatorMarker" -> "::jet_foundation::AST::OperatorMarker"
        "CoreMarkerApplication" -> "::jet_foundation::Syntax::CoreMarkerApplication"
        "Effect" -> "::jet_foundation::Effects::Effect"
        "SinkClass" -> "::jet_foundation::Syntax::SinkClass"
        "LayoutFacts" | "ByteLayout" | "FieldLayoutFacts" -> "::jet_foundation::Layout::{name}"
        "MIRDerivationRef" | "MIRDerivationMethod" | "MIRDerivationDisposition" -> "::jet_foundation::Facts::{name.trim_start_matches("MIR")}"
        "MIRFFIEvidenceBasis" -> "::jet_foundation::AST::FfiEvidenceBasis"
        "MIRFFIBoundaryFacts" -> "::jet_foundation::AST::FfiBoundaryFacts"
        "MIRFFIBoundaryObligation" -> "::jet_foundation::AST::FfiBoundaryObligation"
        "MIRTypedHeadKind" -> "::jet_foundation::Syntax::TypedHeadKind"
        "MIRWebBucket" -> "::jet_foundation::WebPartition::WebBucket"
        "MIRWebPartitionMarker" -> "::jet_foundation::WebPartition::WebPartitionMarker"
        "MIRFFICloseSource" -> "::jet_foundation::AST::FfiCloseSource"
        "MIRFFIThreadSafety" -> "::jet_foundation::AST::FfiThreadSafety"
        "MIRResourceAccessMode" -> "::jet_foundation::ResourceSchedule::JetResourceAccessMode"
        "MIRResourceIdentity" -> "::jet_foundation::ResourceSchedule::JetResourceIdentity"
        "MIRResourceRegion" -> "::jet_foundation::ResourceSchedule::JetResourceRegion"
        "MIRResourceLayout" -> "::jet_foundation::ResourceSchedule::JetResourceLayout"
        "MIRResourceAccess" -> "::jet_foundation::ResourceSchedule::JetResourceAccess"
        "MIRFrameCompletion" -> "::jet_foundation::ResourceSchedule::JetFrameCompletion"
        "MIRFrameOperation" -> "::jet_foundation::ResourceSchedule::JetFrameOperation"
        "MIRFrameDependency" -> "::jet_foundation::ResourceSchedule::JetFrameDependency"
        "MIRFrameTransfer" -> "::jet_foundation::ResourceSchedule::JetFrameTransfer"
        "MIRFrameReuse" -> "::jet_foundation::ResourceSchedule::JetFrameReuse"
        "MIRFrameRetention" -> "::jet_foundation::ResourceSchedule::JetFrameRetention"
        "MIRFrameSchedule" -> "::jet_foundation::ResourceSchedule::JetFrameSchedule"
        "MIRHostImportFact" -> "::jet_foundation::Authority::HostImportFact"
        "MIRNameFacts" -> "::jet_foundation::MIR::MirNameFacts"
        "MIRStructureFact" | "MIRStructureFactKind" -> "::jet_foundation::Names::{name.trim_start_matches("MIR")}"
        "MIRFixedReductionTree" | "MIRFixedReductionOrder" | "MIRAccelerationTransform" | "MIRAccelerationProof" | "MIRAccelerationWorkloadFacts" -> "::jet_foundation::MIROptimization::Acceleration::{name.trim_start_matches("MIR")}"
        "CoreCallFallibility" | "CoreCallPureRoute" | "CoreCallInterpreterRoute" | "CoreCallSymbol" -> "::jet_foundation::Syntax::{name}"
        "MIRLayoutSupportFacts" | "MIRLayoutCapabilityFacts" | "MIRLayoutAlignmentFact" -> "::jet_foundation::Layout::{name.trim_start_matches("MIR")}"
        "MIROSTarget" -> "::jet_foundation::OSTarget::OSTarget"
        "MIRRuntimeLayer" -> "::jet_foundation::RingLayer::RuntimeLayer"
        "MIRByteSize" | "MIRMemoryAccess" | "MIRMemoryRegion" | "MIRLinkerInput" | "MIRProviderLimits" | "MIRProviderContract" | "MIRAllocatorPolicy" | "MIRPanicPolicy" | "MIRClockPolicy" | "MIREntropyPolicy" | "MIRSchedulerPolicy" | "MIRByteSinkPolicy" | "MIRStartupPolicy" | "MIRAuditPolicy" | "MIRRegisterWidth" | "MIRTargetRegisterAccessMode" | "MIRTargetRegisterFact" | "MIRTargetRegisterBlockFact" | "MIRTargetRegisterOperation" | "MIRTargetRegisterAccessFact" | "MIRTargetInterruptFact" | "MIRTargetInterruptHandlerFact" | "MIRTargetHardwareFacts" | "MIRTargetHardwareUse" | "MIRTargetHardwareUnresolvedReference" | "MIRTargetProgrammerAdapter" | "MIRTargetProgrammerFacts" | "MIRTargetMachine" | "MIRMemoryKind" -> "::jet_foundation::TargetMachine::{name.trim_start_matches("MIR")}"
        "MIRMMIOPolicy" -> "::jet_foundation::TargetMachine::MmioPolicy"
        "MIRSVDProvenance" -> "::jet_foundation::TargetMachine::SvdProvenance"
        "MIRTargetDossier" -> "::jet_foundation::Facts::TargetDossier"
        "MIRComponentSignatureDescriptor" | "MIRComponentTypeDescriptor" -> "::jet_foundation::MIR::{name.trim_start_matches("MIR")}"
        "MIRProviderABI" -> "::jet_foundation::TargetMachine::ProviderAbi"
        "MIRTargetDMAOwnership" -> "::jet_foundation::TargetMachine::TargetDmaOwnership"
        "MIRTargetDMAChannelFact" -> "::jet_foundation::TargetMachine::TargetDmaChannelFact"
        "MIRTargetDMAOperation" -> "::jet_foundation::TargetMachine::TargetDmaOperation"
        "MIRTargetDMAOwner" -> "::jet_foundation::TargetMachine::TargetDmaOwner"
        "MIRTargetDMAOperationFact" -> "::jet_foundation::TargetMachine::TargetDmaOperationFact"
        "MIRTargetApplicability" -> "::jet_foundation::MIR::MirTargetApplicability"
        "MIRAppPendingBoundaryID" -> "::jet_foundation::App::AppPendingBoundaryId"
        name if name.starts_with("MIRName") && name != "MIRNamedSpan" -> "::jet_foundation::Names::{name.trim_start_matches("MIR")}"
        name if name.starts_with("MIRApp") -> "::jet_foundation::App::{name.trim_start_matches("MIR")}"
        "MIRDataPlanOperation" | "MIRDataPlanPhysicalOperator" -> "::jet_foundation::AST::DataPlan{name.trim_start_matches("MIRDataPlan")}Kind"
        "MIRDataPlanSourceKind" | "MIRDataPlanStreamMode" -> "::jet_foundation::AST::{name.trim_start_matches("MIR")}"
        else -> "::jet_foundation::MIR::{host_by_name.get(name).map_or(name, fn(definition) { definition.name })}"
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1788
pub fn source_field_name(owner: String, host_field: String) -> String {
    if (owner, host_field) == {
        ("MIRImport", "module") | ("MIRTypeDef", "module") -> "module_id"
        ("MIRFunction", "module") | ("MIRPreludeCall", "module") | ("MIRCoreCall", "module") -> "module_name"
        ("MIRCoreCall", "effect") | ("MIRPreludeCall", "effect") -> "effect_kind"
        ("MIRForeign", "module") | ("MIRCLib", "module") -> "module_name"
        ("MIRTraitDef", "module") | ("MIRImplDef", "module") | ("MIRConstantDef", "module") -> "module_id"
        ("MIRNameDeclaration", "module") | ("MIRNameAlias", "module") -> "module_index"
        // comptime is a Source keyword.
        ("MIRLocal", "comptime") -> "is_comptime"
        else -> host_field.to_string()
    }
}
