// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1109
pub fn expand_host_aliases(ty: String) -> String {
    static ALIASES: OnceLock[[String: String?]] = OnceLock.new() // GATE #4494
    aliases :: ALIASES.get_or_init(fn() {
        aliases := [:]
        loop (_, schema) in HOST_SUPPORT_SCHEMAS {
            loop line in schema.lines() {
                trimmed := line.trim() // #4303
                row :: trimmed.strip_prefix("pub type ").and_then(fn(rest) { rest.strip_suffix(';') }).and_then(fn(rest) { rest.split_once('=') })
                if row == .Some((raw_name, raw_target)) {
                    name := raw_name.trim() // #4303
                    target := raw_target.trim() // #4303
                    if !name.chars().all(fn(c) { c.is_ascii_alphanumeric() || c == '_' }) { continue }
                    if aliases.get(name) == .Some(known) {
                        if known != Some(target) { _ :: &aliases.insert(name.to_string(), None) }
                    } else { _ :: &aliases.insert(name.to_string(), Some(target.to_string())) }
                }
            }
        }
        aliases
    })
    expanded := ty.to_string()
    loop _ in 0..8 {
        out := String.with_capacity(expanded.len())
        changed := false
        rest := expanded
        while rest.find(fn(c) { c.is_ascii_alphabetic() || c == '_' }) == .Some(start) {
            &out.push_str(rest[..start])
            path :: rest[start..]
            end :: path.find(fn(c) { !(c.is_ascii_alphanumeric() || c == '_' || c == ':') }).unwrap_or(path.len())
            segment :: path[..end].rsplit("::").next().unwrap_or_default()
            if aliases.get(segment) == {
                .Some(.Some(target)) -> { &out.push_str(target); changed = true }
                else -> &out.push_str(path[..end])
            }
            rest = path[end..]
        }
        &out.push_str(rest)
        expanded = out
        if !changed { break }
    }
    expanded
}
