//RS fn emit_id_converter(
//RS     out: &mut String,
//RS     symbols: &BootstrapCodecSymbols<'_>,
//RS     host_by_name: &BTreeMap<String, Definition>,
//RS     name: &str,
//RS ) -> Result<(), BootstrapHostCodecError> {
//RS     let source = symbols.type_symbol(name)?;
//RS     let value_field = symbols.field_symbol(name, "value")?;
//RS     let host_path = host_type_path(name, host_by_name);
//RS     writeln!(
//RS         out,
//RS         "fn __jet_bootstrap_mir_{name}_to_host(value: &{source}) -> Result<{host_path}, String> {{\n    let raw = value.{value_field};\n    if raw == 0 {{ return Err(\"MIR identity must be non-zero\".to_string()); }}\n    Ok({host_path}(raw))\n}}\n"
//RS     )
//RS     .map_err(|error| BootstrapHostCodecError::InvalidMetadata(error.to_string()))
//RS }
//RS 
//RS /// Source MIR identities are single-`value` records named `…ID`; native MIR
//RS /// carries them as `u64` newtypes. Enums that happen to end in `ID`
//RS /// (`MIROptimizationPassID`, `MIRRuntimePartID`) convert structurally.
//RS fn id_newtype(definition: &Definition) -> bool {
//RS     definition.name.ends_with("ID")
//RS         && definition.name != "MIRTypeID"
//RS         && matches!(definition.body, Body::Struct(_))
//RS }
//RS 
//RS fn custom_source_converter(name: &str) -> bool {
//RS     matches!(
//RS         name,
//RS         "Span"
//RS             | "MIRTypeID"
//RS             | "MIRMeasure"
//RS             | "MIRDimension"
//RS             | "MIRTagMarker"
//RS             | "MIRABI"
//RS             | "MIRSize"
//RS             | "MIRType"
//RS             | "MIRViewProvenanceEntry"
//RS             | "MIRJobLimit"
//RS             | "MIRStringPart"
//RS             | "MIRStringPartKind"
//RS     )
//RS }
//RS 
//RS /// Source-only enums with no native MIR type. Their values never cross on
//RS /// their own: `MIRBinaryOverflow` is derived from the Binary dispatch (see
//RS /// `derived_source_variant_field`), and string formats are carried only as the
//RS /// display interpolation the string-part converter accepts. So they get no
//RS /// converters, which would name a native type that does not exist.
//RS fn source_only_type(name: &str) -> bool {
//RS     matches!(name, "MIRBinaryOverflow" | "MIRStringFormat" | "MIRUnitFormat")
//RS }
//RS 
//RS /// A Source definition with no native type of its own: absent from the parsed
//RS /// `MIR.rs` schema and from the support carriers `host_type_path` maps into
//RS /// other `jet_foundation` modules (a mapped carrier that is not declared is
//RS /// reported by `insert_support_host_definitions`). Such records cross only
//RS /// inline (pair records, hand converters), so a standalone converter would
//RS /// name a type that does not exist; a use that does need one fails at its call
//RS /// site instead.
//RS fn native_type_absent(name: &str, host_by_name: &BTreeMap<String, Definition>) -> bool {
//RS     !host_by_name.contains_key(name)
//RS }
//RS 
//RS fn missing_host_definition(name: &str) -> BootstrapHostCodecError {
//RS     BootstrapHostCodecError::InvalidMetadata(format!(
//RS         "Source MIR `{name}` has no parsed native carrier"
//RS     ))
//RS }
//RS 
//RS /// A converted value as the Source field it initializes: `.into()` covers the
//RS /// emitter's boxed recursive fields (`Box<MIRType>`, `Box<Vec<..>>`) through
//RS /// `From<T>`. A map is never boxed, and `.into()` would leave the collected
//RS /// map type uninferred, so a map value is used as is.
//RS fn into_source_field(source_type: &str, value: &str) -> String {
//RS     if matches!(parse_type(source_type), Ok(TypeExpr::Map(..))) {
//RS         value.to_string()
//RS     } else {
//RS         format!("({value}).into()")
//RS     }
//RS }
//RS 
//RS /// Source MIR keeps a string part as a record over a kind that also carries
//RS /// the interpolation format; native MIR has a bare literal/value enum and
//RS /// lowers formatting before `BuildString`. Only display interpolation crosses.
//RS fn emit_string_part_converters(
//RS     out: &mut String,
//RS     symbols: &BootstrapCodecSymbols<'_>,
//RS ) -> Result<(), BootstrapHostCodecError> {
//RS     let part = symbols.type_symbol("MIRStringPart")?;
//RS     let kind = symbols.field_symbol("MIRStringPart", "kind")?;
//RS     let literal = symbols.variant_path("MIRStringPartKind", "Literal")?;
//RS     let interpolation = symbols.variant_path("MIRStringPartKind", "Interpolation")?;
//RS     let display = symbols.variant_path("MIRStringFormat", "Display")?;
//RS     let text = symbols.field_symbol("MIRStringPartKind", "text")?;
//RS     let interpolated = symbols.field_symbol("MIRStringPartKind", "value")?;
//RS     let format = symbols.field_symbol("MIRStringPartKind", "format")?;
//RS     writeln!(
//RS         out,
//RS         "fn __jet_bootstrap_mir_MIRStringPart_to_host(value: &{part}) -> Result<::jet_foundation::MIR::MirStringPart, String> {{\n    match &value.{kind} {{\n        {literal} {{ {text}: __text }} => Ok(::jet_foundation::MIR::MirStringPart::Literal(__text.clone())),\n        {interpolation} {{ {interpolated}: __value, {format}: {display} }} => Ok(::jet_foundation::MIR::MirStringPart::Value(__jet_bootstrap_mir_MIRValueID_to_host(__value)?)),\n        {interpolation} {{ .. }} => Err(\"Source MIR string interpolation with a format has no native MIR string part\".to_string()),\n    }}\n}}\n\nfn __jet_bootstrap_mir_MIRStringPart_from_host(value: &::jet_foundation::MIR::MirStringPart) -> Result<{part}, String> {{\n    Ok({part} {{\n        {kind}: match value {{\n            ::jet_foundation::MIR::MirStringPart::Literal(__text) => {literal} {{ {text}: __text.clone() }},\n            ::jet_foundation::MIR::MirStringPart::Value(__value) => {interpolation} {{ {interpolated}: __jet_bootstrap_mir_MIRValueID_from_host(__value)?, {format}: {display} }},\n        }},\n    }})\n}}\n"
//RS     )
//RS     .map_err(|error| BootstrapHostCodecError::InvalidMetadata(error.to_string()))
//RS }
