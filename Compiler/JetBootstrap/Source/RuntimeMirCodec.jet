            "({expression}).iter().map(|__item| Ok({converted})).collect::<Result<Vec<_>, String>>()?"
        }
        .Map(key, value) -> {
            (host_key, host_value) :: if host_type == { .Map(host_key, host_value) -> (host_key, host_value) else -> (key, value) }
            converted_key :: convert_from_host_type_expression(key, host_key, "__key", pairs)!
            converted_value :: convert_from_host_type_expression(value, host_value, "__value", pairs)!
            "__jet_bootstrap_mir_collect_unique(({expression}).iter().map(|(__key, __value)| Ok(({converted_key}, {converted_value}))).collect::<Result<Vec<_>, String>>()?, \"duplicate native MIR map key\")?"
        }
        .Named(name) -> {
