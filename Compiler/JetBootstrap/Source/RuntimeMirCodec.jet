//RS /// `ty` with each native type alias (`EffectSet` = `Holds` =
//RS /// `BTreeSet<String>`) spelled as the type it names, so the carrier shape
//RS /// (set, map, list) drives the conversion. Aliases are the single-line,
//RS /// non-generic `pub type` items of [`HOST_SUPPORT_SCHEMAS`]; a name aliased
//RS /// differently in two modules is left as written.
//RS fn expand_host_aliases(ty: &str) -> String {
//RS     static ALIASES: ::std::sync::OnceLock<BTreeMap<String, Option<String>>> =
//RS         ::std::sync::OnceLock::new();
//RS     let aliases = ALIASES.get_or_init(|| {
//RS         let mut aliases = BTreeMap::<String, Option<String>>::new();
//RS         for (_, schema) in HOST_SUPPORT_SCHEMAS {
//RS             for line in schema.lines() {
//RS                 let Some((name, target)) = line
//RS                     .trim()
//RS                     .strip_prefix("pub type ")
//RS                     .and_then(|rest| rest.strip_suffix(';'))
//RS                     .and_then(|rest| rest.split_once('='))
//RS                 else {
//RS                     continue;
//RS                 };
//RS                 let (name, target) = (name.trim(), target.trim().to_string());
//RS                 if !name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
//RS                     continue;
//RS                 }
//RS                 aliases
//RS                     .entry(name.to_string())
//RS                     .and_modify(|known| {
//RS                         if known.as_deref() != Some(target.as_str()) {
//RS                             *known = None;
//RS                         }
//RS                     })
//RS                     .or_insert(Some(target));
//RS             }
//RS         }
//RS         aliases
//RS     });
//RS     let mut expanded = ty.to_string();
//RS     // Aliases name aliases (`EffectSet` -> `Holds`); a cycle stops at the bound.
//RS     for _ in 0..8 {
//RS         let mut out = String::with_capacity(expanded.len());
//RS         let mut changed = false;
//RS         let mut rest = expanded.as_str();
//RS         while let Some(start) = rest.find(|c: char| c.is_ascii_alphabetic() || c == '_') {
//RS             out.push_str(&rest[..start]);
//RS             let path = &rest[start..];
//RS             let end = path
//RS                 .find(|c: char| !(c.is_ascii_alphanumeric() || c == '_' || c == ':'))
//RS                 .unwrap_or(path.len());
//RS             let segment = path[..end].rsplit("::").next().unwrap_or_default();
//RS             match aliases.get(segment) {
//RS                 Some(Some(target)) => {
//RS                     out.push_str(target);
//RS                     changed = true;
//RS                 }
//RS                 _ => out.push_str(&path[..end]),
//RS             }
//RS             rest = &path[end..];
//RS         }
//RS         out.push_str(rest);
//RS         expanded = out;
//RS         if !changed {
//RS             break;
//RS         }
//RS     }
//RS     expanded
//RS }
