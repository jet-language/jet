//RS /// A unit too large for one rustc, split by `shard_unit` (texts before
//RS /// export).
//RS struct ShardedUnit {
//RS     /// Every type, trait, impl and unmovable item: the unit crate itself.
//RS     facade: String,
//RS     /// `unsafe extern "Rust"` block members declaring each moved function.
//RS     declarations: String,
//RS     /// Moved hot function definitions, at most about `shard_bytes` each.
//RS     shards: Vec<String>,
//RS     /// Moved cold function definitions (`MovedFunction::cold`), packed the
//RS     /// same way into their own crates.
//RS     cold_shards: Vec<String>,
//RS }
//RS 
//RS /// One function moved out of a facade: its declaration and its definition
//RS /// under its own symbol.
//RS struct MovedFunction {
//RS     declaration: String,
//RS     definition: String,
//RS     /// Code an optimized build should not optimize: a cold-trait impl
