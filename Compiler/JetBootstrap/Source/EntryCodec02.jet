        }
        .Float -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Float {{ value, f32: false }} => value, _ => return Err(\"checked Float result has invalid carrier\".to_string()) }}"
        .Float32 -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Float {{ value, f32: true }} => value as f32, _ => return Err(\"checked Float32 result has invalid carrier\".to_string()) }}"
        .Measure(_) -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Float {{ value, f32: false }} => value, _ => return Err(\"checked Measure result has invalid carrier\".to_string()) }}"
        .Bool -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Bool(value) => value, _ => return Err(\"checked Bool result has invalid carrier\".to_string()) }}"
        .Char -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Char(value) => value, _ => return Err(\"checked Char result has invalid carrier\".to_string()) }}"
        .String -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::String(value) => value, _ => return Err(\"checked String result has invalid carrier\".to_string()) }}"
        .List(inner), .FixedList(elem: inner, ..) -> {
            if is_u8_type(inner) -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Bytes(bytes) => bytes, ::jet_foundation::MIR::MirRuntimeValue::List(items) => items.into_iter().map(|item| match item {{ ::jet_foundation::MIR::MirRuntimeValue::Int(value) => u8::try_from(value).map_err(|_| \"byte value is out of range\".to_string()), _ => Err(\"byte list contains a non-integer carrier\".to_string()) }}).collect::<Result<Vec<_>, String>>()?, _ => return Err(\"checked byte list result has invalid carrier\".to_string()) }}"
            else {
