    match (kind, ty.kind()) {{
        ("list", K::List(inner)) | ("fixed-list", K::FixedList {{ elem: inner, .. }}) | ("option", K::Option(inner)) | ("shared", K::Shared(inner)) | ("range", K::InlineRange {{ base: inner, .. }}) | ("tagged", K::Tagged {{ inner, .. }}) | ("quantity", K::Quantity {{ base: inner, .. }}) => Ok(inner),
        ("map", K::Map {{ key, .. }}) if index == 0 => Ok(key), ("map", K::Map {{ value, .. }}) if index == 1 => Ok(value),
        ("result", K::Result {{ ok, .. }}) if index == 0 => Ok(ok), ("result", K::Result {{ err, .. }}) if index == 1 => Ok(err),
