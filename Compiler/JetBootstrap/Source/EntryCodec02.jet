        }
        .Tuple(fields) -> {
            if fields.is_empty() -> "match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Unit => (), _ => return Err(\"checked unit result has invalid carrier\".to_string()) }}"
            else {
