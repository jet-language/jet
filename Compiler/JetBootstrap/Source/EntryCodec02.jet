fn __jet_bootstrap_entry_next_record_field(fields: &mut impl Iterator<Item = (String, ::jet_foundation::MIR::MirRuntimeValue)>, expected: &str) -> Result<(String, ::jet_foundation::MIR::MirRuntimeValue), String> {{
    let (name, value) = fields.next().ok_or_else(|| format!("record is missing checked field `{{expected}}`"))?;
