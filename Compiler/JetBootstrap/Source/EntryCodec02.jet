//RS         Kind::FixedList { elem: inner, .. }
//RS         | Kind::InlineRange { base: inner, .. }
//RS         | Kind::Tagged { inner, .. }
//RS         | Kind::Quantity { base: inner, .. } => entry_type_is_thread_bound(program, inner, visited),
//RS         Kind::Map { key, value } => {
//RS             entry_type_is_thread_bound(program, key, visited) || entry_type_is_thread_bound(program, value, visited)
//RS         }
//RS         Kind::Result { ok, err } => {
//RS             entry_type_is_thread_bound(program, ok, visited) || entry_type_is_thread_bound(program, err, visited)
//RS         }
//RS         Kind::Tuple(fields) => fields.iter().any(|(_, field)| entry_type_is_thread_bound(program, field, visited)),
//RS         Kind::Union(members) => members.iter().any(|member| entry_type_is_thread_bound(program, member, visited)),
//RS         Kind::Apply { name, args } => {
//RS             if args.iter().any(|arg| entry_type_is_thread_bound(program, arg, visited)) {
//RS                 return true;
//RS             }
//RS             if !visited.insert(name.id) {
//RS                 return false;
//RS             }
//RS             let Some(definition) = program.types.iter().find(|definition| definition.id == name.id) else {
//RS                 return false;
//RS             };
//RS             match &definition.kind {
//RS                 MirTypeDefKind::Struct { fields, .. } => {
//RS                     fields.iter().any(|field| entry_type_is_thread_bound(program, &field.ty, visited))
//RS                 }
//RS                 MirTypeDefKind::Enum { variants, .. } => variants.iter().any(|variant| match &variant.payload {
//RS                     MirVariantPayload::Unit => false,
