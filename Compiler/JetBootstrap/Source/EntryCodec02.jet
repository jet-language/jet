            child :: from_runtime_expression(program, symbols, inner, "*inner", "&__jet_inner_type", program_expr, path)!
            "{{ let __jet_inner_type = {inner_type}; match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Present(inner) => Ok({child}), ::jet_foundation::MIR::MirRuntimeValue::Absent {{ element }} if element.same_checked_type(__jet_inner_type) => Err(Default::default()), _ => return Err(\"checked Option result has invalid carrier\".to_string()) }} }}"
        }
        .Result(ok, err) -> {
            ok_type :: "__jet_bootstrap_entry_child_type({checked}, \"result\", 0)?"
            err_type :: "__jet_bootstrap_entry_child_type({checked}, \"result\", 1)?"
            ok_value :: from_runtime_expression(program, symbols, ok, "*inner", "&__jet_ok_type", program_expr, path)!
            err_value :: from_runtime_expression(program, symbols, err, "*inner", "&__jet_err_type", program_expr, path)!
            "{{ let __jet_ok_type = {ok_type}; let __jet_err_type = {err_type}; match {value} {{ ::jet_foundation::MIR::MirRuntimeValue::Present(inner) => Ok({ok_value}), ::jet_foundation::MIR::MirRuntimeValue::FailedTold(inner) => Err({err_value}), _ => return Err(\"checked Result result has invalid carrier\".to_string()) }} }}"
        }
