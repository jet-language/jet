            if fields.is_empty() -> "{mir}::Unit" else -> "{mir}::Struct {{ type_name: \"Tuple\".to_string(), fields: vec![{items.join(", ")}] }}"
        }
        .InlineRange(base, ..), .Tagged(inner: base, ..), .Quantity(base, ..) -> {
            kind :: if ty.kind() == { .InlineRange(..) -> "range"; .Tagged(..) -> "tagged"; else -> "quantity" }
            child_ty :: "__jet_bootstrap_entry_child_type({checked}, \"{kind}\", 0)?"
            child :: to_runtime_expression(program, symbols, base, source, "__jet_inner_type", program_expr, path, physical)!
            "{{ let __jet_inner_type = {child_ty}; {child} }}"
        }
        .Union(members) -> {
            id :: ty.identity ?? fail BootstrapHostCodecError.InvalidMetadata("checked entry union has no nominal identity")
            if members.is_empty() -> fail BootstrapHostCodecError.InvalidMetadata("checked entry union has no members")
            "__jet_bootstrap_entry_type_{id.0}_to_runtime({source}, {checked}, {program_expr}, {path}, {physical})?"
        }
    }
}

