fn is_u8_type(ty: MirType) -> Bool {
    if ty.kind() == { .IntN(signed: false, bits: 8) -> true; else -> false }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3362
// Fn and trait-object carriers cannot back a cross-thread Shared owner.
fn entry_type_is_thread_bound(program: MirProgram, ty: MirType, visited: &HashSet<MirTypeId>) -> Bool {
    if ty.kind() == {
        .Fn(_), .TraitObject(_) -> true
        .List(inner), .Option(inner), .Shared(inner),
        .FixedList(elem: inner, ..), .InlineRange(base: inner, ..),
        .Tagged(inner, ..), .Quantity(base: inner, ..) -> entry_type_is_thread_bound(program, inner, &visited)
        .Map(key, value) -> entry_type_is_thread_bound(program, key, &visited) || entry_type_is_thread_bound(program, value, &visited)
        .Result(ok, err) -> entry_type_is_thread_bound(program, ok, &visited) || entry_type_is_thread_bound(program, err, &visited)
        .Tuple(fields) -> fields.iter().any(fn(row) { entry_type_is_thread_bound(program, row.1, &visited) })
        .Union(members) -> members.iter().any(fn(member) { entry_type_is_thread_bound(program, member, &visited) })
        .Apply(name, args) -> {
            if args.iter().any(fn(arg) { entry_type_is_thread_bound(program, arg, &visited) }) -> return true
            if !visited.insert(name.id) -> return false
            definition :: program.types.iter().find(fn(definition) { definition.id == name.id }) ?? return false
            if definition.kind == {
                .Struct(fields, ..) -> fields.iter().any(fn(field) { entry_type_is_thread_bound(program, field.ty, &visited) })
                .Enum(variants, ..) -> variants.iter().any(fn(variant) {
                    if variant.payload == {
                        .Unit -> false
                        .Single(ty) -> entry_type_is_thread_bound(program, ty, &visited)
                        .Named(fields) -> fields.iter().any(fn(field) { entry_type_is_thread_bound(program, field.ty, &visited) })
                    }
                })
                .Distinct(base, ..) -> entry_type_is_thread_bound(program, base, &visited)
                .Alias(target) -> entry_type_is_thread_bound(program, target, &visited)
                .UnitFamily(..) -> false
            }
        }
        else -> false
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3413
// Continue past binding failures so symbols.finish reports the complete list.
fn validate_binding_graph(program: MirProgram, symbols: BootstrapCodecSymbols, root: MirType) {
    visited := HashSet<MirTypeId>.new()
    stack := [root]
    loop {
        ty :: stack.pop() ?? break
        if ty.kind() == {
            .List(inner), .Shared(inner), .Option(inner), .FixedList(elem: inner, ..),
            .InlineRange(base: inner, ..), .Tagged(inner, ..), .Quantity(base: inner, ..) -> stack.push(inner)
            .Map(key, value), .Result(ok: key, err: value) -> { stack.push(key); stack.push(value) }
            .Fn(signature) -> {
                stack.extend(signature.params.iter())
                if signature.ret == Some(ret) -> stack.push(ret)
            }
            .SendFn(params, ret, ..) -> {
                stack.extend(params.iter())
                if ret == Some(ret) -> stack.push(ret)
            }
            .Tuple(fields) -> stack.extend(fields.iter().map(fn(row) { row.1 }))
            .Union(members) -> stack.extend(members.iter())
            .Apply(name, args) -> {
                stack.extend(args.iter())
                if !visited.insert(name.id) -> continue
                definition :: checked_definition_by_ref(program, name) catch error {
                    symbols.record(error)
                    continue
                }
                _ :: symbols.type_symbol(definition.name) catch _ {}
                if definition.kind == {
                    .Struct(fields, ..) -> loop field in fields {
                        row :: symbols.field_binding(definition.name, field.name) catch error {
                            symbols.record(error)
                            stack.push(field.ty)
                            continue
                        }
                        if row.field != field.id || row.owner != definition.id || !row.ty.same_checked_type(field.ty) {
                            symbols.record(BootstrapHostCodecError.InvalidMetadata("checked field binding drift for `{definition.name}.{field.name}`"))
                        }
                        stack.push(field.ty)
                    }
                    .Enum(variants, ..) -> loop variant in variants {
                        _ :: symbols.variant_path(definition.name, variant.name) catch _ {}
                        if variant.payload == {
                            .Unit -> {}
                            .Single(ty) -> stack.push(ty)
                            .Named(fields) -> loop field in fields {
                                row :: symbols.field_binding_by_id(definition.id, definition.name, field.id, field.name) catch error {
                                    symbols.record(error)
                                    stack.push(field.ty)
                                    continue
                                }
                                if row.field != field.id || row.owner != definition.id || !row.ty.same_checked_type(field.ty) {
                                    symbols.record(BootstrapHostCodecError.InvalidMetadata("checked enum payload binding drift for `{definition.name}::{variant.name}.{field.name}`"))
                                }
                                stack.push(field.ty)
                            }
                        }
                    }
                    .Distinct(base, ..), .Alias(target: base) -> stack.push(base)
                    .UnitFamily(..) -> {}
                }
            }
            else -> {}
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3475
fn collect_nominal_types(program: MirProgram, root: MirType, visited: &HashSet<MirTypeId>, output: &[MirTypeDef]) -> Unit BootstrapHostCodecError! {
    stack := [root]
    loop {
        ty :: stack.pop() ?? break
        if ty.kind() == {
            .List(inner), .Shared(inner), .Option(inner), .FixedList(elem: inner, ..),
            .InlineRange(base: inner, ..), .Tagged(inner, ..), .Quantity(base: inner, ..) -> stack.push(inner)
            .Map(key, value), .Result(ok: key, err: value) -> { stack.push(key); stack.push(value) }
            .Fn(signature) -> {
                stack.extend(signature.params.iter())
                if signature.ret == Some(ret) -> stack.push(ret)
            }
            .SendFn(params, ret, ..) -> {
                stack.extend(params.iter())
                if ret == Some(ret) -> stack.push(ret)
            }
            .Tuple(fields) -> stack.extend(fields.iter().map(fn(row) { row.1 }))
            .Union(members) -> stack.extend(members.iter())
            .Apply(name, args) -> {
                stack.extend(args.iter())
                if visited.insert(name.id) {
                    def :: checked_definition_by_ref(program, name)!
                    output.push(def)
                    if def.kind == {
                        .Struct(fields, ..) -> stack.extend(fields.iter().map(fn(field) { field.ty }))
                        .Enum(variants, ..) -> loop variant in variants {
                            if variant.payload == {
                                .Unit -> {}
                                .Single(ty) -> stack.push(ty)
                                .Named(fields) -> stack.extend(fields.iter().map(fn(field) { field.ty }))
                            }
                        }
                        .Distinct(base, ..), .Alias(target: base) -> stack.push(base)
                        .UnitFamily(..) -> {}
                    }
                }
            }
            else -> {}
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3510
fn checked_nominal_definition(program: MirProgram, ty: MirType) -> MirTypeDef BootstrapHostCodecError! {
    id :: ty.nominal_id() ?? fail BootstrapHostCodecError.InvalidMetadata("entry type `{ty.canonical_key()}` is not checked nominal")
    if checked_definition_by_id(program, id) == Ok(definition) -> return definition
    if ty.kind() == {
        .Apply(name, ..) -> checked_definition_by_ref(program, name)!
        else -> fail BootstrapHostCodecError.MissingType("`{ty.canonical_key()}` (MIR type ID {id.0})")
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3520
fn checked_definition_by_id(program: MirProgram, id: MirTypeId) -> MirTypeDef BootstrapHostCodecError! {
    program.types.iter().find(fn(definition) { definition.id == id }) ?? fail BootstrapHostCodecError.MissingType("MIR type ID {id.0}")
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3525
fn checked_definition_by_ref(program: MirProgram, name: MirNominalRef) -> MirTypeDef BootstrapHostCodecError! {
    program.types.iter().find(fn(definition) { definition.id == name.id }) ?? fail BootstrapHostCodecError.MissingType("`{name.name}` (MIR type ID {name.id.0})")
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3529
pub fn checked_record_field(program: MirProgram, ty: MirType, value: MirRuntimeValue, id: MirFieldId) -> MirRuntimeValue? Err! {
    definition :: ty.nominal_id().and_then(fn(id) { program.types.iter().find(fn(d) { d.id == id }) }) ?? fail "checked record type is absent"
    fields :: if definition.kind == { .Struct(fields, ..) -> fields; else -> fail "checked type `{definition.name}` is not a record" }
    field :: fields.iter().find(fn(field) { field.id == id }) ?? fail "checked field ID {id.0} is absent"
    (type_name, values) :: if value == { .Struct(type_name, fields: values) -> (type_name, values); else -> fail "result `{definition.name}` is not a record" }
    if type_name != definition.name || values.len() != fields.len() -> fail "result record `{definition.name}` is incomplete or mistyped"
    loop (actual, expected) in values.iter().zip(fields) {
        if actual.0 != expected.name -> fail "result record `{definition.name}` has field order mismatch"
    }
    values.iter().find(fn(row) { row.0 == field.name }).map(fn(row) { row.1 })
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3539
pub fn validate_runtime_value(program: MirProgram, ty: MirType, value: MirRuntimeValue, depth: USize) -> Unit Err! {
    if depth >= MAX_VALUE_DEPTH -> fail "compiler-entry value exceeds checked nesting bound"
    if ty.kind() == {
        .Int, .IntN(..), .Measure(_) -> validate_integer(ty, value)!
        .Float -> if !(value is .Float(f32: false, ..)) -> fail mismatch(ty, "f64")
        .Float32 -> if !(value is .Float(f32: true, ..)) -> fail mismatch(ty, "f32")
        .Bool -> if !(value is .Bool) -> fail mismatch(ty, "Bool")
        .Char -> if !(value is .Char) -> fail mismatch(ty, "Char")
        .String -> if !(value is .String) -> fail mismatch(ty, "String")
        .List(inner) -> validate_sequence(program, ty, inner, value, None, depth)!
        .FixedList(elem, len) -> validate_sequence(program, ty, elem, value, len.literal_value(), depth)!
        .Map(key, value: item_ty) -> {
            entries :: if value == { .Map(entries) -> entries; else -> fail mismatch(ty, "Map") }
            // GATE #4499: exact composite constant-key order/equality.
            seen := BTreeSet<MirConstKey>.new()
            loop (key_value, item) in entries {
                validate_const_key(program, key, key_value, depth + 1)!
                if !seen.insert(key_value) -> fail "compiler-entry map has duplicate keys"
                validate_runtime_value(program, item_ty, item, depth + 1)!
            }
        }
        .Shared(_) -> {
            // GATE #4494: owner-issued native root and exact checked type ID.
            root :: SourceSharedInterop.from_native_owned(value)!
            if root.type_id() != checked_type_id_for_program(program, ty) -> fail mismatch(ty, "exact checked Shared physical root")
        }
        .TraitObject(_), .Fn(_), .SendFn(..) -> if !(value is .NativeOwned) -> fail mismatch(ty, "registered native-owned physical carrier")
        .Option(inner) -> if value == {
            .Present(value) -> validate_runtime_value(program, inner, value, depth + 1)!
            .Absent(element) -> if !element.same_checked_type(inner) -> fail "absent carrier changed its exact checked element type"
            else -> fail mismatch(ty, "Option")
        }
        .Result(ok, err) -> if value == {
            .Present(value) -> validate_runtime_value(program, ok, value, depth + 1)!
            .FailedTold(value) -> validate_runtime_value(program, err, value, depth + 1)!
            else -> fail mismatch(ty, "Result")
        }
        .Apply(name, ..) -> {
            def :: program.types.iter().find(fn(d) { d.id == name.id }) ?? fail "checked type `{name.name}` is absent"
            validate_nominal(program, def, ty, value, depth + 1)!
        }
        .Tuple(fields) -> {
            if fields.is_empty() {
                if value is .Unit -> return
                fail mismatch(ty, "Unit")
            }
            (type_name, values) :: if value == { .Struct(type_name, fields: values) -> (type_name, values); else -> fail mismatch(ty, "Tuple") }
            if type_name != "Tuple" -> fail mismatch(ty, "Tuple")
            declared :: fields.iter().map(fn(row) { (row.0, row.1) }).collect()
            validate_named_values(program, ty, declared, values, depth + 1)!
        }
        .InlineRange(base, lo, hi) -> {
            validate_runtime_value(program, base, value, depth + 1)!
            number :: integer_as_i128(value) ?? fail mismatch(ty, "integer range")
            if number < I128.from(lo) || number > I128.from(hi) -> fail "value is outside checked range `{ty.canonical_key()}`"
        }
        .Tagged(inner, ..), .Quantity(base: inner, ..) -> validate_runtime_value(program, inner, value, depth + 1)!
        .Union(members) -> {
            last := None as String?
            loop member in members {
                validate_runtime_value(program, member, value, depth + 1) catch err { last = Some(err); continue }
                return
            }
            fail (last ?? mismatch(ty, "union member"))
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3584
fn validate_sequence(program: MirProgram, ty: MirType, elem: MirType, value: MirRuntimeValue, expected: U64?, depth: USize) -> Unit Err! {
    count :: if value == {
        .Bytes(bytes) if is_u8_type(elem) -> bytes.len()
        .List(values) -> {
            loop item in values -> validate_runtime_value(program, elem, item, depth + 1)!
            values.len()
        }
        else -> fail mismatch(ty, "sequence")
    }
    // GATE #4483: conversion uses the selected target's usize width.
    if expected == Some(expected) {
        if USize.try_from(expected).ok() != Some(count) -> fail "sequence `{ty.canonical_key()}` has incorrect fixed length"
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3588
fn validate_nominal(program: MirProgram, def: MirTypeDef, ty: MirType, value: MirRuntimeValue, depth: USize) -> Unit Err! {
    if def.kind == {
        .Struct(fields, ..) -> {
            (type_name, values) :: if value == { .Struct(type_name, fields: values) -> (type_name, values); else -> fail mismatch(ty, "record") }
            if type_name != def.name -> fail mismatch(ty, "exact record name")
            declared :: fields.iter().map(fn(field) { (field.name, field.ty) }).collect()
            validate_named_values(program, ty, declared, values, depth + 1)!
        }
        .Enum(variants, ..) -> {
            (type_name, variant_name, args) :: if value == { .Enum(type_name, variant, args) -> (type_name, variant, args); else -> fail mismatch(ty, "enum") }
            if type_name != def.name -> fail mismatch(ty, "exact enum name")
            variant :: variants.iter().find(fn(v) { v.name == variant_name }) ?? fail "unknown checked variant `{variant_name}`"
            expected :: if variant.payload == {
                .Unit -> []
                .Single(ty) -> [(None, ty)]
                .Named(fields) -> fields.iter().map(fn(f) { (Some(f.name), f.ty) }).collect()
            }
            if args.len() != expected.len() -> fail "checked enum payload arity mismatch"
            loop ((name, ty), (actual, value)) in expected.iter().zip(args) {
                if name != actual -> fail "checked enum payload name/order mismatch"
                validate_runtime_value(program, ty, value, depth + 1)!
            }
        }
        .Distinct(base, ..), .Alias(target: base) -> validate_runtime_value(program, base, value, depth + 1)!
        .UnitFamily(members) -> if value == {
            .Enum(type_name, variant, args) if type_name == def.name && members.iter().any(fn(m) { m == variant }) && args.is_empty() -> {}
            else -> fail mismatch(ty, "unit-family variant")
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3597
fn validate_named_values(program: MirProgram, ty: MirType, declared: [(String, MirType)], values: [(String, MirRuntimeValue)], depth: USize) -> Unit Err! {
    if declared.len() != values.len() -> fail "aggregate `{ty.canonical_key()}` has missing/extra fields"
    seen := HashSet<String>.with_capacity(values.len())
    loop ((expected, expected_ty), (actual, value)) in declared.iter().zip(values) {
        if !seen.insert(actual) || actual != expected -> fail "aggregate `{ty.canonical_key()}` field names/order are invalid"
        validate_runtime_value(program, expected_ty, value, depth + 1)!
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3601
fn validate_const_key(program: MirProgram, ty: MirType, key_ty: MirConstKey, depth: USize) -> Unit Err! {
    if depth >= MAX_VALUE_DEPTH -> fail "map key exceeds checked nesting bound"
    if (ty.kind(), key_ty) == {
        (.Int, .Int(_)), (.IntN(..), .Int(_)), (.Measure(_), .Int(_)),
        (.String, .String(_)), (.Bool, .Bool(_)), (.Char, .Char(_)) -> {}
        (.Tuple(types), .Tuple(values)) if types.len() == values.len() -> {
            loop ((name, ty), (actual, key)) in types.iter().zip(values) {
                if name != actual -> fail "tuple map key names do not match checked type"
                validate_const_key(program, ty, key, depth + 1)!
            }
        }
        (.Apply(name, ..), .Struct(type_name, fields)) -> {
            def :: program.types.iter().find(fn(d) { d.id == name.id }) ?? fail "checked map key type is missing"
            declared :: if def.kind == { .Struct(fields: declared, ..) -> declared; else -> fail "map key is not a checked struct" }
            if type_name != def.name || declared.len() != fields.len() -> fail "struct key differs from checked nominal type"
            loop (field, (name, key)) in declared.iter().zip(fields) {
                if field.name != name -> fail "struct key field order/name mismatch"
                validate_const_key(program, field.ty, key, depth + 1)!
            }
        }
        (.Apply(name, ..), .Enum(type_name, variant)) -> {
            def :: program.types.iter().find(fn(d) { d.id == name.id }) ?? fail "checked map key type is missing"
            if type_name != def.name -> fail "enum key name mismatch"
            if def.kind == {
                .Enum(variants, ..) if variants.iter().any(fn(row) { row.name == variant && row.payload is .Unit }) -> {}
                .UnitFamily(members) if members.iter().any(fn(member) { member == variant }) -> {}
                else -> fail "map enum key is not a checked unit variant"
            }
        }
        (.Tagged(inner, ..), _), (.Quantity(base: inner, ..), _) -> validate_const_key(program, inner, key_ty, depth + 1)!
        else -> fail "map key does not match checked type `{ty.canonical_key()}`"
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3612
fn validate_integer(ty: MirType, value: MirRuntimeValue) -> Unit Err! {
    text :: if value == { .Int(v) -> v.to_string(); .BigInt(v) -> v; else -> fail mismatch(ty, "exact integer") }
    exact :: CtBigInt.from_str(text) catch _ { fail "invalid exact integer carrier" }
    if exact.to_string_rep() != text -> fail "integer carrier is not canonical"
    if ty.kind() == .IntN(signed, bits) {
        if bits == 0 -> fail "fixed-width integer has zero bits"
        binary :: exact.abs().to_radix(2) catch e { fail e.to_string() }
        width :: binary.len()
        fits :: if signed {
            if exact.is_zero() -> true
            else if text.starts_with('-') -> width < USize.from(bits.saturating_sub(1)) || (width == USize.from(bits) && binary == "1{"0".repeat(USize.from(bits.saturating_sub(1)))}")
            else -> width <= USize.from(bits.saturating_sub(1))
        } else -> !text.starts_with('-') && width <= USize.from(bits)
        if !fits -> fail "integer is outside checked {if signed -> 'I' else -> 'U'}{bits} range"
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3618
fn integer_as_i128(value: MirRuntimeValue) -> I128? {
    if value == {
        .Int(v) -> Some(I128.from(v))
        .BigInt(v) -> (CtBigInt.from_str(v).ok() ?? return None).try_i128()
        else -> None
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3619
fn mismatch(ty: MirType, expected: String) -> String {
    "runtime value does not match checked `{ty.canonical_key()}` ({expected})"
}
