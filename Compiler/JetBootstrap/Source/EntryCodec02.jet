    let ::jet_foundation::MIR::MirTypeDefKind::Struct {{ fields, .. }} = &definition.kind else {{ return Err(format!("checked entry type `{{}}` is not a struct", definition.name)); }};
    fields.iter().find(|row| row.id == field).map(|row| row.ty.clone()).ok_or_else(|| format!("checked entry field {{:?}} is absent from `{{}}`", field, definition.name))
