        .InlineRange(base, ..), .Tagged(inner: base, ..), .Quantity(base, ..) -> {
            kind :: if ty.kind() == { .InlineRange(..) -> "range"; .Tagged(..) -> "tagged"; else -> "quantity" }
            inner_type :: "__jet_bootstrap_entry_child_type({checked}, \"{kind}\", 0)?"
            child :: from_runtime_expression(program, symbols, base, value, "__jet_inner_type", program_expr, path)!
            "{{ let __jet_inner_type = {inner_type}; {child} }}"
        }
        .Union(members) -> {
            id :: ty.identity ?? fail BootstrapHostCodecError.InvalidMetadata("checked entry union has no nominal identity")
            if members.is_empty() -> fail BootstrapHostCodecError.InvalidMetadata("checked entry union has no members")
            "__jet_bootstrap_entry_type_{id.0}_from_runtime({value}, {checked}, {program_expr}, {path}, physical)?"
        }
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3285
fn to_const_key_expression(program: MirProgram, _symbols: BootstrapCodecSymbols, ty: MirType, source: String, _checked: String, _program_expr: String, _path: String) -> String BootstrapHostCodecError! {
    key :: "::jet_foundation::MIR::MirConstKey"
    if ty.kind() == {
        .Int -> "{key}::Int(({source}).to_i64().ok_or_else(|| \"integer map key exceeds i64\".to_string())?)"
        .IntN(..) -> "{key}::Int(({source}).to_string().parse::<i64>().map_err(|_| \"fixed-width integer map key exceeds i64\".to_string())?)"
        .String -> "{key}::String(({source}).clone())"
        .Bool -> "{key}::Bool(*({source}))"
        .Char -> "{key}::Char(*({source}))"
        .Tagged(inner, ..), .Quantity(base: inner, ..) -> to_const_key_expression(program, _symbols, inner, source, _checked, _program_expr, _path)!
        .Apply(name, ..) -> {
            definition :: checked_definition_by_ref(program, name)!
            if definition.kind == {
                .Enum(variants, ..) if variants.iter().all(fn(variant) { variant.payload is .Unit }) -> {
                    arms := [String]{}
                    loop variant in variants {
                        path :: _symbols.variant_path(definition.name, variant.name)!
                        arms.push("{path} => Ok({key}::Enum {{ type_name: {definition.name:?}.to_string(), variant: {variant.name:?}.to_string() }}),")
                    }
                    "match {source} {{ {arms.join(" ")} }}"
                }
                .UnitFamily(members) -> {
                    arms := [String]{}
                    loop member in members {
                        path :: unit_family_variant_path(_symbols, definition.name, member)!
                        arms.push("{path} => Ok({key}::Enum {{ type_name: {definition.name:?}.to_string(), variant: {member:?}.to_string() }}),")
                    }
                    "match {source} {{ {arms.join(" ")} }}"
                }
                else -> fail BootstrapHostCodecError.InvalidMetadata("entry map key type `{definition.name}` has no checked constant-key ABI")
            }
        }
        else -> fail BootstrapHostCodecError.InvalidMetadata("entry map key type `{ty.canonical_key()}` has no checked constant-key ABI")
    }
}

// Rust: Compiler/Bootstrap/Host/EntryCodec.rs:3331
fn from_const_key_expression(_program: MirProgram, _symbols: BootstrapCodecSymbols, ty: MirType, key: String, _checked: String, _program_expr: String, _path: String) -> String BootstrapHostCodecError! {
    if ty.kind() == {
        .Int -> "match {key} {{ ::jet_foundation::MIR::MirConstKey::Int(value) => jet_foundation::Numeric::JetInt::from_i64(value), _ => return Err(\"map key does not match checked Int\".to_string()) }}"
        .IntN(signed, bits) -> {
            target :: "{if signed -> "i" else -> "u"}{bits}"
            "match {key} {{ ::jet_foundation::MIR::MirConstKey::Int(value) => {target}::try_from(value).map_err(|_| \"map key does not fit checked fixed width\".to_string())?, _ => return Err(\"map key does not match checked fixed width\".to_string()) }}"
        }
        .String -> "match {key} {{ ::jet_foundation::MIR::MirConstKey::String(value) => value, _ => return Err(\"map key does not match checked String\".to_string()) }}"
        .Bool -> "match {key} {{ ::jet_foundation::MIR::MirConstKey::Bool(value) => value, _ => return Err(\"map key does not match checked Bool\".to_string()) }}"
        .Char -> "match {key} {{ ::jet_foundation::MIR::MirConstKey::Char(value) => value, _ => return Err(\"map key does not match checked Char\".to_string()) }}"
        .Tagged(inner, ..), .Quantity(base: inner, ..) -> from_const_key_expression(_program, _symbols, inner, key, _checked, _program_expr, _path)!
        else -> fail BootstrapHostCodecError.InvalidMetadata("entry map key type `{ty.canonical_key()}` has no checked source reconstruction")
    }
}

