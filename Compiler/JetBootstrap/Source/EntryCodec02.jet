fn emit_entry_machine_access_helpers(out: &String, program: MirProgram, symbols: BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    machine_type :: symbols.type_symbol("JetEvalMachine")!
    machine_program_field :: symbols.field_symbol("JetEvalMachine", "program")!
    program_core_owners_field :: symbols.field_symbol("MIRProgram", "core_owners")!
    program_definition :: program.types.iter().find(fn(definition) { definition.name == "MIRProgram" }) ?? fail BootstrapHostCodecError.MissingType("MIRProgram")
    program_fields :: if program_definition.kind == {
        .Struct(fields, ..) -> fields
        else -> fail BootstrapHostCodecError.InvalidMetadata("checked MirProgram is not a struct")
    }
    core_owners_type :: (program_fields.iter().find(fn(field) { field.name == "core_owners" }) ?? fail BootstrapHostCodecError.MissingField(owner: "MIRProgram", field: "core_owners")).ty
    inner :: if core_owners_type.kind() == {
        .List(inner) -> inner
        else -> fail BootstrapHostCodecError.InvalidMetadata("checked MirProgram.core_owners is not a List")
    }
    core_owners_source :: entry_rust_type(program, symbols, core_owners_type)!
    core_owner_definition :: checked_nominal_definition(program, inner)!
    if core_owner_definition.name != "MIRCoreOwner" -> fail BootstrapHostCodecError.InvalidMetadata("checked MirProgram.core_owners does not contain MirCoreOwner rows")
    decoded_rows :: from_runtime_expression(program, symbols, core_owners_type, "(*__jet_core_owner_runtime).clone()", "&__jet_core_owner_rows_type", "compiler_program", "&__jet_core_owner_path")!
    out += "\n" + """
impl crate::compiler_bootstrap_entry_codec::BootstrapEntryMachineCoreOwnerRows for {machine_type} {{
    fn core_owner_rows(&self) -> Result<Vec<::jet_foundation::MIR::MirCoreOwner>, String> {{
        self.{machine_program_field}.{program_core_owners_field}.iter().map(__jet_bootstrap_mir_MIRCoreOwner_to_host).collect()
    }}
}}
