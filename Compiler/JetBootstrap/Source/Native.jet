struct BootstrapBindingDescriptor {
    pub callables: [BootstrapCallableBinding]
    pub types: [BootstrapTypeBinding]
    pub fields: [BootstrapFieldBinding]
    pub variants: [MirRustVariantMetadata]
    pub traits: [MirRustTraitMetadata]
    pub trait_methods: [MirRustTraitMethodMetadata]
}
// Rust: Compiler/Bootstrap/Host/Native.rs:488
struct BootstrapCallableBinding { pub source_name: String, pub metadata: MirRustCallableMetadata }
// Rust: Compiler/Bootstrap/Host/Native.rs:494
struct BootstrapTypeBinding { pub ty: MirTypeId, pub source_name: String, pub symbol: String }
// Rust: Compiler/Bootstrap/Host/Native.rs:501
struct BootstrapFieldBinding { pub field: MirFieldId, pub owner: MirTypeId, pub source_name: String, pub symbol: String, pub ty: MirType }
// Rust: Compiler/Bootstrap/Host/Native.rs:509
impl BootstrapBindingDescriptor {
    // Rust: Compiler/Bootstrap/Host/Native.rs:510
    fn from_aot(program: &MirProgram, metadata: &MirRustAotMetadata) -> BootstrapBindingDescriptor BootstrapHostCodecError! {
        callables: [(String, MirRustCallableMetadata)] = []
        for row in &metadata.callables {
            source_name := program.functions.iter().find(fn(function) -> function.id == row.function).map(fn(function) -> function.name.clone()).ok_or_else(fn() -> BootstrapHostCodecError.InvalidMetadata("Rust metadata callable {row.function:?} is absent from the MIR program"))?
            callables.push((^source_name, row.clone()))
        }
        types: [(MirTypeId, String, String)] = []
        for row in &metadata.types {
            source_name := program.types.iter().find(fn(definition) -> definition.id == row.ty).map(fn(definition) -> definition.name.clone()).ok_or_else(fn() -> BootstrapHostCodecError.InvalidMetadata("Rust metadata type {row.ty:?} is absent from the MIR program"))?
            types.push((row.ty, ^source_name, row.symbol.clone()))
        }
        fields: [(MirFieldId, MirTypeId, String, String, MirType)] = []
        for row in &metadata.fields {
            field := program.fields.iter().find(fn(field) -> field.id == row.field && field.owner == row.owner).ok_or_else(fn() -> BootstrapHostCodecError.InvalidMetadata("Rust metadata field {row.field:?} is absent from the MIR program"))?
            fields.push((row.field, row.owner, field.field.name.clone(), row.symbol.clone(), field.field.ty.clone()))
        }
        BootstrapBindingDescriptor.from_rows(^callables, ^types, ^fields, metadata.variants.clone(), metadata.traits.clone(), metadata.trait_methods.clone())
    }
    // Rust: Compiler/Bootstrap/Host/Native.rs:583
    fn from_rows(callables: [(String, MirRustCallableMetadata)], types: [(MirTypeId, String, String)], fields: [(MirFieldId, MirTypeId, String, String, MirType)], variants: [MirRustVariantMetadata], traits: [MirRustTraitMetadata], trait_methods: [MirRustTraitMethodMetadata]) -> BootstrapBindingDescriptor {
        BootstrapBindingDescriptor(
            callables: callables.into_iter().map(fn((source_name, metadata)) -> BootstrapCallableBinding(source_name: ^source_name, metadata: ^metadata)).collect(),
            types: types.into_iter().map(fn((ty, source_name, symbol)) -> BootstrapTypeBinding(ty: ty, source_name: ^source_name, symbol: ^symbol)).collect(),
            fields: fields.into_iter().map(fn((field, owner, source_name, symbol, ty)) -> BootstrapFieldBinding(field: field, owner: owner, source_name: ^source_name, symbol: ^symbol, ty: ^ty)).collect(),
            variants: ^variants, traits: ^traits, trait_methods: ^trait_methods)
    }
}
