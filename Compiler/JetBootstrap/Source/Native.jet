// Native half of the private source-coupled compiler bootstrap.
// Owns the filesystem authority lease, ambient native Prelude scope and
// source-coupled carrier codec; never invokes the Rust front end as a fallback.
use jet_driver.Authority.[AuthorityError, AuthorityKind, AuthorityResolver, CheckedFile, CheckedDirectory, FileIdentity]
