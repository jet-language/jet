//RS     types: BTreeMap<&'a str, &'a str>,
//RS     // First row per key, matching the linear-scan meaning these replace: the
//RS     // host glue walks the whole compiler type graph once per root, so each
//RS     // field and variant lookup must not rescan every row.
//RS     definitions: HashMap<&'a str, MirTypeId>,
//RS     fields: HashMap<(MirTypeId, &'a str), &'a BootstrapFieldBinding>,
//RS     // Enum variants with named payloads may repeat a field name across
//RS     // variants, so their payload fields resolve by checked field identity.
//RS     field_ids: HashMap<(MirTypeId, MirFieldId), &'a BootstrapFieldBinding>,
//RS     variants: HashMap<(MirTypeId, &'a str), &'a str>,
//RS     // Failed symbol lookups. A miss yields `MISSING_SYMBOL` so packaging keeps
//RS     // going and `finish` reports every miss of one run, not just the first.
//RS     missed: RefCell<Vec<BootstrapHostCodecError>>,
//RS }
