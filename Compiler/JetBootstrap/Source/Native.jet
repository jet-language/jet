}
// Rust: Compiler/Bootstrap/Host/Native.rs:65
// Retain checked handles until the generated callable returns: bytes cannot
// become detached from the objects checked before the call.
struct AuthorizedSourceLease {
    roots: [AuthorizedSourceRootLease]
    snapshot: AuthorizedSourceSnapshot
}
// Rust: Compiler/Bootstrap/Host/Native.rs:69
impl AuthorizedSourceLease {
    // Rust: Compiler/Bootstrap/Host/Native.rs:70
    fn snapshot(self: &AuthorizedSourceLease) -> &AuthorizedSourceSnapshot { &self.snapshot }
    // Rust: Compiler/Bootstrap/Host/Native.rs:76
    fn revalidate(self: &AuthorizedSourceLease) -> Unit AuthorityError! {
        for root in &self.roots {
            root.resolver.revalidate_directory(&root.root)?
            root.resolver.revalidate_file(&root.manifest)?
            for file in &root.files { root.resolver.revalidate_file(file)? }
            for file in &root.foreign_cache_files { root.resolver.revalidate_file(file)? }
            root.resolver.revalidate_root()?
        }
    }
}
// Rust: Compiler/Bootstrap/Host/Native.rs:91
struct AuthorizedRootRecord { lease: AuthorizedSourceRootLease, snapshot: AuthorizedSourceRoot }

// Rust: Compiler/Bootstrap/Host/Native.rs:99
fn open_authorized_sources(root: &OSPath, entry: &OSPath) -> AuthorizedSourceLease AuthorityError! {
    open_authorized_source_candidates([root], 0, entry)
}
// Rust: Compiler/Bootstrap/Host/Native.rs:106
fn open_authorized_source_candidates(roots: [&OSPath], entry_root_index: USize, entry: &OSPath) -> AuthorizedSourceLease AuthorityError! {
    if roots.is_empty() {
        throw AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the native source snapshot has no candidate authority roots")
    }
    if entry_root_index >= roots.len() {
        throw AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the selected entry root is outside the candidate authority roots")
    }
    records: [AuthorizedRootRecord] = []
    entry_root_identity: String? = None
    entry_path: String? = None
    for (root_index, root_path) in roots.iter().enumerate() {
        // GATE #4494: descriptor-relative retained authority handles.
        resolver := AuthorityResolver.open(root_path)?
        root_directory := resolver.checked_directory(OSPath.new("."))?
        // Check both canonical package.jet and retired jet.toml marker.
        manifest := resolver.checked_manifest(OSPath.new("."))?.file
        files := resolver.discover_source_files()?
        checked_entry := if root_index == entry_root_index -> Val(resolver.checked_file(entry)?) else -> None
        entry_file: OSPath? = None
        if checked_entry == Val(checked) {
            file := files.iter().find(fn(file) -> file.relative == checked.relative).ok_or_else(fn() -> AuthorityError.Invalid(path: checked.path.clone(), detail: "the selected entry is not present in the complete authorized source walk"))?
            if file.identity != checked.identity || file.bytes != checked.bytes { throw AuthorityError.Changed(checked.path.clone()) }
            entry_file = Val(file.relative.clone())
        }
        if !files.iter().any(fn(file) -> file.relative == manifest.relative) {
            files.push(manifest.clone())
            files.sort_by(fn(left, right) -> left.relative.cmp(&right.relative))
        }
        foreign_cache_files := collect_authorized_foreign_cache_files(&resolver, &files)?
        authorized_files: [AuthorizedSourceFile] = []
        for file in &files {
            resolver.revalidate_file(file)?
            authorized_files.push(authorized_source_file(file)?)
        }
        authorized_foreign_cache_files: [AuthorizedSourceFile] = []
        for file in &foreign_cache_files {
            resolver.revalidate_file(file)?
            authorized_foreign_cache_files.push(authorized_source_file(file)?)
        }
        resolver.revalidate_file(&manifest)?
        resolver.revalidate_root()?
        root_identity := identity_key(&root_directory.identity)
        canonical_path := root_directory.path.display().to_string()
        if root_index == entry_root_index {
            relative := entry_file.ok_or_else(fn() -> AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the selected entry root did not produce an entry file"))?
            selected := authorized_files.iter().find(fn(file) -> file.relative_path == relative_text(&relative)).ok_or_else(fn() -> AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the selected entry was lost while building the authorized snapshot"))?
            entry_root_identity = Val(root_identity.clone())
            entry_path = Val(selected.path.clone())
        }
        records.push(AuthorizedRootRecord(
            lease: AuthorizedSourceRootLease(resolver: ^resolver, root: ^root_directory, manifest: ^manifest, files: ^files, foreign_cache_files: ^foreign_cache_files),
            snapshot: AuthorizedSourceRoot(canonical_path: ^canonical_path, identity: ^root_identity, allow_hardlinks: false, files: ^authorized_files, foreign_cache_files: ^authorized_foreign_cache_files)))
    }
    records.sort_by(fn(left, right) -> left.snapshot.canonical_path.cmp(&right.snapshot.canonical_path))
    for pair in records.windows(2) {
        if pair[0].snapshot.canonical_path == pair[1].snapshot.canonical_path {
            throw AuthorityError.Invalid(path: OSPath.new(pair[1].snapshot.canonical_path).to_path_buf(), detail: "candidate authority roots must be physically distinct")
        }
    }
    snapshot := AuthorizedSourceSnapshot(
        roots: records.iter().map(fn(record) -> record.snapshot.clone()).collect(),
        entry_root_identity: entry_root_identity.ok_or_else(fn() -> AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the selected entry root was not recorded"))?,
        entry_path: entry_path.ok_or_else(fn() -> AuthorityError.Invalid(path: entry.to_path_buf(), detail: "the selected entry path was not recorded"))?)
    leases := records.into_iter().map(fn(record) -> ^record.lease).collect()
    AuthorizedSourceLease(roots: ^leases, snapshot: ^snapshot)
}
// Rust: Compiler/Bootstrap/Host/Native.rs:247
fn authorized_source_file(file: &CheckedFile) -> AuthorizedSourceFile AuthorityError! {
    AuthorizedSourceFile(path: file.path.display().to_string(), relative_path: relative_text(&file.relative), identity: identity_key(&file.identity), source: file.text()?)
}
// Rust: Compiler/Bootstrap/Host/Native.rs:255
fn append_authorized_foreign_cache_file(foreign_cache_files: &[CheckedFile], file: CheckedFile, total_files: &USize, total_bytes: &U64) -> Unit AuthorityError! {
    next_file_count := total_files.saturating_add(1)
    next_byte_count := total_bytes.saturating_add(file.bytes.len() as U64)
    if next_file_count > MAX_TREE_FILES || next_byte_count > MAX_TREE_TOTAL_BYTES {
        throw AuthorityError.Invalid(path: file.path.clone(), detail: "authorized source and foreign cache snapshot exceeds the authority tree read bounds")
    }
    total_files.* = next_file_count
    total_bytes.* = next_byte_count
    foreign_cache_files.push(^file)
}
// Rust: Compiler/Bootstrap/Host/Native.rs:278
fn collect_authorized_foreign_cache_files(resolver: &AuthorityResolver, source_files: &[CheckedFile]) -> [CheckedFile] AuthorityError! {
    foreign_cache_files: [CheckedFile] = []
    total_files := source_files.len()
    total_bytes := source_files.iter().fold(0 as U64, fn(total, file) -> total.saturating_add(file.bytes.len() as U64))
    for cache_directory in [OSPath.new(".jet/bindings/c"), OSPath.new(".jet/bindings/cpp")] {
        cache_files := resolver.discover_files(cache_directory, Val("jet")) catch {
            error -> { if error.is_missing() { continue }; throw error }
        }
        for cache in cache_files {
            if cache.relative.file_name().and_then(fn(name) -> name.to_str()).is_some_and(fn(name) -> name.ends_with(".adapted.jet")) { continue }
            for extension in ["metadata", "provenance"] {
                sidecar := cache.relative.with_extension(extension)
                file := resolver.checked_file(&sidecar) catch {
                    error -> { if error.is_missing() { continue }; throw error }
                }
                append_authorized_foreign_cache_file(&foreign_cache_files, ^file, &total_files, &total_bytes)?
            }
            append_authorized_foreign_cache_file(&foreign_cache_files, ^cache, &total_files, &total_bytes)?
        }
    }
    foreign_cache_files.sort_by(fn(left, right) -> left.relative.cmp(&right.relative))
    ^foreign_cache_files
}
// Rust: Compiler/Bootstrap/Host/Native.rs:330
fn relative_text(path: &OSPath) -> String {
    // GATE #4494: native path display and separator use selected platform facts.
    text := path.to_string_lossy().replace(std.path.MAIN_SEPARATOR, "/")
    if text.is_empty() -> "." else -> ^text
}
// Rust: Compiler/Bootstrap/Host/Native.rs:339
fn identity_key(identity: &FileIdentity) -> String {
    kind := if identity.kind == { .File -> "file", .Directory -> "directory" }
    modified := identity.modified_ns.map_or_else(fn() -> "none", fn(value) -> value.to_string())
    device := identity.device.map_or_else(fn() -> "none", fn(value) -> value.to_string())
    inode := identity.inode.map_or_else(fn() -> "none", fn(value) -> value.to_string())
    "authority-file-v1;kind={kind};length={identity.length};modified_ns={modified};device={device};inode={inode}"
}
// Rust: Compiler/Bootstrap/Host/Native.rs:362
fn with_native_prelude<R>(body: FnOnce() -> R) -> R {
    // GATE #4494: canonical ambient native scope, not a duplicate route table.
    jet_comptime.with_ambient_mir_prelude(Val(jet_codegen.NativePreludeBridge.ambient_call), ^body)
}
// Rust: Compiler/Bootstrap/Host/Native.rs:372
fn invoke_with_authority<R>(lease: &AuthorizedSourceLease, invoke: FnOnce(&AuthorizedSourceSnapshot) -> R) -> R AuthorityError! {
    lease.revalidate()?
    with_native_prelude(fn() -> invoke(lease.snapshot()))
}
// Rust: Compiler/Bootstrap/Host/Native.rs:385
// Machine record failures are misses, including unknown schemas and rejected publishes.
struct BootstrapRecordStore { store: Store }
// Rust: Compiler/Bootstrap/Host/Native.rs:389
impl BootstrapRecordStore {
    // Rust: Compiler/Bootstrap/Host/Native.rs:392
    fn from_env() -> BootstrapRecordStore? { Store.from_env().ok().map(fn(store) -> BootstrapRecordStore(store: ^store)) }
    // Rust: Compiler/Bootstrap/Host/Native.rs:396
    fn record(self: &BootstrapRecordStore, schema: String, key: String) -> [U8]? {
        kind := RecordKind.from_schema(schema)?
        self.store.record(kind, key).ok().flatten()
    }
    // Rust: Compiler/Bootstrap/Host/Native.rs:401
    fn put_record(self: &BootstrapRecordStore, schema: String, key: String, bytes: &[U8]) -> Bool {
        RecordKind.from_schema(schema).is_some_and(fn(kind) -> self.store.put_record(kind, key, bytes).is_ok())
    }
    // Rust: Compiler/Bootstrap/Host/Native.rs:408
    fn stamp(self: &BootstrapRecordStore, path: String) -> String? { jet_store.project_state.file_stamp(OSPath.new(path)) }
}
// Rust: Compiler/Bootstrap/Host/Native.rs:417
#Error
enum BootstrapHostCodecError {
    MissingType(String)
    MissingField(owner: String, field: String)
    MissingVariant(owner: String, variant: String)
    MissingEntry(String)
    InvalidMetadata(String)
    ResourceRetirement(cause: Box<BootstrapHostCodecError>, retirement: SourceResourceRetireError)
    Multiple([BootstrapHostCodecError])
}
// Rust: Compiler/Bootstrap/Host/Native.rs:432
impl BootstrapHostCodecError {
    // Rust: Compiler/Bootstrap/Host/Native.rs:434
    fn combine(errors: [BootstrapHostCodecError]) -> BootstrapHostCodecError {
        if errors.len() == 1 { if errors.pop() == Val(error) { return ^error } }
        BootstrapHostCodecError.Multiple(^errors)
    }
}
// Rust: Compiler/Bootstrap/Host/Native.rs:444
impl fmt.Display for BootstrapHostCodecError {
    // Rust: Compiler/Bootstrap/Host/Native.rs:445
    fn fmt(self: &BootstrapHostCodecError, formatter: &fmt.Formatter) -> Unit fmt.Error! {
        if self == {
            .MissingType(name) -> formatter.write_str("bootstrap codec type `{name}` is not emitted")
            .MissingField(owner, field) -> formatter.write_str("bootstrap codec field `{owner}.{field}` is not emitted")
            .MissingVariant(owner, variant) -> formatter.write_str("bootstrap codec variant `{owner}::{variant}` is not emitted")
            .MissingEntry(name) -> formatter.write_str("bootstrap codec entry `{name}` is not emitted")
            .InvalidMetadata(detail) -> formatter.write_str("invalid bootstrap codec metadata: {detail}")
            .ResourceRetirement(cause, retirement) -> formatter.write_str("{cause}; Source resource retirement failed: {retirement.error}")
            .Multiple(errors) -> {
                formatter.write_str("{errors.len()} bootstrap packaging errors:")?
                for error in errors { formatter.write_str("\n  - {error}")? }
            }
        }
    }
}
