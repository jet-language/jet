use JetBootstrap.NativeAdapter.emit_bootstrap_native_adapter_impl
use JetBootstrap.DiagnosticCodec.append_diagnostic_codec
use JetBootstrap.RuntimeMirCodec.append_runtime_mir_codec
use JetBootstrap.EntryCodec.append_bootstrap_entry_codec
