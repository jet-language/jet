    // Rust: Compiler/Bootstrap/Host/Native.rs:832
    fn named_payload<T: Copy>(self: &BootstrapCodecSymbols, owner: String, variant: String, definition: &MirTypeDef, declared: &[MirField], listed: &[(String, T)]) -> [(String, Bool, T)] BootstrapHostCodecError! {
        mismatch := fn() -> BootstrapHostCodecError.InvalidMetadata("host glue lists payload [{listed.iter().map(fn((name, _)) -> name).collect<[String]>().join(", ")}] for `{owner}::{variant}`, the checked payload is [{declared.iter().map(fn(field) -> field.name).collect<[String]>().join(", ")}]")
        if listed.len() != declared.len() { throw mismatch() }
