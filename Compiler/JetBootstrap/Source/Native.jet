    // Rust: Compiler/Bootstrap/Host/Native.rs:806
    fn variant_payload(self: &BootstrapCodecSymbols, owner: String, variant: String) -> (String, &MirTypeDef, &MirVariantPayload) BootstrapHostCodecError! {
