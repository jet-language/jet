        if ch == {
            '"' -> { in_string = true }
            '{' | '(' | '[' -> { depth += 1 }
            '}' | ')' | ']' -> { depth -= 1; if depth == 0 { return Val((open, trimmed[1..index], text[offset + index + 1..])) } }
