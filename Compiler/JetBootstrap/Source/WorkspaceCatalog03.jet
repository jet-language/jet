// Fragment of the canonical WorkspaceCatalog owner.
use jet_foundation.RustSource.[rust_code_mask]
// GATE #4494: filesystem and process operations use the native std substrate.
use std.[fs, Command, Output, env]

// Rust: Compiler/Bootstrap/Tests.rs:3415
fn movable_function(item: String, code: String) -> MovedFunction? Never! {
    lead :: code.len() - code.trim_start().len()
    head :: item_head(code)
    if !movable_attributes(code[lead..<head]) || !code.ends_with("}") -> return None
    rest := code[head..<code.len()]
    rest = rest.strip_prefix("pub ") ?? rest
    unsafe_function :: rest.starts_with("unsafe ")
    rest = rest.strip_prefix("unsafe ") ?? rest
    rest = rest.strip_prefix("fn ") ?? return None
    name_end :: rest.find(|character| !(character.is_ascii_alphanumeric() || character == '_')) ?? return None
    name :: rest[0..<name_end]
    if !name.starts_with("__jet_") || !rest[name_end..<rest.len()].starts_with("(") -> return None
    open :: code.len() - rest.len() + name_end
    close :: matching_bracket(code, open)
    body :: close + (code[close..<code.len()].find('{') ?? return None)
    if code[open..<body].contains("impl ") || code[close..<body].contains("where") -> return None
    parameters := [String]{}
    loop (relative_start, relative_end) in split_top_level(code[open + 1..<close], U8{44}) {
        start :: open + 1 + relative_start
        end :: open + 1 + relative_end
        if code[start..<end].trim().is_empty() -> continue
        colon :: start + (parameter_colon(code[start..<end]) ?? return None)
        parameter_type := item[colon + 1..<end].trim() // #4303
        &parameters.push("_: {parameter_type}")
    }
    // A bare rows is a cached table's fill vector, unlike emitted __jet_* locals.
    body_code := code[body + 1..<code.len()].trim_start() // #4303
    table :: (parameters.is_empty() && body_code.starts_with("vec![")) || body_code.starts_with("rows.push(")
    safety :: if unsafe_function -> "unsafe" else -> "safe"
    signature := item[close + 1..<body].trim() // #4303
    joined :: parameters.join(", ")
    definition :: item[lead..<item.len()]
    Val(MovedFunction{declaration: "    pub {safety} fn {name}({joined}) {signature};\n", definition: "\n#[no_mangle]\n{definition}", cold: table || code.len() >= BACKEND_COLD_FUNCTION_BYTES})
}

// Rust: Compiler/Bootstrap/Tests.rs:3464
// Move large methods of an inherent/trait impl of a plain named type.
fn delegate_impl_methods(item: String, code: String) -> (String, [MovedFunction])? Never! {
    head :: item_head(code)
    if !code[head..<code.len()].starts_with("impl ") || !code.ends_with("}") -> return None
    brace :: head + (code[head..<code.len()].find('{') ?? return None)
    header := code[head + 5..<brace].trim() // #4303
    (trait_path, type_text) :: header.split_once(" for ") ?? ("inherent", header)
    self_type := type_text.trim() // #4303
    if !is_identifier(self_type) -> return None
    trait_tag := String{}
    loop character in trait_path.trim().chars() {
        &trait_tag.push(if character.is_ascii_alphanumeric() -> character else -> '_')
    }
    prefix :: "__jet_impl_{self_type}_{trait_tag}_"
    cold_trait :: BACKEND_COLD_TRAITS.contains(trait_path.trim())
    close :: code.len() - 1
    (methods, tail) :: masked_items(code[brace + 1..<close])
    rewritten := item[0..<brace + 1].to_string()
    moved := [MovedFunction]{}
    loop (relative_start, relative_end) in methods {
        start :: brace + 1 + relative_start
        end :: brace + 1 + relative_end
        match delegated_method(item[start..<end], code[start..<end], self_type, prefix) {
            Val((method, function)) => {
                &rewritten.push_str(method)
                function.cold = function.cold || cold_trait
                &moved.push(^function)
            }
            None => &rewritten.push_str(item[start..<end])
        }
    }
    if moved.is_empty() -> return None
    &rewritten.push_str(item[brace + 1 + tail..<item.len()])
    Val((^rewritten, ^moved))
}

// Rust: Compiler/Bootstrap/Tests.rs:3508
fn delegated_method(method: String, code: String, self_type: String, prefix: String) -> (String, MovedFunction)? Never! {
    // Nested impls and module-relative paths cannot survive the move unchanged.
    if code.len() < BACKEND_DELEGATE_METHOD_BYTES || code.contains("impl ") || code.contains("self::") -> return None
    lead :: code.len() - code.trim_start().len()
    head :: item_head(code)
    if !movable_attributes(code[lead..<head]) -> return None
    rest := code[head..<code.len()]
    rest = rest.strip_prefix("pub ") ?? rest
    unsafe_method :: rest.starts_with("unsafe ")
    rest = rest.strip_prefix("unsafe ") ?? rest
    rest = rest.strip_prefix("fn ") ?? return None
    name_end :: rest.find(|character| !(character.is_ascii_alphanumeric() || character == '_')) ?? return None
    name :: rest[0..<name_end]
    if !rest[name_end..<rest.len()].starts_with("(") -> return None
    open :: code.len() - rest.len() + name_end
    close :: matching_bracket(code, open)
    body :: close + (code[close..<code.len()].find('{') ?? return None)
    // Receiver lifetime resolution changes when it becomes an ordinary argument.
    if code[0..<body].contains('\'') || code[close..<body].contains('&') || code[close..<body].contains("where") -> return None
    parameters := [String]{}
    arguments := [String]{}
    loop (relative_start, relative_end) in split_top_level(code[open + 1..<close], U8{44}) {
        start :: open + 1 + relative_start
        end :: open + 1 + relative_end
        parameter := code[start..<end].trim() // #4303
        if parameter.is_empty() -> continue
        receiver :: match parameter {
            "&self" => Val("__jet_self: &{self_type}")
            "&mut self" => Val("__jet_self: &mut {self_type}")
            "self" => Val("__jet_self: {self_type}")
            "mut self" => Val("mut __jet_self: {self_type}")
            _ => None
        }
        if receiver == .Val(value) {
            &parameters.push(value)
            &arguments.push("self")
            continue
        }
        colon :: parameter_colon(parameter) ?? return None
        pattern := parameter[0..<colon].trim() // #4303
        binding_text :: pattern.strip_prefix("mut ") ?? pattern
        binding := binding_text.trim() // #4303
        if !is_identifier(binding) || binding == "_" || binding == "self" -> return None
        &parameters.push(method[start..<end].trim().to_string())
        &arguments.push(binding.to_string())
    }
    function_name :: "{prefix}{name}"
    safety :: if unsafe_method -> "unsafe " else -> ""
    joined :: parameters.join(", ")
    signature := method[close + 1..<body].trim() // #4303
    method_body :: method[body..<method.len()]
    function :: replace_self_tokens("pub {safety}fn {function_name}({joined}) {signature} {method_body}", self_type)
    moved :: movable_function(function, rust_code_mask(function)) ?? return None
    call_arguments :: arguments.join(", ")
    header :: method[0..<body]
    Val(("{header}{{ {function_name}({call_arguments}) }}", ^moved))
}

// Rust: Compiler/Bootstrap/Tests.rs:3586
fn replace_self_tokens(text: String, self_type: String) -> String Never! {
    code :: rust_code_mask(text)
    bytes :: code.bytes()
    identifier :: |byte: U8| byte.is_ascii_alphanumeric() || byte == U8{95}
    out := String.with_capacity(text.len())
    copied := 0
    at := 0
    loop at + 4 <= bytes.len() {
        token :: bytes[at..<at + 4]
        if (token == "self".bytes() || token == "Self".bytes()) && (at == 0 || !identifier(bytes[at - 1])) && (at + 4 == bytes.len() || !identifier(bytes[at + 4])) {
            &out.push_str(text[copied..<at])
            &out.push_str(if token == "self".bytes() -> "__jet_self" else -> self_type)
            copied = at + 4
            at += 4
        } else -> at += 1
    }
    &out.push_str(text[copied..<text.len()])
    out
}

// Rust: Compiler/Bootstrap/Tests.rs:3818
fn generated_compiler_image(output: OSPath) -> [U8] Never! {
    path :: output.with_extension("image")
    fs.read(path) ?? panic("generated compiler did not write its image `{path.display()}`: {err}")
}

// Rust: Compiler/Bootstrap/Tests.rs:3825
fn build_backend_artifact(repo: OSPath, project: OSPath, package_name: String, source: String) -> (OSPath, String) Never! {
    build_backend_artifact_with_native_library(repo, project, package_name, source, None, None, None)
}

// Rust: Compiler/Bootstrap/Tests.rs:3839
fn write_backend_project(repo: OSPath, project: OSPath, package_name: String, source: String, compiler_image: [U8]?, native_library: (OSPath, String)?, ffi: BackendFfiCrate?) -> OSPath Never! {
    source_dir :: project.join("src")
    fs.create_dir_all(source_dir) ?? panic("cannot create backend project `{project.display()}`: {err}")
    source_path :: source_dir.join("main.rs")
    manifest_path :: project.join("Cargo.toml")
    build_script_path :: project.join("build.rs")
    profile :: backend_release_profile()
    // Identity hashes complete generated text; the split units are pure functions of it.
    generated_path :: project.join("generated.rs")
    fs.write(generated_path, source) ?? panic("cannot write backend source `{generated_path.display()}`: {err}")
    main_source := source.to_string()
    unit_dependencies := String{}
    unit_profiles := String{}
    if split_backend_workspace(source) == .Val(workspace) {
        units_root :: home_path().join(BOOTSTRAP_UNITS_RELATIVE).join(package_name)
        unit_dependencies = write_backend_workspace(units_root, workspace, ffi)
        unit_profiles = backend_unit_profiles(workspace, profile)
        main_source = ^workspace.main
    }
    ffi_dependency :: match ffi { Val(value) => value.dependency(); None => String{} }
    fs.write(source_path, main_source) ?? panic("cannot write backend source `{source_path.display()}`: {err}")
    image_path :: source_dir.join("compiler.image")
    match compiler_image {
        Val(image) => fs.write(image_path, image) ?? panic("cannot write backend compiler image `{image_path.display()}`: {err}")
        None => {
            // GATE #4409: ignore only native NotFound; preserve all other error kinds.
            fs.remove_file(image_path) ?? {
                if err.kind() != .NotFound -> panic("cannot remove stale backend compiler image `{image_path.display()}`: {err}")
            }
        }
    }
    manifest := "[package]\nname = {package_name:?}\nversion = \"0.0.0\"\nedition = \"2021\"\nbuild = \"build.rs\"\n\n[dependencies]\n"
    &manifest.push_str("jet = {{ path = {repo.display().to_string():?} }}\n")
    loop (name, relative) in [("jet-codegen", "crates/jet-codegen"), ("jet-driver", "crates/jet-driver"), ("jet-foundation", "crates/jet-foundation"), ("jet-jit", "crates/jet-jit"), ("jet-net", "crates/jet-net"), ("jet-pkg-model", "crates/jet-pkg-model"), ("jet-rt", "crates/jet-rt"), ("jet-store", "crates/jet-store")] {
        path :: repo.join(relative).display().to_string()
        &manifest.push_str("{name} = {{ path = {path:?} }}\n")
    }
    patch :: repo.join("crates/vendor/cranelift-jit-0.112.3").display().to_string()
    build_profile :: if profile.is_some() -> BACKEND_RELEASE_PROFILE else -> BACKEND_DEV_HOST_PROFILE
    &manifest.push_str("{ffi_dependency}{unit_dependencies}\n[patch.crates-io]\ncranelift-jit = {{ path = {patch:?} }}\n{unit_profiles}{build_profile}")
    fs.copy(repo.join("Cargo.lock"), project.join("Cargo.lock")) ?? panic("cannot seed backend lockfile in `{project.display()}`: {err}")
    fs.write(manifest_path, manifest) ?? panic("cannot write backend manifest `{manifest_path.display()}`: {err}")
    fs.write(build_script_path, backend_identity_build_script(repo, native_library)) ?? panic("cannot write backend identity build script `{build_script_path.display()}`: {err}")
    manifest_path
}

// Rust: Compiler/Bootstrap/Tests.rs:3936
fn build_backend_artifact_with_native_library(repo: OSPath, project: OSPath, package_name: String, source: String, compiler_image: [U8]?, native_library: (OSPath, String)?, ffi: BackendFfiCrate?) -> (OSPath, String) Never! {
    manifest_path :: write_backend_project(repo, project, package_name, source, compiler_image, native_library, ffi)
    target :: repo.join("target")
    profile :: backend_release_profile()
    // GATE #4494: native child process invocation, environment and captured output.
    command := Command.new(repo.join("Tools/agent/jet-env"))
    &command.current_dir(repo)
    &command.env("CARGO_TARGET_DIR", target)
    &command.env("JET_CARGO_INCREMENTAL", if profile.is_some() -> "0" else -> "1")
    &command.env("CARGO_BUILD_JOBS", if profile.is_some() -> BACKEND_RELEASE_BUILD_JOBS else -> BACKEND_BUILD_JOBS)
    &command.env("RUST_MIN_STACK", BACKEND_RUSTC_STACK)
    &command.env("JET_NO_SCCACHE", "1")
    &command.env_remove("RUSTC_WRAPPER")
    manifest_text :: manifest_path.to_str() ?? panic("backend manifest path is not valid UTF-8: {manifest_path.display()}")
    &command.args(["cargo", "build", "--manifest-path", manifest_text, "--bin", package_name])
    if profile == .Val(name) {
        flags :: env.var("RUSTFLAGS") ?? ""
        &command.args(["--profile", name])
        flag_text := "{flags} -C force-frame-pointers=yes".trim_start() // #4303
        &command.env("RUSTFLAGS", flag_text.to_string())
    }
    output :: &command.output() ?? panic("cannot invoke the permitted Rust backend: {err}")
    assert_command_success("Rust backend for `{package_name}` (compiler ICE/101 on rejection)", output)
    binary :: target.join(profile ?? "debug").join(package_name)
    assert(binary.is_file(), "permitted Rust backend reported success without producing `{binary.display()}`")
    identity_path :: project.join(".bootstrap-artifact-id")
    identity_text :: fs.read_to_string(identity_path) ?? panic("backend build did not produce canonical identity receipt `{identity_path.display()}`: {err}")
    identity := identity_text.trim() // #4303
    assert(!identity.is_empty(), "backend identity receipt `{identity_path.display()}` is empty")
    (binary, identity.to_string())
}

// Rust: Compiler/Bootstrap/Tests.rs:4012
fn run_generated_artifact(binary: OSPath, mode: String, source_root: OSPath, entry: String, output_path: OSPath, receipt_path: OSPath) Never! {
    // GATE #4494: actual native execution with the original bootstrap environment.
    command := Command.new(binary)
    &command.env("JET_BOOTSTRAP_MODE", mode)
    &command.env("JET_BOOTSTRAP_SOURCE_ROOT", source_root)
    &command.env("JET_BOOTSTRAP_ENTRY", entry)
    &command.env("JET_BOOTSTRAP_OUTPUT", output_path)
    &command.env("JET_BOOTSTRAP_RECEIPT", receipt_path)
    result :: &command.output() ?? panic("cannot execute generated Jet {mode} artifact `{binary.display()}`: {err}")
    assert_command_success("generated Jet {mode} artifact `{binary.display()}`", result)
    assert(receipt_path.is_file(), "generated Jet {mode} artifact did not produce receipt `{receipt_path.display()}`")
}

// Rust: Compiler/Bootstrap/Tests.rs:4044
fn assert_aot_provenance(receipt: String) Never! {
    assert(receipt.lines().any(|line| line == "selected_factory_tier=Aot"), "factory receipt selected a tier other than Aot")
    assert(receipt.lines().any(|line| line == "actual_factory_tier=Aot"), "factory receipt ran a tier other than Aot")
}

// Rust: Compiler/Bootstrap/Tests.rs:4055
fn assert_factory_receipt(path: OSPath) Never! {
    receipt :: fs.read_to_string(path) ?? panic("cannot read factory receipt `{path.display()}`: {err}")
    assert(receipt.lines().any(|line| line == "mode=factory"))
    assert(receipt.lines().any(|line| line == "complete=true"))
    assert_aot_provenance(receipt)
    assert_receipt_count_at_least(receipt, "source_bytes", 1)
    assert_receipt_count_at_least(receipt, "callables", 1)
}

// Rust: Compiler/Bootstrap/Tests.rs:4065
fn assert_runner_receipt(path: OSPath) Never! {
    receipt :: fs.read_to_string(path) ?? panic("cannot read Runner receipt `{path.display()}`: {err}")
    assert(receipt.lines().any(|line| line == "mode=runner"))
    assert(receipt.lines().any(|line| line == "complete=true"))
    assert_aot_provenance(receipt)
    assert_receipt_count_at_least(receipt, "source_bytes", 1)
}

// Rust: Compiler/Bootstrap/Tests.rs:4074
fn assert_task_roots_receipt(output_path: OSPath, receipt_path: OSPath) Never! {
    output :: fs.read_to_string(output_path) ?? panic("cannot read task-root fixture output `{output_path.display()}`: {err}")
    assert_eq(output, "task-roots=passed\n")
    receipt :: fs.read_to_string(receipt_path) ?? panic("cannot read task-root fixture receipt `{receipt_path.display()}`: {err}")
    assert_eq(receipt, "mode=task-roots\nstatus=passed\nselected_factory_tier=Aot\nactual_factory_tier=Aot\ncallback_capture_params=1\ncallback_escapes=true\ncallback_moves=0\ncursor_close_count=1\nshared_producer_machine_retired=true\nshared_parent_retirement_requested=true\nshared_parent_retirement_deferred=true\nshared_consumer_completed=true\nshared_payload_finalizer_completed=true\nretained_roots=0\n")
}

// Rust: Compiler/Bootstrap/Tests.rs:4095
fn assert_optional_codec_roundtrip(binary: OSPath, project: OSPath, session: OSPath, stage: String) Never! {
    output :: session.join("{stage}-optional-roundtrip.txt")
    receipt :: session.join("{stage}-optional-roundtrip.receipt")
    run_generated_artifact(binary, "optional-roundtrip", project, SMALL_ENTRY_RELATIVE, output, receipt)
    receipt_text :: fs.read_to_string(receipt) ?? panic("cannot read {stage} optional codec receipt: {err}")
    assert(receipt_text.lines().any(|line| line == "mode=optional-roundtrip"))
    assert(receipt_text.lines().any(|line| line == "identity_absent=roundtrip"))
    assert(receipt_text.lines().any(|line| line == "identity_present=roundtrip"))
    actual :: fs.read_to_string(output) ?? panic("cannot read {stage} optional codec output: {err}")
    assert_eq(actual, "identity=absent,present\n")
}

// Rust: Compiler/Bootstrap/Tests.rs:4117
fn assert_mir_optimizer_compiler_source(binary: OSPath, compiler_project: OSPath, session: OSPath) Never! {
    output :: session.join("compiler-source-optimizer-evidence.out")
    receipt :: session.join("compiler-source-optimizer-evidence.receipt")
    run_generated_artifact(binary, "optimizer-evidence", compiler_project, BOOTSTRAP_ENTRY_RELATIVE, output, receipt)
    evidence :: fs.read_to_string(receipt) ?? panic("cannot read compiler-source optimizer evidence: {err}")
    assert_eq(evidence, "mode=optimizer-evidence\nsource_file=Compiler/JetOptimizer/Source/Pipeline.jet\noptimizer_entry=optimize_mir_program\ninline_pass=mir_pass_expand_inline_always\ninline_pass_call_retained=true\n", "stage-two MIR did not retain the compiler-source optimizer entry and inline pass")
}

// Rust: Compiler/Bootstrap/Tests.rs:4138
fn receipt_reports(path: OSPath) -> [String] Never! {
    receipt :: fs.read_to_string(path) ?? panic("cannot read bootstrap receipt `{path.display()}`: {err}")
    reports := [String]{}
    loop line in receipt.lines() {
        if line.strip_prefix("report_json=") == .Val(value) -> &reports.push(value.to_string())
    }
    reports
}

// Rust: Compiler/Bootstrap/Tests.rs:4148
fn assert_receipt_count_at_least(receipt: String, key: String, minimum: Int) Never! {
    found := String?{None}
    loop line in receipt.lines() {
        if line.strip_prefix("{key}=") == .Val(value) { found = Val(value.to_string()); break }
    }
    text :: found ?? panic("bootstrap receipt is missing `{key}`")
    value :: text.parse::<Int>() ?? panic("bootstrap receipt `{key}` is not numeric: {err}")
    assert(value >= minimum, "bootstrap receipt `{key}` was {value}, expected at least {minimum}")
}

// Rust: Compiler/Bootstrap/Tests.rs:4161
fn assert_small_program_runs(binary: OSPath, stage: String) Never! {
    command := Command.new(binary)
    output :: &command.output() ?? panic("cannot execute {stage} small Jet program: {err}")
    assert_command_success("{stage} small Jet program", output)
    stdout :: String.from_utf8_lossy(output.stdout)
    lines := [String]{}
    loop line in stdout.lines() -> &lines.push(line.to_string())
    assert_eq(lines, ["bootstrap-small-program", "π🙂", "2", "6"], "{stage} generated compiler must execute String/List/Bytes materialization copies: {stdout:?}")
}

// Rust: Compiler/Bootstrap/Tests.rs:4174
fn assert_command_success(label: String, output: Output) Never! {
    if output.status.success() -> return
    stdout :: String.from_utf8_lossy(output.stdout)
    stderr :: String.from_utf8_lossy(output.stderr)
    panic("{label} failed with status {output.status}\nstdout:\n{stdout}\nstderr:\n{stderr}")
}
