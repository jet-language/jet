use jet_foundation.SHA256
use JetBootstrap.BuildIdentity
use std.env

// Rust: build.rs:3
// The build-time Syntax module shares the canonical file extension.
use jet_foundation.Syntax
// Rust: build.rs:14
const STDLIB_SOURCES: [String] = ["Core", "crates/jet-foundation", "crates/jet-codegen/src/Prelude"]
// Rust: build.rs:19
const RUNNER_SOURCES: [String] = ["Core", "crates/jet-foundation", "crates/jet-net", "crates/jet-codegen", "crates/jet-jit", "crates/jet-rt"]

// Rust: build.rs:28
fn main() {
    println("cargo::rustc-check-cfg=cfg(jet_bootstrap_compiler_artifact)")
    // GATE #4494: real build environment, never synthesized facts.
    target := env.var("TARGET").expect("Cargo always provides TARGET to build scripts")
    println("cargo:rustc-env=JET_BUILD_TARGET={target}")
    facts := BuildIdentity.build_facts().expect("compiler build facts must be readable")
    root := OSPath.new(".")
    compiler := BuildIdentity.semantic_id(root, BuildIdentity.COMPILER_DOMAIN, BuildIdentity.COMPILER_SOURCES, facts).expect("compiler source identity must be readable")
    stdlib := BuildIdentity.semantic_id(root, "jet.stdlib.v2", STDLIB_SOURCES, facts).expect("stdlib source identity must be readable")
    runner := BuildIdentity.semantic_id(root, "jet.runner.v2", RUNNER_SOURCES, facts).expect("runner source identity must be readable")
    println("cargo:rustc-env=JET_COMPILER_BUILD_ID={compiler}")
    println("cargo:rustc-env=JET_STDLIB_BUILD_ID={stdlib}")
    println("cargo:rustc-env=JET_RUNNER_BUILD_ID={runner}")
    watched := BuildIdentity.COMPILER_SOURCES.iter().chain(STDLIB_SOURCES).chain(RUNNER_SOURCES).collect<[String]>()
    watched.sort()
    watched.dedup()
    for path in watched { println("cargo:rerun-if-changed={path}") }
    for key in ["RUSTC", "TARGET", "HOST", "PROFILE", "OPT_LEVEL", "DEBUG", "CARGO_CFG_TARGET_FEATURE", "CARGO_ENCODED_RUSTFLAGS"] {
        println("cargo:rerun-if-env-changed={key}")
    }
    for key in BuildIdentity.profile_override_keys() { println("cargo:rerun-if-env-changed={key}") }
    if BuildIdentity.target_spec_path() == Val(spec) { println("cargo:rerun-if-changed={spec.display()}") }
}
