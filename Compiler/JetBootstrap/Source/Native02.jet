// Rust: Compiler/Bootstrap/Host/Native.rs:2187
pub fn emit_bootstrap_record_store(out: &String, symbols: &BootstrapCodecSymbols) -> Unit Err BootstrapHostCodecError! {
    trait_symbol := symbols.trait_symbol("JetDriverRecordStore")?
    out.push_str("#[doc(hidden)]\n#[derive(Clone)]\nstruct __JetBootstrapRecordStore {{\nstore: crate::compiler_bootstrap_host::BootstrapRecordStore,\n}}\n")
    out.push_str("impl {trait_symbol} for __JetBootstrapRecordStore {{\n")
    for metadata in symbols.trait_methods("JetDriverRecordStore")? {
        receiver := match metadata.receiver_access {
            Some(MirAccess.Read) -> "&self"
            Some(MirAccess.Write) -> "&mut self"
            Some(MirAccess.Move), None -> return Err(BootstrapHostCodecError.InvalidMetadata(
                "JetDriverRecordStore.{metadata.name} has no borrowed (read or write) checked receiver"))
        }
        (arity, body) := match metadata.name {
            "record" -> (2, "match self.store.record(&__jet_arg_0, &__jet_arg_1) {{ Some(bytes) => Ok(bytes), None => Err(Default::default()) }}")
            "put_record" -> (3, "Ok(self.store.put_record(&__jet_arg_0, &__jet_arg_1, &__jet_arg_2))")
            "stamp" -> (1, "match self.store.stamp(&__jet_arg_0) {{ Some(stamp) => Ok(stamp), None => Err(Default::default()) }}")
            name -> return Err(BootstrapHostCodecError.InvalidMetadata("JetDriverRecordStore.{name} has no host implementation"))
        }
        if metadata.parameter_types.len() != arity {
            return Err(BootstrapHostCodecError.InvalidMetadata("JetDriverRecordStore.{metadata.name} does not take {arity} checked arguments"))
        }
        mut parameters := ""
        for (index, ty) in metadata.parameter_types.iter().enumerate() {
            parameters.push_str(", __jet_arg_{index}: {ty}")
        }
        out.push_str("    fn {metadata.symbol}({receiver}{parameters}) -> {metadata.return_type} {{ {body} }}\n")
    }
    out.push_str("""
}}
#[doc(hidden)]
fn __jet_bootstrap_record_store() -> crate::JetOutcome<Box<dyn {trait_symbol}>, crate::JetAbsent> {{
    match crate::compiler_bootstrap_host::BootstrapRecordStore::from_env() {{
        Some(store) => Ok(Box::new(__JetBootstrapRecordStore {{ store }})),
        None => Err(Default::default()),
    }}
}}
""")
}

