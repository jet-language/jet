    let complete = (value).{result_complete};
    let comptime_stdout = (value).{result_comptime_stdout}.clone();
    let comptime_stderr = (value).{result_comptime_stderr}.clone();
    let soft_stop = (value).{result_soft_stop};
    let exit_code = (value).{result_exit_code}.as_ref().ok().map(|code| code.to_string_rep().parse::<i64>().map_err(|_| "Jet compile exit code does not fit i64".to_string())).transpose()?;
