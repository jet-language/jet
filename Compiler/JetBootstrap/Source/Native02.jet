) -> Result<{request_type}, crate::BootstrapHostCodecError> {{
    let __jet_roots = __jet_snapshot.roots.iter().map(|root| {root_type} {{
        {root_canonical_path}: root.canonical_path.clone(),
        {root_identity}: root.identity.clone(),
        {root_allow_hardlinks}: root.allow_hardlinks,
        {root_files}: root.files.iter().map(|file| {file_type} {{
            {file_path}: file.path.clone(),
            {file_relative_path}: file.relative_path.clone(),
            {file_identity}: file.identity.clone(),
            {file_source}: file.source.clone(),
        }}).collect::<Vec<_>>(),
        {root_foreign_cache_files}: root.foreign_cache_files.iter().map(|file| {file_type} {{
            {file_path}: file.path.clone(),
            {file_relative_path}: file.relative_path.clone(),
            {file_identity}: file.identity.clone(),
            {file_source}: file.source.clone(),
        }}).collect::<Vec<_>>(),
    }}).collect::<Vec<_>>();
    // The Core library bodies the Rust loader embeds: every public source
    // module row plus the compiler-private parts, in table order.
    let mut __jet_core_sources = Vec::new();
    for (row, owner) in ::jet_foundation::CoreModuleExports::core_source_modules().iter().map(|row| (row, ""))
        .chain(::jet_foundation::CoreSourceParts::CORE_PRIVATE_SOURCE_PARTS.iter().map(|part| (&part.source, part.owner)))
    {{
        let text = ::jet_driver::CoreSources::core_source_text(row.module).ok_or_else(|| {{
            crate::BootstrapHostCodecError::InvalidMetadata(format!("Core source module `{{}}` has no body text", row.module))
        }})?;
        __jet_core_sources.push({core_source_type} {{
            {core_source_module_name}: row.module.to_string(),
            {core_source_alias}: row.alias.to_string(),
            {core_source_path}: row.path.to_string(),
            {core_source_owner}: owner.to_string(),
            {core_source_owned_members}: row.owned_members.iter().map(|member| member.to_string()).collect::<Vec<_>>(),
            {core_source_text}: text.to_string(),
        }});
    }}
    let __jet_target = __jet_bootstrap_target_with_raw_web_assets(__jet_requested_target)
        .map_err(crate::BootstrapHostCodecError::InvalidMetadata)?;
    let __jet_eval_config = {default_symbol}();
    let __jet_request = {request_type} {{
        {request_sources}: {snapshot_type} {{
            {snapshot_roots}: __jet_roots,
            {snapshot_entry_root}: __jet_snapshot.entry_root_identity.clone(),
            {snapshot_entry_path}: __jet_snapshot.entry_path.clone(),
        }},
        {request_host_facts}: {host_facts_type} {{
            {host_target_triple}: Ok(::jet_foundation::Layout::TargetLayout::host_triple()),
            {host_active_os}: Ok(::std::env::consts::OS.to_string()),
            {host_compiler_identity}: option_env!("JET_COMPILER_SOURCE_ID").map(|value| Ok(format!("{{}}@{{}}#{{}}", ::jet_foundation::Syntax::BINARY_NAME, ::jet_pkg_model::Manifest::COMPILER_VERSION, value))).unwrap_or_else(|| Err(Default::default())),
        }},
        {request_effect_source}: ::jet_foundation::Effects::EFFECT_SOURCE.to_string(),
        {request_core_sources}: __jet_core_sources,
        {request_eval_config}: __jet_eval_config,
        {request_target}: __jet_target,
        {request_record_store}: __jet_bootstrap_record_store(),
        {request_trace_sink}: __jet_bootstrap_trace_sink(),
        // Full verification (MIR Lint after every optimizer pass) is an
        // explicit host opt-in for tests and verification runs.
        {request_mir_lint_every_pass}: ::std::env::var_os("JET_BOOTSTRAP_MIR_LINT_EVERY_PASS").is_some_and(|value| value == "1"),
    }};
    Ok(__jet_request)
}}
""")
    out.push_str("""
#[doc(hidden)]
pub(crate) fn __jet_bootstrap_compile_from_host(
    __jet_snapshot: &crate::compiler_bootstrap_host::AuthorizedSourceSnapshot,
    __jet_requested_target: {target_type},
    __jet_selected_tier: crate::BootstrapFactoryTier,
    __jet_execution: &crate::Codegen::MIRRust::MirRustExecutionConfig,
    __jet_completion_owner: &mut crate::compiler_bootstrap_runner::BootstrapRunCompletionOwner,
) -> Result<crate::BootstrapJetCompileResult<{mir_program_type}, {eval_config_type}>, crate::BootstrapHostCodecError> {{
    let __jet_request = __jet_bootstrap_request_from_host(__jet_snapshot, __jet_requested_target)?;
    let __jet_completion_scope = __jet_completion_owner.completion_scope();
    let __jet_compile_span = ::jet_driver::Trace::span("compile");
    let __jet_result = __jet_bootstrap_compile_with_native(__jet_request, __jet_selected_tier, __jet_execution, __jet_completion_owner)?;
    drop(__jet_compile_span);
    let mut __jet_runtime_config = Some(__jet_result.runtime_config);
    let __jet_decode_span = ::jet_driver::Trace::span("decode");
    let __jet_output = __jet_completion_scope.with_current(|| {{
        let _activation = __jet_result.resources.activate();
        __jet_bootstrap_bindings_from_result(__jet_result.result, __jet_snapshot, &mut __jet_runtime_config, __jet_result.selected_factory_tier, __jet_result.actual_factory_tier)
    }});
    drop(__jet_decode_span);
    match __jet_output {{
        Ok(mut output) => {{ output.resources = Some(__jet_result.resources); Ok(output) }},
        Err(error) => {{ let error = crate::BootstrapHostCodecError::InvalidMetadata(error); match __jet_completion_scope.with_current(|| __jet_result.resources.retire()) {{
            Ok(completions) => {{
                for completion in completions {{ __jet_completion_scope.record(completion); }}
                Err(error)
            }},
            Err(retirement) => Err(crate::BootstrapHostCodecError::ResourceRetirement {{ cause: Box::new(error), retirement }}),
        }} }},
    }}
}}
""")
}

// Rust: Compiler/Bootstrap/Host/Native.rs:2561
// Each checked parameter chooses a mutable borrow, read borrow, or owned value.
pub fn bootstrap_call_arguments(parameter_types: &[String], values: &[(String, String)]) -> String {
    mut arguments: [String] := []
    for (ty, (place, owned)) in parameter_types.iter().zip(values) {
        arguments.push(if ty.starts_with("&mut ") { "&mut {place}" }
            else if ty.starts_with("&") { "&{place}" }
            else { owned })
    }
    arguments.join(", ")
}

// Rust: Compiler/Bootstrap/Host/Native.rs:2578
pub fn checked_task_roots_callable(
    bindings: &BootstrapBindingDescriptor, name: String, arity: Int, returns_bool: Bool
) -> MirRustCallableMetadata Err BootstrapHostCodecError! {
    callable := bootstrap_required_callable(bindings, name)?
    if callable.parameter_types.len() != arity || (returns_bool && callable.return_type != "bool") {
        return Err(BootstrapHostCodecError.InvalidMetadata(
            "task-root fixture `{name}` does not have its checked {arity}-parameter signature"))
    }
    callable
}

