pub fn emit_bootstrap_trace_sink(out: &String, symbols: &BootstrapCodecSymbols) -> Unit Err BootstrapHostCodecError! {
    trait_symbol := symbols.trait_symbol("CompilerTraceSink")?
    out.push_str("#[doc(hidden)]\n#[derive(Clone)]\nstruct __JetBootstrapTraceSink {{\nsink: &'static ::jet_driver::Trace::TraceSink,\n}}\n")
    out.push_str("impl {trait_symbol} for __JetBootstrapTraceSink {{\n")
    for metadata in symbols.trait_methods("CompilerTraceSink")? {
        receiver := match metadata.receiver_access {
            Some(MirAccess.Read) -> "&self"
            Some(MirAccess.Write) -> "&mut self"
            Some(MirAccess.Move), None -> return Err(BootstrapHostCodecError.InvalidMetadata(
                "CompilerTraceSink.{metadata.name} has no borrowed (read or write) checked receiver"))
        }
        (arity, call_body) := match metadata.name {
            "begin" -> (4, "self.sink.begin(&__jet_arg_0, &__jet_arg_1, __jet_arg_2.to_i64().unwrap_or(-1), __jet_arg_3.to_i64().unwrap_or(-1))")
            "end" -> (2, "self.sink.end(&__jet_arg_0, __jet_arg_1.to_i64().unwrap_or(-1))")
            "progress" -> (3, "self.sink.progress(&__jet_arg_0, __jet_arg_1.to_i64().unwrap_or(-1), __jet_arg_2.to_i64().unwrap_or(-1))")
            "functions" -> (0, "self.sink.functions()")
            name -> return Err(BootstrapHostCodecError.InvalidMetadata("CompilerTraceSink.{name} has no host implementation"))
        }
        if metadata.parameter_types.len() != arity {
            return Err(BootstrapHostCodecError.InvalidMetadata("CompilerTraceSink.{metadata.name} does not take {arity} checked arguments"))
        }
        mut parameters := ""
        for (index, ty) in metadata.parameter_types.iter().enumerate() {
            parameters.push_str(", __jet_arg_{index}: {ty}")
        }
        return_type := metadata.return_type.trim_start_matches("crate::") // #4303
        body := if return_type.starts_with("JetOutcome<") { "Ok({call_body})" } else { call_body }
        out.push_str("    fn {metadata.symbol}({receiver}{parameters}) -> {metadata.return_type} {{ {body} }}\n")
    }
    out.push_str("""
}}
