pub fn emit_bootstrap_native_compile_entry(
    out: &String, bindings: &BootstrapBindingDescriptor, symbols: &BootstrapCodecSymbols,
    entry: &MirRustCallableMetadata, runtime_config_symbol: String,
    helpers: &BootstrapNativeHelperRoots
) -> Unit Err BootstrapHostCodecError! {
    eval_config := symbols.type_symbol("JetEvalConfig")?
    request_eval_config := symbols.field_symbol("JetDriverCompileRequest", "eval_config")?
    request_host_adapter := symbols.field_symbol("JetEvalConfig", "host_adapter")?
    request_host_hooks := symbols.field_symbol("JetEvalConfig", "host_hooks")?
    host_hooks_type := symbols.type_symbol("SemaRegistrationHostHooks")?
    hook_numeric := symbols.field_symbol("SemaRegistrationHostHooks", "numeric_unit_conversion_exact")?
    hook_boundary := symbols.field_symbol("SemaRegistrationHostHooks", "typed_boundary_literal_validate")?
    host_field := symbols.field_binding("JetEvalConfig", "host_adapter")?
    numeric_field := symbols.field_binding("SemaRegistrationHostHooks", "numeric_unit_conversion_exact")?
    entry_id := entry.function.0.to_string()
    callback_transfer := helpers.callback_transfer.0.to_string()
    host_type_shape := helpers.host_type_shape.0.to_string()
    shape_callable := checked_bootstrap_callable(bindings, "jet_eval_host_type_shape_from_program")?
    if shape_callable.metadata.parameter_types.len() != 3 {
        return Err(BootstrapHostCodecError.InvalidMetadata(
            "Source host-shape accessor must take its program, checked type, and source span"
        ))
    }
    shape_arguments := bootstrap_call_arguments(shape_callable.metadata.parameter_types, [
        ("__jet_shape_program", "__jet_shape_program.clone()"),
        ("__jet_shape_type", "__jet_shape_type.clone()"),
        ("__jet_shape_span", "__jet_shape_span.clone()")
    ])
    // Generated Rust is output data, not a host-language implementation.
    generated := """

#[doc(hidden)]
fn __jet_bootstrap_native_collect_shared_payload_types(
    program: &::jet_foundation::MIR::MirProgram,
) -> ::std::collections::BTreeMap<String, ::jet_foundation::MIR::MirType> {{
    use ::jet_foundation::MIR::MirTypeKind as K;

    fn visit(
        ty: &::jet_foundation::MIR::MirType,
        payloads: &mut ::std::collections::BTreeMap<
            String,
            ::jet_foundation::MIR::MirType,
        >,
    ) {{
        match ty.kind() {{
            K::Shared(inner) => {{
                payloads
                    .entry(inner.canonical_key())
                    .or_insert_with(|| inner.as_ref().clone());
                visit(inner, payloads);
            }}
            K::List(inner)
            | K::Option(inner)
            | K::FixedList {{ elem: inner, .. }}
            | K::InlineRange {{ base: inner, .. }}
            | K::Tagged {{ inner, .. }}
            | K::Quantity {{ base: inner, .. }} => visit(inner, payloads),
            K::Map {{ key, value }} => {{
                visit(key, payloads);
                visit(value, payloads);
            }}
            K::Result {{ ok, err }} => {{
                visit(ok, payloads);
                visit(err, payloads);
            }}
            K::Fn(signature) => {{
                for parameter in &signature.params {{
                    visit(parameter, payloads);
                }}
                if let Some(result) = &signature.ret {{
                    visit(result, payloads);
                }}
            }}
            K::SendFn {{ params, ret, .. }} => {{
                for parameter in params {{
                    visit(parameter, payloads);
                }}
                if let Some(result) = ret {{
                    visit(result, payloads);
                }}
            }}
            K::Apply {{ args, .. }} => {{
                for argument in args {{
                    visit(argument, payloads);
                }}
            }}
            K::Tuple(fields) => {{
                for (_, field_type) in fields {{
                    visit(field_type, payloads);
                }}
            }}
            K::Union(variants) => {{
                for variant in variants {{
                    visit(variant, payloads);
                }}
            }}
            _ => {{}}
        }}
    }}

    let mut payloads = ::std::collections::BTreeMap::new();
    for ty in &program.type_instances {{
        visit(ty, &mut payloads);
    }}
    payloads
}}

struct __JetBootstrapCompileLease {{
    result: __COMPILE_RESULT__,
    resources: ::jet_jit::SourceResources::SourceResourceSession,
    runtime_config: __EVAL_CONFIG__,
    selected_factory_tier: crate::BootstrapFactoryTier,
    actual_factory_tier: crate::BootstrapFactoryTier,
}}

