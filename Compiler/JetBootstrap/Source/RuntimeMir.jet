// Private generated Runner boundary: typed carrier/identity/resource ownership only.
use jet_foundation.JitBackend.RunOutcome
use jet_foundation.MIR.[MirArtifactId, MirExecutionIdentity, MirFunctionId, MirProgram, MirRuntimeValue]
use jet_pkg_model.Package.ReleaseDevtoolsPolicy
use jet_jit.SourceResources.SourceResourceSession
use jet_jit.[SourceDeoptRequest, SourceDeoptReply, SourceExecutionTier, SourceExecutionGuard, SourceExecutionRetirement, SourceExecutionRetirementError, SourceDeoptError, execute_source_entry, retire_source_entry]
use jet_bootstrap.BootstrapBindingDescriptor

// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:22
struct SourceMirExecution {
    pub outcome: RunOutcome
    pub value: MirRuntimeValue?
    pub soft_stop: Bool
    pub stdout: String
    pub stderr: String
    pub tier: SourceExecutionTier
    pub program: MirProgram
    pub identity: MirExecutionIdentity
    pub artifact: MirArtifactId
    pub entry_function: MirFunctionId
    // Physical arena root remains alive until explicit logical retirement.
    pub resources: SourceResourceSession
    pub source_session: Box<dyn SourceExecutionGuard>?
}
// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:50
#Error
enum SourceMirExecutionError {
    Carrier(String)
    Identity(String)
    Resource(String)
    Backend(String)
    Retirement(SourceExecutionRetirementError)
}
// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:58
impl SourceMirExecution {
    // Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:63
    fn retire_source_session(self: SourceMirExecution) -> SourceExecutionRetirement SourceMirExecutionError! {
        // Consume all projections without copying the program or arena.
        execution :: ^self
        retire_source_entry(^execution.resources, ^execution.source_session,
            SourceExecutionRetirement(outcome: Val(^execution.outcome), value: ^execution.value,
                soft_stop: execution.soft_stop, stdout: ^execution.stdout, stderr: ^execution.stderr,
                completions: [])
        ).map_err(fn(error) { SourceMirExecutionError.Retirement(^error) })
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:93
impl std.fmt.Display for SourceMirExecutionError {
    // Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:94
    fn fmt(self: &SourceMirExecutionError, formatter: &std.fmt.Formatter) -> Unit std.fmt.Error! {
        if self == {
            .Carrier(message) -> formatter.write_str("Source MIR carrier conversion failed: {message}")
            .Identity(message) -> formatter.write_str("Source MIR execution identity failed: {message}")
            .Resource(message) -> formatter.write_str("Source resource activation failed: {message}")
            .Backend(message) -> formatter.write_str("Source MIR backend handoff failed: {message}")
            .Retirement(error) -> formatter.write_str("{error}")
        }
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:105
impl std.error.Error for SourceMirExecutionError {}

// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:123
fn execute_decoded_source_mir<Resume: Fn(&SourceDeoptRequest) -> SourceDeoptReply Err!>(
    program: MirProgram, artifact: MirArtifactId, entry_function: MirFunctionId,
    resources: &SourceResourceSession, entry_values: [MirRuntimeValue],
    policy: ReleaseDevtoolsPolicy, resume: Resume
) -> SourceMirExecution SourceMirExecutionError! {
    identity :: program.execution_identity(Val(artifact)).map_err(fn(error) {
        SourceMirExecutionError.Identity(error.to_string())
    })?
    // GATE #4494: real invocation arena activation and nested native callback lifetime;
    // canonical transport seam owns cleanup on both return and unwind.
    native_run :: execute_source_entry(&program, artifact, entry_function, resources.clone(),
        ^entry_values, &policy, ^resume).map_err(fn(error) {
        if error == {
            .Resource(message) -> SourceMirExecutionError.Resource(^message)
            other -> SourceMirExecutionError.Backend(other.to_string())
        }
    })?
    return SourceMirExecution(outcome: ^native_run.outcome, value: ^native_run.value,
        soft_stop: native_run.soft_stop, stdout: ^native_run.stdout, stderr: ^native_run.stderr,
        tier: native_run.tier, program: ^program, identity: ^identity, artifact: artifact,
        entry_function: entry_function, resources: ^native_run.resources,
        source_session: ^native_run.session)
}
// Rust: Compiler/Bootstrap/Host/RuntimeMir.rs:181
fn execute_source_mir<SourceProgram, Decode: FnOnce(&SourceProgram, &BootstrapBindingDescriptor) -> MirProgram Err!, Resume: Fn(&SourceDeoptRequest) -> SourceDeoptReply Err!>(
    source_program: &SourceProgram, artifact: MirArtifactId, entry_function: MirFunctionId,
    bindings: &BootstrapBindingDescriptor, resources: &SourceResourceSession,
    entry_values: [MirRuntimeValue], policy: ReleaseDevtoolsPolicy, decode: Decode, resume: Resume
) -> SourceMirExecution SourceMirExecutionError! {
    program :: decode(source_program, bindings).map_err(fn(error) { SourceMirExecutionError.Carrier(^error) })?
    execute_decoded_source_mir(^program, artifact, entry_function, resources, ^entry_values, ^policy, ^resume)
}
