// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1886
pub fn align_variant_fields(owner: String, source: &Variant, host: &Variant) -> [USize?] BootstrapHostCodecError! {
    if source.fields.len() == host.fields.len() { return (0..<host.fields.len()).map(fn(index) -> Val(index)).collect() }
    arity := fn() -> BootstrapHostCodecError.InvalidMetadata("MIR enum variant `{owner}::{source.name}` changes payload arity")
    aligned: [USize?] = []
    for host_field in &host.fields {
        name := host_field.name.as_deref().ok_or_else(arity)?
        index := source.fields.iter().position(fn(field) -> field.name.as_deref() == Val(name))
        if index.is_none() && host_only_variant_field(owner, source.name, name).is_none() { throw arity() }
        aligned.push(index)
    }
    for (index, field) in source.fields.iter().enumerate() {
        derived := field.name.as_deref().is_some_and(fn(name) -> derived_source_variant_field(owner, source.name, name))
        if !aligned.contains(Val(index)) && !derived { throw arity() }
    }
    ^aligned
}
