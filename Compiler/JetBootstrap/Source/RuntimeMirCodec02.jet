// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1819
pub fn custom_struct_field_to_host(symbols: &BootstrapCodecSymbols, owner: String, host_field: String) -> String? BootstrapHostCodecError! {
    if (owner, host_field) == {
        ("MIRCaptureFacts", "frame_schedule" | "frame_schedule_derivation") -> Val("None")
        ("MIRKernelFacts", "mode") -> Val("::jet_foundation::MIR::MirKernelMode::Parallel")
        ("MIRFunction", "memo_bound") -> {
            bound := symbols.field_symbol(owner, "memo_bound")?
            unbounded := symbols.field_symbol(owner, "memo_unbounded")?
            Val("if value.{unbounded} {{ Some(None) }} else {{ value.{bound}.as_ref().ok().map(|__bound| -> Result<_, String> {{ Ok(Some(__bound.to_string_rep().parse::<usize>().map_err(|_| \"MIR memo bound is outside native range\".to_string())?)) }}).transpose()? }}")
        }
        _ -> None
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1842
pub fn custom_struct_field_from_host(owner: String, source_field: String) -> String? {
    if host_private_row(owner, source_field) == Val((_, _, getter, _)) { return Val("value.{getter}().ok_or(jet_foundation::Outcome::JetAbsent)") }
    if (owner, source_field) == {
        ("MIRFunction", "memo_bound") -> Val("match &value.memo_bound {{ Some(Some(__bound)) => Ok(jet_foundation::Numeric::JetInt::from_big(jet_foundation::Numeric::CtBigInt::from_str(&__bound.to_string())?)), _ => Err(jet_foundation::Outcome::JetAbsent) }}")
        ("MIRFunction", "memo_unbounded") -> Val("matches!(value.memo_bound, Some(None))")
        _ -> None
    }
}
