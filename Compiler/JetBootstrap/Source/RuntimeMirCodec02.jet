// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1980
pub fn derived_field_to_host_check(symbols: &BootstrapCodecSymbols, owner: String, source: &Variant, host: &Variant, field_index: USize, bindings: &[String]) -> String BootstrapHostCodecError! {
    basis := derived_field_basis(owner, source.name)?
    host_basis := variant_field_index(&host.fields, basis, owner, source.name)?
    trap := symbols.variant_path("MIRBinaryOverflow", "Trap")?
    "if __jet_bootstrap_binary_traps(&__host_{host_basis})? != matches!({bindings[field_index]}, {trap}) {{ return Err(\"Source MIR Binary overflow disagrees with its dispatch: Trap is exactly a fixed-width trap route for an overflowing operator\".to_string()); }}"
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:1998
pub fn derived_field_from_host(symbols: &BootstrapCodecSymbols, owner: String, source: &Variant, host: &Variant, bindings: &[String]) -> String BootstrapHostCodecError! {
    basis := derived_field_basis(owner, source.name)?
    host_basis := variant_field_index(&host.fields, basis, owner, source.name)?
    trap := symbols.variant_path("MIRBinaryOverflow", "Trap")?
    unchecked := symbols.variant_path("MIRBinaryOverflow", "Unchecked")?
    "if __jet_bootstrap_binary_traps({bindings[host_basis]})? {{ {trap} }} else {{ {unchecked} }}"
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2018
pub fn emit_binary_overflow_derivation(out: &String, symbols: &BootstrapCodecSymbols) -> Unit BootstrapHostCodecError! {
    program := symbols.type_symbol("MIRProgram")?
    prelude_calls := symbols.field_symbol("MIRProgram", "prelude_calls")?
    family := symbols.field_symbol("MIRPreludeCall", "family")?
    member := symbols.field_symbol("MIRPreludeCall", "member")?
    id := symbols.field_symbol("MIRPreludeCall", "id")?
    id_value := symbols.field_symbol("MIRPreludeCallID", "value")?
    overflow := symbols.variant_path("MIRPreludeFamily", "Overflow")?
    // GATE #4494: generated native TLS retains program-local derivation context.
    out.push_str("""
thread_local! {{
    static __JET_BOOTSTRAP_TRAP_ROUTES: ::std::cell::RefCell<Option<::std::collections::BTreeSet<u64>>> = ::std::cell::RefCell::new(None);
}}
fn __jet_bootstrap_fixed_trap_member(member: &str) -> bool {{
    member.split_once(".trap.").is_some_and(|(width, op)| matches!(width, "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64") && matches!(op, "add" | "sub" | "mul" | "div" | "pow" | "shl" | "shr"))
}}
fn __jet_bootstrap_with_trap_routes<T>(routes: ::std::collections::BTreeSet<u64>, convert: impl FnOnce() -> Result<T, String>) -> Result<T, String> {{
    let previous = __JET_BOOTSTRAP_TRAP_ROUTES.with(|cell| cell.replace(Some(routes)));
    let result = convert();
    __JET_BOOTSTRAP_TRAP_ROUTES.with(|cell| *cell.borrow_mut() = previous);
    result
}}
fn __jet_bootstrap_binary_traps(dispatch: &::jet_foundation::MIR::MirBinaryDispatch) -> Result<bool, String> {{
    match dispatch {{
        ::jet_foundation::MIR::MirBinaryDispatch::Primitive => Ok(false),
        ::jet_foundation::MIR::MirBinaryDispatch::Prelude {{ call, .. }} => __JET_BOOTSTRAP_TRAP_ROUTES.with(|cell| cell.borrow().as_ref().map(|routes| routes.contains(&call.0))).ok_or_else(|| "MIR Binary overflow derives from the program's Prelude routes; convert the whole program".to_string()),
    }}
}}
fn __jet_bootstrap_source_trap_routes(value: &{program}) -> ::std::collections::BTreeSet<u64> {{
    value.{prelude_calls}.iter().filter(|row| matches!(row.{family}, {overflow}) && __jet_bootstrap_fixed_trap_member(&row.{member})).map(|row| row.{id}.{id_value}).collect()
}}
fn __jet_bootstrap_host_trap_routes(value: &::jet_foundation::MIR::MirProgram) -> ::std::collections::BTreeSet<u64> {{
    value.prelude_calls.iter().filter(|row| matches!(row.family, ::jet_foundation::MIR::MirPreludeFamily::Overflow) && __jet_bootstrap_fixed_trap_member(&row.member)).map(|row| row.id.0).collect()
}}
""")
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2043
pub fn host_variant_name(owner: String, variant: String) -> String {
    if (owner, variant) == {
        ("MIRDropKind", "NoDrop") | ("MIRCopyCost", "NoCopy") | ("MIREntryOutput", "NoOutput") | ("MIRAllocatorPolicy", "NoAllocator") | ("MIRClockPolicy", "NoClock") | ("MIREntropyPolicy", "NoEntropy") | ("MIRSchedulerPolicy", "NoScheduler") | ("MIRByteSinkPolicy", "NoByteSink") | ("MIRMMIOPolicy", "NoMMIO") | ("CoreCallPureRoute", "NoPureRoute") | ("CoreCallInterpreterRoute", "NoRoute") -> "None"
        _ -> variant.to_string()
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2061
pub fn validate_unique_definitions(definitions: &[Definition]) -> Unit Err! {
    names: [String: Unit] = [:]
    for definition in definitions {
        if names.insert(definition.name, ()).is_some() { throw "duplicate MIR schema type `{definition.name}`" }
        if definition.body == {
            .Struct(fields) -> {
                field_names: [String: Unit] = [:]
                for field in fields { if field_names.insert(field.name, ()).is_some() { throw "duplicate MIR schema field `{definition.name}.{field.name}`" } }
            }
            .Enum(variants) -> {
                variant_names: [String: Unit] = [:]
                for variant in variants { if variant_names.insert(variant.name, ()).is_some() { throw "duplicate MIR schema variant `{definition.name}::{variant.name}`" } }
            }
            .Tuple -> {}
        }
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2104
pub fn parse_type(input: String) -> TypeExpr Err! {
    input := input.trim().trim_end_matches(',').trim() // #4303
    if input.is_empty() { throw "empty MIR field type" }
    if input.strip_prefix('?').or_else(fn() -> input.strip_suffix('?')) == Val(rest) { return TypeExpr.Optional(Box.new(parse_type(rest)?)) }
    if input.starts_with('[') && input.ends_with(']') {
        body := input[1..input.len() - 1]
        if top_level_colon(body) == Val(index) { return TypeExpr.Map(Box.new(parse_type(body[..index])?), Box.new(parse_type(body[index + 1..])?)) }
        return TypeExpr.List(Box.new(parse_type(body)?))
    }
    if generic_inner(input, "Option") == Val(inner) { return TypeExpr.Optional(Box.new(parse_type(inner)?)) }
    if generic_inner(input, "Vec") == Val(inner) { return TypeExpr.List(Box.new(parse_type(inner)?)) }
    if generic_inner(input, "BTreeSet").or_else(fn() -> generic_inner(input, "HashSet")) == Val(inner) { return TypeExpr.Named("BTreeSet<{inner}>") }
    if generic_inner(input, "Box") == Val(inner) { trimmed := inner.trim(); return TypeExpr.Named("Box<{trimmed}>") } // #4303
    if generic_inner(input, "BTreeMap").or_else(fn() -> generic_inner(input, "HashMap")) == Val(inner) {
        parts := split_top_level(inner, ',')
        if parts.len() != 2 { throw "map type `{input}` does not have two parameters" }
        return TypeExpr.Map(Box.new(parse_type(parts[0])?), Box.new(parse_type(parts[1])?))
    }
    TypeExpr.Named(input.to_string())
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2147
pub fn generic_inner(input: String, name: String) -> String? { input.strip_prefix("{name}<").and_then(fn(rest) -> rest.strip_suffix('>')) }
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2154
pub fn parse_definitions(input: String) -> [Definition] Err! {
    input := strip_comments(input)
    definitions: [Definition] = []
    cursor: USize = 0
    while find_next_definition(input, cursor) == Val((keyword, start)) {
        cursor = start + keyword.len()
        position := cursor
        skip_space(input, &position)
        // Macro template $name declares no visible schema expansion.
        if input.as_bytes().get(position) == Val('$' as U8) { cursor = position; continue }
        name := read_identifier(input, &position)?
        (definition, end) := parse_definition_body(input, keyword, ^name, position)?
        definitions.push(^definition)
        cursor = end
    }
    ^definitions
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2179
pub fn parse_definition_body(input: String, keyword: String, name: String, position: USize) -> (Definition, USize) Err! {
    skip_space(input, &position)
    body := if input.as_bytes().get(position).copied() == {
        Val('{' as U8) -> {
            end := matching_delimiter(input, position, '{' as U8, '}' as U8)?
            contents := input[position + 1..end]
            position = end + 1
            if keyword == "struct" {
                fields := parse_fields(contents)?
                for field in &fields { field.ty = spell_self(field.ty, name) }
                Body.Struct(^fields)
            } else {
                variants := parse_variants(contents)?
                for variant in &variants { for field in &variant.fields { field.ty = spell_self(field.ty, name) } }
                Body.Enum(^variants)
            }
        }
        Val('(' as U8) -> { end := matching_delimiter(input, position, '(' as U8, ')' as U8)?; position = end + 1; Body.Tuple }
        _ -> { throw "MIR declaration `{name}` has no body" }
    }
    (Definition(name: ^name, body: ^body), position)
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2231
pub fn spell_self(ty: String, owner: String) -> String {
    bytes := ty.as_bytes()
    identifier := fn(index: USize) -> bytes.get(index).is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == '_' as U8)
    out := String.with_capacity(ty.len())
    cursor: USize = 0
    while ty[cursor..].find("Self") == Val(relative) {
        start := cursor + relative
        end := start + "Self".len()
        out.push_str(ty[cursor..start])
        if identifier(start.wrapping_sub(1)) || identifier(end) { out.push_str("Self") } else { out.push_str(owner) }
        cursor = end
    }
    out.push_str(ty[cursor..])
    ^out
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2251
pub fn strip_comments(input: String) -> String { input.lines().map(fn(line) -> line.split_once("//").map_or(line, fn((line, _)) -> line)).collect<[String]>().join("\n") }
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2259
pub fn find_next_definition(input: String, from: USize) -> (String, USize)? {
    struct_position := find_keyword(input, "pub struct", from)
    enum_position := find_keyword(input, "pub enum", from)
    if (struct_position, enum_position) == {
        (Val(left), Val(right)) if left < right -> Val(("struct", left + 4))
        (Val(_), Val(right)) -> Val(("enum", right + 4))
        (Val(position), None) -> Val(("struct", position + 4))
        (None, Val(position)) -> Val(("enum", position + 4))
        (None, None) -> None
    }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2271
pub fn find_keyword(input: String, keyword: String, from: USize) -> USize? {
    cursor := from
    while input[cursor..].find(keyword) == Val(relative) {
        position := cursor + relative
        before := input.as_bytes().get(position.wrapping_sub(1)).copied()
        after := input.as_bytes().get(position + keyword.len()).copied()
        if !before.is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == '_' as U8) && !after.is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == '_' as U8) { return Val(position) }
        cursor = position + keyword.len()
    }
    None
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2287
pub fn parse_fields(input: String) -> [Field] Err! {
    starts := top_level_keyword_starts(input, "pub")
    fields: [Field] = []
    for (index, start) in starts.iter().enumerate() {
        end := starts.get(index + 1).copied().unwrap_or(input.len())
        field := input[start..end].trim().trim_end_matches(',').trim() // #4303
        cursor: USize = 3
        skip_space(field, &cursor)
        if field[cursor..].starts_with("(") { end := matching_delimiter(field, cursor, '(' as U8, ')' as U8)?; cursor = end + 1; skip_space(field, &cursor) }
        name := read_identifier(field, &cursor)?
        skip_space(field, &cursor)
        if field.as_bytes().get(cursor) != Val(':' as U8) { throw "field `{name}` has no type" }
        cursor += 1
        // Field attributes after the comma belong to the next field.
        ty := split_top_level(field[cursor..], ',').into_iter().next().unwrap_or_default().trim().to_string() // #4303
        fields.push(Field(name: ^name, ty: ^ty))
    }
    ^fields
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2319
pub fn parse_named_fields(input: String) -> [Field] Err! {
    fields: [Field] = []
    for part in split_top_level(input, ',') {
        if part.trim().is_empty() { continue }
        index := top_level_colon(part).ok_or_else(fn() -> "named MIR field `{part}` has no type")?
        name := part[..index].trim().to_string() // #4303
        ty := part[index + 1..].trim().to_string() // #4303
        fields.push(Field(name: ^name, ty: ^ty))
    }
    ^fields
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2334
pub fn parse_variants(input: String) -> [Variant] Err! {
    variants: [Variant] = []
    cursor: USize = 0
    while cursor < input.len() {
        skip_space_and_commas(input, &cursor)
        while input[cursor..].starts_with("#[") { cursor = matching_delimiter(input, cursor + 1, '[' as U8, ']' as U8)? + 1; skip_space_and_commas(input, &cursor) }
        if cursor >= input.len() { break }
        name := read_identifier(input, &cursor)?
        skip_space(input, &cursor)
        fields: [VariantField] = []
        if input.as_bytes().get(cursor).copied() == {
            Val('(' as U8) -> {
                end := matching_delimiter(input, cursor, '(' as U8, ')' as U8)?
                for part in split_top_level(input[cursor + 1..end], ',') { if !part.trim().is_empty() { fields.push(parse_variant_field(^part)?) } }
                cursor = end + 1
            }
            Val('{' as U8) -> {
                end := matching_delimiter(input, cursor, '{' as U8, '}' as U8)?
                for field in parse_named_fields(input[cursor + 1..end])? { fields.push(VariantField(name: Val(^field.name), ty: ^field.ty)) }
                cursor = end + 1
            }
            _ -> {}
        }
        // Explicit discriminants carry no schema shape.
        skip_space(input, &cursor)
        if input[cursor..].starts_with('=') { cursor += split_top_level(input[cursor..], ',')[0].len() }
        variants.push(Variant(name: ^name, fields: ^fields))
    }
    ^variants
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2384
pub fn parse_variant_field(input: String) -> VariantField Err! {
    input := input.trim().to_string() // #4303
    if top_level_colon(input) == Val(index) {
        name := input[..index].trim().to_string() // #4303
        ty := input[index + 1..].trim().to_string() // #4303
        VariantField(name: Val(^name), ty: ^ty)
    } else { VariantField(name: None, ty: ^input) }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2399
pub fn top_level_keyword_starts(input: String, keyword: String) -> [USize] {
    starts: [USize] = []
    cursor: USize = 0
    depth: USize = 0
    bytes := input.as_bytes()
    while cursor < input.len() {
        if bytes[cursor] == {
            '[' as U8 | '(' as U8 | '{' as U8 | '<' as U8 -> { depth += 1 }
            ']' as U8 | ')' as U8 | '}' as U8 | '>' as U8 -> { depth = depth.saturating_sub(1) }
            _ -> {}
        }
        if depth == 0 && input[cursor..].starts_with(keyword) && (cursor == 0 || !bytes[cursor - 1].is_ascii_alphanumeric()) && bytes.get(cursor + keyword.len()).is_some_and(fn(byte) -> byte.is_ascii_whitespace() || byte == '(' as U8) { starts.push(cursor) }
        cursor += 1
    }
    ^starts
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2424
pub fn split_top_level(input: String, delimiter: Char) -> [String] {
    pieces: [String] = []
    start: USize = 0
    depth: USize = 0
    for (index, character) in input.char_indices() {
        if character == {
            '[' | '(' | '{' | '<' -> { depth += 1 }
            ']' | ')' | '}' | '>' -> { depth = depth.saturating_sub(1) }
            character if character == delimiter && depth == 0 -> { pieces.push(input[start..index].to_string()); start = index + character.len_utf8() }
            _ -> {}
        }
    }
    pieces.push(input[start..].to_string())
    ^pieces
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2443
pub fn top_level_colon(input: String) -> USize? {
    depth: USize = 0
    for (index, character) in input.char_indices() {
        if character == {
            '[' | '(' | '{' | '<' -> { depth += 1 }
            ']' | ')' | '}' | '>' -> { depth = depth.saturating_sub(1) }
            ':' if depth == 0 && !input[..index].ends_with(':') && !input[index + 1..].starts_with(':') -> { return Val(index) }
            _ -> {}
        }
    }
    None
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2462
pub fn matching_delimiter(input: String, start: USize, open: U8, close: U8) -> USize Err! {
    depth: USize = 0
    bytes := input.as_bytes()
    for index in start..<input.len() {
        if bytes[index] == {
            byte if byte == open -> { depth += 1 }
            byte if byte == close -> { depth = depth.saturating_sub(1); if depth == 0 { return index } }
            _ -> {}
        }
    }
    throw "unclosed MIR delimiter at byte {start}"
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2479
pub fn skip_space(input: String, cursor: &USize) -> Unit {
    while input.as_bytes().get(cursor.*).is_some_and(fn(byte) -> byte.is_ascii_whitespace()) { cursor.* += 1 }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2489
pub fn skip_space_and_commas(input: String, cursor: &USize) -> Unit {
    while input.as_bytes().get(cursor.*).is_some_and(fn(byte) -> byte.is_ascii_whitespace() || byte == ',' as U8) { cursor.* += 1 }
}
// Rust: Compiler/Bootstrap/Host/RuntimeMirCodec.rs:2499
pub fn read_identifier(input: String, cursor: &USize) -> String Err! {
    start := cursor.*
    while input.as_bytes().get(cursor.*).is_some_and(fn(byte) -> byte.is_ascii_alphanumeric() || byte == '_' as U8) { cursor.* += 1 }
    if cursor.* == start { throw "expected MIR identifier at byte {start}" }
    input[start..cursor.*].to_string()
}
