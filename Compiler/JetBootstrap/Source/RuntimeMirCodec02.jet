pub fn unrepresentable_host_field(owner: String, source: &Variant, host: &Variant, aligned: &[USize?]) -> String? {
    host.fields.iter().zip(aligned).find_map(fn((field, source_index)) -> if source_index == {
        Val(_) -> None
        None -> host_only_variant_field(owner, source.name, field.name.as_deref()?)
    })
}
