fn split_backend_workspace(source: String) -> BackendWorkspace? {
    split :: split_runtime_crate(source) catch error { panic("backend source: {error}") }
    parts :: split ?? {
        assert(!source.contains(UNIT_BEGIN_MARKER), "unit-split backend source has no runtime block")
        return None
    }
    sections := [BootstrapSourceUnit]{}
    positions := [String:Int]{}
    main := ""
    open := Int?{None}
    loop line in parts.program.split_inclusive('\n') {
        if line.strip_prefix(UNIT_BEGIN_MARKER) == .Val(name_view) {
            name := name_view.trim_end() // #4303
            assert(open == None, "backend unit section `{name}` opens inside another section")
            index := positions.get(name)
            if index == None {
                index = Val(sections.len())
                positions[name] = sections.len()
                &sections.push(BootstrapSourceUnit{name: name, source: ""})
            }
            open = index
        } else if line.strip_prefix(UNIT_END_MARKER) == .Val(name_view) {
            index :: open ?? panic("backend unit section `{name_view.trim_end()}` closes without opening")
            open = None
            assert_eq(sections[index].name, name_view.trim_end(), "backend unit sections interleave")
        } else if open == .Val(index) -> &sections[index].source.push_str(line)
        else -> &main.push_str(line)
    }
    assert(open == None, "backend unit section is unterminated")
    catalog :: bootstrap_unit_catalog(sections)
    crate_names := [String]{}
    loop members in catalog.components {
        names := [String]{}
        loop member in members -> &names.push(sections[member].name)
        &names.sort()
        name :: names.join("_").to_ascii_lowercase()
        cleaned := ""
        loop character in name.chars() -> &cleaned.push(if character.is_ascii_alphanumeric() -> character else -> '_')
        &crate_names.push("jetc_{cleaned}")
    }
    units := [BackendUnit]{}
    loop (component, members) in catalog.components.iter().enumerate() {
        dependency_set := Set<Int>{}
        loop member in members {
            loop target in catalog.edges[member] {
                other :: catalog.component_of[target]
                if other != component -> _ :: &dependency_set.insert(other)
            }
        }
        dependency_indices := dependency_set.to_list()
        &dependency_indices.sort()
        deps := [String]{}
        loop target in dependency_indices -> &deps.push(crate_names[target])
        crate_name :: crate_names[component]
        prelude := "#![allow(warnings)]\nuse jet_runtime::*;\n"
        loop dep in deps -> &prelude.push_str("use {dep}::*;\n")
        text := ""
        loop member in members -> &text.push_str(sections[member].source)
        projected := ""
        shards := [BackendShard]{}
        if shard_unit(text, BACKEND_SHARD_BYTES) == .Val(sharded) {
            projected = "{prelude}{export_crate_source(sharded.facade)}unsafe extern \"Rust\" {{\n{sharded.declarations}}}\n"
            loop (index, shard_text) in sharded.shards.iter().enumerate() -> &shards.push(BackendShard{name: "{crate_name}_s{index}", source: "{prelude}use {crate_name}::*;\n{export_crate_source(shard_text)}", cold: false})
            loop (index, shard_text) in sharded.cold_shards.iter().enumerate() -> &shards.push(BackendShard{name: "{crate_name}_cold{index}", source: "{prelude}use {crate_name}::*;\n{export_crate_source(shard_text)}", cold: true})
        } else -> projected = "{prelude}{export_crate_source(text)}"
        &units.push(BackendUnit{crate_name: crate_name, deps: deps, source: projected, shards: shards})
    }
    anchor :: "use jet_runtime::*;\n"
    at :: (main.find(anchor) ?? panic("split backend main has no `jet_runtime` import")) + anchor.bytes().len()
    uses := ""
    loop unit in units {
        &uses.push_str("use {unit.crate_name}::*;\n")
        loop shard in unit.shards -> &uses.push_str("use {shard.name} as _;\n")
    }
    &main.insert_str(at, uses)
    Val(BackendWorkspace{runtime_lib: parts.runtime_lib, units: units, main: main})
}
