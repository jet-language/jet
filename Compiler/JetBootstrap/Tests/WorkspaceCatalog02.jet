    // GATE #4494: retained Rust test-peer subprocess; never a production bridge.
    response :: RustReference.compile_bundle_path_opts_with_source_closure_and_runtime(entry_path, .Check, false, .default(), false, false, false, false, None, None, "dev", [String:String]{}, false, None, source_closure, None)
