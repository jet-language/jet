// Rust: Compiler/Bootstrap/Tests.rs:2175
fn home_path() -> OSPath {
    // GATE #4494: native environment OS-string lookup, preserving non-UTF8 HOME.
    OSPath(env.var_os("HOME") ?? panic("HOME is required for the private bootstrap cache"))
}
// Rust: Compiler/Bootstrap/Tests.rs:2182
fn bootstrap_session_root() -> OSPath {
    // GATE #4494: native wall-clock and process identity.
    timestamp :: time.SystemTime.now().duration_since(time.UNIX_EPOCH) catch error { panic("system clock is before the Unix epoch: {error}") }
    home_path().join(".cache/jet-test-scratch").join("bootstrap-self-{process.id()}-{timestamp.as_nanos()}")
}
// Rust: Compiler/Bootstrap/Tests.rs:2193
fn assemble_compiler_sources(repo: OSPath, task_roots: Bool) {
    // GATE #4494: real child process with native cwd/environment removal.
    output :: Command.new(repo.join("Tools/agent/jet-env")).current_dir(repo).env_remove("CARGO_TARGET_DIR").args(["node", "Compiler/Bootstrap/assemble.mjs"]).output() catch error { panic("cannot run bootstrap assembler: {error}") }
    assert_command_success("bootstrap assembler", output)
    if !task_roots -> return
    compiler_entry :: home_path().join(BOOTSTRAP_PROJECT_RELATIVE).join(BOOTSTRAP_ENTRY_RELATIVE)
    compiler_source := fs.read_to_string(compiler_entry) catch error { panic("cannot read assembled compiler fixture `{compiler_entry}`: {error}") }
    &compiler_source.push_str("\n\n")
    &compiler_source.push_str(TASK_ROOTS_FIXTURE_SOURCE)
    fs.write(compiler_entry, compiler_source) catch error { panic("cannot add task-root fixture to the private compiler unit `{compiler_entry}`: {error}") }
}
// Rust: Compiler/Bootstrap/Tests.rs:2225
fn write_small_program(project: OSPath) -> OSPath {
    fs.create_dir_all(project) catch error { panic("cannot create small Jet project `{project}`: {error}") }
    manifest :: project.join("package.jet")
    entry :: project.join(SMALL_ENTRY_RELATIVE)
    fs.write(manifest, SMALL_PROGRAM_MANIFEST) catch error { panic("cannot write small Jet manifest `{manifest}`: {error}") }
    fs.write(entry, SMALL_PROGRAM_SOURCE) catch error { panic("cannot write small Jet source `{entry}`: {error}") }
    entry
}
// Rust: Compiler/Bootstrap/Tests.rs:2240
fn write_source_fixture_project(project: OSPath, manifest: String, source: String) -> OSPath {
    fs.create_dir_all(project) catch error { panic("cannot create source fixture project `{project}`: {error}") }
    manifest_path :: project.join("package.jet")
    entry :: project.join(SMALL_ENTRY_RELATIVE)
    fs.write(manifest_path, manifest) catch error { panic("cannot write source fixture manifest `{manifest_path}`: {error}") }
    fs.write(entry, source) catch error { panic("cannot write source fixture `{entry}`: {error}") }
    entry
}
// Rust: Compiler/Bootstrap/Tests.rs:2254
fn assert_mir_optimizer_fixtures(binary: OSPath, repo: OSPath, session: OSPath) {
    loop (name, fixture_path, expected_stdout) in [
        ("inline", "tests/fixtures/mir_optimizer_inline.jet", "inline:11\nfailure:negative\n"),
        ("loops", "tests/fixtures/mir_optimizer_loops.jet", "true true true true false\n"),
        ("source_regressions", "tests/fixtures/mir_optimizer_source_regressions.jet", "unit:body\ntrue true true true true true true\n"),
    ] {
        fixture_source :: fs.read_to_string(repo.join(fixture_path)) catch error { panic("cannot read MIR optimizer fixture `{fixture_path}`: {error}") }
        project :: session.join("optimizer-{name}")
        write_source_fixture_project(project, SOURCE_FIXTURE_MANIFEST, fixture_source)
        generated_source_path :: session.join("optimizer-{name}.rs")
        receipt :: session.join("optimizer-{name}.receipt")
        run_generated_artifact(binary, "factory", project, SMALL_ENTRY_RELATIVE, generated_source_path, receipt)
        assert_factory_receipt(receipt)
        generated_source :: fs.read_to_string(generated_source_path) catch error { panic("cannot read generated MIR optimizer backend for `{name}`: {error}") }
        backend_project :: session.join("optimizer-{name}-backend")
        (backend_binary, _) :: build_backend_artifact(repo, backend_project, "jet_bootstrap_optimizer_{name}", generated_source)
        output :: Command.new(backend_binary).output() catch error { panic("cannot execute MIR optimizer fixture `{name}`: {error}") }
        assert_command_success("MIR optimizer fixture `{name}`", output)
        assert_eq(String.from_utf8_lossy(output.stdout), expected_stdout, "generated compiler changed MIR optimizer fixture `{name}` behavior")
    }
}
// Rust: Compiler/Bootstrap/Tests.rs:2311
fn build_local_c_provider(root: OSPath, library: String, source: String) {
    source_path :: root.join("{library}.c")
    object_path :: root.join("{library}.o")
    archive_path :: root.join("lib{library}.a")
    fs.write(source_path, source) catch error { panic("cannot write C provider `{source_path}`: {error}") }
    compiler := String?{None}
    loop candidate in ["cc", "gcc", "clang"] {
        output :: Command.new(candidate).arg("--version").output().ok()
        if output == .Val(value) { if value.status.success() { compiler = Val(candidate); break } }
    }
    selected :: compiler ?? panic("C provider fixture requires cc, gcc, or clang")
    compile :: Command.new(selected).arg("-c").arg(source_path).arg("-o").arg(object_path).output() catch error { panic("cannot compile C provider `{source_path}`: {error}") }
    assert_command_success("native C provider compile", compile)
    archive :: Command.new("ar").arg("rcs").arg(archive_path).arg(object_path).output() catch error { panic("cannot archive C provider `{archive_path}`: {error}") }
    assert_command_success("native C provider archive", archive)
}
// Rust: Compiler/Bootstrap/Tests.rs:2344
fn compile_and_run_source_fixture(compiler: OSPath, repo: OSPath, session: OSPath, label: String, project: OSPath, expected_stdout: String) {
    raw_source :: session.join("{label}.raw.rs")
    receipt :: session.join("{label}.receipt")
    run_generated_artifact(compiler, "runner", project, SMALL_ENTRY_RELATIVE, raw_source, receipt)
    assert_runner_receipt(receipt)
    source :: fs.read_to_string(raw_source) catch error { panic("generated compiler did not emit `{raw_source}`: {error}") }
    backend_project :: session.join("{label}-backend")
    (binary, _) :: build_backend_artifact(repo, backend_project, label, source)
    output :: Command.new(binary).output() catch error { panic("cannot execute generated `{label}` fixture: {error}") }
    assert_command_success("generated `{label}` fixture", output)
    assert_eq(String.from_utf8_lossy(output.stdout), expected_stdout, "generated `{label}` fixture output differs from its executable source contract")
}
// Rust: Compiler/Bootstrap/Tests.rs:2379
fn compile_and_run_source_fixture_with_native_library(compiler: OSPath, repo: OSPath, session: OSPath, label: String, project: OSPath, expected_stdout: String, native_library: (OSPath, String)?) {
    raw_source :: session.join("{label}.raw.rs")
    receipt :: session.join("{label}.receipt")
    run_generated_artifact(compiler, "runner", project, SMALL_ENTRY_RELATIVE, raw_source, receipt)
    assert_runner_receipt(receipt)
    source :: fs.read_to_string(raw_source) catch error { panic("generated compiler did not emit `{raw_source}`: {error}") }
    backend_project :: session.join("{label}-backend")
    (binary, _) :: build_backend_artifact_with_native_library(repo, backend_project, label, source, None, native_library, None)
    output :: Command.new(binary).output() catch error { panic("cannot execute generated `{label}` fixture: {error}") }
    assert_command_success("generated `{label}` fixture", output)
    assert_eq(String.from_utf8_lossy(output.stdout), expected_stdout, "generated `{label}` fixture output differs from its executable source contract")
}
