// Rust: Compiler/Bootstrap/Tests.rs:2667
fn append_generated_artifact_main(source: String, task_roots: Bool) -> String {
    complete := ^source
    if task_roots { &complete.push_str(GENERATED_ARTIFACT_MAIN); return complete }
    rest := GENERATED_ARTIFACT_MAIN
    loop {
        begin :: rest.find(TASK_ROOTS_BEGIN) ?? break
        &complete.push_str(rest[..<begin])
        end :: rest[begin..].find(TASK_ROOTS_END) ?? panic("generated artifact main has an unterminated task-root region")
        rest = rest[(begin + end + TASK_ROOTS_END.bytes().len())..]
    }
    &complete.push_str(rest)
    complete
}
