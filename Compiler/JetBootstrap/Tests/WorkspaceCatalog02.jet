fn write_backend_workspace(units_root: OSPath, workspace: BackendWorkspace, ffi: BackendFfiCrate?) -> String {
    ffi_dependency :: if ffi == { Val(value) -> value.dependency() None -> "" }
    runtime_digest :: sha256_hex("{ffi_dependency}{TEXT_NUL}{workspace.runtime_lib}".bytes())
    runtime_dir_name :: "jet_runtime_{runtime_digest[..<16]}"
    runtime_dir :: units_root.join(runtime_dir_name)
    write_backend_crate(runtime_dir, "jet_runtime", [], ffi_dependency, workspace.runtime_lib)
    dependencies := "jet_runtime = {{ path = {rust_debug_string(runtime_dir.display())} }}\n"
    unit_extra_dependencies :: "jet_runtime = {{ path = \"../{runtime_dir_name}\" }}\n{ffi_dependency}"
    loop unit in workspace.units {
        dir :: units_root.join(unit.crate_name)
        deps := unit.deps
        write_backend_crate(dir, unit.crate_name, deps, unit_extra_dependencies, unit.source)
        &dependencies.push_str("{unit.crate_name} = {{ path = {rust_debug_string(dir.display())} }}\n")
        &deps.push(unit.crate_name)
        loop shard in unit.shards {
            shard_dir :: units_root.join(shard.name)
            write_backend_crate(shard_dir, shard.name, deps, unit_extra_dependencies, shard.source)
            &dependencies.push_str("{shard.name} = {{ path = {rust_debug_string(shard_dir.display())} }}\n")
        }
    }
    dependencies
}
