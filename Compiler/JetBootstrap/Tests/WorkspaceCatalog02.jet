fn assert_evaluator_materialization_helpers_in_mir(mir: MIRProgram) {
    loop helper_name in ["jet_eval_materialize_string_window", "jet_eval_materialize_list_window", "jet_eval_materialize_bytes_window"] {
        by_name := mir.functions.iter().filter(fn(function) { function.name == helper_name })
        helper :: &by_name.next() ?? panic("full-manifest MIR lacks evaluator helper `{helper_name}`")
        assert(&by_name.next() == None, "full-manifest MIR has ambiguous evaluator helper `{helper_name}`")
        function_id :: helper.id
        by_identity := mir.functions.iter().filter(fn(function) { function.id == function_id })
        checked_helper :: &by_identity.next() ?? panic("checked evaluator helper `{helper_name}` lost its function ID")
        assert(&by_identity.next() == None, "checked evaluator helper `{helper_name}` has a duplicate MIR function ID")
        assert(checked_helper.blocks.any(fn(block) { block.instructions.any(fn(instruction) { if instruction.operation == { .Copy(_, fact) -> fact == MIRCopyFact.ViewMaterialize else -> false } }) }), "checked evaluator helper `{helper_name}` ({function_id}) must contain a materializing Copy")
    }
}
