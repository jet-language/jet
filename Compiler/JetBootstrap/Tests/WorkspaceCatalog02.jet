    if release == {
        None -> {
            &out.push_str("\n[profile.dev.package.jet_runtime]\n{BACKEND_UNIT_PROFILE}")
            loop unit in workspace.units -> &out.push_str("\n[profile.dev.package.{unit.crate_name}]\n{BACKEND_UNIT_PROFILE}")
            loop unit in workspace.units { loop shard in unit.shards -> &out.push_str("\n[profile.dev.package.{shard.name}]\n{BACKEND_UNIT_PROFILE}") }
        }
        Val(profile) -> {
            loop unit in workspace.units { loop shard in unit.shards { if shard.cold -> &out.push_str("\n[profile.{profile}.package.{shard.name}]\n{BACKEND_COLD_PROFILE}") } }
        }
    }
    out
}
// Rust: Compiler/Bootstrap/Tests.rs:3204
fn write_backend_crate(dir: OSPath, name: String, deps: [String], extra_dependencies: String, lib: String) {
    manifest := "[package]\nname = {rust_debug_string(name)}\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\n"
    loop dep in deps -> &manifest.push_str("{dep} = {{ path = \"../{dep}\" }}\n")
    &manifest.push_str(extra_dependencies)
    loop (path, text) in [(dir.join("Cargo.toml"), manifest), (dir.join("src/lib.rs"), lib)] {
        if fs.read(path).ok() == .Val(existing) { if existing == text.bytes() -> next }
        if path.parent() == .Val(parent) -> fs.create_dir_all(parent) catch error { panic("cannot create backend crate directory `{parent}`: {error}") }
        fs.write(path, text) catch error { panic("cannot write backend crate file `{path}`: {error}") }
    }
}
// Rust: Compiler/Bootstrap/Tests.rs:3227
struct ShardedUnit { facade: String, declarations: String, shards: [String], cold_shards: [String] }
// Rust: Compiler/Bootstrap/Tests.rs:3241
struct MovedFunction { declaration: String, definition: String, cold: Bool }
// Rust: Compiler/Bootstrap/Tests.rs:3262
fn shard_unit(text: String, shard_bytes: Int) -> ShardedUnit? {
    if text.bytes().len() <= shard_bytes -> return None
    mask :: rust_code_mask(text)
    (items, end) :: masked_items(mask)
    facade := ""
    uses := ""
    declarations := ""
    moved := [MovedFunction]{}
    loop (start, stop) in items {
        item :: text[start..<stop]
        code :: mask[start..<stop]
        head :: code[item_head(code)..]
        if head.starts_with("macro_rules!") -> return None
        if head.starts_with("use ") || head.starts_with("pub use ") -> &uses.push_str(item)
        if movable_function(item, code) == .Val(function) {
            &declarations.push_str(function.declaration)
            &moved.push(function)
        } else if delegate_impl_methods(item, code) == .Val((rewritten, functions)) {
            &facade.push_str(rewritten)
            loop function in functions { &declarations.push_str(function.declaration); &moved.push(function) }
        } else -> &facade.push_str(item)
    }
    &facade.push_str(text[end..])
    shards := [String]{}
    cold_shards := [String]{}
    loop function in moved {
        if function.cold {
            last :: cold_shards.len() - 1
            if last >= 0 && cold_shards[last].bytes().len() + function.definition.bytes().len() <= shard_bytes -> &cold_shards[last].push_str(function.definition)
            else -> &cold_shards.push("{uses}{function.definition}")
        } else {
            last :: shards.len() - 1
            if last >= 0 && shards[last].bytes().len() + function.definition.bytes().len() <= shard_bytes -> &shards[last].push_str(function.definition)
            else -> &shards.push("{uses}{function.definition}")
        }
    }
    Val(ShardedUnit{facade: facade, declarations: declarations, shards: shards, cold_shards: cold_shards})
}
