// Original Compiler/Bootstrap/Tests.rs:3617 unit fixture and dependency graph.
// Exercises the catalog/SCC operation, not yet the gated split/export/shard or
// native backend build; the full original backend witness remains required.
#Test("bootstrap unit catalog orders the original graph and merges cycles") {
    units :: [BootstrapSourceUnit]{
        BootstrapSourceUnit{name: "base", source: "fn __jet_base_item() {{}}\ntrait __jet_BaseStore {{\n    fn __jet_gamma_field(&self);\n}}\n"},
        BootstrapSourceUnit{name: "Alpha", source: "fn __jet_alpha() {{ __jet_base_item(); __jet_beta(); }}\n"},
        BootstrapSourceUnit{name: "Beta", source: "fn __jet_beta() {{ __jet_alpha(); }}\n"},
        BootstrapSourceUnit{name: "Gamma", source: "struct __jet_Gamma {{ __jet_gamma_field: i64 }}\nfn __jet_gamma() {{ __jet_beta(); }}\n"},
    }
    catalog :: bootstrap_unit_catalog(units)
    assert_eq(catalog.edges, [[Int]]{[Int]{}, [Int]{0, 2}, [Int]{1}, [Int]{2}})
    assert_eq(catalog.components, [[Int]]{[Int]{0}, [Int]{1, 2}, [Int]{3}})
    assert_eq(catalog.component_of, [Int]{0, 1, 1, 2})
}
#Test("bootstrap unit catalog preserves first definition and whole identifiers") {
    units :: [BootstrapSourceUnit]{
        BootstrapSourceUnit{name: "first", source: "pub(crate) unsafe extern \"C\" fn __jet_shared() {{}}\n"},
        BootstrapSourceUnit{name: "second", source: "fn __jet_shared() {{}}\n"},
        BootstrapSourceUnit{name: "foreign", source: "unsafe extern \"C\" {{\n    fn __jet_foreign();\n}}\n"},
        BootstrapSourceUnit{name: "use", source: "fn __jet_user() {{ __jet_shared(); __jet_foreign(); not__jet_shared(); }}\n"},
    }
    catalog :: bootstrap_unit_catalog(units)
    assert_eq(catalog.edges[3], [Int]{0, 2})
}
#Test("bootstrap SCC retains isolated roots self edges and dependency order") {
    edges :: [[Int]]{[Int]{0}, [Int]{2}, [Int]{3}, [Int]{1}, [Int]{0, 1}}
    assert_eq(bootstrap_strongly_connected_units(edges), [[Int]]{[Int]{0}, [Int]{1, 2, 3}, [Int]{4}})
    assert_eq(bootstrap_strongly_connected_units([[Int]]{}), [[Int]]{})
}
