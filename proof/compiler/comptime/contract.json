{
  "schema": "jet.comptime-contract.v1",
  "schema_version": 1,
  "contract_id": "jet-comptime-contract-v1",
  "stage": "comptime",
  "owner": "#2938",
  "policy": {
    "decision_id": "D-COMPILER-PROOF1",
    "outcome": "A",
    "status": "ratified",
    "scope": "every Jet-controlled compile-time evaluation and build-cache boundary before 1.0",
    "foreign_suffix": "foreign compiler tools, foreign libraries, operating systems, networks, and external services remain explicit assumptions"
  },
  "claim": {
    "kind": "conditional-comptime-preservation",
    "statement": "For an identified accepted Jet source and stated resource and foreign assumptions, the compile-time evaluator preserves the shared value, failure, mutation, input, effect, cleanup, and schedule observations allowed by the canonical source semantics; finite evidence remains bounded and cannot prove every accepted program.",
    "preconditions": [
      "The source bytes, imported module closure, checked body semantic hash, build facts, and dependency interfaces are identified.",
      "The source is accepted by the published parser, sema, purity, generic-module, and build-time I/O rules.",
      "The canonical MIR evaluator receives the checked types, Core registry route, globals, mutable bindings, gates, and finite fuel budget.",
      "Target dossier, profile, effect policy, layout, compiler ABI/schema, evaluator artifact, toolchain, and configuration are identity-bound.",
      "Foreign Core adapters, operating-system behavior, external resources, and build tools satisfy their named contracts.",
      "A failed, cancelled, exhausted, unsupported, unknown, stale, or unavailable evaluation is retained as blocking evidence and never as a valid cache result."
    ],
    "observation_alphabet": [
      "result",
      "typed_failure",
      "mutation",
      "input_consumption",
      "ordered_effects",
      "cleanup",
      "resource_premises",
      "schedule",
      "allowed_schedules"
    ],
    "permitted_resource_failures": [
      "ResourceExhausted",
      "InputUnavailable",
      "Cancelled"
    ],
    "trusted_components": [
      "ratified Jet comptime, generic-module, Core, Prelude, cache, and diagnostic specifications",
      "the canonical jet-comptime MIR evaluator and its checked source inputs",
      "the canonical sema/Facts/TIR cache and dependency identity carriers",
      "the pinned identity claim from jet.compiler-proof.v1",
      "named foreign compiler, runtime, operating-system, filesystem, network, and service contracts"
    ],
    "unsupported_cases": [
      "an unlisted AST, TIR, MIR, Core receiver, generic value, template, or build-time operation",
      "a missing or unknown Core registry route or a route without an executable interpreter projection",
      "purity, fuel, panic, overflow, divide-by-zero, path, network, vault, or other registered rejection not observed through its diagnostic",
      "unbounded scheduling, concurrency, progress, resource, FFI, ABI/layout, browser, or external-service claims",
      "a changed source, imported fact, dependency interface, evaluator artifact, compiler configuration, target, checker, witness, or proof identity"
    ]
  },
  "evaluator": {
    "model": {
      "id": "jet-comptime-evaluator-state-model-v1",
      "state": [
        "CtValue or CtReport outcome",
        "typed globals and active scope",
        "mutable receiver and binding updates",
        "Core imports and registry route",
        "purity/effect gates and impure depth",
        "literal build inputs and their SHA-256 records",
        "finite fuel and interruption state",
        "checked structs, methods, conversions, and generic facts",
        "ordered effect and cleanup observations"
      ],
      "transitions": [
        "evaluate a closed expression through the installed canonical MIR evaluator",
        "evaluate a statement block while retaining scope and receiver mutations",
        "route user and Core calls through the checked registry and shared Prelude operation",
        "carry Present, clean absence, and told failure through one outcome carrier",
        "record sanctioned literal build inputs before publishing semantic cache facts",
        "stop on purity, unsupported, resource, panic, fuel, or cancellation obligations",
        "normalize generic module values only after finite closed evaluation",
        "publish only a completed identity-bound result"
      ],
      "failure_codes": [
        "E0952",
        "E0953",
        "E0955",
        "E0956",
        "E0957",
        "E0958",
        "E0959",
        "E1265",
        "E3401",
        "E3413",
        "E3414"
      ]
    },
    "implementation": {
      "id": "jet-comptime-canonical-mir-v1",
      "crate": "crates/jet-comptime",
      "entrypoints": [
        "evaluate_with_imports_opts",
        "evaluate_owned_with_imports_opts",
        "evaluate_with_imports_opts_collecting",
        "run_build_entry_with_policy",
        "MirBridge::eval_expr",
        "MirBridge::eval_block",
        "MirBridge::mir_to_ct_value"
      ],
      "canonical_seam": "crates/jet-comptime/src/Comptime/MirBridge.rs",
      "fuel_budgets": {
        "binding": 10000000,
        "dev": 1000000000,
        "repl": 10000000
      },
      "no_second_engine": true
    },
    "resource_premises": [
      "fuel is finite and exhaustion is E0952/E2202 rather than successful completion",
      "literal embed/find/fetch inputs are project-relative, hashed, and retained as ComptimeInput facts",
      "foreign host/effect calls require their checked gate and named adapter",
      "allocation, stack, target layout, and external resource failures stay explicit"
    ]
  },
  "cache": {
    "key_schema": "jet.comptime-cache-key.v1",
    "required_inputs": [
      "source_bytes_sha256",
      "imported_module_closure_sha256",
      "checked_body_semantic_hash",
      "compiler_abi_schema",
      "target_dossier",
      "profile",
      "effects",
      "layout",
      "dependency_interfaces",
      "build_facts",
      "evaluator_artifact_identity",
      "configuration",
      "policy",
      "toolchain"
    ],
    "invalidation_events": [
      "source_dependency_changed",
      "imported_fact_changed",
      "compiler_abi_changed",
      "target_profile_effect_changed",
      "evaluator_artifact_changed",
      "configuration_changed",
      "interrupted_before_publish",
      "failed_without_outputs"
    ],
    "publication_rules": [
      "FrontEndCompletion::authorize_cache_lookup must succeed before any cache lookup",
      "the action key includes source, imports, checked body, compiler ABI, target, profile, effects, layout, facts, evaluator, configuration, policy, and toolchain",
      "a changed identity is a miss and cannot reuse a prior compile-time result",
      "cancellation is checked under the remote commit lock before validation and before atomic publication",
      "a cancelled or incomplete evaluation cannot publish a valid cache entry",
      "a failed cached action retains a structured failure report and no declared outputs"
    ],
    "lookup_gate": "FrontEndCompletion::authorize_cache_lookup",
    "action_key": "canonical_effective_action_key"
  },
  "execution": {
    "schema": "jet.comptime-witness-mapping.v1",
    "runner": "scripts/agent/jet-env",
    "compiler": "target/debug/jet",
    "operations": [
      "run",
      "check"
    ],
    "modes": [
      "aot",
      "jet_run",
      "interpreter",
      "check"
    ],
    "observation_fields": [
      "result",
      "typed_failure",
      "mutation",
      "input_consumption",
      "ordered_effects",
      "cleanup",
      "resource_premises",
      "schedule",
      "allowed_schedules"
    ],
    "identity_fields": [
      "source_sha256",
      "program_sha256",
      "dependency_closure_sha256",
      "configuration_sha256",
      "evaluator_sha256",
      "compiler_identity",
      "checker_sha256",
      "target",
      "obligations_sha256"
    ],
    "timeout_ms": 120000,
    "unknown_status": "unverified",
    "resource_policy": "unknown, unavailable, exhausted, cancelled, and foreign-resource observations remain unproved",
    "observation_policy": "authored source witnesses are never executed or promoted to proof by this checker; live mode evidence must bind every identity field",
    "observation_certificates": {
      "path": "proof/compiler/comptime/observations.json",
      "schema": "jet.comptime-observations.v1",
      "positive_status": "verified",
      "producer": "proof/compiler/comptime/observe.mjs",
      "required_identity_fields": [
        "source_sha256",
        "program_sha256",
        "dependency_closure_sha256",
        "configuration_sha256",
        "evaluator_sha256",
        "compiler_identity",
        "checker_sha256",
        "target",
        "obligations_sha256"
      ],
      "required_observations": [
        "result",
        "typed_failure",
        "mutation",
        "input_consumption",
        "ordered_effects",
        "cleanup",
        "resource_premises",
        "schedule",
        "allowed_schedules"
      ],
      "universal_proof": false
    }
  },
  "binding_methods": [
    {
      "method": "verified_construction",
      "source": "contract.evaluator.model and ratified comptime/cache rules",
      "implementation": "the canonical MirBridge evaluator, interpreter state, Core registry, sema, and cache publication paths",
      "construction": "state/effect/failure/cache transition obligations carried by the one evaluator seam",
      "checker": "proof/compiler/comptime/check.mjs",
      "limit": "the structural model and source correspondence do not prove the complete production implementation"
    },
    {
      "method": "direct_verification",
      "source": "the identity-bound production source map and jet.compiler-proof.v1 claim",
      "implementation": "the checked jet-comptime, jet-sema, jet-foundation, and jet-codegen artifacts named by source_bindings",
      "candidate_binding": "identity.candidate plus exact source/dependency/configuration/evaluator digests",
      "checker": "proof/compiler/comptime/check.mjs",
      "limit": "foreign tools and unexecuted target modes remain explicit assumptions"
    },
    {
      "method": "translation_certificate",
      "source": "proof/compiler/comptime/witnesses.json",
      "implementation": "the canonical evaluator and cache identity mechanisms",
      "certificate": "mixed mutation/fallibility witnesses and explicit negative/cache invalidation controls",
      "checker": "proof/compiler/comptime/check.mjs",
      "limit": "finite authored evidence is unverified in this phase and never a universal preservation claim"
    }
  ],
  "identity": {
    "schema": "jet.compiler-proof.v1",
    "manifest_path": "proof/compiler/toolchain/manifest.json",
    "authority_key": "compiler-proof.comptime",
    "claim_id": "compiler-proof.identity-direct",
    "identity_digest_source": "scripts/agent/compiler-proof.mjs:identityDigest",
    "required_fields": [
      "claim.identity_sha256",
      "candidate.record_identity.target_inputs_sha256",
      "candidate.record_identity.tool_version",
      "candidate.record_identity.engine",
      "candidate.commit",
      "candidate.compiler.source",
      "candidate.compiler.artifact",
      "candidate.configuration",
      "candidate.target",
      "checker.toolchain_pin_sha256",
      "proof.artifact",
      "raw_replay"
    ]
  },
