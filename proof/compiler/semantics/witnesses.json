{
  "schema": "jet.semantic-witnesses.v1",
  "schema_version": 1,
  "relation": "ordered_effects",
  "observation_fields": [
    "result",
    "typed_failure",
    "mutation",
    "input_consumption",
    "ordered_effects",
    "cleanup",
    "resource_premises",
    "schedule",
    "allowed_schedules"
  ],
  "identity_fields": ["program_sha256", "source_sha256"],
  "runner": {
    "launcher": "scripts/agent/jet-env",
    "invocation": "scripts/agent/jet-env full followed by the declared Jet operation and tier arguments",
    "compiler": "target/debug/jet",
    "supported_operations": ["run", "check"],
    "tiers": ["aot", "jet_run", "interpreter", "check"],
    "scratch": "$HOME/.cache/jet-test-scratch",
    "timeout_ms": 120000,
    "unknown_policy": "unverified mappings never become comparison evidence; unknown resource observations remain unproved"
  },
  "coverage": {
    "relation": "proof/compiler/obligations.json",
    "mapping_statuses": ["mapped_unproved", "unsupported", "unmapped", "proved"],
    "qualification_rule": "model agreement is tested evidence; an obligation is proved only after complete identity-bound Jet observations, and no current witness claims that state"
  },
  "cases": [
    {
      "id": "value-mutation-cleanup",
      "category": "mutation",
      "obligations": [
        "syntax-registry-001-none-910625f0",
        "tir-expr:TExprKind.Local",
        "tir-expr:TExprKind.Binary",
        "tir-stmt:TStmt.Let",
        "tir-stmt:TStmt.Assign",
        "tir-stmt:TStmt.Return",
        "tir-stmt:TStmt.DeferClose"
      ],
      "program": {
        "version": 1,
        "fuel": 32,
        "steps": [
          { "kind": "defer", "event": "scope.closed" },
          { "kind": "let", "name": "counter", "expr": { "kind": "literal", "value": 1 } },
          {
            "kind": "set",
            "name": "counter",
            "expr": {
              "kind": "add",
              "left": { "kind": "var", "name": "counter" },
              "right": { "kind": "literal", "value": 2 }
            }
          },
          { "kind": "emit", "event": "counter.updated" },
          { "kind": "return", "expr": { "kind": "var", "name": "counter" } }
        ]
      },
      "expect": { "accepted": true, "result": "value", "value": 3, "mutation": true, "cleanup": true },
      "jet": {
        "status": "unverified",
        "source_mode": "inline",
        "entry": "main.jet",
        "source": "fn run() {\n    counter := 1\n    counter += 2\n    print(\"SEMANTIC_RESULT:{counter}\")\n}\n",
        "source_sha256": "sha256-58545490cefbaedf5bdd102940fac0e1dd538afb75636cc66f5e59b05b56df5e",
        "program_sha256": "sha256-fa86e79ca34202a9b0a2dabe03097bb9ebb3d7cfad44beffd04ed5a1f37b58f1",
        "runner": {
          "operation": "run",
