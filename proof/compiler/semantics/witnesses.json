            "result": { "status": "observed", "from": "stdout", "encoding": "json" },
            "typed_failure": { "status": "unobserved", "reason": "the source mapping has no stable typed-failure channel" },
            "mutation": { "status": "unobserved", "reason": "the source mapping does not serialize the before/after store" },
            "input_consumption": { "status": "unobserved", "reason": "the source mapping has no input trace channel" },
            "ordered_effects": { "status": "unobserved", "reason": "print output is not a complete effect trace" },
