// Web number-series widget: export the series kernel to the generated Wasm
// module, then let the JS-target entry point print the observable transcript.
#WasmExport
fn triangular(n: Int) Int -> {
    total := 0
    loop i in 1..n -> total += i
    return total
}

#Target(JS)
fn run() {
    sum := 0
    loop i in 1..12 {
        value := triangular(i)
        print("t{i} {value}")
        sum += value
    }
    print("sum {sum}")
}
