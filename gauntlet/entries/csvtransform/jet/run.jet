use core.[data, files]

#Codable
struct Sale {
    region: String
    amount: Decimal
}

#CLI
struct Args {
    input: String
}

fn run(args: Args) {
    text :: files.read(args.input) ?? panic("read failed")
    sales :: data.csv<Sale>(text) ?? panic("csv failed")
    included :: data.query(sales)
        .filter(sale -> (sale.amount.to_string().to_float() ?? 0.0) > 0.0)
        .collect() ?? panic("filter failed")
    groups := data.query(included)
        .group_by(sale -> sale.region)
        .sum(sale -> sale.amount.to_string().to_float() ?? 0.0)
        .collect() ?? panic("group sum")
    counts :: data.query(included)
        .group_by(sale -> sale.region)
        .count()
        .collect() ?? panic("group count")
    groups.sort_by(group -> group.key)
    loop group in groups {
        count := 0
        loop entry in counts {
            if entry.key == group.key {
                count = entry.value
                break
            }
        }
        sum :: "{group.value:Fixed(2)}"
        print("{group.key} n={count} sum={sum}")
    }
    total :: included.fold(Decimal("0.00"), (total, sale) -> total + sale.amount)
    sum :: total.to_string()
    print("total n={included.len()} sum={sum}")
}
