use core.[data, files]

struct Sale {
    region: String
    amount: Float
}

#CLI
struct Args {
    input: String
}

fn run(args: Args) {
    text :: files.read(args.input) ?? panic("read failed")
    sales :: data.csv<Sale>(text) ?? panic("csv failed")
    positive :: data.filter(sales, sale -> sale.amount > 0.0)
    loop group in data.group_sum(positive, sale -> sale.region, sale -> sale.amount) {
        sum :: "{group.sum:Fixed(2)}"
        print("{group.key} n={group.count} sum={sum}")
    }
    total :: positive.fold(Float{0.0}, (total, sale) -> total + sale.amount)
    sum :: "{total:Fixed(2)}"
    print("total n={positive.len()} sum={sum}")
}
