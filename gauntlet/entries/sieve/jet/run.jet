use core.math as math

#CLI struct Args { n: Int }

fn run(args: Args) {
    n :: args.n
slots :: n /% 2
prime := [Bool]{n > 2}.cycle(slots).to_list()
loop p := 3, p * p < n {
    if prime[p /% 2] -> loop m in p * p /% 2..<slots, p -> prime[m] = false
    p += 2
}
count :: prime.count(true)
largest :: if n > 2 -> math.max(2, (prime.last_index_of(true) ?? 0) * 2 + 1) else -> 0
print("count {count}\nlargest {largest}")
}
