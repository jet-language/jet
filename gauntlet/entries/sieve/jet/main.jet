use core.process as process

fn sieve(n: Int) [U8] -> {
    prime := [U8]{1}.cycle(n).to_list()
    if n > 0 -> prime[0] = 0
    if n > 1 -> prime[1] = 0
    p := 3
    loop p * p < n {
        if prime[p] == 1 {
            multiple := p * p
            loop multiple < n {
                prime[multiple] = 0
                multiple += p * 2
            }
        }
        p += 2
    }
    return prime
}

fn run() {
    args :: process.argv()
    n :: Int.parse(args.get(1) ?? "0") ?? 0
    prime :: sieve(n)
    count := 0
    largest := 0
    if n > 2 {
        count = 1
        largest = 2
        i := 3
        loop i < n {
            if prime[i] == 1 {
                count += 1
                largest = i
            }
            i += 2
        }
    }
    print("count {count}")
    print("largest {largest}")
}
