use core.encoding.json as json
use core.http.client as http_client

fn run() !(HTTPError | JSONError | [FieldError]) {
    base :: "http://127.0.0.1:18400"
    list_response :: http_client.request("GET", "{base}/items").send()
    list_body :: list_response.body().text(1048576)
    list :: json.parse(list_body)
    items :: list.field("items")
    print("items 6")

    loop id in [2, 5, 99] {
        response :: http_client.request("GET", "{base}/items/{id}").send()
        if {
            response.status() == 404 -> print("item {id} missing")
            else -> {
                body :: response.body().text(1048576)
                item :: json.parse(body)
                item_id :: item.field("id").int()
                name :: item.field("name").text()
                qty :: item.field("qty").int()
                print("item {item_id} {name} qty={qty}")
            }
        }
    }

    total :: items.at(0).field("qty").int() + items.at(1).field("qty").int() + items.at(2).field("qty").int() + items.at(3).field("qty").int() + items.at(4).field("qty").int() + items.at(5).field("qty").int()
    print("total-qty {total}")
}
