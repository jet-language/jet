use core.[encoding.json, http.client]

struct Item { id: Int, name: String, qty: Int }
struct Listing { items: [Item] }

#CLI
struct Args {
    base: String
}

fn run(args: Args) !(HTTPError | [FieldError]) -> {
    base :: args.base
    listing :: json.decode<Listing>(client.get("{base}/items").body().text(1048576))
    print("items {listing.items.len()}")

    loop id in [2, 5, 99] {
        response :: client.get("{base}/items/{id}")
        if {
            response.status() == 404 -> print("item {id} missing")
            else -> {
                item :: json.decode<Item>(response.body().text(1048576))
                print("item {item.id} {item.name} qty={item.qty}")
            }
        }
    }
    print("total-qty {listing.items.map(item -> item.qty).sum()}")
}
