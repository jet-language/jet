use core.[data, files]

#CLI struct Args { path: String }

struct Measurement { group: String, value: Float }

fn run(args: Args) !(IOError | [FieldError]) {
    measurements :: data.csv<Measurement>(files.read(args.path))
    loop (name, rows) in measurements.group_by(.group) {
        values :: rows.map(.value)
        stats :: data.describe(values)
        n :: stats.count
        sorted := ~values
        sorted.sort()
        print("{name} n={n} mean={stats.mean:Fixed(2)} median={sorted[(n - 1) /% 2]:Fixed(2)} p95={sorted[(n * 19 - 1) /% 20]:Fixed(2)} sd={stats.stddev:Fixed(2)}")
    }
    overall :: data.describe(measurements.map(.value))
    print("overall n={overall.count} mean={overall.mean:Fixed(2)}")
}
