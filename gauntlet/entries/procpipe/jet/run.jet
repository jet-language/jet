use core.process as process

fn run() {
    calculation :: process.cmd(["python3", "-c", "print(6*7)"]).run() ?? panic("calc failed")
    print("calc {calculation.output.trim()}")
    sorted_output :: process.pipeline([process.cmd(["python3", "-c", "print('b');print('a');print('c')"]), process.cmd(["sort"])]) ?? panic("sort failed")
    print("sorted {sorted_output.output.trim().lines().join(",")}")
    timeout_probe :: process.cmd(["python3", "-c", "import time;time.sleep(5)"]).timeout(300ms).run() ?? panic("slow failed")
    if timeout_probe.timed_out -> print("slow timeout")
    exit_probe :: process.cmd(["python3", "-c", "import sys;sys.exit(3)"]).run() ?? panic("checked process failed")
    if !exit_probe.success -> print("exit {exit_probe.code}")
}
