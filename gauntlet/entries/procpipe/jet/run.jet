use core.process as process

fn run() {
    calc :: process.run(["python3", "-c", "print(6*7)"]) ?? panic("calc failed")
    print("calc {calc.output.trim()}")
    sorted :: process.pipeline([process.cmd(["python3", "-c", "print('b');print('a');print('c')"]), process.cmd(["sort"])]) ?? panic("sort failed")
    print("sorted {sorted.output.trim().lines().join(",")}")
    slow :: process.cmd(["python3", "-c", "import time;time.sleep(5)"]).timeout(300ms).run() ?? panic("slow failed")
    if slow.timed_out -> print("slow timeout")
    checked :: process.run(["python3", "-c", "import sys;sys.exit(3)"]) ?? panic("checked process failed")
    if !checked.success -> print("exit {checked.code}")
}
