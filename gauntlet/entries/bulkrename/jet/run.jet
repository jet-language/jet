use core.[files, regex]

#CLI
struct Args {
    path: String
}

struct Photo {
    number: Int
    name: String
    path: String
}

fn run(args: Args) {
    directory :: args.path
    entries :: files.list_dir(directory) ?? panic("cannot list directory")
    pattern :: Regex{"^IMG_(\d+)\.jpeg$"}
    photos := entries.filter(entry -> !entry.is_dir && pattern.is_match(entry.name)).map(entry -> {
        match :: pattern.match(entry.name) ?? panic("bad photo")
        Photo{
            number: Int.parse(match.group(1) ?? panic("bad photo")) ?? panic("bad photo"),
            name: entry.name,
            path: entry.path,
        }
    })
    photos.sort_by(photo -> photo.number)
    loop (index, photo) in photos {
        ordinal :: "{index + 1}".pad_start(4, "0")
        target_name :: "photo-{ordinal}.jpg"
        files.rename(photo.path, Path.from(directory).join(target_name)) ?? panic("cannot rename photo")
        print("renamed {photo.name} -> {target_name}")
    }
    print("renamed {photos.len()} skipped {entries.count_where(entry -> !entry.is_dir) - photos.len()}")
}
