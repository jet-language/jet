#CLI
struct Args {
    steps: Int
}

fn energy(bodies: [(position: Vec3, velocity: Vec3, mass: Float)]) Float -> {
    total := Float{0.0}
    loop (i, body) in bodies {
        total += Float{0.5} * body.mass * body.velocity.dot(body.velocity)
        loop j in (i + 1)..<bodies.len() {
            other :: bodies[j]
            total -= body.mass * other.mass / (body.position - other.position).length()
        }
    }
    total
}

fn offset_momentum(bodies: &[(position: Vec3, velocity: Vec3, mass: Float)]) {
    momentum := Vec3.splat(0.0)
    loop i in 1..<bodies.len() {
        body :: bodies[i]
        momentum += body.velocity * Vec3.splat(body.mass)
    }
    sun := bodies[0]
    sun.velocity = Vec3.splat(Float{-1.0} / sun.mass) * momentum
    bodies[0] = sun
}

fn advance(bodies: &[(position: Vec3, velocity: Vec3, mass: Float)], steps: Int) {
    dt :: Float{0.01}
    loop _ in 0..<steps {
        loop i in bodies.indexes() {
            loop j in (i + 1)..<bodies.len() {
                left := bodies[i]
                right := bodies[j]
                delta :: left.position - right.position
                magnitude :: dt / (delta.dot(delta) * delta.length())
                left.velocity = left.velocity - delta * Vec3.splat(right.mass * magnitude)
                right.velocity = right.velocity + delta * Vec3.splat(left.mass * magnitude)
                bodies[i] = left
                bodies[j] = right
            }
        }
        loop i in bodies.indexes() {
            body := bodies[i]
            body.position = body.position + body.velocity * Vec3.splat(dt)
            bodies[i] = body
        }
    }
}

fn run(args: Args) {
    steps :: args.steps
    pi :: Float{3.141592653589793}
    solar_mass :: Float{4.0} * pi * pi
    year :: Float{365.24}
    bodies := [
        (position: Vec3(0.0, 0.0, 0.0), velocity: Vec3(0.0, 0.0, 0.0), mass: solar_mass),
        (position: Vec3(4.84143144246472090, -1.16032004402742839, -0.103622044471123109),
            velocity: Vec3(0.00166007664274403694 * year, 0.00769901118419740425 * year, -0.0000690460016972063023 * year),
            mass: Float{0.000954791938424326609} * solar_mass),
        (position: Vec3(8.34336671824457987, 4.12479856412430479, -0.403523417114321381),
            velocity: Vec3(-0.00276742510726862411 * year, 0.00499852801234917238 * year, 0.0000230417297573763929 * year),
            mass: Float{0.000285885980666130812} * solar_mass),
        (position: Vec3(12.8943695621391310, -15.1111514016986312, -0.223307578892655734),
            velocity: Vec3(0.00296460137564761618 * year, 0.00237847173959480950 * year, -0.0000296589568540237556 * year),
            mass: Float{0.0000436624404335156298} * solar_mass),
        (position: Vec3(15.3796971148509165, -25.9193146099879641, 0.179258772950371181),
            velocity: Vec3(0.00268067772490389322 * year, 0.00162824170038242201 * year, -0.0000951592254519715870 * year),
            mass: Float{0.0000515138902046611451} * solar_mass)
    ]
    offset_momentum(&bodies)
    initial_energy :: energy(bodies)
    print("{initial_energy:Fixed(9)}")
    advance(&bodies, steps)
    final_energy :: energy(bodies)
    print("{final_energy:Fixed(9)}")
}
