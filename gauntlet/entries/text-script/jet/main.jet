use core.files as fs
use core.process as process

fn run() {
    path :: process.argv().get(1) ?? "notes.txt"
    input :: fs.read(path) ?? panic("read failed")
    lines := [String]{}
    loop line in input.lines() {
        trimmed :: line.trim()
        clean :: "{trimmed}"
        if clean.len() > 0 -> lines.push(clean)
    }
    lines.sort()
    print("lines {lines.len()}")
    loop line in lines -> print(line)
}
