use core.files as files


#CLI struct Args { path: String }

fn run(args: Args) !Err {
    r :: Reader.over(files.read_bytes(args.path) ?? return)
    r.take_pattern([U8]{"JGB1"}) ?? return
    n :: Int.from_u32(r.read_u32_le() ?? return)
    s := 0.0
    h := U64{14695981039346656037}
    loop _ in 0..<n {
        i :: r.read_u32_le() ?? return
        v :: r.read_f64_le() ?? return
        l :: r.read_u16_le() ?? return
        if i % 7 == 0 -> s += v
        loop b in r.take(l) ?? return -> h = (h ~| b).wrapping_mul(1099511628211)
    }
    print("records {n}\nsum7 {s:Fixed(6)}\nfnv {Int.from_u64(h):Hex(16)}")
}
