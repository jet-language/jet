use core.files as fs
use core.process as process
use core.sys as sys
use core.encoding.hex as hex
use core.regex as re

fn run() {
    args :: process.argv()
    cwd :: sys.current_dir() ?? return Err("cannot get cwd")
    path :: Path.from(cwd).join(args.get(1) ?? "records.bin").to_string()
    data :: fs.read_bytes(Path.from(path)) ?? return Err("cannot read input")
    reader :: Reader.over(data)

    magic :: reader.take(4) ?? return Err("short magic")
    expected_magic :: [U8]{74, 71, 66, 49}
    if magic != expected_magic -> return Err("bad magic")
    count_u32 :: reader.read_u32_le() ?? return Err("short count")
    count :: Int.from_u32(count_u32)

    sum := Float{0.0}
    hash := U64{14695981039346656037}
    prime :: U64{1099511628211}
    loop _ in 0..<count {
        id_u32 :: reader.read_u32_le() ?? return Err("short id")
        id :: Int.from_u32(id_u32)
        value :: reader.read_f64_le() ?? return Err("short value")
        name_len_u16 :: reader.read_u16_le() ?? return Err("short name length")
        name_len :: Int.from_u16(name_len_u16)
        if id % 7 == 0 -> sum += value
        loop _ in 0..<name_len {
            byte :: reader.read_u8() ?? return Err("short name")
            hash = (hash ~| U64.from_u8(byte)).wrapping_mul(prime)
        }
    }

    hash_bytes :: [U8]{
        U8.from_u64((hash >> 56) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 48) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 40) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 32) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 24) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 16) & U64{255}) ?? U8{0},
        U8.from_u64((hash >> 8) & U64{255}) ?? U8{0},
        U8.from_u64(hash & U64{255}) ?? U8{0}
    }
    print("records {count}")
    sum_text :: re.replace_all(Regex{","}, "", "{sum:Fixed(6)}")
    print("sum7 {sum_text}")
    print("fnv {hex.encode(hash_bytes)}")
}
