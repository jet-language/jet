use core.[files, regex]

#CLI
struct Args {
    input: String
}

fn run(args: Args) !IOError -> {
    text :: files.read(args.input)
    pattern :: Regex{"^([0-9.]+) - - \[[^]]+\] \"GET /api/[^ ]+ HTTP/1\.1\" 5[0-9][0-9] "}
    counts := [String:Int]{}
    matches := 0

    loop line in text.lines() {
        if regex.match(pattern, line) == .Val(mat) {
            ip :: mat.group(1) ?? ""
            counts[ip] = (counts.get(ip) ?? 0) + 1
            matches += 1
        }
    }

    print("matches {matches}")
    loop item in counts.top_n(5) -> print("{item.value} {item.key}")
}
