use core.files as fs
use core.process as process
use core.regex as re

fn run() {
    path :: process.argv().get(1) ?? "access.log"
    text :: fs.read(path) ?? return Err("read failed")
    pattern :: Regex{"^([0-9.]+) - - \[[^]]+\] \"GET (/api/[^ ]+) HTTP/1\.1\" 5[0-9][0-9] "}
    counts := [String:Int]{}
    matches := 0

    loop line in text.lines() {
        if line.contains(" /api/") && line.contains("\" 5") {
            found :: re.match(pattern, line)
            if found == .Val(mat) {
                ip :: mat.group(1) ?? ""
                counts[ip] = (counts.get(ip) ?? 0) + 1
                matches += 1
            }
        }
    }

    print("matches {matches}")
    ips := counts.keys().to_list()
    top := [String]{}
    loop _ in 0..<5 {
        best_ip := ""
        best_count := -1
        loop ip in ips {
            count :: counts.get(ip) ?? 0
            if !top.contains(ip) && (count > best_count || (count == best_count && (best_ip == "" || ip < best_ip))) {
                best_ip = ip
                best_count = count
            }
        }
        if best_ip == "" -> break
        top.push(best_ip)
    }
    loop i in 0..<top.len() -> print("{counts.get(top[i]) ?? 0} {top[i]}")
}
