use core.[files, time]
#CLI
struct Args { input: String }
fn run(args: Args) !IOError -> {
    input :: files.open(~args.input) ?? return
    levels := [String:Int]{}
    errors := [String:Int]{}
    first := ""; last := ""; first_ms := 0;last_ms := 0
    loop line in input.lines() {
        fields :: line.split(" ").to_list()
        stamp :: fields[0]
        level :: fields[1]
        component :: fields[2]
        millis :: (time.parse_rfc3339(stamp) ?? panic("bad timestamp")).to_unix_ms()
        if first == "" { first = stamp; first_ms = millis }
        last = stamp; last_ms = millis
        levels[level] = (levels.get(level) ?? 0) + 1
        if level == "ERROR" { errors[component] = (errors.get(component) ?? 0) + 1 }
    }
    loop level in ["DEBUG", "INFO", "WARN", "ERROR"] -> print("{level} {levels.get(level) ?? 0}")
    print("top-error-components:")
    loop item in errors.top_n(3) -> print("{item.value} {item.key}")
    print("span {first} .. {last} ({(last_ms - first_ms) / 1000}s)")
}
