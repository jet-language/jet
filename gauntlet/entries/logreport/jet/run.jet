use core.[files, time]

#CLI
struct Args {
    input: String
}

fn parse_millis(stamp: String) Int -> {
    (time.parse_rfc3339(stamp) ?? panic("bad timestamp")).to_unix_ms()
}

fn bump(counts: &[String:Int], key: String) {
    counts[key] = (counts.get(key) ?? 0) + 1
}

fn run(args: Args) !IOError {
    input :: files.open(~args.input)
    level_counts := [String:Int]{}
    error_components := [String:Int]{}
    first := ""
    last := ""
    first_ms := 0
    last_ms := 0
    loop line in input.lines() {
        first_fields :: line.split_once(" ") ?? panic("bad line")
        rest :: first_fields.after
        second_fields :: rest.split_once(" ") ?? panic("bad line")
        third_fields :: second_fields.after.split_once(" ") ?? panic("bad line")
        stamp :: first_fields.before
        level :: second_fields.before
        component :: third_fields.before
        millis :: parse_millis(stamp)
        if first == "" {
            first = ~stamp
            first_ms = millis
        }
        last = ~stamp
        last_ms = millis
        bump(&level_counts, level)
        if level == "ERROR" -> bump(&error_components, component)
    }
    print("DEBUG {level_counts.get("DEBUG") ?? 0}")
    print("INFO {level_counts.get("INFO") ?? 0}")
    print("WARN {level_counts.get("WARN") ?? 0}")
    print("ERROR {level_counts.get("ERROR") ?? 0}")
    print("top-error-components:")
    loop item in error_components.top_n(3) -> print("{item.value} {item.key}")
    print("span {first} .. {last} ({(last_ms - first_ms) / 1000}s)")
}
