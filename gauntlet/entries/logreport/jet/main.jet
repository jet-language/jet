use core.[files, time]

struct LogLine { timestamp: String, level: String, component: String, millis: Int }

#CLI
struct Args {
    input: String
}

fn parse_line(line: String) LogLine -> {
    fields :: line.split(" ").take(3).to_list()
    timestamp_text :: fields.get(0) ?? panic("bad log line")
    level :: fields.get(1) ?? panic("bad log line")
    component :: fields.get(2) ?? panic("bad log line")
    timestamp :: time.parse_rfc3339(timestamp_text) ?? panic("bad timestamp")
    LogLine{timestamp: timestamp_text, level, component, millis: timestamp.to_unix_ms()}
}

fn run(args: Args) !IOError -> {
    input :: (files.open(~args.input) ?? panic("open log"))
    level_counts := [String:Int]{}
    error_components := [String:Int]{}
    first_timestamp := ""
    last_timestamp := ""
    first_millis := 0
    last_millis := 0
    total := 0
    loop line in input.lines() {
        record :: parse_line(line) ?? panic("bad log line")
        last_timestamp = record.timestamp
        last_millis = record.millis
        if total == 0 {
            first_timestamp = ~last_timestamp
            first_millis = last_millis
        }
        level_counts[record.level] = (level_counts.get(record.level) ?? 0) + 1
        if record.level == "ERROR" {
            error_components[record.component] = (error_components.get(record.component) ?? 0) + 1
        }
        total += 1
    }

    loop level in ["DEBUG", "INFO", "WARN", "ERROR"] {
        print("{level} {level_counts.get(level) ?? 0}")
    }
    print("top-error-components:")
    loop item in error_components.top_n(3) -> print("{item.value} {item.key}")
    print("span {first_timestamp} .. {last_timestamp} ({(last_millis - first_millis) / 1000}s)")
}
