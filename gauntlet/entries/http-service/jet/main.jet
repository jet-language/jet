use core.[http.server, net]

struct ServerState {
    stopped: Bool
}

#CLI
struct Args {
    port: String
}

fn reply(status: Int, body: String) HTTPResponse !HTTPError ->
    Ok(server.response(status, body).header("content-type", "application/json"))

fn put_value(req: HTTPRequest, values: Shared<[String:String]>) HTTPResponse !HTTPError -> {
    key :: req.param("key") ?? ""
    value :: req.body().text(8388608) ?? ""
    guard := values.guard_edit()
    guard.value.add(key, value).drop("stored value")
    reply(200, "{{\"stored\":\"{key}\"}}")
}

fn get_value(req: HTTPRequest, values: Shared<[String:String]>) HTTPResponse !HTTPError -> {
    key :: req.param("key") ?? ""
    guard :: values.guard_read()
    stored :: guard.value.get(key) ?? return reply(404, "{{\"error\":\"not found\"}}")
    reply(200, "{{\"key\":\"{key}\",\"value\":\"{stored}\"}}")
}

fn run(args: Args) !(HTTPError | NetError | IOError) -> {
    listener :: net.tcp_listen("127.0.0.1:{args.port}")
    values :: shared [String:String]{}
    state :: shared ServerState{stopped: false}
    mux :: server.mux()
    mux.get("/health", (_req: HTTPRequest) -> reply(200, "{{\"status\":\"ok\"}}"))
    mux.put("/kv/:key", (req: HTTPRequest) -> put_value(req, values))
    mux.get("/kv/:key", (req: HTTPRequest) -> get_value(req, values))
    mux.get("/shutdown", (_req: HTTPRequest) -> {
        state.stopped = true
        reply(200, "{{\"bye\":true}}")
    })
    loop {
        if state.stopped -> break
        server.serve_once_listener(listener, mux) ?? panic("serve failed")
    }
}
