use core.files as fs
use core.process as process

fn run() {
    contents :: fs.read(process.argv().get(1) ?? "input.txt") ?? panic("read failed")
    words :: contents.lines().map((line: String) -> line.split(" ").to_list()).flatten()
    counts :: words.counts()
    total :: counts.values().sum()
    loop item in counts.top_n(20) -> print("{item.value} {item.key}")
    print("distinct {counts.len()} total {total}")
}
