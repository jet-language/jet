use core.files as files

#CLI
struct Args {
    root: String
    needle: String
}

fn run(args: Args) {
    root :: args.root
    needle :: ~args.needle
    paths := (files.walk_files(root) ?? panic("walk failed")).filter(entry -> entry.path.ends_with(".txt")).map(entry -> entry.path)
    line_groups :: paths.map(path -> (files.read(path) ?? panic("read failed")).lines())
    counts :: line_groups.para_map((rows: [String]) -> rows.map(line -> line.count(needle)).sum())
    matched := 0
    total := 0
    loop pair in paths.zip(counts) {
        count :: pair.b
        if count > 0 {
            print("{pair.a}:{count}")
            matched++
        }
        total += count
    }
    print("files {matched}/{paths.len()} total {total}")
}
