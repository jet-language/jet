use core.files as files

#CLI
struct Args {
    root: String
    needle: String
}

fn scan(path: String, needle: String) Int -> {
    text :: files.read(path) ?? panic("read failed")
    text.lines().map(line -> line.count(needle)).sum()
}

fn run(args: Args) {
    root :: args.root
    needle :: ~args.needle
    paths := (files.walk_files(root) ?? panic("walk failed")).filter(entry -> entry.path.ends_with(".txt")).map(entry -> entry.path)
    counts := paths.para_map(path -> scan(path, needle))
    matched := 0
    total := 0
    loop pair in paths.zip(counts) {
        count :: pair.b
        if count > 0 {
            print("{pair.a}:{count}")
            matched++
        }
        total += count
    }
    print("files {matched}/{paths.len()} total {total}")
}
