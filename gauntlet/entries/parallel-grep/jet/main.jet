use core.files as files

#CLI
struct Args {
    root: String
    needle: String
}

fn count_file(path: String, needle: String) Int -> {
    text :: files.read(path) ?? ""
    text.lines().map(line -> line.count(needle)).sum()
}

fn run(args: Args) {
    root :: ~args.root
    needle :: ~args.needle
    paths := (files.list_dir(root) ?? panic("list failed")).filter(entry -> !entry.is_dir && entry.name.ends_with(".txt")).map(entry -> entry.path)
    paths.sort()
    counts := paths.para_map((path: String) -> count_file(path, needle), limit: 32)
    normalized := counts.map(count -> Int{count})
    zero :: Int{0}
    matched := 0
    loop index in 0..<paths.len() {
        count :: normalized[index]
        if count > zero {
            path :: paths.get(index) ?? ""
            print("{path}:{count}")
            matched += 1
        }
    }
    print("files {matched}/{paths.len()} total {normalized.sum()}")
}
