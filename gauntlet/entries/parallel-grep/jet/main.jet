use core.files as fs
use core.process as process
struct Match { display: String, count: Int }
fn scan(path: String, root: String, needle: String) Match -> {
    text :: fs.read(~path) ?? ""
    count :: text.lines().map((line: String) -> line.count(needle)).sum()
    return Match{display: "{root}/{Path.from(path).stem()}.txt", count}
}
fn run() {
    root :: process.argv().get(1) ?? "files"
    needle :: process.argv().get(2) ?? "needle-7f"
    entries :: fs.list_dir(root) ?? panic("list failed")
    paths := [String]{}
    loop entry in entries {
        if !entry.is_dir && entry.name.ends_with(".txt") -> paths.push(entry.path)
    }
    results := paths.para_map((path: String) -> scan(path, root, needle), limit: 32)
    results.sort_by(result -> result.display)
    positive :: results.filter((result: Match) -> result.count > 0)
    total :: positive.map((result: Match) -> result.count).sum()
    loop result in positive -> print("{result.display}:{result.count}")
    print("files {positive.len()}/{paths.len()} total {total}")
}
