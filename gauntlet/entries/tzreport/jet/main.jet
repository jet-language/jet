use core.files as files
use core.process as process
use core.sys as sys
use core.time as time

fn run() !IOError {
    path :: process.argv().get(1) ?? "meetings.txt"
    cwd :: sys.current_dir() ?? "."
    text :: files.read(Path.from(cwd).join(path).to_string()) ?? panic("read meetings")
    names := [String]{}
    utc_texts := [String]{}
    milliseconds := [Int]{}
    weekdays := [Int]{}

    loop line in text.split("\n") {
        if line == "" -> next
        fields :: line.split("|").to_list()
        name :: fields.get(0) ?? panic("bad meeting")
        raw :: fields.get(1) ?? panic("bad meeting")
        local :: time.parse_rfc3339(raw) ?? panic("bad timestamp")
        millis :: local.to_unix_ms()
        utc :: time.from_unix_ms(millis)
        names.push(name)
        utc_texts.push(utc.format_rfc3339())
        milliseconds.push(millis)
        weekdays.push(utc.date().iso_weekday())
    }

    order := [Int]{}
    loop i in 0..<names.len() -> order.push(i)
    loop i in 1..<order.len() {
        key :: order[i]
        j := i
        loop j > 0 {
            previous :: order[j - 1]
            if milliseconds[previous] <= milliseconds[key] -> break
            order[j] = previous
            j -= 1
        }
        order[j] = key
    }

    day_names :: [String]{"", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
    loop position in 0..<order.len() {
        index :: order[position]
        if {
            position == 0 -> print("{names[index]} utc={utc_texts[index]} day={day_names[weekdays[index]]} gap=-")
            else -> {
                gap :: (milliseconds[index] - milliseconds[order[position - 1]]) /% 60000
                print("{names[index]} utc={utc_texts[index]} day={day_names[weekdays[index]]} gap={gap}")
            }
        }
    }
    first :: order.get(0) ?? 0
    last :: order.get(order.len() - 1) ?? 0
    span :: if order.len() == 0 -> 0 else -> (milliseconds[last] - milliseconds[first]) /% 60000
    print("span {span} minutes {order.len()}")
}
