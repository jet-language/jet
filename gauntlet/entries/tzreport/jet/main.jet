use core.[files, time]

struct Meeting {
    when: DateTime
    name: String
}

#CLI
struct Args {
    input: String
}

fn parse_meeting(line: String) Meeting -> {
    fields :: line.split_once("|") ?? panic("bad meeting")
    local :: time.parse_rfc3339(fields.after) ?? panic("bad timestamp")
    Meeting{when: local, name: fields.before}
}

fn run(args: Args) {
    text :: files.read(args.input) ?? panic("read failed")
    meetings := [Meeting]{}
    loop line in text.lines() {
        if line != "" -> meetings.push(parse_meeting(line))
    }
    meetings.sort_by(meeting -> (when: meeting.when, name: meeting.name))
    loop (position, meeting) in meetings {
        gap :: if position == 0 -> "-" else -> "{meeting.when.difference(meetings[position - 1].when).in(.Minutes) ?? 0}"
        print("{meeting.name} utc={meeting.when.format_rfc3339()} day={meeting.when.format("%a")} gap={gap}")
    }
    span :: if meetings.len() == 0 -> 0 else -> meetings[meetings.len() - 1].when.difference(meetings[0].when).in(.Minutes) ?? 0
    print("span {span} minutes {meetings.len()}")
}
