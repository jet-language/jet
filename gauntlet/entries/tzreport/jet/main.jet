use core.files as files
use core.process as process
use core.time as time

struct Meeting {
    millis: Int
    name: String
    utc: String
    weekday: String
}

fn parse_meeting(line: String) Meeting -> {
    fields :: line.split("|").to_list()
    local :: time.parse_rfc3339(fields.get(1) ?? panic("bad meeting")) ?? panic("bad timestamp")
    return Meeting{millis: local.to_unix_ms(), name: fields.get(0) ?? panic("bad meeting"), utc: local.format_rfc3339(), weekday: ["", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][local.date().iso_weekday()]}
}

fn run() {
    text :: files.read(process.argv().get(1) ?? "meetings.txt") ?? panic("read meetings")
    // Loop form until #2266 c6 lands (fallible callee in a map closure AOT-leaks).
    meetings := [Meeting]{}
    loop line in text.lines() {
        if line != "" -> meetings.push(parse_meeting(line))
    }
    meetings.sort_by(meeting -> meeting.millis)
    loop position in 0..<meetings.len() {
        gap :: if position == 0 -> "-" else -> "{(meetings[position].millis - meetings[position - 1].millis) /% 60000}"
        print("{meetings[position].name} utc={meetings[position].utc} day={meetings[position].weekday} gap={gap}")
    }
    print("span {if meetings.len() == 0 -> 0 else -> (meetings[meetings.len() - 1].millis - meetings[0].millis) /% 60000} minutes {meetings.len()}")
}
