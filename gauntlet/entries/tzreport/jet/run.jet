use core.[files, time]

#CLI
struct Args {
    path: String
}

fn parse_meeting(line: String) (when: DateTime, name: String) -> {
    fields :: line.split_once("|") ?? panic("bad meeting")
    timestamp :: time.parse_rfc3339(fields.after) ?? panic("bad timestamp")
    return (when: timestamp, name: fields.before)
}

fn run(args: Args) {
    meetings := (files.read(args.path) ?? panic("read meetings"))
        .lines()
        .filter(line -> line != "")
        .map(line -> parse_meeting(line))
    meetings.sort_by(.when)
    loop (position, meeting) in meetings {
        gap :: if position == 0 -> "-" else -> "{meeting.when.difference(meetings[position - 1].when).in(.Minutes) ?? panic("gap")}"
        print("{meeting.name} utc={meeting.when.format_rfc3339()} day={meeting.when.format("%a")} gap={gap}")
    }
    count :: meetings.len()
    span :: if count == 0 -> 0 else -> meetings[count - 1].when.difference(meetings[0].when).in(.Minutes) ?? panic("span")
    print("span {span} minutes {count}")
}
