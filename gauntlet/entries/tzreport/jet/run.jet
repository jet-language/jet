use core.[files, time]

#CLI struct Args { path: String }

fn run(args: Args) {
    meetings := (files.read(args.path) ?? panic("read")).lines().filter(line -> line != "").map(line -> {
        fields :: line.split_once("|") ?? panic("bad")
        (a: time.parse_rfc3339(fields.after) ?? panic("bad"), b: fields.before)
    })
    meetings.sort_by(.a)
    loop (position, meeting) in meetings {
        gap :: if position == 0 -> "-" else -> "{meeting.a.difference(meetings[position - 1].a).in(.Minutes) ?? 0}"
        print("{meeting.b} utc={meeting.a.format_rfc3339()} day={meeting.a.format("%a")} gap={gap}")
    }
    n :: meetings.len()
    span :: if n == 0 -> 0 else -> meetings[n - 1].a.difference(meetings[0].a).in(.Minutes) ?? 0
    print("span {span} minutes {n}")
}
