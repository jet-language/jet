use core.[encoding.json, files, process]

struct Task { id: Int, text: String, done: Bool }
struct Store { tasks: [Task] }

fn load() [Task] !(IOError | [FieldError]) -> {
    if !files.exists("tasks.json") -> return Ok([])
    Ok(json.decode<Store>(files.read("tasks.json")).tasks)
}

fn save(tasks: [Task]) !IOError -> {
    files.write("tasks.json", json.to_string(Store{tasks: tasks}))
}

fn run() !(IOError | [FieldError]) -> {
    args :: process.argv()
    command :: args.get(1) ?? ""
    tasks := load()

    if command == {
        "add" -> {
            text :: args.get(2) ?? ""
            id :: tasks.len() + 1
            message :: "added {id} {text}"
            tasks.push(Task{id, text: text, done: false})
            save(tasks)
            print(message)
        }
        "done" -> {
            id :: Int.parse(args.get(2) ?? "") ?? -1
            index :: tasks.position(item -> item.id == id) ?? -1
            if index >= 0 {
                tasks[index].done = true
                save(tasks)
                print("done {id}")
            } else {
                print("no task {id}")
            }
        }
        "list" -> {
            open := 0
            done := 0
            loop item in tasks {
                mark :: if item.done -> "x" else -> " "
                if item.done -> done += 1 else -> open += 1
                print("[{mark}] {item.id} {item.text}")
            }
            print("open {open} done {done}")
        }
        else -> {}
    }
}
