use core.[encoding.json, files, process]

struct Task { id: Int, text: String, done: Bool }
struct Store { tasks: [Task] }

fn load() [Task] !(IOError | [FieldError]) -> {
    if !files.exists("tasks.json") -> return Ok([])
    raw :: files.read("tasks.json")
    store :: json.decode<Store>(raw)
    return Ok(store.tasks)
}

fn save(tasks: [Task]) !IOError {
    files.write("tasks.json", json.to_string(Store{tasks: tasks}))
}

fn run() !(IOError | [FieldError]) {
    args :: process.args()
    command :: args.get(0) ?? ""
    tasks := load()

    if command == {
        "add" -> {
            text :: args.get(1) ?? ""
            id :: tasks.len() + 1
            tasks.push(Task{id: id, text: ~text, done: false})
            save(tasks)
            print("added {id} {text}")
        }
        "done" -> {
            id :: Int.parse(args.get(1) ?? "") ?? -1
            if tasks.find(entry -> entry.id == id) == {
                .Val(current) -> {
                    tasks.update_first(entry -> entry.id == id, Task{id: current.id, text: current.text, done: true})
                    save(tasks)
                    print("done {id}")
                }
                .None -> print("no task {id}")
            }
        }
        "list" -> {
            done :: tasks.count_where(entry -> entry.done)
            loop entry in tasks {
                mark :: if entry.done -> "x" else -> " "
                print("[{mark}] {entry.id} {entry.text}")
            }
            print("open {tasks.len() - done} done {done}")
        }
        else -> {}
    }
}
