use core.[encoding.json, files, process]

struct Task { id: Int, text: String, done: Bool }
struct Store { tasks: [Task] }

fn load() [Task] !(IOError | [FieldError]) -> if files.exists("tasks.json") -> Ok(json.decode<Store>(files.read("tasks.json")).tasks) else -> Ok([])
fn save(tasks: [Task]) !IOError { files.write("tasks.json", json.to_string(Store{tasks})) }

fn run() !(IOError | [FieldError]) {
    args :: process.args()
    text :: args.get(1) ?? ""
    tasks := load()

    if (args.first() ?? "") == {
        "add" -> {
            id :: tasks.len() + 1
            tasks.push(Task{id, text, done: false})
            save(tasks)
            print("added {id} {text}")
        }
        "done" -> {
            id :: Int.parse(text) ?? -1
            if tasks.find(item -> item.id == id) == .Val(current) {
                tasks.update_first(item -> item.id == id, Task{id, text: current.text, done: true})
                save(tasks)
                print("done {id}")
            } else {
                print("no task {id}")
            }
        }
        "list" -> {
            done :: tasks.count_where(.done)
            tasks.each(item -> print("[{if item.done -> "x" else -> " "}] {item.id} {item.text}"))
            print("open {tasks.len() - done} done {done}")
        }
        else -> {}
    }
}
