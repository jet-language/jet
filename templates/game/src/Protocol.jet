// The generated dev protocol is bounded, local, read-only, and tied to checked
// source.  Hosts may project these facts through the existing devtools envelope;
// this package does not create a second transport or payload authority.
pub struct RemoteProtocol {
    protocol: String
    version: Int
    transport: String
    host: String
    port: Int
    max_messages: Int
    max_message_bytes: Int
    source_revision: Bool
    execution_tier: Bool
    scene_identity: Bool
    frame_identity: Bool
    payload_free: Bool
    read_only: Bool
    remote_writes: Bool
}

pub fn loopback() RemoteProtocol -> {
    return RemoteProtocol{
        protocol: "jet.devtools.v1",
        version: 1,
        transport: "loopback",
        host: "127.0.0.1",
        port: 0,
        max_messages: 256,
        max_message_bytes: 1048576,
        source_revision: true,
        execution_tier: true,
        scene_identity: true,
        frame_identity: true,
        payload_free: true,
        read_only: true,
        remote_writes: false,
    }
}
