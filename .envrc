# Requires nix-direnv. Run `direnv allow` once; normal commands then reuse its
# cached Nix environment. `JET_DEV_SHELL=full` selects integration tooling.
# Nix owns this shell; do not stack the global Jet env auto-hook on top.
export JET_ENV_DISABLE=1

if ! has nix_direnv_version; then
  log_error "Jet needs nix-direnv for cached development shells; use scripts/agent/jet-env as fallback."
  return 1
fi

if [ "${JET_DEV_SHELL:-core}" = "full" ]; then
  use flake .#full
else
  use flake
fi
