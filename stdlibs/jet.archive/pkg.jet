// jet.archive ring package — gzip compress / decompress (D-DEP-ARCHIVE1=A).
//
// D-BFS1: the `flate2` crate source is vendored under `pkgs/archive/vendor/`
// so `jetpack build jet.archive` compiles offline with no internet access.
// The `.cargo/config.toml` in `pkgs/archive/` activates the vendor directory.
//
// Usage in a Jet program:
//   use jet.archive as ar
//   compressed @= ar.gzip_compress(bytes)
//   original @= ar.gzip_decompress(compressed)

payload: {
    name: "jet.archive"
    version: "0.1.0"
}
packages: {
    archive: library
}
