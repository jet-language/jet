// env.jet — 1:1 of flake.nix `devShells.default` (inputs.nixpkgs = nixos-unstable).
//
// Unmapped from flake (no env.* spelling yet — L0204):
//   shellHook (JET_ROOT, TZDIR, raylib LD_LIBRARY_PATH, clean-nix-tmp,
//   githooksPath, banner)
//   jetDev / jetpackDev wrappers (cargo `target/debug/{jet,jetpack}` + PATH)
//
// R + jsonlite: flake uses `rWrapper.override { packages = [jsonlite] }`;
// here that is nixpkgs `R` plus the CRAN provider (`cran.jsonlite`).
//
// Linux-only in flake (`lib.optionals stdenv.isLinux`): chromium, gtk4, bubblewrap.
module env.dev {
    sources: { default: github@NixOS/nixpkgs/nixos-unstable }
    packages: [
        default.[
            cargo,
            rustc,
            gcc,
            gnat,
            fpc,
            dart,
            powershell,
            gfortran,
            gnucobol,
            go,
            jdk,
            dotnet-sdk_8,
            tcl,
            lua5_4,
            lld,
            ruby,
            php,
            R,
            qemu,
            nodejs_22,
            nixfmt,
            ripgrep,
            jq,
            gh,
            fd,
            bashInteractive,
            zsh,
            fish,
            util-linux,
            wasm-tools,
            tree-sitter,
            emscripten,
            lldb,
            pkg-config,
            raylib,
            chromium,
            gtk4,
            bubblewrap,
        ],
        cran.jsonlite,
    ]
    prompt: "jet"
}
