// env.jet — the Jet-native projections of flake.nix `devShells.default` and
// `devShells.full`.
//
// Jetpack supplies the project root, direct target/debug tools, TZDIR, Linux
// loader paths, and the Jet environment markers as native runtime facts. It
// does not execute the flake shellHook. `env.full` is selected with
// `jetpack env --env full`.
// Native facts: JET_ROOT=project-root; TZDIR=tzdata/share/zoneinfo;
// JET_ENV_DISABLE=1; JET_NIX_TMP_CLEANED=1 because Jetpack creates no Nix
// scratch; Linux LD_LIBRARY_PATH=vulkan-loader/lib:raylib/lib plus inherited
// loader paths. These are projected from typed realized outputs, not literals.
// The native repo-tool definitions are `jetDev -> target/debug/jet` and
// `jetpackDev -> target/debug/jetpack`; they are not shell wrappers.
// Compiler dogfood is explicit: scripts/agent/jet-env compiler <command>.
// The checked-in local catalog pins these packages to flake.lock's revision;
// Jetpack verifies and imports their binary-cache closures without invoking Nix.
// dev/full remain separate selections; a missing package is never skipped.
module env.compiler {
    sources: { default: NixOS/nixpkgs/nixos-unstable@github }
    packages: [
        default.[
            cargo, rustc, clippy, rustfmt, sccache, gcc, clang, lld, pkg-config,
            cmake, gnumake, coreutils, findutils, gnugrep, gnused, gawk,
            diffutils, patch, bashInteractive, git, curl, cacert, nodejs_22,
            python3, ripgrep, jq, gh, fd, util-linux, bubblewrap, tzdata,
            vulkan-loader, wasm-tools, tree-sitter, zsh, fish,
        ],
    ]
    prompt: "jet-compiler"
}

module env.dev {
    sources: { default: NixOS/nixpkgs/nixos-unstable@github }
    packages: [
        default.[
            cargo, sccache, clippy, rustc, rustfmt, gcc, clang, lld, nodejs_22, python3,
            nixfmt, ripgrep, jq, gh, fd, bashInteractive, zsh, fish, util-linux,
            wasm-tools, tree-sitter, pkg-config,
            tzdata, vulkan-loader, ruby, php, rWrapper,
        ],
        default.rPackages.jsonlite,
    ]
    prompt: "jet"
}

module env.full {
    sources: { default: NixOS/nixpkgs/nixos-unstable@github }
    packages: [
        default.[
            cargo, sccache, clippy, rustc, rustup, rustfmt, gcc, clang, gnat, fpc, dart,
            powershell, gfortran, gnucobol, go, jdk, dotnet-sdk_8, tcl, lua5_4, lld,
            ruby, php,
            rWrapper,
            octave, qemu, nodejs_22, python3, nixfmt, ripgrep, jq, gh, fd,
            bashInteractive, zsh, fish, util-linux, wasm-tools, wasmtime, tree-sitter,
            emscripten, lldb, pkg-config, raylib,
            chromium, firefox, geckodriver, gtk4, bubblewrap,
            tzdata, vulkan-loader,
        ],
        default.rPackages.jsonlite,
    ]
    prompt: "jet"
}
