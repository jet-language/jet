// env.jet — the Jet-native projections of flake.nix `devShells.default` and
// `devShells.full`.
//
// Jetpack supplies the project root, direct target/debug tools, TZDIR, Linux
// loader paths, and the Jet environment markers as native runtime facts. It
// does not execute the flake shellHook. `env.full` is selected with
// `jetpack enter --env full`.
// The native repo-tool definitions are `jetDev -> target/debug/jet` and
// `jetpackDev -> target/debug/jetpack`; they are not shell wrappers.
module env.dev {
    sources: { default: NixOS/nixpkgs/nixos-unstable@github }
    packages: [
        default.[
            cargo, sccache, clippy, rustc, gcc, clang, lld, nodejs_22,
            nixfmt, ripgrep, jq, gh, fd, bashInteractive, zsh, fish, util-linux,
            wasm-tools, tree-sitter, pkg-config,
        ],
    ]
    prompt: "jet"
}

module env.full {
    sources: { default: NixOS/nixpkgs/nixos-unstable@github }
    packages: [
        default.[
            cargo, sccache, clippy, rustc, rustup, rustfmt, gcc, clang, gnat, fpc, dart,
            powershell, gfortran, gnucobol, go, jdk, dotnet-sdk_8, tcl, lua5_4, lld,
            ruby, php,
            rWrapper,
            octave, qemu, nodejs_22, python3, nixfmt, ripgrep, jq, gh, fd,
            bashInteractive, zsh, fish, util-linux, wasm-tools, wasmtime, tree-sitter,
            emscripten, lldb, pkg-config, raylib,
            chromium, firefox, geckodriver, gtk4, bubblewrap,
            tzdata, vulkan-loader,
        ],
        default.rPackages.jsonlite,
    ]
    prompt: "jet"
}
