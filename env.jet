// env.jet — core compiler shell, matching flake.nix `devShells.default`.
// Full FFI/browser/graphics tooling stays opt-in through `nix develop .#full`.
//
// Unmapped from flake (no env.* spelling yet — L0204):
//   shellHook (JET_ROOT, TZDIR, clean-nix-tmp)
//   jetDev / jetpackDev wrappers (cargo `target/debug/{jet,jetpack}` + PATH)
module env.dev {
    sources: { default: github@NixOS/nixpkgs/nixos-unstable }
    packages: [
        default.cargo,
        default.clippy,
        default.rustc,
        default.gcc,
        default.clang,
        default.lld,
        default.nodejs_22,
        default.nixfmt,
        default.ripgrep,
        default.jq,
        default.gh,
        default.fd,
        default.bashInteractive,
        default.zsh,
        default.fish,
        default.util-linux,
        default.wasm-tools,
        default.tree-sitter,
        default.pkg-config,
    ]
    prompt: "jet"
}
