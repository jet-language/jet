fn run() {
    left := [String:Int]{"a": 1, "b": 2}
    right :: [String:Int]{"b": 9, "c": 3}
    left.update(right)
    print(left.get("a") ?? -1)
    print(left.get("b") ?? -1)
    print(left.get("c") ?? -1)

    int_left := [Int:String]{1: "one"}
    int_right :: [Int:String]{2: "two"}
    int_left.update(int_right)
    print(int_left.get(2) ?? "missing")
}
